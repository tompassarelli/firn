# Cleartext structure of the Clockify secret (modules/clockify).
# This .example is NOT encrypted and NOT read by nix — it documents the shape.
#
# Fork setup:
#   1. add your age public key as a recipient in .sops.yaml
#   2. cp secrets/clockify.yaml.example secrets/clockify.yaml   (fill the value)
#   3. sops --encrypt --in-place secrets/clockify.yaml
# Or: just don't enable myConfig.modules.clockify on your host.
msa-clockify-api-key: REPLACE_WITH_YOUR_CLOCKIFY_API_KEY
