# Cleartext structure of the AWS credentials secret (modules/awscli).
# This .example is NOT encrypted and NOT read by nix — it documents the shape.
#
# Fork setup:
#   1. add your age public key as a recipient in .sops.yaml
#   2. cp secrets/aws.yaml.example secrets/aws.yaml   (fill real values below)
#   3. sops --encrypt --in-place secrets/aws.yaml      (re-encrypts in place)
# Or: just don't enable myConfig.modules.awscli on your host.
aws-access-key-id: REPLACE_WITH_YOUR_AWS_ACCESS_KEY_ID
aws-secret-access-key: REPLACE_WITH_YOUR_AWS_SECRET_ACCESS_KEY
