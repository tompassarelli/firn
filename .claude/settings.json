{
  "permissions": {
    "allow": [
      "Bash(./scripts/firn-build)",
      "Bash(./scripts/firn-validate)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-edit-check.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
