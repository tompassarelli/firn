;; Order = band order; bind-names/bind-prefixes route matching workspaces
;; here regardless of the current activity.
{:default "home"
 :activities
 [{:id "home" :label "home"}
  {:id "gjoa" :label "gjoa"
   :bind-names ["gjoa release" "render"]
   :bind-prefixes ["gjoa"]}
  {:id "msa" :label "msa"
   :bind-names ["heist"]
   :bind-prefixes ["msa"]}]}
