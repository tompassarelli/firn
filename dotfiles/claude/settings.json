{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(nix:*)",
      "WebSearch",
      "Bash(safe-push:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "switchModelsOnFlag": false,
  "disableClaudeAiConnectors": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/tom/code/nixos-config/dotfiles/claude/hooks/beagle-session-start.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "AGENT_PROVIDER=anthropic /run/current-system/sw/bin/north-on-spawn",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_PROVIDER=anthropic /run/current-system/sw/bin/north-on-spawn",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/north-session-end",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "/home/tom/code/nixos-config/dotfiles/claude/hooks/agent-spawn-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/home/tom/code/nixos-config/dotfiles/claude/hooks/code-upstream-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/home/tom/code/nixos-config/dotfiles/claude/hooks/firn-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/tom/code/nixos-config/dotfiles/agents/hooks/agent-spawn-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/home/tom/code/nixos-config/dotfiles/claude/hooks/tripwire-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/home/tom/code/nixos-config/dotfiles/claude/hooks/firn-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/home/tom/code/nixos-config/dotfiles/agents/hooks/git-blind-stage-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/tom/code/nixos-config/dotfiles/claude/hooks/logcompress-hook.js",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/home/tom/code/nixos-config/dotfiles/claude/hooks/racket-build-guard.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_PROVIDER=anthropic /home/tom/code/nixos-config/dotfiles/agents/hooks/hook-detach.sh /run/current-system/sw/bin/north-on-tooluse",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__north__spawn|mcp__north__dispatch|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/north-mark-delegated",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/run/current-system/sw/bin/north-on-stop",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/code/nixos-config/dotfiles/claude/statusline.sh\""
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "orchestration@orchestration": true
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "orchestration": {
      "source": {
        "source": "directory",
        "path": "/home/tom/code/north/orchestration"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
