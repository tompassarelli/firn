{
 "entries": [
  {
   "event": "SessionStart",
   "matcher": null,
   "hook": {
    "type": "command",
    "command": "AGENT_PROVIDER=anthropic /run/current-system/sw/bin/north-on-spawn",
    "timeout": 15
   }
  },
  {
   "event": "SubagentStart",
   "matcher": null,
   "hook": {
    "type": "command",
    "command": "AGENT_PROVIDER=anthropic /run/current-system/sw/bin/north-on-spawn",
    "timeout": 15
   }
  },
  {
   "event": "SessionEnd",
   "matcher": null,
   "hook": {
    "type": "command",
    "command": "/home/tom/.agents/hooks/north-session-end.sh",
    "timeout": 15
   }
  },
  {
   "event": "PostToolUse",
   "matcher": "mcp__north__spawn|mcp__north__dispatch|Task|Agent",
   "hook": {
    "type": "command",
    "command": "/run/current-system/sw/bin/north-mark-delegated",
    "timeout": 10
   }
  },
  {
   "event": "Stop",
   "matcher": null,
   "hook": {
    "type": "command",
    "command": "/run/current-system/sw/bin/north-on-stop",
    "timeout": 10
   }
  }
 ],
