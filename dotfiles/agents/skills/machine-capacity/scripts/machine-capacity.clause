Resources:
  cpus: F64
  memoryMiB: F64

# Tom present: keep cores idle for the desktop. Away: batch may take every core.
export reserved-cpus(?profile: Text, ?cores: F64): F64
  if(?profile = "attended", if(?cores > 8, 4, if(?cores > 4, 2, 1)), 0)

export aggregate-cpus(?profile: Text, ?cores: F64): F64
  ?cores - reserved-cpus(?profile, ?cores)

# Available-memory floor below which nothing is admitted. Away keeps only the
# hard floor against swap and OOM; present keeps 20% for the desktop.
export memory-floor-mib(?profile: Text, ?memory-total-mib: F64): F64
  ?share: if(?profile = "attended", ?memory-total-mib / 5, ?memory-total-mib / 12)
  if(?share > 8192, ?share, 8192)

export resource-class(?kind: Text, ?cores: F64): Resources
  if(?kind = "agent", {cpus: 0, memoryMiB: 768},
    if(?kind = "native", {cpus: if(?cores > 1, 2, 1), memoryMiB: 4096},
      if(?kind = "moderate", {cpus: if(?cores > 1, 2, 1), memoryMiB: 2048},
        if(?kind = "heavy", {cpus: if(?cores > 8, 6, if(?cores > 4, 3, 1)), memoryMiB: 8192},
          require(?kind = "exclusive", {cpus: ?cores, memoryMiB: 16384},
            "Unknown resource class")))))

export reserve-class(?kind: Text): Bool
  ?kind = "agent"

# The request is charged and used as MemoryHigh for this client only.
export native-memory-request(?kind: Text, ?cores: F64, ?memory-gib: F64): Resources
  ?base: resource-class(?kind, ?cores)
  require(?kind = "native" and ?memory-gib > 0,
    {cpus: ?base.cpus, memoryMiB: ?memory-gib * 1024},
    "--memory-gib requires a positive native memory request")

export batch-class(?kind: Text): Bool
  ?kind = "moderate" or ?kind = "heavy" or ?kind = "exclusive"

# Longest hold per class in seconds. Exclusive work is short so it cannot
# starve the queue it drains; every batch lease ends by its deadline.
export maximum-seconds(?kind: Text): F64
  if(?kind = "exclusive", 900, 3600)

# Default deadline for a session; 0 means none (native clients only).
export session-seconds(?kind: Text): F64
  if(?kind = "exclusive", 900, if(batch-class(?kind), 1800, 0))

# Batch work runs at low CPU weight and only takes cycles the desktop and native
# clients leave idle. Present, it also yields while a protected slice itself
# waits. In every profile moderate and heavy work waits its turn while declared
# batch ceilings would pass the aggregate limit or system CPU pressure shows the
# cores already oversubscribed. A waiting exclusive request drains the machine
# of heavy work: no heavy work starts after it is queued, and it starts once
# running batch leases end, whatever the pressure. Moderate work (builds,
# dependency updates) keeps running beside it. Native clients are admitted on
# cores and memory, and wait while the GPU is busy; present, at most two
# Warcraft clients run at once, so the compositor keeps GPU time.
export batch-pressure-limit-basis-points(): F64
  3000

export gpu-busy-limit-percent(): F64
  85

export native-gpu-decision(?profile: Text, ?gpu-busy-percent: F64, ?gpu-clients: F64): Text
  if(?profile = "attended" and ?gpu-clients >= 2, "DEFER_GPU_CLIENTS",
    if(?gpu-busy-percent >= gpu-busy-limit-percent(), "DEFER_GPU_BUSY", "RUN"))

export admission-decision(?profile: Text, ?kind: Text, ?cores: F64, ?memory-total-mib: F64, ?memory-available-mib: F64, ?cpu-some-avg10-basis-points: F64, ?protected-cpu-some-avg10-basis-points: F64, ?leased-memory-mib: F64, ?leased-batch-cpus: F64, ?leased-native-cpus: F64, ?requested-cpus: F64, ?requested-memory-mib: F64, ?peer-batch-runs: F64, ?peer-exclusive-runs: F64, ?unbounded-runs: F64, ?queued-ahead: F64, ?exclusive-waiting: F64, ?gpu-busy-percent: F64, ?gpu-clients: F64): Text
  require(?profile = "attended" or ?profile = "unattended", if(?cores <= 0 or ?memory-total-mib <= 0 or ?memory-available-mib <= 0 or ?requested-cpus < 0 or ?requested-memory-mib <= 0, "INVALID",
    if(?memory-available-mib - ?requested-memory-mib < memory-floor-mib(?profile, ?memory-total-mib), "DEFER_MEMORY_HEADROOM",
      if((?leased-memory-mib + ?requested-memory-mib) * 4 > ?memory-total-mib * 3, "DEFER_MEMORY_CAPACITY",
        if(?kind = "agent", "RUN",
          if(?kind = "native",
            if(?leased-native-cpus + ?requested-cpus > aggregate-cpus(?profile, ?cores), "DEFER_NATIVE_CPUS",
              native-gpu-decision(?profile, ?gpu-busy-percent, ?gpu-clients)),
            if(?unbounded-runs > 0, "DEFER_UNBOUNDED_PEER",
              if(?peer-exclusive-runs > 0, "DEFER_EXCLUSIVE",
                if(?kind = "exclusive",
                  if(?exclusive-waiting > 0, "DEFER_QUEUED",
                    if(?peer-batch-runs > 0, "DEFER_EXCLUSIVE", "RUN")),
                  if(?exclusive-waiting > 0 and ?kind = "heavy", "DEFER_EXCLUSIVE_QUEUED",
                    if(?profile = "attended" and ?protected-cpu-some-avg10-basis-points >= 1000, "DEFER_INTERACTIVE_PRESSURE",
                      if(?queued-ahead > 0, "DEFER_QUEUED",
                        if(?leased-batch-cpus + ?requested-cpus > aggregate-cpus(?profile, ?cores), "DEFER_CPU_CAPACITY",
                          if(?cpu-some-avg10-basis-points > batch-pressure-limit-basis-points(), "DEFER_CPU_PRESSURE", "RUN"))))))))))))), "Unknown capacity profile")
