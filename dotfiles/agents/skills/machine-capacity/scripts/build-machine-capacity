#!/usr/bin/env bash
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
output=${1:-"$here/machine-capacity.mjs"}
bun=${BUN_PATH:-$(command -v bun || true)}
[[ -n "$bun" && -x "$bun" ]] || {
  printf 'machine-capacity build: Bun is unavailable\n' >&2
  exit 1
}

"$bun" build "$here/machine-capacity-host.mjs" \
  --target=bun \
  --minify \
  --outfile "$output" \
  --banner '#!/usr/bin/env bun'
chmod +x "$output"
