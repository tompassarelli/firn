#lang beagle/js
(ns todo.cross-supervisor-mailbox)

(defn text-index-from
  [text String
   needle String
   start Int] Int
  (cond
    (= needle "") start
    (> (+ start (count needle)) (count text)) -1
    (= (subs text start (+ start (count needle))) needle) start
    :else (text-index-from text needle (+ start 1))))

(defn starts-at?
  [text String
   index Int
   prefix String] Bool
  (and (>= index 0)
       (<= (+ index (count prefix)) (count text))
       (= (subs text index (+ index (count prefix))) prefix)))

(defn token-end
  [text String
   start Int] Int
  (let [ending Int (text-index-from text " " start)]
    (if (< ending 0) (count text) ending)))

(defn digits-from?
  [text String
   index Int] Bool
  (if (>= index (count text))
    true
    (if (>= (text-index-from "0123456789" (subs text index (+ index 1)) 0) 0)
      (digits-from? text (+ index 1))
      false)))

(defn valid-positive-int? [text String] Bool
  (let [value (U Int Nil) (parse-long text)]
    (and (> (count text) 0)
         (digits-from? text 0)
         (some? value)
         (> value 0))))

(defn envelope
  [line String
   channel String
   sender String
   receiver String
   status String] (Vec String)
  (let [timestamp-start Int 3
        timestamp-end Int (text-index-from line "]" timestamp-start)
        prefix String (str "[" channel "][" sender " -> " receiver "]["
          status "] ")]
    (if (and (starts-at? line 0 "- [")
             (> timestamp-end timestamp-start)
             (starts-at? line (+ timestamp-end 1) prefix))
      [(subs line timestamp-start timestamp-end)
       (subs line (+ timestamp-end 1 (count prefix)) (count line))]
      [])))

(js/export
 (defn peer-open-facts
   [line String
    channel String
    peer-sender String
    local-receiver String
    now-ms Int] (Vec String)
   (let [parts (Vec String) (envelope line channel peer-sender local-receiver "OPEN")]
     (if (not= (count parts) 2)
       []
       (let [timestamp String (nth parts 0)
             body String (nth parts 1)
             event-start Int 6
             event-end Int (token-end body event-start)
             session-label String " session="
             session-start Int (+ event-end (count session-label))
             session-end Int (token-end body session-start)
             round-label String " round="
             round-start Int (+ session-end (count round-label))
             round-end Int (token-end body round-start)
             proof-label String " proof="
             proof-start Int (+ round-end (count proof-label))
             proof-end Int (token-end body proof-start)
             expires-label String " expires="
             expires-start Int (+ proof-end (count expires-label))
             expires-end Int (token-end body expires-start)
             message-label String " message="
             message-start Int (+ expires-end (count message-label))]
         (if (and (starts-at? body 0 "event=")
                  (> event-end event-start)
                  (starts-at? body event-end session-label)
                  (> session-end session-start)
                  (starts-at? body session-end round-label)
                  (> round-end round-start)
                  (starts-at? body round-end proof-label)
                  (> proof-end proof-start)
                  (starts-at? body proof-end expires-label)
                  (> expires-end expires-start)
                  (starts-at? body expires-end message-label)
                  (> (count body) message-start)
                  (valid-positive-int? (subs body round-start round-end)))
           (let [expires-text String (subs body expires-start expires-end)
                 expires (U Int Nil) (parse-long expires-text)]
             (if (and (valid-positive-int? expires-text)
                      (some? expires)
                      (> expires now-ms))
               [timestamp
                (subs body event-start event-end)
                (subs body session-start session-end)
                (subs body round-start round-end)
                (subs body proof-start proof-end)
                expires-text
                (subs body message-start (count body))]
               []))
           []))))))

(js/export
 (defn received-facts
   [line String
    channel String
    sender String
    receiver String] (Vec String)
   (let [parts (Vec String) (envelope line channel sender receiver "RECEIVED")]
     (if (not= (count parts) 2)
       []
       (let [timestamp String (nth parts 0)
             body String (nth parts 1)
             event-start Int 6
             event-end Int (token-end body event-start)
             reply-label String " reply-to="
             reply-start Int (+ event-end (count reply-label))
             reply-end Int (token-end body reply-start)
             session-label String " session="
             session-start Int (+ reply-end (count session-label))
             session-end Int (token-end body session-start)
             round-label String " round="
             round-start Int (+ session-end (count round-label))
             round-end Int (token-end body round-start)
             proof-label String " proof="
             proof-start Int (+ round-end (count proof-label))
             proof-end Int (token-end body proof-start)
             received-session-label String " received-session="
             received-session-start Int (+ proof-end (count received-session-label))
             received-session-end Int (token-end body received-session-start)]
         (if (and (starts-at? body 0 "event=")
                  (> event-end event-start)
                  (starts-at? body event-end reply-label)
                  (> reply-end reply-start)
                  (starts-at? body reply-end session-label)
                  (> session-end session-start)
                  (starts-at? body session-end round-label)
                  (> round-end round-start)
                  (starts-at? body round-end proof-label)
                  (> proof-end proof-start)
                  (starts-at? body proof-end received-session-label)
                  (> received-session-end received-session-start)
                  (= received-session-end (count body))
                  (valid-positive-int? (subs body round-start round-end)))
           [timestamp
            (subs body event-start event-end)
            (subs body reply-start reply-end)
            (subs body session-start session-end)
            (subs body round-start round-end)
            (subs body proof-start proof-end)
            (subs body received-session-start received-session-end)]
           []))))))
