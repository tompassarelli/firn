#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == rebuild && "${2:-}" == --landed ]]; then
  if [[ "$#" != 3 ]]; then
    printf 'usage: firn rebuild --landed SHA\n' >&2
    exit 64
  fi
  firn_source="$(dirname "$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")")"
  status=0
  /run/current-system/sw/bin/python3 "$firn_source/modules/landed-rebuild/landed-rebuild.py" client "$3" || status=$?
  if [[ "$status" == 0 ]]; then
    generation="$(basename "$(readlink "${FIRN_SYSTEM_PROFILE:-/nix/var/nix/profiles/system}")")"
    generation="${generation#system-}"
    git -C "${FIRN_REPO:-$firn_source}" tag -f "gen-${generation%-link}" "$3" >/dev/null
  fi
  exit "$status"
fi

firn_repo="${FIRN_REPO:-}"
if [[ -z "$firn_repo" ]]; then
  checkout="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ -n "$checkout" && -f "$checkout/flake.nix" && -f "$checkout/dotfiles/bin/firn" ]]; then
    firn_repo="$checkout"
  else
    firn_repo="$HOME/code/nixos-config/main" # hardcoded-repo-path:allow
  fi
fi
if [[ "${1:-}" == repo && "${2:-}" == doctor ]]; then
  "$(dirname "$(readlink -f "$0")")/update-status"
fi
runtime_root="${FIRN_RUNTIME_ROOT:-$HOME/.local/lib/firn/cli}"
runtime_bin="$runtime_root/current/bin"
firn_source="$(dirname "$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")")"
runtime="$firn_source/native/firn_host.mjs"
bun="${FIRN_BUN:-$runtime_bin/bun}"

if [[ ! -f "$runtime" || ! -x "$bun" ]]; then
  printf 'firn: user runtime is not installed; run firn-runtime-update\n' >&2
  exit 127
fi

export FIRN_REPO="$firn_repo"
export FIRN_RUNTIME_BIN="$runtime_bin"
exec "$bun" "$runtime" "$@"
