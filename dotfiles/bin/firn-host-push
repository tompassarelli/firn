#!/usr/bin/env bash
set -euo pipefail

host="${1:?usage: firn-host-push HOST  (FIRN_DEPLOY_REPO names a checkout at origin/main of the repo the host upgrades from)}"
repo="${FIRN_DEPLOY_REPO:-$PWD}"
state="${XDG_STATE_HOME:-$HOME/.local/state}/firn/host-follow"
key="$state/signing-key"
quiet="${FIRN_PUSH_QUIET:-30}"
mkdir -p "$state"
remote() { ssh -o BatchMode=yes -o ConnectTimeout=15 "$host" "$@"; }
remote true || { printf 'firn host push: %s does not answer, so nothing is deployed to it\n' "$host" >&2; exit 1; }

if ! remote systemctl cat nexus-deploy@x.service >/dev/null 2>&1; then
  printf 'firn host push: %s has no nexus-deploy@ unit; deploying through its upgrade unit\n' "$host"
  exec "${FIRN_HOST_DEPLOY:-firn-host-deploy}" "$host"
fi

head="$(git -C "$repo" rev-parse HEAD)"
origin="$(git -C "$repo" remote get-url origin)"
waited=0
while ((waited < quiet)); do
  sleep 10
  waited=$((waited + 10))
  if [[ "$(git ls-remote "$origin" refs/heads/main | cut -f1)" != "$head" ]]; then
    printf 'firn host push: main moved past %s; the next run deploys the newest main once it is quiet\n' "${head:0:8}"
    exit 0
  fi
done

name="$(remote hostname)"
builder="${FIRN_PUSH_BUILDER:-}"
if [[ -n "$builder" ]]; then
  src="github:$(printf '%s' "$origin" | sed -E 's#^.*github\.com[/:]##; s#\.git$##')/$head"
  nixc() { ssh -o BatchMode=yes -o ConnectTimeout=15 "$builder" "$(printf '%q ' nix "$@")"; }
else
  if reason="$("${FIRN_HOST_BUSY:-firn-host-busy}")"; then
    printf 'firn host push: deferring %s to %s: %s, so this machine builds nothing; set FIRN_PUSH_BUILDER to build elsewhere\n' "${head:0:8}" "$host" "$reason"
    exit 75
  fi
  src="$repo"
  nixc() { nix "$@"; }
fi
attr="$src#nixosConfigurations.$name"
runs="$(remote readlink /run/current-system)"
revision="$(remote nixos-version --configuration-revision || true)"
if [[ "$revision" =~ ^[0-9a-f]{40}$ ]]; then
  same="$(nixc eval --raw "$attr" --apply "c: (c.extendModules { modules = [ ({ lib, ... }: { system.configurationRevision = lib.mkOverride 0 \"$revision\"; }) ]; }).config.system.build.toplevel.outPath")"
  if [[ "$runs" == "$same" ]]; then
    printf 'firn host push: %s changes nothing on %s at %s apart from its revision: it runs %s; no deploy\n' "${head:0:8}" "$host" "$name" "$runs"
    exit 0
  fi
fi

[[ -f "$key" ]] || (umask 077 && nix key generate-secret --key-name "${HOSTNAME:-follower}-deploy-1" >"$key")
top="$(nixc build --no-link --print-out-paths "$attr.config.system.build.toplevel")"
export NIX_SSHOPTS='-o BatchMode=yes -o ConnectTimeout=15'
if [[ -n "$builder" ]]; then
  nixc store sign --key-file "${FIRN_PUSH_BUILDER_KEY:-$key}" --recursive "$top"
  nix copy --substitute-on-destination --from "ssh-ng://$builder" --to "ssh-ng://$host" "$top"
else
  nix store sign --key-file "$key" --recursive "$top"
  nix copy --substitute-on-destination --to "ssh-ng://$host" "$top"
fi

unit="nexus-deploy@$(systemd-escape --path "$top").service"
printf 'starting %s on %s for %s %s\n' "${unit%%@*}" "$host" "$name" "${head:0:8}"
remote systemctl start "$(printf '%q' "$unit")" || {
  remote journalctl -u "$(printf '%q' "$unit")" -n 20 --no-pager -o cat >&2 || true
  exit 1
}

booted="$(remote readlink /run/current-system)"
staged="$(remote readlink /nix/var/nix/profiles/system)"
[[ "$booted" == "$top" || "$staged" == "$top" ]] || { printf 'firn host push: %s runs %s and staged %s, not %s\n' "$host" "$booted" "$staged" "$top" >&2; exit 1; }
[[ "$booted" == "$top" ]] && printf '%s runs %s (%s)\n' "$host" "$top" "$head" || printf '%s staged %s for its next boot, because the kernel, initrd or modules changed\n' "$host" "$top"
