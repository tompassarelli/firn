#!/usr/bin/env bash
set -euo pipefail

firn_repo="${FIRN_REPO:-$HOME/code/nixos-config/main}" # hardcoded-repo-path:allow
host="${1:-whiterabbit}"
name="$host-environment"
ref="${2:-git+file://$firn_repo}#$name"
shift $(($# < 2 ? $# : 2))

nix build --no-link "$ref" "$@"
exec "${FIRN_RUNTIME_ROOT:-$HOME/.local/lib/firn/cli}/current/bin/firn-tools" profile replace "$name" "$ref" "$@"
