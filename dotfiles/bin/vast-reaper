#!/usr/bin/env bun
import { appendFileSync, existsSync, mkdirSync, readFileSync, writeFileSync } from "fs";
import { hostname } from "os";

const USAGE = `usage: vast-reaper [--dry-run]
       vast-reaper floor-decide < {credit, instances, keys, state}

Destroys every vast.ai instance whose vast-job label deadline has passed, or whose
vast-job supervisor on this host is no longer running, then verifies it is gone and
removes that job's SSH key. Instances without a vast-job label are reported and left
alone. Exit 3 when a destroy is not verified.

Credit floor for the runner VM (label vast-launch-check): at credit <= $5.00 one
notify-send warning and incident per crossing; at credit <= $2.50 delete the
FARM_RUNNER variable on the farm repos, destroy the VM and remove its SSH key.
floor-decide prints the floor actions for recorded inputs without side effects.`;

const VASTAI = process.env.VAST_JOB_VASTAI ?? `${process.env.HOME}/.local/bin/vastai`;
const SECRETS = `${process.env.HOME}/code/nixos-config/main/secrets/vastai.yaml`;
const LABEL = /^vast-job-(.+)-(\d+)-(\d{10})-([a-z0-9]+)$/;
const OLD_LABEL = /^vast-job-\d{13}-[a-z0-9]+$/;

type Inst = { id: number; label?: string | null; actual_status?: string };
type Verdict = { id: number; label: string; action: "destroy" | "keep" | "report"; why: string };

export function decide(insts: Inst[], nowS: number, host: string, live: (pid: number) => boolean, anyLive: boolean): Verdict[] {
  return insts.map((i) => {
    const label = String(i.label ?? "");
    const m = label.match(LABEL);
    if (m) {
      const [, h, pid, deadline] = m;
      if (nowS >= Number(deadline)) return { id: i.id, label, action: "destroy", why: `deadline ${new Date(Number(deadline) * 1000).toISOString()} passed` };
      if (h === host && !live(Number(pid))) return { id: i.id, label, action: "destroy", why: `supervisor pid ${pid} is not running` };
      return { id: i.id, label, action: "keep", why: h === host ? `supervisor pid ${pid} running` : `job of host ${h}, deadline ahead` };
    }
    if (OLD_LABEL.test(label)) return anyLive ? { id: i.id, label, action: "keep", why: "old-format label while a vast-job runs" } : { id: i.id, label, action: "destroy", why: "old-format label and no vast-job running" };
    return { id: i.id, label, action: "report", why: "no vast-job label; left alone" };
  });
}

export const RUNNER_LABEL = "vast-launch-check";
export const FARM_REPOS = ["tompassarelli/smashcraft", "tompassarelli/wisp"];
export const WARN_AT = 5;
export const TEARDOWN_AT = 2.5;
type Key = { id: number; public_key?: string; ssh_key?: string };
type FloorState = { warned: boolean };
type FloorAction =
  | { kind: "warn"; message: string }
  | { kind: "unset-farm-runner"; repos: string[] }
  | { kind: "destroy"; id: number }
  | { kind: "delete-key"; id: number };

const keyComment = (k: Key) => String(k.public_key ?? k.ssh_key ?? "").trim().split(/\s+/).at(-1) ?? "";

export function creditFloor(credit: number, insts: Inst[], keys: Key[], state: FloorState): { actions: FloorAction[]; state: FloorState } {
  const runners = insts.filter((i) => i.label === RUNNER_LABEL);
  const runnerKeys = keys.filter((k) => keyComment(k) === RUNNER_LABEL);
  if (credit > WARN_AT) return { actions: [], state: { warned: false } };
  const actions: FloorAction[] = [];
  let warned = state.warned;
  if (runners.length && !warned) {
    actions.push({ kind: "warn", message: `vast.ai credit $${credit.toFixed(2)} <= $${WARN_AT.toFixed(2)}; runner VM ${runners.map((r) => r.id).join(" ")} is torn down at $${TEARDOWN_AT.toFixed(2)}` });
    warned = true;
  }
  if (credit <= TEARDOWN_AT) {
    if (runners.length) actions.push({ kind: "unset-farm-runner", repos: FARM_REPOS }, ...runners.map((r) => ({ kind: "destroy" as const, id: r.id })));
    actions.push(...runnerKeys.map((k) => ({ kind: "delete-key" as const, id: k.id })));
  }
  return { actions, state: { warned } };
}

function cmdline(pid: number): string {
  try {
    return readFileSync(`/proc/${pid}/cmdline`, "utf8").replaceAll("\0", " ");
  } catch {
    return "";
  }
}
function isVastJob(pid: number) {
  return /(^|\/|\s)vast-job(\s|$)/.test(cmdline(pid));
}
function anyVastJob() {
  for (const d of new Bun.Glob("[0-9]*").scanSync({ cwd: "/proc", onlyFiles: false })) if (isVastJob(Number(d))) return true;
  return false;
}

function log(line: string) {
  process.stdout.write(`vast-reaper: ${line}\n`);
}

if (import.meta.main) {
  const argv = process.argv.slice(2);
  if (argv.includes("-h") || argv.includes("--help")) {
    console.log(USAGE);
    process.exit(0);
  }
  if (argv[0] === "floor-decide") {
    const i = JSON.parse(await Bun.stdin.text());
    console.log(JSON.stringify(creditFloor(i.credit, i.instances, i.keys, i.state)));
    process.exit(0);
  }
  const dry = argv.includes("--dry-run");
  if (!existsSync(SECRETS)) {
    log(`missing ${SECRETS}`);
    process.exit(2);
  }
  const decrypt = Bun.spawnSync(["sudo", "-n", "env", "SOPS_AGE_KEY_FILE=/var/lib/sops-nix/key.txt", "sops", "-d", "--extract", '["api_key"]', SECRETS], { stdout: "pipe", stderr: "pipe" });
  if (decrypt.exitCode !== 0) {
    log("could not decrypt the vast.ai API key");
    process.exit(2);
  }
  const env = { ...process.env, VAST_API_KEY: decrypt.stdout.toString().trim() };
  const vast = (...cmd: string[]): any => {
    const r = Bun.spawnSync(["timeout", "120", VASTAI, ...cmd, "--raw"], { stdout: "pipe", stderr: "pipe", env });
    if (r.exitCode !== 0) throw new Error(`vastai ${cmd.slice(0, 2).join(" ")} failed: ${(r.stderr.toString() || r.stdout.toString()).trim().slice(0, 300)}`);
    try {
      return JSON.parse(r.stdout.toString());
    } catch {
      return r.stdout.toString().trim();
    }
  };

  const insts: Inst[] = vast("show", "instances");
  const verdicts = decide(insts, Date.now() / 1000, hostname(), isVastJob, anyVastJob());
  let unverified = 0;
  for (const v of verdicts) {
    log(`instance ${v.id} (${v.label || "no label"}): ${v.action}, ${v.why}`);
    if (v.action !== "destroy" || dry) continue;
    try {
      vast("destroy", "instance", String(v.id), "-y");
    } catch (e: any) {
      log(`destroy ${v.id} failed: ${e.message}`);
    }
    let gone = false;
    for (let attempt = 0; attempt < 12 && !gone; attempt++) {
      Bun.sleepSync(10_000);
      const list = (() => { try { return vast("show", "instances"); } catch { return null; } })();
      gone = Array.isArray(list) && !list.some((i: Inst) => i.id === v.id);
    }
    log(gone ? `instance ${v.id} destroyed and verified gone` : `INSTANCE ${v.id} STILL PRESENT after destroy`);
    if (!gone) unverified++;
    const m = v.label.match(LABEL);
    if (!m) continue;
    const prefix = `vast-job-${m[1]}-${m[2]}-`;
    const keys = (() => { try { return vast("show", "ssh-keys"); } catch { return []; } })();
    for (const k of Array.isArray(keys) ? keys : []) {
      const comment = String(k.public_key ?? k.ssh_key ?? "").trim().split(/\s+/).at(-1) ?? "";
      if (!comment.startsWith(prefix) || !comment.endsWith(`-${m[4]}`)) continue;
      try {
        vast("delete", "ssh-key", String(k.id));
        log(`job SSH key ${k.id} removed`);
      } catch (e: any) {
        log(`delete ssh-key ${k.id} failed: ${e.message}`);
      }
    }
  }
  if (verdicts.length === 0) log("no instances");

  const STATE_DIR = `${process.env.HOME}/.local/state/vast-reaper`;
  const FLOOR_STATE = `${STATE_DIR}/credit-floor.json`;
  const INCIDENTS = `${process.env.HOME}/.local/state/agents/watchdog/incidents.md`;
  const incident = (summary: string) => {
    mkdirSync(`${process.env.HOME}/.local/state/agents/watchdog`, { recursive: true });
    appendFileSync(INCIDENTS, `- ${new Date().toISOString()} vast-credit-floor: ${summary}\n`);
  };
  const farmRunnerSet = (repo: string) => {
    const r = Bun.spawnSync(["gh", "variable", "list", "-R", repo, "--json", "name"], { stdout: "pipe", stderr: "pipe" });
    if (r.exitCode !== 0) return null;
    return (JSON.parse(r.stdout.toString()) as { name: string }[]).some((v) => v.name === "FARM_RUNNER");
  };
  const credit = Number(vast("show", "user").credit);
  const remaining = insts.filter((i) => verdicts.every((v) => v.id !== i.id || v.action !== "destroy" || dry));
  const keys = (() => { try { return vast("show", "ssh-keys"); } catch { return []; } })();
  const prev: FloorState = (() => { try { return JSON.parse(readFileSync(FLOOR_STATE, "utf8")); } catch { return { warned: false }; } })();
  const floor = creditFloor(credit, remaining, Array.isArray(keys) ? keys : [], prev);
  log(`credit $${credit.toFixed(2)}: ${floor.actions.length ? floor.actions.map((a) => a.kind).join(", ") : "no floor action"}`);
  let floorFailed = false;
  for (const a of dry ? [] : floor.actions) {
    if (a.kind === "warn") {
      Bun.spawnSync(["notify-send", "--urgency=critical", "vast.ai credit low", a.message]);
      incident(a.message);
    } else if (a.kind === "unset-farm-runner") {
      for (const repo of a.repos) {
        Bun.spawnSync(["gh", "variable", "delete", "FARM_RUNNER", "-R", repo], { stdout: "pipe", stderr: "pipe" });
        const set = farmRunnerSet(repo);
        log(set === false ? `FARM_RUNNER deleted on ${repo} and verified absent` : `FARM_RUNNER on ${repo} NOT verified absent`);
        if (set !== false) floorFailed = true;
      }
      incident(`credit $${credit.toFixed(2)} <= $${TEARDOWN_AT.toFixed(2)}: FARM_RUNNER deleted on ${a.repos.join(" ")}${floorFailed ? " (not verified on all)" : ""}`);
    } else if (a.kind === "destroy") {
      try { vast("destroy", "instance", String(a.id), "-y"); } catch (e: any) { log(`destroy ${a.id} failed: ${e.message}`); }
      let gone = false;
      for (let attempt = 0; attempt < 12 && !gone; attempt++) {
        Bun.sleepSync(10_000);
        const list = (() => { try { return vast("show", "instances"); } catch { return null; } })();
        gone = Array.isArray(list) && !list.some((i: Inst) => i.id === a.id);
      }
      log(gone ? `runner VM ${a.id} destroyed and verified gone` : `RUNNER VM ${a.id} STILL PRESENT after destroy`);
      incident(gone ? `runner VM ${a.id} destroyed at credit $${credit.toFixed(2)}` : `runner VM ${a.id} still present after destroy at credit $${credit.toFixed(2)}`);
      if (!gone) { floorFailed = true; break; }
    } else if (a.kind === "delete-key") {
      try {
        vast("delete", "ssh-key", String(a.id));
        log(`runner SSH key ${a.id} removed`);
      } catch (e: any) {
        log(`delete ssh-key ${a.id} failed: ${e.message}`);
        floorFailed = true;
      }
    }
  }
  if (!dry) {
    mkdirSync(STATE_DIR, { recursive: true });
    writeFileSync(FLOOR_STATE, JSON.stringify(floor.state));
  }
  process.exit(unverified || floorFailed ? 3 : 0);
}
