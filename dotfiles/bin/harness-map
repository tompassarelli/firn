#!/usr/bin/env bun
// harness-map — read-only introspection of the Claude Code session bootstrap
// on this machine. Never writes anything; output is markdown to stdout.
// Usage: harness-map

import { readFileSync, existsSync, readlinkSync, lstatSync, readdirSync } from "node:fs";
import { join, dirname } from "node:path";
import { execSync } from "node:child_process";

const HOME = process.env.HOME;

// ── helpers ────────────────────────────────────────────────────────────────

function tilde(p) {
  return p.startsWith(HOME) ? "~" + p.slice(HOME.length) : p;
}

function readJSON(p) {
  try { return JSON.parse(readFileSync(p, "utf8")); } catch { return null; }
}

function readText(p) {
  try { return readFileSync(p, "utf8"); } catch { return null; }
}

function lineCount(p) {
  const t = readText(p);
  if (!t) return null;
  return t.split("\n").length;
}

function firstHeading(p) {
  const t = readText(p);
  if (!t) return null;
  for (const line of t.split("\n")) {
    const m = line.match(/^#{1,3}\s+(.+)/);
    if (m) return m[1].trim();
    // also bare title lines (non-empty, no leading #)
    if (line.trim() && !line.startsWith("#")) return line.trim().slice(0, 80);
  }
  return null;
}

function symTarget(p) {
  try {
    const stat = lstatSync(p);
    if (stat.isSymbolicLink()) {
      const target = readlinkSync(p);
      // target may be relative; resolve against symlink's directory
      const resolved = target.startsWith("/") ? target : join(dirname(p), target);
      return { isLink: true, target: resolved, targetExists: existsSync(resolved) };
    }
    return { isLink: false, target: p, targetExists: true };
  } catch { return null; }
}

function exists(p) {
  return existsSync(p);
}

function frontmatter(text) {
  const m = text.match(/^---\n([\s\S]*?)\n---/);
  if (!m) return {};
  const out = {};
  for (const line of m[1].split("\n")) {
    const kv = line.match(/^(\w[\w-]*):\s*(.+)/);
    if (kv) out[kv[1]] = kv[2].trim();
  }
  return out;
}

function listDir(p) {
  try { return readdirSync(p); } catch { return []; }
}

// Print without trailing newline accumulation
const out = [];
function emit(s) { out.push(s); }

// ── gather data ────────────────────────────────────────────────────────────

const CLAUDE_DIR = `${HOME}/.claude`;

// 1a. Settings
const settingsPath = `${CLAUDE_DIR}/settings.json`;
const settingsLocal = `${CLAUDE_DIR}/settings.local.json`;
const settingsSym = symTarget(settingsPath);
const settings = readJSON(settingsPath) || {};
const settingsLc = readJSON(settingsLocal) || {};

const envVars = settings.env ? Object.keys(settings.env) : [];
const permsAllow = (settings.permissions?.allow || []).length +
                   (settingsLc.permissions?.allow || []).length;

// Collect all hooks from settings
function collectHooks(src, label) {
  const hooks = src.hooks || {};
  const rows = [];
  for (const [event, matchers] of Object.entries(hooks)) {
    for (const matcher of matchers) {
      for (const h of (matcher.hooks || [])) {
        rows.push({ event, matcher: matcher.matcher || "*", command: h.command, label });
      }
    }
  }
  return rows;
}

const settingsHooks = collectHooks(settings, "settings.json");
const settingsLocalHooks = collectHooks(settingsLc, "settings.local.json");

// 1b. Memory chain
const claudeMdPath = `${CLAUDE_DIR}/CLAUDE.md`;
const claudeMdSym = symTarget(claudeMdPath);
const claudeMdLines = lineCount(claudeMdPath);

const exampleClaudes = [
  `${HOME}/code/CLAUDE.md`,
  `${HOME}/code/nixos-config/CLAUDE.md`,
];

// Breadcrumb paths from global CLAUDE.md
function breadcrumbsFrom(p) {
  const text = readText(p);
  if (!text) return [];
  const refs = [];
  for (const line of text.split("\n")) {
    const m = line.match(/→\s+`(~\/[^`]+)`/g);
    if (m) for (const hit of m) {
      const path = hit.match(/`([^`]+)`/)[1];
      refs.push(path.replace("~", HOME));
    }
  }
  return [...new Set(refs)];
}
const claudeBreadcrumbs = breadcrumbsFrom(claudeMdPath);

// 1c. Plugins
const installedPluginsPath = `${CLAUDE_DIR}/plugins/installed_plugins.json`;
const knownMarketplacesPath = `${CLAUDE_DIR}/plugins/known_marketplaces.json`;
const installedPlugins = readJSON(installedPluginsPath)?.plugins || {};
const knownMarketplaces = readJSON(knownMarketplacesPath) || {};

function pluginInstallPath(key, install) {
  // install path from the record
  return install.installPath || "";
}

function pluginPluginJson(installPath) {
  // Try .claude-plugin/plugin.json first, then plugin.json at root
  const paths = [
    `${installPath}/.claude-plugin/plugin.json`,
    `${installPath}/plugin.json`,
  ];
  for (const p of paths) {
    const d = readJSON(p);
    if (d) return d;
  }
  return null;
}

function pluginSourcePath(key) {
  const marketplace = key.split("@")[1];
  const mkt = knownMarketplaces[marketplace];
  if (!mkt) return null;
  if (mkt.source?.source === "directory") return mkt.source.path;
  return null; // github — no local path
}

// Collect plugin details
const pluginDetails = [];
for (const [key, installs] of Object.entries(installedPlugins)) {
  const latestInstall = installs[installs.length - 1];
  const installPath = pluginInstallPath(key, latestInstall);
  const pjson = pluginPluginJson(installPath);
  const sourcePath = pluginSourcePath(key);

  // skills/agents from install path
  const skillsDir = `${installPath}/skills`;
  const agentsDir = `${installPath}/agents`;
  const skillNames = listDir(skillsDir);
  const agentNames = listDir(agentsDir).filter(f => f.endsWith(".md"));

  // marketplace source info
  const marketplace = key.split("@")[1];
  const mkt = knownMarketplaces[marketplace];
  const source = mkt?.source?.source === "directory"
    ? `local:${mkt.source.path}`
    : mkt?.source?.source === "github"
      ? `github:${mkt.source.repo}`
      : "unknown";

  pluginDetails.push({
    key,
    name: pjson?.name || key.split("@")[0],
    source,
    installPath,
    installPathExists: exists(installPath),
    sourcePath,
    pluginJson: pjson,
    hooks: pjson ? collectHooks(pjson, key) : [],
    skillNames,
    agentNames,
    scope: latestInstall.scope,
  });
}

// 1d. SessionStart injections
function sessionStartInjection(h) {
  // If command is `cat <file>`, extract file (handles quoted and unquoted paths)
  const m = (h.command || "").match(/^cat\s+"?([^"]+)"?\s*$/);
  if (m) {
    const file = m[1]
      .replace(/\$\{CLAUDE_PLUGIN_ROOT\}|\$CLAUDE_PLUGIN_ROOT/g, h.pluginRoot || "")
      .replace(/\$\{HOME\}|\$HOME/g, HOME);
    return { type: "cat", file };
  }
  return { type: "script", file: null };
}

const allSessionStartHooks = [
  ...settingsHooks.filter(h => h.event === "SessionStart"),
  ...pluginDetails.flatMap(p =>
    p.hooks
      .filter(h => h.event === "SessionStart")
      .map(h => ({ ...h, plugin: p.key, pluginRoot: p.installPath }))
  ),
];

// 1e. Skills registry
const personalSkillsDir = `${HOME}/code/nixos-config/dotfiles/agents/skills`;
const nixSkillsDir = `${HOME}/.claude/skills`; // symlink
const personalSkills = listDir(personalSkillsDir);
const pluginSkills = pluginDetails.flatMap(p => p.skillNames.map(s => ({ plugin: p.key, name: s })));

// 1f. Agents registry
const personalAgentsDir = `${HOME}/.claude/agents`; // symlink → nix store
const agentsSym = symTarget(personalAgentsDir);
// use raw symlink target even if it doesn't exist (broken symlink = GC'd nix store)
const nixAgentsDir = agentsSym?.target || personalAgentsDir;
const nixAgentFiles = agentsSym?.targetExists ? listDir(nixAgentsDir).filter(f => f.endsWith(".md")) : [];

function agentFrontmatter(dir, file) {
  const text = readText(`${dir}/${file}`);
  if (!text) return {};
  return frontmatter(text);
}

const personalAgentDetails = nixAgentFiles.map(f => {
  const fm = agentFrontmatter(nixAgentsDir, f);
  return { name: f.replace(".md", ""), model: fm.model, effortLevel: fm["effort_level"] || fm.effortLevel };
});

const pluginAgentDetails = pluginDetails.flatMap(p =>
  p.agentNames.map(f => {
    const fm = agentFrontmatter(p.installPath + "/agents", f);
    return { name: f.replace(".md", ""), plugin: p.key, model: fm.model, effortLevel: fm["effort_level"] || fm.effortLevel };
  })
);

// 1g. MCP servers
function collectMcpServers(obj) {
  if (!obj || !obj.mcpServers) return [];
  return Object.entries(obj.mcpServers).map(([name, cfg]) => ({
    name,
    command: cfg.command || (cfg.type === "sse" ? `sse:${cfg.url}` : JSON.stringify(cfg)),
  }));
}

const mcpFromSettings = collectMcpServers(settings);
const mcpJsonPaths = [
  `${CLAUDE_DIR}/.mcp.json`,
  `${HOME}/code/.mcp.json`,
];
const mcpServers = [...mcpFromSettings];
for (const p of mcpJsonPaths) {
  const d = readJSON(p);
  if (d) mcpServers.push(...collectMcpServers(d));
}

// 1h. North harness constants
const harnessPath = `${HOME}/code/north/sdk/src/harness.ts`;
const harnessText = readText(harnessPath) || "";
const praxisDirMatch = harnessText.match(/const PRAXIS_DIR\s*=\s*`([^`]+)`/);
const praxisDir = praxisDirMatch
  ? praxisDirMatch[1].replace("${process.env.HOME}", HOME)
  : null;
const appendixFns = ["globalLawsAppendix", "cavemanAppendix", "esoAppendix", "praxisAppendix"]
  .filter(fn => harnessText.includes(`function ${fn}(`));

// ── rot audit data ──────────────────────────────────────────────────────────

const flags = [];
const passes = [];

function check(label, path, condition) {
  const ok = condition !== undefined ? condition : exists(path);
  if (ok) passes.push(`PASS  ${label}`);
  else flags.push(`FLAG  ${label}  →  ${tilde(path)}`);
  return ok;
}

// Breadcrumbs
for (const p of claudeBreadcrumbs) {
  check(`breadcrumb ${tilde(p)}`, p);
}

// Plugin install paths and source paths
for (const p of pluginDetails) {
  check(`plugin install ${p.key}`, p.installPath, p.installPathExists);
  if (p.sourcePath) check(`plugin source ${p.key}`, p.sourcePath);
}

// ~/.claude/* symlinks
const claudeSymlinks = ["CLAUDE.md", "settings.json", "agents", "skills", "hooks", "commands"];
for (const name of claudeSymlinks) {
  const p = `${CLAUDE_DIR}/${name}`;
  const sym = symTarget(p);
  if (!sym) { flags.push(`FLAG  ~/.claude/${name}  →  not found`); continue; }
  if (sym.isLink) {
    if (sym.targetExists) passes.push(`PASS  ~/.claude/${name} → ${tilde(sym.target)}`);
    else flags.push(`FLAG  ~/.claude/${name} → ${tilde(sym.target)}  (broken symlink — target missing)`);
  } else {
    passes.push(`PASS  ~/.claude/${name} (not a symlink, exists)`);
  }
}

// North PRAXIS_DIR
if (praxisDir) {
  check("north PRAXIS_DIR exists", praxisDir);
  check("north PRAXIS_DIR/roles.md", `${praxisDir}/roles.md`);
  check("north PRAXIS_DIR/postures.md", `${praxisDir}/postures.md`);
  check("north PRAXIS_DIR/comms.md", `${praxisDir}/comms.md`);
  check("north PRAXIS_DIR/deltas/ dir", `${praxisDir}/deltas`);
} else {
  flags.push("FLAG  north PRAXIS_DIR  →  not found in harness.ts");
}

// gaffer build-agents check
const gafferCheck = (() => {
  const script = `${HOME}/code/gaffer/scripts/build-agents.mjs`;
  if (!exists(script)) return { ok: false, reason: "script not found" };
  try {
    execSync(`node ${script} --check`, { stdio: "pipe", timeout: 15000 });
    return { ok: true };
  } catch (e) {
    return { ok: false, reason: (e.stderr?.toString() || e.message || "nonzero exit").slice(0, 120) };
  }
})();
if (gafferCheck.ok) passes.push("PASS  gaffer build-agents --check");
else flags.push(`FLAG  gaffer build-agents --check  →  ${gafferCheck.reason}`);

// Personal agents/skills dirs — broken symlink already flagged in symlinks loop above; skip redundant check
if (agentsSym?.isLink && agentsSym.targetExists) {
  check("personal agents dir (nix store)", nixAgentsDir);
} else if (!agentsSym?.isLink) {
  check("personal agents dir", nixAgentsDir);
}
// (broken symlink case already flagged in the symlinks loop)
check("personal skills dir", personalSkillsDir, personalSkills.length > 0 || exists(personalSkillsDir));

// ── output ─────────────────────────────────────────────────────────────────

emit("# harness-map — Claude Code session bootstrap\n");

// ── Section 1: Bootstrap narrative ─────────────────────────────────────────

emit("## Bootstrap narrative\n");

// 1a. Settings
emit("### a. Settings\n");

function showSym(sym, path) {
  if (!sym) return tilde(path) + "  (not found)";
  if (sym.isLink) return `${tilde(path)}  →  ${tilde(sym.target)}`;
  return tilde(path);
}

emit(`- **${showSym(settingsSym, settingsPath)}**  (${lineCount(settingsPath) ?? "?"} lines)`);
emit(`  - symlink into nixos-config: yes`);
emit(`  - model: ${settings.model || "(not set)"}`);
emit(`  - effortLevel: ${settings.effortLevel || "(not set)"}`);
emit(`  - env vars: ${envVars.length ? envVars.join(", ") : "none"}`);
emit(`  - permissions allow count: ${(settings.permissions?.allow || []).length} (settings) + ${(settingsLc.permissions?.allow || []).length} (local)`);

const allHooks = [...settingsHooks, ...settingsLocalHooks];
if (allHooks.length > 0) {
  emit(`  - hooks:`);
  for (const h of allHooks) {
    emit(`    - **${h.event}** ${h.matcher !== "*" ? `[${h.matcher}]` : ""}  →  \`${h.command}\``);
  }
} else {
  emit(`  - hooks: none`);
}

if (exists(settingsLocal)) {
  emit(`\n- **${tilde(settingsLocal)}**  (${lineCount(settingsLocal) ?? "?"} lines)`);
  emit(`  - purpose: local permission overrides (not symlinked, machine-local)`);
}

// 1b. Memory chain
emit("\n### b. Memory chain\n");

emit(`- **${showSym(claudeMdSym, claudeMdPath)}**  (${claudeMdLines ?? "?"} lines)`);
emit(`  - role: global constitution — posture, authority, routing, standing guards`);

for (const p of exampleClaudes) {
  const sym = symTarget(p);
  const lc = lineCount(p);
  emit(`- **${showSym(sym, p)}**  (${lc ?? "missing"} lines)`);
  emit(`  - role: per-project rules, loaded when cwd matches`);
}

// 1c. Plugins
emit("\n### c. Plugins\n");

emit(`Known marketplaces: ${Object.keys(knownMarketplaces).join(", ")}\n`);

for (const p of pluginDetails) {
  emit(`#### ${p.name} (\`${p.key}\`)`);
  emit(`- source: \`${p.source}\``);
  emit(`- install path: \`${tilde(p.installPath)}\`  (exists: ${p.installPathExists})`);
  emit(`- scope: ${p.scope}`);

  if (p.hooks.length > 0) {
    emit(`- hooks:`);
    for (const h of p.hooks) {
      emit(`  - **${h.event}**  →  \`${h.command}\``);
    }
  } else {
    emit(`- hooks: none`);
  }

  if (p.agentNames.length > 0) {
    emit(`- agents (${p.agentNames.length}): ${p.agentNames.map(f => f.replace(".md","")).join(", ")}`);
  } else {
    emit(`- agents: none`);
  }

  if (p.skillNames.length > 0) {
    emit(`- skills (${p.skillNames.length}): ${p.skillNames.join(", ")}`);
  } else {
    emit(`- skills: none`);
  }
  emit("");
}

// 1d. SessionStart injections
emit("### d. SessionStart context injections\n");
emit("Each fires at session open; injected text lands in every session's context.\n");

for (const h of allSessionStartHooks) {
  const info = sessionStartInjection(h);
  const origin = h.plugin ? `plugin \`${h.plugin}\`` : h.label;
  emit(`#### ${origin} — \`${h.event}\``);
  emit(`- command: \`${h.command}\``);
  if (info.type === "cat" && info.file) {
    const heading = firstHeading(info.file) || "(no heading)";
    const lc = lineCount(info.file);
    emit(`- injects: \`${tilde(info.file)}\`  (${lc ?? "?"} lines)`);
    emit(`  - first heading: "${heading}"`);
  } else {
    emit(`- injects: (dynamic script output)`);
  }
  emit("");
}

// 1e. Skills registry
emit("### e. Skills registry\n");

emit(`**Personal skills** (\`${tilde(personalSkillsDir)}\`): ${personalSkills.length ? personalSkills.join(", ") : "(none)"}\n`);

for (const p of pluginDetails) {
  if (p.skillNames.length > 0) {
    emit(`**Plugin \`${p.key}\`** skills: ${p.skillNames.join(", ")}`);
  }
}
emit("");

// 1f. Agents registry
emit("### f. Agents registry\n");

const agentsDirNote = agentsSym?.isLink
  ? (agentsSym.targetExists ? ` → \`${tilde(nixAgentsDir)}\`` : ` → \`${tilde(nixAgentsDir)}\` ⚠ broken symlink`)
  : "";
emit(`**Personal agents** (\`${tilde(personalAgentsDir)}\`${agentsDirNote}):`);
if (personalAgentDetails.length > 0) {
  for (const a of personalAgentDetails) {
    const meta = [a.model, a.effortLevel].filter(Boolean).join(", ");
    emit(`- \`${a.name}\`${meta ? `  (${meta})` : ""}`);
  }
} else {
  emit("- (none)");
}
emit("");

if (pluginAgentDetails.length > 0) {
  emit(`**Plugin agents:**`);
  for (const a of pluginAgentDetails) {
    const meta = [a.model, a.effortLevel].filter(Boolean).join(", ");
    emit(`- \`${a.name}\` from \`${a.plugin}\`${meta ? `  (${meta})` : ""}`);
  }
  emit("");
}

// 1g. MCP servers
emit("### g. MCP servers\n");

if (mcpServers.length > 0) {
  for (const s of mcpServers) {
    emit(`- **${s.name}**  →  \`${s.command}\``);
  }
} else {
  // Check project-level .mcp.json
  const projectMcp = readJSON(`${HOME}/code/nixos-config/.mcp.json`);
  if (projectMcp) {
    for (const [name, cfg] of Object.entries(projectMcp.mcpServers || {})) {
      emit(`- **${name}** (project-level)  →  \`${cfg.command || JSON.stringify(cfg)}\``);
    }
  } else {
    emit("- (none configured in settings.json or .mcp.json)");
  }
}

// Check north-peer and north MCP from the running session context
// These are noted in system context but not in files — report from settings
const mcpSection = settings.mcpServers;
if (!mcpSection || Object.keys(mcpSection).length === 0) {
  emit("\n_Note: MCP servers may be configured elsewhere (e.g. project .mcp.json files per-repo)._");
}
emit("");

// 1h. North harness / spawn wiring
emit("### h. Cross-repo spawn wiring (north harness)\n");

emit(`- harness: \`${tilde(harnessPath)}\``);
emit(`- PRAXIS_DIR: \`${praxisDir ? tilde(praxisDir) : "(not found)"}\``);
emit(`  - north reads spawn blocks from: gaffer docs (single source of truth)`);
emit(`  - personal residue: \`~/code/nixos-config/dotfiles/agents/docs/praxis/\``);
emit(`- appendix functions found in harness: ${appendixFns.join(", ")}`);
emit(`  - globalLawsAppendix: injects global CLAUDE.md laws into every spawn`);
emit(`  - praxisAppendix: reads role/posture/delta from PRAXIS_DIR per model`);
emit(`  - cavemanAppendix: propagates caveman mode to subagents`);
emit(`  - esoAppendix: injects ESO output format spec for dense handoffs`);
emit("");

// ── Section 2: Dependency graph ─────────────────────────────────────────────

emit("## Dependency graph\n");
emit("```mermaid");
emit("graph TD");
emit("  session[\"Claude Code session\"]");
emit("  settingsJson[\"settings.json\\n~/.claude/settings.json\"]");
emit("  settingsNixos[\"settings.json source\\n~/code/nixos-config/dotfiles/claude/settings.json\"]");
emit("  claudeMdGlobal[\"CLAUDE.md (global)\\n~/.claude/CLAUDE.md\"]");
emit("  claudeMdNixos[\"CLAUDE.md source\\n~/code/nixos-config/dotfiles/claude/CLAUDE.md\"]");
emit("  pluginGaffer[\"plugin: gaffer\"]");
emit("  pluginCaveman[\"plugin: caveman\"]");
emit("  pluginRustLsp[\"plugin: rust-analyzer-lsp\"]");
emit("  pluginTsLsp[\"plugin: typescript-lsp\"]");
emit("  pluginLean[\"plugin: lean\"]");
emit("  gafferDoctrine[\"gaffer/doctrine.md\\n(routing doctrine)\"]");
emit("  ternHarness[\"north sdk/src/harness.ts\"]");
emit("  gafferDocs[\"~/code/gaffer/docs\\n(PRAXIS_DIR: roles/postures/deltas)\"]");
emit("  praxisPersonal[\"personal praxis residue\\n~/code/nixos-config/dotfiles/agents/docs/praxis/\"]");
emit("  nixosClaudeMd[\"nixos-config/CLAUDE.md\\n(per-project rules)\"]");
emit("  ternOnSpawn[\"north-on-spawn\\n(SessionStart hook)\"]");
emit("  ternOnTooluse[\"north-on-tooluse\\n(PostToolUse hook)\"]");
emit("");
emit("  session -->|loads| settingsJson");
emit("  session -->|loads| claudeMdGlobal");
emit("  settingsJson -->|symlinks-to| settingsNixos");
emit("  claudeMdGlobal -->|symlinks-to| claudeMdNixos");
emit("  settingsJson -->|loads plugin| pluginGaffer");
emit("  settingsJson -->|loads plugin| pluginCaveman");
emit("  settingsJson -->|loads plugin| pluginRustLsp");
emit("  settingsJson -->|loads plugin| pluginTsLsp");
emit("  pluginGaffer -->|SessionStart injects| gafferDoctrine");
emit("  ternHarness -->|reads-at-spawn| gafferDocs");
emit("  ternHarness -->|reads-at-spawn| praxisPersonal");
emit("  settingsJson -->|SessionStart hook| ternOnSpawn");
emit("  settingsJson -->|PostToolUse hook| ternOnTooluse");
emit("  session -->|cwd loads| nixosClaudeMd");
emit("  gafferDocs -->|contains| praxisPersonal");
emit("```\n");

// ── Section 3: Rot audit ────────────────────────────────────────────────────

emit("## Rot audit\n");

for (const p of passes) emit(p);
for (const f of flags) emit(f);

emit("");
const nFlags = flags.length;
emit(`**${nFlags} flag${nFlags === 1 ? "" : "s"}**${nFlags === 0 ? " — all checks passed." : "."}`);

// Output all at once
process.stdout.write(out.join("\n") + "\n");
