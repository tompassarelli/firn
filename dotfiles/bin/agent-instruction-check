#!/usr/bin/env bash
set -euo pipefail
exec python3 - "$@" <<'PY'
import argparse
import json
from pathlib import Path
import subprocess
import sys

parser = argparse.ArgumentParser(
    description="Refuse repository AGENTS.md over 100 lines and generated global policy over 200 lines.",
    epilog="Move detail to CLI --help, help TOPIC, or indexed docs; keep AGENTS.md as a router.")
parser.add_argument("--repo", metavar="DIR", help="check a repository's published Git tree (default: current directory)")
parser.add_argument("--ref", default="HEAD", help="Git snapshot to check (default: HEAD)")
parser.add_argument("--global", dest="globals", action="append", default=[], metavar="FILE",
                    help="check an actual generated global policy; repeat for multiple files")
args = parser.parse_args()
failures = []
checked = 0

def check(label, content, limit):
    global checked
    checked += 1
    lines = len(content.splitlines())
    if lines > limit:
        failures.append(f"{label}: {lines} lines, limit {limit}; move detail to CLI --help, help TOPIC, or indexed docs and keep AGENTS.md as a router")

try:
    if args.repo is not None or not args.globals:
        repo = args.repo or "."

        def git(*arguments):
            return subprocess.check_output(["git", "-C", repo, *arguments], stderr=subprocess.PIPE)

        snapshot = git("rev-parse", "--verify", f"{args.ref}^{{commit}}").decode().strip()
        paths = {p.decode() for p in git("ls-tree", "-r", "--name-only", "-z", snapshot).split(b"\0") if p}

        def source(path):
            return git("show", f"{snapshot}:{path}").decode()

        catalog_path = "dotfiles/agents/catalog-config.json"
        catalog = json.loads(source(catalog_path)) if catalog_path in paths else {}
        baselines = catalog.get("baselines", [])
        baseline_paths = {entry["owner"]["path"] for entry in baselines
                          if entry["owner"]["repo"] == "nixos-config"}
        for path in sorted(paths):
            if Path(path).name == "AGENTS.md" and path not in baseline_paths:
                check(f"{path}@{snapshot}", source(path), 100)

        for target in ("shared", "codex"):
            entries = [entry for entry in baselines if target in entry.get("targets", [])]
            for unit in catalog.get("activation", {}).values():
                entries.extend(entry for entry in unit.get("distributions", [])
                               if entry.get("type") == "instructions" and target in entry.get("targets", []))
            rendered = ""
            for entry in entries:
                owner = entry["owner"]
                if owner["repo"] != "nixos-config":
                    raise ValueError(f"cannot render proposed global source {owner['repo']}:{owner['path']} from this Git snapshot")
                rendered += f"<!-- {owner['repo']}:{owner['path']} -->\n" + source(owner["path"]) + "\n\n"
            if entries:
                check(f"generated global {target}@{snapshot}", rendered, 200)

    for path in args.globals:
        check(path, Path(path).read_text(), 200)
except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
    print(f"agent-instruction-check: cannot check instructions: {error}", file=sys.stderr)
    sys.exit(2)

for failure in failures:
    print(f"agent-instruction-check: {failure}", file=sys.stderr)
if failures:
    sys.exit(1)
print(f"agent-instruction-check: {checked} instruction files within limits")
PY
