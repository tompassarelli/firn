#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: wt-reap [--all] [--dry-run]

Sweep spent lanes out of a container's worktrees/ directory.

A container holds exactly three slots, and the directory IS the lifecycle
policy:
  <project>/main/               the clean checkout — never swept
  <project>/worktrees/<slug>/   ephemeral lanes — the only thing this sweeps
  <project>/pins/<name>/        externally consumed — never swept, never
                                enumerated here

A lane is reaped when it is completely clean (including untracked and
non-disposable ignored files), is at least two hours old, has no live process
working inside it, is not locked or a rescue branch, AND either:
  merged  — its HEAD is an ancestor of main; or
  equiv   — every commit it is ahead by is patch-equivalent to something
            already on main (the rebase-landed lane).

Every reap is held back by ignored files that are not disposable caches
(.direnv/, result symlinks) — docs/private/ notes live there.
Both reap modes are held back by: a rescue-* branch, a locked worktree, a
live process whose CWD is inside the tree, or an age under 2h. Equivalence
reaping is also held back by any merge commit the lane is ahead by.

  (no flags)  operate on the container of the current directory
  --all       operate on every ~/code/*/main container
  --dry-run   report what would be reaped or kept; change nothing

Only <project>/worktrees/<slug> is swept. main/, pins/*, and any other shape
are skipped by construction — a pin is externally consumed, so it is never a
reap candidate no matter how clean, merged, detached, or old it is.
USAGE
}

all=0
dry=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --all) all=1; shift ;;
    --dry-run) dry=1; shift ;;
    *) echo "wt-reap: unknown argument '$1'" >&2; usage >&2; exit 2 ;;
  esac
done

reaped=0
reaped_equiv=0
kept_dirty=0
kept_unmerged=0
kept_protected=0

# Freshly created lanes have not started work yet; a worktree's .git file is
# written once at creation, so its mtime is the lane's birth time.
MIN_AGE_SECONDS=7200

find_container() {
  local dir="$PWD"
  while [ "$dir" != "/" ]; do
    if [ -e "$dir/main/.git" ]; then
      printf '%s\n' "$dir"
      return 0
    fi
    dir=$(dirname "$dir")
  done
  return 1
}

# A process cwd'd inside the tree is someone working there right now — removing
# it out from under them is the one unrecoverable mistake this script can make.
has_live_cwd() {
  local tree="$1" live
  # `find -lname` examines the cwd links without spawning one readlink per PID.
  live=$(find /proc/[0-9]*/cwd \( -lname "$tree" -o -lname "$tree"'/*' \) \
    -print -quit 2>/dev/null)
  [ -n "$live" ]
}

# `status --porcelain` hides ignored files but `worktree remove` deletes them,
# so docs/private/ notes need their own gate; only caches are safe to destroy.
irreplaceable_ignored() { # print the ignored paths that are not disposable
  local tree="$1" path
  while IFS= read -r path; do
    case "$path" in
      .direnv/*|*/.direnv/*) continue ;;
      # Every lane that runs firn-build regenerates this; keeping it would
      # make each built lane permanently unreapable.
      .beagle-cache/*|*/.beagle-cache/*) continue ;;
      result|result-*) case "$path" in */*) ;; *) continue ;; esac ;;
    esac
    printf '%s\n' "$path"
  done < <(git -C "$tree" ls-files --others --ignored --exclude-standard 2>/dev/null)
}

younger_than_min_age() {
  local tree="$1" born now
  born=$(stat -c %Y "$tree/.git" 2>/dev/null) || return 1
  now=$(date +%s)
  [ $((now - born)) -lt "$MIN_AGE_SECONDS" ]
}

safety_gate() { # print the reason that makes a clean tree unreapable
  local tree="$1" branch_name="$2" locked_paths="$3"
  if [[ "$branch_name" == rescue-* ]]; then
    printf 'rescue\n'
  elif grep -Fxq "$tree" <<<"$locked_paths"; then
    printf 'locked\n'
  elif has_live_cwd "$tree"; then
    printf 'live cwd\n'
  elif younger_than_min_age "$tree"; then
    printf 'fresh\n'
  else
    return 1
  fi
}

# Zero '+' lines from `git cherry` means every commit this branch is ahead by
# already has a patch-equivalent twin on main — the lane landed through some
# other branch's rebase and its content is safe.
# refs/heads/ throughout: a bare name resolves refs/tags first, so a tag
# sharing the lane's name would answer for the branch.
all_commits_equivalent() {
  local main_dir="$1" main_branch="$2" branch="$3" out merges
  local main_ref="refs/heads/$main_branch" branch_ref="refs/heads/$branch"
  # cherry skips merges, so an evil merge's unique resolution has no patch-id.
  merges=$(git -C "$main_dir" rev-list --merges "$main_ref..$branch_ref" 2>/dev/null) || return 1
  [ -z "$merges" ] || return 1
  out=$(git -C "$main_dir" cherry "$main_ref" "$branch_ref" 2>/dev/null) || return 1
  ! grep -q '^+' <<<"$out"
}

reap_container() {
  local container="$1" main_dir wt main_branch head branch_ref branch_name dirty ahead
  local wt_list locked_paths keep_reason ignored ignored_count
  local sweep_dir
  # `worktree list` reports resolved paths; the sweep test compares parents
  # against this container, so resolve it the same way.
  container=$(cd "$container" && pwd -P) || return 0
  main_dir="$container/main"
  sweep_dir="$container/worktrees"
  [ -e "$main_dir/.git" ] || return 0

  [ "$dry" -eq 1 ] || git -C "$main_dir" worktree prune

  main_branch=$(git -C "$main_dir" symbolic-ref --quiet --short HEAD 2>/dev/null) || return 0

  wt_list=$(git -C "$main_dir" worktree list --porcelain)
  locked_paths=$(awk '/^worktree /{p=substr($0, 10)} /^locked/{print p}' <<<"$wt_list")

  while IFS= read -r wt; do
    [ -n "$wt" ] || continue
    # Positive opt-in, not a negative skip list: only a lane parked directly in
    # <container>/worktrees is sweepable. main/, pins/*, and any future slot are
    # skipped by construction — safe by default instead of deleted by default.
    [ "$(dirname "$wt")" = "$sweep_dir" ] || continue

    dirty=$(git -C "$wt" status --porcelain 2>/dev/null) || continue
    if [ -n "$dirty" ]; then
      printf 'kept: dirty (%s)\n' "$wt"
      kept_dirty=$((kept_dirty + 1))
      continue
    fi

    ignored=$(irreplaceable_ignored "$wt")
    if [ -n "$ignored" ]; then
      ignored_count=$(grep -c '' <<<"$ignored")
      printf 'kept: ignored files (%s, %s total) (%s)\n' \
        "$(head -n1 <<<"$ignored")" "$ignored_count" "$wt"
      kept_protected=$((kept_protected + 1))
      continue
    fi

    head=$(git -C "$wt" rev-parse HEAD 2>/dev/null) || continue
    branch_ref=$(git -C "$wt" symbolic-ref --quiet HEAD 2>/dev/null) || branch_ref=""
    branch_name=${branch_ref#refs/heads/}
    [ -n "$branch_name" ] || branch_name="(detached)"

    if keep_reason=$(safety_gate "$wt" "$branch_name" "$locked_paths"); then
      printf 'kept: %s (%s) (%s)\n' "$keep_reason" "$branch_name" "$wt"
      kept_protected=$((kept_protected + 1))
      continue
    fi

    if git -C "$main_dir" merge-base --is-ancestor "$head" "refs/heads/$main_branch" 2>/dev/null; then
      if [ "$dry" -eq 1 ]; then
        printf 'would reap: %s (%s)\n' "$wt" "$branch_name"
      else
        git -C "$main_dir" worktree remove "$wt"
        if [ "$branch_name" != "(detached)" ]; then
          git -C "$main_dir" branch -d "$branch_name"
        fi
        printf 'reaped: %s (%s)\n' "$wt" "$branch_name"
      fi
      reaped=$((reaped + 1))
      continue
    fi

    # --- equivalence path: landed content, different SHAs ---------------------
    keep_reason=""
    if [ "$branch_name" != "(detached)" ] \
      && all_commits_equivalent "$main_dir" "$main_branch" "$branch_name"; then
      if [ "$dry" -eq 1 ]; then
        printf 'would reap (equiv): %s (%s was %s)\n' "$wt" "$branch_name" "$head"
      else
        git -C "$main_dir" worktree remove "$wt"
        # -D, not -d: an equivalent branch is by definition not an ancestor,
        # so -d refuses it. Only reachable once all_commits_equivalent passed.
        git -C "$main_dir" branch -D "$branch_name" >/dev/null
        printf 'reaped (equiv): %s (%s was %s)\n' "$wt" "$branch_name" "$head"
      fi
      reaped_equiv=$((reaped_equiv + 1))
      continue
    fi

    if [ -n "$keep_reason" ]; then
      printf 'kept: %s (%s) (%s)\n' "$keep_reason" "$branch_name" "$wt"
      kept_protected=$((kept_protected + 1))
    else
      ahead=$(git -C "$main_dir" rev-list --count "refs/heads/$main_branch..$head" 2>/dev/null) || ahead="?"
      printf 'kept: unmerged (%s, %s commits ahead) (%s)\n' "$branch_name" "$ahead" "$wt"
      kept_unmerged=$((kept_unmerged + 1))
    fi
  done < <(awk '/^worktree /{print substr($0, 10)}' <<<"$wt_list")
}

if [ "$all" -eq 1 ]; then
  for main_dir in "$HOME"/code/*/main; do
    [ -e "$main_dir/.git" ] || continue
    reap_container "$(dirname "$main_dir")"
  done
else
  container=$(find_container) || {
    echo "wt-reap: no container found above $PWD (no <dir>/main/.git)" >&2
    exit 1
  }
  reap_container "$container"
fi

if [ "$dry" -eq 1 ]; then
  printf 'dry-run: would reap %d, would reap equiv %d, kept dirty %d, kept unmerged %d, kept protected %d\n' \
    "$reaped" "$reaped_equiv" "$kept_dirty" "$kept_unmerged" "$kept_protected"
else
  printf 'reaped %d, reaped equiv %d, kept dirty %d, kept unmerged %d, kept protected %d\n' \
    "$reaped" "$reaped_equiv" "$kept_dirty" "$kept_unmerged" "$kept_protected"
fi
