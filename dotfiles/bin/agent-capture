#!/usr/bin/env bash
# agent-capture — screenshot for agents that never touches Tom's clipboard.
#
#   agent-capture --screen OUT.png          the focused output
#   agent-capture --window ID OUT.png       one visible floating niri window (ID from `niri msg -j windows`)
#   agent-capture --region "X,Y WxH" OUT.png  a logical-pixel region
#
# Built on grim because niri's screenshot actions always replace the clipboard; niri reports positions only for visible floating windows.
set -uo pipefail

die() { printf 'agent-capture: %s\n' "$1" >&2; exit "${2:-1}"; }
usage() { awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"; }

window_geometry() {
  local id="$1" windows workspaces outputs
  windows=$(niri msg -j windows) || die "niri msg windows failed"
  workspaces=$(niri msg -j workspaces) || die "niri msg workspaces failed"
  outputs=$(niri msg -j outputs) || die "niri msg outputs failed"
  jq -nr --argjson id "$id" --argjson w "$windows" --argjson ws "$workspaces" --argjson o "$outputs" '
    ($w[] | select(.id == $id)) as $win
    | if $win == null then "missing" else
      ($ws[] | select(.id == $win.workspace_id)) as $space
      | if ($space.is_active | not) then "hidden"
        elif $win.layout.tile_pos_in_workspace_view == null then "hidden"
        else
          ($o[$space.output].logical) as $out
          | ($win.layout.tile_pos_in_workspace_view) as $tile
          | ($win.layout.window_offset_in_tile) as $off
          | ($win.layout.window_size) as $size
          | "\(($out.x + $tile[0] + $off[0]) | floor),\(($out.y + $tile[1] + $off[1]) | floor) \($size[0])x\($size[1])"
        end
      end'
}

[ $# -ge 1 ] || { usage >&2; exit 2; }
case "$1" in
  -h|--help) usage; exit 0 ;;
  --screen)
    out="${2:-}"; [ -n "$out" ] || die "usage: agent-capture --screen OUT.png" 2
    output=$(niri msg -j focused-output | jq -r .name) || die "no focused output"
    grim -o "$output" "$out" || die "grim failed"
    ;;
  --window)
    id="${2:-}" out="${3:-}"
    [[ "$id" =~ ^[0-9]+$ ]] && [ -n "$out" ] || die "usage: agent-capture --window ID OUT.png" 2
    geom=$(window_geometry "$id")
    case "$geom" in
      missing) die "no niri window with id $id" ;;
      hidden) die "window $id has no on-screen position (niri reports one only for visible floating windows); capture its output with --screen or a --region" 3 ;;
    esac
    grim -g "$geom" "$out" || die "grim failed"
    ;;
  --region)
    geom="${2:-}" out="${3:-}"; [ -n "$geom" ] && [ -n "$out" ] || die "usage: agent-capture --region \"X,Y WxH\" OUT.png" 2
    grim -g "$geom" "$out" || die "grim failed"
    ;;
  *) die "unknown option: $1 (try --help)" 2 ;;
esac
printf '%s\n' "$out"
