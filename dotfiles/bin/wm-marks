#!/usr/bin/env bb
;; wm-marks — list every mark: letter, target id, alive/dead, app_id, title.
;; Read-only over MARKS_LOG (folded latest-wins) + live niri window set.

(require '[cheshire.core :as json]
         '[babashka.process :as proc]
         '[clojure.java.io :as io]
         '[clojure.string :as str])

(def log-file
  (or (System/getenv "MARKS_LOG")
      (str (System/getenv "HOME") "/.local/state/wm-world/marks.jsonl")))

(defn niri-json [& args]
  (json/parse-string (:out (apply proc/sh "niri" "msg" "-j" args)) true))

(defn fold []
  (let [state (atom {})]
    (when (.exists (io/file log-file))
      (with-open [r (io/reader log-file)]
        (doseq [line (line-seq r) :when (not (str/blank? line))]
          (try
            (let [{:keys [l p r op]} (json/parse-string line true)]
              (cond
                (= op "retract") (if p (swap! state update l dissoc p)
                                     (swap! state dissoc l))
                (= op "assert")  (swap! state assoc-in [l p] r)))
            (catch Exception _ nil)))))
    @state))

(defn -main [_]
  (let [marks    (->> (fold)
                      (filter (fn [[k _]] (str/starts-with? k "@mark-")))
                      (sort-by first))
        live-ids (set (map :id (niri-json "windows")))]
    (if (empty? marks)
      (println "(no marks)")
      (doseq [[subj f] marks]
        (let [letter (subs subj 6)
              id     (some-> (get f "window") (->> (re-find #"\d+")) parse-long)
              alive  (if (and id (contains? live-ids id)) "alive" "dead ")]
          (println (format "%-3s @w%-5s %s  %-24s %s"
                           letter (or id "?") alive
                           (or (get f "app_id") "") (or (get f "title") ""))))))))

(-main *command-line-args*)
