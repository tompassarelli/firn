#!/usr/bin/env bash
# Bootloader wrapper for the `claude` CLI.
#   bare / any args -> auto-select the north-managed Anthropic account with the
#                      most headroom, then exec the real claude.
#   as <id> [args]  -> pin one account explicitly.
# Fails OPEN: north trouble never blocks the real binary — but the banner names
# the ACTUAL reason (north missing / snapshot error / empty or malformed data /
# no eligible account / vanished account dir), never a blanket "north
# unavailable", and points at an explicit `claude as <id>` recovery — using a
# real id when one is known, never guessing one.
set -u

PROVIDER_WORD="claude"
ACCOUNTS_ROOT="$HOME/.local/state/north/accounts/anthropic"
NORTH_PROVIDER="anthropic"
BIND_LIMIT="claude:seven_day"   # window that binds Anthropic subscription usage

# Locate the real claude: first PATH entry that isn't this wrapper itself.
self="$(realpath "$0" 2>/dev/null || echo "$0")"
REAL=""
while IFS= read -r cand; do
  [ -n "$cand" ] || continue
  cp="$(realpath "$cand" 2>/dev/null || echo "$cand")"
  [ "$cp" = "$self" ] && continue
  REAL="$cand"; break
done < <(type -aP claude 2>/dev/null)
if [ -z "$REAL" ]; then
  echo "claude: real binary not found on PATH" >&2
  exit 127
fi

# Native provider roots are a coordination surface when North owns dispatch:
# keep the listener capable, but reserve fan-out for managed North lanes. These
# defaults precede caller argv so a later explicit --model/--effort wins.
# Account-pinned managed lanes return through the passthrough guard below and
# therefore never inherit this native-root policy.
native_dispatch_args() {
  local state mode="north" line enforce_topology=1
  if [ -n "${NORTH_HARNESS_STATE:-}" ]; then
    state="$NORTH_HARNESS_STATE"
  elif [ -f "$HOME/.local/state/north/harness.conf" ]; then
    state="$HOME/.local/state/north/harness.conf"
  else
    state="$HOME/.claude/my-config.state"
  fi
  if [ -r "$state" ]; then
    while IFS= read -r line; do
      case "$line" in dispatch=*) mode="${line#dispatch=}" ;; esac
    done <"$state"
    mode="${mode:-north}"
  fi
  # `north config dispatch` owns this vocabulary; this table must track it.
  # Stripping the native spawn tools is correct ONLY when native dispatch is
  # actually denied. Getting that backwards is not a degraded mode — it leaves
  # a session with no dispatch surface at all, which is what `native-forced`
  # falling through to the old `*)` catch-all did on 2026-07-30.
  case "$mode" in
    # Current four-mode vocabulary.
    native-forced|native-biased|managed-biased) enforce_topology=0 ;;
    managed-forced) ;;
    # Legacy values, honored exactly as before.
    native) return 0 ;;
    warn) enforce_topology=0 ;;
    north) ;;
    *)
      # Fail closed, but never silently: an unreadable mode is a coupling bug
      # between north and this launcher, and it must be visible the first time.
      printf 'claude: unrecognized dispatch mode "%s" in %s; assuming managed-forced\n' \
        "$mode" "$state" >&2
      ;;
  esac
  printf '%s\0' \
    '--model' 'claude-fable-5' \
    '--effort' 'xhigh'
  [ "$enforce_topology" -eq 0 ] || \
    printf '%s\0' '--disallowedTools' 'Agent,Task,Workflow'
}

# 1. North's own provider probe is an internal recursive launch. Never inspect
#    or re-route it, even if a future probe happens to carry resume-shaped argv.
if [ "${NORTH_CLAUDE_LAUNCHER_BYPASS:-}" = "1" ]; then
  exec "$REAL" "$@"
fi

# 1b. Compute governance: run the session inside agent.slice so a lane and
#     everything it spawns yields to the desktop under contention. ONE
#     chokepoint — re-exec the launcher, and all five downstream exec paths
#     plus every descendant tool call inherit the cgroup. Weights live in
#     nixos-config modules/agent-slice; this only enters them.
#     Fails OPEN like the account selection below: absent systemd-run, no user
#     manager, or a scope that never started the payload all fall through.
NORTH_SLICE_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/north/agent-slice.state"
slice_note() {
  { mkdir -p "${NORTH_SLICE_STATE%/*}"; } 2>/dev/null || true
  { printf '%s\t%s\t%s\t%s\n' \
      "${EPOCHSECONDS:-0}" "$1" "$PROVIDER_WORD" "$$" >"$NORTH_SLICE_STATE"; } \
    2>/dev/null || true
}
if [ "${NORTH_SLICE_ENTERED:-}" = "1" ]; then
  # The re-exec (or an agent's nested launch): already governed. Prove to the
  # parent that the payload really started, then carry on normally.
  [ -n "${NORTH_SLICE_MARK:-}" ] && { : >"$NORTH_SLICE_MARK"; } 2>/dev/null
  slice_note on
elif [ "${NORTH_NO_SLICE:-}" = "1" ]; then
  slice_note off:NORTH_NO_SLICE
elif ! command -v systemd-run >/dev/null 2>&1; then
  slice_note off:no-systemd-run
elif [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -S "$XDG_RUNTIME_DIR/systemd/private" ]; then
  slice_note off:no-user-manager
else
  # Without the marker a failed scope and a session that merely exited 1 look
  # identical, and the retry would double-run the session.
  slice_dir="$(mktemp -d 2>/dev/null || true)"
  if [ -z "$slice_dir" ]; then
    slice_note off:no-scratch
  else
    NORTH_SLICE_MARK="$slice_dir/ran"
    export NORTH_SLICE_ENTERED=1 NORTH_SLICE_MARK
    systemd-run --user --scope --quiet --slice=agent.slice --same-dir --collect \
      -- "$self" "$@"
    slice_rc=$?
    slice_ran=1
    [ -e "$NORTH_SLICE_MARK" ] || slice_ran=0
    rm -rf "${slice_dir:?}"
    if [ "$slice_ran" -eq 1 ]; then
      exit "$slice_rc"
    fi
    # The scope never started the launcher: unset the inheritance so the
    # ordinary path below runs ungoverned rather than not at all.
    unset NORTH_SLICE_ENTERED NORTH_SLICE_MARK
    slice_note off:scope-failed
  fi
fi

# A caller-supplied config home is an exact authority (managed North lane,
# explicit shell pin, or custom profile). Never search outside it.
if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
  exec "$REAL" "$@"
fi

NATIVE_DISPATCH_ARGS=()
while IFS= read -r -d '' arg; do
  NATIVE_DISPATCH_ARGS+=("$arg")
done < <(native_dispatch_args)

# 2. Exact UUID resume: resolve the transcript's owning authority before
#    quota-based selection can send it to the wrong home.
#    `claude as <id> ...` remains an explicit override and skips this lookup.
if [ "${1:-}" != "as" ]; then
  resume_index=-1
  resume_id=""
  resume_equals=0
  resume_terminal=0
  argv=("$@")
  for entry in "${argv[@]}"; do
    case "$entry" in
      --) break ;;
      -h|--help|-v|--version)
        resume_terminal=1
        break
        ;;
    esac
  done
  for index in "${!argv[@]}"; do
    case "${argv[$index]}" in
      --|-h|--help|-v|--version)
        # Everything after `--` is prompt text; help/version are terminal.
        # Neither may be reinterpreted as a later resume request.
        break
        ;;
      -r|--resume)
        next=$((index + 1))
        if [ "$next" -lt "${#argv[@]}" ]; then
          resume_index="$next"
          resume_id="${argv[$next]}"
        fi
        break
        ;;
      --resume=*)
        resume_index="$index"
        resume_id="${argv[$index]#--resume=}"
        resume_equals=1
        break
        ;;
    esac
  done

  uuid_re='^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$'
  if [ "$resume_terminal" -eq 0 ] && [ "$resume_index" -ge 0 ] &&
     [[ "$resume_id" =~ $uuid_re ]]; then
    resolver="$(dirname "$self")/north-session-resolve"
    if [ ! -x "$resolver" ]; then
      echo "claude: cross-account resume resolver is unavailable: $resolver" >&2
      exit 127
    fi
    resolved="$("$resolver" anthropic "$resume_id")"
    resolve_status=$?
    [ "$resolve_status" -eq 0 ] || exit "$resolve_status"
    IFS=$'\t' read -r version resolved_provider authority_kind authority_name authority_home canonical_id <<<"$resolved"
    if [ "$version" != "v1" ] || [ "$resolved_provider" != "anthropic" ] ||
       [ -z "$authority_home" ] || [ -z "$canonical_id" ]; then
      echo "claude: cross-account resume resolver returned an invalid result" >&2
      exit 1
    fi
    if [ "$resume_equals" -eq 1 ]; then
      argv[resume_index]="--resume=$canonical_id"
    else
      argv[resume_index]="$canonical_id"
    fi
    set -- "${argv[@]}"
    printf '[claude resume → %s:%s]\n' "$authority_kind" "$authority_name" >&2
    if [ "$authority_kind" = "profile" ] && [ "$authority_name" = "claude-native" ]; then
      native="$(dirname "$self")/claude-native"
      [ -x "$native" ] || { echo "claude: native launcher is unavailable: $native" >&2; exit 127; }
      exec "$native" "$@"
    fi
    export CLAUDE_CONFIG_DIR="$authority_home"
    exec "$REAL" "${NATIVE_DISPATCH_ARGS[@]}" "$@"
  fi
fi

list_accounts() {
  [ -d "$ACCOUNTS_ROOT" ] && \
    find "$ACCOUNTS_ROOT" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort
}

# 3. Explicit pin: `claude as <id> [args...]`.
if [ "${1:-}" = "as" ]; then
  shift
  acct="${1:-}"
  usage() {
    echo "usage: claude as <account-id> [claude args...]"
    echo "available account ids:"
    list_accounts | sed 's/^/  /'
  }
  case "$acct" in
    -h|--help) usage; exit 0 ;;
    "")        usage >&2; exit 1 ;;
  esac
  shift
  root="$ACCOUNTS_ROOT/$acct"
  if [ ! -d "$root" ]; then
    {
      echo "claude as: unknown account '$acct'"
      echo "available account ids:"
      list_accounts | sed 's/^/  /'
    } >&2
    exit 1
  fi
  export CLAUDE_CONFIG_DIR="$root"
  exec "$REAL" "${NATIVE_DISPATCH_ARGS[@]}" "$@"
fi

# 4. Auto-select greatest-headroom account from north's machine boundary.
#    Rank: lowest measured used% on the binding window. Headroom class
#    (plenty>normal>low>other) only breaks a numeric tie; target order is final.
#    Every failure mode fails OPEN
#    but is reported distinctly — the caller learns WHY it went ambient.
#
#    Emits a single tab-separated verdict line on stdout:
#      ok\t<account-id>     a rankable eligible account was chosen
#      err\t<reason>        no id — <reason> is a concise, actionable cause
#    Never touches account state; the caller decides how to act on the verdict.
SELECT_TIMEOUT=10
select_account() {
  if ! command -v north >/dev/null 2>&1; then
    printf 'err\tnorth not found on PATH\n'
    return
  fi

  local errfile json rc detail
  errfile="$(mktemp 2>/dev/null || true)"
  if command -v timeout >/dev/null 2>&1; then
    if [ -n "$errfile" ]; then
      json="$(timeout --foreground "${SELECT_TIMEOUT}s" env -u NORTH_CHECKOUT NORTH_CLAUDE_LAUNCHER_BYPASS=1 north providers --json 2>"$errfile")"; rc=$?
    else
      json="$(timeout --foreground "${SELECT_TIMEOUT}s" env -u NORTH_CHECKOUT NORTH_CLAUDE_LAUNCHER_BYPASS=1 north providers --json 2>/dev/null)"; rc=$?
    fi
  elif [ -n "$errfile" ]; then
    json="$(env -u NORTH_CHECKOUT NORTH_CLAUDE_LAUNCHER_BYPASS=1 north providers --json 2>"$errfile")"; rc=$?
  else
    json="$(env -u NORTH_CHECKOUT NORTH_CLAUDE_LAUNCHER_BYPASS=1 north providers --json 2>/dev/null)"; rc=$?
  fi

  if [ "$rc" -ne 0 ]; then
    detail=""
    [ -n "$errfile" ] && detail="$(head -n1 "$errfile" 2>/dev/null)"
    [ -n "$errfile" ] && rm -f "$errfile"
    if [ "$rc" -eq 124 ]; then
      printf 'err\tnorth providers timed out after %ss\n' "$SELECT_TIMEOUT"
    elif [ -n "$detail" ]; then
      printf 'err\tnorth providers exited %s: %s\n' "$rc" "$detail"
    else
      printf 'err\tnorth providers exited %s\n' "$rc"
    fi
    return
  fi
  [ -n "$errfile" ] && rm -f "$errfile"

  if [ -z "$json" ]; then
    printf 'err\tnorth providers returned no output\n'
    return
  fi

  local id
  if ! id="$(printf '%s' "$json" | jq -r --arg prov "$NORTH_PROVIDER" --arg limit "$BIND_LIMIT" '
    (.providers[]? | select(.provider==$prov) | .targets) // []
    | to_entries
    | map(.value + {order: .key})
    | map(select(.authenticated==true and .routing=="eligible"))
    | map({
        id,
        order,
        hclass: (if .headroom=="plenty" then 0
                 elif .headroom=="normal" then 1
                 elif .headroom=="low" then 2
                 else 3 end),
        used: ([.usage.windows[]? | select(.limitId==$limit) | .usedPercent][0] // 999)
      })
    | sort_by(.used, .hclass, .order)
    | .[0].id // empty
  ' 2>/dev/null)"; then
    printf 'err\tnorth providers JSON was malformed\n'
    return
  fi

  if [ -z "$id" ]; then
    printf 'err\tno eligible %s account (need authenticated + routing-eligible)\n' "$NORTH_PROVIDER"
    return
  fi

  printf 'ok\t%s\n' "$id"
}

# 4b. Same verdict, memoized: a cold `north providers` costs seconds, and a
#     lookup slower than SELECT_TIMEOUT lands ambient. An err caches longer
#     than it stalls, so a down north stalls once per window, not per call.
#     NORTH_NO_SELECT_CACHE=1 forces a fresh lookup.
SELECT_CACHE="${XDG_STATE_HOME:-$HOME/.local/state}/north/account-select.${NORTH_PROVIDER}"
SELECT_CACHE_TTL_OK=180
SELECT_CACHE_TTL_ERR=60

cached_select_account() {
  local now stamp kind value ttl age verdict tmp
  now="${EPOCHSECONDS:-0}"

  if [ "${NORTH_NO_SELECT_CACHE:-}" != "1" ] && [ "$now" -gt 0 ] && [ -r "$SELECT_CACHE" ] \
     && IFS=$'\t' read -r stamp kind value <"$SELECT_CACHE" 2>/dev/null \
     && [ -n "${kind:-}" ] && [ -n "${stamp:-}" ] && [ -z "${stamp//[0-9]/}" ]; then
    case "$kind" in ok) ttl=$SELECT_CACHE_TTL_OK ;; *) ttl=$SELECT_CACHE_TTL_ERR ;; esac
    age=$((now - stamp))
    # A cached id whose account dir vanished re-selects now rather than
    # repeating the caller's ambient fallback for the rest of the window.
    if [ "$age" -ge 0 ] && [ "$age" -lt "$ttl" ] \
       && { [ "$kind" != "ok" ] || [ -d "$ACCOUNTS_ROOT/$value" ]; }; then
      printf '%s\t%s\n' "$kind" "$value"
      return
    fi
  fi

  verdict="$(select_account)"
  if [ "$now" -gt 0 ]; then
    { mkdir -p "${SELECT_CACHE%/*}"; } 2>/dev/null || true
    tmp="$(mktemp "$SELECT_CACHE.XXXXXX" 2>/dev/null || true)"
    if [ -n "$tmp" ]; then
      if printf '%s\t%s\n' "$now" "$verdict" >"$tmp" 2>/dev/null; then
        mv -f "$tmp" "$SELECT_CACHE" 2>/dev/null || rm -f "$tmp" 2>/dev/null
      else
        rm -f "$tmp" 2>/dev/null
      fi
    fi
  fi
  printf '%s\n' "$verdict"
}

# Concise recovery hint: prefer a real, known id; otherwise show the command
# shape with any on-disk account ids, never inventing an account.
recovery_hint() {
  local known
  known="$(list_accounts | paste -sd, - 2>/dev/null)"
  if [ -n "$known" ]; then
    printf 'pin explicitly: %s as <id> (known: %s)' "$PROVIDER_WORD" "$known"
  else
    printf 'no %s accounts present — authenticate one, then: %s as <id>' \
      "$PROVIDER_WORD" "$PROVIDER_WORD"
  fi
}

verdict="$(cached_select_account)"
kind="${verdict%%$'\t'*}"
value="${verdict#*$'\t'}"

if [ "$kind" = "ok" ] && [ -n "$value" ]; then
  if [ -d "$ACCOUNTS_ROOT/$value" ]; then
    export CLAUDE_CONFIG_DIR="$ACCOUNTS_ROOT/$value"
    printf '[%s → %s]\n' "$PROVIDER_WORD" "$value" >&2
  else
    # An id was selected but its state dir vanished. Do NOT auto-pick it
    # (unverified stale account); fail open and name the exact recovery.
    printf '[%s → ambient] selected %s but %s/%s is absent — pin once restored: %s as %s\n' \
      "$PROVIDER_WORD" "$value" "$ACCOUNTS_ROOT" "$value" "$PROVIDER_WORD" "$value" >&2
  fi
else
  reason="$value"
  [ "$kind" = "ok" ] && reason="north returned an empty selection"
  printf '[%s → ambient] %s — %s\n' "$PROVIDER_WORD" "$reason" "$(recovery_hint)" >&2
fi
exec "$REAL" "${NATIVE_DISPATCH_ARGS[@]}" "$@"
