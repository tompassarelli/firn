#!/usr/bin/env bash
# Bootloader wrapper for the `claude` CLI.
#   bare / any args -> auto-select the north-managed Anthropic account with the
#                      most headroom, then exec the real claude.
#   as <id> [args]  -> pin one account explicitly.
# Fails OPEN: north trouble never blocks the real binary — but the banner names
# the ACTUAL reason (north missing / snapshot error / empty or malformed data /
# no eligible account / vanished account dir), never a blanket "north
# unavailable", and points at an explicit `claude as <id>` recovery — using a
# real id when one is known, never guessing one.
set -u

PROVIDER_WORD="claude"
ACCOUNTS_ROOT="$HOME/.local/state/north/accounts/anthropic"
NORTH_PROVIDER="anthropic"
BIND_LIMIT="claude:seven_day"   # window that binds Anthropic subscription usage

# Locate the real claude: first PATH entry that isn't this wrapper itself.
self="$(realpath "$0" 2>/dev/null || echo "$0")"
REAL=""
while IFS= read -r cand; do
  [ -n "$cand" ] || continue
  cp="$(realpath "$cand" 2>/dev/null || echo "$cand")"
  [ "$cp" = "$self" ] && continue
  REAL="$cand"; break
done < <(type -aP claude 2>/dev/null)
if [ -z "$REAL" ]; then
  echo "claude: real binary not found on PATH" >&2
  exit 127
fi

# Native provider roots are a coordination surface when North owns dispatch:
# keep the listener capable, but reserve fan-out for managed North lanes. These
# defaults precede caller argv so a later explicit --model/--effort wins.
# Account-pinned managed lanes return through the passthrough guard below and
# therefore never inherit this native-root policy.
native_dispatch_args() {
  local state mode="north" line enforce_topology=1
  if [ -n "${NORTH_HARNESS_STATE:-}" ]; then
    state="$NORTH_HARNESS_STATE"
  elif [ -f "$HOME/.local/state/north/harness.conf" ]; then
    state="$HOME/.local/state/north/harness.conf"
  else
    state="$HOME/.claude/my-config.state"
  fi
  if [ -r "$state" ]; then
    while IFS= read -r line; do
      case "$line" in dispatch=*) mode="${line#dispatch=}" ;; esac
    done <"$state"
    mode="${mode:-north}"
  fi
  case "$mode" in
    native) return 0 ;;
    warn) enforce_topology=0 ;;
    north) ;;
    *) mode="north" ;;
  esac
  printf '%s\0' \
    '--model' 'claude-fable-5' \
    '--effort' 'xhigh'
  [ "$enforce_topology" -eq 0 ] || \
    printf '%s\0' '--disallowedTools' 'Agent,Task,Workflow'
}

# 1. Passthrough guard: an account is already pinned (north's own lanes /
#    app-server probes, or explicit user env). Do not recurse or re-route.
if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
  exec "$REAL" "$@"
fi

NATIVE_DISPATCH_ARGS=()
while IFS= read -r -d '' arg; do
  NATIVE_DISPATCH_ARGS+=("$arg")
done < <(native_dispatch_args)

list_accounts() {
  [ -d "$ACCOUNTS_ROOT" ] && \
    find "$ACCOUNTS_ROOT" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort
}

# 2. Explicit pin: `claude as <id> [args...]`.
if [ "${1:-}" = "as" ]; then
  shift
  acct="${1:-}"
  usage() {
    echo "usage: claude as <account-id> [claude args...]"
    echo "available account ids:"
    list_accounts | sed 's/^/  /'
  }
  case "$acct" in
    -h|--help) usage; exit 0 ;;
    "")        usage >&2; exit 1 ;;
  esac
  shift
  root="$ACCOUNTS_ROOT/$acct"
  if [ ! -d "$root" ]; then
    {
      echo "claude as: unknown account '$acct'"
      echo "available account ids:"
      list_accounts | sed 's/^/  /'
    } >&2
    exit 1
  fi
  export CLAUDE_CONFIG_DIR="$root"
  exec "$REAL" "${NATIVE_DISPATCH_ARGS[@]}" "$@"
fi

# 3. Auto-select greatest-headroom account from north's machine boundary.
#    Rank: headroom class (plenty>low>other), then lowest used% on the binding
#    window, then north's target listing order. Every failure mode fails OPEN
#    but is reported distinctly — the caller learns WHY it went ambient.
#
#    Emits a single tab-separated verdict line on stdout:
#      ok\t<account-id>     a rankable eligible account was chosen
#      err\t<reason>        no id — <reason> is a concise, actionable cause
#    Never touches account state; the caller decides how to act on the verdict.
select_account() {
  if ! command -v north >/dev/null 2>&1; then
    printf 'err\tnorth not found on PATH\n'
    return
  fi

  local errfile json rc detail
  errfile="$(mktemp 2>/dev/null || true)"
  if [ -n "$errfile" ]; then
    json="$(env -u NORTH_CHECKOUT north providers --json 2>"$errfile")"; rc=$?
  else
    json="$(env -u NORTH_CHECKOUT north providers --json 2>/dev/null)"; rc=$?
  fi

  if [ "$rc" -ne 0 ]; then
    detail=""
    [ -n "$errfile" ] && detail="$(head -n1 "$errfile" 2>/dev/null)"
    [ -n "$errfile" ] && rm -f "$errfile"
    if [ -n "$detail" ]; then
      printf 'err\tnorth providers exited %s: %s\n' "$rc" "$detail"
    else
      printf 'err\tnorth providers exited %s\n' "$rc"
    fi
    return
  fi
  [ -n "$errfile" ] && rm -f "$errfile"

  if [ -z "$json" ]; then
    printf 'err\tnorth providers returned no output\n'
    return
  fi

  local id
  if ! id="$(printf '%s' "$json" | jq -r --arg prov "$NORTH_PROVIDER" --arg limit "$BIND_LIMIT" '
    (.providers[]? | select(.provider==$prov) | .targets) // []
    | to_entries
    | map(.value + {order: .key})
    | map(select(.authenticated==true and .routing=="eligible"))
    | map({
        id,
        order,
        hclass: (if .headroom=="plenty" then 0
                 elif .headroom=="low" then 1
                 else 2 end),
        used: ([.usage.windows[]? | select(.limitId==$limit) | .usedPercent][0] // 999)
      })
    | sort_by(.hclass, .used, .order)
    | .[0].id // empty
  ' 2>/dev/null)"; then
    printf 'err\tnorth providers JSON was malformed\n'
    return
  fi

  if [ -z "$id" ]; then
    printf 'err\tno eligible %s account (need authenticated + routing-eligible)\n' "$NORTH_PROVIDER"
    return
  fi

  printf 'ok\t%s\n' "$id"
}

# Concise recovery hint: prefer a real, known id; otherwise show the command
# shape with any on-disk account ids, never inventing an account.
recovery_hint() {
  local known
  known="$(list_accounts | paste -sd, - 2>/dev/null)"
  if [ -n "$known" ]; then
    printf 'pin explicitly: %s as <id> (known: %s)' "$PROVIDER_WORD" "$known"
  else
    printf 'no %s accounts present — authenticate one, then: %s as <id>' \
      "$PROVIDER_WORD" "$PROVIDER_WORD"
  fi
}

verdict="$(select_account)"
kind="${verdict%%$'\t'*}"
value="${verdict#*$'\t'}"

if [ "$kind" = "ok" ] && [ -n "$value" ]; then
  if [ -d "$ACCOUNTS_ROOT/$value" ]; then
    export CLAUDE_CONFIG_DIR="$ACCOUNTS_ROOT/$value"
    printf '[%s → %s]\n' "$PROVIDER_WORD" "$value" >&2
  else
    # An id was selected but its state dir vanished. Do NOT auto-pick it
    # (unverified stale account); fail open and name the exact recovery.
    printf '[%s → ambient] selected %s but %s/%s is absent — pin once restored: %s as %s\n' \
      "$PROVIDER_WORD" "$value" "$ACCOUNTS_ROOT" "$value" "$PROVIDER_WORD" "$value" >&2
  fi
else
  reason="$value"
  [ "$kind" = "ok" ] && reason="north returned an empty selection"
  printf '[%s → ambient] %s — %s\n' "$PROVIDER_WORD" "$reason" "$(recovery_hint)" >&2
fi
exec "$REAL" "${NATIVE_DISPATCH_ARGS[@]}" "$@"
