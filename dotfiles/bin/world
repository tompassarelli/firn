#!/usr/bin/env bash
set -euo pipefail

WORLD_SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
readonly WORLD_SCRIPT_PATH
WORLD_SOURCE_ROOT="$(cd "$(dirname "$WORLD_SCRIPT_PATH")/../.." && pwd)"
readonly WORLD_SOURCE_ROOT
readonly WORLD_MANIFEST_PATH="${WORLD_MANIFEST_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/world/manifest.env}"

world_defaults() {
  : "${WORLD_CODE_ROOT:=$HOME/code}"
  : "${WORLD_REPO_NIXOS_CONFIG:=$WORLD_CODE_ROOT/nixos-config/main}"
  : "${WORLD_REPO_NORTH:=$WORLD_CODE_ROOT/north/main}"
  : "${WORLD_REPO_FRAM:=$WORLD_CODE_ROOT/fram/main}"
  : "${WORLD_REPO_BEAGLE:=$WORLD_CODE_ROOT/beagle/main}"
  : "${WORLD_NORTH_STATE:=$HOME/.local/state/north}"
  : "${WORLD_COORD_LOG:=$WORLD_NORTH_STATE/coordination.log}"
  : "${WORLD_TELEMETRY_LOG:=$WORLD_NORTH_STATE/telemetry.log}"
  : "${WORLD_THREADS_DIR:=$WORLD_NORTH_STATE/threads}"
  : "${WORLD_HARNESS_CONF:=$WORLD_NORTH_STATE/harness.conf}"
  : "${WORLD_FIRN_CACHE:=$HOME/.cache/firn}"
  : "${WORLD_NORTH_DATA_LEGACY:=/home/tom/code/north-data}" # world:allow
  : "${WORLD_AGENT_DATA:=$WORLD_CODE_ROOT/agent-data}"
  : "${WORLD_HOST:=$(hostname -s)}"
  : "${WORLD_NORTH_PORT:=7977}"
  : "${WORLD_TELEMETRY_PORT:=7978}"
  : "${WORLD_RACKET_BIN:=/nix/store/67ixm62090fzccg1w9qy7wdlh3kk05r9-racket-9.1/bin/racket}"
  : "${WORLD_RACKET_HASH:=a819fcdd72d0}"
  : "${WORLD_MANIFEST_VERSION:=1}"
  : "${WORLD_GENERATED_AT:=compiled-defaults}"
  : "${WORLD_GENERATED_FROM:=compiled-defaults}"
}

readonly -a WORLD_KEYS=(
  WORLD_CODE_ROOT
  WORLD_REPO_NIXOS_CONFIG
  WORLD_REPO_NORTH
  WORLD_REPO_FRAM
  WORLD_REPO_BEAGLE
  WORLD_NORTH_STATE
  WORLD_COORD_LOG
  WORLD_TELEMETRY_LOG
  WORLD_THREADS_DIR
  WORLD_HARNESS_CONF
  WORLD_FIRN_CACHE
  WORLD_NORTH_DATA_LEGACY
  WORLD_AGENT_DATA
  WORLD_HOST
  WORLD_NORTH_PORT
  WORLD_TELEMETRY_PORT
  WORLD_RACKET_BIN
  WORLD_RACKET_HASH
  WORLD_MANIFEST_VERSION
  WORLD_GENERATED_AT
  WORLD_GENERATED_FROM
)

load_world() {
  world_defaults
  if [[ -f "$WORLD_MANIFEST_PATH" ]]; then
    if ! bash -n "$WORLD_MANIFEST_PATH"; then
      printf 'world: invalid manifest: %s\n' "$WORLD_MANIFEST_PATH" >&2
      return 1
    fi
    # shellcheck disable=SC1090
    source "$WORLD_MANIFEST_PATH"
  fi
}

world_key() {
  local key="$1"
  if [[ "$key" != WORLD_* ]]; then
    key="WORLD_${key^^}"
    key="${key//./_}"
    key="${key//-/_}"
  fi
  [[ "$key" =~ ^WORLD_[A-Z0-9_]+$ ]] || return 1
  local known
  for known in "${WORLD_KEYS[@]}"; do
    [[ "$known" == "$key" ]] && {
      printf '%s\n' "$key"
      return 0
    }
  done
  return 1
}

lint_roots() {
  if [[ -n "${WORLD_LINT_ROOTS:-}" ]]; then
    tr ':' '\n' <<<"$WORLD_LINT_ROOTS"
  else
    printf '%s\n' \
      "$WORLD_REPO_NIXOS_CONFIG" \
      "$WORLD_REPO_NORTH" \
      "$WORLD_REPO_FRAM" \
      "$WORLD_REPO_BEAGLE"
  fi
}

lint_git() {
  local local_env_vars variable
  local -a unset_args=()

  local_env_vars="$(command git rev-parse --local-env-vars)" || return 2
  while IFS= read -r variable; do
    [[ -n "$variable" ]] || continue
    if [[ ! "$variable" =~ ^GIT_[A-Z0-9_]+$ ]]; then
      printf 'world: invalid Git local environment name: %s\n' "$variable" >&2
      return 2
    fi
    unset_args+=(-u "$variable")
  done <<<"$local_env_vars"
  env "${unset_args[@]}" git "$@"
}

lint_skip_path() {
  local path="$1"
  [[ "$path" == "flake.lock" || "$path" == */flake.lock ]] && return 0
  [[ "$path" =~ (^|/)(out|\.beagle-cache|node_modules|\.direnv|docs/private)(/|$) ]] && return 0
  [[ "$path" =~ (^|/)result[^/]*(/|$) ]] && return 0
  return 1
}

lint_allow_header() {
  cat <<'EOF'
# Declared hard-coded repository paths: <repo-relative path><TAB><reference count>.
# An entry is live only while the path still carries exactly that many
# references. A stale entry and a changed count are both hard failures, so
# this file is the entire inventory — there is no separate total to drift.
# `world check --lint --write-allow` re-counts and prunes what is listed here.
# It never adds a path: a brand-new coupling is declared by hand, on purpose.
EOF
}

run_lint() {
  local allow_file="${WORLD_LINT_ALLOW_FILE:-$WORLD_SOURCE_ROOT/config/world-allow.txt}"
  local scratch
  scratch="$(mktemp -d)"
  WORLD_LINT_SCRATCH="$scratch"
  trap 'rm -rf "${WORLD_LINT_SCRATCH:?}"' EXIT
  local findings="$scratch/findings.tsv"
  : >"$findings"

  local r1='\$\{?HOME\}?/code/(nixos-config|north|fram|beagle)\b'
  local r2='/home/[a-z][a-z0-9_-]*/code/'
  # shellcheck disable=SC2088 # This is the literal repository-path form being linted.
  local r3='~/code/(nixos-config|north|fram|beagle)/'
  local canary_count
  canary_count="$(printf '/home/worldcanary/code/north/\n' | rg -c "$r2" || true)" # world:allow
  if (( canary_count < 1 )); then
    printf 'world: lint canary did not self-match\n' >&2
    return 2
  fi

  local file_count=0 root repo path full rule pattern hit line body
  while IFS= read -r root; do
    [[ -n "$root" ]] || continue
    if [[ ! -d "$root" ]] ||
       ! lint_git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      printf 'world: lint root is not a git checkout: %s\n' "$root" >&2
      return 2
    fi
    repo_dir="$(dirname "$root")"
    case "$(basename "$repo_dir")" in
      worktrees|pins) repo_dir="$(dirname "$repo_dir")" ;;
    esac
    repo="$(basename "$repo_dir")"
    while IFS= read -r -d '' path; do
      lint_skip_path "$path" && continue
      full="$root/$path"
      [[ -f "$full" ]] || continue
      if [[ "$path" == *.nix && -f "${full%.nix}.bnix" ]]; then
        continue
      fi
      ((file_count += 1))
      for rule in R1 R2; do
        [[ "$rule" == R1 ]] && pattern="$r1" || pattern="$r2"
        while IFS= read -r hit; do
          line="${hit%%:*}"
          body="${hit#*:}"
          [[ "$body" == *world:allow* ]] && continue
          printf '%s\t%s\t%s\t%s\t%s\n' "$repo/$path" "$rule" "$line" "$root" "$body" >>"$findings"
        done < <(rg -n --no-heading --color never "$pattern" "$full" || true)
      done
      if [[ -x "$full" ]]; then
        while IFS= read -r hit; do
          line="${hit%%:*}"
          body="${hit#*:}"
          [[ "$body" == *world:allow* ]] && continue
          printf '%s\tR3\t%s\t%s\t%s\n' "$repo/$path" "$line" "$root" "$body" >>"$findings"
        done < <(rg -n --no-heading --color never "$r3" "$full" || true)
      fi
    done < <(lint_git -C "$root" ls-files -z)
  done < <(lint_roots)

  if (( file_count < 100 )); then
    printf 'world: lint anti-false-green: scanned only %d files (minimum 100)\n' "$file_count" >&2
    return 2
  fi

  [[ -f "$allow_file" ]] || {
    printf 'world: missing lint allowlist: %s\n' "$allow_file" >&2
    return 2
  }

  declare -A declared=()
  declare -A found=()
  local entry count lineno=0
  while IFS= read -r entry || [[ -n "$entry" ]]; do
    ((lineno += 1))
    [[ -z "$entry" || "$entry" == \#* ]] && continue
    path="${entry%%$'\t'*}"
    count="${entry#*$'\t'}"
    if [[ "$path" == "$entry" || ! "$count" =~ ^[1-9][0-9]*$ ]]; then
      printf 'world: malformed lint allowlist entry at %s:%d: %s\n' \
        "$allow_file" "$lineno" "$entry" >&2
      return 2
    fi
    if [[ -n "${declared[$path]:-}" ]]; then
      printf 'world: duplicate lint allowlist entry: %s\n' "$path" >&2
      return 2
    fi
    declared["$path"]="$count"
  done <"$allow_file"

  local allowed=0 new=0
  while IFS=$'\t' read -r path rule line root body; do
    if [[ -n "${declared[$path]:-}" ]]; then
      ((allowed += 1))
      found["$path"]=$(( ${found[$path]:-0} + 1 ))
    else
      ((new += 1))
      printf 'WARN %s:%s [%s] %s\n' "$path" "$line" "$rule" "$body" >&2
    fi
  done <"$findings"

  # --write-allow re-counts and prunes only what is already declared. A path
  # nobody declared stays a hard failure, so this cannot launder new drift.
  if (( ${WORLD_LINT_WRITE_ALLOW:-0} == 1 )); then
    local rewritten="$scratch/allow.txt"
    lint_allow_header >"$rewritten"
    for path in "${!declared[@]}"; do
      (( ${found[$path]:-0} > 0 )) || continue
      printf '%s\t%d\n' "$path" "${found[$path]}"
    done | LC_ALL=C sort >>"$rewritten"
    cat "$rewritten" >"$allow_file"
    printf 'world: rewrote lint allowlist: %s\n' "$allow_file" >&2
    for path in "${!declared[@]}"; do
      if (( ${found[$path]:-0} == 0 )); then
        unset 'declared[$path]'
      else
        declared["$path"]="${found[$path]}"
      fi
    done
  fi

  local dead=0 want got
  for path in "${!declared[@]}"; do
    want="${declared[$path]}"
    got="${found[$path]:-0}"
    if (( got == 0 )); then
      printf 'world: dead lint allowlist entry: %s\n' "$path" >&2
      dead=1
    elif (( got != want )); then
      printf 'world: lint reference drift: %s: declared %d, found %d\n' \
        "$path" "$want" "$got" >&2
      dead=1
    fi
  done
  if (( dead == 1 )); then
    printf 'world: allowlist bookkeeping is stale — re-count and prune with: world check --lint --write-allow\n' >&2
  fi

  printf 'hardcoded-repo-paths: %d allowed, %d new\n' "$allowed" "$new"
  (( dead == 0 )) || return 2
  if (( new > 0 )) && [[ "${WORLD_LINT_FAIL:-0}" == 1 ]]; then
    return 1
  fi
  return 0
}

world_check() {
  local lint=0 errors=0
  # Local, so the ambient environment cannot ask a hook run to rewrite the
  # allowlist: the rewrite is only ever an explicit argument.
  local WORLD_LINT_WRITE_ALLOW=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --lint) lint=1 ;;
      --write-allow) WORLD_LINT_WRITE_ALLOW=1 ;;
      *)
        printf 'usage: world check [--lint] [--write-allow]\n' >&2
        return 2
        ;;
    esac
    shift
  done
  if (( WORLD_LINT_WRITE_ALLOW == 1 && lint == 0 )); then
    printf 'world: --write-allow requires --lint\n' >&2
    return 2
  fi

  if [[ ! -e "$WORLD_MANIFEST_PATH" ]]; then
    printf 'WARN world manifest is missing: %s (using compiled defaults)\n' "$WORLD_MANIFEST_PATH" >&2
  elif [[ ! -f "$WORLD_MANIFEST_PATH" || ! -r "$WORLD_MANIFEST_PATH" ]]; then
    printf 'world: manifest is not a readable regular file: %s\n' "$WORLD_MANIFEST_PATH" >&2
    errors=1
  fi

  local key value
  for key in "${WORLD_KEYS[@]}"; do
    [[ "$key" == WORLD_REPO_* ]] || continue
    value="${!key}"
    if [[ ! -d "$value" ]]; then
      printf 'world: missing checkout for %s: %s\n' "$key" "$value" >&2
      errors=1
    fi
  done

  if (( lint == 1 )); then
    run_lint || errors=$?
  fi
  return "$errors"
}

usage() {
  cat <<'EOF'
usage:
  world get <dotted.key|WORLD_KEY>
  world env
  world repo <name>
  world check [--lint] [--write-allow]
EOF
}

load_world
case "${1:-}" in
  get)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    key="$(world_key "$2")" || {
      printf 'world: unknown key: %s\n' "$2" >&2
      exit 2
    }
    printf '%s\n' "${!key}"
    ;;
  env)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    for key in "${WORLD_KEYS[@]}"; do
      printf 'export %s=%q\n' "$key" "${!key}"
    done
    ;;
  repo)
    [[ $# -eq 2 && "$2" =~ ^[A-Za-z0-9._-]+$ ]] || { usage >&2; exit 2; }
    printf '%s/%s/main\n' "${WORLD_CODE_ROOT%/}" "$2"
    ;;
  check)
    shift
    world_check "$@"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
