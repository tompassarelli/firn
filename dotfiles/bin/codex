#!/usr/bin/env bash
# Bootloader wrapper for the `codex` CLI.
#   bare / any args -> use the managed account pool.
#   as <id> [args]  -> pin one account explicitly.
set -u

PROVIDER_WORD="codex"

# Prefer the atomically promoted user runtime. PATH is only a migration fallback
# for machines that have not run codex-runtime-update yet.
self="$(realpath "$0" 2>/dev/null || echo "$0")"
REAL=""
user_runtime="${CODEX_RUNTIME:-$HOME/.local/lib/codex/current/bin/codex}"
if [ -n "${CODEX_RUNTIME:-}" ] && [ ! -x "$user_runtime" ]; then
  echo "codex: CODEX_RUNTIME is not executable: $user_runtime" >&2
  exit 127
fi
if [ -x "$user_runtime" ]; then
  REAL="$user_runtime"
else
  while IFS= read -r cand; do
    [ -n "$cand" ] || continue
    cp="$(realpath "$cand" 2>/dev/null || echo "$cand")"
    [ "$cp" = "$self" ] && continue
    REAL="$cand"; break
  done < <(type -aP codex 2>/dev/null)
fi
if [ -z "$REAL" ]; then
  echo "codex: user runtime is not installed; run codex-runtime-update" >&2
  exit 127
fi

# Compute governance: run the session inside agent.slice so a lane and
# everything it spawns yields to the desktop under contention. ONE chokepoint —
# re-exec the launcher, and every downstream exec path plus every descendant
# tool call inherits the cgroup. Weights live in nixos-config
# modules/agent-slice; this only enters them. Fails OPEN: absent
# systemd-run, no user manager, or a scope that never
# started the payload all fall through.
NORTH_SLICE_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/north/agent-slice.state"
slice_note() {
  { mkdir -p "${NORTH_SLICE_STATE%/*}"; } 2>/dev/null || true
  { printf '%s\t%s\t%s\t%s\n' \
      "${EPOCHSECONDS:-0}" "$1" "$PROVIDER_WORD" "$$" >"$NORTH_SLICE_STATE"; } \
    2>/dev/null || true
}
if [ "${NORTH_SLICE_ENTERED:-}" = "1" ]; then
  [ -n "${NORTH_SLICE_MARK:-}" ] && { : >"$NORTH_SLICE_MARK"; } 2>/dev/null
  slice_note on
elif [ "${NORTH_NO_SLICE:-}" = "1" ]; then
  slice_note off:NORTH_NO_SLICE
elif ! command -v systemd-run >/dev/null 2>&1; then
  slice_note off:no-systemd-run
elif [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -S "$XDG_RUNTIME_DIR/systemd/private" ]; then
  slice_note off:no-user-manager
else
  # Without the marker a failed scope and a session that merely exited 1 look
  # identical, and the retry would double-run the session.
  slice_dir="$(mktemp -d 2>/dev/null || true)"
  if [ -z "$slice_dir" ]; then
    slice_note off:no-scratch
  else
    NORTH_SLICE_MARK="$slice_dir/ran"
    export NORTH_SLICE_ENTERED=1 NORTH_SLICE_MARK
    systemd-run --user --scope --quiet --slice=agent.slice --same-dir --collect \
      -- "$self" "$@"
    slice_rc=$?
    slice_ran=1
    [ -e "$NORTH_SLICE_MARK" ] || slice_ran=0
    rm -rf "${slice_dir:?}"
    if [ "$slice_ran" -eq 1 ]; then
      exit "$slice_rc"
    fi
    unset NORTH_SLICE_ENTERED NORTH_SLICE_MARK
    slice_note off:scope-failed
  fi
fi

# Force launch-wide config on every standalone launch. This wrapper redirects
# CODEX_HOME to a per-account state dir whose config.toml does NOT carry the
# nixos-config full-access and agent-thread keys, so ~/.codex/config.toml is
# bypassed and codex falls back to its restricted defaults. Inject the overrides
# at exec time so every account gets the same permissions and a practical
# no-ceiling concurrency value. Codex requires a positive integer here; leaving
# the key unset restores its small built-in default.
# `-c` values are parsed as TOML.
FORCE_CONFIG=(
  -c 'approval_policy="never"'
  -c 'sandbox_mode="danger-full-access"'
  -c 'default_permissions=":danger-full-access"'
  -c 'agents.max_concurrent_threads_per_session=64'
  -c 'agents.default_subagent_model="gpt-6.1-sol"'
  -c 'agents.default_subagent_reasoning_effort="high"'
)

# The single conversation home. Managed lanes arrive with CODEX_HOME already
# set and keep their own; every other session shares this one.
CONVERSATION_HOME="${NORTH_CODEX_CONVERSATION_HOME:-${NORTH_CODEX_POOLED_HOME:-$HOME/.local/state/north/codex-pooled}}"

# Only interactive journeys attach to the shared app-server owner. App-server
# startup and maintenance commands keep their native lifecycle; an explicit
# endpoint remains the caller's choice.
shared_interactive() {
  local skip_value=0 entry command=""
  for entry in "$@"; do
    if ((skip_value)); then skip_value=0; continue; fi
    case "$entry" in
      --remote|--remote=*|-h|--help|-V|--version) return 1 ;;
      -c|--config|--enable|--disable|--remote-auth-token-env|\
      -i|--image|-m|--model|--local-provider|-p|--profile|-s|--sandbox|\
      -C|--cd|--add-dir|-a|--ask-for-approval) skip_value=1 ;;
      --) break ;;
      -*) ;;
      *)
        if [[ -z "$command" ]]; then command="$entry"; fi
        ;;
    esac
  done
  case "$command" in
    ""|resume|fork) return 0 ;;
    exec|e|review|login|logout|mcp|plugin|app-server|remote-control|completion|\
    update|doctor|sandbox|debug|apply|a|queue|archive|delete|migrate-rollouts|\
    unarchive|cloud|exec-server|features|help|agents) return 1 ;;
    *) return 0 ;;
  esac
}

# Codex refuses --add-dir alongside --remote: an attached client may not widen
# the server's workspace. The server's own launch is never remote and carries
# these roots itself, so every remote invocation drops them here.
remote_invocation() {
  local skip_value=0 entry
  for entry in "$@"; do
    if ((skip_value)); then skip_value=0; continue; fi
    case "$entry" in
      --remote|--remote=*) return 0 ;;
      -c|--config|--enable|--disable|--remote-auth-token-env|\
      -i|--image|-m|--model|--local-provider|-p|--profile|-s|--sandbox|\
      -C|--cd|--add-dir|-a|--ask-for-approval) skip_value=1 ;;
      --) break ;;
    esac
  done
  return 1
}

# Run the session in the conversation home. The provider service has its own
# owner; this launcher stays in the foreground and never supervises it.
exec_conversation() {
  local endpoint subcommand exec_args resume_arg_index arg_index arg resume_prefix_length
  [ -d "$CONVERSATION_HOME" ] || {
    printf 'codex: conversation home is unavailable at %s\n' "$CONVERSATION_HOME" >&2
    exit 1
  }
  export CODEX_HOME="$CONVERSATION_HOME"
  export CODEX_SQLITE_HOME="${NORTH_CODEX_CONVERSATION_SQLITE_HOME:-$CONVERSATION_HOME/sqlite}"

  local workspace_args=(--add-dir "$HOME/code")
  local provider_args=(
    -c 'model="gpt-6-astra"'
    -c 'model_reasoning_effort="xhigh"'
  )
  local full_access_args=(--dangerously-bypass-approvals-and-sandbox)
  local shared_args=()
  if shared_interactive "$@"; then
    endpoint="$("$(dirname "$self")/codex-shared-server")"
    shared_args=(--remote "$endpoint")
  fi
  if ((${#shared_args[@]})) || remote_invocation "$@"; then
    workspace_args=()
  fi

  case "${1:-}" in
    exec|e)
      subcommand="$1"
      shift
      exec_args=("$@")
      resume_arg_index=-1
      arg_index=0
      while ((arg_index < ${#exec_args[@]})); do
        arg="${exec_args[arg_index]}"
        case "$arg" in
          --|-)
            break
            ;;
          -c|--config|--enable|--disable|--remote|--thread-source|\
          -i|--image|-m|--model|--local-provider|-p|--profile|\
          -s|--sandbox|-C|--cd|--add-dir|--output-schema|\
          --color|-o|--output-last-message)
            ((arg_index += 2))
            ;;
          -*)
            ((arg_index += 1))
            ;;
          resume)
            resume_arg_index="$arg_index"
            break
            ;;
          *)
            break
            ;;
        esac
      done
      if ((resume_arg_index >= 0)); then
        resume_prefix_length=$((resume_arg_index + 1))
        exec "$REAL" "${FORCE_CONFIG[@]}" "$subcommand" \
          "${exec_args[@]:0:resume_arg_index}" \
          "${workspace_args[@]}" resume \
          "${provider_args[@]}" "${full_access_args[@]}" \
          "${exec_args[@]:resume_prefix_length}"
      fi
      exec "$REAL" "${FORCE_CONFIG[@]}" "$subcommand" \
        "${workspace_args[@]}" "${provider_args[@]}" \
        "${full_access_args[@]}" "${exec_args[@]}"
      ;;
    review)
      subcommand="$1"
      shift
      exec "$REAL" "${FORCE_CONFIG[@]}" "$subcommand" "${provider_args[@]}" "$@"
      ;;
    *)
      local force_args=("${FORCE_CONFIG[@]}")
      # Codex rejects permission overrides when resuming through the shared
      # server; that server already runs with the same permissions.
      if ((${#shared_args[@]})) && [[ "${1:-}" = resume || "${1:-}" = fork ]]; then
        force_args=(
          -c 'agents.max_concurrent_threads_per_session=64'
          -c 'agents.default_subagent_model="gpt-6.1-sol"'
          -c 'agents.default_subagent_reasoning_effort="high"'
        )
      fi
      exec "$REAL" "${force_args[@]}" \
        "${workspace_args[@]}" "${provider_args[@]}" "${shared_args[@]}" "$@"
      ;;
  esac
}

codex_option_takes_value() {
  case "$1" in
    -c|--config|--enable|--disable|--remote|--remote-auth-token-env|\
    -i|--image|-m|--model|--local-provider|-p|--profile|-s|--sandbox|\
    -C|--cd|--add-dir|-a|--ask-for-approval)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

codex_option_has_attached_value() {
  case "$1" in
    --config=*|--enable=*|--disable=*|--remote=*|--remote-auth-token-env=*|\
    --image=*|--model=*|--local-provider=*|--profile=*|--sandbox=*|--cd=*|\
    --add-dir=*|--ask-for-approval=*|\
    -c?*|-i?*|-m?*|-p?*|-s?*|-C?*|-a?*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

codex_known_flag() {
  case "$1" in
    --strict-config|--oss|--dangerously-bypass-approvals-and-sandbox|\
    --dangerously-bypass-hook-trust|--search|--no-alt-screen)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

codex_terminal_flag() {
  case "$1" in
    -h|--help|-V|--version)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

# 1. Uniform resume syntax: upstream Codex uses `codex resume ID`; accept the
#    requested `codex --resume ID` / `codex --resume=ID` aliases as well.
#    Resolve exact UUIDs to their existing conversation home.
resume_index=-1
resume_marker=-1
resume_id=""
resume_alias=0
resume_equals=0
resume_last=0
resume_terminal=0
skip_value=0
argv=("$@")
for entry in "${argv[@]}"; do
  case "$entry" in
    --) break ;;
    -h|--help|-V|--version)
      resume_terminal=1
      break
      ;;
  esac
done
for index in "${!argv[@]}"; do
  if [ "$skip_value" -eq 1 ]; then
    skip_value=0
    continue
  fi
  case "${argv[$index]}" in
    --)
      break
      ;;
    resume)
      skip_resume_value=0
      after_separator=0
      for ((next = index + 1; next < ${#argv[@]}; next++)); do
        if [ "$skip_resume_value" -eq 1 ]; then
          skip_resume_value=0
          continue
        fi
        if [ "$after_separator" -eq 1 ]; then
          resume_index="$next"
          resume_id="${argv[$next]}"
          break
        fi
        case "${argv[$next]}" in
          --)
            after_separator=1
            ;;
          --last)
            # --last supplies the session selection; any positional that
            # follows is a prompt, even when it happens to look like a UUID.
            resume_last=1
            break
            ;;
          --all|--include-non-interactive)
            ;;
          *)
            if codex_option_takes_value "${argv[$next]}"; then
              skip_resume_value=1
            elif codex_terminal_flag "${argv[$next]}"; then
              break
            elif codex_option_has_attached_value "${argv[$next]}" ||
                 codex_known_flag "${argv[$next]}"; then
              :
            elif [[ "${argv[$next]}" = -* ]]; then
              # Unknown future option: leave parsing to Codex rather than
              # risk treating its value as a session id.
              break
            else
              # SESSION_ID/name is the first positional. Never scan into the
              # optional PROMPT for a later UUID.
              resume_index="$next"
              resume_id="${argv[$next]}"
              break
            fi
            ;;
        esac
      done
      break
      ;;
    --resume)
      resume_marker="$index"
      resume_alias=1
      next=$((index + 1))
      if [ "$next" -lt "${#argv[@]}" ]; then
        resume_index="$next"
        resume_id="${argv[$next]}"
      fi
      break
      ;;
    --resume=*)
      resume_marker="$index"
      resume_index="$index"
      resume_id="${argv[$index]#--resume=}"
      resume_alias=1
      resume_equals=1
      break
      ;;
    *)
      if codex_option_takes_value "${argv[$index]}"; then
        skip_value=1
      elif codex_terminal_flag "${argv[$index]}"; then
        break
      elif codex_option_has_attached_value "${argv[$index]}" ||
           codex_known_flag "${argv[$index]}"; then
        :
      else
        # Another subcommand or an interactive prompt owns the remaining
        # argv; a later literal "resume"/"--resume" is not launcher syntax.
        break
      fi
      ;;
  esac
done

# A caller-supplied Codex home is an exact authority. Normalize the friendly
# alias, but never search outside a managed/custom/explicitly pinned home.
if [ -n "${CODEX_HOME:-}" ]; then
  if [ "$resume_alias" -eq 1 ]; then
    if [ "$resume_equals" -eq 1 ]; then
      argv=("${argv[@]:0:$resume_marker}" resume "$resume_id" "${argv[@]:$((resume_marker + 1))}")
    else
      argv[resume_marker]=resume
    fi
    set -- "${argv[@]}"
  fi
  exec "$REAL" "${FORCE_CONFIG[@]}" "$@"
fi

uuid_re='^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$'
if [ "$resume_terminal" -eq 0 ] && [ "$resume_last" -eq 0 ] &&
   [ "$resume_index" -ge 0 ] &&
   [[ "$resume_id" =~ $uuid_re ]]; then
  resolver="$(dirname "$self")/north-session-resolve"
  if [ ! -x "$resolver" ]; then
    echo "codex: cross-account resume resolver is unavailable: $resolver" >&2
    exit 127
  fi
  printf '[codex] north launcher — resolving cross-account resume…\n' >&2
  resolved="$("$resolver" openai "$resume_id")"
  resolve_status=$?
  [ "$resolve_status" -eq 0 ] || exit "$resolve_status"
  IFS=$'\t' read -r version resolved_provider authority_kind authority_name authority_home canonical_id <<<"$resolved"
  if [ "$version" != "v1" ] || [ "$resolved_provider" != "openai" ] ||
     [ -z "$authority_home" ] || [ -z "$canonical_id" ]; then
    echo "codex: cross-account resume resolver returned an invalid result" >&2
    exit 1
  fi
  if [ "$resume_alias" -eq 1 ] && [ "$resume_equals" -eq 1 ]; then
    argv=("${argv[@]:0:$resume_marker}" resume "$canonical_id" "${argv[@]:$((resume_marker + 1))}")
  elif [ "$resume_alias" -eq 1 ]; then
    argv[resume_marker]=resume
    argv[resume_index]="$canonical_id"
  else
    argv[resume_index]="$canonical_id"
  fi
  set -- "${argv[@]}"
  printf '[codex resume → %s:%s]\n' "$authority_kind" "$authority_name" >&2
  if [ "$authority_kind" = "pooled" ]; then
    CONVERSATION_HOME="$authority_home"
    export NORTH_CODEX_CONVERSATION_HOME="$authority_home"
    export NORTH_CODEX_CONVERSATION_SQLITE_HOME="$authority_home/sqlite"
    exec_conversation "$@"
  fi
  if [ "$authority_kind" = "profile" ] && [ "$authority_name" = "codex-native" ]; then
    native="$(dirname "$self")/codex-native"
    [ -x "$native" ] || { echo "codex: native launcher is unavailable: $native" >&2; exit 127; }
    exec "$native" "$@"
  fi
  CONVERSATION_HOME="$authority_home"
  export NORTH_CODEX_CONVERSATION_HOME="$authority_home"
  if [ "$authority_kind" = "ambient" ]; then
    export NORTH_CODEX_CONVERSATION_SQLITE_HOME="$authority_home"
  else
    export NORTH_CODEX_CONVERSATION_SQLITE_HOME="$authority_home/sqlite"
  fi
  exec_conversation "$@"
fi

# Non-UUID aliases still map to the native subcommand (picker/session name)
# and then follow the existing pinned/automatic account routing.
if [ "$resume_alias" -eq 1 ]; then
  if [ "$resume_equals" -eq 1 ]; then
    argv=("${argv[@]:0:$resume_marker}" resume "$resume_id" "${argv[@]:$((resume_marker + 1))}")
  else
    argv[resume_marker]=resume
  fi
  set -- "${argv[@]}"
fi
# 2. Managed lanes arrive with CODEX_HOME already set and keep their own home.
if [ -n "${CODEX_HOME:-}" ]; then
  exec "$REAL" "${FORCE_CONFIG[@]}" "$@"
fi

# 3. Every other session runs in the single conversation home.
exec_conversation "$@"
