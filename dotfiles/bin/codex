#!/usr/bin/env bash
# Bootloader wrapper for the `codex` CLI.
#   bare / any args -> auto-select the north-managed OpenAI account with the
#                      most headroom, then exec the real codex.
#   as <id> [args]  -> pin one account explicitly.
# Fails OPEN: north trouble never blocks the real binary — but the banner names
# the ACTUAL reason (north missing / snapshot error / empty or malformed data /
# no eligible account / vanished account dir), never a blanket "north
# unavailable", and points at an explicit `codex as <id>` recovery — using a
# real id when one is known, never guessing one.
set -u

PROVIDER_WORD="codex"
ACCOUNTS_ROOT="$HOME/.local/state/north/accounts/openai"
NORTH_PROVIDER="openai"
BIND_LIMIT="codex:primary"   # window that binds OpenAI subscription usage

# Locate the real codex: first PATH entry that isn't this wrapper itself.
self="$(realpath "$0" 2>/dev/null || echo "$0")"
REAL=""
while IFS= read -r cand; do
  [ -n "$cand" ] || continue
  cp="$(realpath "$cand" 2>/dev/null || echo "$cand")"
  [ "$cp" = "$self" ] && continue
  REAL="$cand"; break
done < <(type -aP codex 2>/dev/null)
if [ -z "$REAL" ]; then
  echo "codex: real binary not found on PATH" >&2
  exit 127
fi

# Force full-permission mode on every standalone launch. This wrapper redirects
# CODEX_HOME to a per-account state dir whose config.toml does NOT carry the
# nixos-config full-access keys, so ~/.codex/config.toml is bypassed and codex
# falls back to its restricted defaults (approval OnRequest, sandboxed fs/net).
# Inject the overrides at exec time so approval/sandbox stay full-access no
# matter which account config loads. `-c` values are parsed as TOML.
FORCE_PERMS=(
  -c 'approval_policy="never"'
  -c 'sandbox_mode="danger-full-access"'
  -c 'default_permissions=":danger-full-access"'
)

# Native provider roots are a coordination surface when North owns dispatch:
# keep the listener capable, but do not let an ambient Codex session silently
# become another agent orchestrator. These are launch defaults, deliberately
# placed before caller argv so a later explicit model/reasoning choice wins.
# Account-pinned managed lanes return through the passthrough guard below and
# therefore never inherit this native-root policy.
native_dispatch_args() {
  local state mode="north" line enforce_topology=1
  if [ -n "${NORTH_HARNESS_STATE:-}" ]; then
    state="$NORTH_HARNESS_STATE"
  elif [ -f "$HOME/.local/state/north/harness.conf" ]; then
    state="$HOME/.local/state/north/harness.conf"
  else
    state="$HOME/.claude/my-config.state"
  fi
  if [ -r "$state" ]; then
    while IFS= read -r line; do
      case "$line" in dispatch=*) mode="${line#dispatch=}" ;; esac
    done <"$state"
    mode="${mode:-north}"
  fi
  case "$mode" in
    native) return 0 ;;
    warn) enforce_topology=0 ;;
    north) ;;
    *) mode="north" ;;
  esac
  printf '%s\0' \
    '-c' 'model="gpt-5.6-terra"' \
    '-c' 'model_reasoning_effort="medium"'
  [ "$enforce_topology" -eq 0 ] || printf '%s\0' '--disable' 'multi_agent'
}

codex_option_takes_value() {
  case "$1" in
    -c|--config|--enable|--disable|--remote|--remote-auth-token-env|\
    -i|--image|-m|--model|--local-provider|-p|--profile|-s|--sandbox|\
    -C|--cd|--add-dir|-a|--ask-for-approval)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

codex_option_has_attached_value() {
  case "$1" in
    --config=*|--enable=*|--disable=*|--remote=*|--remote-auth-token-env=*|\
    --image=*|--model=*|--local-provider=*|--profile=*|--sandbox=*|--cd=*|\
    --add-dir=*|--ask-for-approval=*|\
    -c?*|-i?*|-m?*|-p?*|-s?*|-C?*|-a?*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

codex_known_flag() {
  case "$1" in
    --strict-config|--oss|--dangerously-bypass-approvals-and-sandbox|\
    --dangerously-bypass-hook-trust|--search|--no-alt-screen)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

codex_terminal_flag() {
  case "$1" in
    -h|--help|-V|--version)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

NATIVE_DISPATCH_ARGS=()
while IFS= read -r -d '' arg; do
  NATIVE_DISPATCH_ARGS+=("$arg")
done < <(native_dispatch_args)

# 1. Uniform resume syntax: upstream Codex uses `codex resume ID`; accept the
#    requested `codex --resume ID` / `codex --resume=ID` aliases as well.
#    Resolve exact UUIDs before quota selection can choose the wrong account.
#    `codex as <id> ...` remains an explicit override.
if [ "${1:-}" != "as" ]; then
  resume_index=-1
  resume_marker=-1
  resume_id=""
  resume_alias=0
  resume_equals=0
  resume_last=0
  resume_terminal=0
  skip_value=0
  argv=("$@")
  for entry in "${argv[@]}"; do
    case "$entry" in
      --) break ;;
      -h|--help|-V|--version)
        resume_terminal=1
        break
        ;;
    esac
  done
  for index in "${!argv[@]}"; do
    if [ "$skip_value" -eq 1 ]; then
      skip_value=0
      continue
    fi
    case "${argv[$index]}" in
      --)
        break
        ;;
      resume)
        skip_resume_value=0
        after_separator=0
        for ((next = index + 1; next < ${#argv[@]}; next++)); do
          if [ "$skip_resume_value" -eq 1 ]; then
            skip_resume_value=0
            continue
          fi
          if [ "$after_separator" -eq 1 ]; then
            resume_index="$next"
            resume_id="${argv[$next]}"
            break
          fi
          case "${argv[$next]}" in
            --)
              after_separator=1
              ;;
            --last)
              # --last supplies the session selection; any positional that
              # follows is a prompt, even when it happens to look like a UUID.
              resume_last=1
              break
              ;;
            --all|--include-non-interactive)
              ;;
            *)
              if codex_option_takes_value "${argv[$next]}"; then
                skip_resume_value=1
              elif codex_terminal_flag "${argv[$next]}"; then
                break
              elif codex_option_has_attached_value "${argv[$next]}" ||
                   codex_known_flag "${argv[$next]}"; then
                :
              elif [[ "${argv[$next]}" = -* ]]; then
                # Unknown future option: leave parsing to Codex rather than
                # risk treating its value as a session id.
                break
              else
                # SESSION_ID/name is the first positional. Never scan into the
                # optional PROMPT for a later UUID.
                resume_index="$next"
                resume_id="${argv[$next]}"
                break
              fi
              ;;
          esac
        done
        break
        ;;
      --resume)
        resume_marker="$index"
        resume_alias=1
        next=$((index + 1))
        if [ "$next" -lt "${#argv[@]}" ]; then
          resume_index="$next"
          resume_id="${argv[$next]}"
        fi
        break
        ;;
      --resume=*)
        resume_marker="$index"
        resume_index="$index"
        resume_id="${argv[$index]#--resume=}"
        resume_alias=1
        resume_equals=1
        break
        ;;
      *)
        if codex_option_takes_value "${argv[$index]}"; then
          skip_value=1
        elif codex_terminal_flag "${argv[$index]}"; then
          break
        elif codex_option_has_attached_value "${argv[$index]}" ||
             codex_known_flag "${argv[$index]}"; then
          :
        else
          # Another subcommand or an interactive prompt owns the remaining
          # argv; a later literal "resume"/"--resume" is not launcher syntax.
          break
        fi
        ;;
    esac
  done

  # A caller-supplied Codex home is an exact authority. Normalize the friendly
  # alias, but never search outside a managed/custom/explicitly pinned home.
  if [ -n "${CODEX_HOME:-}" ]; then
    if [ "$resume_alias" -eq 1 ]; then
      if [ "$resume_equals" -eq 1 ]; then
        argv=("${argv[@]:0:$resume_marker}" resume "$resume_id" "${argv[@]:$((resume_marker + 1))}")
      else
        argv[resume_marker]=resume
      fi
      set -- "${argv[@]}"
    fi
    exec "$REAL" "${FORCE_PERMS[@]}" "$@"
  fi

  uuid_re='^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$'
  if [ "$resume_terminal" -eq 0 ] && [ "$resume_last" -eq 0 ] &&
     [ "$resume_index" -ge 0 ] &&
     [[ "$resume_id" =~ $uuid_re ]]; then
    resolver="$(dirname "$self")/north-session-resolve"
    if [ ! -x "$resolver" ]; then
      echo "codex: cross-account resume resolver is unavailable: $resolver" >&2
      exit 127
    fi
    resolved="$("$resolver" openai "$resume_id")"
    resolve_status=$?
    [ "$resolve_status" -eq 0 ] || exit "$resolve_status"
    IFS=$'\t' read -r version resolved_provider authority_kind authority_name authority_home canonical_id <<<"$resolved"
    if [ "$version" != "v1" ] || [ "$resolved_provider" != "openai" ] ||
       [ -z "$authority_home" ] || [ -z "$canonical_id" ]; then
      echo "codex: cross-account resume resolver returned an invalid result" >&2
      exit 1
    fi
    if [ "$resume_alias" -eq 1 ] && [ "$resume_equals" -eq 1 ]; then
      argv=("${argv[@]:0:$resume_marker}" resume "$canonical_id" "${argv[@]:$((resume_marker + 1))}")
    elif [ "$resume_alias" -eq 1 ]; then
      argv[resume_marker]=resume
      argv[resume_index]="$canonical_id"
    else
      argv[resume_index]="$canonical_id"
    fi
    set -- "${argv[@]}"
    printf '[codex resume → %s:%s]\n' "$authority_kind" "$authority_name" >&2
    if [ "$authority_kind" = "profile" ] && [ "$authority_name" = "codex-stock" ]; then
      stock="$(dirname "$self")/codex-stock"
      [ -x "$stock" ] || { echo "codex: stock launcher is unavailable: $stock" >&2; exit 127; }
      exec "$stock" "$@"
    fi
    export CODEX_HOME="$authority_home"
    if [ "$authority_kind" = "ambient" ]; then
      export CODEX_SQLITE_HOME="$authority_home"
    else
      export CODEX_SQLITE_HOME="$authority_home/sqlite"
    fi
    exec "$REAL" "${FORCE_PERMS[@]}" "${NATIVE_DISPATCH_ARGS[@]}" "$@"
  fi

  # Non-UUID aliases still map to the native subcommand (picker/session name)
  # and then follow the existing pinned/automatic account routing.
  if [ "$resume_alias" -eq 1 ]; then
    if [ "$resume_equals" -eq 1 ]; then
      argv=("${argv[@]:0:$resume_marker}" resume "$resume_id" "${argv[@]:$((resume_marker + 1))}")
    else
      argv[resume_marker]=resume
    fi
    set -- "${argv[@]}"
  fi
fi

# 2. Passthrough guard for `codex as ...`, which intentionally skipped the
#    automatic resume parser above.
if [ -n "${CODEX_HOME:-}" ]; then
  exec "$REAL" "${FORCE_PERMS[@]}" "$@"
fi

list_accounts() {
  [ -d "$ACCOUNTS_ROOT" ] && \
    find "$ACCOUNTS_ROOT" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort
}

# 3. Explicit pin: `codex as <id> [args...]`.
if [ "${1:-}" = "as" ]; then
  shift
  acct="${1:-}"
  usage() {
    echo "usage: codex as <account-id> [codex args...]"
    echo "available account ids:"
    list_accounts | sed 's/^/  /'
  }
  case "$acct" in
    -h|--help) usage; exit 0 ;;
    "")        usage >&2; exit 1 ;;
  esac
  shift
  root="$ACCOUNTS_ROOT/$acct"
  if [ ! -d "$root" ]; then
    {
      echo "codex as: unknown account '$acct'"
      echo "available account ids:"
      list_accounts | sed 's/^/  /'
    } >&2
    exit 1
  fi
  export CODEX_HOME="$root"
  export CODEX_SQLITE_HOME="$root/sqlite"
  exec "$REAL" "${FORCE_PERMS[@]}" "${NATIVE_DISPATCH_ARGS[@]}" "$@"
fi

# 4. Auto-select greatest-headroom account from north's machine boundary.
#    Rank: headroom class (plenty>low>other), then lowest used% on the binding
#    window, then north's target listing order. Every failure mode fails OPEN
#    but is reported distinctly — the caller learns WHY it went ambient.
#
#    Emits a single tab-separated verdict line on stdout:
#      ok\t<account-id>     a rankable eligible account was chosen
#      err\t<reason>        no id — <reason> is a concise, actionable cause
#    Never touches account state; the caller decides how to act on the verdict.
select_account() {
  if ! command -v north >/dev/null 2>&1; then
    printf 'err\tnorth not found on PATH\n'
    return
  fi

  local errfile json rc detail
  errfile="$(mktemp 2>/dev/null || true)"
  if [ -n "$errfile" ]; then
    json="$(env -u NORTH_CHECKOUT north providers --json 2>"$errfile")"; rc=$?
  else
    json="$(env -u NORTH_CHECKOUT north providers --json 2>/dev/null)"; rc=$?
  fi

  if [ "$rc" -ne 0 ]; then
    detail=""
    [ -n "$errfile" ] && detail="$(head -n1 "$errfile" 2>/dev/null)"
    [ -n "$errfile" ] && rm -f "$errfile"
    if [ -n "$detail" ]; then
      printf 'err\tnorth providers exited %s: %s\n' "$rc" "$detail"
    else
      printf 'err\tnorth providers exited %s\n' "$rc"
    fi
    return
  fi
  [ -n "$errfile" ] && rm -f "$errfile"

  if [ -z "$json" ]; then
    printf 'err\tnorth providers returned no output\n'
    return
  fi

  local id
  if ! id="$(printf '%s' "$json" | jq -r --arg prov "$NORTH_PROVIDER" --arg limit "$BIND_LIMIT" '
    (.providers[]? | select(.provider==$prov) | .targets) // []
    | to_entries
    | map(.value + {order: .key})
    | map(select(.authenticated==true and .routing=="eligible"))
    | map({
        id,
        order,
        hclass: (if .headroom=="plenty" then 0
                 elif .headroom=="low" then 1
                 else 2 end),
        used: ([.usage.windows[]? | select(.limitId==$limit) | .usedPercent][0] // 999)
      })
    | sort_by(.hclass, .used, .order)
    | .[0].id // empty
  ' 2>/dev/null)"; then
    printf 'err\tnorth providers JSON was malformed\n'
    return
  fi

  if [ -z "$id" ]; then
    printf 'err\tno eligible %s account (need authenticated + routing-eligible)\n' "$NORTH_PROVIDER"
    return
  fi

  printf 'ok\t%s\n' "$id"
}

# Concise recovery hint: prefer a real, known id; otherwise show the command
# shape with any on-disk account ids, never inventing an account.
recovery_hint() {
  local known
  known="$(list_accounts | paste -sd, - 2>/dev/null)"
  if [ -n "$known" ]; then
    printf 'pin explicitly: %s as <id> (known: %s)' "$PROVIDER_WORD" "$known"
  else
    printf 'no %s accounts present — authenticate one, then: %s as <id>' \
      "$PROVIDER_WORD" "$PROVIDER_WORD"
  fi
}

verdict="$(select_account)"
kind="${verdict%%$'\t'*}"
value="${verdict#*$'\t'}"

if [ "$kind" = "ok" ] && [ -n "$value" ]; then
  if [ -d "$ACCOUNTS_ROOT/$value" ]; then
    export CODEX_HOME="$ACCOUNTS_ROOT/$value"
    export CODEX_SQLITE_HOME="$ACCOUNTS_ROOT/$value/sqlite"
    printf '[%s → %s]\n' "$PROVIDER_WORD" "$value" >&2
  else
    # An id was selected but its state dir vanished. Do NOT auto-pick it
    # (unverified stale account); fail open and name the exact recovery.
    printf '[%s → ambient] selected %s but %s/%s is absent — pin once restored: %s as %s\n' \
      "$PROVIDER_WORD" "$value" "$ACCOUNTS_ROOT" "$value" "$PROVIDER_WORD" "$value" >&2
  fi
else
  reason="$value"
  [ "$kind" = "ok" ] && reason="north returned an empty selection"
  printf '[%s → ambient] %s — %s\n' "$PROVIDER_WORD" "$reason" "$(recovery_hint)" >&2
fi
exec "$REAL" "${FORCE_PERMS[@]}" "${NATIVE_DISPATCH_ARGS[@]}" "$@"
