#!/usr/bin/env bash
# Bootloader wrapper for the `codex` CLI.
#   bare / any args -> use the managed account pool.
#   as <id> [args]  -> pin one account explicitly.
set -u

PROVIDER_WORD="codex"
ACCOUNTS_ROOT="$HOME/.local/state/north/accounts/openai"

# Prefer the atomically promoted user runtime. PATH is only a migration fallback
# for machines that have not run codex-runtime-update yet.
self="$(realpath "$0" 2>/dev/null || echo "$0")"
REAL=""
user_runtime="${CODEX_RUNTIME:-$HOME/.local/lib/codex/current/bin/codex}"
if [ -n "${CODEX_RUNTIME:-}" ] && [ ! -x "$user_runtime" ]; then
  echo "codex: CODEX_RUNTIME is not executable: $user_runtime" >&2
  exit 127
fi
if [ -x "$user_runtime" ]; then
  REAL="$user_runtime"
else
  while IFS= read -r cand; do
    [ -n "$cand" ] || continue
    cp="$(realpath "$cand" 2>/dev/null || echo "$cand")"
    [ "$cp" = "$self" ] && continue
    REAL="$cand"; break
  done < <(type -aP codex 2>/dev/null)
fi
if [ -z "$REAL" ]; then
  echo "codex: user runtime is not installed; run codex-runtime-update" >&2
  exit 127
fi

# Compute governance: run the session inside agent.slice so a lane and
# everything it spawns yields to the desktop under contention. ONE chokepoint —
# re-exec the launcher, and every downstream exec path plus every descendant
# tool call inherits the cgroup. Weights live in nixos-config
# modules/agent-slice; this only enters them. Fails OPEN: absent
# systemd-run, no user manager, or a scope that never
# started the payload all fall through.
NORTH_SLICE_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/north/agent-slice.state"
slice_note() {
  { mkdir -p "${NORTH_SLICE_STATE%/*}"; } 2>/dev/null || true
  { printf '%s\t%s\t%s\t%s\n' \
      "${EPOCHSECONDS:-0}" "$1" "$PROVIDER_WORD" "$$" >"$NORTH_SLICE_STATE"; } \
    2>/dev/null || true
}
if [ "${NORTH_SLICE_ENTERED:-}" = "1" ]; then
  [ -n "${NORTH_SLICE_MARK:-}" ] && { : >"$NORTH_SLICE_MARK"; } 2>/dev/null
  slice_note on
elif [ "${NORTH_NO_SLICE:-}" = "1" ]; then
  slice_note off:NORTH_NO_SLICE
elif ! command -v systemd-run >/dev/null 2>&1; then
  slice_note off:no-systemd-run
elif [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -S "$XDG_RUNTIME_DIR/systemd/private" ]; then
  slice_note off:no-user-manager
else
  # Without the marker a failed scope and a session that merely exited 1 look
  # identical, and the retry would double-run the session.
  slice_dir="$(mktemp -d 2>/dev/null || true)"
  if [ -z "$slice_dir" ]; then
    slice_note off:no-scratch
  else
    NORTH_SLICE_MARK="$slice_dir/ran"
    export NORTH_SLICE_ENTERED=1 NORTH_SLICE_MARK
    systemd-run --user --scope --quiet --slice=agent.slice --same-dir --collect \
      -- "$self" "$@"
    slice_rc=$?
    slice_ran=1
    [ -e "$NORTH_SLICE_MARK" ] || slice_ran=0
    rm -rf "${slice_dir:?}"
    if [ "$slice_ran" -eq 1 ]; then
      exit "$slice_rc"
    fi
    unset NORTH_SLICE_ENTERED NORTH_SLICE_MARK
    slice_note off:scope-failed
  fi
fi

# Codex v2 only advertises catalog entries tagged for its multi-agent protocol.
# The local catalog still tags Luna as v1, so preserve the live catalog and
# project the one corrected capability into this process at startup. A catalog
# outage must never make the launcher unavailable.
codex_luna_v2_catalog() {
  local runtime_root="${XDG_RUNTIME_DIR:-}" catalog_dir raw patched final
  [ -n "$runtime_root" ] || return 1
  command -v curl >/dev/null 2>&1 || return 1
  command -v jq >/dev/null 2>&1 || return 1

  catalog_dir="$runtime_root/codex"
  mkdir -p "$catalog_dir" 2>/dev/null || return 1
  raw="$(mktemp "$catalog_dir/model-catalog.raw.XXXXXX" 2>/dev/null)" || return 1
  patched="$(mktemp "$catalog_dir/model-catalog.luna-v2.XXXXXX" 2>/dev/null)" || {
    rm -f "$raw"
    return 1
  }

  if ! curl -fsS --connect-timeout 0.25 --max-time 1 \
      http://127.0.0.1:2455/backend-api/codex/models >"$raw" 2>/dev/null \
    || ! jq -e '
      ([.models[]? | select(.slug == "gpt-5.6-luna")] | length) as $matches
      | if $matches == 1 then
          .models |= map(
            if .slug == "gpt-5.6-luna"
            then .multi_agent_version = "v2"
            else .
            end
          )
        else
          error("expected exactly one gpt-5.6-luna catalog entry")
        end
    ' "$raw" >"$patched" 2>/dev/null; then
    rm -f "$raw" "$patched"
    return 1
  fi

  final="$catalog_dir/model-catalog-luna-v2.json"
  chmod 600 "$patched" 2>/dev/null || true
  if ! mv -f "$patched" "$final" 2>/dev/null; then
    rm -f "$raw" "$patched"
    return 1
  fi
  rm -f "$raw"
  printf '%s\n' "$final"
}

CODEX_MODEL_CATALOG_ARGS=()
if codex_model_catalog="$(codex_luna_v2_catalog)"; then
  CODEX_MODEL_CATALOG_ARGS=(-c "model_catalog_json=\"$codex_model_catalog\"")
fi

# Force launch-wide config on every standalone launch. This wrapper redirects
# CODEX_HOME to a per-account state dir whose config.toml does NOT carry the
# nixos-config full-access and agent-thread keys, so ~/.codex/config.toml is
# bypassed and codex falls back to its restricted defaults. Inject the overrides
# at exec time so every account gets the same permissions and a practical
# no-ceiling concurrency value. Codex requires a positive integer here; leaving
# the key unset restores its small built-in default.
# `-c` values are parsed as TOML.
FORCE_CONFIG=(
  -c 'approval_policy="never"'
  -c 'sandbox_mode="danger-full-access"'
  -c 'default_permissions=":danger-full-access"'
  -c 'agents.max_concurrent_threads_per_session=64'
  "${CODEX_MODEL_CATALOG_ARGS[@]}"
)

# Direct user sessions may coordinate work across repositories beneath the
# stable code root. Managed lanes arrive with CODEX_HOME already set and return
# through the passthrough branches, so they retain their narrower workspace.
DIRECT_WORKSPACE_ARGS=(
  --add-dir /home/tom/code
)

# Native provider roots are a coordination surface when North owns dispatch:
# keep the listener capable, but do not let an ambient Codex session silently
# become another agent orchestrator. These are launch defaults, deliberately
# placed before caller argv so a later explicit model/reasoning choice wins.
# Account-pinned managed lanes return through the passthrough guard below and
# therefore never inherit this native-root policy.
native_dispatch_args() {
  local state mode="north" line enforce_topology=1
  if [ -n "${NORTH_HARNESS_STATE:-}" ]; then
    state="$NORTH_HARNESS_STATE"
  elif [ -f "$HOME/.local/state/north/harness.conf" ]; then
    state="$HOME/.local/state/north/harness.conf"
  else
    state="$HOME/.local/state/north/harness.conf"
  fi
  if [ -r "$state" ]; then
    while IFS= read -r line; do
      case "$line" in dispatch=*) mode="${line#dispatch=}" ;; esac
    done <"$state"
    mode="${mode:-north}"
  fi
  # `north config dispatch` owns this vocabulary; this table must track it.
  # Disabling multi_agent is correct ONLY when native dispatch is actually
  # denied. A catch-all here once left native-forced sessions with no dispatch
  # surface at all.
  case "$mode" in
    # Current vocabulary (`north config dispatch`): native | north | auto.
    # `auto` chooses per dispatch, so native dispatch stays available; only a
    # pinned `north` denies it. Omitting `auto` sent every session through the
    # catch-all below and stripped its dispatch surface on 2026-08-02.
    auto) enforce_topology=0 ;;
    # Superseded four-mode vocabulary, honored for stale state files.
    native-forced|native-biased|managed-biased) enforce_topology=0 ;;
    managed-forced) ;;
    # Legacy values, honored exactly as before.
    native) return 0 ;;
    warn) enforce_topology=0 ;;
    north) ;;
    *)
      # Fail closed, but never silently: an unreadable mode is a coupling bug
      # between north and this launcher, and it must be visible the first time.
      printf 'codex: unrecognized dispatch mode "%s" in %s; assuming managed-forced\n' \
        "$mode" "$state" >&2
      ;;
  esac
  printf '%s\0' \
    '-c' 'model="gpt-6-astra"' \
    '-c' 'model_reasoning_effort="high"'
  [ "$enforce_topology" -eq 0 ] || printf '%s\0' '--disable' 'multi_agent'
}

codex_option_takes_value() {
  case "$1" in
    -c|--config|--enable|--disable|--remote|--remote-auth-token-env|\
    -i|--image|-m|--model|--local-provider|-p|--profile|-s|--sandbox|\
    -C|--cd|--add-dir|-a|--ask-for-approval)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

codex_option_has_attached_value() {
  case "$1" in
    --config=*|--enable=*|--disable=*|--remote=*|--remote-auth-token-env=*|\
    --image=*|--model=*|--local-provider=*|--profile=*|--sandbox=*|--cd=*|\
    --add-dir=*|--ask-for-approval=*|\
    -c?*|-i?*|-m?*|-p?*|-s?*|-C?*|-a?*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

codex_known_flag() {
  case "$1" in
    --strict-config|--oss|--dangerously-bypass-approvals-and-sandbox|\
    --dangerously-bypass-hook-trust|--search|--no-alt-screen)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

codex_terminal_flag() {
  case "$1" in
    -h|--help|-V|--version)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

# `sandbox_mode="danger-full-access"` is only a config preference. Codex's
# executable bypass is the no-sandbox boundary: without it, an account-pinned
# worker can still resolve to workspace-write and enter bwrap. Detect native
# exec/resume shapes after global options and inject the bypass exactly once.
codex_execution_invocation() {
  local skip_value=0 entry
  for entry in "$@"; do
    [ "$entry" = "--" ] && break
    codex_terminal_flag "$entry" && return 1
  done
  for entry in "$@"; do
    if [ "$skip_value" -eq 1 ]; then
      skip_value=0
      continue
    fi
    case "$entry" in
      --) return 1 ;;
      exec|e|resume) return 0 ;;
      *)
        if codex_option_takes_value "$entry"; then
          skip_value=1
        elif codex_option_has_attached_value "$entry" || codex_known_flag "$entry"; then
          :
        elif [[ "$entry" = -* ]]; then
          :
        else
          return 1
        fi
        ;;
    esac
  done
  return 1
}

direct_execution_args() {
  local entry
  codex_execution_invocation "$@" || return 0
  for entry in "$@"; do
    [ "$entry" = "--dangerously-bypass-approvals-and-sandbox" ] && return 0
  done
  printf '%s\0' '--dangerously-bypass-approvals-and-sandbox'
}

load_direct_execution_args() {
  DIRECT_EXECUTION_ARGS=()
  while IFS= read -r -d '' entry; do
    DIRECT_EXECUTION_ARGS+=("$entry")
  done < <(direct_execution_args "$@")
}

NATIVE_DISPATCH_ARGS=()
while IFS= read -r -d '' arg; do
  NATIVE_DISPATCH_ARGS+=("$arg")
done < <(native_dispatch_args)

# 1. Uniform resume syntax: upstream Codex uses `codex resume ID`; accept the
#    requested `codex --resume ID` / `codex --resume=ID` aliases as well.
#    Resolve exact UUIDs to their existing conversation home.
#    `codex as <id> ...` remains an explicit override.
if [ "${1:-}" != "as" ]; then
  resume_index=-1
  resume_marker=-1
  resume_id=""
  resume_alias=0
  resume_equals=0
  resume_last=0
  resume_terminal=0
  skip_value=0
  argv=("$@")
  for entry in "${argv[@]}"; do
    case "$entry" in
      --) break ;;
      -h|--help|-V|--version)
        resume_terminal=1
        break
        ;;
    esac
  done
  for index in "${!argv[@]}"; do
    if [ "$skip_value" -eq 1 ]; then
      skip_value=0
      continue
    fi
    case "${argv[$index]}" in
      --)
        break
        ;;
      resume)
        skip_resume_value=0
        after_separator=0
        for ((next = index + 1; next < ${#argv[@]}; next++)); do
          if [ "$skip_resume_value" -eq 1 ]; then
            skip_resume_value=0
            continue
          fi
          if [ "$after_separator" -eq 1 ]; then
            resume_index="$next"
            resume_id="${argv[$next]}"
            break
          fi
          case "${argv[$next]}" in
            --)
              after_separator=1
              ;;
            --last)
              # --last supplies the session selection; any positional that
              # follows is a prompt, even when it happens to look like a UUID.
              resume_last=1
              break
              ;;
            --all|--include-non-interactive)
              ;;
            *)
              if codex_option_takes_value "${argv[$next]}"; then
                skip_resume_value=1
              elif codex_terminal_flag "${argv[$next]}"; then
                break
              elif codex_option_has_attached_value "${argv[$next]}" ||
                   codex_known_flag "${argv[$next]}"; then
                :
              elif [[ "${argv[$next]}" = -* ]]; then
                # Unknown future option: leave parsing to Codex rather than
                # risk treating its value as a session id.
                break
              else
                # SESSION_ID/name is the first positional. Never scan into the
                # optional PROMPT for a later UUID.
                resume_index="$next"
                resume_id="${argv[$next]}"
                break
              fi
              ;;
          esac
        done
        break
        ;;
      --resume)
        resume_marker="$index"
        resume_alias=1
        next=$((index + 1))
        if [ "$next" -lt "${#argv[@]}" ]; then
          resume_index="$next"
          resume_id="${argv[$next]}"
        fi
        break
        ;;
      --resume=*)
        resume_marker="$index"
        resume_index="$index"
        resume_id="${argv[$index]#--resume=}"
        resume_alias=1
        resume_equals=1
        break
        ;;
      *)
        if codex_option_takes_value "${argv[$index]}"; then
          skip_value=1
        elif codex_terminal_flag "${argv[$index]}"; then
          break
        elif codex_option_has_attached_value "${argv[$index]}" ||
             codex_known_flag "${argv[$index]}"; then
          :
        else
          # Another subcommand or an interactive prompt owns the remaining
          # argv; a later literal "resume"/"--resume" is not launcher syntax.
          break
        fi
        ;;
    esac
  done

  # A caller-supplied Codex home is an exact authority. Normalize the friendly
  # alias, but never search outside a managed/custom/explicitly pinned home.
  if [ -n "${CODEX_HOME:-}" ]; then
    if [ "$resume_alias" -eq 1 ]; then
      if [ "$resume_equals" -eq 1 ]; then
        argv=("${argv[@]:0:$resume_marker}" resume "$resume_id" "${argv[@]:$((resume_marker + 1))}")
      else
        argv[resume_marker]=resume
      fi
      set -- "${argv[@]}"
    fi
    exec "$REAL" "${FORCE_CONFIG[@]}" "$@"
  fi

  uuid_re='^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$'
  if [ "$resume_terminal" -eq 0 ] && [ "$resume_last" -eq 0 ] &&
     [ "$resume_index" -ge 0 ] &&
     [[ "$resume_id" =~ $uuid_re ]]; then
    resolver="$(dirname "$self")/north-session-resolve"
    if [ ! -x "$resolver" ]; then
      echo "codex: cross-account resume resolver is unavailable: $resolver" >&2
      exit 127
    fi
    printf '[codex] north launcher — resolving cross-account resume…\n' >&2
    resolved="$("$resolver" openai "$resume_id")"
    resolve_status=$?
    [ "$resolve_status" -eq 0 ] || exit "$resolve_status"
    IFS=$'\t' read -r version resolved_provider authority_kind authority_name authority_home canonical_id <<<"$resolved"
    if [ "$version" != "v1" ] || [ "$resolved_provider" != "openai" ] ||
       [ -z "$authority_home" ] || [ -z "$canonical_id" ]; then
      echo "codex: cross-account resume resolver returned an invalid result" >&2
      exit 1
    fi
    if [ "$resume_alias" -eq 1 ] && [ "$resume_equals" -eq 1 ]; then
      argv=("${argv[@]:0:$resume_marker}" resume "$canonical_id" "${argv[@]:$((resume_marker + 1))}")
    elif [ "$resume_alias" -eq 1 ]; then
      argv[resume_marker]=resume
      argv[resume_index]="$canonical_id"
    else
      argv[resume_index]="$canonical_id"
    fi
    set -- "${argv[@]}"
    printf '[codex resume → %s:%s]\n' "$authority_kind" "$authority_name" >&2
    if [ "$authority_kind" = "pooled" ]; then
      pooled="$(dirname "$self")/codex-pooled"
      [ -x "$pooled" ] || { echo "codex: pooled launcher is unavailable: $pooled" >&2; exit 127; }
      export NORTH_CODEX_CONVERSATION_HOME="$authority_home"
      export NORTH_CODEX_CONVERSATION_SQLITE_HOME="$authority_home/sqlite"
      exec "$pooled" "$@"
    fi
    if [ "$authority_kind" = "profile" ] && [ "$authority_name" = "codex-native" ]; then
      native="$(dirname "$self")/codex-native"
      [ -x "$native" ] || { echo "codex: native launcher is unavailable: $native" >&2; exit 127; }
      exec "$native" "$@"
    fi
    export NORTH_CODEX_CONVERSATION_HOME="$authority_home"
    if [ "$authority_kind" = "ambient" ]; then
      export NORTH_CODEX_CONVERSATION_SQLITE_HOME="$authority_home"
    else
      export NORTH_CODEX_CONVERSATION_SQLITE_HOME="$authority_home/sqlite"
    fi
    pooled="$(dirname "$self")/codex-pooled"
    [ -x "$pooled" ] || { echo "codex: pooled launcher is unavailable: $pooled" >&2; exit 127; }
    exec "$pooled" "$@"
  fi

  # Non-UUID aliases still map to the native subcommand (picker/session name)
  # and then follow the existing pinned/automatic account routing.
  if [ "$resume_alias" -eq 1 ]; then
    if [ "$resume_equals" -eq 1 ]; then
      argv=("${argv[@]:0:$resume_marker}" resume "$resume_id" "${argv[@]:$((resume_marker + 1))}")
    else
      argv[resume_marker]=resume
    fi
    set -- "${argv[@]}"
  fi
fi

# 2. Passthrough guard for `codex as ...`, which intentionally skipped the
#    automatic resume parser above.
if [ -n "${CODEX_HOME:-}" ]; then
  exec "$REAL" "${FORCE_CONFIG[@]}" "$@"
fi

list_accounts() {
  [ -d "$ACCOUNTS_ROOT" ] && \
    find "$ACCOUNTS_ROOT" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort
}

# 3. Explicit pin: `codex as <id> [args...]`.
if [ "${1:-}" = "as" ]; then
  shift
  acct="${1:-}"
  usage() {
    echo "usage: codex as <account-id> [codex args...]"
    echo "available account ids:"
    list_accounts | sed 's/^/  /'
  }
  case "$acct" in
    -h|--help) usage; exit 0 ;;
    "")        usage >&2; exit 1 ;;
  esac
  shift
  root="$ACCOUNTS_ROOT/$acct"
  if [ ! -d "$root" ]; then
    {
      echo "codex as: unknown account '$acct'"
      echo "available account ids:"
      list_accounts | sed 's/^/  /'
    } >&2
    exit 1
  fi
  export CODEX_HOME="$root"
  export CODEX_SQLITE_HOME="$root/sqlite"
  load_direct_execution_args "$@"
  exec "$REAL" "${FORCE_CONFIG[@]}" "${DIRECT_EXECUTION_ARGS[@]}" "${DIRECT_WORKSPACE_ARGS[@]}" "${NATIVE_DISPATCH_ARGS[@]}" "$@"
fi

# 4. Automatic sessions use the managed pool. The provider owns execution
# account eligibility and routing; the conversation stays in the pooled home.
pooled="$(dirname "$self")/codex-pooled"
[ -x "$pooled" ] || { echo "codex: pooled launcher is unavailable: $pooled" >&2; exit 127; }
exec "$pooled" "$@"
