#!/usr/bin/env python3
"""Archive parser-proved settled mailbox claims without touching live ones."""

from __future__ import annotations

import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import stat
import sys
import tempfile
from collections import OrderedDict
from dataclasses import dataclass, field
from pathlib import Path
from types import ModuleType


def load_parser() -> ModuleType:
    """Load the public mailbox parser so rotation cannot drift from status."""
    parser_path = Path(__file__).with_name("todo-mailbox-status")
    loader = importlib.machinery.SourceFileLoader("todo_mailbox_status", str(parser_path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError(f"cannot load parser: {parser_path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    sys.dont_write_bytecode = True
    loader.exec_module(module)
    return module


PARSER = load_parser()


@dataclass
class Claim:
    claim: str
    messages: list[tuple[int, str, bytes]] = field(default_factory=list)
    malformed: list[dict[str, object]] = field(default_factory=list)

    def reason(self) -> str | None:
        if self.malformed:
            return "claim has malformed bracketed message"
        verbs = [verb for _, verb, _ in self.messages]
        if not verbs:
            return "claim has no parser-valid messages"
        if verbs.count("DONE") != 1:
            return "claim must have exactly one DONE"
        if verbs[-1] != "DONE":
            return "DONE must be the final message"
        done_index = verbs.index("DONE")
        if "OPEN" not in verbs[:done_index]:
            return "claim has no OPEN before DONE"
        if "ACK" not in verbs[:done_index]:
            return "claim has no ACK before DONE"
        return None


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def decode_line(raw: bytes) -> str:
    return raw.decode("utf-8", errors="surrogateescape").rstrip("\n")


def infer_claim(line: str) -> str | None:
    """Associate malformed protocol-shaped text with a claim when unambiguous."""
    text = line.lstrip()
    if text.startswith("- "):
        text = text[2:]
    if not text.startswith("["):
        return None
    first_end = text.find("]")
    if first_end < 1 or not text[first_end + 1 :].startswith("["):
        return None
    claim_end = text.find("]", first_end + 2)
    if claim_end < first_end + 3:
        return None
    claim = text[first_end + 2 : claim_end]
    return claim if claim.strip() else None


def parse_mailbox(source: bytes) -> tuple[OrderedDict[str, Claim], list[dict[str, object]]]:
    claims: OrderedDict[str, Claim] = OrderedDict()
    malformed: list[dict[str, object]] = []

    for line_number, raw_line in enumerate(source.splitlines(keepends=True), start=1):
        line = decode_line(raw_line)
        if not PARSER.candidate(line):
            continue
        parsed = PARSER.parse_message(line)
        if isinstance(parsed, str):
            issue: dict[str, object] = {"line": line_number, "reason": parsed}
            claim_id = infer_claim(line)
            if claim_id is not None:
                issue["claim"] = claim_id
                claims.setdefault(claim_id, Claim(claim_id)).malformed.append(issue)
            malformed.append(issue)
            continue
        claim_id, verb = parsed
        claims.setdefault(claim_id, Claim(claim_id)).messages.append(
            (line_number, verb, raw_line)
        )
    return claims, malformed


def atomic_write(path: Path, data: bytes, mode: int) -> None:
    """Write one file durably enough for a local rename-based transaction."""
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary_path = Path(temporary)
    try:
        with os.fdopen(descriptor, "wb") as target:
            target.write(data)
            target.flush()
            os.fsync(target.fileno())
        os.chmod(temporary_path, mode)
        os.replace(temporary_path, path)
        directory = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if temporary_path.exists():
            temporary_path.unlink()


def ensure_object(path: Path, content: bytes) -> None:
    if path.exists():
        if path.read_bytes() != content:
            raise ValueError(f"content-address collision at {path}")
        return
    atomic_write(path, content, 0o644)


def rotate(mailbox: Path, archive_root: Path) -> dict[str, object]:
    mailbox_stat = mailbox.stat()
    if not stat.S_ISREG(mailbox_stat.st_mode):
        raise ValueError(f"mailbox is not a regular file: {mailbox}")
    source = mailbox.read_bytes()
    claims, malformed = parse_mailbox(source)

    archived: list[dict[str, object]] = []
    preserved: list[dict[str, object]] = []
    selected: set[str] = set()
    content_by_claim: dict[str, bytes] = {}
    for claim in claims.values():
        reason = claim.reason()
        if reason is not None:
            preserved.append({"claim": claim.claim, "reason": reason})
            continue
        content = b"".join(raw_line for _, _, raw_line in claim.messages)
        digest = sha256(content)
        selected.add(claim.claim)
        content_by_claim[claim.claim] = content
        archived.append(
            {
                "claim": claim.claim,
                "sha256": digest,
                "bytes": len(content),
                "lines": [line for line, _, _ in claim.messages],
                "path": f"claims/{digest}.md",
            }
        )

    active = b"".join(
        raw_line
        for raw_line in source.splitlines(keepends=True)
        if not (
            PARSER.candidate(decode_line(raw_line))
            and isinstance(parsed := PARSER.parse_message(decode_line(raw_line)), tuple)
            and parsed[0] in selected
        )
    )
    archive_root.mkdir(parents=True, exist_ok=True)
    claims_root = archive_root / "claims"
    receipts_root = archive_root / "receipts"
    claims_root.mkdir(exist_ok=True)
    receipts_root.mkdir(exist_ok=True)

    for entry in archived:
        claim_id = entry["claim"]
        assert isinstance(claim_id, str)
        object_path = claims_root / Path(str(entry["path"])).name
        ensure_object(object_path, content_by_claim[claim_id])

    if selected:
        if mailbox.read_bytes() != source:
            raise ValueError("mailbox changed while preparing rotation; active file was not replaced")
        atomic_write(mailbox, active, stat.S_IMODE(mailbox_stat.st_mode))

    receipt: dict[str, object] = {
        "schema": "todo-mailbox-rotate/v1",
        "mailbox": str(mailbox),
        "source_sha256": sha256(source),
        "active_sha256": sha256(active),
        "archived": archived,
        "preserved": preserved,
        "malformed": malformed,
    }
    receipt_bytes = (json.dumps(receipt, indent=2, sort_keys=True) + "\n").encode()
    receipt_digest = sha256(receipt_bytes)
    receipt_path = receipts_root / f"{receipt_digest}.json"
    ensure_object(receipt_path, receipt_bytes)
    receipt["receipt"] = {
        "sha256": receipt_digest,
        "path": str(receipt_path),
    }
    return receipt


def print_human(receipt: dict[str, object]) -> None:
    archived = receipt["archived"]
    preserved = receipt["preserved"]
    malformed = receipt["malformed"]
    assert isinstance(archived, list)
    assert isinstance(preserved, list)
    assert isinstance(malformed, list)
    print(
        f"todo-mailbox-rotate: archived={len(archived)} "
        f"preserved={len(preserved)} malformed={len(malformed)}"
    )
    for entry in archived:
        assert isinstance(entry, dict)
        print(f"ARCHIVED {entry['claim']} sha256={entry['sha256']} path={entry['path']}")
    for entry in preserved:
        assert isinstance(entry, dict)
        print(f"PRESERVED {entry['claim']} reason={entry['reason']}")
    receipt_info = receipt["receipt"]
    assert isinstance(receipt_info, dict)
    print(f"RECEIPT sha256={receipt_info['sha256']} path={receipt_info['path']}")


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        description="Archive parser-proved settled claims from a mailbox."
    )
    parser.add_argument("--json", action="store_true", help="emit the receipt as JSON")
    parser.add_argument("mailbox", help="mailbox to rotate; no live-path default")
    parser.add_argument("archive_dir", help="content-addressed archive root")
    args = parser.parse_args(argv)

    try:
        receipt = rotate(Path(args.mailbox).expanduser(), Path(args.archive_dir).expanduser())
    except (OSError, ValueError) as error:
        print(f"todo-mailbox-rotate: {error}", file=sys.stderr)
        return 2

    if args.json:
        print(json.dumps(receipt, indent=2, sort_keys=True))
    else:
        print_human(receipt)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
