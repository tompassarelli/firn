#!/usr/bin/env bash
set -euo pipefail

firn_repo="${FIRN_REPO:-$HOME/code/nixos-config/main}" # hardcoded-repo-path:allow
beagle_path="${BEAGLE_PATH:-$HOME/code/beagle/main}" # hardcoded-repo-path:allow
beagle="$beagle_path/bin/beagle"
galileo_path="${FIRN_GALILEO_REPO:-$HOME/code/galileo/main}" # hardcoded-repo-path:allow
runtime_root="${FIRN_RUNTIME_ROOT:-$HOME/.local/lib/firn/cli}"
versions="$runtime_root/versions"
next=""
scope="${1:-full}"

if [[ "$#" -gt 1 ]]; then
  printf 'usage: firn-runtime-update [repo|full|galileo]\n' >&2
  exit 64
fi
case "$scope" in
  repo|full|galileo) ;;
  *)
    printf 'firn-runtime-update: unknown runtime scope: %s\n' "$scope" >&2
    exit 64
    ;;
esac

if [[ "$scope" != galileo && ! -x "$beagle" ]]; then
  printf 'firn-runtime-update: BEAGLE_PATH has no executable bin/beagle: %s\n' \
    "$beagle_path" >&2
  exit 1
fi
for prerequisite in cmp find git ldd nix nix-store readlink sha256sum tar; do
  if ! command -v "$prerequisite" >/dev/null 2>&1; then
    printf 'firn-runtime-update: required producer command is unavailable: %s\n' \
      "$prerequisite" >&2
    exit 127
  fi
done
galileo_revision="$(cat "$firn_repo/config/galileo-revision")"
if [[ ! "$galileo_revision" =~ ^[0-9a-f]{40}$ ]] ||
   [[ "$(git -C "$galileo_path" rev-parse --verify "$galileo_revision^{commit}")" != "$galileo_revision" ]]; then
  printf 'firn-runtime-update: declared Galileo revision is unavailable: %s\n' \
    "$galileo_revision" >&2
  exit 1
fi
bun_candidate="${FIRN_BUN:-}"
if [[ -z "$bun_candidate" && -x "$runtime_root/current/bin/bun" ]]; then
  bun_candidate="$runtime_root/current/bin/bun"
fi
if [[ -z "$bun_candidate" ]]; then
  bun_candidate="$(command -v bun || true)"
fi
if [[ -z "$bun_candidate" || ! -x "$bun_candidate" ]]; then
  printf 'firn-runtime-update: Bun runtime is unavailable\n' >&2
  exit 127
fi
bun_source="$(readlink -f "$bun_candidate")"
bun_store_path=""
case "$bun_source" in
  /nix/store/*)
    bun_store_relative="${bun_source#/nix/store/}"
    bun_store_path="/nix/store/${bun_store_relative%%/*}"
    if ! command -v nix-store >/dev/null 2>&1; then
      printf 'firn-runtime-update: nix-store is required to retain Bun: %s\n' \
        "$bun_store_path" >&2
      exit 127
    fi
    ;;
esac

datum_reader="$beagle_path/native-core/src/beagle/datum_reader.bjs"
native_json="$beagle_path/native-core/src/native/json.bjs"
dispatcher_bridge="$firn_repo/native/firn_host.mjs"
dispatcher_io="$firn_repo/native/firn_io.mjs"
host_list_source="$firn_repo/native/firn-host-list.ts"
host_list_os="$firn_repo/native/firn-host-list-os.mjs"
beagle_core="$beagle_path/beagle-lib/lib/beagle/core.js"
beagle_host="$beagle_path/beagle-lib/lib/beagle/host.js"

dispatcher_sources=(
  "$dispatcher_bridge"
  "$dispatcher_io"
  "$host_list_source"
  "$host_list_os"
  "$beagle_core"
  "$beagle_host"
)
tag_sources=(
  "$firn_repo/native/datum_reader.ts"
  "$firn_repo/native/native_json.ts"
  "$firn_repo/native/tag_resolve.ts"
  "$firn_repo/native/tag_inputs.ts"
  "$firn_repo/native/tag_resolve_driver.ts"
  "$firn_repo/native/tag_resolve_family.ts"
  "$firn_repo/native/tag_commands.ts"
  "$firn_repo/native/tag_commands_driver.ts"
  "$firn_repo/native/tag_commands_family.ts"
  "$firn_repo/native/firn_tag_family.ts"
)
tag_bridge="$firn_repo/native/firn_tag_host.mjs"
module_facts_bridge="$firn_repo/native/module_facts_host.mjs"
flake_input_sources=(
  "$firn_repo/native/flake_input.ts"
  "$firn_repo/native/flake_input_driver.ts"
  "$firn_repo/native/flake_input_family.ts"
)
flake_input_bridge="$firn_repo/native/flake_input_host.mjs"
inventory_sources=(
  "$firn_repo/native/datum_reader.ts"
  "$firn_repo/native/native_json.ts"
  "$firn_repo/native/tag_resolve.ts"
  "$firn_repo/native/tag_inputs.ts"
  "$firn_repo/native/tag_resolve_driver.ts"
  "$firn_repo/native/tag_resolve_family.ts"
  "$firn_repo/native/inventory.ts"
  "$firn_repo/native/inventory_family.ts"
)
inventory_bridge="$firn_repo/native/inventory_host.mjs"
authoring_sources=(
  "$native_json"
  "$firn_repo/native/authoring.bjs"
  "$firn_repo/native/authoring_native.bjs"
)
authoring_bridge="$firn_repo/native/authoring_host.mjs"
views_sources=(
  "$datum_reader"
  "$native_json"
  "$firn_repo/native/firn_views.bjs"
  "$firn_repo/native/firn_views_native.bjs"
)
views_bridge="$firn_repo/native/firn_views_host.mjs"
repo_build_sources=(
  "$firn_repo/native/datum_reader.ts"
  "$firn_repo/native/native_json.ts"
  "$firn_repo/native/tag_resolve.ts"
  "$firn_repo/native/tag_inputs.ts"
  "$firn_repo/native/tag_resolve_driver.ts"
  "$firn_repo/native/tag_resolve_family.ts"
  "$firn_repo/native/flake_input.ts"
  "$firn_repo/native/flake_input_driver.ts"
  "$firn_repo/native/flake_input_family.ts"
  "$firn_repo/native/repo_build.ts"
  "$firn_repo/native/repo_build_family.ts"
)
repo_build_bridge="$firn_repo/native/repo_build_host.mjs"
repo_workflow_sources=(
  "$native_json"
  "$firn_repo/native/repo_quality.bjs"
  "$firn_repo/native/repo_workflows.bjs"
  "$firn_repo/native/repo_workflows_runtime.bjs"
)
repo_workflow_bridge="$firn_repo/native/repo_workflows_host.mjs"
rebuild_sources=(
  "$firn_repo/native/native_json.ts"
  "$firn_repo/native/impact.ts"
  "$firn_repo/native/rebuild.ts"
  "$firn_repo/native/rebuild_native.ts"
  "$firn_repo/native/firn_rebuild_family.ts"
)
rebuild_bridge="$firn_repo/native/firn_rebuild_host.mjs"
prewarm_source="$firn_repo/native/prewarm.ts"
prewarm_bridge="$firn_repo/native/prewarm_host.mjs"
system_policy_sources=(
  "$native_json"
  "$firn_repo/native/system_policy.bjs"
  "$firn_repo/native/system_policy_native.bjs"
)
system_policy_bridge="$firn_repo/native/system_policy_host.mjs"

case "$scope" in
  galileo) selected_sources=() ;;
  repo)
    selected_sources=(
      "${dispatcher_sources[@]}"
      "${repo_build_sources[@]}"
      "$repo_build_bridge"
    )
    ;;
  full)
    selected_sources=(
      "${dispatcher_sources[@]}"
      "${tag_sources[@]}"
      "$tag_bridge"
      "${flake_input_sources[@]}"
      "$flake_input_bridge"
      "${inventory_sources[@]}"
      "$inventory_bridge"
      "${authoring_sources[@]}"
      "$authoring_bridge"
      "${views_sources[@]}"
      "$views_bridge"
      "${repo_build_sources[@]}"
      "$repo_build_bridge"
      "${repo_workflow_sources[@]}"
      "$repo_workflow_bridge"
      "${rebuild_sources[@]}"
      "$rebuild_bridge"
      "$prewarm_source"
      "$prewarm_bridge"
      "${system_policy_sources[@]}"
      "$system_policy_bridge"
    )
    ;;
esac
for source in "${selected_sources[@]}"; do
  if [[ ! -f "$source" ]]; then
    printf 'firn-runtime-update: required source is unavailable: %s\n' \
      "$source" >&2
    exit 1
  fi
done

firn_revision="$(git -C "$firn_repo" rev-parse HEAD)" || {
  printf 'firn-runtime-update: FIRN_REPO has no readable Git identity: %s\n' \
    "$firn_repo" >&2
  exit 1
}
beagle_revision=""
if [[ "$scope" != galileo ]]; then
  beagle_revision="$(git -C "$beagle_path" rev-parse HEAD)" || {
    printf 'firn-runtime-update: BEAGLE_PATH has no readable Git identity: %s\n' \
      "$beagle_path" >&2
    exit 1
  }
fi

mkdir -p "$versions"
stage="$(mktemp -d "$runtime_root/.stage.XXXXXX")"
cleanup() {
  if [[ -n "${stage:-}" ]]; then
    rm -rf -- "${stage:?}"
  fi
  if [[ -n "$next" ]]; then
    rm -f -- "$next"
  fi
}
trap cleanup EXIT INT TERM HUP
mkdir -p "$stage/bin" "$stage/lib" "$stage/artifacts" \
  "$stage/node_modules/beagle"

manifest="$stage/manifest"
{
  printf 'format=firn-cli-runtime/v5\n'
  printf 'scope=%s\n' "$scope"
  printf 'firn_revision=%s\n' "$firn_revision"
  printf 'beagle_revision=%s\n' "$beagle_revision"
  printf 'galileo_revision=%s\n' "$galileo_revision"
  printf 'bun_store_path=%s\n' "${bun_store_path:-copied}"
} >"$manifest"

declare -A artifact_ids=()
artifact_paths=()
binaries=()
record_artifact() {
  local component="$1"
  local relative="$2"
  local source="$3"
  local artifact="$stage/$relative"
  local source_id
  local artifact_id

  read -r source_id _ < <(sha256sum "$source")
  read -r artifact_id _ < <(sha256sum "$artifact")
  artifact_ids["$relative"]="$artifact_id"
  artifact_paths+=("$relative")
  printf 'artifact=%s path=%s source_sha256=%s artifact_sha256=%s\n' \
    "$component" "$relative" "$source_id" "$artifact_id" >>"$manifest"
}

record_generated_artifact() {
  local component="$1"
  local relative="$2"
  local artifact_id

  read -r artifact_id _ < <(sha256sum "$stage/$relative")
  artifact_ids["$relative"]="$artifact_id"
  artifact_paths+=("$relative")
  printf 'artifact=%s path=%s artifact_sha256=%s\n' \
    "$component" "$relative" "$artifact_id" >>"$manifest"
}

materialize_galileo() {
  local dependencies
  local dependency
  local store_relative
  local store_path
  local policy

  mkdir -p "$galileo_build"
  git -C "$galileo_path" archive "$galileo_revision" | tar -x -C "$galileo_build"
  nix develop "path:$galileo_build" --command cargo build --locked --release \
    --manifest-path "$galileo_build/Cargo.toml" --target-dir "$galileo_build/target" \
    -p galileo-cli
  cp -- "$galileo_build/target/release/galileo" "$stage/bin/galileo"
  printf '%s\n' "$galileo_revision" >"$stage/galileo-revision"
  record_generated_artifact galileo bin/galileo
  record_artifact galileo-revision galileo-revision "$firn_repo/config/galileo-revision"
  binaries+=(galileo)
  mkdir -p "$stage/lib/firn"
  for policy in dispatch host-list; do
    cp -- "$galileo_build/lib/firn/$policy.gal" "$stage/lib/firn/$policy.gal"
    record_artifact "$policy-policy" "lib/firn/$policy.gal" \
      "$galileo_build/lib/firn/$policy.gal"
  done

  dependencies="$(ldd "$stage/bin/galileo")"
  if [[ "$dependencies" == *'not found'* ]]; then
    printf 'firn-runtime-update: Galileo runtime dependencies are unavailable\n%s\n' \
      "$dependencies" >&2
    exit 1
  fi
  while IFS= read -r dependency; do
    store_relative="${dependency#/nix/store/}"
    store_path="/nix/store/${store_relative%%/*}"
    galileo_store_paths["$store_path"]=1
  done < <(printf '%s\n' "$dependencies" | \
    awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^\/nix\/store\//) print $i }')
  for store_path in "${!galileo_store_paths[@]}"; do
    printf 'galileo_runtime_dependency=%s\n' "$store_path"
  done | sort >>"$manifest"
}

materialize_dispatcher() {
  cp -- "$dispatcher_bridge" "$stage/bin/firn-host.mjs"
  cp -- "$dispatcher_io" "$stage/bin/firn-io.mjs"
  cp -- "$host_list_source" "$stage/bin/firn-host-list.ts"
  cp -- "$host_list_os" "$stage/bin/firn-host-list-os.mjs"
  cp -- "$beagle_core" "$stage/node_modules/beagle/core.js"
  cp -- "$beagle_host" "$stage/node_modules/beagle/host.js"
  printf '%s\n' '{"type":"module"}' \
    >"$stage/node_modules/beagle/package.json"

  record_artifact bridge bin/firn-host.mjs "$dispatcher_bridge"
  record_artifact dispatcher-io bin/firn-io.mjs "$dispatcher_io"
  record_artifact host-list-source bin/firn-host-list.ts "$host_list_source"
  record_artifact host-list-os bin/firn-host-list-os.mjs "$host_list_os"
  record_artifact beagle-core node_modules/beagle/core.js "$beagle_core"
  record_artifact beagle-host node_modules/beagle/host.js "$beagle_host"
  record_generated_artifact beagle-package node_modules/beagle/package.json
}

materialize_js() {
  local component="$1"
  local binary="$2"
  local module_relative="$3"
  local module_environment="$4"
  local bridge="$5"
  shift 5
  local output_root="$stage/lib/$component"
  local module="$output_root/$module_relative"
  local host="$output_root/host.mjs"
  local launcher="$stage/bin/$binary"
  local relative source

  mkdir -p "$output_root"
  case "$component" in
    tag|inventory|repo-build|flake-input|rebuild)
      for source in "$@"; do
        cp -- "$source" "$output_root/${source##*/}"
        record_artifact "$component-source" \
          "lib/$component/${source##*/}" "$source"
      done
      ;;
    prewarm)
      cp -- "$1" "$module"
      record_artifact "$component-source" "lib/$component/$module_relative" "$1"
      mkdir -p "$stage/lib/firn"
      cp -- "$2" "$stage/lib/firn/prewarm.gal"
      record_artifact "$component-policy" lib/firn/prewarm.gal "$2"
      ;;
    *)
      if ! "$beagle_path/bin/beagle-build-all" "$@" --out "$output_root"; then
        printf 'firn-runtime-update: Beagle/JS materialization failed: %s\n' \
          "$component" >&2
        exit 1
      fi
      ;;
  esac
  if [[ ! -f "$module" ]]; then
    printf 'firn-runtime-update: materializer produced no JS module: %s\n' \
      "$component" >&2
    exit 1
  fi
  cp -- "$bridge" "$host"
  case "$component" in
    tag|inventory|repo-build|flake-input)
      cp -- "$module_facts_bridge" "$output_root/module_facts_host.mjs"
      record_artifact "$component-module-facts-host" \
        "lib/$component/module_facts_host.mjs" "$module_facts_bridge"
      ;;
  esac
  cat >"$launcher" <<EOF
#!/usr/bin/env bash
set -euo pipefail
here="\$(cd "\$(dirname "\${BASH_SOURCE[0]}")" && pwd)"
EOF
  cat >>"$launcher" <<EOF
exec env $module_environment="\$here/../lib/$component/$module_relative" \
  "\$here/bun" "\$here/../lib/$component/host.mjs" "\$@"
EOF
  chmod +x "$launcher"
  record_generated_artifact "$component-launcher" "bin/$binary"
  record_artifact "$component-host" "lib/$component/host.mjs" "$bridge"
  while IFS= read -r relative; do
    record_generated_artifact "$component-js" "${relative#"$stage/"}"
  done < <(find "$output_root" -type f -name '*.js' -print | sort)
  binaries+=("$binary")
  printf 'component=%s module=lib/%s/%s executable=bin/%s runtime=bun\n' \
    "$component" "$component" "$module_relative" "$binary" >>"$manifest"
}

if [[ -n "$bun_store_path" ]]; then
  ln -s "$bun_source" "$stage/bin/bun"
else
  cp -- "$bun_source" "$stage/bin/bun"
  chmod +x "$stage/bin/bun"
fi
record_artifact bun bin/bun "$bun_source"
declare -A galileo_store_paths=()
galileo_build="$stage/.galileo-build"
materialize_galileo
if [[ "$scope" != galileo ]]; then materialize_dispatcher; fi
case "$scope" in
  repo)
    materialize_js repo-build firn-repo-build repo_build_family.ts \
      FIRN_REPO_BUILD_MODULE "$repo_build_bridge" "${repo_build_sources[@]}"
    ;;
  full)
    materialize_js tag firn-tag firn_tag_family.ts \
      FIRN_TAG_MODULE "$tag_bridge" "${tag_sources[@]}"
    materialize_js flake-input firn-flake-input flake_input_family.ts \
      FIRN_FLAKE_INPUT_MODULE "$flake_input_bridge" "${flake_input_sources[@]}"
    materialize_js inventory firn-inventory inventory_family.ts \
      FIRN_INVENTORY_MODULE "$inventory_bridge" "${inventory_sources[@]}"
    materialize_js authoring firn-authoring firn/authoring-native.js \
      FIRN_AUTHORING_MODULE "$authoring_bridge" "${authoring_sources[@]}"
    materialize_js views firn-views firn/views-native.js \
      FIRN_VIEWS_MODULE "$views_bridge" "${views_sources[@]}"
    materialize_js repo-build firn-repo-build repo_build_family.ts \
      FIRN_REPO_BUILD_MODULE "$repo_build_bridge" "${repo_build_sources[@]}"
    materialize_js repo-workflow firn-repo-workflow firn/repo-workflows-runtime.js \
      FIRN_REPO_WORKFLOW_MODULE "$repo_workflow_bridge" "${repo_workflow_sources[@]}"
    materialize_js rebuild firn-rebuild firn_rebuild_family.ts \
      FIRN_REBUILD_MODULE "$rebuild_bridge" "${rebuild_sources[@]}"
    materialize_js prewarm firn-prewarm prewarm.ts \
      FIRN_PREWARM_MODULE "$prewarm_bridge" "$prewarm_source" \
      "$galileo_build/lib/firn/prewarm.gal"
    materialize_js system-policy firn-system-policy firn/system-policy-native.js \
      FIRN_SYSTEM_POLICY_MODULE "$system_policy_bridge" \
      "${system_policy_sources[@]}"
    ;;
esac

rm -rf -- "${galileo_build:?}"
read -r bundle_id _ < <(sha256sum "$manifest")
destination="$versions/$bundle_id"
if [[ -e "$destination" ]]; then
  if [[ ! -f "$destination/manifest" ]] ||
     ! cmp -s "$manifest" "$destination/manifest"; then
    printf 'firn-runtime-update: existing runtime manifest mismatch: %s\n' \
      "$destination" >&2
    exit 1
  fi
  for binary in "${binaries[@]}"; do
    output="$destination/bin/$binary"
    if [[ ! -x "$output" ]]; then
      printf 'firn-runtime-update: existing runtime is incomplete: %s\n' \
        "$destination" >&2
      exit 1
    fi
    read -r existing_id _ < <(sha256sum "$output")
    if [[ "$existing_id" != "${artifact_ids[bin/$binary]}" ]]; then
      printf 'firn-runtime-update: existing runtime identity mismatch: %s\n' \
        "$output" >&2
      exit 1
    fi
  done
  for relative in "${artifact_paths[@]}"; do
    output="$destination/$relative"
    if [[ ! -f "$output" ]]; then
      printf 'firn-runtime-update: existing runtime is incomplete: %s\n' \
        "$destination" >&2
      exit 1
    fi
    read -r existing_id _ < <(sha256sum "$output")
    if [[ "$existing_id" != "${artifact_ids[$relative]}" ]]; then
      printf 'firn-runtime-update: existing runtime identity mismatch: %s\n' \
        "$output" >&2
      exit 1
    fi
  done
else
  mv -- "$stage" "$destination"
  stage=""
fi

if [[ -n "$bun_store_path" ]]; then
  bun_gc_root="$destination/.bun-gc-root"
  if [[ -L "$bun_gc_root" ]]; then
    if [[ "$(readlink "$bun_gc_root")" != "$bun_store_path" ]]; then
      printf 'firn-runtime-update: Bun GC root identity mismatch: %s\n' \
        "$bun_gc_root" >&2
      exit 1
    fi
  elif [[ -e "$bun_gc_root" ]]; then
    printf 'firn-runtime-update: Bun GC root is not a symlink: %s\n' \
      "$bun_gc_root" >&2
    exit 1
  elif ! nix-store --add-root "$bun_gc_root" -r "$bun_store_path" \
      >/dev/null; then
    printf 'firn-runtime-update: cannot retain Bun store path: %s\n' \
      "$bun_store_path" >&2
    exit 1
  fi
fi

mkdir -p "$destination/.galileo-gcroots"
for store_path in "${!galileo_store_paths[@]}"; do
  nix-store --add-root "$destination/.galileo-gcroots/${store_path##*/}" \
    --indirect --realise "$store_path" >/dev/null
done

if [[ "$scope" == galileo ]]; then
  printf 'firn Galileo materialized: %s\n' "$destination/bin/galileo"
  exit 0
fi

next="$runtime_root/.current.$$"
ln -s "versions/$bundle_id" "$next"
mv -Tf -- "$next" "$runtime_root/current"
next=""

printf 'firn runtime active: %s\n' "$destination"
printf 'manifest: %s\n' "$destination/manifest"
