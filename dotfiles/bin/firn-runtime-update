#!/usr/bin/env bash
set -euo pipefail

firn_repo="${FIRN_REPO:-$HOME/code/nixos-config/main}" # hardcoded-repo-path:allow
beagle_path="${BEAGLE_PATH:-$HOME/code/beagle/main}" # hardcoded-repo-path:allow
beagle="$beagle_path/bin/beagle"
runtime_root="${FIRN_RUNTIME_ROOT:-$HOME/.local/lib/firn/cli}"
versions="$runtime_root/versions"
next=""
scope="${1:-full}"

if [[ "$#" -gt 1 ]]; then
  printf 'usage: firn-runtime-update [repo|full]\n' >&2
  exit 64
fi
case "$scope" in
  repo|full) ;;
  *)
    printf 'firn-runtime-update: unknown runtime scope: %s\n' "$scope" >&2
    exit 64
    ;;
esac

if [[ ! -x "$beagle" ]]; then
  printf 'firn-runtime-update: BEAGLE_PATH has no executable bin/beagle: %s\n' \
    "$beagle_path" >&2
  exit 1
fi
for prerequisite in cmp git sha256sum; do
  if ! command -v "$prerequisite" >/dev/null 2>&1; then
    printf 'firn-runtime-update: required producer command is unavailable: %s\n' \
      "$prerequisite" >&2
    exit 127
  fi
done

datum_reader="$beagle_path/native-core/src/beagle/datum_reader.bgl"
native_json="$beagle_path/native-core/src/native/json.bgl"
nix_schema_path="$beagle_path/native-core/src/beagle/nix_schema_path.bgl"
native_json_js="$beagle_path/native-core/src/native/json.bjs"
nix_schema_path_js="$beagle_path/native-core/src/beagle/nix_schema_path.bjs"
dispatcher_source="$firn_repo/native/firn.bjs"
dispatcher_bridge="$firn_repo/native/firn_host.mjs"
beagle_core="$beagle_path/beagle-lib/lib/beagle/core.js"
beagle_host="$beagle_path/beagle-lib/lib/beagle/host.js"

dispatcher_sources=(
  "$dispatcher_source"
  "$dispatcher_bridge"
  "$beagle_core"
  "$beagle_host"
)
tag_sources=(
  "$datum_reader"
  "$native_json"
  "$firn_repo/native/tag_resolve.bgl"
  "$firn_repo/native/tag_inputs.bgl"
  "$firn_repo/native/tag_resolve_driver.bgl"
  "$firn_repo/native/tag_resolve_native.bgl"
  "$firn_repo/native/tag_commands.bgl"
  "$firn_repo/native/tag_commands_driver.bgl"
  "$firn_repo/native/tag_commands_native.bgl"
  "$firn_repo/native/firn_tag_family.bgl"
)
flake_input_sources=(
  "$datum_reader"
  "$firn_repo/native/flake_input.bgl"
  "$firn_repo/native/flake_input_driver.bgl"
  "$firn_repo/native/flake_input_native.bgl"
)
inventory_sources=(
  "$datum_reader"
  "$native_json"
  "$firn_repo/native/tag_resolve.bgl"
  "$firn_repo/native/tag_inputs.bgl"
  "$firn_repo/native/tag_resolve_driver.bgl"
  "$firn_repo/native/tag_resolve_native.bgl"
  "$firn_repo/native/inventory.bgl"
  "$firn_repo/native/inventory_native.bgl"
)
authoring_sources=(
  "$native_json"
  "$firn_repo/native/authoring.bgl"
  "$firn_repo/native/authoring_native.bgl"
)
views_sources=(
  "$native_json_js"
  "$nix_schema_path_js"
  "$firn_repo/native/firn_views.bjs"
  "$firn_repo/native/firn_views_native.bjs"
)
views_bridge="$firn_repo/native/firn_views_host.mjs"
repo_build_sources=(
  "$datum_reader"
  "$native_json"
  "$firn_repo/native/tag_resolve.bgl"
  "$firn_repo/native/tag_inputs.bgl"
  "$firn_repo/native/tag_resolve_driver.bgl"
  "$firn_repo/native/tag_resolve_native.bgl"
  "$firn_repo/native/flake_input.bgl"
  "$firn_repo/native/flake_input_driver.bgl"
  "$firn_repo/native/flake_input_native.bgl"
  "$firn_repo/native/repo_build.bgl"
  "$firn_repo/native/repo_build_native.bgl"
)
schema_sources=(
  "$native_json"
  "$firn_repo/native/schema_transaction.bgl"
  "$firn_repo/native/schema_transaction_native.bgl"
)
repo_workflow_sources=(
  "$native_json"
  "$firn_repo/native/repo_quality.bgl"
  "$firn_repo/native/repo_workflows.bgl"
  "$firn_repo/native/repo_workflows_native.bgl"
)
rebuild_sources=(
  "$native_json"
  "$firn_repo/native/impact.bgl"
  "$firn_repo/native/rebuild.bgl"
  "$firn_repo/native/rebuild_native.bgl"
  "$firn_repo/native/firn_rebuild_family.bgl"
)
prewarm_sources=(
  "$firn_repo/native/prewarm.bgl"
  "$firn_repo/native/prewarm_native.bgl"
)

case "$scope" in
  repo)
    selected_sources=(
      "${dispatcher_sources[@]}"
      "${repo_build_sources[@]}"
      "${schema_sources[@]}"
    )
    ;;
  full)
    selected_sources=(
      "${dispatcher_sources[@]}"
      "${tag_sources[@]}"
      "${flake_input_sources[@]}"
      "${inventory_sources[@]}"
      "${authoring_sources[@]}"
      "${views_sources[@]}"
      "$views_bridge"
      "${repo_build_sources[@]}"
      "${schema_sources[@]}"
      "${repo_workflow_sources[@]}"
      "${rebuild_sources[@]}"
      "${prewarm_sources[@]}"
    )
    ;;
esac
for source in "${selected_sources[@]}"; do
  if [[ ! -f "$source" ]]; then
    printf 'firn-runtime-update: required source is unavailable: %s\n' \
      "$source" >&2
    exit 1
  fi
done

firn_revision="$(git -C "$firn_repo" rev-parse HEAD)" || {
  printf 'firn-runtime-update: FIRN_REPO has no readable Git identity: %s\n' \
    "$firn_repo" >&2
  exit 1
}
beagle_revision="$(git -C "$beagle_path" rev-parse HEAD)" || {
  printf 'firn-runtime-update: BEAGLE_PATH has no readable Git identity: %s\n' \
    "$beagle_path" >&2
  exit 1
}

mkdir -p "$versions"
stage="$(mktemp -d "$runtime_root/.stage.XXXXXX")"
cleanup() {
  if [[ -n "${stage:-}" ]]; then
    rm -rf -- "${stage:?}"
  fi
  if [[ -n "$next" ]]; then
    rm -f -- "$next"
  fi
}
trap cleanup EXIT INT TERM HUP
mkdir -p "$stage/bin" "$stage/lib" "$stage/artifacts" \
  "$stage/node_modules/beagle"

manifest="$stage/manifest"
{
  printf 'format=firn-cli-runtime/v2\n'
  printf 'scope=%s\n' "$scope"
  printf 'firn_revision=%s\n' "$firn_revision"
  printf 'beagle_revision=%s\n' "$beagle_revision"
} >"$manifest"

declare -A artifact_ids=()
artifact_paths=()
binaries=()
record_artifact() {
  local component="$1"
  local relative="$2"
  local source="$3"
  local artifact="$stage/$relative"
  local source_id
  local artifact_id

  read -r source_id _ < <(sha256sum "$source")
  read -r artifact_id _ < <(sha256sum "$artifact")
  artifact_ids["$relative"]="$artifact_id"
  artifact_paths+=("$relative")
  printf 'artifact=%s path=%s source_sha256=%s artifact_sha256=%s\n' \
    "$component" "$relative" "$source_id" "$artifact_id" >>"$manifest"
}

record_generated_artifact() {
  local component="$1"
  local relative="$2"
  local artifact_id

  read -r artifact_id _ < <(sha256sum "$stage/$relative")
  artifact_ids["$relative"]="$artifact_id"
  artifact_paths+=("$relative")
  printf 'artifact=%s path=%s artifact_sha256=%s\n' \
    "$component" "$relative" "$artifact_id" >>"$manifest"
}

materialize_dispatcher() {
  local output="$stage/lib/firn-dispatcher.js"

  if ! "$beagle" build "$dispatcher_source" "$output"; then
    printf 'firn-runtime-update: JS dispatcher materialization failed\n' >&2
    exit 1
  fi
  if [[ ! -f "$output" ]]; then
    printf 'firn-runtime-update: materializer produced no JS dispatcher\n' >&2
    exit 1
  fi

  cp -- "$dispatcher_bridge" "$stage/bin/firn-host.mjs"
  cp -- "$beagle_core" "$stage/node_modules/beagle/core.js"
  cp -- "$beagle_host" "$stage/node_modules/beagle/host.js"
  printf '%s\n' '{"type":"module"}' \
    >"$stage/node_modules/beagle/package.json"

  record_artifact dispatcher lib/firn-dispatcher.js "$dispatcher_source"
  if [[ -f "$output.map" ]]; then
    record_artifact dispatcher-map lib/firn-dispatcher.js.map \
      "$dispatcher_source"
  fi
  record_artifact bridge bin/firn-host.mjs "$dispatcher_bridge"
  record_artifact beagle-core node_modules/beagle/core.js "$beagle_core"
  record_artifact beagle-host node_modules/beagle/host.js "$beagle_host"
  record_generated_artifact beagle-package node_modules/beagle/package.json
}

materialize() {
  local component="$1"
  local binary="$2"
  local entry="$3"
  shift 3
  local artifacts="$stage/artifacts/$component"
  local output="$stage/bin/$binary"
  local source_id
  local artifact_id
  local source

  mkdir -p "$artifacts"
  if ! "$beagle" native-exe \
    --out "$output" \
    --artifacts "$artifacts" \
    --entry "$entry" \
    "$@"; then
    printf 'firn-runtime-update: native materialization failed: %s\n' \
      "$component" >&2
    exit 1
  fi

  if [[ ! -x "$output" ]]; then
    printf 'firn-runtime-update: materializer produced no executable: %s\n' \
      "$component" >&2
    exit 1
  fi
  if [[ ! -f "$artifacts/report.txt" ]] ||
     [[ ! -f "$artifacts/native-exe.report.txt" ]] ||
     ! grep -Fxq "source-entry $entry" "$artifacts/report.txt" ||
     ! grep -Fq "native-exe-entry PASS name=$entry " \
       "$artifacts/native-exe.report.txt"; then
    printf 'firn-runtime-update: materializer producer identity is invalid: %s\n' \
      "$component" >&2
    exit 1
  fi

  source_id="$(sed -n \
    's/^native-provenance-v0 source sha256:\([0-9a-f]\{64\}\)$/\1/p' \
    "$artifacts/report.txt")"
  if [[ ${#source_id} -ne 64 ]]; then
    printf 'firn-runtime-update: materializer source identity is invalid: %s\n' \
      "$component" >&2
    exit 1
  fi
  read -r artifact_id _ < <(sha256sum "$output")
  artifact_ids["bin/$binary"]="$artifact_id"
  artifact_paths+=("bin/$binary")
  binaries+=("$binary")
  printf 'component=%s entry=%s executable=bin/%s source_sha256=%s artifact_sha256=%s\n' \
    "$component" "$entry" "$binary" "$source_id" "$artifact_id" \
    >>"$manifest"
}

materialize_views() {
  local output="$stage/lib/firn/views-native.js"
  local bridge_output="$stage/bin/firn-views"
  local relative

  if ! "$beagle" build "${views_sources[@]}" --out "$stage/lib"; then
    printf 'firn-runtime-update: JS materialization failed: views\n' >&2
    exit 1
  fi
  if [[ ! -f "$output" ]]; then
    printf 'firn-runtime-update: materializer produced no JS views module\n' >&2
    exit 1
  fi
  cp -- "$views_bridge" "$bridge_output"
  chmod +x "$bridge_output"
  record_artifact views-host bin/firn-views "$views_bridge"
  binaries+=("firn-views")
  while IFS= read -r relative; do
    record_generated_artifact views-js "${relative#"$stage/"}"
  done < <(find "$stage/lib" -type f -name '*.js' ! -path '*/firn-dispatcher.js' \
    -print | sort)
  printf 'component=views entry=firn.views-native/run executable=bin/firn-views runtime=bun\n' \
    >>"$manifest"
}

materialize_dispatcher
case "$scope" in
  repo)
    materialize repo-build firn-repo-build firn.repo-build-native/-main \
      "${repo_build_sources[@]}"
    materialize schema firn-schema firn.schema-transaction-native/-main \
      "${schema_sources[@]}"
    ;;
  full)
    materialize tag firn-tag firn.tag-family/-main "${tag_sources[@]}"
    materialize flake-input firn-flake-input firn.flake-input-native/-main \
      "${flake_input_sources[@]}"
    materialize inventory firn-inventory firn.inventory-native/-main \
      "${inventory_sources[@]}"
    materialize authoring firn-authoring firn.authoring-native/-main \
      "${authoring_sources[@]}"
    materialize_views
    materialize repo-build firn-repo-build firn.repo-build-native/-main \
      "${repo_build_sources[@]}"
    materialize schema firn-schema firn.schema-transaction-native/-main \
      "${schema_sources[@]}"
    materialize repo-workflow firn-repo-workflow firn.repo-workflows-native/-main \
      "${repo_workflow_sources[@]}"
    materialize rebuild firn-rebuild firn.rebuild-family/-main \
      "${rebuild_sources[@]}"
    materialize prewarm firn-prewarm firn.prewarm-native/-main \
      "${prewarm_sources[@]}"
    ;;
esac

read -r bundle_id _ < <(sha256sum "$manifest")
destination="$versions/$bundle_id"
if [[ -e "$destination" ]]; then
  if [[ ! -f "$destination/manifest" ]] ||
     ! cmp -s "$manifest" "$destination/manifest"; then
    printf 'firn-runtime-update: existing runtime manifest mismatch: %s\n' \
      "$destination" >&2
    exit 1
  fi
  for binary in "${binaries[@]}"; do
    output="$destination/bin/$binary"
    if [[ ! -x "$output" ]]; then
      printf 'firn-runtime-update: existing runtime is incomplete: %s\n' \
        "$destination" >&2
      exit 1
    fi
    read -r existing_id _ < <(sha256sum "$output")
    if [[ "$existing_id" != "${artifact_ids[bin/$binary]}" ]]; then
      printf 'firn-runtime-update: existing runtime identity mismatch: %s\n' \
        "$output" >&2
      exit 1
    fi
  done
  for relative in "${artifact_paths[@]}"; do
    output="$destination/$relative"
    if [[ ! -f "$output" ]]; then
      printf 'firn-runtime-update: existing runtime is incomplete: %s\n' \
        "$destination" >&2
      exit 1
    fi
    read -r existing_id _ < <(sha256sum "$output")
    if [[ "$existing_id" != "${artifact_ids[$relative]}" ]]; then
      printf 'firn-runtime-update: existing runtime identity mismatch: %s\n' \
        "$output" >&2
      exit 1
    fi
  done
else
  mv -- "$stage" "$destination"
  stage=""
fi

next="$runtime_root/.current.$$"
ln -s "versions/$bundle_id" "$next"
mv -Tf -- "$next" "$runtime_root/current"
next=""

printf 'firn runtime active: %s\n' "$destination"
printf 'manifest: %s\n' "$destination/manifest"
