#!/usr/bin/env bun
import { mkdtempSync, rmSync, readFileSync, existsSync, statSync, mkdirSync } from "fs";
import { hostname, tmpdir } from "os";
import { basename, join, resolve } from "path";

const USAGE = `usage: vast-job --offer-query '<vastai search query>' --max-hours H [--upload <dir|git-ref>]... --run '<remote command>' --fetch <remote path> --to <local dir> [--disk GB] [--image IMAGE]

Rents the offer with the most cpu_cores_effective per dollar, uploads to /root/<name>,
runs the command under nohup, and stops at the earliest of: command exit, H hours,
credit below $2, or SIGINT/SIGTERM/crash. It then fetches the result, destroys the
instance and its volumes, removes the job's SSH key, and verifies none is left.
Exit: the remote command's status; 1 when stopped early; 3 when cleanup is unverified.`;

const FLOOR = 2;
const POLL_MS = 60_000;
const VASTAI = process.env.VAST_JOB_VASTAI ?? `${process.env.HOME}/.local/bin/vastai`;
const SECRETS = `${process.env.HOME}/code/nixos-config/main/secrets/vastai.yaml`;

type Args = { query: string; hours: number; uploads: string[]; run: string; fetch: string; to: string; disk: number; image: string };

function log(line: string) {
  process.stdout.write(`vast-job: ${line}\n`);
}

function die(line: string): never {
  process.stderr.write(`vast-job: ${line}\n`);
  process.exit(2);
}

function parseArgs(argv: string[]): Args {
  const a: Partial<Args> & { uploads: string[] } = { uploads: [], disk: 10, image: "ubuntu:22.04" };
  for (let i = 0; i < argv.length; i++) {
    const flag = argv[i];
    if (flag === "-h" || flag === "--help") {
      console.log(USAGE);
      process.exit(0);
    }
    const value = argv[++i];
    if (value === undefined) die(`missing value for ${flag}\n${USAGE}`);
    switch (flag) {
      case "--offer-query": a.query = value; break;
      case "--max-hours": a.hours = Number(value); break;
      case "--upload": a.uploads.push(value); break;
      case "--run": a.run = value; break;
      case "--fetch": a.fetch = value; break;
      case "--to": a.to = value; break;
      case "--disk": a.disk = Number(value); break;
      case "--image": a.image = value; break;
      default: die(`unknown option ${flag}\n${USAGE}`);
    }
  }
  for (const k of ["query", "hours", "run", "fetch", "to"] as const) if (a[k] === undefined) die(`missing --${k === "query" ? "offer-query" : k === "hours" ? "max-hours" : k}\n${USAGE}`);
  if (!(a.hours! > 0)) die("--max-hours must be positive");
  if (!(a.disk! > 0)) die("--disk must be positive");
  return a as Args;
}

const args = parseArgs(process.argv.slice(2));

const decrypt = Bun.spawnSync(["sudo", "-n", "env", "SOPS_AGE_KEY_FILE=/var/lib/sops-nix/key.txt", "sops", "-d", "--extract", '["api_key"]', SECRETS], { stdout: "pipe", stderr: "pipe" });
if (decrypt.exitCode !== 0) die("could not decrypt the vast.ai API key");
const apiKey = decrypt.stdout.toString().trim();
const baseEnv = { ...process.env };
delete baseEnv.VAST_API_KEY;

async function sh(cmd: string[], opts: { input?: Uint8Array | string; vast?: boolean; timeoutSec?: number } = {}) {
  const full = ["setsid", "timeout", String(opts.timeoutSec ?? 300), ...cmd];
  const p = Bun.spawn(full, {
    stdin: opts.input === undefined ? "ignore" : new Blob([opts.input]),
    stdout: "pipe",
    stderr: "pipe",
    env: opts.vast ? { ...baseEnv, VAST_API_KEY: apiKey } : baseEnv,
  });
  const [out, err, code] = await Promise.all([new Response(p.stdout).text(), new Response(p.stderr).text(), p.exited]);
  return { code, out, err };
}

async function vast(...cmd: string[]): Promise<any> {
  const r = await sh([VASTAI, ...cmd, "--raw"], { vast: true, timeoutSec: 120 });
  if (r.code !== 0) throw new Error(`vastai ${cmd.slice(0, 2).join(" ")} failed: ${(r.err || r.out).trim().slice(0, 300)}`);
  try {
    return JSON.parse(r.out);
  } catch {
    return r.out.trim();
  }
}

async function credit(): Promise<number> {
  const u = await vast("show", "user");
  const c = Number(u.credit);
  if (!Number.isFinite(c)) throw new Error("show user returned no credit");
  return c;
}

let stopReason: string | null = null;
let wake: (() => void) | null = null;
function requestStop(reason: string) {
  if (stopReason === null) {
    stopReason = reason;
    log(`stop requested: ${reason}`);
  } else log(`${reason} ignored; cleanup is already running`);
  wake?.();
}
process.on("SIGINT", () => requestStop("SIGINT"));
process.on("SIGTERM", () => requestStop("SIGTERM"));
process.on("SIGHUP", () => requestStop("SIGHUP"));

function sleep(ms: number) {
  return new Promise<void>((done) => {
    const t = setTimeout(() => { wake = null; done(); }, ms);
    wake = () => { clearTimeout(t); wake = null; done(); };
  });
}

const LABEL_GRACE_S = 900;
const labelSuffix = Math.random().toString(36).slice(2, 8);
let label = `vast-job-${hostname()}-${process.pid}-${Math.floor(Date.now() / 1000)}-${labelSuffix}`;
const keyDir = mkdtempSync(join(tmpdir(), "vast-job-"));
const keyPath = join(keyDir, "id_ed25519");
let instanceId: number | null = null;
let accountKeyId: number | null = null;
let ssh: { host: string; port: string } | null = null;
let startCredit = NaN;
let price = NaN;
let rentedAt = 0;
let remoteExit: number | null = null;

function sshBase(): string[] {
  return ["ssh", "-i", keyPath, "-p", ssh!.port, "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null", "-o", "LogLevel=ERROR", "-o", "ConnectTimeout=15", `root@${ssh!.host}`];
}
function rsyncShell(): string {
  return `ssh -i ${keyPath} -p ${ssh!.port} -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=15`;
}
function remote(command: string, input?: Uint8Array | string, timeoutSec = 120) {
  return sh([...sshBase(), command], { input, timeoutSec });
}

async function rent() {
  startCredit = await credit();
  log(`credit $${startCredit.toFixed(4)}`);
  const offers: any[] = await vast("search", "offers", args.query, "--storage", String(args.disk), "--limit", "1000");
  if (!Array.isArray(offers) || offers.length === 0) throw new Error("no offers match the query");
  const ranked = offers.filter((o) => o.dph_total > 0 && o.cpu_cores_effective > 0).sort((x, y) => y.cpu_cores_effective / y.dph_total - x.cpu_cores_effective / x.dph_total);
  const offer = ranked[0];
  price = offer.dph_total;
  const need = args.hours * price + FLOOR;
  log(`offer ${offer.id}: ${offer.cpu_cores_effective.toFixed(1)} effective cores, $${price.toFixed(4)}/h with ${args.disk} GB storage; needs $${need.toFixed(4)}`);
  if (startCredit < need) throw new Error(`refusing to rent: credit $${startCredit.toFixed(4)} is below H x $/h + $${FLOOR} = $${need.toFixed(4)}`);
  if (stopReason) return;

  const gen = await sh(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", label, "-f", keyPath]);
  if (gen.code !== 0) throw new Error(`ssh-keygen failed: ${gen.err.trim()}`);
  const pub = readFileSync(`${keyPath}.pub`, "utf8").trim();
  const before = new Set(((await vast("show", "ssh-keys")) as any[]).map((k) => k.id));
  await vast("create", "ssh-key", pub, "-y");
  const after = (await vast("show", "ssh-keys")) as any[];
  accountKeyId = after.find((k) => !before.has(k.id) && String(k.public_key ?? k.ssh_key ?? "").trim() === pub)?.id ?? after.find((k) => !before.has(k.id))?.id ?? null;
  if (accountKeyId === null) throw new Error("job SSH key did not appear on the account");
  log(`job SSH key ${accountKeyId} added`);
  if (stopReason) return;

  label = `vast-job-${hostname()}-${process.pid}-${Math.floor(Date.now() / 1000 + args.hours * 3600 + LABEL_GRACE_S)}-${labelSuffix}`;
  const created = await vast("create", "instance", String(offer.id), "--image", args.image, "--disk", String(args.disk), "--ssh", "--direct", "--label", label, "--cancel-unavail", "--onstart-cmd", "command -v rsync >/dev/null || (apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq rsync >/dev/null)");
  rentedAt = Date.now();
  instanceId = Number(created?.new_contract);
  if (!Number.isFinite(instanceId) || instanceId <= 0) throw new Error(`create instance returned no contract: ${JSON.stringify(created).slice(0, 200)}`);
  log(`instance ${instanceId} rented (label ${label}); deadline in ${args.hours} h`);
  await vast("attach", "ssh", String(instanceId), pub).catch(() => {});
}

function pastDeadline() {
  return Date.now() - rentedAt >= args.hours * 3600_000;
}

async function waitForSsh() {
  let lastStatus = "";
  while (!stopReason) {
    if (pastDeadline()) return requestStop("deadline reached before SSH");
    const inst = await vast("show", "instance", String(instanceId)).catch(() => null);
    const status = String(inst?.actual_status ?? "unknown");
    if (status !== lastStatus) log(`instance status ${status}`), (lastStatus = status);
    if (status === "running") {
      const url = await sh([VASTAI, "ssh-url", String(instanceId)], { vast: true, timeoutSec: 60 });
      const m = url.out.trim().match(/^ssh:\/\/root@([^:]+):(\d+)/);
      if (m) {
        ssh = { host: m[1], port: m[2] };
        const probe = await remote("command -v rsync >/dev/null && echo ready", undefined, 30);
        if (probe.out.includes("ready")) return log(`SSH ready at ${ssh.host}:${ssh.port}`);
      }
    }
    await sleep(10_000);
  }
}

async function upload() {
  for (const item of args.uploads) {
    if (stopReason) return;
    if (existsSync(item) && statSync(item).isDirectory()) {
      const name = basename(resolve(item));
      const r = await sh(["rsync", "-az", "--delete", "-e", rsyncShell(), `${resolve(item)}/`, `root@${ssh!.host}:/root/${name}/`], { timeoutSec: 3600 });
      if (r.code !== 0) throw new Error(`rsync of ${item} failed: ${r.err.trim().slice(0, 300)}`);
      log(`uploaded ${item} to /root/${name}`);
      continue;
    }
    const ref = await sh(["git", "rev-parse", "--verify", `${item}^{commit}`]);
    if (ref.code !== 0) throw new Error(`--upload ${item} is neither a directory nor a git ref here`);
    const name = basename((await sh(["git", "rev-parse", "--show-toplevel"])).out.trim());
    const tar = Bun.spawnSync(["git", "archive", "--format=tar", item], { stdout: "pipe", stderr: "pipe", maxBuffer: 4 * 1024 ** 3 });
    if (tar.exitCode !== 0) throw new Error(`git archive ${item} failed`);
    const r = await remote(`rm -rf /root/${name} && mkdir -p /root/${name} && tar -x -C /root/${name}`, tar.stdout, 3600);
    if (r.code !== 0) throw new Error(`upload of ${item} failed: ${r.err.trim().slice(0, 300)}`);
    log(`uploaded git ${item} (${ref.out.trim().slice(0, 12)}) to /root/${name}`);
  }
}

async function start() {
  const script = Buffer.from(args.run).toString("base64");
  const r = await remote(`echo ${script} | base64 -d > /root/.vast-job.sh && rm -f /root/.vast-job-exit && cd /root || exit 1; nohup bash -c 'bash /root/.vast-job.sh > /root/vast-job.log 2>&1; echo $? > /root/.vast-job-exit' </dev/null >/dev/null 2>&1 & echo started`);
  if (!r.out.includes("started")) throw new Error(`could not start the command: ${r.err.trim().slice(0, 300)}`);
  log("command started under nohup; log at /root/vast-job.log");
}

async function supervise() {
  while (!stopReason) {
    await sleep(POLL_MS);
    if (stopReason) return;
    const r = await remote("cat /root/.vast-job-exit 2>/dev/null; true", undefined, 60);
    const done = r.out.trim();
    if (done !== "") {
      remoteExit = Number(done);
      return log(`command exited with status ${remoteExit}`);
    }
    if (pastDeadline()) return requestStop(`deadline of ${args.hours} h reached`);
    const c = await credit().catch(() => NaN);
    if (c < FLOOR) return requestStop(`credit $${c.toFixed(4)} below $${FLOOR}`);
    log(`running ${((Date.now() - rentedAt) / 60000).toFixed(1)} min${r.code !== 0 ? " (poll SSH failed)" : ""}; credit $${c.toFixed(4)}`);
  }
}

async function fetchResults() {
  if (!ssh) return log("no SSH connection; nothing to fetch");
  mkdirSync(args.to, { recursive: true });
  const r = await sh(["rsync", "-az", "-e", rsyncShell(), `root@${ssh.host}:${args.fetch}`, `root@${ssh.host}:/root/vast-job.log`, `${resolve(args.to)}/`], { timeoutSec: 3600 });
  log(r.code === 0 ? `fetched ${args.fetch} and vast-job.log to ${args.to}` : `FETCH FAILED for ${args.fetch}: ${r.err.trim().slice(0, 300)}`);
}

function mine(x: any) {
  return x?.label === label || (instanceId !== null && (x?.id === instanceId || JSON.stringify(x).includes(String(instanceId))));
}

async function cleanup(): Promise<boolean> {
  let ok = true;
  let instancesClear = false;
  for (let attempt = 0; attempt < 12 && !instancesClear; attempt++) {
    const list = await vast("show", "instances").catch(() => null);
    if (!Array.isArray(list)) { await Bun.sleep(5000); continue; }
    const ours = list.filter(mine);
    if (ours.length === 0) { instancesClear = true; break; }
    for (const inst of ours) await vast("destroy", "instance", String(inst.id), "-y").then(() => log(`destroy instance ${inst.id} requested`)).catch((e) => log(`destroy instance ${inst.id} failed: ${e.message}`));
    await Bun.sleep(10_000);
  }
  let volumesClear = false;
  for (let attempt = 0; attempt < 6 && !volumesClear; attempt++) {
    const vols = await vast("show", "volumes").catch(() => null);
    if (!Array.isArray(vols)) { await Bun.sleep(5000); continue; }
    const ours = vols.filter(mine);
    if (ours.length === 0) { volumesClear = true; break; }
    for (const v of ours) await vast("delete", "volume", String(v.id)).then(() => log(`delete volume ${v.id} requested`)).catch((e) => log(`delete volume ${v.id} failed: ${e.message}`));
    await Bun.sleep(10_000);
  }
  let keyClear = accountKeyId === null;
  if (accountKeyId !== null) {
    await vast("delete", "ssh-key", String(accountKeyId)).catch((e) => log(`delete ssh-key ${accountKeyId} failed: ${e.message}`));
    const keys = await vast("show", "ssh-keys").catch(() => null);
    keyClear = Array.isArray(keys) && !keys.some((k) => k.id === accountKeyId);
  }
  rmSync(keyDir, { recursive: true, force: true });
  log(`verify: instances for this job ${instancesClear ? "none" : "STILL PRESENT"}; volumes ${volumesClear ? "none" : "STILL PRESENT"}; job SSH key ${keyClear ? "removed" : "STILL ON ACCOUNT"}`);
  ok = instancesClear && volumesClear && keyClear;
  if (Number.isFinite(startCredit)) {
    const end = await credit().catch(() => NaN);
    const est = rentedAt ? ((Date.now() - rentedAt) / 3600_000) * price : 0;
    log(`final credit $${end.toFixed(4)}; cost $${(startCredit - end).toFixed(4)} by credit (estimate $${est.toFixed(4)} from $/h x time)`);
  }
  return ok;
}

let failure: string | null = null;
try {
  await rent();
  if (instanceId !== null && !stopReason) await waitForSsh();
  if (ssh && !stopReason) await upload();
  if (ssh && !stopReason) await start();
  if (ssh && !stopReason) await supervise();
} catch (e: any) {
  failure = e?.message ?? String(e);
  log(`error: ${failure}`);
} finally {
  if (instanceId !== null) await fetchResults().catch((e) => log(`FETCH FAILED: ${e.message}`));
  const clean = await cleanup().catch((e) => (log(`cleanup error: ${e.message}`), false));
  if (!clean) {
    const msg = `CLEANUP NOT VERIFIED: instance ${instanceId ?? "?"} (label ${label}) or its key/volume may still be billing. Check: vastai show instances; vastai show volumes; vastai show ssh-keys`;
    process.stderr.write(`\n!!!!!!!! vast-job: ${msg} !!!!!!!!\n\n`);
    process.exit(3);
  }
  log("cleanup verified");
  process.exit(failure || remoteExit === null ? 1 : remoteExit);
}
