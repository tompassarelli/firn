#!/usr/bin/env bash
# rofi chooser over spaces: goto (default), --move column, --assign workspace.
mode="${1:-goto}"
case "$mode" in
  --move)   verb="move-to-space"; prompt="move to space" ;;
  --assign) verb="assign";        prompt="assign to space" ;;
  *)        verb="goto";          prompt="space" ;;
esac
choice="$(spaces list --menu | rofi -dmenu -p "$prompt")" || exit 0
[ -n "$choice" ] || exit 0
exec spaces "$verb" "$choice"
