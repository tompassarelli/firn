#!/usr/bin/env bash
# Select an unlocked secret collection as the Secret Service default.
#
# Codex blocks session init on org.freedesktop.Secret.Prompt.Prompt() when the
# default collection is locked: it waits for a prompt completion signal that a
# session without a graphical prompter never delivers, so the session never
# starts. PAM unlocks only `login`, while the stored default is usually another
# collection, and restarting the keyring daemon relocks everything. Point the
# default at a collection that is already unlocked instead.
set -uo pipefail

SERVICE=org.freedesktop.secrets
ROOT=/org/freedesktop/secrets

note() { printf 'codex-keyring-default: %s\n' "$*"; }

service_present() {
  busctl --user call org.freedesktop.DBus /org/freedesktop/DBus \
    org.freedesktop.DBus GetNameOwner s "$SERVICE" >/dev/null 2>&1
}

collection_paths() {
  busctl --user get-property "$SERVICE" "$ROOT" \
    org.freedesktop.Secret.Service Collections 2>/dev/null |
    grep -o '"/[^"]*"' | tr -d '"'
}

collection_unlocked() {
  [ "$(busctl --user get-property "$SERVICE" "$1" \
    org.freedesktop.Secret.Collection Locked 2>/dev/null)" = "b false" ]
}

current_default() {
  busctl --user call "$SERVICE" "$ROOT" \
    org.freedesktop.Secret.Service ReadAlias s default 2>/dev/null |
    grep -o '"/[^"]*"' | tr -d '"'
}

# The collection set is published lazily, so a login race is expected rather
# than exceptional. Absent secret storage is not an error for this machine.
for _ in $(seq 1 60); do
  service_present && [ -n "$(collection_paths)" ] && break
  sleep 1
done
if ! service_present; then
  note "no secret service on this session; nothing to select"
  exit 0
fi

existing="$(current_default)"
if [ -n "$existing" ] && collection_unlocked "$existing"; then
  note "default collection is already unlocked: $existing"
  exit 0
fi

while IFS= read -r collection; do
  [ -n "$collection" ] || continue
  collection_unlocked "$collection" || continue
  if busctl --user call "$SERVICE" "$ROOT" \
      org.freedesktop.Secret.Service SetAlias so default "$collection" \
      >/dev/null 2>&1; then
    note "selected unlocked default collection: $collection"
    exit 0
  fi
done < <(collection_paths)

note "no unlocked collection available; left default at ${existing:-none}"
exit 0
