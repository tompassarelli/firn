#!/usr/bin/env bash
set -euo pipefail

tool="${1:?usage: _firn-live-tool TOOL [ARGS...]}"
shift

firn_repo="${FIRN_REPO:-$HOME/code/nixos-config/main}" # hardcoded-repo-path:allow
beagle_path="${BEAGLE_PATH:-$HOME/code/beagle/main}" # hardcoded-repo-path:allow
beagle="$beagle_path/bin/beagle"

if [[ ! -x "$beagle" ]]; then
  printf '%s: BEAGLE_PATH has no executable bin/beagle: %s\n' "$tool" "$beagle_path" >&2
  exit 1
fi

case "$tool" in
  activity-menu)
    sources=("$firn_repo/native/activity_menu.bjs")
    host="$firn_repo/native/activity_menu_host.mjs"
    module="activity/menu.js"
    module_environment="FIRN_ACTIVITY_MENU_MODULE"
    ;;
  firn-system-policy)
    sources=(
      "$beagle_path/native-core/src/native/json.bjs"
      "$firn_repo/native/system_policy.bjs"
      "$firn_repo/native/system_policy_native.bjs"
    )
    host="$firn_repo/native/system_policy_host.mjs"
    module="firn/system-policy-native.js"
    module_environment="FIRN_SYSTEM_POLICY_MODULE"
    ;;
  *)
    printf '_firn-live-tool: unknown tool: %s\n' "$tool" >&2
    exit 2
    ;;
esac

stage="$(mktemp -d "${TMPDIR:-/tmp}/firn-live-tool.XXXXXX")"
cleanup() {
  rm -rf -- "${stage:?}"
}
trap cleanup EXIT

 bun="${FIRN_BUN:-$(command -v bun || true)}"
if [[ -z "$bun" || ! -x "$bun" ]]; then
  printf '%s: Bun runtime is unavailable\n' "$tool" >&2
  exit 127
fi
mkdir -p "$stage/modules/node_modules/beagle"
if ! "$beagle_path/bin/beagle-build-all" "${sources[@]}" \
  --out "$stage/modules"; then
  printf '%s: live Beagle/JS compilation failed\n' "$tool" >&2
  exit 1
fi
cp -- "$beagle_path/beagle-lib/lib/beagle/core.js" \
  "$stage/modules/node_modules/beagle/core.js"
printf '%s\n' '{"type":"module"}' \
  >"$stage/modules/node_modules/beagle/package.json"
env "$module_environment=$stage/modules/$module" "$bun" "$host" "$@"
