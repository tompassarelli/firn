#!/usr/bin/env bash
set -euo pipefail

tool="${1:?usage: _firn-live-tool TOOL [ARGS...]}"
shift

firn_repo="${FIRN_REPO:-$HOME/code/nixos-config/main}" # hardcoded-repo-path:allow
beagle_path="${BEAGLE_PATH:-$HOME/code/beagle/main}" # hardcoded-repo-path:allow
beagle="$beagle_path/bin/beagle"

if [[ ! -x "$beagle" ]]; then
  printf '%s: BEAGLE_PATH has no executable bin/beagle: %s\n' "$tool" "$beagle_path" >&2
  exit 1
fi

case "$tool" in
  activity-menu)
    mode="js"
    sources=("$firn_repo/native/activity_menu.bjs")
    host="$firn_repo/native/activity_menu_host.mjs"
    ;;
  firn-system-policy)
    mode="native"
    entry="firn.system-policy-native/-main"
    sources=(
      "$beagle_path/native-core/src/native/json.bgl"
      "$firn_repo/native/system_policy.bgl"
      "$firn_repo/native/system_policy_native.bgl"
    )
    ;;
  *)
    printf '_firn-live-tool: unknown tool: %s\n' "$tool" >&2
    exit 2
    ;;
esac

stage="$(mktemp -d "${TMPDIR:-/tmp}/firn-live-tool.XXXXXX")"
cleanup() {
  rm -rf -- "${stage:?}"
}
trap cleanup EXIT

if [[ "$mode" == js ]]; then
  bun="${FIRN_BUN:-$(command -v bun || true)}"
  if [[ -z "$bun" || ! -x "$bun" ]]; then
    printf '%s: Bun runtime is unavailable\n' "$tool" >&2
    exit 127
  fi
  mkdir -p "$stage/modules/activity"
  if ! "$beagle" build "${sources[0]}" "$stage/modules/activity/menu.js"; then
    printf '%s: live Beagle/JS compilation failed\n' "$tool" >&2
    exit 1
  fi
  FIRN_ACTIVITY_MENU_MODULE="$stage/modules/activity/menu.js" \
    "$bun" "$host" "$@"
  exit $?
fi

if ! "$beagle" native-exe \
  --out "$stage/$tool" \
  --artifacts "$stage/artifacts" \
  --entry "$entry" \
  "${sources[@]}"; then
  printf '%s: live native materialization failed\n' "$tool" >&2
  exit 1
fi

"$stage/$tool" "$@"
