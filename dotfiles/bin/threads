#!/usr/bin/env python3
"""threads: who holds which GitHub issue, handoffs, and the worker runs spent
on each. GitHub owns the issue itself (title, boxes, state, blocked-by); this
SQLite file holds only what GitHub can't."""

from __future__ import annotations

import argparse
import json
import os
import random
import re
import sqlite3
import subprocess
import sys
import time
from datetime import datetime, timezone

DB = os.environ.get("THREADS_DB") or os.path.expanduser("~/.local/state/threads/threads.db")
CACHE_SECONDS = 60

# Every repository under OWNER whose issues threads tracks. A ref names the
# GitHub repository (firn#3); ALIASES lets a checkout's name stand in for it.
OWNER = "tompassarelli"
REPOS = ["smashcraft", "wisp", "firn", "north", "clause", "beagle", "gjoa", "fram", "wake"]
ALIASES = {"nixos-config": "firn"}

SCHEMA = """
CREATE TABLE IF NOT EXISTS events(
  seq INTEGER PRIMARY KEY,
  ts TEXT NOT NULL,
  item TEXT,
  kind TEXT NOT NULL CHECK(kind IN ('claim','release','handoff','need','unneed','run','note')),
  actor TEXT NOT NULL DEFAULT '',
  tier TEXT NOT NULL DEFAULT '',
  data TEXT NOT NULL DEFAULT '{}' CHECK(json_valid(data))
) STRICT;
CREATE TABLE IF NOT EXISTS claims(
  item TEXT PRIMARY KEY CHECK(item GLOB '*#[0-9]*'),
  owner TEXT NOT NULL CHECK(length(owner) > 0),
  since TEXT NOT NULL,
  eta_min INTEGER CHECK(eta_min IS NULL OR eta_min > 0)
) STRICT;
CREATE TABLE IF NOT EXISTS runs(
  agent TEXT PRIMARY KEY,
  item TEXT,
  follows TEXT,
  session TEXT,
  tier TEXT NOT NULL,
  category TEXT NOT NULL,
  started TEXT,
  ended TEXT NOT NULL,
  minutes INTEGER NOT NULL CHECK(minutes >= 0),
  eta_min INTEGER,
  tokens INTEGER,
  peak_ctx INTEGER,
  outcome TEXT NOT NULL CHECK(outcome IN ('done','not done','escalated','handoff','unclear')),
  report TEXT NOT NULL DEFAULT '',
  note TEXT,
  repeats INTEGER,
  landed INTEGER,
  arm TEXT,
  spec TEXT,
  scope TEXT,
  surface TEXT,
  verify TEXT,
  lens TEXT,
  flaws INTEGER,
  expects_landing INTEGER
) STRICT;
CREATE TABLE IF NOT EXISTS tier_choice(
  cell TEXT PRIMARY KEY,
  tier TEXT NOT NULL,
  since TEXT NOT NULL
) STRICT;
CREATE TABLE IF NOT EXISTS gh_cache(
  repo TEXT PRIMARY KEY,
  fetched REAL NOT NULL,
  issues TEXT NOT NULL CHECK(json_valid(issues))
) STRICT;
CREATE TABLE IF NOT EXISTS blocks(
  item TEXT PRIMARY KEY,
  reason TEXT NOT NULL,
  since TEXT NOT NULL,
  by TEXT NOT NULL
) STRICT;
CREATE INDEX IF NOT EXISTS events_item ON events(item, seq);
CREATE INDEX IF NOT EXISTS runs_item ON runs(item, ended);
"""


class Refused(Exception):
    pass


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def minutes_since(ts):
    return int((datetime.now(timezone.utc) - datetime.fromisoformat(ts.replace("Z", "+00:00"))).total_seconds() // 60)


def default_actor() -> str:
    return os.environ.get("THREADS_ACTOR") or os.environ.get("USER") or "unknown"


def table_exists(db, name):
    return db.execute("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?", (name,)).fetchone()


class Tx:
    """One BEGIN IMMEDIATE transaction per command: every write lands whole or not at all."""

    def __init__(self, db: sqlite3.Connection):
        self.db = db

    def __enter__(self):
        self.db.execute("BEGIN IMMEDIATE")
        return self.db

    def __exit__(self, kind, *_):
        self.db.execute("COMMIT" if kind is None else "ROLLBACK")
        return False


def connect() -> sqlite3.Connection:
    os.makedirs(os.path.dirname(DB), exist_ok=True)
    db = sqlite3.connect(DB, timeout=10, isolation_level=None)
    db.row_factory = sqlite3.Row
    db.execute("PRAGMA busy_timeout = 10000")
    if db.execute("PRAGMA journal_mode").fetchone()[0] != "wal":
        db.execute("PRAGMA journal_mode = WAL")
    if not table_exists(db, "blocks"):
        with Tx(db):
            for stmt in SCHEMA.split(";"):
                if stmt.strip():
                    db.execute(stmt)
    columns = {r[1] for r in db.execute("PRAGMA table_info(runs)")}
    for column in ("repeats", "landed"):
        if column not in columns:
            db.execute(f"ALTER TABLE runs ADD COLUMN {column} INTEGER")
    for column in ("arm", "spec", "scope", "surface", "verify", "lens"):
        if column not in columns:
            db.execute(f"ALTER TABLE runs ADD COLUMN {column} TEXT")
    for column in ("flaws", "expects_landing"):
        if column not in columns:
            db.execute(f"ALTER TABLE runs ADD COLUMN {column} INTEGER")
    db.execute("CREATE TABLE IF NOT EXISTS tier_choice(cell TEXT PRIMARY KEY, tier TEXT NOT NULL, since TEXT NOT NULL) STRICT")
    return db


def event(db, item, kind, actor="", tier="", **data):
    db.execute(
        "INSERT INTO events(ts, item, kind, actor, tier, data) VALUES (?,?,?,?,?,?)",
        (now(), item, kind, actor, tier, json.dumps(data)),
    )


# Issue refs and GitHub ---------------------------------------------------------

REF = re.compile(r"^([\w.-]+(?:/[\w.-]+)?)#(\d+)$")


def parse_ref(ref: str) -> tuple[str, int]:
    """'smashcraft#222', 'tompassarelli/smashcraft#222' or 'nixos-config#3' -> ('smashcraft', 222) / ('firn', 3)."""
    m = REF.match(ref.strip())
    if not m:
        raise Refused(f"{ref} is not an issue ref like smashcraft#222")
    name = m.group(1).removeprefix(f"{OWNER}/")
    repo = ALIASES.get(name, name)
    if repo not in REPOS:
        raise Refused(f"unknown repo {m.group(1)} (known: {', '.join(REPOS)})")
    return repo, int(m.group(2))


def ref(repo: str, number: int) -> str:
    return f"{repo}#{number}"


def gh(*args: str) -> str:
    """Run gh, waiting out rate-limit refusals (retry-after unknown: 30 s doubling to 5 min, ~65 min in all)."""
    delay, waited = 30.0, 0.0
    while True:
        p = subprocess.run(["gh", *args], capture_output=True, text=True)
        if p.returncode == 0:
            return p.stdout
        if "rate limit" not in p.stderr.lower() or waited > 65 * 60:
            raise Refused(f"gh {args[0]} {args[1] if len(args) > 1 else ''}: {p.stderr.strip()}")
        pause = delay * random.uniform(0.8, 1.2)
        print(f"threads: GitHub rate limit, waiting {pause:.0f} s", file=sys.stderr)
        time.sleep(pause)
        waited += pause
        delay = min(delay * 2, 300)


OPEN_ISSUES = """
query($owner: String!, $name: String!, $cursor: String) {
  repository(owner: $owner, name: $name) {
    issues(states: OPEN, first: 100, after: $cursor) {
      pageInfo { hasNextPage endCursor }
      nodes { number title blockedBy(first: 50) { nodes { number state repository { nameWithOwner } } } }
    }
  }
}"""

ONE_ISSUE = """
query($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) {
    issue(number: $number) {
      number title state blockedBy(first: 50) { nodes { number state repository { nameWithOwner } } }
    }
  }
}"""


def blockers(node) -> list:
    out = []
    for b in node["blockedBy"]["nodes"]:
        full = b["repository"]["nameWithOwner"]
        out.append({"ref": ref(full.removeprefix(f"{OWNER}/"), b["number"]), "state": b["state"]})
    return out


def open_issues(db, repo: str) -> dict:
    """{number: {title, blockers}} for the repo's open issues; one paged query, cached CACHE_SECONDS."""
    row = db.execute("SELECT fetched, issues FROM gh_cache WHERE repo = ?", (repo,)).fetchone()
    if row and time.time() - row["fetched"] < CACHE_SECONDS:
        return json.loads(row["issues"])
    owner, name = OWNER, repo
    issues, cursor = {}, None
    while True:
        args = ["api", "graphql", "-f", f"query={OPEN_ISSUES}", "-F", f"owner={owner}", "-F", f"name={name}"]
        if cursor:
            args += ["-F", f"cursor={cursor}"]
        page = json.loads(gh(*args))["data"]["repository"]["issues"]
        for n in page["nodes"]:
            issues[str(n["number"])] = {"title": n["title"], "blockers": blockers(n)}
        if not page["pageInfo"]["hasNextPage"]:
            break
        cursor = page["pageInfo"]["endCursor"]
    with Tx(db):
        db.execute(
            "INSERT OR REPLACE INTO gh_cache(repo, fetched, issues) VALUES (?,?,?)",
            (repo, time.time(), json.dumps(issues)),
        )
    return issues


def one_issue(db, repo: str, number: int) -> dict:
    row = db.execute("SELECT fetched, issues FROM gh_cache WHERE repo = ?", (repo,)).fetchone()
    if row and time.time() - row["fetched"] < CACHE_SECONDS and str(number) in json.loads(row["issues"]):
        return dict(json.loads(row["issues"])[str(number)], state="OPEN")
    owner, name = OWNER, repo
    out = json.loads(gh("api", "graphql", "-f", f"query={ONE_ISSUE}", "-F", f"owner={owner}",
                        "-F", f"name={name}", "-F", f"number={number}"))
    issue = out["data"]["repository"]["issue"]
    if issue is None:
        raise Refused(f"no issue {ref(repo, number)}")
    return {"title": issue["title"], "state": issue["state"], "blockers": blockers(issue)}


def forget(db, repo):
    with Tx(db):
        db.execute("DELETE FROM gh_cache WHERE repo = ?", (repo,))


# Commands --------------------------------------------------------------------


def cmd_claim(db, a):
    item = ref(*parse_ref(a.id))
    with Tx(db):
        row = db.execute("SELECT owner FROM claims WHERE item = ?", (item,)).fetchone()
        if row and row["owner"] != a.by:
            raise Refused(f"{item} is already owned by {row['owner']}")
        if row:
            db.execute("UPDATE claims SET eta_min = COALESCE(?, eta_min) WHERE item = ?", (a.eta, item))
        else:
            db.execute("INSERT INTO claims(item, owner, since, eta_min) VALUES (?,?,?,?)", (item, a.by, now(), a.eta))
        event(db, item, "claim", a.by, eta_min=a.eta)
    print(f"{a.by} owns {item}")


def cmd_release(db, a):
    item = ref(*parse_ref(a.id))
    with Tx(db):
        row = db.execute("SELECT owner FROM claims WHERE item = ?", (item,)).fetchone()
        if not row:
            raise Refused(f"{item} has no owner")
        if a.to:
            db.execute("UPDATE claims SET owner = ?, since = ? WHERE item = ?", (a.to, now(), item))
            event(db, item, "handoff", a.by, **{"from": row["owner"], "to": a.to})
        else:
            db.execute("DELETE FROM claims WHERE item = ?", (item,))
            event(db, item, "release", a.by, owner=row["owner"])
    print(f"{item} handed from {row['owner']} to {a.to}" if a.to else f"{item} released by {row['owner']}")


def dependency(db, a, method):
    repo, number = parse_ref(a.id)
    brepo, bnumber = parse_ref(a.other)
    blocker_id = gh("api", f"repos/{OWNER}/{brepo}/issues/{bnumber}", "--jq", ".id").strip()
    path = f"repos/{OWNER}/{repo}/issues/{number}/dependencies/blocked_by"
    if method == "POST":
        gh("api", "-X", "POST", path, "-F", f"issue_id={blocker_id}")
    else:
        gh("api", "-X", "DELETE", f"{path}/{blocker_id}")
    forget(db, repo)
    with Tx(db):
        event(db, ref(repo, number), "need" if method == "POST" else "unneed", a.by, needs=ref(brepo, bnumber))


def cmd_need(db, a):
    dependency(db, a, "POST")
    print(f"{a.id} is blocked by {a.other} on GitHub")


def cmd_unneed(db, a):
    dependency(db, a, "DELETE")
    print(f"{a.id} is no longer blocked by {a.other}")


def cmd_show(db, a):
    repo, number = parse_ref(a.id)
    item = ref(repo, number)
    issue = one_issue(db, repo, number)
    print(f"{item}  {issue['title']}")
    print(f"  state: {issue['state'].lower()}")
    if issue["blockers"]:
        print("  blocked by: " + ", ".join(f"{b['ref']} ({b['state'].lower()})" for b in issue["blockers"]))
    c = db.execute("SELECT * FROM claims WHERE item = ?", (item,)).fetchone()
    if c:
        print(f"  owner: {c['owner']} for {minutes_since(c['since'])}m" + (f" of {c['eta_min']}m ETA" if c["eta_min"] else ""))
    hands = db.execute(
        "SELECT ts, kind, actor, data FROM events WHERE item = ? AND kind IN ('claim','release','handoff') ORDER BY seq",
        (item,),
    ).fetchall()
    if hands:
        print("  owners:")
        for e in hands:
            d = json.loads(e["data"])
            what = f"{d['from']} -> {d['to']}" if e["kind"] == "handoff" else e["actor"]
            print(f"    {e['ts']}  {e['kind']:<8} {what}")
    runs = db.execute("SELECT * FROM runs WHERE item = ? ORDER BY ended", (item,)).fetchall()
    if runs:
        print(f"  runs: {len(runs)}, {sum(r['minutes'] for r in runs)}m in all")
        for r in runs:
            eta = f"/{r['eta_min']}m ETA" if r["eta_min"] else ""
            follows = f" follows {r['follows']}" if r["follows"] else ""
            note = f"  note {r['note']}" if r["note"] else ""
            print(f"    {r['ended'][:16]}  {r['agent']} {r['tier']}{follows}  {r['minutes']}m{eta}  {r['outcome']}: {r['report'][:80]}{note}")


def cmd_ready(db, a):
    claimed = {r["item"] for r in db.execute("SELECT item FROM claims")}
    for repo in REPOS:
        issues = open_issues(db, repo)
        for number in sorted(issues, key=int):
            i = issues[number]
            item = ref(repo, int(number))
            if item in claimed or any(b["state"] == "OPEN" for b in i["blockers"]):
                continue
            print(f"{item}\t{i['title']}")


def cmd_list(db, a):
    cached = {r["repo"]: json.loads(r["issues"]) for r in db.execute("SELECT repo, issues FROM gh_cache")}
    out = [("item", "owner", "clock", "eta", "flag")]
    for c in db.execute("SELECT * FROM claims ORDER BY since"):
        repo, number = parse_ref(c["item"])
        clock = minutes_since(c["since"])
        flag = "-"
        if repo in cached and str(number) not in cached[repo]:
            flag = "CLOSED"
        elif c["eta_min"] and clock > 2 * c["eta_min"]:
            flag = "OVERDUE"
        out.append((c["item"], c["owner"], f"{clock}m", f"{c['eta_min']}m" if c["eta_min"] else "-", flag))
    widths = [max(len(row[i]) for row in out) for i in range(len(out[0]))]
    for row in out:
        print("  ".join(v.ljust(w) for v, w in zip(row, widths)).rstrip())


# Staffing: unowned and blocked issues -------------------------------------------

STAFFED = ["smashcraft", "wisp"]
PRIORITIES = ["priority:now", "-", "priority:next", "priority:later"]
BOX = re.compile(r"^\s*[-*] \[ \]", re.M)
BLOCK_DAYS = 7


def cmd_block(db, a):
    item = ref(*parse_ref(a.id))
    reason = " ".join(a.reason).strip()
    with Tx(db):
        if a.clear:
            db.execute("DELETE FROM blocks WHERE item = ?", (item,))
            event(db, item, "note", a.by, unblock=True)
        else:
            if not reason:
                raise Refused("block needs a reason")
            db.execute("INSERT OR REPLACE INTO blocks(item, reason, since, by) VALUES (?,?,?,?)", (item, reason, now(), a.by))
            event(db, item, "note", a.by, block=reason)
    print(f"{item} unblocked" if a.clear else f"{item} blocked: {reason}")


COMMIT_REF = re.compile(r"^(?:item|closes|close|fixes|fix|refs|ref|part of|issue|for)\b", re.I)
BRANCH_HOURS = 48


def commit_refs(message: str, repo: str, number: int) -> bool:
    """The headline, or an Item:/Closes/Fixes/Refs line, names the issue; a passing mention in the body does not."""
    lines = message.splitlines()
    picked = lines[:1] + [l for l in lines[1:] if COMMIT_REF.match(l.strip())]
    return any(mentions(l, repo, number) for l in picked)


def mentions(text: str, repo: str, number: int) -> bool:
    return re.search(rf"(?:(?<![\w/-])|(?<={re.escape(repo)}))#{number}(?!\d)", text) is not None


def branch_names_issue(name: str, number: int) -> bool:
    return re.search(rf"(?:^|[-_/#]){number}(?:$|[-_/])", name) is not None


def open_branches(repo: str) -> dict:
    """{branch: [commit messages ahead of the default branch]} for claude/* and *land-* branches on origin."""
    names = json.loads(gh("api", "graphql", "-f", "query=query($owner: String!, $name: String!) { repository(owner: $owner, name: $name) "
                          "{ refs(refPrefix: \"refs/heads/\", first: 100) { nodes { name target { ... on Commit { committedDate } } } } } }",
                          "-F", f"owner={OWNER}", "-F", f"name={repo}"))["data"]["repository"]["refs"]["nodes"]
    cutoff = time.time() - BRANCH_HOURS * 3600
    names = [n["name"] for n in names if (n["name"].startswith("claude/") or "land-" in n["name"])
             and datetime.fromisoformat(((n.get("target") or {}).get("committedDate") or "1970-01-01T00:00:00Z")
                                        .replace("Z", "+00:00")).timestamp() >= cutoff]
    if not names:
        return {}
    fields = " ".join(f'b{i}: compare(headRef: {json.dumps(n)}) {{ commits(first: 100) {{ nodes {{ message }} }} }}' for i, n in enumerate(names))
    out = json.loads(gh("api", "graphql", "-f", f"query=query($owner: String!, $name: String!) {{ repository(owner: $owner, name: $name) "
                        f"{{ defaultBranchRef {{ {fields} }} }} }}", "-F", f"owner={OWNER}", "-F", f"name={repo}"))
    base = out["data"]["repository"]["defaultBranchRef"]
    return {n: [c["message"] for c in ((base.get(f"b{i}") or {}).get("commits") or {}).get("nodes", [])] for i, n in enumerate(names)}


def comment_block(comments) -> str | None:
    cutoff = time.time() - BLOCK_DAYS * 86400
    for c in sorted(comments, key=lambda c: c["createdAt"], reverse=True):
        body = c.get("body", "").strip()
        if datetime.fromisoformat(c["createdAt"].replace("Z", "+00:00")).timestamp() < cutoff:
            return None
        if body.startswith("Blocked:"):
            return body[len("Blocked:"):].strip().splitlines()[0] if body[len("Blocked:"):].strip() else "comment"
    return None


def cmd_unowned(db, a):
    claims = {}
    for c in db.execute("SELECT * FROM claims"):
        if not (c["eta_min"] and minutes_since(c["since"]) > 2 * c["eta_min"]):
            claims[c["item"]] = c["owner"]
    blocks = {r["item"]: r["reason"] for r in db.execute("SELECT item, reason FROM blocks")}
    rows = []
    for repo in STAFFED:
        issues = json.loads(gh("issue", "list", "-R", f"{OWNER}/{repo}", "--state", "open", "--limit", "500",
                               "--json", "number,title,labels,body,comments"))
        branches = open_branches(repo)
        for i in issues:
            boxes = len(BOX.findall(i.get("body") or ""))
            if not boxes:
                continue
            number, item = i["number"], ref(repo, i["number"])
            labels = {l["name"] for l in i.get("labels", [])}
            prio = next((p for p in PRIORITIES if p in labels), "-")
            owner = claims.get(item) or next(
                (f"branch:{b}" for b, msgs in sorted(branches.items())
                 if branch_names_issue(b, number) or any(commit_refs(m, repo, number) for m in msgs)), None)
            block = blocks.get(item) or comment_block(i.get("comments") or [])
            state = owner or (f"blocked:{block}" if block else "UNOWNED")
            rows.append((PRIORITIES.index(prio), repo, number, prio, state, boxes, i["title"]))
    rows.sort(key=lambda r: (r[0], STAFFED.index(r[1]), r[2]))
    for _, repo, number, prio, state, boxes, title in rows:
        print(f"{ref(repo, number)}\t{prio}\t{state}\t{boxes}\t{title}")
    now_rows = [r for r in rows if r[3] == "priority:now"]
    print(f"priority:now unowned={sum(r[4] == 'UNOWNED' for r in now_rows)} "
          f"blocked={sum(r[4].startswith('blocked:') for r in now_rows)} "
          f"owned={sum(r[4] != 'UNOWNED' and not r[4].startswith('blocked:') for r in now_rows)}")


# Runs (fed by worker-ledger) ---------------------------------------------------

BRIEF_FIELD = {name: re.compile(rf"\b{name}:[ \t]*([^\s`<>]+)") for name in ("Item", "Follows", "Arm")}
CATEGORY = re.compile(r"\bCategory:[ \t]*([^.;,\n`<>]+)")
LENS = re.compile(r"\bLens:[ \t]*([^.;,\n`<>]+)")
# Orthogonal brief facets, each a closed vocabulary; worker-tier-guard holds the same lists.
FACETS = {
    "spec": ["exact", "measured", "judged"],
    "scope": ["one-file", "module", "cross-module", "cross-repo"],
    "surface": ["ts", "lua", "nix", "shell", "workflow", "docs", "assets"],
    "verify": ["none", "local-test", "farm", "native", "visual"],
}
FACET_FIELD = {f: re.compile(rf"\b{f.capitalize()}:[ \t]*([A-Za-z-]+)") for f in FACETS}


def brief_fields(brief: str) -> dict:
    out = {}
    for name, pattern in BRIEF_FIELD.items():
        m = pattern.search(brief)
        if m:
            out[name.lower()] = m.group(1).rstrip(".,;:)")
    m = CATEGORY.search(brief)
    if m:
        out["category"] = m.group(1).strip().lower()
    for facet, pattern in FACET_FIELD.items():
        m = pattern.search(brief)
        if m and m.group(1).lower() in FACETS[facet]:
            out[facet] = m.group(1).lower()
    m = LENS.search(brief)
    if m:
        out["lens"] = m.group(1).strip().lower()
    return out


CATEGORIES = [
    "mechanical", "docs-policy", "tooling", "feature", "bug-known-cause", "debugging-unknown-cause",
    "netcode-determinism", "performance", "balance-tuning", "native-check", "research",
]


def issue_ref(item):
    """Canonical repo#N, or None when the brief's Item is not an issue ref."""
    try:
        return ref(*parse_ref(item)) if item else None
    except Refused:
        return None


def hold(db, item, r, claim, follows):
    """A running worker holds its brief's issue; taking it from someone else is a handoff."""
    prev = claim["owner"] if claim else follows
    if claim:
        db.execute("UPDATE claims SET owner = ?, since = ?, eta_min = ? WHERE item = ?",
                   (r["id"], r.get("started") or now(), r.get("eta_min") and round(r["eta_min"]), item))
    else:
        db.execute("INSERT INTO claims(item, owner, since, eta_min) VALUES (?,?,?,?)",
                   (item, r["id"], r.get("started") or now(), r.get("eta_min") and round(r["eta_min"])))
        event(db, item, "claim", r["id"], r["tier"], eta_min=r.get("eta_min"))
    if prev and prev != r["id"]:
        event(db, item, "handoff", r["id"], r["tier"], **{"from": prev, "to": r["id"]})


def cmd_ingest(db, a):
    """Read worker-ledger's JSON rows on stdin. A running worker holds its Item; a finished one
    releases it and becomes a run; a stale one (idle 2 h) releases it. Recorded runs are skipped."""
    added = backfilled = 0
    with Tx(db):
        for line in sys.stdin:
            if not line.strip():
                continue
            r = json.loads(line)
            status = r.get("status", "finished")
            f = brief_fields(r.get("brief") or "")
            if db.execute("SELECT 1 FROM runs WHERE agent = ?", (r["id"],)).fetchone():
                if r.get("backfill"):
                    backfilled += db.execute(
                        "UPDATE runs SET spec = coalesce(spec, ?), scope = coalesce(scope, ?), surface = coalesce(surface, ?),"
                        " verify = coalesce(verify, ?), lens = coalesce(lens, ?), flaws = coalesce(flaws, ?),"
                        " expects_landing = coalesce(?, expects_landing), landed = coalesce(?, landed) WHERE agent = ?",
                        (f.get("spec"), f.get("scope"), f.get("surface"), f.get("verify"), f.get("lens"),
                         r.get("flaws"), r.get("expects_landing"), r.get("landed"), r["id"])).rowcount
                continue
            item = issue_ref(f.get("item") or r.get("item"))
            follows = f.get("follows") or r.get("follows")
            claim = db.execute("SELECT owner FROM claims WHERE item = ?", (item,)).fetchone() if item else None
            mine = claim is not None and claim["owner"] == r["id"]
            if status == "running":
                if item and not mine:
                    hold(db, item, r, claim, follows)
                continue
            if mine:
                db.execute("DELETE FROM claims WHERE item = ?", (item,))
                event(db, item, "release", r["id"], r["tier"], why=status)
            if status != "finished":
                continue
            raw = f.get("category") or r.get("category") or "unknown"
            category = raw if raw in CATEGORIES else "unknown"
            prev = None
            if item and not db.execute(
                "SELECT 1 FROM events WHERE item = ? AND kind = 'handoff' AND json_extract(data, '$.to') = ?",
                (item, r["id"]),
            ).fetchone():
                p = db.execute("SELECT agent FROM runs WHERE item = ? ORDER BY ended DESC LIMIT 1", (item,)).fetchone()
                prev = follows or (p["agent"] if p else None)
            eta = r.get("eta_min")
            db.execute(
                """INSERT INTO runs(agent, item, follows, session, tier, category, started, ended, minutes,
                                    eta_min, tokens, peak_ctx, outcome, report, note, repeats, landed, arm,
                                    spec, scope, surface, verify, lens, flaws, expects_landing)
                   VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
                (r["id"], item, follows, r.get("session"), r["tier"], category, r.get("started"), r["ended"],
                 r["actual_min"], None if eta is None else round(eta), r.get("tokens"), r.get("peak_ctx"),
                 r["outcome"], r.get("report") or "", r.get("note"), r.get("repeats"), r.get("landed"),
                 (f.get("arm") or "").lower() or None, f.get("spec"), f.get("scope"), f.get("surface"),
                 f.get("verify"), f.get("lens"), r.get("flaws"), r.get("expects_landing")),
            )
            if prev and prev != r["id"]:
                event(db, item, "handoff", r["id"], r["tier"], **{"from": prev, "to": r["id"]})
            event(db, item, "run", r["id"], r["tier"], category=category, brief_category=raw,
                  minutes=r["actual_min"], eta_min=eta, outcome=r["outcome"], note=r.get("note"))
            added += 1
    print(f"threads: {added} runs recorded" + (f", {backfilled} backfilled" if backfilled else "") + f" in {DB}",
          file=sys.stderr)


def cmd_run_ids(db, a):
    for (agent,) in db.execute("SELECT agent FROM runs"):
        print(agent)


def median(xs):
    xs = sorted(x for x in xs if x is not None)
    return xs[(len(xs) - 1) // 2] if xs else None


TIER_RANK = {"haiku": -1, "low": 0, "medium": 1, "high": 2, "xhigh": 3, "max": 4}


GROUPS = ["category", *FACETS]


def group_list(text):
    keys = [k.strip().lower() for k in text.split(",") if k.strip()]
    bad = [k for k in keys if k not in GROUPS]
    if bad or not keys:
        raise Refused(f"--group takes a comma list of {', '.join(GROUPS)}; got {text!r}")
    return keys


def cell_value(r, key):
    if key == "category":
        return r["category"] if r["category"] in CATEGORIES else "unknown"
    return r[key] or "-"


def cmd_summary(db, a):
    rows = db.execute("SELECT * FROM runs WHERE ended >= ?", (a.since or "",)).fetchall()
    if not rows:
        raise Refused(f"no runs in {DB}")
    keys = group_list(a.group)
    groups: dict = {}
    for r in rows:
        groups.setdefault((*(cell_value(r, k) for k in keys), r["tier"], r["arm"] or "-"), []).append(r)
    ok = run_ok(db)
    out = [(*keys, "tier", "arm", "n", "done", "success", "ok", "eta_med", "actual_med", "x_eta_med", "over_2x_eta", "tokens_med",
            "repeat_runs", "no_landing")]
    for key, rs in sorted(groups.items(), key=lambda kv: (kv[0][:-2], TIER_RANK.get(kv[0][-2], 5), kv[0][-1])):
        done = sum(r["outcome"] == "done" for r in rs)
        timed = [r for r in rs if r["eta_min"]]
        ratio = median([r["minutes"] / r["eta_min"] for r in timed])
        tok = median([r["tokens"] for r in rs])
        out.append((*key, str(len(rs)), str(done), f"{done * 100 // len(rs)}%", f"{sum(map(ok, rs)) * 100 // len(rs)}%",
                    str(median([r["eta_min"] for r in rs]) or "-"), str(median([r["minutes"] for r in rs])),
                    f"{ratio:.1f}" if ratio is not None else "-",
                    f"{sum(r['minutes'] > 2 * r['eta_min'] for r in timed)}/{len(timed)}",
                    f"{tok // 1000}k" if tok is not None else "-",
                    str(sum(r["repeats"] or 0 for r in rs)),
                    f"{sum(r['landed'] == 0 for r in rs)}/{sum(r['landed'] is not None for r in rs)}"))
    table(out)
    lenses: dict = {}
    for r in rows:
        if r["lens"]:
            lenses.setdefault(r["lens"], []).append(r)
    if lenses:
        print()
        table([("lens", "reviews", "accepted_flaws", "reviews_with_flaws")] + [
            (lens, str(len(rs)), str(sum(r["flaws"] or 0 for r in rs)), str(sum((r["flaws"] or 0) > 0 for r in rs)))
            for lens, rs in sorted(lenses.items())])
    print()
    try:
        closure(db, rows)
    except Refused as e:
        print(f"threads: closure table needs GitHub: {e}", file=sys.stderr)


BAR, MIN_RUNS, MARGIN = 80, 5, 15
BACKOFF = ["surface", "verify", "scope", "spec"]


def recommend(runs, asked, incumbent):
    """Pure core. runs: dicts with category, the facets, tier and ok (run_ok).
    asked: facet -> value, category required. incumbent: cell -> tier. Returns (cell, n, tier, rates) where
    cell is the finest one with a tier holding MIN_RUNS runs, backing off along BACKOFF; tier is the cheapest
    reaching BAR, kept at the incumbent unless a pricier challenger beats it by MARGIN points on MIN_RUNS each."""
    keys = ["category", *(k for k in reversed(BACKOFF) if k in asked)]
    while True:
        cell = {k: asked[k] for k in keys}
        rs = [r for r in runs if all(r.get(k) == v for k, v in cell.items())]
        by_tier: dict = {}
        for r in rs:
            by_tier.setdefault(r["tier"], []).append(r["ok"])
        rates = {t: (sum(oks) * 100 // len(oks), len(oks)) for t, oks in by_tier.items() if t in TIER_RANK}
        if any(n >= MIN_RUNS for _, n in rates.values()) or len(keys) == 1:
            break
        keys.pop()
    name = ", ".join(f"{k.capitalize()}: {v}" for k, v in cell.items())
    sampled = {t: rn for t, rn in rates.items() if rn[1] >= MIN_RUNS}
    passing = sorted((t for t, (rate, _) in sampled.items() if rate >= BAR), key=TIER_RANK.get)
    best = passing[0] if passing else (max(sampled, key=lambda t: (sampled[t][0], -TIER_RANK[t])) if sampled else "medium")
    held = incumbent.get(name)
    if held and held != best and held in sampled and best in sampled:
        pricier = TIER_RANK[best] > TIER_RANK[held]
        if pricier and sampled[best][0] < sampled[held][0] + MARGIN:
            best = held
    return name, len(rs), best, rates


def run_ok(db):
    """Reported Done (ruled out included) with no later Follows: run on it, and landed when the run made a commit."""
    escalated = {r["follows"] for r in db.execute("SELECT follows FROM runs WHERE follows IS NOT NULL")}
    return lambda r: (r["outcome"] == "done" and r["agent"] not in escalated
                      and not (r["expects_landing"] and r["landed"] == 0))


def cmd_recommend(db, a):
    asked = brief_fields(a.facets)
    if "category" not in asked or asked["category"] not in CATEGORIES:
        raise Refused(f"recommend needs `Category: <one of {', '.join(CATEGORIES)}>` in {a.facets!r}")
    asked = {k: v for k, v in asked.items() if k in GROUPS}
    ok = run_ok(db)
    runs = [{**{k: cell_value(r, k) for k in GROUPS}, "tier": r["tier"], "ok": ok(r)}
            for r in db.execute("SELECT * FROM runs WHERE follows IS NULL AND ended >= ?", (a.since or "",))]
    incumbent = dict(db.execute("SELECT cell, tier FROM tier_choice").fetchall())
    cell, n, tier, rates = recommend(runs, asked, incumbent)
    if incumbent.get(cell) != tier:
        with Tx(db):
            db.execute("INSERT INTO tier_choice(cell, tier, since) VALUES (?,?,?) ON CONFLICT(cell) DO UPDATE SET"
                       " tier = excluded.tier, since = excluded.since", (cell, tier, now()))
    print(f"tier {tier}  cell [{cell}]  n {n}")
    for t, (rate, k) in sorted(rates.items(), key=lambda kv: TIER_RANK[kv[0]]):
        print(f"  {t:<7} {rate}% of {k}")


def table(out):
    widths = [max(len(row[i]) for row in out) for i in range(len(out[0]))]
    for row in out:
        print("  ".join(c.ljust(w) for c, w in zip(row, widths)).rstrip())


def closure(db, rows):
    """Per issue: category and tier of its first run; closed from GitHub's open set; escalated when a
    later run used a higher tier."""
    by_item: dict = {}
    for r in rows:
        if issue_ref(r["item"]):
            by_item.setdefault(r["item"], []).append(r)
    opened: dict = {}
    groups: dict = {}
    for item, rs in by_item.items():
        rs.sort(key=lambda r: r["started"] or r["ended"])
        first = rs[0]
        repo, number = parse_ref(item)
        if repo not in opened:
            opened[repo] = open_issues(db, repo)
        g = groups.setdefault((first["category"], first["tier"]), {"issues": 0, "closed": 0, "runs": 0, "tokens": 0, "escalated": 0})
        g["issues"] += 1
        g["escalated"] += any(TIER_RANK.get(r["tier"], 5) > TIER_RANK.get(first["tier"], 5) for r in rs[1:])
        if str(number) not in opened[repo]:
            g["closed"] += 1
            g["runs"] += len(rs)
            g["tokens"] += sum(r["tokens"] or 0 for r in rs)
    out = [("category", "first_tier", "issues", "closed", "runs_per_closed", "tokens_per_closed", "escalated")]
    for (cat, tier), g in sorted(groups.items(), key=lambda kv: (kv[0][0], TIER_RANK.get(kv[0][1], 5))):
        c = g["closed"]
        out.append((cat, tier, str(g["issues"]), str(c), f"{g['runs'] / c:.1f}" if c else "-",
                    f"{g['tokens'] // c // 1000}k" if c else "-", f"{g['escalated'] * 100 // g['issues']}%"))
    table(out)


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="threads",
        description=f"Who holds which GitHub issue, handoffs and worker runs. Items are issue refs "
                    f"({', '.join(r + '#N' for r in REPOS)}). Database: {DB}",
        epilog="A running worker whose brief has `Item: <repo#N>` holds that issue (worker-ledger, run by "
               "worker-sweep); claim/release are for humans and lanes. Brief categories: "
               + ", ".join(CATEGORIES) + "; anything else counts as unknown. Facets: "
               + "; ".join(f"{k.capitalize()}: {' | '.join(v)}" for k, v in FACETS.items())
               + "; Lens: <reviewer lens>. unowned: order is priority:now, unlabeled, "
               "priority:next, priority:later; the owner is a threads claim not past 2x its ETA, else an origin claude/* or "
               f"*land-* branch with a commit in the last {BRANCH_HOURS} h whose name, or a commit headline or "
               "Item:/Closes/Fixes/Refs line ahead of main, names the issue; blocked:REASON comes from `threads block` "
               f"or a comment starting `Blocked:` in the last {BLOCK_DAYS} days. Cloud routine runs are not a source: the "
               "CLI cannot read them.",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    def cmd(name, fn, help_):
        s = sub.add_parser(name, help=help_)
        s.set_defaults(fn=fn)
        s.add_argument("--by", default=default_actor(), help="who is acting (default $THREADS_ACTOR or $USER)")
        return s

    s = cmd("claim", cmd_claim, "hold an issue; refused when someone else holds it")
    s.add_argument("id")
    s.add_argument("--eta", type=int, help="minutes")
    s = cmd("release", cmd_release, "let go of an issue, or hand it --to someone")
    s.add_argument("id")
    s.add_argument("--to")
    s = cmd("need", cmd_need, "on GitHub: ID is blocked by OTHER")
    s.add_argument("id")
    s.add_argument("other")
    s = cmd("unneed", cmd_unneed, "on GitHub: remove ID's blocked-by OTHER")
    s.add_argument("id")
    s.add_argument("other")
    s = cmd("show", cmd_show, "issue title, state and blockers, with its owners, handoffs and runs")
    s.add_argument("id")
    cmd("ready", cmd_ready, "open issues with no open blocker and no owner")
    cmd("list", cmd_list, "held issues with owner, time on the clock, ETA and overdue flag")
    cmd("ingest", cmd_ingest, "record worker runs from worker-ledger rows on stdin")
    cmd("run-ids", cmd_run_ids, "agent ids already recorded (for worker-ledger)")
    s = cmd("unowned", cmd_unowned, "open smashcraft and wisp issues with an unchecked box: owner, block or UNOWNED, "
            "priority:now first")
    s = cmd("block", cmd_block, "record why an issue cannot be staffed now (shown by unowned); --clear removes it")
    s.add_argument("id")
    s.add_argument("reason", nargs="*")
    s.add_argument("--clear", action="store_true")
    s = cmd("summary", cmd_summary, "runs by category (or --group facets) and tier: success and minutes against ETA, "
            "and accepted flaws per reviewer Lens")
    s.add_argument("--since", help="only runs that ended on or after DATE")
    s.add_argument("--group", default="category", help=f"comma list of {', '.join(GROUPS)} (default category)")
    s = cmd("recommend", cmd_recommend,
            f"cheapest tier whose first-assignment runs reported Done with no later Follows: run (and landed when it "
            f"committed) at >= {BAR}% in the finest "
            f"cell holding a tier with >= {MIN_RUNS} runs, backing off {', '.join(BACKOFF)}; a pricier tier replaces the "
            f"cell's last recommendation only when it beats it by {MARGIN} points on >= {MIN_RUNS} runs each")
    s.add_argument("facets", help="brief facet lines, e.g. 'Category: tooling, Spec: measured, Scope: one-file'")
    s.add_argument("--since", help="only runs that ended on or after DATE")
    return p


def main(argv=None) -> int:
    a = parser().parse_args(argv)
    db = connect()
    try:
        a.fn(db, a)
    except Refused as e:
        print(f"threads: {e}", file=sys.stderr)
        return 1
    finally:
        db.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
