#!/usr/bin/env bash
set -euo pipefail
[[ $# -eq 1 ]] || exit 64
unit="${1%.service}.service"
state="${XDG_STATE_HOME:-$HOME/.local/state}/update-notify"
mkdir -p "$state"
stamp="$state/$unit"
now=$(date +%s)
last=0 id=0
[[ -r $stamp ]] && read -r last id <"$stamp" || true
(( now - last < 3600 )) && exit 0
if ! id=$(notify-send --print-id --replace-id="${id:-0}" --urgency=critical --expire-time=0 'Automatic update failed' "$unit failed. Inspect: journalctl --user -u $unit -b" 2>&1); then
  printf 'update-notify: no notification daemon; %s failed (%s)\n' "$unit" "$id" >&2
  exit 0
fi
printf '%s %s\n' "$now" "$id" >"$stamp"
