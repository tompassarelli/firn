#!/usr/bin/env bash
# spaces — CLI + daemon entry for the niri activity layer (tools/spaces).
# Live-checkout anchor required: ~/.local/bin serves this shim as a store
# snapshot, where self-relative paths resolve read-only.
d="$HOME/code/nixos-config/main/tools/spaces"
out="$d/build/spaces/main.clj"
if [ ! -f "$out" ] || [ "$d/src/spaces/main.bclj" -nt "$out" ]; then
  "$d/build.sh" >&2
fi
exec bb -cp "$d/build:$d/src" -m spaces.main "$@"
