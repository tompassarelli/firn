#!/usr/bin/env bash
# Firn keeps this stable command name; North owns the catalog, permission
# transition, activation generation, and every projection it reports.
# `plan` is local: it reads dotfiles/agents/orchestration.toml and the
# providers signed in now, and prints the bands sessions staff from.
# `routines` indexes every recurring job from dotfiles/agents/routines/.
# `org` prints and edits the chain of command; `lead start` opens a registered lead.
set -uo pipefail

north_bin="${AGENTS_NORTH_BIN:-north}"

usage() {
  printf 'usage: agents {status [--json]|stale [--json]|inspect <id> [--json]|path <id>|on <id>|off <id>|sync|plan [--mode split|claude-only|codex-only] [--posture efficiency|balanced|performance]|routines [list|show NAME|pointer NAME] [--crons FILE|-]|org [show|add|remove]|lead start}\n' >&2
}

plan() {
  "$(dirname "$(readlink -f "$0")")/update-status"
  local mode="" posture=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --mode) [ $# -ge 2 ] || { usage; exit 2; }; mode=$2; shift 2 ;;
      --posture) [ $# -ge 2 ] || { usage; exit 2; }; posture=$2; shift 2 ;;
      *) usage; exit 2 ;;
    esac
  done
  local config="${AGENTS_ORCHESTRATION:-$(dirname "$(readlink -f "$0")")/../agents/orchestration.toml}"
  AGENTS_PLAN_MODE="$mode" AGENTS_PLAN_POSTURE="$posture" AGENTS_PLAN_CONFIG="$config" \
    AGENTS_CLAUDE_BIN="${AGENTS_CLAUDE_BIN:-claude}" \
    AGENTS_CODEX_BIN="${AGENTS_CODEX_BIN:-codex}" \
    exec python3 -I -c '
import json, os, subprocess, sys, tomllib

POSTURES = ("efficiency", "balanced", "performance")

def die(msg):
    print(f"agents plan: {msg}", file=sys.stderr)
    sys.exit(2)

path = os.environ["AGENTS_PLAN_CONFIG"]
try:
    with open(path, "rb") as f:
        cfg = tomllib.load(f)
except (OSError, tomllib.TOMLDecodeError) as e:
    die(f"cannot read {path}: {e}")

tiers = cfg.get("tiers", {})
for ref, t in tiers.items():
    st = t.get("start")
    if ":" not in ref or "model" not in t or "effort" not in t or not (isinstance(st, list) and len(st) == 3):
        die(f"tier {ref!r} needs provider:name, model, effort and start = [efficiency, balanced, performance]")
providers = list(dict.fromkeys(ref.split(":")[0] for ref in tiers))

mode = os.environ["AGENTS_PLAN_MODE"] or cfg.get("mode", "split")
if mode == "split":
    wanted = providers
elif mode.endswith("-only") and mode[:-5] in providers:
    wanted = [mode[:-5]]
else:
    die(f"unknown mode {mode!r}; use split, " + ", ".join(p + "-only" for p in providers))

override = os.environ["AGENTS_PLAN_POSTURE"]
posture = override or cfg.get("posture", "balanced")
own = {p: cfg.get(p, {}).get("posture", posture) for p in providers}
if override:
    own = {p: override for p in providers}
for p in [posture, *own.values()]:
    if p not in POSTURES:
        die(f"unknown posture {p!r}; use " + ", ".join(POSTURES))

def run(cmd):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
        return r.returncode, r.stdout + r.stderr
    except (OSError, subprocess.TimeoutExpired):
        return None, ""

def signed_in(name):
    if name == "claude":
        code, out = run([os.environ["AGENTS_CLAUDE_BIN"], "auth", "status"])
        try:
            return code == 0 and json.loads(out).get("loggedIn") is True, "claude auth status"
        except ValueError:
            return False, "claude auth status"
    if name == "codex":
        code, out = run([os.environ["AGENTS_CODEX_BIN"], "login", "status"])
        return code == 0 and "Logged in" in out, "codex login status"
    return False, "no sign-in check for this provider"

head = f"mode: {mode}, posture: {posture}"
moved = [f"{p} {own[p]}" for p in providers if own[p] != posture and p in wanted]
print(head + (" (" + ", ".join(moved) + ")" if moved else ""))
usable = []
for name in providers:
    if name not in wanted:
        print(f"{name}: dropped, mode is {mode}")
        continue
    ok, how = signed_in(name)
    if ok:
        usable.append(name)
        print(f"{name}: signed in")
    else:
        print(f"{name}: dropped, not signed in ({how})")
if not usable:
    print("bands: none; recommend to Tom (no provider is usable)")
    sys.exit(1)

def bands_of(refs):
    out, floor = [], 0
    for i, r in enumerate(refs):
        lo = 0 if i == 0 else max(floor, tiers[r]["start"][POSTURES.index(own[r.split(":")[0]])])
        floor = lo
        out.append([lo, 100, r])
    for i in range(len(out) - 1):
        out[i][1] = out[i + 1][0]
    return [x for x in out if x[1] > x[0]]

def label(r):
    t = tiers[r]
    agent = f" ({t["agent"]})" if t.get("agent") else ""
    return f"{t["model"]} {t["effort"]}{agent}"

avail = [r for r in tiers if r.split(":")[0] in usable]
full = bands_of(list(tiers))

def resolve():
    out, pending = [], None
    for lo, hi, r in full:
        if r in avail:
            out.append([lo if pending is None else pending, hi, r])
            pending = None
        elif pending is None:
            pending = lo
    if pending is not None:
        out[-1][1] = 100
    return out

print("bands (difficulty percentile: start tier):")
for lo, hi, r in resolve():
    took = [f"{x[2]} {x[0]}-{x[1]}" for x in full if x[2] not in avail and x[0] < hi and x[1] > lo]
    note = f" (takes {", ".join(took)}: provider dropped)" if took else ""
    print(f"  {lo}-{hi} {tiers[r].get("role", r)}: {label(r)}{note}")
print("escalation: " + ", ".join(label(r) for r in avail) + ", then recommend to Tom")
'
}

case "${1:-}" in
  status|stale|inspect|path|on|off|sync) ;;
  plan)
    shift
    plan "$@"
    ;;
  routines)
    shift
    exec python3 -I "$(dirname "$(readlink -f "$0")")/../agents/lib/routines.py" "$@"
    ;;
  org|lead)
    exec python3 -I "$(dirname "$(readlink -f "$0")")/../agents/lib/org.py" "$@"
    ;;
  *)
    usage
    exit 2
    ;;
esac

if ! command -v -- "$north_bin" >/dev/null 2>&1; then
  printf 'agents: North CLI is unavailable: %s\n' "$north_bin" >&2
  exit 2
fi

if [ "${1:-}" = sync ]; then
  "$north_bin" config agents "$@" || exit
  "$(dirname "$(readlink -f "$0")")/effect-kit" scan
  exit 0
fi

exec "$north_bin" config agents "$@"
