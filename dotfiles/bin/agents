#!/usr/bin/env bash
# agents — context switchboard; `apply` is the ONLY writer of every injection surface.
set -euo pipefail

STATE="$HOME/.config/agents"
MANIFEST="$STATE/manifest.conf"
FRAGMENTS="${AGENTS_FRAGMENTS:-$HOME/code/nixos-config/main/dotfiles/agents/hooks.d}"
SETTINGS="$HOME/.claude/settings.json"
PLUGINS_JSON="$HOME/.claude/plugins/installed_plugins.json"
ORCH="$HOME/code/north/main/orchestration"
CLAUDE_AGENTS="$HOME/.claude/agents"

HOOKS=(agent-spawn-guard beagle-session-start comment-bloat-guard firn-guard
  git-blind-stage-guard hook-detach logcompress north-session-lifecycle
  tripwire-guard worktree-guard)
SKILLS=(webdev beagle-authoring fram-modeling code-as-facts firn)
SINGLETONS=(agents-md code-md statusline orchestration)

# Plugins are not a hand-written list: the install ledger is the inventory, so
# an install/uninstall done outside this script is picked up on the next run
# rather than rotting in an array here.
PLUGINS=(); PLUGIN_PATHS=(); PLUGINS_LOADED=

load_plugins() {
  if [ -n "$PLUGINS_LOADED" ]; then return 0; fi
  PLUGINS_LOADED=1
  local name path
  while IFS=$'\t' read -r name path; do
    PLUGINS+=("$name"); PLUGIN_PATHS+=("$path")
  done < <(python3 - "$PLUGINS_JSON" <<'PY'
import json, sys
try:
    data = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
for name, installs in sorted((data.get("plugins") or {}).items()):
    # Project-scoped installs are owned by that project's own config; the key
    # this switchboard writes (settings.json enabledPlugins) is user-global, so
    # governing a project plugin from here would enable it everywhere.
    for i in installs:
        if i.get("scope") == "user":
            print(f"{name}\t{i.get('installPath', '')}")
            break
PY
  )
}

plugin_install_path() {
  local i
  for i in "${!PLUGINS[@]}"; do
    if [ "${PLUGINS[$i]}" = "$1" ]; then echo "${PLUGIN_PATHS[$i]}"; return 0; fi
  done
  return 1
}

enabled_plugins_now() { # what settings.json already enables — the seed truth
  python3 - "$SETTINGS" <<'PY'
import json, sys
try:
    enabled = json.load(open(sys.argv[1])).get("enabledPlugins") or []
except Exception:
    enabled = []
if isinstance(enabled, dict):
    enabled = [k for k, v in enabled.items() if v]
print("\n".join(enabled))
PY
}

skill_source() {
  case "$1" in
    webdev)          echo "$HOME/code/north/main/agent-profile/skills/webdev" ;;
    beagle-authoring) echo "$HOME/code/beagle/main/integrations/north/skills/beagle-authoring" ;;
    fram-modeling)   echo "$HOME/code/fram/main/integrations/north/skills/fram-modeling" ;;
    code-as-facts)   echo "$HOME/code/fram/main/integrations/north/skills/code-as-facts" ;;
    firn)            echo "$HOME/code/nixos-config/main/modules/north-profile/firn/skills/firn" ;;
  esac
}

path_of() { # the canonical source file to view or edit for an item
  case "$1" in
    agents-md)  echo "$HOME/code/nixos-config/main/dotfiles/agents/AGENTS.md" ;;
    code-md)    echo "$HOME/code/nixos-config/main/dotfiles/code/CLAUDE.md" ;;
    statusline) echo "$HOME/code/nixos-config/main/dotfiles/claude/statusline.sh" ;;
    orchestration) echo "$ORCH/doctrine.md" ;;
    *)
      case " ${HOOKS[*]} " in *" $1 "*) echo "$FRAGMENTS/$1.json"; return ;; esac
      case " ${SKILLS[*]} " in *" $1 "*) echo "$(skill_source "$1")/SKILL.md"; return ;; esac
      load_plugins
      case " ${PLUGINS[*]} " in *" $1 "*) plugin_install_path "$1"; return ;; esac
      echo "agents: unknown item: $1" >&2; exit 2 ;;
  esac
}

ensure_manifest() {
  mkdir -p "$STATE" "$STATE/skills"
  [ -f "$MANIFEST" ] || : > "$MANIFEST"
  load_plugins
  # Merge, don't just seed: an entry added to the arrays after the manifest
  # exists must still appear (off) or it is invisible to status/flip forever.
  # Plugins seed from reality instead of off: settings.json already enables
  # some, and seeding those off would silently disable them on first apply.
  local enabled p k n
  enabled=" $(enabled_plugins_now | tr '\n' ' ')"
  # Field-exact presence, not a regex: plugin names are marketplace strings
  # (`@`, `.`, `+`) and would otherwise be read as patterns.
  local -A have=()
  while read -r k n _; do
    [ -n "${k:-}" ] && have["$k $n"]=1
  done < "$MANIFEST"
  { for s in "${SINGLETONS[@]}"; do echo "item $s off"; done
    for h in "${HOOKS[@]}"; do echo "hook $h off"; done
    for s in "${SKILLS[@]}"; do echo "skill $s off"; done
    for p in "${PLUGINS[@]}"; do
      case "$enabled" in *" $p "*) echo "plugin $p on" ;; *) echo "plugin $p off" ;; esac
    done
  } | while read -r kind name default; do
    [ -n "${have["$kind $name"]:-}" ] || echo "$kind $name $default" >> "$MANIFEST"
  done
}

state_of() { awk -v k="$1" -v n="$2" '$1==k && $2==n {print $3}' "$MANIFEST"; }

set_state() { # kind name state
  awk -v k="$1" -v n="$2" '$1==k && $2==n {f=1} END {exit !f}' "$MANIFEST" ||
    { echo "agents: unknown: $1 $2" >&2; exit 2; }
  local tmp="$MANIFEST.tmp.$$"
  awk -v k="$1" -v n="$2" -v s="$3" '{if ($1==k && $2==n) $3=s; print}' "$MANIFEST" > "$tmp"
  mv "$tmp" "$MANIFEST"
}

status() {
  ensure_manifest
  printf 'AGENTS.md            %s\n' "$(state_of item agents-md)"
  printf 'code CLAUDE.md       %s\n' "$(state_of item code-md)"
  printf 'statusline           %s\n' "$(state_of item statusline)"
  printf 'orchestration        %s\n' "$(state_of item orchestration)"
  echo "hooks"
  # One interpreter for all rows; a python3 start per hook made status crawl.
  python3 - "$FRAGMENTS" "$MANIFEST" <<'PY'
import json, os, sys
fragments_dir, manifest = sys.argv[1:]
states = {}
for line in open(manifest):
    parts = line.split()
    if len(parts) == 3 and parts[0] == "hook":
        states[parts[1]] = parts[2]
for name in sorted(states):
    try:
        frag = json.load(open(os.path.join(fragments_dir, f"{name}.json")))
        tags = " ".join(":" + t for t in frag.get("tags", []))
    except Exception:
        tags = ""
    print(f"  {name:<22} {states[name]:<4} {tags}")
PY
  echo "skills"
  for s in "${SKILLS[@]}"; do printf '  %-20s %s\n' "$s" "$(state_of skill "$s")"; done
  echo "plugins"
  local p
  for p in "${PLUGINS[@]}"; do printf '  %-40s %s\n' "$p" "$(state_of plugin "$p")"; done
}

apply() {
  ensure_manifest
  # AGENTS.md — global constitution: empty when off. One slot, every provider
  # surface: the claude config target, every account-scoped copy (the launcher
  # redirects CLAUDE_CONFIG_DIR, so account copies are what sessions actually
  # load), and the codex target that ~/.codex/AGENTS.md resolves to.
  # The World-1 slim profile is the source; north's profiles/tom/AGENTS.md is
  # the World-2 constitution and is loaded by lab sessions, not by this slot.
  local agents_target="$STATE/CLAUDE.md"
  local codex_target="$STATE/AGENTS.md"
  if [ "$(state_of item agents-md)" = on ]; then
    cat "$HOME/code/nixos-config/main/dotfiles/agents/AGENTS.md" > "$agents_target"
  else
    : > "$agents_target"
  fi
  cat "$agents_target" > "$codex_target"
  local acct
  for acct in "$HOME"/.local/state/north/accounts/*/*/CLAUDE.md; do
    [ -e "$acct" ] && cat "$agents_target" > "$acct"
  done
  # ~/code routing note — one slot, both provider surfaces: ~/code/CLAUDE.md
  # and ~/code/AGENTS.md resolve here, so off means neither provider picks up
  # routing instructions when entering ~/code.
  if [ "$(state_of item code-md)" = on ]; then
    cat "$HOME/code/nixos-config/main/dotfiles/code/CLAUDE.md" > "$STATE/code-CLAUDE.md"
  else
    : > "$STATE/code-CLAUDE.md"
  fi
  cat "$STATE/code-CLAUDE.md" > "$STATE/code-AGENTS.md"
  # skills — a farm of symlinks; only `on` skills exist
  local s src
  find "$STATE/skills" -maxdepth 1 -type l -delete
  for s in "${SKILLS[@]}"; do
    if [ "$(state_of skill "$s")" = on ]; then
      src="$(skill_source "$s")"
      [ -d "$src" ] && ln -sfn "$src" "$STATE/skills/$s"
    fi
  done
  # orchestration — one switch, two surfaces: the doctrine skill (skills farm,
  # so it must be linked after the sweep above) and the role templates Claude
  # Code loads as subagents. Both are live symlinks into north: editing a
  # template there is immediately live, no frozen copies to drift.
  local link tgt tpl
  if [ -d "$CLAUDE_AGENTS" ]; then
    # Sweep only what this switchboard owns. ~/.claude/agents is a user-visible
    # directory; hand-written agents there must survive an off.
    for link in "$CLAUDE_AGENTS"/*; do
      [ -L "$link" ] || continue
      tgt="$(readlink "$link")"
      case "$tgt" in "$ORCH"/*) rm -f "$link" ;; esac
    done
  fi
  if [ "$(state_of item orchestration)" = on ]; then
    [ -d "$ORCH/skill" ] && ln -sfn "$ORCH/skill" "$STATE/skills/orchestration"
    if [ -d "$ORCH/agents" ]; then
      mkdir -p "$CLAUDE_AGENTS"
      for tpl in "$ORCH"/agents/*.md; do
        [ -e "$tpl" ] && ln -sfn "$tpl" "$CLAUDE_AGENTS/$(basename "$tpl")"
      done
    fi
  fi
  # hooks + statusline + plugins — rewrite exactly those keys in live settings.json
  local on_hooks=()
  for s in "${HOOKS[@]}"; do
    [ "$(state_of hook "$s")" = on ] && on_hooks+=("$s")
  done
  local on_plugins=() p
  for p in "${PLUGINS[@]}"; do
    [ "$(state_of plugin "$p")" = on ] && on_plugins+=("$p")
  done
  STATUSLINE_STATE="$(state_of item statusline)" \
  ON_PLUGINS="$(printf '%s\n' ${on_plugins[@]+"${on_plugins[@]}"})" \
  python3 - "$SETTINGS" "$FRAGMENTS" "${on_hooks[@]}" <<'PY'
import json, os, sys
settings_path, fragments_dir, *names = sys.argv[1:]
settings = json.load(open(settings_path))
hooks = {}
for name in names:
    frag = json.load(open(os.path.join(fragments_dir, f"{name}.json")))
    for entry in frag["entries"]:
        matchers = hooks.setdefault(entry["event"], [])
        for m in matchers:
            if m.get("matcher") == entry["matcher"]:
                m["hooks"].append(entry["hook"]); break
        else:
            block = {"hooks": [entry["hook"]]}
            if entry["matcher"] is not None: block["matcher"] = entry["matcher"]
            matchers.append(block)
settings["hooks"] = hooks
settings["enabledPlugins"] = [p for p in os.environ["ON_PLUGINS"].split("\n") if p]
if os.environ["STATUSLINE_STATE"] == "on":
    settings["statusLine"] = {"type": "command",
      "command": 'bash "$HOME/code/nixos-config/dotfiles/claude/statusline.sh"'}
else:
    settings.pop("statusLine", None)
tmp = settings_path + ".next"
json.dump(settings, open(tmp, "w"), indent=2)
os.replace(tmp, settings_path)
PY
  echo "applied: $(state_of item agents-md) AGENTS.md, ${#on_hooks[@]} hooks, $(find "$STATE/skills" -maxdepth 1 -type l | wc -l) skills, ${#on_plugins[@]} plugins, orchestration $(state_of item orchestration)"
}

flip() { # on|off [--all | kind? name]
  local target_state="$1"; shift
  ensure_manifest
  if [ "${1:-}" = "--all" ]; then
    local tmp="$MANIFEST.tmp.$$"
    awk -v s="$target_state" '{$3=s; print}' "$MANIFEST" > "$tmp"; mv "$tmp" "$MANIFEST"
  else
    local name="${1:?agents: name required}"
    case " ${SKILLS[*]} " in *" $name "*)
      set_state skill "$name" "$target_state"; apply; return ;;
    esac
    case " ${SINGLETONS[*]} " in *" $name "*)
      set_state item "$name" "$target_state"; apply; return ;;
    esac
    case " ${PLUGINS[*]} " in *" $name "*)
      set_state plugin "$name" "$target_state"; apply; return ;;
    esac
    # Hook or :tag — resolve requires-closure: `on` pulls requirements in,
    # `off` cascades out through dependents.
    local resolved h
    resolved="$(python3 - "$FRAGMENTS" "$target_state" "$name" <<'PY'
import json, os, sys, glob
frag_dir, op, sel = sys.argv[1:]
frags = {os.path.basename(p)[:-5]: json.load(open(p))
         for p in glob.glob(os.path.join(frag_dir, "*.json"))}
if sel.startswith(":"):
    seeds = {n for n, d in frags.items() if sel[1:] in d.get("tags", [])}
    if not seeds: sys.exit(f"agents: no hooks tagged {sel}")
elif sel in frags:
    seeds = {sel}
else:
    sys.exit(f"agents: unknown hook or tag: {sel}")
result = set(seeds)
changed = True
while changed:
    changed = False
    for n, d in frags.items():
        if op == "on" and n in result:
            for req in d.get("requires", []):
                if req not in result: result.add(req); changed = True
        if op == "off" and n not in result:
            if any(r in result for r in d.get("requires", [])):
                result.add(n); changed = True
print("\n".join(sorted(result)))
PY
)" || { echo "$resolved" >&2; exit 2; }
    for h in $resolved; do set_state hook "$h" "$target_state"; done
  fi
  apply
}

case "${1:-status}" in
  status) status ;;
  on)  shift; flip on "$@"; ;;
  off) shift; flip off "$@" ;;
  apply) apply ;;
  path) shift; path_of "${1:?agents: path requires a name}" ;;
  *) echo "usage: agents [status] | on|off <name>|--all | path <name> | apply" >&2; exit 2 ;;
esac
