#!/usr/bin/env bash
# agents — context switchboard; `apply` is the ONLY writer of every injection surface.
set -euo pipefail

STATE="$HOME/.config/agents"
MANIFEST="$STATE/manifest.conf"
FRAGMENTS="${AGENTS_FRAGMENTS:-$HOME/code/nixos-config/main/dotfiles/agents/hooks.d}"
SETTINGS="$HOME/.claude/settings.json"
PLUGINS_JSON="$HOME/.claude/plugins/installed_plugins.json"
ORCH="$HOME/code/north/main/orchestration"
CLAUDE_AGENTS="$HOME/.claude/agents"
# Codex reads skills from its own directory, so a skill governed only in the
# claude farm is a skill Codex loads on rules nobody set. This directory is NOT
# ours the way the farm is: Codex ships `.system/` here (its vendor-managed
# built-ins, marked with .codex-system-skills.marker) and a user may keep real
# skill directories alongside. Everything below treats it as someone else's
# space that we place links into.
CODEX_SKILLS="$HOME/.codex/skills"
# Which directories have a context file is user data, so the inventory lives in
# north-data; this switchboard only decides whether each one has content.
CONTEXT_REGISTRY="$HOME/code/north-data/context-dirs.conf"
CONTEXT_SOURCES="$HOME/code/north-data/context-dirs"
DIR_TARGETS="$STATE/dir"
# Per-project MEMORY lives in each account's Claude state, one directory per
# project: a .md per fact, plus MEMORY.md — the INDEX the binary auto-loads at
# session start. The index is the only thing this switchboard writes there. A
# memory's content file is the model's and is never written, moved or deleted
# here; governing memory means governing what the index lists.
ACCOUNTS="$HOME/.local/state/north/accounts"
# The index line ("- [Title](file.md) — hook") is the model's words, and
# MEMORY.md is the only place they exist. Filtering a memory out of the index
# would destroy that text, so the last line seen for every memory is kept here
# and put back when the memory is turned on again. Derived, never authoritative:
# a memory whose file is gone loses its entry on the next apply.
MEM_INDEX_CACHE="$STATE/mem-index"

HOOKS=(agent-spawn-guard beagle-session-start comment-bloat-guard firn-guard
  git-blind-stage-guard hook-detach logcompress north-session-lifecycle
  tripwire-guard worktree-guard)
SKILLS=(webdev beagle-authoring fram-modeling code-as-facts firn repo-safety
  orchestration)
# A MODULE is a skill with declarations — a skill whose frontmatter names the
# hooks its rules need (`hooks:`) or a directory of agent templates it ships
# (`agents:`). It is not a kind: a module's name IS a skill's name, always, so
# there is nothing to drift. Orchestration is the case that proves it — doctrine
# skill, its spawn guard and its role templates, all declared in the one file
# that ships them, with no special case anywhere in this script.
#
# A MODULE SET is the other thing, and the only distinctly-named one: a row that
# names units it composes, in modules.d/<name>.json as
# `{"members": ["<unit-name>", ...]}`. Members are bare names of ANY kind —
# including other sets, which is how a bundle is built out of bundles. Sets are
# discovered from the directory, so writing a file is the whole act of adding
# one, and this array starts empty.
MODULES=()
MODULES_D="${AGENTS_MODULES:-$HOME/code/nixos-config/main/dotfiles/agents/modules.d}"
MODULES_LOADED=

# A module may also own INSTRUCTIONS: `"instructions": "<abs-path>"`, a file
# appended to the global surfaces while the module is active. That is what
# makes a module the equivalent of a plugin for code you own — context, skills
# and hooks arriving together, live from the working tree, with no version to
# pin and no copy to drift.
declare -A MODULE_INSTRUCTIONS=()
MODULE_INSTRUCTION_ORDER=()

load_modules() {
  if [ -n "$MODULES_LOADED" ]; then return 0; fi
  MODULES_LOADED=1
  local n f
  # Filename order, and nothing cleverer: two modules that both append must land
  # in the same order on every machine and every run, or the surfaces churn.
  while IFS=$'\t' read -r n f; do
    [ -n "${n:-}" ] || continue
    case " ${MODULES[*]} " in *" $n "*) ;; *) MODULES+=("$n") ;; esac
    if [ -n "${f:-}" ]; then
      MODULE_INSTRUCTIONS["$n"]="$f"; MODULE_INSTRUCTION_ORDER+=("$n")
    fi
  done < <(python3 - "$MODULES_D" <<'PY'
import glob, json, os, sys
for p in sorted(glob.glob(os.path.join(sys.argv[1], "*.json"))):
    try:
        ins = (json.load(open(p)).get("instructions") or "").strip()
    except Exception:
        ins = ""  # activity() is where an unreadable module file is reported
    print(f"{os.path.basename(p)[:-5]}\t{ins}")
PY
  )
}
# `other` is the honest triage drawer, not a kind with a story: a single toggle
# whose activation reason is not a directory, a skill, a hook, a module, or a
# plugin. A row here is a row nobody has found the right kind for yet.
OTHERS=(statusline-script)
# A `dir` row is a directory instruction file: it fires for that directory and
# everything under it. The global profile is that same thing scoped at the
# root — `~`, the tree that contains every other — which is why it is built in
# rather than registry-backed, and why it reads first.
# It writes the global surfaces (the config-dir pair and the account copies) and
# never a per-directory target or a link at a directory.
GLOBAL_SLUG=global
GLOBAL_DIR="~"

# Plugins are not a hand-written list: the install ledger is the inventory, so
# an install/uninstall done outside this script is picked up on the next run
# rather than rotting in an array here.
PLUGINS=(); PLUGIN_PATHS=(); PLUGINS_LOADED=

load_plugins() {
  if [ -n "$PLUGINS_LOADED" ]; then return 0; fi
  PLUGINS_LOADED=1
  local name path
  while IFS=$'\t' read -r name path; do
    PLUGINS+=("$name"); PLUGIN_PATHS+=("$path")
  done < <(python3 - "$PLUGINS_JSON" <<'PY'
import json, sys
try:
    data = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
for name, installs in sorted((data.get("plugins") or {}).items()):
    # Project-scoped installs are owned by that project's own config; the key
    # this switchboard writes (settings.json enabledPlugins) is user-global, so
    # governing a project plugin from here would enable it everywhere.
    for i in installs:
        if i.get("scope") == "user":
            print(f"{name}\t{i.get('installPath', '')}")
            break
PY
  )
}

DIRS=(); DIR_PATHS=(); DIRS_LOADED=

load_dirs() { # the registry is the inventory, same shape as the plugin ledger
  if [ -n "$DIRS_LOADED" ]; then return 0; fi
  DIRS_LOADED=1
  [ -f "$CONTEXT_REGISTRY" ] || return 0
  local d s
  # `|| [ -n "$d" ]` — a registry saved without a trailing newline still counts.
  while read -r d s _ || [ -n "${d:-}" ]; do
    case "${d:-}" in ''|'#'*) continue ;; esac
    [ -n "${s:-}" ] || { echo "agents: $CONTEXT_REGISTRY: no slug for $d" >&2; continue; }
    DIRS+=("$s"); DIR_PATHS+=("$d")
  done < "$CONTEXT_REGISTRY"
}

dir_source() { echo "$CONTEXT_SOURCES/$1.md"; }

dir_rows() { # slug<TAB>directory for every dir row, the root first
  # One iteration for the whole subtree family: seeding, status and apply must
  # walk the same directories in the same order, and the global row is a dir row
  # at `~` rather than a special case with its own loop.
  local i
  printf '%s\t%s\n' "$GLOBAL_SLUG" "$GLOBAL_DIR"
  load_dirs
  for i in ${DIRS[@]+"${!DIRS[@]}"}; do
    printf '%s\t%s\n' "${DIRS[$i]}" "${DIR_PATHS[$i]}"
  done
}

dir_path_of() { # slug -> the directory that row gates
  local i
  if [ "$1" = "$GLOBAL_SLUG" ]; then echo "$GLOBAL_DIR"; return 0; fi
  load_dirs
  for i in ${DIRS[@]+"${!DIRS[@]}"}; do
    if [ "${DIRS[$i]}" = "$1" ]; then echo "${DIR_PATHS[$i]}"; return 0; fi
  done
  return 1
}

project_slug() { # <directory> -> the projects/<name> directory holding its memory
  # Claude Code names a project's state directory after the path with the
  # separators turned into dashes: /home/tom/code -> -home-tom-code. The global
  # row's scope is `~`, which is $HOME, and slugs the same way.
  local p="$1"
  if [ "$p" = "$GLOBAL_DIR" ]; then p="$HOME"; fi
  echo "${p//\//-}"
}

mem_dirs() { # <directory> -> every account's memory directory for that project
  # Every account keeps its own copy of a project's memories, so a scope has as
  # many memory directories as there are accounts that have opened it. None is
  # not an error: a directory nobody has stored a memory for simply has no
  # memory rows.
  local proj md
  proj="$(project_slug "$1")"
  for md in "$ACCOUNTS"/*/*/projects/"$proj"/memory; do
    if [ -d "$md" ]; then echo "$md"; fi
  done
}

mem_names() { # <directory> -> the memory FILES governed for that scope
  # Union by name across accounts: the same fact carries the same filename in
  # every account that has it, so one row governs it everywhere and an account
  # that lacks it is simply not written.
  local md f b
  while IFS= read -r md; do
    for f in "$md"/*.md; do
      [ -f "$f" ] || continue
      b="${f##*/}"
      # The index is not a memory; it is what this switchboard composes.
      if [ "$b" = MEMORY.md ]; then continue; fi
      # The manifest is whitespace-delimited, so a name with a space in it has
      # no row it could live on. Say so, and leave the file alone.
      case "$b" in *[[:space:]]*)
        echo "agents: memory $f: name contains whitespace — not governable" >&2
        continue ;;
      esac
      # A directory's own rows are addressed as `<slug>/AGENTS.md` and
      # `<slug>/memories`, so those two names are spoken for: a memory file
      # called either has no address of its own. Ungoverned is not unread —
      # apply leaves such a file's index line exactly where it found it.
      case "$b" in AGENTS.md|memories)
        echo "agents: memory $f: \`$b\` is how a directory's own row is" \
          "addressed — this memory is left ungoverned" >&2
        continue ;;
      esac
      echo "$b"
    done
  done < <(mem_dirs "$1") | sort -u
}

declare -A MEM_NAMES=()
MEMS_LOADED=

load_mems() { # the memory inventory, scanned like the plugin ledger
  # Dynamic on purpose: a memory the model wrote between two runs is governable
  # on the next one, without anybody registering it. Nothing is written back —
  # the files are the inventory, the manifest only holds the switches.
  if [ -n "$MEMS_LOADED" ]; then return 0; fi
  MEMS_LOADED=1
  local slug ddir
  while IFS=$'\t' read -r slug ddir; do
    MEM_NAMES["$slug"]="$(mem_names "$ddir")"
  done < <(dir_rows)
}

# A hook may name ONE companion unit in its fragment (`"follows": "<name>"`,
# same metadata level as tags/requires). Hooks are enforcement; the unit is the
# thing whose activation makes that enforcement wanted, so a supporting hook
# follows it instead of being flipped by hand. The companion is named bare and
# may be ANY unit that speaks on/off — a skill, a directory scope, a module —
# because what makes a guard wanted is not always a skill. A hook with no
# companion is infrastructure and answers only to a direct flip.
declare -A HOOK_FOLLOWS=()
HOOK_FOLLOWS_LOADED=

load_hook_follows() {
  if [ -n "$HOOK_FOLLOWS_LOADED" ]; then return 0; fi
  HOOK_FOLLOWS_LOADED=1
  local h s
  while IFS=$'\t' read -r h s; do
    [ -n "${h:-}" ] && HOOK_FOLLOWS["$h"]="$s"
  done < <(python3 - "$FRAGMENTS" <<'PY'
import glob, json, os, sys
for p in sorted(glob.glob(os.path.join(sys.argv[1], "*.json"))):
    try:
        follows = (json.load(open(p)).get("follows") or "").strip()
    except Exception as exc:
        print(f"agents: {p}: unreadable ({exc})", file=sys.stderr)
        continue
    if follows:
        print(f"{os.path.basename(p)[:-5]}\t{follows}")
PY
  )
}

activity() { # kind|name|own|active|reason|follows|tags — every unit, one line
  # `|` and not a tab: read splits on runs of IFS WHITESPACE, so a unit with no
  # companion (empty field) would shift every field after it left.
  # ONE derivation, read by both status and apply, because activity is computed
  # and never stored. Two axes: the OWN SWITCH is the user's and lives in the
  # manifest (`enabled`/`disabled` for a hook, `on`/`off` for everything else);
  # ACTIVITY is what that adds up to right now, and it is
  #
  #   own switch  AND  (in no module  OR  some containing module is active)
  #                 AND every GATE above it in its directory subtree
  #
  # with a hook additionally following its companion. A `dir` row is that gate:
  # it governs the whole subtree scoped at its directory, so the instruction
  # file (`ins`), the memories group (`memroot`) and each memory (`mem`) are all
  # ANDed with it — and `mem` with `memroot` too. Gates are AND where modules are
  # UNION, because a gate is containment in a place and a module is one of
  # several parties that may want a unit. UNION over containing
  # modules is deliberate: a unit two bundles both want survives one of them
  # being turned off, because the other still wants it. The rule recurses —
  # a module is gated by the modules that contain IT — so a bundle of bundles
  # composes without a second mechanism. Nothing here is written back, so the
  # manifest cannot disagree with itself.
  # Skill-side claims ride in on the environment rather than being re-read here:
  # they come from files this script already knows how to find, and the
  # derivation stays one python block with one input format.
  load_skill_hooks
  local cs ch claims=""
  for cs in "${SKILLS[@]}"; do
    for ch in ${SKILL_HOOKS[$cs]:-}; do claims+="$ch"$'\t'"$cs"$'\n'; done
  done
  AGENTS_CLAIMS="$claims" python3 - "$FRAGMENTS" "$MANIFEST" "$MODULES_D" <<'PY'
import glob, json, os, sys
frag_dir, manifest, modules_dir = sys.argv[1:]
frags = {}
for p in sorted(glob.glob(os.path.join(frag_dir, "*.json"))):
    try:
        frags[os.path.basename(p)[:-5]] = json.load(open(p))
    except Exception as exc:
        print(f"agents: {p}: unreadable ({exc}) — hook skipped", file=sys.stderr)
members = {}
for p in sorted(glob.glob(os.path.join(modules_dir, "*.json"))):
    n = os.path.basename(p)[:-5]
    try:
        members[n] = [str(m).strip() for m in (json.load(open(p)).get("members") or [])
                      if str(m).strip()]
    except Exception as exc:
        # A module whose list cannot be read composes nothing rather than
        # guessing: its own payload, if it has one, still answers to its switch.
        print(f"agents: {p}: unreadable ({exc}) — {n} composes no members",
              file=sys.stderr)
        members[n] = []

# Three kinds are namespaced under a directory slug, so their names are not
# unique on their own: `ins code`, `memroot code` and the `dir code` they hang
# under would all be "code". They are keyed by kind here (and reported that way,
# so bash keeps ONE lookup table), which also keeps them out of the bare-name
# namespace a companion or a module member is written in.
QUALIFIED = ("ins", "memroot", "mem")

def keyof(k, n):
    return f"{k}:{n}" if k in QUALIFIED else n

kind, own, rows = {}, {}, []
for line in open(manifest):
    parts = line.split()
    if len(parts) < 3:
        continue
    key = keyof(parts[0], parts[1])
    kind[key] = parts[0]
    own[key] = parts[2]
    rows.append((parts[0], parts[1], key))

# The gates above a row, nearest first. A directory row gates its own subtree;
# nothing gates a directory row but the modules that contain it.
gates = {}
for k, n, key in rows:
    if k in ("ins", "memroot"):
        gates[key] = [n]
    elif k == "mem":
        gates[key] = ["memroot:" + n.split("/", 1)[0], n.split("/", 1)[0]]

# Containment inverted: for a unit, which modules claim it. Sorted, so a unit
# in two bundles always blames the same one when both are off.
container = {}
for m in sorted(members):
    for u in members[m]:
        container.setdefault(u, []).append(m)
        if u not in own:
            print(f"agents: module {m} lists {u}, which is no unit — ignored",
                  file=sys.stderr)
for u in container:
    container[u].sort()

# Mutual containment has no answer — each module would be waiting on the other
# — so it is named and every module in it derives inactive. Fail loud, not
# forever: the alternative is a recursion that never bottoms out.
GREY = 1
color, in_cycle = {}, set()

def visit(m, stack):
    color[m] = GREY
    stack.append(m)
    for c in container.get(m, []):
        if c not in members:
            continue
        if color.get(c) == GREY:
            cyc = stack[stack.index(c):]
            in_cycle.update(cyc)
            print("agents: module cycle: " + " -> ".join(cyc + [cyc[0]])
                  + " — every module in it derives inactive", file=sys.stderr)
        elif c not in color:
            visit(c, stack)
    stack.pop()
    color[m] = 2

for m in sorted(members):
    if m not in color:
        visit(m, [])

def own_on(u):
    return own.get(u) == ("enabled" if kind.get(u) == "hook" else "on")

gated = {}

def gate_open(g): # a gate whose row is gone gates nothing open
    return g in own and gated_active(g)

def gated_active(u): # own switch, gated by its subtree gates and its modules
    if u in gated:
        return gated[u]
    gated[u] = False
    if u in in_cycle:
        return False
    ok = own_on(u)
    if ok:
        ok = all(gate_open(g) for g in gates.get(u, []))
    cs = container.get(u, [])
    if ok and cs:
        ok = any(gated_active(c) for c in cs)
    gated[u] = ok
    return ok

def off_ancestor(u, seen=None): # the nearest thing up the chain that is itself off
    seen = set() if seen is None else seen
    # Gates before modules: the gate is the closer container, and it is the row
    # sitting directly above this one in the directory the reader is looking at.
    for g in gates.get(u, []):
        if g in seen:
            continue
        seen.add(g)
        if g not in own:
            return g
        if not gated_active(g):
            if not own_on(g):
                return g
            a = off_ancestor(g, seen)
            if a:
                return a
    for c in container.get(u, []):
        if c in seen:
            continue
        seen.add(c)
        if c in in_cycle:
            return c
        if not gated_active(c):
            if not own_on(c):
                return c
            a = off_ancestor(c, seen)
            if a:
                return a
    return ""

def label(u): # what a reader calls this row — how status renders it, not its key
    # KIND-PREFIXED, because a bare name in a hook's parenthetical reads as
    # another hook: `(skill: firn off)` says which switchboard row to go flip.
    # The rows nested under a directory say what they are already.
    k = kind.get(u, "")
    if k == "ins":
        return "AGENTS.md"
    if k == "memroot":
        return "memories"
    if k == "mem":
        return u.split(":", 1)[1].split("/", 1)[1]
    return f"{k}: {u}" if k else u

def blame(u): # why this unit is not active, in the words of the nearest cause
    if u in in_cycle:
        return "module cycle"
    a = off_ancestor(u)
    return f"{label(a)} off" if a else ""

companion = {n: (d.get("follows") or "").strip() for n, d in frags.items()}
# Who wants each hook: the unit its fragment follows, then the skills whose
# frontmatter claims it. Deduped and order-stable, because this list is also the
# provenance status prints — a hook must always blame the same row twice running.
claims = {}
for row in os.environ.get("AGENTS_CLAIMS", "").split("\n"):
    if not row:
        continue
    h, _, s = row.partition("\t")
    claims.setdefault(h, [])
    if s and s not in claims[h]:
        claims[h].append(s)
for h in claims:
    claims[h].sort()
enabled = {n for n in frags if own.get(n) == "enabled"}
requires = {n: [r for r in frags[n].get("requires", [])] for n in frags}

# A chain is composed whole or not at all: a hook whose requirement the user
# disabled cannot do its job, so it drops out loudly rather than running half
# armed. Blockage is transitive — a dependent of a dropped hook is dropped too.
blocked, why = {}, {}
changed = True
while changed:
    changed = False
    for n in frags:
        if n in blocked:
            continue
        for r in requires[n]:
            if r not in enabled or r in blocked:
                blocked[n] = True
                why[n] = r
                changed = True
                break

def claimant_active(c):
    # A hook is nobody's claimant: it speaks permission, not on/off, and
    # hook-needs-hook is what `requires` is for.
    if kind.get(c) == "hook":
        return False
    return gated_active(c)

def claimants(n): # every unit that wants this hook, nearest statement first
    cs = []
    s = companion.get(n) or ""
    if s:
        cs.append(s)
    for c in claims.get(n, []):
        if c not in cs:
            cs.append(c)
    return cs

def wanted(n): # UNION: one active claimant is enough, and none means unbound
    cs = claimants(n)
    return not cs or any(claimant_active(c) for c in cs)

def eligible(n):
    return n in enabled and n not in blocked and gated_active(n) and wanted(n)

# Requirements ride in on their dependent: an enabled requirement is composed
# because something active needs it, even when its own companion is off.
composed, pulled_by = {n for n in frags if eligible(n)}, {}
changed = True
while changed:
    changed = False
    for n in list(composed):
        for r in requires[n]:
            if r not in composed:
                composed.add(r)
                pulled_by[r] = n
                changed = True

for n in sorted(frags):
    p = own.get(n, "disabled")
    cs = claimants(n)
    if n in composed:
        reason = f"required by {pulled_by[n]}" if n in pulled_by and not eligible(n) else ""
    elif p != "enabled":
        reason = ""
    elif n in blocked:
        reason = f"needs {why[n]}, disabled"
        print(f"agents: {n} is enabled but requires {why[n]}, which is disabled"
              " — not composed", file=sys.stderr)
    elif not gated_active(n):
        # The bundle this hook came in with is off — coarser than the companion
        # and the thing to flip first, so it is named first.
        reason = blame(n)
    elif not wanted(n):
        # Name what the reader can act on: a claimant held off by a bundle
        # blames the bundle, not itself, or the row above would read `on`. Every
        # claimant is named, because turning any ONE of them on is the fix.
        reason = ", ".join(w for w in
                           (("" if own_on(c) else f"{label(c)} off") or blame(c)
                            for c in cs) if w)
    else:
        reason = ""
    tags = " ".join(":" + t for t in frags[n].get("tags", []))
    print("|".join(["hook", n, p, "1" if n in composed else "0", reason,
                    ", ".join(label(c) for c in cs), tags]))

for k, n, key in rows:
    if k == "hook":
        continue
    a = gated_active(key)
    print("|".join([k, key, own[key], "1" if a else "0",
                    "" if a or not own_on(key) else blame(key), "", ""]))
PY
}

declare -A ACT_STATE=() ACT_ACTIVE=() ACT_REASON=() ACT_FOLLOWS=() ACT_TAGS=()
ACT_HOOKS=()

load_activity() { # the derivation, once, into name-keyed lookups
  # Name-keyed and not kind-keyed on purpose: a companion and a member are both
  # bare names, so this is the same namespace ensure_manifest polices.
  ACT_STATE=(); ACT_ACTIVE=(); ACT_REASON=(); ACT_FOLLOWS=(); ACT_TAGS=(); ACT_HOOKS=()
  local k n st a r f t
  while IFS='|' read -r k n st a r f t; do
    [ -n "${n:-}" ] || continue
    ACT_STATE["$n"]="$st"; ACT_ACTIVE["$n"]="$a"; ACT_REASON["$n"]="$r"
    ACT_FOLLOWS["$n"]="$f"; ACT_TAGS["$n"]="$t"
    # `if`, not `&&`: a non-hook last row would make the loop — and so this
    # function — exit non-zero under `set -e`.
    if [ "$k" = hook ]; then ACT_HOOKS+=("$n"); fi
  done < <(activity)
}

is_active() { [ "${ACT_ACTIVE[$1]:-0}" = 1 ]; }

on_off() { is_active "$1" && echo on || echo off; }

unit_line() { # the state column for a non-hook row: both axes, when they differ
  local n="$1"
  if [ "${ACT_STATE[$n]:-}" = on ] && ! is_active "$n"; then
    if [ -n "${ACT_REASON[$n]:-}" ]; then echo "on · off (${ACT_REASON[$n]})"
    else echo "on · off"; fi
  else
    echo "${ACT_STATE[$n]:-}"
  fi
}

copy_surface() { # src dst — dst is ours, and must be a real file
  # A symlink AT dst can resolve back to src: an old account copy pointed at
  # ~/.claude/CLAUDE.md, which points here, so `> dst` truncated the master
  # before `cat` could read it and the profile was zeroed on every apply. A
  # copy that is a link is also not a copy — per-account isolation is the whole
  # point of the account files — so the link is removed, not followed.
  if [ -L "$2" ]; then rm -f "$2"; fi
  cat "$1" > "$2" || echo "agents: could not write $2" >&2
  return 0
}

dir_target_base() { # the <base>-CLAUDE.md / <base>-AGENTS.md stem a slug writes
  case "$1" in
    # Compat exception, not a pattern: ~/code/{CLAUDE,AGENTS}.md are
    # home-manager links to these exact paths. Moving them under dir/ would
    # leave the live links dangling until the next rebuild.
    code) echo "$STATE/code" ;;
    *)    echo "$DIR_TARGETS/$1" ;;
  esac
}

link_dir_context() { # dir base — the two provider links AT the directory itself
  # `apply` owns the target files; the links at <dir> are usually someone
  # else's (home-manager writes ~/code's). Create only what is missing, and
  # never clobber a file already sitting there — a real CLAUDE.md at a
  # registered directory is the user's, and overwriting it is unrecoverable.
  local ddir="$1" base="$2" provider link want
  [ -d "$ddir" ] || { echo "agents: $ddir does not exist — no links made" >&2; return 0; }
  for provider in CLAUDE AGENTS; do
    link="$ddir/$provider.md"; want="$base-$provider.md"
    if [ -e "$link" ] || [ -L "$link" ]; then
      # Already ours counts even through an indirection (home-manager points
      # ~/code's links at a store path that points back here).
      if [ "$(readlink -f "$link" 2>/dev/null)" = "$(readlink -f "$want")" ]; then continue; fi
      echo "agents: $link is not this switchboard's — left alone" >&2
      continue
    fi
    ln -s "$want" "$link"
  done
}

sweep_codex_skills() { # remove ONLY the links this switchboard writes
  # Ownership is proven, not assumed: a link counts as ours when its name is one
  # we govern and it points exactly where we would have pointed it. Nothing
  # else is touched — not `.system` (Codex's own, and a real directory anyway),
  # not a hand-written skill directory, not a symlink somebody else placed.
  # A blanket sweep here would delete a user's work on the first `agents off`.
  local link src tgt
  [ -d "$CODEX_SKILLS" ] || return 0
  for link in "$CODEX_SKILLS"/*; do
    [ -L "$link" ] || continue
    src="$(skill_source "$(basename "$link")")"
    [ -n "$src" ] || continue
    tgt="$(readlink "$link")"
    if [ "$tgt" = "$src" ]; then rm -f "$link"; fi
  done
}

link_codex_skill() { # name source
  # Created only when there is something to put in it, and never replaced: if
  # that path is a real file, or cannot be made, this item degrades to a warning
  # like every other item in apply.
  [ -e "$CODEX_SKILLS" ] || mkdir -p "$CODEX_SKILLS" 2>/dev/null || true
  if [ ! -d "$CODEX_SKILLS" ]; then
    echo "agents: $CODEX_SKILLS is not a directory — $1 not linked for codex" >&2
    return 0
  fi
  ln -sfn "$2" "$CODEX_SKILLS/$1" ||
    echo "agents: could not link $1 into $CODEX_SKILLS" >&2
  return 0
}

plugin_install_path() {
  local i
  for i in "${!PLUGINS[@]}"; do
    if [ "${PLUGINS[$i]}" = "$1" ]; then echo "${PLUGIN_PATHS[$i]}"; return 0; fi
  done
  return 1
}

enabled_plugins_now() { # what settings.json already enables — the seed truth
  python3 - "$SETTINGS" <<'PY'
import json, sys
try:
    enabled = json.load(open(sys.argv[1])).get("enabledPlugins") or []
except Exception:
    enabled = []
# Both shapes are read: the record Claude Code writes today, and the array an
# older file (or an older version of this script) left behind.
if isinstance(enabled, dict):
    enabled = [k for k, v in enabled.items() if v]
print("\n".join(enabled))
PY
}

skill_source() {
  case "$1" in
    webdev)          echo "$HOME/code/north/main/agent-profile/skills/webdev" ;;
    beagle-authoring) echo "$HOME/code/beagle/main/integrations/north/skills/beagle-authoring" ;;
    fram-modeling)   echo "$HOME/code/fram/main/integrations/north/skills/fram-modeling" ;;
    code-as-facts)   echo "$HOME/code/fram/main/integrations/north/skills/code-as-facts" ;;
    firn)            echo "$HOME/code/nixos-config/main/modules/north-profile/firn/skills/firn" ;;
    repo-safety)     echo "$HOME/code/nixos-config/main/dotfiles/agents/skills/repo-safety" ;;
    # The doctrine arrives as a skill like any other, and declares its guard and
    # its role templates in its own frontmatter — which is the whole reason
    # nothing below knows the word "orchestration".
    orchestration)   echo "$ORCH/skill" ;;
  esac
}

subtree_row() { # <slug>/<leaf> -> the kind and name of the row it addresses
  # Everything under a directory gate is addressed through it, because that is
  # what it is: `code/AGENTS.md` is that directory's instruction file,
  # `code/memories` the group, and any other leaf is a memory file by name. The
  # slash is what keeps memory names out of the bare namespace a companion or a
  # module member is written in — two directories may both remember `style.md`.
  local slug="${1%%/*}" leaf="${1#*/}"
  case " $GLOBAL_SLUG ${DIRS[*]} " in *" $slug "*) ;; *) return 1 ;; esac
  case "$leaf" in
    AGENTS.md) echo "ins $slug" ;;
    memories)  echo "memroot $slug" ;;
    *)         echo "mem $slug/$leaf" ;;
  esac
}

# A skill may declare what it needs and what it ships, in its own SKILL.md
# frontmatter — and a skill that declares either is what this switchboard calls
# a MODULE:
#
#   hooks: [worktree-guard, tripwire-guard]     — or the dash-list form
#   agents: ../agents                           — a directory of templates
#
# `hooks:` is the same statement a fragment's `follows` makes, from the other
# and better end: the skill is what knows which enforcement its rules require,
# so it ships that list in its own file instead of leaving it scattered across
# fragments. A hook is active when it is enabled and ANY of its CLAIMANTS is
# active — the skills that list it, plus the unit its fragment follows — so the
# two mechanisms compose rather than compete, and a hook two skills both want
# survives one of them being turned off, exactly as a set member does.
# `agents:` is the same idea for payload: the templates ride on the skill's
# switch, from the directory the skill names, with nothing about them written
# here. Together they are why a module needs no kind of its own.
declare -A SKILL_HOOKS=() SKILL_AGENTS=()
SKILL_HOOKS_LOADED=

skill_meta_of() { # SKILL.md -> `hooks <name>` and `agents <dir>` declarations
  # Read by shape, not by a YAML parser: this is a list of bare names between
  # two `---` lines, and a dependency to read it would be a dependency in the
  # boot path of every surface. Anything that is not that shape is reported and
  # claims nothing — a skill whose list cannot be read must not silently take
  # its hooks down with it.
  python3 - "$1" <<'PY'
import re, sys
path = sys.argv[1]
try:
    text = open(path).read()
except OSError as exc:
    print(f"agents: {path}: unreadable ({exc}) — no hooks claimed", file=sys.stderr)
    raise SystemExit(0)
m = re.match(r"^---\n(.*?)\n---\s*?\n", text, re.S)
if not m:
    raise SystemExit(0)
names, agents, in_list = [], "", False
for line in m.group(1).split("\n"):
    if in_list:
        item = re.match(r"\s+-\s*(\S+)\s*$", line)
        if item:
            names.append(item.group(1))
            continue
        in_list = False
    key = re.match(r"(hooks|agents):\s*(.*)$", line)
    if not key:
        continue
    field, rest = key.group(1), key.group(2).strip()
    if field == "agents":
        agents = rest.strip("\"'")
        if not agents:
            print(f"agents: {path}: agents: names no directory — none linked",
                  file=sys.stderr)
        continue
    if rest.startswith("["):
        if not rest.endswith("]"):
            print(f"agents: {path}: hooks: list is not closed — no hooks claimed",
                  file=sys.stderr)
            raise SystemExit(0)
        names += [n.strip().strip("\"'") for n in rest[1:-1].split(",")]
    elif rest == "":
        in_list = True
    else:
        print(f"agents: {path}: hooks: {rest} is not a list of names"
              " — no hooks claimed", file=sys.stderr)
        raise SystemExit(0)
for n in names:
    if n:
        print("hooks", n)
if agents:
    print("agents", agents)
PY
}

load_skill_hooks() { # every skill's declarations, read once from its own file
  if [ -n "$SKILL_HOOKS_LOADED" ]; then return 0; fi
  SKILL_HOOKS_LOADED=1
  local s src field val
  for s in "${SKILLS[@]}"; do
    src="$(skill_source "$s")"
    [ -n "$src" ] || continue
    [ -f "$src/SKILL.md" ] || continue
    while read -r field val; do
      [ -n "${val:-}" ] || continue
      case "$field" in
        hooks)
          case " ${HOOKS[*]} " in
            *" $val "*) SKILL_HOOKS["$s"]="${SKILL_HOOKS[$s]:-}${SKILL_HOOKS[$s]:+ }$val" ;;
            *) echo "agents: skill $s declares $val, which is no hook here" \
              "— ignored" >&2 ;;
          esac ;;
        # Relative to the skill's own directory, and normalised here so the
        # sweep in apply can recognise a link by where it points.
        agents) SKILL_AGENTS["$s"]="$(realpath -m "$src/$val")" ;;
      esac
    done < <(skill_meta_of "$src/SKILL.md")
  done
}

skill_is_module() { # a skill that declares anything is a module
  load_skill_hooks
  [ -n "${SKILL_HOOKS[$1]:-}${SKILL_AGENTS[$1]:-}" ]
}

hook_is_claimed() { # does any skill list this hook
  local s
  load_skill_hooks
  for s in "${SKILLS[@]}"; do
    case " ${SKILL_HOOKS[$s]:-} " in *" $1 "*) return 0 ;; esac
  done
  return 1
}

path_of() { # the canonical source file to view or edit for a unit
  case "$1" in
    "$GLOBAL_SLUG") echo "$HOME/code/nixos-config/main/dotfiles/agents/AGENTS.md" ;;
    statusline-script) echo "$HOME/code/nixos-config/main/dotfiles/claude/statusline.sh" ;;
    # orchestration is payload-only: its source is what it injects, not a
    # member list it does not have.
    orchestration) echo "$ORCH/doctrine.md" ;;
    */*)
      # A row under a directory gate: the instruction file is the directory's
      # source, the memories group is the directory that holds them, and a
      # memory is its own file — in the first account that has it, because every
      # account keeps the same project's memories and one of them is a place to
      # look, not a claim about where it lives.
      load_dirs
      local slug="${1%%/*}" leaf="${1#*/}" md
      case " $GLOBAL_SLUG ${DIRS[*]} " in *" $slug "*) ;;
        *) echo "agents: unknown unit: $1" >&2; exit 2 ;;
      esac
      if [ "$leaf" = AGENTS.md ]; then path_of "$slug"; return; fi
      while IFS= read -r md; do
        if [ "$leaf" = memories ]; then echo "$md"; return; fi
        if [ -f "$md/$leaf" ]; then echo "$md/$leaf"; return; fi
      done < <(mem_dirs "$(dir_path_of "$slug")")
      echo "agents: unknown unit: $1" >&2; exit 2 ;;
    *)
      case " ${HOOKS[*]} " in *" $1 "*) echo "$FRAGMENTS/$1.json"; return ;; esac
      case " ${SKILLS[*]} " in *" $1 "*) echo "$(skill_source "$1")/SKILL.md"; return ;; esac
      # A member-list module's source is the list — that is the whole unit.
      [ -f "$MODULES_D/$1.json" ] && { echo "$MODULES_D/$1.json"; return; }
      load_dirs
      case " ${DIRS[*]} " in *" $1 "*) dir_source "$1"; return ;; esac
      load_plugins
      case " ${PLUGINS[*]} " in *" $1 "*) plugin_install_path "$1"; return ;; esac
      echo "agents: unknown unit: $1" >&2; exit 2 ;;
  esac
}

migrate_row() { # old-kind old-name new-kind new-name
  # A renamed slot must carry its state across, in place. Leaving the old row
  # behind is not harmless: status stops showing it, but the TUI reads the
  # manifest directly and would keep rendering the ghost.
  awk -v k="$1" -v n="$2" '$1==k && $2==n {f=1} END {exit !f}' "$MANIFEST" || return 0
  local tmp="$MANIFEST.tmp.$$"
  # Two passes over the same file: pass 1 asks whether the new row already
  # exists, so a half-migrated manifest drops the old row instead of doubling.
  awk -v ok="$1" -v oname="$2" -v nk="$3" -v nname="$4" '
    NR==FNR { if ($1==nk && $2==nname) have=1; next }
    $1==ok && $2==oname { if (!have) print nk " " nname " " $3; next }
    { print }
  ' "$MANIFEST" "$MANIFEST" > "$tmp"
  mv "$tmp" "$MANIFEST"
}

sync_dir_path() { # slug directory — the 4th column of one `dir` row
  local tmp="$MANIFEST.tmp.$$"
  awk -v n="$1" -v p="$2" \
    '$1=="dir" && $2==n && (NF<4 || $4!=p) {f=1} END {exit !f}' "$MANIFEST" || return 0
  awk -v n="$1" -v p="$2" \
    '$1=="dir" && $2==n {print $1, $2, $3, p; next} {print}' "$MANIFEST" > "$tmp"
  mv "$tmp" "$MANIFEST"
}

sync_dir_paths() { # the 4th column: where the row's context file is triggered
  # A `dir` row carries its directory past the state column, because the
  # manifest is read directly by Northbridge and the panel renders anything
  # past the state as that row's detail. The registry stays the truth: a row
  # written before the column existed is backfilled, and a directory that moved
  # in the registry is corrected here rather than drifting until someone flips.
  # The global row's directory is not in the registry and cannot move: it is
  # the root, and it is written here so every `dir` row reads the same way.
  local i
  sync_dir_path "$GLOBAL_SLUG" "$GLOBAL_DIR"
  for i in "${!DIRS[@]}"; do sync_dir_path "${DIRS[$i]}" "${DIR_PATHS[$i]}"; done
}

sync_hook_follows() { # the 4th column: the companion unit this hook follows
  # Same contract as sync_dir_paths, and for the same reason: the manifest is
  # read directly by Northbridge, which renders anything past the state as the
  # row's detail. The fragment stays the truth — a row written before the
  # column existed is backfilled, a re-pointed or removed binding is corrected
  # here rather than drifting until someone flips the hook.
  local h want tmp="$MANIFEST.tmp.$$"
  for h in "${HOOKS[@]}"; do
    want="${HOOK_FOLLOWS[$h]:-}"
    awk -v n="$h" -v s="$want" \
      '$1=="hook" && $2==n && $4!=s {f=1} END {exit !f}' "$MANIFEST" || continue
    awk -v n="$h" -v s="$want" '
      $1=="hook" && $2==n {
        if (s == "") print $1, $2, $3; else print $1, $2, $3, s
        next
      }
      {print}' "$MANIFEST" > "$tmp"
    mv "$tmp" "$MANIFEST"
  done
}

migrate_dir_subtrees() { # a dir row's state stopped meaning "this file has content"
  # It now means GATE: the row governs everything scoped at that directory. The
  # old meaning moved down to `ins <slug>`, which seeds from the dir row's state,
  # so the instruction file this switchboard writes is byte-for-byte what it was.
  # The gate itself is then OPENED wherever something else under it is already
  # live: a directory whose memories the binary loads today keeps loading them,
  # and a closed gate would empty their index on the next apply — a change to
  # what sessions read, made by a migration, which is exactly what a migration
  # must not do. Same shape as migrate_hook_permissions: a column whose meaning
  # widened is migrated by state, not left to be read the new way by accident.
  local slug ddir state tmp
  while IFS=$'\t' read -r slug ddir; do
    if awk -v n="$slug" '$1=="ins" && $2==n {f=1} END {exit !f}' "$MANIFEST"; then continue; fi
    state="$(awk -v n="$slug" '$1=="dir" && $2==n {print $3; exit}' "$MANIFEST")"
    # No dir row yet means a directory nobody has seen: it seeds off below, and
    # its ins row seeds off with it, which is the same statement.
    [ -n "$state" ] || continue
    echo "ins $slug $state" >> "$MANIFEST"
    if [ "$state" = off ] && [ -n "$(mem_dirs "$ddir")" ]; then
      tmp="$MANIFEST.tmp.$$"
      awk -v n="$slug" '$1=="dir" && $2==n {$3="on"} {print}' "$MANIFEST" > "$tmp"
      mv "$tmp" "$MANIFEST"
      echo "agents: dir $slug is now a subtree GATE — opened so the memories under" \
        "it keep loading; its instruction file stays off as \`ins $slug\`" >&2
    fi
  done < <(dir_rows)
}

migrate_hook_permissions() { # a hook's state column stopped meaning activity
  # It now means permission: `enabled` (may run when a claimant says so) or
  # `disabled` (the user's pin). A pre-column `off` row must NOT become an
  # active hook: a bound hook migrates to enabled, which is still inactive
  # while everything that wants it is off, and an unbound hook — nothing left to
  # gate it — migrates to disabled, so a machine mid-blackout composes nothing.
  awk '$1=="hook" && $3!="enabled" && $3!="disabled" {f=1} END {exit !f}' "$MANIFEST" || return 0
  local tmp="$MANIFEST.tmp.$$" s
  # Bound means claimed by a skill as much as followed by a unit: both are a
  # switch above this hook, and either is enough to keep it dark until asked.
  local bound=" ${!HOOK_FOLLOWS[*]} "
  for s in "${SKILLS[@]}"; do bound="$bound${SKILL_HOOKS[$s]:-} "; done
  awk -v bound="$bound" '
    $1=="hook" && $3!="enabled" && $3!="disabled" {
      if ($3 == "on") $3 = "enabled"
      else $3 = (index(bound, " " $2 " ") ? "enabled" : "disabled")
    }
    {print}' "$MANIFEST" > "$tmp"
  mv "$tmp" "$MANIFEST"
}

warn_duplicate_names() {
  # A companion is named bare, so one name meaning two units makes every
  # binding to it ambiguous — and a name is also how `on`/`off`/`path` reach a
  # unit, where the first matching kind silently wins. Warn, loudly, and keep
  # going: the collision is in the inventories (a registry, a plugin ledger),
  # and taking the whole switchboard down over it would strand the user with no
  # way to look or flip.
  local dup
  dup="$(printf '%s\n' "$GLOBAL_SLUG" "${HOOKS[@]}" "${SKILLS[@]}" "${MODULES[@]}" \
    "${OTHERS[@]}" ${DIRS[@]+"${DIRS[@]}"} ${PLUGINS[@]+"${PLUGINS[@]}"} | sort | uniq -d)"
  [ -n "$dup" ] || return 0
  local d
  while read -r d; do
    echo "agents: duplicate unit name across kinds: $d — companions naming it" \
      "are ambiguous" >&2
  done <<< "$dup"
}

ensure_manifest() {
  mkdir -p "$STATE" "$STATE/skills" "$DIR_TARGETS"
  [ -f "$MANIFEST" ] || : > "$MANIFEST"
  load_plugins
  load_dirs
  load_mems
  load_modules
  load_hook_follows
  load_skill_hooks
  warn_duplicate_names
  # Rename migrations run before the merge below, or the merge re-seeds the new
  # name at `off` and the old row's state is lost. `item` is gone as a kind:
  # every row it held had a real kind waiting for it, and the state rides
  # across so a re-kinding is never a silent flip.
  migrate_row item code-md dir code
  migrate_row item statusline item statusline-script
  migrate_row item agents-md dir "$GLOBAL_SLUG"
  migrate_row item orchestration module orchestration
  migrate_row item statusline-script other statusline-script
  # A module was never a kind: it is a skill that declares hooks or templates,
  # and orchestration is the one row that predated that. The state rides across,
  # so a re-kinding is not a silent flip.
  migrate_row module orchestration skill orchestration
  sync_dir_paths
  sync_hook_follows
  migrate_hook_permissions
  # After the re-kindings, so the `dir` rows it reads are the migrated ones, and
  # before the merge below, or the merge seeds `ins <slug> off` first and the
  # old state is lost.
  migrate_dir_subtrees
  # Merge, don't just seed: an entry added to the arrays after the manifest
  # exists must still appear (off) or it is invisible to status/flip forever.
  # Plugins seed from reality instead of off: settings.json already enables
  # some, and seeding those off would silently disable them on first apply.
  local enabled p k n i m o s h slug ddir mname
  enabled=" $(enabled_plugins_now | tr '\n' ' ')"
  # Field-exact presence, not a regex: plugin names are marketplace strings
  # (`@`, `.`, `+`) and would otherwise be read as patterns.
  local -A have=()
  while read -r k n _; do
    [ -n "${k:-}" ] && have["$k $n"]=1
  done < "$MANIFEST"
  # Seeded in the order status reads them, so a fresh manifest and the panel
  # that renders it agree without either sorting the other's output.
  { # Each directory seeds its whole subtree, in the order status renders it:
    # the gate, then what hangs under it. A newly registered directory is inert
    # until it is turned on — registering is "there is context here", not
    # "inject it" — and its instruction file seeds with it, so one flip is not
    # silently two.
    while IFS=$'\t' read -r slug ddir; do
      echo "dir $slug off $ddir"
      echo "ins $slug off"
      # The memories group seeds from REALITY, like a plugin does: a project
      # with a memory directory is a project whose index the binary is already
      # loading, and seeding that off would silently delete it on first apply.
      if [ -n "$(mem_dirs "$ddir")" ]; then echo "memroot $slug on"
      else echo "memroot $slug off"; fi
      # And each memory on, for the same reason: what is in the index today
      # stays in it until somebody says otherwise.
      for mname in ${MEM_NAMES[$slug]:-}; do echo "mem $slug/$mname on"; done
    done < <(dir_rows)
    for m in "${MODULES[@]}"; do echo "module $m off"; done
    for s in "${SKILLS[@]}"; do echo "skill $s off"; done
    # A new hook seeds by its binding, not by a blanket off: bound means
    # something above it — a unit it follows, a skill that declares it — is off
    # until asked for, and unbound means nothing would gate it, so it stays the
    # user's explicit call.
    for h in "${HOOKS[@]}"; do
      if [ -n "${HOOK_FOLLOWS[$h]:-}" ]; then echo "hook $h enabled ${HOOK_FOLLOWS[$h]}"
      elif hook_is_claimed "$h"; then echo "hook $h enabled"
      else echo "hook $h disabled"; fi
    done
    for p in "${PLUGINS[@]}"; do
      case "$enabled" in *" $p "*) echo "plugin $p on" ;; *) echo "plugin $p off" ;; esac
    done
    for o in "${OTHERS[@]}"; do echo "other $o off"; done
  # `rest` is state plus, for a `dir` row, the directory column after it.
  } | while read -r kind name rest; do
    [ -n "${have["$kind $name"]:-}" ] || echo "$kind $name $rest" >> "$MANIFEST"
  done
}

set_state() { # kind name state
  awk -v k="$1" -v n="$2" '$1==k && $2==n {f=1} END {exit !f}' "$MANIFEST" ||
    { echo "agents: unknown: $1 $2" >&2; exit 2; }
  local tmp="$MANIFEST.tmp.$$"
  # Assigning $3 rebuilds the record, so a `dir` row's directory column rides
  # through a flip untouched — only the state field is rewritten.
  awk -v k="$1" -v n="$2" -v s="$3" '{if ($1==k && $2==n) $3=s; print}' "$MANIFEST" > "$tmp"
  mv "$tmp" "$MANIFEST"
}

hook_line() { # the two-axis state column for one hook, wherever it is rendered
  # Both axes, always: the permission the user set, then whether that adds up to
  # running right now and why not. A hook that is enabled but silent is the case
  # worth explaining. The parenthetical is provenance — who wants this hook, or,
  # when that is not the whole story, why it is not running.
  local name="$1" line reason
  # A declared hook whose fragment is not here has no derivation to show, and a
  # missing fragment is already loud where it is read.
  if [ -z "${ACT_STATE[$name]:-}" ]; then echo "(no fragment)"; return 0; fi
  if [ "${ACT_STATE[$name]}" = enabled ]; then line="enabled · $(on_off "$name")"
  else line="disabled"; fi
  reason="${ACT_REASON[$name]}"
  if [ -n "$reason" ]; then line="$line ($reason)"
  elif [ -n "${ACT_FOLLOWS[$name]}" ]; then line="$line (${ACT_FOLLOWS[$name]})"; fi
  echo "$line"
}

status() {
  ensure_manifest
  load_activity
  load_skill_hooks
  # Read from the least specific to the most: a module set flips units of every
  # kind, a module flips a skill's own hooks, a skill or a hook answers only for
  # itself, and a directory's context is the narrowest thing here — it fires in
  # one subtree and nowhere else — so it reads last. `other` is the drawer, and
  # sits where the general things stop.
  # A MODULE is not a sibling of a skill, it IS one — a skill that declares the
  # hooks its rules need or the agent templates it ships — so modules read as
  # the first thing inside `skills`, each with what it declares nested under it.
  # A skill that declares nothing is a plain skill, and a hook nobody claims
  # answers only to itself.
  local m o p s h name slug ddir mname
  echo "module sets"
  for m in ${MODULES[@]+"${MODULES[@]}"}; do
    printf '  %-20s %s\n' "$m" "$(unit_line "$m")"
  done
  echo "skills"
  echo "  modules"
  for s in "${SKILLS[@]}"; do
    if ! skill_is_module "$s"; then continue; fi
    printf '    %-20s %s\n' "$s" "$(unit_line "$s")"
    for h in ${SKILL_HOOKS[$s]:-}; do
      printf '      %-20s %-28s %s\n' "$h" "$(hook_line "$h")" "${ACT_TAGS[$h]:-}"
    done
  done
  for s in "${SKILLS[@]}"; do
    if skill_is_module "$s"; then continue; fi
    printf '  %-20s %s\n' "$s" "$(unit_line "$s")"
  done
  echo "hooks"
  for name in ${ACT_HOOKS[@]+"${ACT_HOOKS[@]}"}; do
    if hook_is_claimed "$name"; then continue; fi
    printf '  %-22s %-28s %s\n' "$name" "$(hook_line "$name")" "${ACT_TAGS[$name]}"
  done
  echo "plugins"
  for p in "${PLUGINS[@]}"; do printf '  %-40s %s\n' "$p" "$(unit_line "$p")"; done
  echo "other"
  for o in "${OTHERS[@]}"; do printf '  %-20s %s\n' "$o" "$(unit_line "$o")"; done
  # A `dir` row is a SUBTREE GATE — it governs that directory and everything
  # under it — and the global profile is the root-of-tree case, scope `~`, which
  # is why it heads this section. Each reads as the subtree it is: the gate,
  # then the instruction file, the memories group, and each memory, indented
  # because that is the containment. The section says SCOPE, not content type:
  # what hangs off a directory is an instruction file today and its memories now,
  # and whatever else turns out to be scoped at a directory later.
  echo "directory scoped"
  while IFS=$'\t' read -r slug ddir; do
    printf '  %-20s %-24s %s\n' "$slug" "$(unit_line "$slug")" "$ddir"
    printf '    %-18s %s\n' "AGENTS.md" "$(unit_line "ins:$slug")"
    printf '    %-18s %s\n' "memories" "$(unit_line "memroot:$slug")"
    for mname in ${MEM_NAMES[$slug]:-}; do
      printf '      %-16s %s\n' "$mname" "$(unit_line "mem:$slug/$mname")"
    done
  done < <(dir_rows)
}

apply() {
  ensure_manifest
  # Read once, up front: every composition below is decided by ACTIVITY, never
  # by the raw state column. A unit a module holds off is a unit that does not
  # get written, linked, or composed — otherwise the switchboard would say one
  # thing and the surfaces would say another.
  load_activity
  # the global profile — `dir global`, the context file scoped at the root:
  # empty when off. One slot, every provider surface: the claude config target,
  # every account-scoped copy (the launcher redirects CLAUDE_CONFIG_DIR, so
  # account copies are what sessions actually load), and the codex target that
  # ~/.codex/AGENTS.md resolves to. Being root-scoped is exactly why it is not
  # in the per-directory loop below: it writes no <dir>-CLAUDE.md pair and hangs
  # no links off a directory — its surfaces are these global ones.
  # The World-1 slim profile is the source; north's profiles/tom/AGENTS.md is
  # the World-2 constitution and is loaded by lab sessions, not by this slot.
  # Every item below degrades on its own: a missing or unreadable source warns
  # and writes empty, and apply keeps going. A source that vanished must not
  # abort the run half-applied — the surfaces written after the failure would
  # keep whatever the previous apply left there, which is a state no manifest
  # describes.
  local agents_target="$STATE/CLAUDE.md"
  local codex_target="$STATE/AGENTS.md"
  local agents_src="$HOME/code/nixos-config/main/dotfiles/agents/AGENTS.md"
  # `ins global`, not `dir global`: the dir row is the gate over the whole root
  # subtree now, and the instruction file is the row under it. Activity already
  # carries the gate — ins is own AND dir — so this reads one name and gets both.
  if is_active "ins:$GLOBAL_SLUG" && [ -f "$agents_src" ]; then
    cat "$agents_src" > "$agents_target"
  else
    if is_active "ins:$GLOBAL_SLUG"; then
      echo "agents: ins $GLOBAL_SLUG is on but $agents_src is missing — wrote empty" >&2
    fi
    : > "$agents_target"
  fi
  # An active module's instructions ride on the global surfaces, after the
  # profile and behind a marker that says whose words these are. Inactive means
  # absent: a bundle turned off leaves no trace in what a session reads.
  local mname mfile
  for mname in ${MODULE_INSTRUCTION_ORDER[@]+"${MODULE_INSTRUCTION_ORDER[@]}"}; do
    is_active "$mname" || continue
    mfile="${MODULE_INSTRUCTIONS[$mname]}"
    if [ -f "$mfile" ]; then
      printf '\n\n<!-- module: %s -->\n' "$mname" >> "$agents_target"
      cat "$mfile" >> "$agents_target" ||
        echo "agents: could not append $mfile" >&2
    else
      echo "agents: module $mname is active but $mfile is missing" \
        "— not appended" >&2
    fi
  done
  copy_surface "$agents_target" "$codex_target"
  # Glob the account DIRECTORIES, not the files in them: a copy someone deleted,
  # or one a new account never seeded, heals on the next apply instead of
  # staying absent while status insists the profile is on.
  local acctdir
  for acctdir in "$HOME"/.local/state/north/accounts/*/*/; do
    [ -d "$acctdir" ] || continue
    copy_surface "$agents_target" "${acctdir}CLAUDE.md"
  done
  # directory instructions — one slot per registered directory, both
  # provider surfaces: <dir>/CLAUDE.md and <dir>/AGENTS.md resolve to the pair
  # written here, and a provider walks up from wherever the session stands, so
  # inactive means nothing is picked up anywhere in that subtree.
  local i slug ddir base dsrc
  for i in "${!DIRS[@]}"; do
    slug="${DIRS[$i]}"; ddir="${DIR_PATHS[$i]}"
    base="$(dir_target_base "$slug")"; dsrc="$(dir_source "$slug")"
    if is_active "ins:$slug" && [ -f "$dsrc" ]; then
      cat "$dsrc" > "$base-CLAUDE.md" ||
        { echo "agents: could not write $base-CLAUDE.md" >&2; continue; }
    else
      if is_active "ins:$slug"; then
        echo "agents: ins $slug is on but $dsrc is missing — wrote empty" >&2
      fi
      : > "$base-CLAUDE.md"
    fi
    copy_surface "$base-CLAUDE.md" "$base-AGENTS.md"
    link_dir_context "$ddir" "$base"
  done
  # memories — the INDEX, and only the index. Every account keeps its own copy
  # of a project's memory directory (one .md per fact, plus MEMORY.md, which the
  # binary auto-loads at session start), so this walks every account that has
  # one and rewrites MEMORY.md to list exactly the ACTIVE memories, in the words
  # the index already used for them. Content files are never written, never
  # deleted, never moved: a memory turned off keeps its file and loses its line.
  # A closed gate means an empty index — which is how a whole subtree goes quiet
  # without a single fact being touched.
  local mslug mdir mgate mname mactive mem_on=0 mem_all=0
  while IFS=$'\t' read -r mslug mdir; do
    mgate=0
    if is_active "memroot:$mslug"; then mgate=1; fi
    mactive=""
    for mname in ${MEM_NAMES[$mslug]:-}; do
      mem_all=$((mem_all + 1))
      if is_active "mem:$mslug/$mname"; then
        mactive="$mactive$mname"$'\n'
        mem_on=$((mem_on + 1))
      fi
    done
    if ! MEM_ACTIVE="$mactive" MEM_GOVERNED="${MEM_NAMES[$mslug]:-}" \
      python3 - "$ACCOUNTS" "$(project_slug "$mdir")" \
      "$MEM_INDEX_CACHE" "$mslug" "$mgate" <<'PY'
import glob, os, re, sys
accounts, proj, cache_root, slug, gate = sys.argv[1:]
gate = gate == "1"
active = {n for n in os.environ.get("MEM_ACTIVE", "").split("\n") if n}
governed = {n for n in os.environ.get("MEM_GOVERNED", "").split("\n") if n}
LINK = re.compile(r"\]\(([^)]+)\)")

def listed(f): # what belongs in the index this run
    # A memory with no row — a name this switchboard cannot address — is not
    # this switchboard's to filter: its line stays exactly where it was.
    return f in active or f not in governed

def read(path):
    try:
        with open(path) as fh:
            return fh.read()
    except OSError:
        return None

for memdir in sorted(glob.glob(
        os.path.join(accounts, "*", "*", "projects", proj, "memory"))):
    if not os.path.isdir(memdir):
        continue
    parts = os.path.relpath(memdir, accounts).split(os.sep)  # provider/account/...
    cache = os.path.join(cache_root, parts[0], parts[1], slug + ".tsv")
    try:
        files = {f for f in os.listdir(memdir)
                 if f.endswith(".md") and f != "MEMORY.md"
                 and os.path.isfile(os.path.join(memdir, f))}
    except OSError as exc:
        print(f"agents: {memdir}: unreadable ({exc}) — index left alone",
              file=sys.stderr)
        continue

    # What the live index says, in its order: a line naming a memory that is
    # gone goes with it, and a line naming nothing is somebody's prose, carried
    # through untouched rather than rewritten into a shape we prefer.
    index_path = os.path.join(memdir, "MEMORY.md")
    raw = read(index_path)
    preamble, live, live_order = [], {}, []
    for line in (raw.splitlines() if raw else []):
        m = LINK.search(line)
        if not m:
            preamble.append(line)
            continue
        f = os.path.basename(m.group(1))
        if f in files:
            if f not in live:
                live_order.append(f)
            live[f] = line

    # and what an earlier apply filtered OUT of it. That line is the model's
    # words about its own memory and MEMORY.md is the only place they exist, so
    # dropping one would destroy it: the last line seen is kept here and put
    # back in the neighbourhood it came from when the memory is on again.
    cached, cache_order = {}, []
    for row in (read(cache) or "").split("\n"):
        if not row:
            continue
        f, _, line = row.partition("\t")
        if f not in files:
            continue
        if f not in cached:
            cache_order.append(f)
        cached[f] = line

    after, prev = {}, None
    for f in cache_order:
        if f in live:
            prev = f
        else:
            after.setdefault(prev, []).append(f)
    order, seen = [], set()

    def emit(f):
        if f not in seen:
            seen.add(f)
            order.append(f)

    for f in after.get(None, []):
        emit(f)
    for f in live_order:
        emit(f)
        for g in after.get(f, []):
            emit(g)
    # A memory with no line in either place gets none invented: it is a fact
    # nobody indexed, and writing a title for it would be this switchboard
    # putting words in the model's mouth.
    lines_of = dict(cached)
    lines_of.update(live)

    body = [lines_of[f] for f in order if f in lines_of and listed(f)]
    text = ""
    if gate and (preamble or body):
        text = "\n".join(preamble + body) + "\n"
    if raw is None and not text:
        pass  # no index, nothing to list: create nothing
    elif raw != text:
        # A MEMORY.md that is a symlink is not a copy — writing through it would
        # edit somebody else's file — so it is replaced, not followed.
        if os.path.islink(index_path):
            os.unlink(index_path)
        try:
            with open(index_path, "w") as fh:
                fh.write(text)
        except OSError as exc:
            print(f"agents: could not write {index_path} ({exc})", file=sys.stderr)

    keep = [f for f in order if f in lines_of]
    try:
        if keep:
            os.makedirs(os.path.dirname(cache), exist_ok=True)
            tmp = cache + ".next"
            with open(tmp, "w") as fh:
                fh.write("".join(f"{f}\t{lines_of[f]}\n" for f in keep))
            os.replace(tmp, cache)
        elif os.path.exists(cache):
            os.remove(cache)
    except OSError as exc:
        print(f"agents: could not update {cache} ({exc})", file=sys.stderr)
PY
    then
      echo "agents: the memory index for $mslug was left as it was" >&2
    fi
  done < <(dir_rows)
  # skills — a farm of symlinks; only ACTIVE skills exist, in BOTH surfaces
  local s src
  find "$STATE/skills" -maxdepth 1 -type l -delete
  sweep_codex_skills
  for s in "${SKILLS[@]}"; do
    if is_active "$s"; then
      src="$(skill_source "$s")"
      if [ -d "$src" ]; then
        ln -sfn "$src" "$STATE/skills/$s"
        link_codex_skill "$s" "$src"
      else echo "agents: skill $s is on but $src is missing — not linked" >&2; fi
    fi
  done
  # agent templates — a skill may ship a directory of them (`agents:` in its
  # frontmatter), and they exist in ~/.claude/agents while that skill is active:
  # live symlinks into the source, so editing a template there is immediately
  # live and no frozen copy can drift. Nothing here names a particular skill —
  # the declaration is the whole wiring.
  local link tgt tpl adir
  if [ -d "$CLAUDE_AGENTS" ]; then
    # Sweep only what this switchboard owns, proven the same way as the codex
    # farm: a link is ours when it points inside a directory some skill declared.
    # ~/.claude/agents is user-visible, and a hand-written agent there must
    # survive an off.
    for link in "$CLAUDE_AGENTS"/*; do
      [ -L "$link" ] || continue
      tgt="$(readlink "$link")"
      for s in "${SKILLS[@]}"; do
        adir="${SKILL_AGENTS[$s]:-}"
        [ -n "$adir" ] || continue
        case "$tgt" in "$adir"/*) rm -f "$link"; break ;; esac
      done
    done
  fi
  for s in "${SKILLS[@]}"; do
    adir="${SKILL_AGENTS[$s]:-}"
    [ -n "$adir" ] || continue
    is_active "$s" || continue
    if [ ! -d "$adir" ]; then
      echo "agents: skill $s is on but $adir is missing — no templates linked" >&2
      continue
    fi
    mkdir -p "$CLAUDE_AGENTS"
    for tpl in "$adir"/*.md; do
      [ -e "$tpl" ] && ln -sfn "$tpl" "$CLAUDE_AGENTS/$(basename "$tpl")"
    done
  done
  # hooks + statusline + plugins — rewrite exactly those keys in live settings.json
  # The composed set is derived, never read off the manifest: a hook runs when
  # the user has it enabled AND its companion unit (if any) is on.
  local on_hooks=() hname
  for hname in ${ACT_HOOKS[@]+"${ACT_HOOKS[@]}"}; do
    if is_active "$hname"; then on_hooks+=("$hname"); fi
  done
  local on_plugins=() p
  for p in "${PLUGINS[@]}"; do
    if is_active "$p"; then on_plugins+=("$p"); fi
  done
  if ! STATUSLINE_STATE="$(on_off statusline-script)" \
  ON_PLUGINS="$(printf '%s\n' ${on_plugins[@]+"${on_plugins[@]}"})" \
  python3 - "$SETTINGS" "$FRAGMENTS" ${on_hooks[@]+"${on_hooks[@]}"} <<'PY'
import json, os, sys
settings_path, fragments_dir, *names = sys.argv[1:]
try:
    settings = json.load(open(settings_path))
except FileNotFoundError:
    settings = {}
except Exception as exc:
    # A settings.json we cannot parse is somebody's live config in a state we
    # do not understand. Rewriting it from {} would drop every key this
    # switchboard does not own, so this item degrades to "did nothing".
    sys.exit(f"agents: {settings_path} is unreadable ({exc}) — hooks/plugins/"
             "statusline left as they are")
hooks = {}
for name in names:
    try:
        frag = json.load(open(os.path.join(fragments_dir, f"{name}.json")))
    except Exception as exc:
        print(f"agents: hook {name}: {exc} — not composed", file=sys.stderr)
        continue
    for entry in frag["entries"]:
        matchers = hooks.setdefault(entry["event"], [])
        for m in matchers:
            if m.get("matcher") == entry["matcher"]:
                m["hooks"].append(entry["hook"]); break
        else:
            block = {"hooks": [entry["hook"]]}
            if entry["matcher"] is not None: block["matcher"] = entry["matcher"]
            matchers.append(block)
settings["hooks"] = hooks
# A RECORD, not a list: Claude Code validates this key strictly and rejects an
# array outright — and one invalid key makes it skip the whole file, so a
# session runs with no settings at all. A plugin that is off is absent rather
# than false, which is what its own converter writes.
settings["enabledPlugins"] = {p: True for p in os.environ["ON_PLUGINS"].split("\n") if p}
if os.environ["STATUSLINE_STATE"] == "on":
    settings["statusLine"] = {"type": "command",
      "command": 'bash "$HOME/code/nixos-config/dotfiles/claude/statusline.sh"'}
else:
    settings.pop("statusLine", None)
tmp = settings_path + ".next"
json.dump(settings, open(tmp, "w"), indent=2)
os.replace(tmp, settings_path)
PY
  then
    echo "agents: hooks, plugins, and statusline are as $SETTINGS already had them" >&2
  fi
  local on_dirs=0
  for i in "${!DIRS[@]}"; do
    is_active "ins:${DIRS[$i]}" && on_dirs=$((on_dirs + 1))
  done
  echo "applied: $(on_off "ins:$GLOBAL_SLUG") AGENTS.md, ${#on_hooks[@]} hooks, $(find "$STATE/skills" -maxdepth 1 -type l | wc -l) skills, ${#on_plugins[@]} plugins, $on_dirs/${#DIRS[@]} dir contexts, $mem_on/$mem_all memories"
}

flip() { # on|off [--all | kind? name]
  local target_state="$1"; shift
  ensure_manifest
  if [ "${1:-}" = "--all" ]; then
    local tmp="$MANIFEST.tmp.$$"
    # Hooks speak permission, everything else speaks activity, so one sweep
    # writes two vocabularies: `on --all` grants every hook and turns every
    # other unit on (so bound hooks go live too), `off --all` revokes every hook
    # outright rather than leaving one armed behind a skill.
    awk -v s="$target_state" '
      $1=="hook" {$3 = (s=="on" ? "enabled" : "disabled"); print; next}
      {$3=s; print}' "$MANIFEST" > "$tmp"
    mv "$tmp" "$MANIFEST"
  else
    local name="${1:?agents: name required}"
    case " ${SKILLS[*]} " in *" $name "*)
      set_state skill "$name" "$target_state"; apply; return ;;
    esac
    # The global profile answers to `on global`, same as any other dir row.
    case " $GLOBAL_SLUG ${DIRS[*]} " in *" $name "*)
      set_state dir "$name" "$target_state"; apply; return ;;
    esac
    case " ${MODULES[*]} " in *" $name "*)
      set_state module "$name" "$target_state"; apply; return ;;
    esac
    case " ${OTHERS[*]} " in *" $name "*)
      set_state other "$name" "$target_state"; apply; return ;;
    esac
    case " ${PLUGINS[*]} " in *" $name "*)
      set_state plugin "$name" "$target_state"; apply; return ;;
    esac
    # A row under a directory gate, addressed through it. Read after the flat
    # kinds so a name that legitimately contains a slash — a marketplace plugin,
    # say — is still found where it lives.
    case "$name" in */*)
      local row
      row="$(subtree_row "$name")" ||
        { echo "agents: unknown unit: $name" >&2; exit 2; }
      # Word-split on purpose: subtree_row answers "kind name", and set_state
      # says `unknown` for a memory that is not there.
      # shellcheck disable=SC2086
      set_state $row "$target_state"; apply; return ;;
    esac
    # Hook or :tag — a direct flip writes PERMISSION, the sticky axis: `off`
    # is a pin no skill can undo, `on` grants the hook and everything it
    # requires (asking for a hook is asking for what it needs to work). There
    # is no off-cascade to write: a dependent of a revoked hook simply stops
    # composing, and status says so.
    local resolved h perm
    perm="$([ "$target_state" = on ] && echo enabled || echo disabled)"
    resolved="$(python3 - "$FRAGMENTS" "$target_state" "$name" <<'PY'
import json, os, sys, glob
frag_dir, op, sel = sys.argv[1:]
frags = {}
for p in glob.glob(os.path.join(frag_dir, "*.json")):
    try:
        frags[os.path.basename(p)[:-5]] = json.load(open(p))
    except Exception as exc:
        print(f"agents: {p}: unreadable ({exc}) — skipped", file=sys.stderr)
if sel.startswith(":"):
    seeds = {n for n, d in frags.items() if sel[1:] in d.get("tags", [])}
    if not seeds: sys.exit(f"agents: no hooks tagged {sel}")
elif sel in frags:
    seeds = {sel}
else:
    sys.exit(f"agents: unknown hook or tag: {sel}")
result = set(seeds)
changed = True
while changed:
    changed = False
    for n, d in frags.items():
        if op == "on" and n in result:
            for req in d.get("requires", []):
                if req not in result: result.add(req); changed = True
print("\n".join(sorted(result)))
PY
)" || { echo "$resolved" >&2; exit 2; }
    for h in $resolved; do set_state hook "$h" "$perm"; done
  fi
  apply
}

# ── export-plugin ─────────────────────────────────────────────────────────────
# A module is the working tree: live symlinks into repos, governed by a switch,
# edited in place. A plugin is the opposite kind of object — a sealed release
# somebody else installs — so the export COPIES. Freezing is not a compromise
# here, it is what a release IS: the artifact must not change when the source
# repo moves on, and the receipt says exactly which revision it froze.
PLUGIN_RELEASES="${AGENTS_PLUGIN_RELEASES:-$HOME/code/north-data/plugin-releases}"

export_plugin() { # <module> [dest] [--force] [--description <text>]
  local module="" dest="" force="" desc=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --force)       force=1 ;;
      --description) shift; desc="${1:?agents: --description needs text}" ;;
      -*)            echo "agents: unknown flag: $1" >&2; exit 2 ;;
      *)             if [ -z "$module" ]; then module="$1"; else dest="$1"; fi ;;
    esac
    shift
  done
  [ -n "$module" ] || { echo "agents: export-plugin requires a module name" >&2; exit 2; }
  ensure_manifest
  case " ${MODULES[*]} " in
    *" $module "*) ;;
    *) echo "agents: not a module: $module" >&2; exit 2 ;;
  esac
  # Sources are resolved HERE, by the same function the sweep and the link use,
  # so a plugin can never contain a skill from a path the switchboard would not
  # have linked. Agent templates ride the same way: a skill that declares them
  # ships them, and the export learns that from the declaration rather than from
  # a directory it went looking for.
  local sources=() n src
  load_skill_hooks
  for n in "${SKILLS[@]}" ${MODULES[@]+"${MODULES[@]}"}; do
    src="$(skill_source "$n")"
    if [ -n "$src" ]; then sources+=("$n=$src"); fi
  done
  local templates=()
  for n in "${SKILLS[@]}"; do
    if [ -n "${SKILL_AGENTS[$n]:-}" ]; then templates+=("$n=${SKILL_AGENTS[$n]}"); fi
  done
  AGENTS_PLUGIN_DESC="$desc" AGENTS_PLUGIN_TEMPLATES="$(printf '%s\n' \
    ${templates[@]+"${templates[@]}"})" \
    python3 - "$module" "$dest" "${force:-}" "$MODULES_D" \
    "$FRAGMENTS" "$MANIFEST" "$PLUGIN_RELEASES" ${sources[@]+"${sources[@]}"} <<'PY'
import hashlib, json, os, re, shutil, stat, subprocess, sys, tempfile, time

module, dest_arg, force, modules_d, frag_dir, manifest, releases, *pairs = sys.argv[1:]
sources = dict(p.split("=", 1) for p in pairs)
templates = dict(t.split("=", 1) for t in
                 os.environ.get("AGENTS_PLUGIN_TEMPLATES", "").split("\n") if "=" in t)
desc_flag = os.environ.get("AGENTS_PLUGIN_DESC", "").strip()

kind = {}
for line in open(manifest):
    parts = line.split()
    # The rows nested under a directory gate are namespaced by their slug, not
    # named in the flat namespace a member is written in — and reading them here
    # would shadow the `dir` row they hang under.
    if len(parts) >= 3 and parts[0] not in ("ins", "memroot", "mem"):
        kind[parts[1]] = parts[0]

def module_file(name):
    return os.path.join(modules_d, name + ".json")

def module_decl(name):
    p = module_file(name)
    if not os.path.isfile(p):
        return {}
    try:
        return json.load(open(p))
    except Exception as exc:
        sys.exit(f"agents: {p}: unreadable ({exc}) — nothing exported")

# Flatten: a contained module is not a nested plugin, because a plugin has no
# such thing. Its members join this one's, union, and the receipt records that
# they arrived through their own module rather than being named here directly.
skills, hooks, skipped, flattened = [], [], [], {}
seen_modules, seen_units = [], set()

def walk(name, via):
    if name in seen_modules:
        return
    seen_modules.append(name)
    if via:
        flattened[name] = via
    for raw in (module_decl(name).get("members") or []):
        u = str(raw).strip()
        if not u or u in seen_units:
            continue
        seen_units.add(u)
        k = kind.get(u, "")
        if k == "module":
            walk(u, name)
        elif k == "skill":
            skills.append((u, name))
        elif k == "hook":
            hooks.append((u, name))
        elif k:
            skipped.append((u, k, name, f"{k} rows have no plugin equivalent"))
        else:
            skipped.append((u, "?", name, "names no unit in the manifest"))

walk(module, "")

stage = tempfile.mkdtemp(prefix="agents-plugin.")
warnings, copied_scripts, unresolved, repos = [], [], [], {}

def note(msg):
    warnings.append(msg)
    print("agents: " + msg, file=sys.stderr)

def record_repo(path):
    d = path if os.path.isdir(path) else os.path.dirname(path)
    try:
        top = subprocess.run(["git", "-C", d, "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, timeout=5)
        rev = subprocess.run(["git", "-C", d, "rev-parse", "HEAD"],
                             capture_output=True, text=True, timeout=5)
        if top.returncode == 0 and rev.returncode == 0:
            repos[top.stdout.strip()] = rev.stdout.strip()
    except Exception:
        pass

def copy_tree(src, rel):
    dst = os.path.join(stage, rel)
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    shutil.copytree(src, dst, symlinks=False, dirs_exist_ok=True)
    record_repo(src)

def rewrite_command(cmd, hook_name):
    # A plugin runs from wherever it was installed, so a command naming this
    # machine's paths is a command that works nowhere else. Every absolute path
    # that IS a file rides along in hooks/bin and the command points at it
    # through ${CLAUDE_PLUGIN_ROOT}; every one that is not gets named in the
    # receipt rather than shipped broken and silent.
    out = cmd
    for tok in re.findall(r'/[^\s"\']+', cmd):
        if os.path.isfile(tok):
            base = os.path.basename(tok)
            dst = os.path.join(stage, "hooks", "bin", base)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copy2(tok, dst)
            if (tok, "hooks/bin/" + base) not in copied_scripts:
                copied_scripts.append((tok, "hooks/bin/" + base))
            record_repo(tok)
            out = out.replace(tok, "${CLAUDE_PLUGIN_ROOT}/hooks/bin/" + base)
        else:
            unresolved.append((hook_name, tok))
            note(f"hook {hook_name}: {tok} is not a file on this machine"
                 " — left as an absolute path in the plugin")
    return out

def guide_skill(name, path):
    body = open(path).read()
    head = ""
    for line in body.splitlines():
        if line.startswith("#"):
            head = line.lstrip("#").strip()
            break
    head = head or f"Instructions carried by the {name} module."
    d = os.path.join(stage, "skills", name + "-guide")
    os.makedirs(d, exist_ok=True)
    esc = head.replace("\\", "\\\\").replace('"', '\\"')
    with open(os.path.join(d, "SKILL.md"), "w") as fh:
        fh.write(f'---\nname: {name}-guide\ndescription: "{esc}"\n---\n\n{body}')
    record_repo(path)
    return head

# Every module in the flattened set contributes its own payload and its own
# instructions, not just its member list: a plugin has no global-context slot,
# so instructions become a skill, which is the honest equivalent of "text every
# session reads".
first_head = ""
for m in seen_modules:
    decl = module_decl(m)
    payload = sources.get(m, "")
    if payload and os.path.isdir(payload):
        copy_tree(payload, os.path.join("skills", m))
    ins = (decl.get("instructions") or "").strip()
    if ins and os.path.isfile(ins):
        head = guide_skill(m, ins)
        if m == module:
            first_head = head
    elif ins:
        note(f"module {m}: instructions file {ins} is missing — no guide skill")

for name, via in skills:
    src = sources.get(name, "")
    if src and os.path.isdir(src):
        copy_tree(src, os.path.join("skills", name))
    else:
        skipped.append((name, "skill", via, f"source {src or '(unknown)'} is missing"))
        note(f"skill {name}: source is missing — not exported")
        continue
    # and the templates that skill declares, which are the other half of what a
    # module ships — flattened into the plugin's own agents/ directory
    tpl = templates.get(name, "")
    if not tpl:
        continue
    if not os.path.isdir(tpl):
        note(f"skill {name}: agents directory {tpl} is missing — no templates")
        continue
    for f in sorted(os.listdir(tpl)):
        if f.endswith(".md"):
            os.makedirs(os.path.join(stage, "agents"), exist_ok=True)
            shutil.copy2(os.path.join(tpl, f), os.path.join(stage, "agents", f))
    record_repo(tpl)

events = {}
for name, via in hooks:
    p = os.path.join(frag_dir, name + ".json")
    try:
        frag = json.load(open(p))
    except Exception as exc:
        skipped.append((name, "hook", via, f"fragment unreadable ({exc})"))
        note(f"hook {name}: {p} unreadable ({exc}) — not exported")
        continue
    record_repo(p)
    for entry in frag.get("entries", []):
        hook = dict(entry.get("hook") or {})
        hook["command"] = rewrite_command(hook.get("command", ""), name)
        blocks = events.setdefault(entry["event"], [])
        for b in blocks:
            if b.get("matcher") == entry.get("matcher"):
                b["hooks"].append(hook)
                break
        else:
            block = {"hooks": [hook]}
            if entry.get("matcher") is not None:
                block["matcher"] = entry["matcher"]
            blocks.append(block)

if events:
    os.makedirs(os.path.join(stage, "hooks"), exist_ok=True)
    with open(os.path.join(stage, "hooks", "hooks.json"), "w") as fh:
        json.dump({"description": f"Hooks composed by the {module} module.",
                   "hooks": events}, fh, indent=2)
        fh.write("\n")

# The version is a fact about the CONTENT, computed before plugin.json and the
# receipt exist so that neither can perturb it: identical sources always yield
# the same version, and any change to any exported byte yields a new one.
h = hashlib.sha256()
for root, dirs, files in os.walk(stage):
    dirs.sort()
    for f in sorted(files):
        p = os.path.join(root, f)
        h.update(os.path.relpath(p, stage).encode())
        h.update(b"\0")
        h.update(open(p, "rb").read())
        h.update(b"\0")
version = time.strftime("%Y%m%d") + "-" + h.hexdigest()[:8]

description = desc_flag or first_head or f"The {module} module, exported from the agents switchboard."
os.makedirs(os.path.join(stage, ".claude-plugin"), exist_ok=True)
with open(os.path.join(stage, ".claude-plugin", "plugin.json"), "w") as fh:
    json.dump({"name": module, "version": version, "description": description,
               "author": {"name": "Tom Passarelli",
                          "url": "https://github.com/tompassarelli"}}, fh, indent=2)
    fh.write("\n")

dest = dest_arg or os.path.join(releases, f"{module}-{version}")
if os.path.exists(dest):
    if not force:
        shutil.rmtree(stage)
        sys.exit(f"agents: {dest} already exists and a release is sealed — "
                 "pass --force to write a new version directory beside it")
    n = 2
    while os.path.exists(f"{dest}-{n}"):
        n += 1
    dest = f"{dest}-{n}"

lines = ["format=north-agents-plugin/v1",
         f"module={module}",
         f"version={version}",
         f"created={time.strftime('%Y-%m-%dT%H:%M:%S%z')}",
         f"declaration={module_file(module)}"]
for m in seen_modules[1:]:
    lines.append(f"flattened={m} (members merged in, contained by {flattened[m]})")
for name, via in skills:
    lines.append(f"member=skill {name} {sources.get(name, '(unknown)')} via {via}")
for name, via in hooks:
    lines.append(f"member=hook {name} {os.path.join(frag_dir, name + '.json')} via {via}")
for src, rel in copied_scripts:
    lines.append(f"script={src} -> {rel}")
for name, k, via, why in skipped:
    lines.append(f"skipped={k} {name} (member of {via}) — {why}")
for hookname, tok in unresolved:
    lines.append(f"unresolved-path={hookname} {tok}")
for root in sorted(repos):
    lines.append(f"repo={root} {repos[root]}")
if not unresolved:
    lines.append("unresolved-path=(none)")
with open(os.path.join(stage, "RELEASE"), "w") as fh:
    fh.write("\n".join(lines) + "\n")

os.makedirs(os.path.dirname(dest) or ".", exist_ok=True)
shutil.move(stage, dest)

# Sealed, like every other release under north-data: an artifact somebody can
# edit in place is an artifact whose receipt is a guess.
for root, dirs, files in os.walk(dest, topdown=False):
    for name in files + dirs:
        p = os.path.join(root, name)
        mode = os.lstat(p).st_mode
        if not stat.S_ISLNK(mode):
            os.chmod(p, stat.S_IMODE(mode) & ~0o222)
# The staging directory was private (mkdtemp is 0700); a release is readable.
os.chmod(dest, 0o555)

for name, k, via, why in skipped:
    print(f"agents: skipped {k} {name} — {why}", file=sys.stderr)
print(f"exported: {module} {version} -> {dest} "
      f"({len(skills)} skills, {len(hooks)} hooks, {len(seen_modules) - 1} flattened, "
      f"{len(skipped)} skipped)")
PY
}

case "${1:-status}" in
  status) status ;;
  on)  shift; flip on "$@"; ;;
  off) shift; flip off "$@" ;;
  apply) apply ;;
  path) shift; path_of "${1:?agents: path requires a name}" ;;
  export-plugin) shift; export_plugin "$@" ;;
  *) echo "usage: agents [status] | on|off <name>|--all | path <name> | apply" \
       "| export-plugin <module> [dest] [--force] [--description <text>]" >&2; exit 2 ;;
esac
