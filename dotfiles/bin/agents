#!/usr/bin/env bash
# agents — context switchboard; `apply` is the ONLY writer of every injection surface.
set -euo pipefail

STATE="$HOME/.config/agents"
MANIFEST="$STATE/manifest.conf"
NORTH="$HOME/code/north/main"
BEAGLE="$HOME/code/beagle/main"
NIXOS_CONFIG="$HOME/code/nixos-config/main"
POLICY_OWNERS="${AGENTS_POLICY_OWNERS:-$NIXOS_CONFIG/dotfiles/agents/policy-owners.toml}"
CODEX_REQUIREMENTS="${AGENTS_CODEX_REQUIREMENTS:-$NIXOS_CONFIG/modules/codex/requirements.toml}"
NORTH_HARNESS="${AGENTS_NORTH_HARNESS:-$NORTH/sdk/src/harness.ts}"
# Codex reads skills from its own directory. This directory is not wholly ours:
# Codex ships `.system/` here (its vendor-managed
# built-ins, marked with .codex-system-skills.marker) and a user may keep real
# skill directories alongside. Everything below treats it as someone else's
# space that we place links into.
CODEX_SKILLS="$HOME/.codex/skills"
# Which directories have a context file is user data, so the inventory lives in
# north-data; this switchboard only decides whether each one has content.
CONTEXT_REGISTRY="$HOME/code/north-data/context-dirs.conf"
CONTEXT_SOURCES="$HOME/code/north-data/context-dirs"
DIR_TARGETS="$STATE/dir"
# Per-project memory lives in provider state, one directory per
# project: a .md per fact, plus MEMORY.md — the INDEX the binary auto-loads at
# session start. The index is the only thing this switchboard writes there. A
# memory's content file is the model's and is never written, moved or deleted
# here; governing memory means governing what the index lists.
ACCOUNTS="$HOME/.local/state/north/accounts"
# The index line ("- [Title](file.md) — hook") is the model's words, and
# MEMORY.md is the only place they exist. Filtering a memory out of the index
# would destroy that text, so the last line seen for every memory is kept here
# and put back when the memory is turned on again. Derived, never authoritative:
# a memory whose file is gone loses its entry on the next apply.
MEM_INDEX_CACHE="$STATE/mem-index"

HOOKS=(agent-spawn-guard beagle-session-start comment-bloat-guard
  corpus-scan-guard firn-system-policy git-blind-stage-guard logcompress
  session-kill-guard tripwire-guard worktree-guard)
declare -A HOOK_FOLLOWS=(
  [beagle-session-start]=beagle-authoring
  [comment-bloat-guard]=global
  [corpus-scan-guard]=convo
  [firn-system-policy]=firn
  [git-blind-stage-guard]=repo-safety
  [session-kill-guard]=repo-safety
  [tripwire-guard]=repo-safety
  [worktree-guard]=repo-safety
)
declare -A HOOK_PATHS=(
  [agent-spawn-guard]="$NORTH/profiles/tom/hooks/agent-spawn-guard.sh"
  [beagle-session-start]="$BEAGLE/integrations/north/hooks/beagle-session-start.sh"
  [comment-bloat-guard]="$NORTH/profiles/tom/hooks/comment-bloat-guard.sh"
  [corpus-scan-guard]="$NORTH/profiles/tom/hooks/corpus-scan-guard.sh"
  [firn-system-policy]="$NIXOS_CONFIG/native/system_policy_native.bgl"
  [git-blind-stage-guard]="$NORTH/profiles/tom/hooks/git-blind-stage-guard.sh"
  [logcompress]="$NORTH/profiles/tom/hooks/logcompress.js"
  [session-kill-guard]="$NORTH/profiles/tom/hooks/session-kill-guard.sh"
  [tripwire-guard]="$NORTH/profiles/tom/hooks/tripwire-guard.sh"
  [worktree-guard]="$NORTH/profiles/tom/hooks/launch-critical-worktree-guard.sh"
)
SKILLS=(webdev importing-skills threejs-animation threejs-fundamentals
  threejs-geometry threejs-interaction threejs-lighting threejs-loaders
  threejs-materials threejs-postprocessing threejs-shaders threejs-textures
  beagle-authoring beagle-system-design fact-modeling firn repo-safety staffing
  messages threads assignments todo convo guard-authoring cloudflare-deploy verification estimate
  agent-policy delegating-agents executive-orchestration executive-report rust-development project-structure external-code terse greenfield)
# A MODULE is a skill with declarations — a skill whose frontmatter names the
# hooks its rules need (`hooks:`) or a directory of agent templates it ships
# (`agents:`). It is not a kind: a module's name IS a skill's name. Staffing is
# one: its spawn guard and role templates travel with the same switch.
#
# A SET is the other thing, and the only distinctly-named one: a row that
# names units it composes, in modules.d/<name>.json as
# `{"members": ["<unit-name>", ...]}`. Members are bare names of ANY kind —
# including other sets, which is how a bundle is built out of bundles. Sets are
# discovered from the directory, so writing a file is the whole act of adding
# one, and this array starts empty.
MODULES=()
MODULES_D="${AGENTS_MODULES:-$HOME/code/nixos-config/main/dotfiles/agents/modules.d}"
MODULES_LOADED=

# A module may also own INSTRUCTIONS: `"instructions": "<abs-path>"`, a file
# appended to the global surfaces while the module is active. That is what
# makes a module the equivalent of a plugin for code you own — context, skills
# and hooks arriving together, live from the working tree, with no version to
# pin and no copy to drift.
declare -A MODULE_INSTRUCTIONS=()
MODULE_INSTRUCTION_ORDER=()

load_modules() {
  if [ -n "$MODULES_LOADED" ]; then return 0; fi
  MODULES_LOADED=1
  local n f
  # Filename order, and nothing cleverer: two modules that both append must land
  # in the same order on every machine and every run, or the surfaces churn.
  while IFS=$'\t' read -r n f; do
    [ -n "${n:-}" ] || continue
    case " ${MODULES[*]} " in *" $n "*) ;; *) MODULES+=("$n") ;; esac
    if [ -n "${f:-}" ]; then
      MODULE_INSTRUCTIONS["$n"]="$f"; MODULE_INSTRUCTION_ORDER+=("$n")
    fi
  done < <(python3 - "$MODULES_D" <<'PY'
import glob, json, os, sys
for p in sorted(glob.glob(os.path.join(sys.argv[1], "*.json"))):
    try:
        ins = (json.load(open(p)).get("instructions") or "").strip()
    except Exception:
        ins = ""  # activity() is where an unreadable module file is reported
    print(f"{os.path.basename(p)[:-5]}\t{ins}")
PY
  )
}
# `other` is the honest triage drawer for rows outside the declared kinds.
OTHERS=()
# A `dir` row is a directory instruction file: it fires for that directory and
# everything under it. The global profile is that same thing scoped at the
# root — `~`, the tree that contains every other — which is why it is built in
# rather than registry-backed, and why it reads first.
# It writes the global surface and
# never a per-directory target or a link at a directory.
GLOBAL_SLUG=global
GLOBAL_DIR="~"

DIRS=(); DIR_PATHS=(); DIRS_LOADED=

load_dirs() { # the registry is the inventory, same shape as the plugin ledger
  if [ -n "$DIRS_LOADED" ]; then return 0; fi
  DIRS_LOADED=1
  [ -f "$CONTEXT_REGISTRY" ] || return 0
  local d s
  # `|| [ -n "$d" ]` — a registry saved without a trailing newline still counts.
  while read -r d s _ || [ -n "${d:-}" ]; do
    case "${d:-}" in ''|'#'*) continue ;; esac
    [ -n "${s:-}" ] || { echo "agents: $CONTEXT_REGISTRY: no slug for $d" >&2; continue; }
    DIRS+=("$s"); DIR_PATHS+=("$d")
  done < "$CONTEXT_REGISTRY"
}

dir_source() { echo "$CONTEXT_SOURCES/$1.md"; }

dir_rows() { # slug<TAB>directory for every dir row, the root first
  # One iteration for the whole subtree family: seeding, status and apply must
  # walk the same directories in the same order, and the global row is a dir row
  # at `~` rather than a special case with its own loop.
  local i
  printf '%s\t%s\n' "$GLOBAL_SLUG" "$GLOBAL_DIR"
  load_dirs
  for i in ${DIRS[@]+"${!DIRS[@]}"}; do
    printf '%s\t%s\n' "${DIRS[$i]}" "${DIR_PATHS[$i]}"
  done
}

dir_path_of() { # slug -> the directory that row gates
  local i
  if [ "$1" = "$GLOBAL_SLUG" ]; then echo "$GLOBAL_DIR"; return 0; fi
  load_dirs
  for i in ${DIRS[@]+"${!DIRS[@]}"}; do
    if [ "${DIRS[$i]}" = "$1" ]; then echo "${DIR_PATHS[$i]}"; return 0; fi
  done
  return 1
}

project_slug() { # <directory> -> the projects/<name> directory holding its memory
  # Provider project state names a directory after the path with the
  # separators turned into dashes: /home/tom/code -> -home-tom-code. The global
  # row's scope is `~`, which is $HOME, and slugs the same way.
  local p="$1"
  if [ "$p" = "$GLOBAL_DIR" ]; then p="$HOME"; fi
  echo "${p//\//-}"
}

mem_dirs() { # <directory> -> every account's memory directory for that project
  # Every account keeps its own copy of a project's memories, so a scope has as
  # many memory directories as there are accounts that have opened it. None is
  # not an error: a directory nobody has stored a memory for simply has no
  # memory rows.
  local proj md
  proj="$(project_slug "$1")"
  for md in "$ACCOUNTS"/*/*/projects/"$proj"/memory; do
    if [ -d "$md" ]; then echo "$md"; fi
  done
}

mem_names() { # <directory> -> the memory FILES governed for that scope
  # Union by name across accounts: the same fact carries the same filename in
  # every account that has it, so one row governs it everywhere and an account
  # that lacks it is simply not written.
  local md f b
  while IFS= read -r md; do
    for f in "$md"/*.md; do
      [ -f "$f" ] || continue
      b="${f##*/}"
      # The index is not a memory; it is what this switchboard composes.
      if [ "$b" = MEMORY.md ]; then continue; fi
      # The manifest is whitespace-delimited, so a name with a space in it has
      # no row it could live on. Say so, and leave the file alone.
      case "$b" in *[[:space:]]*)
        echo "agents: memory $f: name contains whitespace — not governable" >&2
        continue ;;
      esac
      # A directory's own rows are addressed as `<slug>/AGENTS.md` and
      # `<slug>/memories`, so those two names are spoken for: a memory file
      # called either has no address of its own. Ungoverned is not unread —
      # apply leaves such a file's index line exactly where it found it.
      case "$b" in AGENTS.md|memories)
        echo "agents: memory $f: \`$b\` is how a directory's own row is" \
          "addressed — this memory is left ungoverned" >&2
        continue ;;
      esac
      echo "$b"
    done
  done < <(mem_dirs "$1") | sort -u
}

declare -A MEM_NAMES=()
MEMS_LOADED=

load_mems() { # the memory inventory, scanned like the plugin ledger
  # Dynamic on purpose: a memory the model wrote between two runs is governable
  # on the next one, without anybody registering it. Nothing is written back —
  # the files are the inventory, the manifest only holds the switches.
  if [ -n "$MEMS_LOADED" ]; then return 0; fi
  MEMS_LOADED=1
  local slug ddir
  while IFS=$'\t' read -r slug ddir; do
    MEM_NAMES["$slug"]="$(mem_names "$ddir")"
  done < <(dir_rows)
}

activity() { # kind|name|own|active|reason|follows|tags — every unit, one line
  # `|` and not a tab: read splits on runs of IFS WHITESPACE, so a unit with no
  # companion (empty field) would shift every field after it left.
  # ONE derivation, read by both status and apply, because activity is computed
  # and never stored. Two axes: the OWN SWITCH is the user's and lives in the
  # manifest (`enabled`/`disabled` for a hook, `on`/`off` for everything else);
  # ACTIVITY is what that adds up to right now, and it is
  #
  #   own switch  AND  (in no module  OR  some containing module is active)
  #                 AND every GATE above it in its directory subtree
  #
  # with a hook additionally following its companion. A `dir` row is that gate:
  # it governs the whole subtree scoped at its directory, so the instruction
  # file (`ins`), the memories group (`memroot`) and each memory (`mem`) are all
  # ANDed with it — and `mem` with `memroot` too. Gates are AND where modules are
  # UNION, because a gate is containment in a place and a module is one of
  # several parties that may want a unit. UNION over containing
  # modules is deliberate: a unit two bundles both want survives one of them
  # being turned off, because the other still wants it. The rule recurses —
  # a module is gated by the modules that contain IT — so a bundle of bundles
  # composes without a second mechanism. Nothing here is written back, so the
  # manifest cannot disagree with itself.
  # Skill-side claims ride in on the environment rather than being re-read here:
  # they come from files this script already knows how to find, and the
  # derivation stays one python block with one input format.
  load_skill_hooks
  local cs ch claims=""
  for cs in "${SKILLS[@]}"; do
    for ch in ${SKILL_HOOKS[$cs]:-}; do claims+="$ch"$'\t'"$cs"$'\n'; done
  done
  local follows="" h
  for h in "${HOOKS[@]}"; do
    follows+="$h"$'\t'"${HOOK_FOLLOWS[$h]:-}"$'\n'
  done
  AGENTS_CLAIMS="$claims" AGENTS_HOOKS="${HOOKS[*]}" AGENTS_HOOK_FOLLOWS="$follows" \
    python3 - "$MANIFEST" "$MODULES_D" <<'PY'
import glob, json, os, sys
manifest, modules_dir = sys.argv[1:]
frags = {name: {} for name in os.environ.get("AGENTS_HOOKS", "").split()}
for row in os.environ.get("AGENTS_HOOK_FOLLOWS", "").splitlines():
    name, _, follows = row.partition("\t")
    if name and follows:
        frags[name]["follows"] = follows
members = {}
for p in sorted(glob.glob(os.path.join(modules_dir, "*.json"))):
    n = os.path.basename(p)[:-5]
    try:
        members[n] = [str(m).strip() for m in (json.load(open(p)).get("members") or [])
                      if str(m).strip()]
    except Exception as exc:
        # A module whose list cannot be read composes nothing rather than
        # guessing: its own payload, if it has one, still answers to its switch.
        print(f"agents: {p}: unreadable ({exc}) — {n} composes no members",
              file=sys.stderr)
        members[n] = []

# Three kinds are namespaced under a directory slug, so their names are not
# unique on their own: `ins code`, `memroot code` and the `dir code` they hang
# under would all be "code". They are keyed by kind here (and reported that way,
# so bash keeps ONE lookup table), which also keeps them out of the bare-name
# namespace a companion or a module member is written in.
QUALIFIED = ("ins", "memroot", "mem")

def keyof(k, n):
    return f"{k}:{n}" if k in QUALIFIED else n

kind, own, rows = {}, {}, []
for line in open(manifest):
    parts = line.split()
    if len(parts) < 3:
        continue
    key = keyof(parts[0], parts[1])
    kind[key] = parts[0]
    own[key] = parts[2]
    rows.append((parts[0], parts[1], key))

# The gates above a row, nearest first. A directory row gates its own subtree;
# nothing gates a directory row but the modules that contain it.
gates = {}
for k, n, key in rows:
    if k in ("ins", "memroot"):
        gates[key] = [n]
    elif k == "mem":
        gates[key] = ["memroot:" + n.split("/", 1)[0], n.split("/", 1)[0]]

# Containment inverted: for a unit, which modules claim it. Sorted, so a unit
# in two bundles always blames the same one when both are off.
container = {}
for m in sorted(members):
    for u in members[m]:
        container.setdefault(u, []).append(m)
        if u not in own:
            print(f"agents: module {m} lists {u}, which is no unit — ignored",
                  file=sys.stderr)
for u in container:
    container[u].sort()

# Mutual containment has no answer — each module would be waiting on the other
# — so it is named and every module in it derives inactive. Fail loud, not
# forever: the alternative is a recursion that never bottoms out.
GREY = 1
color, in_cycle = {}, set()

def visit(m, stack):
    color[m] = GREY
    stack.append(m)
    for c in container.get(m, []):
        if c not in members:
            continue
        if color.get(c) == GREY:
            cyc = stack[stack.index(c):]
            in_cycle.update(cyc)
            print("agents: module cycle: " + " -> ".join(cyc + [cyc[0]])
                  + " — every module in it derives inactive", file=sys.stderr)
        elif c not in color:
            visit(c, stack)
    stack.pop()
    color[m] = 2

for m in sorted(members):
    if m not in color:
        visit(m, [])

def own_on(u):
    return own.get(u) == ("enabled" if kind.get(u) == "hook" else "on")

gated = {}

def gate_open(g): # a gate whose row is gone gates nothing open
    return g in own and gated_active(g)

def gated_active(u): # own switch, gated by its subtree gates and its modules
    if u in gated:
        return gated[u]
    gated[u] = False
    if u in in_cycle:
        return False
    ok = own_on(u)
    if ok:
        ok = all(gate_open(g) for g in gates.get(u, []))
    cs = container.get(u, [])
    if ok and cs:
        ok = any(gated_active(c) for c in cs)
    gated[u] = ok
    return ok

def off_ancestor(u, seen=None): # the nearest thing up the chain that is itself off
    seen = set() if seen is None else seen
    # Gates before modules: the gate is the closer container, and it is the row
    # sitting directly above this one in the directory the reader is looking at.
    for g in gates.get(u, []):
        if g in seen:
            continue
        seen.add(g)
        if g not in own:
            return g
        if not gated_active(g):
            if not own_on(g):
                return g
            a = off_ancestor(g, seen)
            if a:
                return a
    for c in container.get(u, []):
        if c in seen:
            continue
        seen.add(c)
        if c in in_cycle:
            return c
        if not gated_active(c):
            if not own_on(c):
                return c
            a = off_ancestor(c, seen)
            if a:
                return a
    return ""

def label(u): # what a reader calls this row — how status renders it, not its key
    # KIND-PREFIXED, because a bare name in a hook's parenthetical reads as
    # another hook: `(skill: firn off)` says which switchboard row to go flip.
    # The rows nested under a directory say what they are already.
    k = kind.get(u, "")
    if k == "ins":
        return "AGENTS.md"
    if k == "memroot":
        return "memories"
    if k == "mem":
        return u.split(":", 1)[1].split("/", 1)[1]
    return f"{k}: {u}" if k else u

def blame(u): # why this unit is not active, in the words of the nearest cause
    if u in in_cycle:
        return "module cycle"
    a = off_ancestor(u)
    return f"{label(a)} off" if a else ""

companion = {n: (d.get("follows") or "").strip() for n, d in frags.items()}
# Who wants each hook: the unit its fragment follows, then the skills whose
# frontmatter claims it. Deduped and order-stable, because this list is also the
# provenance status prints — a hook must always blame the same row twice running.
claims = {}
for row in os.environ.get("AGENTS_CLAIMS", "").split("\n"):
    if not row:
        continue
    h, _, s = row.partition("\t")
    claims.setdefault(h, [])
    if s and s not in claims[h]:
        claims[h].append(s)
for h in claims:
    claims[h].sort()
enabled = {n for n in frags if own.get(n) == "enabled"}
requires = {n: [r for r in frags[n].get("requires", [])] for n in frags}

# A chain is composed whole or not at all: a hook whose requirement the user
# disabled cannot do its job, so it drops out loudly rather than running half
# armed. Blockage is transitive — a dependent of a dropped hook is dropped too.
blocked, why = {}, {}
changed = True
while changed:
    changed = False
    for n in frags:
        if n in blocked:
            continue
        for r in requires[n]:
            if r not in enabled or r in blocked:
                blocked[n] = True
                why[n] = r
                changed = True
                break

def claimant_active(c):
    # A hook is nobody's claimant: it speaks permission, not on/off, and
    # hook-needs-hook is what `requires` is for.
    if kind.get(c) == "hook":
        return False
    return gated_active(c)

def claimants(n): # every unit that wants this hook, nearest statement first
    cs = []
    s = companion.get(n) or ""
    if s:
        cs.append(s)
    for c in claims.get(n, []):
        if c not in cs:
            cs.append(c)
    return cs

def wanted(n): # UNION: one active claimant is enough, and none means unbound
    cs = claimants(n)
    return not cs or any(claimant_active(c) for c in cs)

def eligible(n):
    return n in enabled and n not in blocked and gated_active(n) and wanted(n)

# Requirements ride in on their dependent: an enabled requirement is composed
# because something active needs it, even when its own companion is off.
composed, pulled_by = {n for n in frags if eligible(n)}, {}
changed = True
while changed:
    changed = False
    for n in list(composed):
        for r in requires[n]:
            if r not in composed:
                composed.add(r)
                pulled_by[r] = n
                changed = True

for n in sorted(frags):
    p = own.get(n, "disabled")
    cs = claimants(n)
    if n in composed:
        reason = f"required by {pulled_by[n]}" if n in pulled_by and not eligible(n) else ""
    elif p != "enabled":
        reason = ""
    elif n in blocked:
        reason = f"needs {why[n]}, disabled"
        print(f"agents: {n} is enabled but requires {why[n]}, which is disabled"
              " — not composed", file=sys.stderr)
    elif not gated_active(n):
        # The bundle this hook came in with is off — coarser than the companion
        # and the thing to flip first, so it is named first.
        reason = blame(n)
    elif not wanted(n):
        # Name what the reader can act on: a claimant held off by a bundle
        # blames the bundle, not itself, or the row above would read `on`. Every
        # claimant is named, because turning any ONE of them on is the fix.
        reason = ", ".join(w for w in
                           (("" if own_on(c) else f"{label(c)} off") or blame(c)
                            for c in cs) if w)
    else:
        reason = ""
    tags = " ".join(":" + t for t in frags[n].get("tags", []))
    print("|".join(["hook", n, p, "1" if n in composed else "0", reason,
                    ", ".join(label(c) for c in cs), tags]))

for k, n, key in rows:
    if k == "hook":
        continue
    a = gated_active(key)
    print("|".join([k, key, own[key], "1" if a else "0",
                    "" if a or not own_on(key) else blame(key), "", ""]))
PY
}

declare -A ACT_STATE=() ACT_ACTIVE=() ACT_REASON=() ACT_FOLLOWS=() ACT_TAGS=()
ACT_HOOKS=()

load_activity() { # the derivation, once, into name-keyed lookups
  # Name-keyed and not kind-keyed on purpose: a companion and a member are both
  # bare names, so this is the same namespace ensure_manifest polices.
  ACT_STATE=(); ACT_ACTIVE=(); ACT_REASON=(); ACT_FOLLOWS=(); ACT_TAGS=(); ACT_HOOKS=()
  local k n st a r f t
  while IFS='|' read -r k n st a r f t; do
    [ -n "${n:-}" ] || continue
    ACT_STATE["$n"]="$st"; ACT_ACTIVE["$n"]="$a"; ACT_REASON["$n"]="$r"
    ACT_FOLLOWS["$n"]="$f"; ACT_TAGS["$n"]="$t"
    # `if`, not `&&`: a non-hook last row would make the loop — and so this
    # function — exit non-zero under `set -e`.
    if [ "$k" = hook ]; then ACT_HOOKS+=("$n"); fi
  done < <(activity)
}

is_active() { [ "${ACT_ACTIVE[$1]:-0}" = 1 ]; }

on_off() { is_active "$1" && echo on || echo off; }

write_activity_projection() {
  # Provider adapters that cannot accept a dynamically composed hook manifest
  # read this DERIVED projection. The manifest remains the user's authority;
  # this file contains only the activity calculation apply is already using.
  local target="$STATE/activity.conf" tmp="$STATE/activity.conf.tmp.$$"
  local m s h
  : > "$tmp"
  for m in ${MODULES[@]+"${MODULES[@]}"}; do
    printf 'module %s %s\n' "$m" "$(on_off "$m")" >> "$tmp"
  done
  for s in "${SKILLS[@]}"; do
    printf 'skill %s %s\n' "$s" "$(on_off "$s")" >> "$tmp"
  done
  for h in "${HOOKS[@]}"; do
    printf 'hook %s %s\n' "$h" "$(on_off "$h")" >> "$tmp"
  done
  mv "$tmp" "$target"
}

unit_line() { # the state column for a non-hook row: both axes, when they differ
  local n="$1"
  if [ "${ACT_STATE[$n]:-}" = on ] && ! is_active "$n"; then
    if [ -n "${ACT_REASON[$n]:-}" ]; then echo "on · off (${ACT_REASON[$n]})"
    else echo "on · off"; fi
  else
    echo "${ACT_STATE[$n]:-}"
  fi
}

copy_surface() { # src dst — dst is ours, and must be a real file
  # The target is a real derived file. Remove a stale symlink first so a write
  # cannot accidentally truncate its source through an old indirection.
  if [ -L "$2" ]; then rm -f "$2"; fi
  cat "$1" > "$2" || echo "agents: could not write $2" >&2
  return 0
}

dir_target_base() { # the <base>-AGENTS.md stem a slug writes
  case "$1" in
    # ~/code/AGENTS.md is a home-manager link to this exact path. Moving it
    # under dir/ would leave the live link dangling until the next rebuild.
    code) echo "$STATE/code" ;;
    *)    echo "$DIR_TARGETS/$1" ;;
  esac
}

link_dir_context() { # dir base — the AGENTS.md link AT the directory itself
  # `apply` owns the target files; the links at <dir> are usually someone
  # else's (home-manager writes ~/code's). Create only what is missing, and
  # never clobber a file already sitting there.
  local ddir="$1" base="$2" link want
  [ -d "$ddir" ] || { echo "agents: $ddir does not exist — no links made" >&2; return 0; }
  link="$ddir/AGENTS.md"; want="$base-AGENTS.md"
  if [ -e "$link" ] || [ -L "$link" ]; then
    # Already ours counts even through an indirection (home-manager points
    # ~/code's link at a store path that points back here).
    if [ "$(readlink -f "$link" 2>/dev/null)" = "$(readlink -f "$want")" ]; then return 0; fi
    echo "agents: $link is not this switchboard's — left alone" >&2
    return 0
  fi
  ln -s "$want" "$link"
}

sweep_state_skills() { # remove inactive or invalid links from our skill farm
  local link name src
  for link in "$STATE/skills"/*; do
    [ -L "$link" ] || continue
    name="$(basename "$link")"
    src="$(skill_source "$name")"
    if ! is_active "$name" || [ -z "$src" ] || [ ! -r "$src/SKILL.md" ]; then
      rm -f "$link"
    fi
  done
}

sweep_codex_skills() { # remove ONLY inactive links this switchboard writes
  # Ownership is proven, not assumed: a link counts as ours when its name is one
  # we govern and it points exactly where we would have pointed it. Nothing
  # else is touched — not `.system` (Codex's own, and a real directory anyway),
  # not a hand-written skill directory, not a symlink somebody else placed.
  # A blanket sweep here would delete a user's work on the first `agents off`.
  local link name src tgt
  [ -d "$CODEX_SKILLS" ] || return 0
  for link in "$CODEX_SKILLS"/*; do
    [ -L "$link" ] || continue
    name="$(basename "$link")"
    src="$(skill_source "$name")"
    [ -n "$src" ] || continue
    tgt="$(readlink "$link")"
    if [ "$tgt" = "$src" ] &&
       { ! is_active "$name" || [ ! -r "$src/SKILL.md" ]; }; then
      rm -f "$link"
    fi
  done
}

link_skill_atomically() { # root name source surface
  # A scanner must see the complete old link or the complete new one. Publishing
  # through rename also makes an idempotent apply a true no-op: an already-correct
  # link is never unlinked and recreated underneath a provider's startup scan.
  local root="$1" name="$2" src="$3" surface="$4"
  local link="$root/$name" tmp="$root/.agents-$name.next.$$" suffix=0
  if [ -L "$link" ] && [ "$(readlink "$link")" = "$src" ] &&
     [ -r "$link/SKILL.md" ]; then
    return 0
  fi
  if { [ -e "$link" ] || [ -L "$link" ]; } && [ ! -L "$link" ]; then
    echo "agents: $link is not a managed link — $name not linked for $surface" >&2
    return 0
  fi
  while [ -e "$tmp" ] || [ -L "$tmp" ]; do
    suffix=$((suffix + 1)); tmp="$root/.agents-$name.next.$$.$suffix"
  done
  if ! ln -s "$src" "$tmp"; then
    echo "agents: could not stage $name for $surface" >&2
    return 0
  fi
  if [ ! -r "$tmp/SKILL.md" ]; then
    echo "agents: skill $name has no readable SKILL.md at $src — not linked for $surface" >&2
    rm -f "$tmp"
    return 0
  fi
  if ! mv -Tf "$tmp" "$link"; then
    echo "agents: could not publish $name for $surface" >&2
    rm -f "$tmp"
  fi
  return 0
}

link_codex_skill() { # name source
  [ -e "$CODEX_SKILLS" ] || mkdir -p "$CODEX_SKILLS" 2>/dev/null || true
  if [ ! -d "$CODEX_SKILLS" ]; then
    echo "agents: $CODEX_SKILLS is not a directory — $1 not linked for codex" >&2
    return 0
  fi
  link_skill_atomically "$CODEX_SKILLS" "$1" "$2" codex
  return 0
}

skill_source() {
  case "$1" in
    webdev)          echo "$HOME/code/north/main/agent-profile/skills/webdev" ;;
    importing-skills) echo "$HOME/code/north/main/agent-profile/skills/importing-skills" ;;
    threejs-animation) echo "$HOME/code/north/main/agent-profile/skills/threejs-animation" ;;
    threejs-fundamentals) echo "$HOME/code/north/main/agent-profile/skills/threejs-fundamentals" ;;
    threejs-geometry) echo "$HOME/code/north/main/agent-profile/skills/threejs-geometry" ;;
    threejs-interaction) echo "$HOME/code/north/main/agent-profile/skills/threejs-interaction" ;;
    threejs-lighting) echo "$HOME/code/north/main/agent-profile/skills/threejs-lighting" ;;
    threejs-loaders) echo "$HOME/code/north/main/agent-profile/skills/threejs-loaders" ;;
    threejs-materials) echo "$HOME/code/north/main/agent-profile/skills/threejs-materials" ;;
    threejs-postprocessing) echo "$HOME/code/north/main/agent-profile/skills/threejs-postprocessing" ;;
    threejs-shaders) echo "$HOME/code/north/main/agent-profile/skills/threejs-shaders" ;;
    threejs-textures) echo "$HOME/code/north/main/agent-profile/skills/threejs-textures" ;;
    beagle-authoring) echo "$BEAGLE/integrations/north/skills/beagle-authoring" ;;
    beagle-system-design) echo "$NIXOS_CONFIG/dotfiles/agents/skills/beagle-system-design" ;;
    fact-modeling) echo "$BEAGLE/store/integrations/north/skills/fact-modeling" ;;
    firn)            echo "$NIXOS_CONFIG/modules/north-profile/firn/skills/firn" ;;
    repo-safety)     echo "$NIXOS_CONFIG/dotfiles/agents/skills/repo-safety" ;;
    todo)            echo "$NIXOS_CONFIG/dotfiles/agents/skills/todo" ;;
    convo)           echo "$NIXOS_CONFIG/dotfiles/agents/skills/convo" ;;
    guard-authoring) echo "$NIXOS_CONFIG/dotfiles/agents/skills/guard-authoring" ;;
    cloudflare-deploy) echo "$NIXOS_CONFIG/dotfiles/agents/skills/cloudflare-deploy" ;;
    verification)    echo "$NIXOS_CONFIG/dotfiles/agents/skills/verification" ;;
    terse)           echo "$NIXOS_CONFIG/dotfiles/agents/skills/terse" ;;
    greenfield)      echo "$NIXOS_CONFIG/dotfiles/agents/skills/greenfield" ;;
    estimate)        echo "$NIXOS_CONFIG/dotfiles/agents/skills/estimate" ;;
    agent-policy)    echo "$NIXOS_CONFIG/dotfiles/agents/skills/agent-policy" ;;
    delegating-agents) echo "$NIXOS_CONFIG/dotfiles/agents/skills/delegating-agents" ;;
    executive-orchestration) echo "$NIXOS_CONFIG/dotfiles/agents/skills/executive-orchestration" ;;
    executive-report) echo "$NIXOS_CONFIG/dotfiles/agents/skills/executive-report" ;;
    rust-development) echo "$NIXOS_CONFIG/dotfiles/agents/skills/rust-development" ;;
    project-structure) echo "$NIXOS_CONFIG/dotfiles/agents/skills/project-structure" ;;
    external-code)   echo "$HOME/code/north/main/agent-profile/skills/external-code" ;;
    staffing)        echo "$NORTH/orchestration/staffing" ;;
    messages)        echo "$NORTH/coordination/messages" ;;
    threads)         echo "$NORTH/coordination/threads" ;;
    assignments)     echo "$NORTH/coordination/assignments" ;;
  esac
}

subtree_row() { # <slug>/<leaf> -> the kind and name of the row it addresses
  # Everything under a directory gate is addressed through it, because that is
  # what it is: `code/AGENTS.md` is that directory's instruction file,
  # `code/memories` the group, and any other leaf is a memory file by name. The
  # slash is what keeps memory names out of the bare namespace a companion or a
  # module member is written in — two directories may both remember `style.md`.
  local slug="${1%%/*}" leaf="${1#*/}"
  case " $GLOBAL_SLUG ${DIRS[*]} " in *" $slug "*) ;; *) return 1 ;; esac
  case "$leaf" in
    AGENTS.md) echo "ins $slug" ;;
    memories)  echo "memroot $slug" ;;
    *)         echo "mem $slug/$leaf" ;;
  esac
}

# A skill may declare what it needs and what it ships, in its own SKILL.md
# frontmatter — and a skill that declares either is what this switchboard calls
# a MODULE:
#
#   hooks: [worktree-guard, tripwire-guard]     — or the dash-list form
#   agents: ../agents                           — a directory of templates
#
# `hooks:` is the same statement a fragment's `follows` makes, from the other
# and better end: the skill is what knows which enforcement its rules require,
# so it ships that list in its own file instead of leaving it scattered across
# fragments. A hook is active when it is enabled and ANY of its CLAIMANTS is
# active — the skills that list it, plus the unit its fragment follows — so the
# two mechanisms compose rather than compete, and a hook two skills both want
# survives one of them being turned off, exactly as a set member does.
# `agents:` is the same idea for payload: the templates ride on the skill's
# switch, from the directory the skill names, with nothing about them written
# here. Together they are why a module needs no kind of its own.
declare -A SKILL_HOOKS=() SKILL_AGENTS=()
SKILL_HOOKS_LOADED=

skill_meta_of() { # SKILL.md -> `hooks <name>` and `agents <dir>` declarations
  # Read by shape, not by a YAML parser: this is a list of bare names between
  # two `---` lines, and a dependency to read it would be a dependency in the
  # boot path of every surface. Anything that is not that shape is reported and
  # claims nothing — a skill whose list cannot be read must not silently take
  # its hooks down with it.
  python3 - "$1" <<'PY'
import re, sys
path = sys.argv[1]
try:
    text = open(path).read()
except OSError as exc:
    print(f"agents: {path}: unreadable ({exc}) — no hooks claimed", file=sys.stderr)
    raise SystemExit(0)
m = re.match(r"^---\n(.*?)\n---\s*?\n", text, re.S)
if not m:
    raise SystemExit(0)
names, agents, in_list = [], "", False
for line in m.group(1).split("\n"):
    if in_list:
        item = re.match(r"\s+-\s*(\S+)\s*$", line)
        if item:
            names.append(item.group(1))
            continue
        in_list = False
    key = re.match(r"(hooks|agents):\s*(.*)$", line)
    if not key:
        continue
    field, rest = key.group(1), key.group(2).strip()
    if field == "agents":
        agents = rest.strip("\"'")
        if not agents:
            print(f"agents: {path}: agents: names no directory — none linked",
                  file=sys.stderr)
        continue
    if rest.startswith("["):
        if not rest.endswith("]"):
            print(f"agents: {path}: hooks: list is not closed — no hooks claimed",
                  file=sys.stderr)
            raise SystemExit(0)
        names += [n.strip().strip("\"'") for n in rest[1:-1].split(",")]
    elif rest == "":
        in_list = True
    else:
        print(f"agents: {path}: hooks: {rest} is not a list of names"
              " — no hooks claimed", file=sys.stderr)
        raise SystemExit(0)
for n in names:
    if n:
        print("hooks", n)
if agents:
    print("agents", agents)
PY
}

load_skill_hooks() { # every skill's declarations, read once from its own file
  if [ -n "$SKILL_HOOKS_LOADED" ]; then return 0; fi
  SKILL_HOOKS_LOADED=1
  local s src field val
  for s in "${SKILLS[@]}"; do
    src="$(skill_source "$s")"
    [ -n "$src" ] || continue
    [ -f "$src/SKILL.md" ] || continue
    while read -r field val; do
      [ -n "${val:-}" ] || continue
      case "$field" in
        hooks)
          case " ${HOOKS[*]} " in
            *" $val "*) SKILL_HOOKS["$s"]="${SKILL_HOOKS[$s]:-}${SKILL_HOOKS[$s]:+ }$val" ;;
            *) echo "agents: skill $s declares $val, which is no hook here" \
              "— ignored" >&2 ;;
          esac ;;
        # Relative to the skill's own directory, and normalised here so the
        # sweep in apply can recognise a link by where it points.
        agents) SKILL_AGENTS["$s"]="$(realpath -m "$src/$val")" ;;
      esac
    done < <(skill_meta_of "$src/SKILL.md")
  done
}

skill_is_module() { # a skill that declares anything is a module
  load_skill_hooks
  [ -n "${SKILL_HOOKS[$1]:-}${SKILL_AGENTS[$1]:-}" ]
}

hook_is_claimed() { # does any skill list this hook
  local s
  load_skill_hooks
  for s in "${SKILLS[@]}"; do
    case " ${SKILL_HOOKS[$s]:-} " in *" $1 "*) return 0 ;; esac
  done
  return 1
}

path_of() { # the canonical source file to view or edit for a unit
  case "$1" in
    "$GLOBAL_SLUG") echo "$HOME/code/nixos-config/main/dotfiles/agents/AGENTS.md" ;;
    */*)
      # A row under a directory gate: the instruction file is the directory's
      # source, the memories group is the directory that holds them, and a
      # memory is its own file — in the first account that has it, because every
      # account keeps the same project's memories and one of them is a place to
      # look, not a claim about where it lives.
      load_dirs
      local slug="${1%%/*}" leaf="${1#*/}" md
      case " $GLOBAL_SLUG ${DIRS[*]} " in *" $slug "*) ;;
        *) echo "agents: unknown unit: $1" >&2; exit 2 ;;
      esac
      if [ "$leaf" = AGENTS.md ]; then path_of "$slug"; return; fi
      while IFS= read -r md; do
        if [ "$leaf" = memories ]; then echo "$md"; return; fi
        if [ -f "$md/$leaf" ]; then echo "$md/$leaf"; return; fi
      done < <(mem_dirs "$(dir_path_of "$slug")")
      echo "agents: unknown unit: $1" >&2; exit 2 ;;
    *)
      case " ${HOOKS[*]} " in *" $1 "*) echo "${HOOK_PATHS[$1]}"; return ;; esac
      case " ${SKILLS[*]} " in *" $1 "*) echo "$(skill_source "$1")/SKILL.md"; return ;; esac
      # A member-list module's source is the list — that is the whole unit.
      [ -f "$MODULES_D/$1.json" ] && { echo "$MODULES_D/$1.json"; return; }
      load_dirs
      case " ${DIRS[*]} " in *" $1 "*) dir_source "$1"; return ;; esac
      echo "agents: unknown unit: $1" >&2; exit 2 ;;
  esac
}

sync_dir_path() { # slug directory — the 4th column of one `dir` row
  local tmp="$MANIFEST.tmp.$$"
  awk -v n="$1" -v p="$2" \
    '$1=="dir" && $2==n && (NF<4 || $4!=p) {f=1} END {exit !f}' "$MANIFEST" || return 0
  awk -v n="$1" -v p="$2" \
    '$1=="dir" && $2==n {print $1, $2, $3, p; next} {print}' "$MANIFEST" > "$tmp"
  mv "$tmp" "$MANIFEST"
}

sync_dir_paths() { # the 4th column: where the row's context file is triggered
  # A `dir` row carries its directory past the state column, because the
  # manifest is read directly by Northbridge and the panel renders anything
  # past the state as that row's detail. The registry stays the truth, so a
  # directory that moves is corrected here rather than drifting until a flip.
  # The global row's directory is not in the registry and cannot move: it is
  # the root, and it is written here so every `dir` row reads the same way.
  local i
  sync_dir_path "$GLOBAL_SLUG" "$GLOBAL_DIR"
  for i in "${!DIRS[@]}"; do sync_dir_path "${DIRS[$i]}" "${DIR_PATHS[$i]}"; done
}

hook_claimant() { # the unit a hook's manifest column names
  # The nearest statement of who wants this hook: the unit its fragment follows
  # if it has one, else the first skill whose frontmatter claims it — first
  # ALPHABETICALLY, so two machines reading the same files write the same row.
  local h="$1" s
  if [ -n "${HOOK_FOLLOWS[$h]:-}" ]; then echo "${HOOK_FOLLOWS[$h]}"; return 0; fi
  load_skill_hooks
  for s in $(printf '%s\n' "${SKILLS[@]}" | sort); do
    case " ${SKILL_HOOKS[$s]:-} " in *" $h "*) echo "$s"; return 0 ;; esac
  done
  return 0
}

sync_hook_follows() { # the 4th column: the unit that wants this hook
  # Same contract as sync_dir_paths, and for the same reason: the manifest is
  # read directly by Northbridge, which renders anything past the state as the
  # row's detail — and derives from it which module a hook belongs to. The
  # SOURCES stay the truth, both of them: a re-pointed binding, a dropped
  # `follows`, or a changed skill claim is corrected here rather than drifting
  # until someone flips the hook.
  local h want tmp="$MANIFEST.tmp.$$"
  for h in "${HOOKS[@]}"; do
    want="$(hook_claimant "$h")"
    awk -v n="$h" -v s="$want" \
      '$1=="hook" && $2==n && $4!=s {f=1} END {exit !f}' "$MANIFEST" || continue
    awk -v n="$h" -v s="$want" '
      $1=="hook" && $2==n {
        if (s == "") print $1, $2, $3; else print $1, $2, $3, s
        next
      }
      {print}' "$MANIFEST" > "$tmp"
    mv "$tmp" "$MANIFEST"
  done
}

warn_duplicate_names() {
  # A companion is named bare, so one name meaning two units makes every
  # binding to it ambiguous — and a name is also how `on`/`off`/`path` reach a
  # unit, where the first matching kind silently wins. Warn, loudly, and keep
  # going: the collision is in the inventories,
  # and taking the whole switchboard down over it would strand the user with no
  # way to look or flip.
  local dup
  dup="$(printf '%s\n' "$GLOBAL_SLUG" "${HOOKS[@]}" "${SKILLS[@]}" "${MODULES[@]}" \
    "${OTHERS[@]}" ${DIRS[@]+"${DIRS[@]}"} | sort | uniq -d)"
  [ -n "$dup" ] || return 0
  local d
  while read -r d; do
    echo "agents: duplicate unit name across kinds: $d — companions naming it" \
      "are ambiguous" >&2
  done <<< "$dup"
}

ensure_manifest() {
  mkdir -p "$STATE" "$STATE/skills" "$DIR_TARGETS"
  [ -f "$MANIFEST" ] || : > "$MANIFEST"
  load_dirs
  load_mems
  load_modules
  load_skill_hooks
  warn_duplicate_names
  sync_dir_paths
  sync_hook_follows
  # Merge, don't just seed: an entry added to the arrays after the manifest
  # exists must still appear (off) or it is invisible to status/flip forever.
  local k n i m o s h slug ddir mname
  local -A have=()
  while read -r k n _; do
    [ -n "${k:-}" ] && have["$k $n"]=1
  done < "$MANIFEST"
  # Seeded in the order status reads them, so a fresh manifest and the panel
  # that renders it agree without either sorting the other's output.
  { # Each directory seeds its whole subtree, in the order status renders it:
    # the gate, then what hangs under it. A newly registered directory is inert
    # until it is turned on — registering is "there is context here", not
    # "inject it" — and its instruction file seeds with it, so one flip is not
    # silently two.
    while IFS=$'\t' read -r slug ddir; do
      echo "dir $slug off $ddir"
      echo "ins $slug off"
      # The memories group seeds from REALITY, like a plugin does: a project
      # with a memory directory is a project whose index the binary is already
      # loading, and seeding that off would silently delete it on first apply.
      if [ -n "$(mem_dirs "$ddir")" ]; then echo "memroot $slug on"
      else echo "memroot $slug off"; fi
      # And each memory on, for the same reason: what is in the index today
      # stays in it until somebody says otherwise.
      for mname in ${MEM_NAMES[$slug]:-}; do echo "mem $slug/$mname on"; done
    done < <(dir_rows)
    for m in "${MODULES[@]}"; do echo "module $m off"; done
    for s in "${SKILLS[@]}"; do echo "skill $s off"; done
    # A new hook seeds by its binding, not by a blanket off: bound means
    # something above it — a unit it follows, a skill that declares it — is off
    # until asked for, and unbound means nothing would gate it, so it stays the
    # user's explicit call.
    for h in "${HOOKS[@]}"; do
      n="$(hook_claimant "$h")"
      if [ -n "$n" ]; then echo "hook $h enabled $n"
      else echo "hook $h disabled"; fi
    done
    for o in "${OTHERS[@]}"; do echo "other $o off"; done
  # `rest` is state plus, for a `dir` row, the directory column after it.
  } | while read -r kind name rest; do
    [ -n "${have["$kind $name"]:-}" ] || echo "$kind $name $rest" >> "$MANIFEST"
  done
}

set_state() { # kind name state
  awk -v k="$1" -v n="$2" '$1==k && $2==n {f=1} END {exit !f}' "$MANIFEST" ||
    { echo "agents: unknown: $1 $2" >&2; exit 2; }
  local tmp="$MANIFEST.tmp.$$"
  # Assigning $3 rebuilds the record, so a `dir` row's directory column rides
  # through a flip untouched — only the state field is rewritten.
  awk -v k="$1" -v n="$2" -v s="$3" '{if ($1==k && $2==n) $3=s; print}' "$MANIFEST" > "$tmp"
  mv "$tmp" "$MANIFEST"
}

hook_line() { # name [nested] — ONE state token for one hook, and why if it diverges
  # Both axes are still here; `enabled` is simply never spelled, because `on`
  # already says it and a divergence says it louder — `off (skill: firn off)` is
  # a hook that MAY run and is not running. Only `disabled`, the user's pin, is
  # a word, because that one is a decision rather than a derivation.
  # The parenthetical is why it is not running, or else provenance: who wants
  # this hook. Nested under the skill that wants it, provenance is the row
  # above, so it is not repeated.
  local name="$1" nested="${2:-}" line reason
  # A declared hook whose fragment is not here has no derivation to show, and a
  # missing fragment is already loud where it is read.
  if [ -z "${ACT_STATE[$name]:-}" ]; then echo "(no fragment)"; return 0; fi
  if [ "${ACT_STATE[$name]}" = enabled ]; then line="$(on_off "$name")"
  else line="disabled"; fi
  reason="${ACT_REASON[$name]}"
  if [ -n "$reason" ]; then line="$line ($reason)"
  elif [ -z "$nested" ] && [ -n "${ACT_FOLLOWS[$name]}" ]; then
    line="$line (${ACT_FOLLOWS[$name]})"
  fi
  echo "$line"
}

status() {
  ensure_manifest
  load_activity
  load_skill_hooks
  # Read from the least specific to the most: a set flips units of every
  # kind, a module flips a skill's own hooks, a skill or a hook answers only for
  # itself, and a directory's context is the narrowest thing here — it fires in
  # one subtree and nowhere else — so it reads last. `other` is the drawer, and
  # sits where the general things stop.
  # A MODULE is not a sibling of a skill, it IS one — a skill that declares the
  # hooks its rules need or the agent templates it ships — so modules read as
  # the first thing inside `skills`, each with what it declares nested under it.
  # A skill that declares nothing is a plain skill, and a hook nobody claims
  # answers only to itself.
  local m o s h name slug ddir mname
  # Every row reads NAME then STATE, separated by a colon: the name is what you
  # came looking for and what you would type to flip it, so it is never behind
  # a state token the eye has to step over.
  echo "sets"
  for m in ${MODULES[@]+"${MODULES[@]}"}; do
    printf '  %-21s %s\n' "$m:" "$(unit_line "$m")"
  done
  echo "skills"
  echo "  modules"
  for s in "${SKILLS[@]}"; do
    if ! skill_is_module "$s"; then continue; fi
    printf '    %-19s %s\n' "$s:" "$(unit_line "$s")"
    # The kind is tagged here and nowhere else: this is the only row that sits
    # under a heading which does not already name its kind.
    for h in ${SKILL_HOOKS[$s]:-}; do
      printf '      %-30s %-28s %s\n' "hook · $h:" "$(hook_line "$h" nested)" \
        "${ACT_TAGS[$h]:-}"
    done
  done
  for s in "${SKILLS[@]}"; do
    if skill_is_module "$s"; then continue; fi
    printf '  %-21s %s\n' "$s:" "$(unit_line "$s")"
  done
  echo "hooks"
  for name in ${ACT_HOOKS[@]+"${ACT_HOOKS[@]}"}; do
    if hook_is_claimed "$name"; then continue; fi
    printf '  %-23s %-28s %s\n' "$name:" "$(hook_line "$name")" "${ACT_TAGS[$name]}"
  done
  echo "other"
  for o in "${OTHERS[@]}"; do printf '  %-21s %s\n' "$o:" "$(unit_line "$o")"; done
  # A `dir` row is a SUBTREE GATE — it governs that directory and everything
  # under it — and the global profile is the root-of-tree case, scope `~`, which
  # is why it heads this section. Each reads as the subtree it is: the gate,
  # then the instruction file, the memories group, and each memory, indented
  # because that is the containment. The section says SCOPE, not content type:
  # what hangs off a directory is an instruction file today and its memories now,
  # and whatever else turns out to be scoped at a directory later.
  echo "directory scoped"
  while IFS=$'\t' read -r slug ddir; do
    printf '  %-21s %-24s %s\n' "$slug:" "$(unit_line "$slug")" "$ddir"
    printf '    %-19s %s\n' "AGENTS.md:" "$(unit_line "ins:$slug")"
    printf '    %-19s %s\n' "memories:" "$(unit_line "memroot:$slug")"
    for mname in ${MEM_NAMES[$slug]:-}; do
      printf '      %-17s %s\n' "$mname:" "$(unit_line "mem:$slug/$mname")"
    done
  done < <(dir_rows)
}

check() {
  ensure_manifest
  load_activity
  local on_hooks=() hname all_hook_lines active_hook_lines
  for hname in ${ACT_HOOKS[@]+"${ACT_HOOKS[@]}"}; do
    if is_active "$hname"; then on_hooks+=("$hname"); fi
  done
  printf -v all_hook_lines '%s\n' "${HOOKS[@]}"
  printf -v active_hook_lines '%s\n' "${on_hooks[@]}"
  python3 - "$STATE/activity.conf" "$all_hook_lines" "$active_hook_lines" <<'PY'
import sys

activity_path, all_hooks, active_hooks = sys.argv[1:]
all_hooks = [name for name in all_hooks.split("\n") if name]
active_hooks = [name for name in active_hooks.split("\n") if name]
try:
    rows = dict(line.split()[1:] for line in open(activity_path)
                if line.startswith("hook "))
except Exception as exc:
    raise SystemExit(f"agents: activity projection check failed: {activity_path}: {exc}")
expected = {name: ("on" if name in active_hooks else "off") for name in all_hooks}
if rows != expected:
    raise SystemExit("agents: activity projection drifted")
print(f"checked: {len(active_hooks)} active hooks in the shared activity projection")
PY
}
apply() {
  ensure_manifest
  # Read once, up front: every composition below is decided by ACTIVITY, never
  # by the raw state column. A unit a module holds off is a unit that does not
  # get written, linked, or composed — otherwise the switchboard would say one
  # thing and the surfaces would say another.
  load_activity
  # Admission precedes the shared activity projection.
  local on_hooks=() hname
  for hname in ${ACT_HOOKS[@]+"${ACT_HOOKS[@]}"}; do
    if is_active "$hname"; then on_hooks+=("$hname"); fi
  done
  write_activity_projection
  # The global profile is the context file scoped at the root. It writes the
  # target that ~/.codex/AGENTS.md and ~/.agents/AGENTS.md resolve to.
  # The durable global profile is the source. Optional orchestration and
  # coordination instructions are appended below only when their sets
  # derive active.
  # Every item below degrades on its own: a missing or unreadable source warns
  # and writes empty, and apply keeps going. A source that vanished must not
  # abort the run half-applied — the surfaces written after the failure would
  # keep whatever the previous apply left there, which is a state no manifest
  # describes.
  local agents_target="$STATE/AGENTS.md"
  local agents_src="$HOME/code/nixos-config/main/dotfiles/agents/AGENTS.md"
  # `ins global`, not `dir global`: the dir row is the gate over the whole root
  # subtree now, and the instruction file is the row under it. Activity already
  # carries the gate — ins is own AND dir — so this reads one name and gets both.
  if is_active "ins:$GLOBAL_SLUG" && [ -f "$agents_src" ]; then
    cat "$agents_src" > "$agents_target"
  else
    if is_active "ins:$GLOBAL_SLUG"; then
      echo "agents: ins $GLOBAL_SLUG is on but $agents_src is missing — wrote empty" >&2
    fi
    : > "$agents_target"
  fi
  # An active module's instructions ride on the global surfaces, after the
  # profile and behind a marker that says whose words these are. Inactive means
  # absent: a bundle turned off leaves no trace in what a session reads.
  local mname mfile
  for mname in ${MODULE_INSTRUCTION_ORDER[@]+"${MODULE_INSTRUCTION_ORDER[@]}"}; do
    is_active "$mname" || continue
    mfile="${MODULE_INSTRUCTIONS[$mname]}"
    if [ -f "$mfile" ]; then
      printf '\n\n<!-- module: %s -->\n' "$mname" >> "$agents_target"
      cat "$mfile" >> "$agents_target" ||
        echo "agents: could not append $mfile" >&2
    else
      echo "agents: module $mname is active but $mfile is missing" \
        "— not appended" >&2
    fi
  done
  # Directory instructions — one AGENTS.md slot per registered directory.
  local i slug ddir base dsrc
  for i in "${!DIRS[@]}"; do
    slug="${DIRS[$i]}"; ddir="${DIR_PATHS[$i]}"
    base="$(dir_target_base "$slug")"; dsrc="$(dir_source "$slug")"
    if is_active "ins:$slug" && [ -f "$dsrc" ]; then
      cat "$dsrc" > "$base-AGENTS.md" ||
        { echo "agents: could not write $base-AGENTS.md" >&2; continue; }
    else
      if is_active "ins:$slug"; then
        echo "agents: ins $slug is on but $dsrc is missing — wrote empty" >&2
      fi
      : > "$base-AGENTS.md"
    fi
    link_dir_context "$ddir" "$base"
  done
  # memories — the INDEX, and only the index. Every account keeps its own copy
  # of a project's memory directory (one .md per fact, plus MEMORY.md, which the
  # binary auto-loads at session start), so this walks every account that has
  # one and rewrites MEMORY.md to list exactly the ACTIVE memories, in the words
  # the index already used for them. Content files are never written, never
  # deleted, never moved: a memory turned off keeps its file and loses its line.
  # A closed gate means an empty index — which is how a whole subtree goes quiet
  # without a single fact being touched.
  local mslug mdir mgate mname mactive mem_on=0 mem_all=0
  while IFS=$'\t' read -r mslug mdir; do
    mgate=0
    if is_active "memroot:$mslug"; then mgate=1; fi
    mactive=""
    for mname in ${MEM_NAMES[$mslug]:-}; do
      mem_all=$((mem_all + 1))
      if is_active "mem:$mslug/$mname"; then
        mactive="$mactive$mname"$'\n'
        mem_on=$((mem_on + 1))
      fi
    done
    if ! MEM_ACTIVE="$mactive" MEM_GOVERNED="${MEM_NAMES[$mslug]:-}" \
      python3 - "$ACCOUNTS" "$(project_slug "$mdir")" \
      "$MEM_INDEX_CACHE" "$mslug" "$mgate" <<'PY'
import glob, os, re, sys
accounts, proj, cache_root, slug, gate = sys.argv[1:]
gate = gate == "1"
active = {n for n in os.environ.get("MEM_ACTIVE", "").split("\n") if n}
governed = {n for n in os.environ.get("MEM_GOVERNED", "").split("\n") if n}
LINK = re.compile(r"\]\(([^)]+)\)")

def listed(f): # what belongs in the index this run
    # A memory with no row — a name this switchboard cannot address — is not
    # this switchboard's to filter: its line stays exactly where it was.
    return f in active or f not in governed

def read(path):
    try:
        with open(path) as fh:
            return fh.read()
    except OSError:
        return None

for memdir in sorted(glob.glob(
        os.path.join(accounts, "*", "*", "projects", proj, "memory"))):
    if not os.path.isdir(memdir):
        continue
    parts = os.path.relpath(memdir, accounts).split(os.sep)  # provider/account/...
    cache = os.path.join(cache_root, parts[0], parts[1], slug + ".tsv")
    try:
        files = {f for f in os.listdir(memdir)
                 if f.endswith(".md") and f != "MEMORY.md"
                 and os.path.isfile(os.path.join(memdir, f))}
    except OSError as exc:
        print(f"agents: {memdir}: unreadable ({exc}) — index left alone",
              file=sys.stderr)
        continue

    # What the live index says, in its order: a line naming a memory that is
    # gone goes with it, and a line naming nothing is somebody's prose, carried
    # through untouched rather than rewritten into a shape we prefer.
    index_path = os.path.join(memdir, "MEMORY.md")
    raw = read(index_path)
    preamble, live, live_order = [], {}, []
    for line in (raw.splitlines() if raw else []):
        m = LINK.search(line)
        if not m:
            preamble.append(line)
            continue
        f = os.path.basename(m.group(1))
        if f in files:
            if f not in live:
                live_order.append(f)
            live[f] = line

    # and what an earlier apply filtered OUT of it. That line is the model's
    # words about its own memory and MEMORY.md is the only place they exist, so
    # dropping one would destroy it: the last line seen is kept here and put
    # back in the neighbourhood it came from when the memory is on again.
    cached, cache_order = {}, []
    for row in (read(cache) or "").split("\n"):
        if not row:
            continue
        f, _, line = row.partition("\t")
        if f not in files:
            continue
        if f not in cached:
            cache_order.append(f)
        cached[f] = line

    after, prev = {}, None
    for f in cache_order:
        if f in live:
            prev = f
        else:
            after.setdefault(prev, []).append(f)
    order, seen = [], set()

    def emit(f):
        if f not in seen:
            seen.add(f)
            order.append(f)

    for f in after.get(None, []):
        emit(f)
    for f in live_order:
        emit(f)
        for g in after.get(f, []):
            emit(g)
    # A memory with no line in either place gets none invented: it is a fact
    # nobody indexed, and writing a title for it would be this switchboard
    # putting words in the model's mouth.
    lines_of = dict(cached)
    lines_of.update(live)

    body = [lines_of[f] for f in order if f in lines_of and listed(f)]
    text = ""
    if gate and (preamble or body):
        text = "\n".join(preamble + body) + "\n"
    if raw is None and not text:
        pass  # no index, nothing to list: create nothing
    elif raw != text:
        # A MEMORY.md that is a symlink is not a copy — writing through it would
        # edit somebody else's file — so it is replaced, not followed.
        if os.path.islink(index_path):
            os.unlink(index_path)
        try:
            with open(index_path, "w") as fh:
                fh.write(text)
        except OSError as exc:
            print(f"agents: could not write {index_path} ({exc})", file=sys.stderr)

    keep = [f for f in order if f in lines_of]
    try:
        if keep:
            os.makedirs(os.path.dirname(cache), exist_ok=True)
            tmp = cache + ".next"
            with open(tmp, "w") as fh:
                fh.write("".join(f"{f}\t{lines_of[f]}\n" for f in keep))
            os.replace(tmp, cache)
        elif os.path.exists(cache):
            os.remove(cache)
    except OSError as exc:
        print(f"agents: could not update {cache} ({exc})", file=sys.stderr)
PY
    then
      echo "agents: the memory index for $mslug was left as it was" >&2
    fi
  done < <(dir_rows)
  # skills — a farm of symlinks; only ACTIVE skills exist in the shared farm
  # and Codex's discovery directory.
  # Publish desired links before retiring inactive ones. In particular, never
  # sweep an active link and recreate it: Codex may be reading SKILL.md at that
  # exact moment and its startup scan does not retry an ENOENT.
  local s src
  for s in "${SKILLS[@]}"; do
    if is_active "$s"; then
      src="$(skill_source "$s")"
      if [ -r "$src/SKILL.md" ]; then
        link_skill_atomically "$STATE/skills" "$s" "$src" agents
        link_codex_skill "$s" "$src"
      else echo "agents: skill $s is on but $src/SKILL.md is unreadable — not linked" >&2; fi
    fi
  done
  sweep_state_skills
  sweep_codex_skills
  local on_dirs=0
  for i in "${!DIRS[@]}"; do
    is_active "ins:${DIRS[$i]}" && on_dirs=$((on_dirs + 1))
  done
  echo "applied: $(on_off "ins:$GLOBAL_SLUG") AGENTS.md, ${#on_hooks[@]} hooks, $(find "$STATE/skills" -maxdepth 1 -type l | wc -l) skills, $on_dirs/${#DIRS[@]} dir contexts, $mem_on/$mem_all memories"
}

flip() { # on|off [--all | kind? name]
  local target_state="$1"; shift
  ensure_manifest
  if [ "${1:-}" = "--all" ]; then
    local tmp="$MANIFEST.tmp.$$"
    # Hooks speak permission, everything else speaks activity, so one sweep
    # writes two vocabularies: `on --all` grants every hook and turns every
    # other unit on (so bound hooks go live too), `off --all` revokes every hook
    # outright rather than leaving one armed behind a skill.
    awk -v s="$target_state" '
      $1=="hook" {$3 = (s=="on" ? "enabled" : "disabled"); print; next}
      {$3=s; print}' "$MANIFEST" > "$tmp"
    mv "$tmp" "$MANIFEST"
  else
    local name="${1:?agents: name required}"
    case " ${SKILLS[*]} " in *" $name "*)
      set_state skill "$name" "$target_state"; apply; return ;;
    esac
    # The global profile answers to `on global`, same as any other dir row.
    case " $GLOBAL_SLUG ${DIRS[*]} " in *" $name "*)
      set_state dir "$name" "$target_state"; apply; return ;;
    esac
    case " ${MODULES[*]} " in *" $name "*)
      set_state module "$name" "$target_state"; apply; return ;;
    esac
    case " ${OTHERS[*]} " in *" $name "*)
      set_state other "$name" "$target_state"; apply; return ;;
    esac
    # A row under a directory gate, addressed through it. Read after the flat
    # kinds so a name that legitimately contains a slash — a marketplace plugin,
    # say — is still found where it lives.
    case "$name" in */*)
      local row
      row="$(subtree_row "$name")" ||
        { echo "agents: unknown unit: $name" >&2; exit 2; }
      # Word-split on purpose: subtree_row answers "kind name", and set_state
      # says `unknown` for a memory that is not there.
      # shellcheck disable=SC2086
      set_state $row "$target_state"; apply; return ;;
    esac
    # A direct hook flip writes PERMISSION, the sticky axis: `off`
    # is a pin no skill can undo, `on` grants the hook and everything it
    # cannot be undone by a skill claim.
    local perm
    perm="$([ "$target_state" = on ] && echo enabled || echo disabled)"
    case " ${HOOKS[*]} " in
      *" $name "*) set_state hook "$name" "$perm" ;;
      *) echo "agents: unknown hook: $name" >&2; exit 2 ;;
    esac
  fi
  apply
}

case "${1:-status}" in
  status) status ;;
  check) check ;;
  on)  shift; flip on "$@"; ;;
  off) shift; flip off "$@" ;;
  apply) apply ;;
  path) shift; path_of "${1:?agents: path requires a name}" ;;
  *) echo "usage: agents [status|check] | on|off <name>|--all | path <name> | apply" >&2; exit 2 ;;
esac
