#!/usr/bin/env bash
# Firn keeps this stable command name; North owns the catalog, permission
# transition, activation generation, and every projection it reports.
set -uo pipefail

north_bin="${AGENTS_NORTH_BIN:-north}"

usage() {
  printf 'usage: agents {status [--json]|inspect <id> [--json]|path <id>|on <id>|off <id>|sync}\n' >&2
}

case "${1:-}" in
  status|inspect|path|on|off|sync) ;;
  *)
    usage
    exit 2
    ;;
esac

if ! command -v -- "$north_bin" >/dev/null 2>&1; then
  printf 'agents: North CLI is unavailable: %s\n' "$north_bin" >&2
  exit 2
fi

exec "$north_bin" config agents "$@"
