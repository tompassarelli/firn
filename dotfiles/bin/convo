#!/bin/sh
""":"
exec "${CONVO_PYTHON:-$HOME/.local/libexec/convo/python3}" "$0" "$@"
":"""
"""convo: find past agent work across Claude Code and Codex transcripts.

A pure core (record decoding, query planning, ranking, rendering) sits above a
thin shell (discovery, SQLite indexing, compression, CLI). The index stores
each distinct message text once, so a query never opens a transcript and the
sources may be compressed underneath it.
"""

import argparse
from collections import namedtuple
import fcntl
import hashlib
import json
import os
import re
import sqlite3
import sys
import time

HOME = os.path.expanduser("~")
ROOT = os.path.realpath(os.environ.get(
    "CONVO_ROOT", os.path.join(HOME, "code/north-data/accounts")))
STATE = os.environ.get("CONVO_STATE", os.path.join(HOME, ".local/state/convo"))
SCHEMA_VERSION = 4
DB = os.path.join(STATE, f"index-v{SCHEMA_VERSION}.db")
LOCK = DB + ".lock"

LINE_CAP = 1 << 20
TEXT_CAP = 32 << 10
CHUNK = 1 << 20
BATCH = 5000
HEAD_BYTES = 4096
LOCK_WAIT_S = 1.5
CANDIDATES = 400
RELAX_BELOW = 3
SHOW_CAP = 8000

ZSTD = os.environ.get("CONVO_ZSTD", "zstd")
# 2^27 is the standard decoder's window limit, so plain `zstd -d` reads these back.
ZSTD_ARGS = ("-3", "--long=27")
CLOSED_AFTER_S = 48 * 3600
BAND_RATIOS = ((256 << 20, 15.83), (64 << 20, 7.13), (8 << 20, 5.70),
               (1 << 20, 4.25), (0, 4.00))

SCHEMA = """
CREATE TABLE meta(k TEXT PRIMARY KEY, v TEXT);
CREATE TABLE files(
  id INTEGER PRIMARY KEY, path TEXT UNIQUE NOT NULL, dev INTEGER, ino INTEGER,
  size INTEGER NOT NULL DEFAULT 0, dsize INTEGER NOT NULL DEFAULT 0,
  zst INTEGER NOT NULL DEFAULT 0, mtime REAL, head TEXT,
  off INTEGER NOT NULL DEFAULT 0, nline INTEGER NOT NULL DEFAULT 0,
  provider TEXT, account TEXT, project TEXT, session_id TEXT, agent TEXT,
  title TEXT, cwd TEXT, branch TEXT, first_ts TEXT, last_ts TEXT,
  nmsg INTEGER NOT NULL DEFAULT 0);
CREATE INDEX files_session ON files(session_id);
CREATE TABLE msg(
  id INTEGER PRIMARY KEY, file_id INTEGER NOT NULL, line INTEGER NOT NULL,
  ts TEXT, role TEXT, tool TEXT, body INTEGER NOT NULL,
  dup INTEGER NOT NULL DEFAULT 0);
CREATE INDEX msg_file ON msg(file_id, line);
CREATE INDEX msg_ts ON msg(ts);
CREATE INDEX msg_body ON msg(body);
CREATE TABLE body(id INTEGER PRIMARY KEY, h INTEGER NOT NULL UNIQUE,
  first INTEGER NOT NULL, text TEXT NOT NULL);
CREATE VIRTUAL TABLE ftx USING fts5(text, content='', contentless_delete=1,
  tokenize='porter unicode61 remove_diacritics 2');
"""

ROLES = ("user", "assistant", "thinking", "tool", "system")
PROVIDERS = {"claude": "anthropic", "codex": "openai"}
PROVIDER_NAME = {v: k for k, v in PROVIDERS.items()}


# ------------------------------------------------------------- core: records

TOOL_KEYS = ("skill", "command", "cmd", "file_path", "path", "pattern", "query",
             "prompt", "description", "old_string", "new_string", "url",
             "content")
INJECTED = ("base directory for this skill:", "[request interrupted by user",
            "stop hook feedback:", "caveat:", "[image:", "# agents.md instructions",
            "this session is being continued from a previous conversation",
            "another claude session sent", "the coordinator sent a message",
            "[system notification", "[north real-time ping")
TAG = re.compile(r"</?(?:task-notification|system-reminder|local-command-[a-z]+|command-[a-z]+|"
                 r"user-prompt-submit-hook|environment_context|user_instructions|"
                 r"recommended_plugins|codex_internal_context|turn_aborted|image|"
                 r"subagent_notification)\b")


def clip(s):
    return s.strip()[:TEXT_CAP] if isinstance(s, str) else ""


def speaker(role, text):
    """Harness-injected text recorded under the user role is `system`."""
    if role == "user" and (TAG.match(text) or text[:80].lower().startswith(INJECTED)):
        return "system"
    return role


def tool_text(name, args):
    if isinstance(args, str):
        try:
            parsed = json.loads(args)
        except ValueError:
            parsed = None
        if isinstance(parsed, dict):
            args = parsed
    if isinstance(args, dict):
        parts = [f"{k}={args[k]}" for k in TOOL_KEYS
                 if isinstance(args.get(k), str) and args[k].strip()]
        body = "\n".join(parts) if parts else json.dumps(args)[:2000]
    else:
        body = args if isinstance(args, str) else ""
    return clip(f"{name} {body}")


def extract_claude(d):
    """Claude Code record -> ([(role, text, tool)], meta)."""
    meta = {}
    for src, key in (("sessionId", "session_id"), ("cwd", "cwd"),
                     ("gitBranch", "branch"), ("slug", "slug")):
        if isinstance(d.get(src), str) and d[src]:
            meta[key] = d[src]
    t = d.get("type")
    if t == "ai-title":
        if isinstance(d.get("aiTitle"), str) and d["aiTitle"]:
            meta["title"] = d["aiTitle"]
        return [], meta
    m = d.get("message")
    if t not in ("user", "assistant") or not isinstance(m, dict):
        return [], meta
    c = m.get("content")
    blocks = [{"type": "text", "text": c}] if isinstance(c, str) else (
        c if isinstance(c, list) else [])
    injected = t == "user" and (d.get("isMeta") or d.get("isCompactSummary"))
    out = []
    for b in blocks:
        if not isinstance(b, dict):
            continue
        kind, tool = b.get("type"), None
        if kind == "text":
            role, s = t, clip(b.get("text"))
        elif kind == "thinking":
            role, s = "thinking", clip(b.get("thinking"))
        elif kind == "tool_use":
            tool = b.get("name") or "tool"
            role, s = "tool", tool_text(tool, b.get("input"))
        else:
            continue
        if s:
            out.append(("system" if injected else speaker(role, s), s, tool))
    return out, meta


def extract_codex(d):
    """Codex rollout record -> ([(role, text, tool)], meta)."""
    p, t = d.get("payload"), d.get("type")
    if not isinstance(p, dict):
        return [], {}
    if t == "session_meta":
        meta = {}
        sid = p.get("session_id") or p.get("id")
        if isinstance(sid, str) and sid:
            meta["session_id"] = sid
            if isinstance(p.get("id"), str) and p["id"] != sid:
                meta["agent"] = p["id"]
        for src, key in (("cwd", "cwd"), ("agent_nickname", "title")):
            if isinstance(p.get(src), str) and p[src]:
                meta[key] = p[src]
        return [], meta
    if t != "response_item":
        return [], {}
    kind, out = p.get("type"), []
    if kind == "message" and p.get("role") != "developer":
        role = p.get("role") or "user"
        c = p.get("content")
        texts = [c] if isinstance(c, str) else [
            b.get("text") for b in (c if isinstance(c, list) else [])
            if isinstance(b, dict) and b.get("type") in ("input_text", "output_text", "text")]
        out = [(speaker(role, s), s, None) for s in map(clip, texts) if s]
    elif kind == "reasoning":
        blocks = [b for key in ("summary", "content")
                  if isinstance(p.get(key), list) for b in p[key]]
        out = [("thinking", s, None) for s in
               (clip(b.get("text")) for b in blocks if isinstance(b, dict)) if s]
    elif kind in ("function_call", "custom_tool_call"):
        tool = p.get("name") or "tool"
        args = p.get("arguments") if p.get("arguments") is not None else p.get("input")
        out = [("tool", tool_text(tool, args), tool)]
    return out, {}


def wanted(kind, line):
    """Cheap byte test that rejects records the decoder would drop anyway."""
    if kind == "codex":
        head = line[:200]
        return b"response_item" in head or b"session_meta" in head
    return CLAUDE_KEEP.search(line) is not None


CLAUDE_KEEP = re.compile(rb'"type": ?"(?:user|assistant|ai-title)"')


def scan_lines(fh, start, chunk=CHUNK):
    """Yield (start, end, bytes or None) per complete line; None past LINE_CAP."""
    base = line_start = start
    buf, over = bytearray(), False
    while True:
        data = fh.read(chunk)
        if not data:
            return
        pos = 0
        while True:
            nl = data.find(b"\n", pos)
            if nl < 0:
                seg = data[pos:]
                if not over:
                    if len(buf) + len(seg) > LINE_CAP:
                        over, buf = True, bytearray()
                    else:
                        buf += seg
                break
            seg = data[pos:nl]
            line = None if over or len(buf) + len(seg) > LINE_CAP else bytes(buf + seg)
            end = base + nl + 1
            yield line_start, end, line
            buf, over, pos, line_start = bytearray(), False, nl + 1, end
        base += len(data)


def text_hash(text):
    """(64-bit signed hash, text safe to store) for one message."""
    try:
        raw = text.encode()
    except UnicodeEncodeError:
        text = text.encode("utf-8", "replace").decode()
        raw = text.encode()
    return int.from_bytes(hashlib.blake2b(raw, digest_size=8).digest(),
                          "big", signed=True), text


def short_project(project):
    s = project or ""
    for pre in ("-home-tom-code-client-", "-home-tom-code-", "-home-tom-"):
        if s.startswith(pre):
            return s[len(pre):]
    return "home" if s == "-home-tom" else (s.lstrip("-") or "?")


# ---------------------------------------------------------- core: queries

WORD = re.compile(r"\w+")
OPERATORS = ("AND", "OR", "NOT")


Plan = namedtuple("Plan", "match partial literal terms")


def quote(s):
    return '"' + s.replace('"', '""') + '"'


def plan_query(text, exact=False, strict=False):
    words = [w.lower() for w in WORD.findall(text)]
    if not words:
        return None
    plain = " ".join(quote(w) for w in words)
    if exact:
        lit = " ".join(text.split())
        return Plan([quote(lit)], None, lit, words)
    parts, explicit = [], False
    for tok in re.findall(r'"[^"]*"?|[()]|[^\s()"]+', text):
        if tok in OPERATORS or tok in ("(", ")"):
            explicit = True
            parts.append(tok)
        elif re.fullmatch(r"\w+\*", tok):
            parts.append(quote(tok[:-1]) + "*")
        elif WORD.search(tok.strip('"')):
            parts.append(quote(tok.strip('"')))
    match = [" ".join(parts)] + ([plain] if explicit else [])
    distinct = list(dict.fromkeys(words))
    partial = (" OR ".join(quote(w) for w in distinct)
               if not (explicit or strict) and len(distinct) > 1 else None)
    return Plan(match, partial, None, words)


def norm(s):
    return " ".join(s.split()).lower()


UNITS = {"h": 3600, "d": 86400, "w": 7 * 86400, "m": 30 * 86400, "y": 365 * 86400}


def parse_when(s, now):
    """`12h`, `3d`, `2w`, `6m`, `1y`, or an ISO date -> UTC ISO string."""
    m = re.fullmatch(r"(\d+)\s*([hdwmy])", s.strip())
    if m:
        return time.strftime("%Y-%m-%dT%H:%M:%S",
                             time.gmtime(now - int(m.group(1)) * UNITS[m.group(2)]))
    if re.fullmatch(r"\d{4}-\d\d-\d\d([T ][\d:.]+Z?)?", s.strip()):
        return s.strip().replace(" ", "T")
    raise ValueError(f"cannot read time {s!r}: use 12h, 3d, 2w, 6m, 1y or YYYY-MM-DD")


# ---------------------------------------------------------- core: ranking

ROLE_WEIGHT = {"user": 1.0, "assistant": 1.0, "thinking": 0.8, "tool": 0.8,
               "system": 0.4}
CONVO_CALL = re.compile(r"(?:^|[\s;&|(`'\"=])convo(?:\s|$)")
STACK = (1.0, 0.5, 0.25)
PHRASE_BOOST = 3.0


def stem(term):
    return term[:max(4, len(term) - 2)]


def is_convo_call(hit):
    return hit["role"] == "tool" and bool(CONVO_CALL.search(hit["text"]))


def phrase_of(terms):
    """The query words as typed, adjacent and in order."""
    if len(terms) < 2:
        return None
    return re.compile(r"\b" + r"\W+".join(map(re.escape, terms)) + r"\b", re.I)


def weigh(hit, phrase=None):
    w = -hit["bm25"] * ROLE_WEIGHT.get(hit["role"], 1.0)
    return w * PHRASE_BOOST if phrase and phrase.search(hit["text"]) else w


def rank_messages(hits, self_ids=frozenset(), keep_calls=False, terms=()):
    """Weighted hits, best first; the caller's own session sorts last."""
    phrase = phrase_of(terms)
    kept = [dict(h, w=weigh(h, phrase)) for h in hits if keep_calls or not is_convo_call(h)]
    return sorted(kept, key=lambda h: (h["session"] in self_ids, -h["w"], -h["id"]))


def rank_sessions(hits, terms, self_ids=frozenset(), keep_calls=False, coverage=False):
    """Group hits by session: best hit plus decaying credit for the next two.

    With `coverage` (the OR fallback), a session's score is scaled by the
    square of the share of query terms its hits contain.
    """
    groups = {}
    for h in rank_messages(hits, self_ids, keep_calls, terms):
        g = groups.setdefault(h["session"], {"session": h["session"], "best": h,
                                             "scores": [], "hits": 0, "seen": set()})
        g["hits"] += 1
        g["scores"].append(h["w"])
        if coverage:
            low = h["text"].lower()
            g["seen"].update(t for t in terms if stem(t) in low)
    keys = set(map(stem, terms))
    for g in groups.values():
        g["score"] = sum(w * s for w, s in zip(STACK, g["scores"]))
        if coverage and keys:
            g["score"] *= (len(set(map(stem, g["seen"]))) / len(keys)) ** 2
    return sorted(groups.values(), key=lambda g: (
        g["session"] in self_ids, -g["score"], -g["best"]["id"]))


def snippet(text, terms, width=200):
    """The `width`-character window holding the most distinct query terms."""
    flat = " ".join(text.split())
    if len(flat) <= width:
        return flat
    low = flat.lower()
    keys = set(map(stem, terms))
    pos = sorted((m.start(), k) for k in keys for m in re.finditer(re.escape(k), low))[:400]
    best, most = 0, 0
    for i, (p, _) in enumerate(pos):
        n = len({k for q, k in pos[i:] if q < p + width * 3 // 4})
        if n > most:
            best, most = p, n
    a = max(0, min(best - width // 4, len(flat) - width))
    return ("…" if a else "") + flat[a:a + width] + ("…" if a + width < len(flat) else "")


# --------------------------------------------------------- core: rendering

class Palette:
    def __init__(self, on):
        b, d, c, y, o = ("\033[1m", "\033[2m", "\033[36m", "\033[33m", "\033[0m") if on \
            else ("",) * 5
        self.bold, self.dim, self.cyan, self.yellow, self.off = b, d, c, y, o


def stamp(ts):
    return (ts or "")[:16].replace("T", " ")


def who(h):
    return f"{h['role']}:{h['tool']}" if h.get("tool") else h["role"]


def describe(info, h):
    sid = os.path.basename(h["session"] or "")[:8]
    agent = f"/{h['agent'][:8]}" if h.get("agent") else ""
    return sid + agent, short_project(info.get("project") or h.get("project"))


def full_lines(h, indent="   "):
    text = h["text"][:SHOW_CAP]
    more = len(h["text"]) - len(text)
    lines = [indent + ln for ln in text.splitlines() if ln.strip()]
    return lines + ([f"{indent}… {more} more chars: convo show {h['id']} --full"] if more else [])


def render_sessions(groups, infos, terms, pal, full=False):
    out = []
    for i, g in enumerate(groups, 1):
        if g.get("partial") and (i == 1 or not groups[i - 2].get("partial")):
            out.append(f"{pal.dim}no message in these sessions has every word; "
                       f"ranked by words covered{pal.off}")
        h, info = g["best"], infos.get(g["session"], {})
        sid, proj = describe(info, h)
        title = (info.get("title") or "")[:60]
        out.append(f"{pal.dim}{i:2d}{pal.off} {pal.bold}{sid}{pal.off}  {stamp(h['ts'])}  "
                   f"{pal.cyan}{proj}{pal.off}  {title}  "
                   f"{pal.dim}({info.get('provider', '?')}, {g['hits']} hit{'s' * (g['hits'] != 1)}){pal.off}")
        if full:
            out.append(f"   {pal.yellow}{who(h)}{pal.off} [{h['id']}]")
            out.extend(full_lines(h))
        else:
            out.append(f"   {pal.yellow}{who(h)}{pal.off} · {snippet(h['text'], terms)}  "
                       f"{pal.dim}[{h['id']}]{pal.off}")
    out.append(f"{pal.dim}open: convo show <id>  ·  transcripts: convo session <session>{pal.off}")
    return out


def render_messages(hits, infos, terms, pal, full=False, partial=False):
    out = []
    if partial:
        out.append(f"{pal.dim}no message has every term; showing partial matches{pal.off}")
    for i, h in enumerate(hits, 1):
        sid, proj = describe(infos.get(h["session"], {}), h)
        head = (f"{pal.dim}{i:2d}{pal.off} {stamp(h['ts'])}  {pal.bold}{sid}{pal.off}  "
                f"{pal.cyan}{proj}{pal.off}  {pal.yellow}{who(h)}{pal.off}")
        if full:
            out.append(f"{head}  [{h['id']}]")
            out.extend(full_lines(h))
        else:
            out.append(f"{head} · {snippet(h['text'], terms, 160)}  {pal.dim}[{h['id']}]{pal.off}")
    return out


def as_json(h, info, terms, hits=None, full=False):
    row = {"session": h["session"], "agent": h.get("agent"), "title": info.get("title"),
           "project": short_project(info.get("project") or h.get("project")),
           "provider": info.get("provider"), "id": h["id"], "ts": h["ts"],
           "role": h["role"], "tool": h.get("tool"),
           "snippet": snippet(h["text"], terms), "path": h["path"], "line": h["line"]}
    if hits is not None:
        row["hits"] = hits
    if full:
        row["text"] = h["text"]
    return row


# ------------------------------------------------------- shell: discovery

class Unreconciled(Exception):
    """A configured transcript root could not take part in this refresh."""


SESSION_FILE = re.compile(r"[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}\.jsonl(?:\.zst)?")


def transcript_roots():
    """Configured (root, provider, account, layout), de-duplicated by real path."""
    if os.environ.get("CONVO_ROOT"):
        candidates = [(ROOT, "", "", "accounts", True, "CONVO_ROOT")]
    else:
        codex, pooled = os.environ.get("CODEX_HOME"), os.environ.get("NORTH_CODEX_POOLED_HOME")
        claude = os.environ.get("CLAUDE_CONFIG_DIR")
        candidates = [
            (ROOT, "", "", "accounts", False, "account transcript root"),
            (codex, "openai", "configured", "codex", bool(codex), "CODEX_HOME"),
            (pooled, "openai", "pooled", "codex", bool(pooled), "NORTH_CODEX_POOLED_HOME"),
            (os.path.join(HOME, ".local/state/north/codex-pooled"), "openai", "pooled",
             "codex", False, "default pooled transcript root"),
            (claude and os.path.join(claude, "projects"), "anthropic", "local", "claude",
             bool(claude), "CLAUDE_CONFIG_DIR projects"),
            (os.path.join(HOME, ".claude/projects"), "anthropic", "local", "claude",
             False, "Claude Code projects root"),
        ]
    out, seen = [], set()
    for root, provider, account, layout, required, label in candidates:
        if not root:
            continue
        canonical = os.path.realpath(os.path.expanduser(root))
        if not os.path.isdir(canonical):
            if required:
                raise Unreconciled(f"{label} is unavailable: {canonical}")
            continue
        try:
            os.scandir(canonical).close()
        except OSError as e:
            raise Unreconciled(f"{label} is unreadable: {canonical}: {e}") from e
        if canonical not in seen:
            seen.add(canonical)
            out.append((canonical, provider, account, layout))
    return out


def listdir(path):
    try:
        return sorted(os.listdir(path))
    except OSError as e:
        raise Unreconciled(f"configured transcript tree is unreadable: {path}: {e}") from e


def claude_dirs(base):
    """Only <project>/<session>.jsonl and <project>/<session>/subagents/*.jsonl."""
    for project in listdir(base):
        pdir = os.path.join(base, project)
        if not os.path.isdir(pdir):
            continue
        entries = listdir(pdir)
        yield pdir, [e for e in entries if SESSION_FILE.fullmatch(e)], project
        for name in entries:
            sub = os.path.join(pdir, name, "subagents")
            if os.path.isdir(sub):
                yield sub, listdir(sub), project


def codex_dirs(base):
    def fail(e):
        raise Unreconciled(f"configured transcript tree is unreadable: {e.filename}: {e}")
    for dirpath, dirnames, filenames in os.walk(base, onerror=fail):
        dirnames.sort()
        yield dirpath, sorted(filenames), ""


def discover(roots=None):
    """Yield (logical, disk, provider, account, project_hint, kind, stat).

    `logical` names the `.jsonl`; `disk` may be `<logical>.zst`. When both
    exist the plain file wins, because a writer may still append to it. A file
    reached twice through symlinks or hardlinks is yielded once.
    """
    seen = set()
    for root, provider0, account0, layout in (transcript_roots() if roots is None else roots):
        if layout == "claude":
            trees = [(provider0, account0, root, "claude")]
        elif layout == "codex":
            trees = [(provider0, account0 or os.path.basename(root),
                      os.path.join(root, "sessions"), "codex")]
        else:
            trees = [(p, a, os.path.join(root, p, a, sub), kind)
                     for p in listdir(root) if os.path.isdir(os.path.join(root, p))
                     for a in listdir(os.path.join(root, p))
                     for sub, kind in (("sessions", "codex"), ("projects", "claude"))]
        for provider, account, base, kind in trees:
            if not os.path.isdir(base):
                continue
            walk = claude_dirs(base) if kind == "claude" else codex_dirs(base)
            for dirpath, names, hint in walk:
                here = set(names)
                for fn in names:
                    if fn.endswith(".jsonl"):
                        logical = disk = f"{dirpath}/{fn}"
                    elif fn.endswith(".jsonl.zst") and fn[:-4] not in here:
                        logical, disk = f"{dirpath}/{fn[:-4]}", f"{dirpath}/{fn}"
                    else:
                        continue
                    try:
                        st = os.stat(disk)
                    except OSError:
                        continue
                    if (st.st_dev, st.st_ino) in seen:
                        continue
                    seen.add((st.st_dev, st.st_ino))
                    yield logical, disk, provider, account, hint, kind, st


# -------------------------------------------------------- shell: indexing

class Source:
    """A transcript opened for forward reading; `.zst` goes through a pipe."""

    def __init__(self, disk, start):
        self.proc, self._head = None, None
        if disk.endswith(".zst"):
            import subprocess
            self.proc = subprocess.Popen([ZSTD, "-dcq", "--", disk],
                                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            self.fh, self._head = self.proc.stdout, bytearray()
        else:
            self.fh = open(disk, "rb", buffering=0)
            self.fh.seek(start)
            try:
                os.posix_fadvise(self.fh.fileno(), 0, 0, os.POSIX_FADV_SEQUENTIAL)
            except (AttributeError, OSError):
                pass

    def read(self, n):
        b = self.fh.read(n)
        if self._head is not None and len(self._head) < HEAD_BYTES:
            self._head += b[:HEAD_BYTES - len(self._head)]
        return b

    def head(self):
        return hashlib.sha256(bytes(self._head)).hexdigest()

    def close(self):
        self.fh.close()
        return self.proc is None or self.proc.wait() == 0


def head_hash(path, n):
    """Hash of the first n bytes: an append keeps it, a rewrite changes it."""
    try:
        with open(path, "rb") as fh:
            b = fh.read(n)
    except OSError:
        return None
    return hashlib.sha256(b).hexdigest() if len(b) == n else None


def connect(readonly=False):
    if readonly:
        con = sqlite3.connect(f"file:{DB}?mode=ro", uri=True)
    else:
        os.makedirs(STATE, exist_ok=True)
        con = sqlite3.connect(DB)
        if not con.execute("SELECT 1 FROM sqlite_master WHERE name = 'ftx'").fetchone():
            con.executescript(f"BEGIN;{SCHEMA}COMMIT;")
        con.execute("PRAGMA journal_mode=WAL")
        con.execute("PRAGMA synchronous=NORMAL")
    con.execute("PRAGMA temp_store=MEMORY")
    con.execute("PRAGMA cache_size=-64000")
    con.row_factory = sqlite3.Row
    return con


def forget(con, fid):
    """Drop a file's messages; texts it introduced move to their next occurrence."""
    firsts = con.execute(
        "SELECT m.id, m.body FROM msg m JOIN body b ON b.id = m.body AND b.first = m.id "
        "WHERE m.file_id = ?", (fid,)).fetchall()
    con.executemany("DELETE FROM ftx WHERE rowid = ?", [(r[0],) for r in firsts])
    con.execute("DELETE FROM msg WHERE file_id = ?", (fid,))
    for _, bid in firsts:
        nxt = con.execute("SELECT MIN(id) FROM msg WHERE body = ?", (bid,)).fetchone()[0]
        if nxt is None:
            con.execute("DELETE FROM body WHERE id = ?", (bid,))
        else:
            con.execute("UPDATE body SET first = ? WHERE id = ?", (nxt, bid))
            con.execute("UPDATE msg SET dup = 0 WHERE id = ?", (nxt,))
            con.execute("INSERT INTO ftx(rowid, text) SELECT ?, text FROM body WHERE id = ?",
                        (nxt, bid))
    con.execute("UPDATE files SET off = 0, nline = 0, nmsg = 0 WHERE id = ?", (fid,))


def store(con, fid, pend, next_id):
    """Insert pending (line, ts, role, tool, text); each distinct text is indexed once."""
    hashed = [text_hash(p[4]) for p in pend]
    known = {}
    uniq = list({h for h, _ in hashed})
    for i in range(0, len(uniq), 500):
        part = uniq[i:i + 500]
        known.update(con.execute(
            f"SELECT h, id FROM body WHERE h IN ({','.join('?' * len(part))})", part))
    msgs, bodies = [], []
    for (line, ts, role, tool, _), (h, text) in zip(pend, hashed):
        mid = next_id
        next_id += 1
        bid = known.get(h)
        if bid is None:
            bid = known[h] = mid
            bodies.append((mid, h, mid, text))
        msgs.append((mid, fid, line, ts, role, tool, bid, int(bid != mid)))
    con.executemany("INSERT INTO msg(id, file_id, line, ts, role, tool, body, dup) "
                    "VALUES(?,?,?,?,?,?,?,?)", msgs)
    con.executemany("INSERT INTO body(id, h, first, text) VALUES(?,?,?,?)", bodies)
    con.executemany("INSERT INTO ftx(rowid, text) VALUES(?,?)", [(b[0], b[3]) for b in bodies])
    con.execute("INSERT OR REPLACE INTO meta(k, v) VALUES('next_id', ?)", (str(next_id),))
    return next_id


def same_inode(path, st):
    try:
        o = os.stat(path)
    except OSError:
        return False
    return (o.st_dev, o.st_ino) == (st.st_dev, st.st_ino)


def plan_refresh(con, roots):
    """Return (todo, adopted): files to read and archives adopted without reading."""
    cur = con.cursor()
    cur.row_factory = None
    known = {r[0]: r[1:] for r in cur.execute("SELECT path, dev, ino, dsize, zst, mtime FROM files")}
    by_ino = {(v[0], v[1]): p for p, v in known.items()}
    todo, adopted = [], 0
    for path, disk, provider, account, hint, kind, st in discover(roots):
        is_zst, v, alias = disk != path, known.get(path), path
        if v is None:
            alias = by_ino.get((st.st_dev, st.st_ino))
            if alias is None or not same_inode(alias, st):
                todo.append((path, disk, provider, account, hint, kind, st, None, False))
                continue
        elif (v[:4] == (st.st_dev, st.st_ino, st.st_size, int(is_zst))
              and abs(st.st_mtime - (v[4] or 0)) < 1e-3):
            continue
        row = con.execute("SELECT id, path, dev, ino, size, dsize, zst, mtime, head, off, nline "
                          "FROM files WHERE path = ?", (alias,)).fetchone()
        if alias != path:
            con.execute("UPDATE files SET path = ? WHERE id = ?", (path, row["id"]))
        same = abs(st.st_mtime - (row["mtime"] or 0)) < 1e-3
        if (bool(row["zst"]) == is_zst and row["ino"] == st.st_ino and row["dev"] == st.st_dev
                and st.st_size == row["dsize"] and same):
            continue
        complete = row["size"] > 0 and row["off"] == row["size"]
        if (is_zst != bool(row["zst"]) and complete and same
                and (is_zst or st.st_size == row["size"])):
            con.execute("UPDATE files SET zst=?, dev=?, ino=?, dsize=?, mtime=? WHERE id=?",
                        (int(is_zst), st.st_dev, st.st_ino, st.st_size, st.st_mtime, row["id"]))
            adopted += 1
            continue
        h = None if is_zst else head_hash(path, min(row["size"], HEAD_BYTES))
        reset = (is_zst or row["ino"] != st.st_ino or row["dev"] != st.st_dev
                 or st.st_size < row["off"] or st.st_size == row["dsize"]
                 or h is None or h != row["head"])
        todo.append((path, disk, provider, account, hint, kind, st, row, reset))
    return todo, adopted


def read_file(con, item, next_id, progress):
    """Index one transcript from its last offset. Returns (next_id, added)."""
    path, disk, provider, account, hint, kind, st, row, reset = item
    is_zst = disk != path
    if row is not None and reset:
        forget(con, row["id"])
    if row is None:
        agent = None
        if os.path.basename(os.path.dirname(path)) == "subagents":
            agent = os.path.basename(path)[:-6].removeprefix("agent-")
        fid = con.execute(
            "INSERT INTO files(path, dev, ino, provider, account, project, agent) "
            "VALUES(?,?,?,?,?,?,?)",
            (path, st.st_dev, st.st_ino, provider, account, hint, agent)).lastrowid
        start = line_no = 0
    else:
        fid = row["id"]
        start, line_no = (0, 0) if reset else (row["off"], row["nline"])
    extract = extract_claude if kind == "claude" else extract_codex
    meta, pend, added, first_ts, last_ts, off = {}, [], 0, None, None, start
    try:
        src = Source(disk, start)
    except OSError:
        return next_id, 0
    try:
        for ls, le, line in scan_lines(src, start):
            line_no, off = line_no + 1, le
            progress.b += le - ls
            if line is None or not wanted(kind, line):
                continue
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if not isinstance(d, dict):
                continue
            msgs, mu = extract(d)
            meta.update(mu)
            ts = d.get("timestamp") if isinstance(d.get("timestamp"), str) else None
            if ts:
                first_ts, last_ts = first_ts or ts, ts
            pend.extend((line_no, ts, role, tool, text) for role, text, tool in msgs)
            if len(pend) >= BATCH:
                next_id = store(con, fid, pend, next_id)
                added += len(pend)
                progress.m += len(pend)
                save(con, fid, off, line_no, meta, hint, first_ts, last_ts, len(pend))
                pend = []
                con.commit()
                progress.tick()
        next_id = store(con, fid, pend, next_id)
        added += len(pend)
        progress.m += len(pend)
        if not is_zst and st.st_size > 16 << 20:
            try:
                os.posix_fadvise(src.fh.fileno(), 0, 0, os.POSIX_FADV_DONTNEED)
            except (AttributeError, OSError):
                pass
    finally:
        intact = src.close()
    if not intact:
        forget(con, fid)
        con.execute("UPDATE files SET size=0, dsize=0 WHERE id=?", (fid,))
        con.commit()
        sys.stderr.write(f"convo: unreadable archive, skipped: {disk}\n")
        return next_id, 0
    save(con, fid, off, line_no, meta, hint, first_ts, last_ts, len(pend))
    con.execute(
        "UPDATE files SET size=?, dsize=?, zst=?, mtime=?, head=?, dev=?, ino=? WHERE id=?",
        (off if is_zst else st.st_size, st.st_size, int(is_zst), st.st_mtime,
         src.head() if is_zst else head_hash(path, min(st.st_size, HEAD_BYTES)), st.st_dev, st.st_ino,
         fid))
    return next_id, added


def save(con, fid, off, line_no, meta, hint, first_ts, last_ts, n):
    """Checkpoint a file's offset with the metadata and count read up to it."""
    con.execute(
        "UPDATE files SET off=?, nline=?, "
        "session_id=COALESCE(?, session_id), agent=COALESCE(?, agent), "
        "title=COALESCE(?, title, ?), cwd=COALESCE(?, cwd), branch=COALESCE(?, branch), "
        "project=COALESCE(NULLIF(?, ''), project), first_ts=COALESCE(first_ts, ?), "
        "last_ts=COALESCE(?, last_ts), nmsg=nmsg+? WHERE id=?",
        (off, line_no, meta.get("session_id"), meta.get("agent"), meta.get("title"),
         meta.get("slug"), meta.get("cwd"), meta.get("branch"), slug(meta.get("cwd")) or hint,
         first_ts, last_ts, n, fid))


def slug(cwd):
    return cwd.replace("/", "-") if cwd else ""


class Progress:
    def __init__(self, files, total, quiet):
        self.tf, self.tb, self.f, self.b, self.m = files, total, 0, 0, 0
        self.t0, self.last = time.time(), 0.0
        self.on = not quiet and sys.stderr.isatty()

    def tick(self):
        now = time.time()
        if not self.on or now - self.last < 1.0:
            return
        self.last = now
        rate = self.b / max(now - self.t0, 1e-9)
        eta = (self.tb - self.b) / rate if rate else 0
        sys.stderr.write(f"\r\033[Kindexing {self.f}/{self.tf} files  "
                         f"{self.b / 2**30:.1f}/{self.tb / 2**30:.1f} GiB  "
                         f"{self.m} msgs  eta {int(eta // 60)}m{int(eta % 60):02d}s")

    def done(self):
        if self.on:
            sys.stderr.write("\r\033[K")


def index(con, quiet=False, verbose=False):
    """Incremental pass over every configured root. Returns (files, msgs, bytes)."""
    roots = transcript_roots()
    todo, adopted = plan_refresh(con, roots)
    if adopted:
        con.commit()
    total = sum(it[6].st_size - (0 if it[7] is None or it[8] else it[7]["off"]) for it in todo)
    if total > 64 << 20:
        try:
            os.nice(10)
        except OSError:
            pass
    progress = Progress(len(todo), total, quiet)
    next_id = max(1 + con.execute("SELECT COALESCE(MAX(id), 0) FROM msg").fetchone()[0],
                  1 + con.execute("SELECT COALESCE(MAX(id), 0) FROM body").fetchone()[0],
                  int(con.execute("SELECT COALESCE(MAX(v), 0) FROM meta WHERE k = 'next_id'")
                      .fetchone()[0]))
    added = uncommitted = 0
    for item in todo:
        next_id, n = read_file(con, item, next_id, progress)
        added, uncommitted = added + n, uncommitted + n
        if uncommitted >= BATCH:
            con.commit()
            uncommitted = 0
        progress.f += 1
        if verbose and n:
            sys.stderr.write(f"\r\033[K{n:6d} msgs  {item[0]}\n")
        progress.tick()
    progress.done()
    con.execute("INSERT OR REPLACE INTO meta(k, v) VALUES('last_index', ?), ('last_roots', ?)",
                (str(time.time()), json.dumps([r[0] for r in roots])))
    con.commit()
    return len(todo), added, progress.b


def refresh(quiet=False, verbose=False, wait=LOCK_WAIT_S, rebuild=False):
    """Run an incremental pass under the index lock; None if the lock stayed busy."""
    os.makedirs(STATE, exist_ok=True)
    fd = os.open(LOCK, os.O_CREAT | os.O_RDWR, 0o644)
    try:
        deadline = time.monotonic() + wait
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if time.monotonic() >= deadline:
                    return None
                time.sleep(0.02)
        for suffix in ("", "-wal", "-shm") if rebuild else ():
            try:
                os.unlink(DB + suffix)
            except FileNotFoundError:
                pass
        con = connect()
        try:
            return index(con, quiet=quiet, verbose=verbose)
        finally:
            con.close()
    finally:
        os.close(fd)


# ---------------------------------------------------------- shell: queries

COLUMNS = ("m.id, m.file_id, m.line, m.ts, m.role, m.tool, m.body, {score} AS bm25, "
           "f.session_id, f.agent, f.path, f.project, f.provider")
FIRST_PASSING = ("WITH h AS MATERIALIZED (SELECT {columns} FROM ftx JOIN msg o ON o.id = ftx.rowid "
                 "JOIN msg m ON m.body = o.body JOIN files f ON f.id = m.file_id WHERE {where}) "
                 "SELECT MIN(id) AS id, file_id, line, ts, role, tool, body, bm25, session_id, "
                 "agent, path, project, provider FROM h GROUP BY body ORDER BY bm25 LIMIT ?")


class Filters:
    def __init__(self, args, now):
        self.where, self.params = [], []
        if args.role:
            roles = [r.strip() for r in args.role.split(",") if r.strip()]
            bad = [r for r in roles if r not in ROLES]
            if bad:
                raise ValueError(f"unknown role {bad[0]!r}: use {', '.join(ROLES)}")
            self.add(f"m.role IN ({','.join('?' * len(roles))})", *roles)
        if args.tool:
            self.add("m.tool = ? COLLATE NOCASE", args.tool)
        if args.project:
            self.add("f.project LIKE ?", f"%{args.project}%")
        if args.provider:
            self.add("f.provider = ?", PROVIDERS[args.provider])
        if args.since:
            self.add("m.ts >= ?", parse_when(args.since, now))
        if args.until:
            self.add("m.ts < ?", parse_when(args.until, now))
        if args.session:
            sid = args.session.strip().lower().split("/")[-1].removeprefix("agent-")
            self.add("m.file_id IN (SELECT id FROM files WHERE session_id LIKE ? "
                     "OR agent LIKE ?)", sid + "%", sid + "%")
        self.keep_calls = bool(args.role or args.tool)
        self.session = bool(args.session)

    def add(self, clause, *params):
        self.where.append(clause)
        self.params.extend(params)


def as_hits(con, rows):
    texts = {}
    ids = list({r["body"] for r in rows})
    for i in range(0, len(ids), 500):
        part = ids[i:i + 500]
        texts.update(con.execute(
            f"SELECT id, text FROM body WHERE id IN ({','.join('?' * len(part))})", part))
    return [{"id": r["id"], "line": r["line"], "ts": r["ts"], "role": r["role"],
             "tool": r["tool"], "bm25": r["bm25"], "session": r["session_id"] or r["path"],
             "agent": r["agent"], "path": r["path"], "project": r["project"],
             "text": texts.get(r["body"], "")} for r in rows]


def fetch(con, expr, flt, k, literal=None):
    """Top k hits by bm25. A text is indexed at its first occurrence, so with
    filters every occurrence is searched and the first one that passes is kept."""
    text_of = "o.body" if flt.where else "m.body"
    where = ["ftx MATCH ?"] + flt.where
    if literal:
        con.create_function("has_literal", 1, lambda t: literal in norm(t or ""),
                            deterministic=True)
        where.append(f"has_literal((SELECT text FROM body WHERE id = {text_of}))")
    columns = COLUMNS.format(score="bm25(ftx)")
    if flt.where:
        sql = FIRST_PASSING.format(columns=columns, where=" AND ".join(where))
    else:
        sql = (f"SELECT {columns} FROM ftx JOIN msg m ON m.id = ftx.rowid "
               f"JOIN files f ON f.id = m.file_id WHERE {' AND '.join(where)} "
               "ORDER BY bm25 LIMIT ?")
    return as_hits(con, con.execute(sql, [expr] + flt.params + [k]).fetchall())


def recent(con, flt, k):
    where = flt.where if flt.session else ["m.dup = 0"] + flt.where
    sql = (f"SELECT {COLUMNS.format(score='0')} FROM msg m JOIN files f ON f.id = m.file_id "
           f"WHERE {' AND '.join(where) or '1'} ORDER BY m.ts DESC LIMIT ?")
    return as_hits(con, con.execute(sql, flt.params + [k]).fetchall())


def session_info(con, sessions):
    """Per session: title, project and provider, preferring the main transcript."""
    keys = [s for s in sessions if s]
    info = {}
    for i in range(0, len(keys), 500):
        part = keys[i:i + 500]
        for r in con.execute(
                "SELECT session_id, title, project, provider, agent FROM files "
                f"WHERE session_id IN ({','.join('?' * len(part))}) "
                "ORDER BY agent IS NOT NULL, nmsg DESC", part):
            d = info.setdefault(r["session_id"], {
                "project": r["project"], "provider": PROVIDER_NAME.get(r["provider"], r["provider"])})
            d.setdefault("title", None)
            if not d["title"] and r["title"]:
                d["title"] = r["title"]
    return info


def self_sessions():
    return frozenset(v for v in (os.environ.get("CLAUDE_CODE_SESSION_ID"),
                                 os.environ.get("CODEX_THREAD_ID")) if v)


def gather(con, expr, flt, terms, mine, literal=None, coverage=False):
    """Hits and ranked sessions; widens the candidate set while it is full and
    every candidate was dropped, so a miss is never an artefact of the limit."""
    k = CANDIDATES
    while True:
        hits = fetch(con, expr, flt, k, literal)
        groups = rank_sessions(hits, terms, mine, flt.keep_calls, coverage)
        if groups or len(hits) < k:
            return hits, groups
        k *= 8


def cmd_search(con, args, pal):
    now = time.time()
    flt = Filters(args, now)
    mine = self_sessions()
    text = " ".join(args.query)
    if not text.strip():
        return emit_messages(con, recent(con, flt, args.limit or 20), [], args, pal, False)
    plan = plan_query(text, exact=args.exact, strict=args.all_terms)
    if plan is None:
        sys.stderr.write("convo: the query has no searchable words\n")
        return 2
    hits, groups, partial = [], [], False
    for expr in plan.match:
        try:
            hits, groups = gather(con, expr, flt, plan.terms, mine,
                                  plan.literal and norm(plan.literal))
            break
        except sqlite3.OperationalError:
            continue
    limit = args.limit or (20 if args.messages else 10)
    if len(groups) < RELAX_BELOW and plan.partial:
        known = {g["session"] for g in groups}
        loose, extra = gather(con, plan.partial, flt, plan.terms, mine, coverage=True)
        extra = [g for g in extra if g["session"] not in known]
        for g in extra:
            g["partial"] = True
        groups = sorted(groups + extra, key=lambda g: g["session"] in mine)
        if not hits:
            hits, partial = loose, True
    if not groups:
        print(f"no matches for {text!r}" + (" with these filters" if flt.where else ""))
        return 1
    if args.messages:
        return emit_messages(con, rank_messages(hits, mine, flt.keep_calls, plan.terms)[:limit],
                             plan.terms, args, pal, partial)
    groups = groups[:limit]
    infos = session_info(con, [g["session"] for g in groups])
    if args.json:
        print_json([dict(as_json(g["best"], infos.get(g["session"], {}), plan.terms,
                                 g["hits"], args.full), partial=g.get("partial", False))
                    for g in groups])
    else:
        print("\n".join(render_sessions(groups, infos, plan.terms, pal, args.full)))
    return 0


def print_json(rows):
    print("[\n" + ",\n".join(json.dumps(r, ensure_ascii=False) for r in rows) + "\n]")


def emit_messages(con, hits, terms, args, pal, partial):
    if not hits:
        print("no messages match these filters")
        return 1
    infos = session_info(con, [h["session"] for h in hits])
    if args.json:
        print_json([dict(as_json(h, infos.get(h["session"], {}), terms, full=args.full),
                         partial=partial) for h in hits])
    else:
        print("\n".join(render_messages(hits, infos, terms, pal, args.full, partial)))
    return 0


def cmd_show(con, args, pal):
    rc, rows = 0, []
    for ref in args.query:
        mid = int(re.sub(r"\D", "", ref) or 0)
        r = con.execute(
            "SELECT m.id, m.file_id, m.line, m.ts, m.role, m.tool, b.text, f.session_id, "
            "f.agent, f.path, f.project, f.title, f.provider FROM msg m "
            "JOIN body b ON b.id = m.body JOIN files f ON f.id = m.file_id WHERE m.id = ?",
            (mid,)).fetchone()
        if r is None:
            sys.stderr.write(f"convo: no message {ref}\n")
            rc = 1
            continue
        h = dict(r)
        if args.json:
            h["session"] = h["session_id"] or h["path"]
            info = {"title": h["title"], "project": h["project"],
                    "provider": PROVIDER_NAME.get(h["provider"], h["provider"])}
            rows.append(as_json(h, info, [], full=True))
            continue
        text = h["text"][:SHOW_CAP if not args.full else TEXT_CAP]
        agent = f" · agent {h['agent']}" if h["agent"] else ""
        print(f"{pal.bold}{h['session_id']}{pal.off}{agent} · "
              f"{pal.cyan}{short_project(h['project'])}{pal.off} · {h['title'] or ''} · "
              f"{PROVIDER_NAME.get(h['provider'], h['provider'])}")
        print(f"{stamp(h['ts'])}  {pal.yellow}{who(h)}{pal.off}  [{h['id']}]  "
              f"{pal.dim}{h['path']}:{h['line']}{pal.off}")
        print(text)
        if len(h["text"]) > len(text):
            print(f"{pal.dim}… {len(h['text']) - len(text)} more chars (--full){pal.off}")
        ctx = args.context
        if ctx:
            near = con.execute(
                "SELECT * FROM (SELECT m.id, m.line, m.ts, m.role, m.tool, b.text FROM msg m "
                "JOIN body b ON b.id = m.body WHERE m.file_id = ? AND (m.line, m.id) < (?, ?) "
                "ORDER BY m.line DESC, m.id DESC LIMIT ?) UNION ALL "
                "SELECT * FROM (SELECT m.id, m.line, m.ts, m.role, m.tool, b.text FROM msg m "
                "JOIN body b ON b.id = m.body WHERE m.file_id = ? AND (m.line, m.id) > (?, ?) "
                "ORDER BY m.line, m.id LIMIT ?)",
                (h["file_id"], h["line"], h["id"], ctx) * 2).fetchall()
            near.sort(key=lambda n: (n["line"], n["id"]))
            print(f"{pal.dim}context{pal.off}")
            for n in near:
                n = dict(n)
                mark = "↑" if (n["line"], n["id"]) < (h["line"], h["id"]) else "↓"
                print(f"  {mark} [{n['id']}] {stamp(n['ts'])[11:]}  {pal.yellow}{who(n)}{pal.off} · "
                      f"{snippet(n['text'], [], 150)}")
    if args.json:
        print_json(rows)
    return rc


def cmd_session(con, args, pal):
    sid = args.query[0].strip().lower().split("/")[-1].removeprefix("agent-")
    rows = con.execute(
        "SELECT * FROM files WHERE session_id LIKE ? OR agent LIKE ? "
        "ORDER BY agent IS NOT NULL, first_ts", (sid + "%", sid + "%")).fetchall()
    sessions = {r["session_id"] for r in rows}
    if len(sessions) > 1:
        print(f"{sid} matches {len(sessions)} sessions; give more characters:")
        for s in sorted(sessions, key=str)[:args.limit or 20]:
            print(f"  {s}")
        return 0
    live = [r for r in rows if r["nmsg"]]
    shown = rows if args.verbose else live
    limit = args.limit or 20
    if shown:
        full = rows[0]["session_id"]
        print(f"{pal.bold}{full}{pal.off}  {len(live)} transcripts")
        main = next((r for r in rows if not r["agent"] and r["nmsg"]), None)
        if main is not None:
            ask = con.execute(
                "SELECT b.text FROM msg m JOIN body b ON b.id = m.body "
                "WHERE m.file_id = ? AND m.role = 'user' ORDER BY m.line LIMIT 1",
                (main["id"],)).fetchone()
            if ask:
                print(f"  ask · {snippet(ask[0], [], 200)}")
        for r in shown[:limit]:
            span = f"{stamp(r['first_ts'])} → {stamp(r['last_ts'])[11:]}"
            agent = f"agent {r['agent'][:12]}  " if r["agent"] else ""
            print(f"  {pal.cyan}{short_project(r['project'])}{pal.off}  {span}  "
                  f"{r['nmsg']} msgs  {agent}{r['title'] or ''}")
            print(f"    {pal.dim}{r['path']}{pal.off}")
        if len(shown) > limit:
            print(f"  {pal.dim}… {len(shown) - limit} more (-n){pal.off}")
        if len(rows) > len(live) and not args.verbose:
            print(f"  {pal.dim}({len(rows) - len(live)} files without messages; -v lists them){pal.off}")
    mentions = []
    if len(sid) >= 6:
        try:
            mentions = con.execute(
                "SELECT f.session_id, COUNT(*) n, MAX(m.ts) last FROM ftx "
                "JOIN msg m ON m.id = ftx.rowid JOIN files f ON f.id = m.file_id "
                "WHERE ftx MATCH ? AND COALESCE(f.session_id, '') NOT LIKE ? "
                "GROUP BY f.session_id ORDER BY last DESC LIMIT ?",
                (quote(sid), sid + "%", limit)).fetchall()
        except sqlite3.OperationalError:
            pass
    if not shown and not mentions:
        print(f"no transcript or mention found for {sid}")
        return 1
    if mentions:
        print(f"{pal.bold}mentioned in {len(mentions)} other session(s){pal.off}")
        for r in mentions:
            print(f"  {(r['session_id'] or '?')[:8]}  {stamp(r['last'])}  {r['n']} msgs")
    return 0


def cmd_status(con, args, pal):
    f = con.execute("SELECT COUNT(*) n, SUM(size) b, SUM(dsize) d, SUM(nmsg) m, SUM(zst) z "
                    "FROM files").fetchone()
    texts = con.execute("SELECT COUNT(*) FROM body").fetchone()[0]
    size = sum(os.path.getsize(DB + s) for s in ("", "-wal") if os.path.exists(DB + s))
    meta = dict(con.execute("SELECT k, v FROM meta").fetchall())
    logical, disk = f["b"] or 0, f["d"] or 0
    print(f"index    {DB}  {size / 2**20:.1f} MiB")
    print(f"corpus   {logical / 2**30:.1f} GiB in {f['n']} transcripts, "
          f"{disk / 2**30:.1f} GiB on disk ({f['z'] or 0} compressed)")
    print(f"messages {f['m'] or 0} ({texts} distinct texts)")
    if "last_index" in meta:
        print(f"updated  {time.time() - float(meta['last_index']):.0f}s ago")
    if "last_roots" in meta:
        print(f"roots    {len(json.loads(meta['last_roots']))} reconciled")
    print("top projects")
    for r in con.execute("SELECT project, SUM(nmsg) m FROM files GROUP BY project "
                         "ORDER BY m DESC LIMIT 8"):
        print(f"  {short_project(r['project']):<28} {r['m']}")
    return 0


# ------------------------------------------------------- shell: compression

UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", re.I)


class Unsafe(Exception):
    """Closure cannot be proven. Never caught to continue a file."""


def open_files():
    """(paths, unseen, others): transcripts any process holds open, read from /proc.

    `unseen` names this user's non-dumpable processes, whose fd tables no tool
    can read; other users' hidden processes are only counted.
    """
    live, unseen, others, me = set(), [], 0, os.getuid()
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        fdd = os.path.join("/proc", pid, "fd")
        try:
            names = os.listdir(fdd)
        except FileNotFoundError:
            continue
        except OSError:
            if pid_uid(pid) == me:
                unseen.append(pid_comm(pid))
            else:
                others += 1
            continue
        for n in names:
            try:
                t = os.readlink(os.path.join(fdd, n)).removesuffix(" (deleted)")
            except OSError:
                continue
            if t.startswith("/") and (t.endswith(".jsonl") or t.endswith(".jsonl.zst")):
                live.add(t)
    return live, unseen, others


def pid_comm(pid):
    try:
        with open(os.path.join("/proc", pid, "comm")) as fh:
            return fh.read().strip() or pid
    except OSError:
        return pid


def pid_uid(pid):
    try:
        with open(os.path.join("/proc", pid, "status")) as fh:
            for ln in fh:
                if ln.startswith("Uid:"):
                    return int(ln.split()[1])
    except (OSError, ValueError, IndexError):
        return None
    return None


def coordinator_ids():
    """Session ids the coordinator accounts for; failure aborts the sweep."""
    import shlex
    import subprocess
    cmd = shlex.split(os.environ.get("CONVO_ROSTER_CMD", "north agents --json"))
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=180)
    except (OSError, subprocess.SubprocessError) as e:
        raise Unsafe(f"could not ask the coordinator which sessions are live: {e}")
    if r.returncode != 0:
        raise Unsafe("the coordinator refused to report live sessions: "
                     + (r.stderr.strip().splitlines() or [f"exit {r.returncode}"])[-1])
    try:
        d = json.loads(r.stdout)
    except ValueError as e:
        raise Unsafe(f"the coordinator roster was not readable JSON: {e}")
    if d.get("version") != "north:agent-roster:v1" or not isinstance(d.get("agents"), list):
        raise Unsafe("the coordinator roster is not north:agent-roster:v1")
    return {m.lower() for row in d["agents"] if isinstance(row, dict)
            for v in row.values() if isinstance(v, str) for m in UUID_RE.findall(v)}


def fsync_path(path):
    fd = os.open(path, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def round_trips(archive, original):
    import subprocess
    d = subprocess.Popen([ZSTD, "-dcq", "--", archive], stdout=subprocess.PIPE,
                         stderr=subprocess.DEVNULL)
    try:
        c = subprocess.Popen(["cmp", "-s", "-", "--", original], stdin=d.stdout,
                             stderr=subprocess.DEVNULL)
    finally:
        d.stdout.close()
    return c.wait() == 0 and d.wait() == 0


def compress_one(path, st):
    """Write, verify, prove the source never moved, publish, then unlink."""
    import subprocess
    dst = path + ".zst"
    tmp = f"{dst}.tmp{os.getpid()}"
    try:
        if os.path.exists(dst) and round_trips(dst, path):
            os.unlink(path)
            return os.path.getsize(dst)
        r = subprocess.run([ZSTD, *ZSTD_ARGS, "-q", "-f", "-o", tmp, "--", path],
                           stderr=subprocess.PIPE, text=True)
        if r.returncode != 0:
            raise Unsafe(f"zstd failed: {r.stderr.strip()}")
        if not round_trips(tmp, path):
            raise Unsafe("round-trip did not reproduce the original")
        now = os.stat(path)
        if (now.st_ino, now.st_dev, now.st_size, now.st_mtime) != (
                st.st_ino, st.st_dev, st.st_size, st.st_mtime):
            raise Unsafe("the transcript was written during compression")
        fsync_path(tmp)
        os.utime(tmp, (st.st_atime, st.st_mtime))
        os.replace(tmp, dst)
        fsync_path(os.path.dirname(path))
        os.unlink(path)
        fsync_path(os.path.dirname(path))
        return os.path.getsize(dst)
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def gib(n):
    return f"{n / 2**30:.2f} GiB"


def cmd_compress(args, pal):
    roots = transcript_roots()
    cutoff = time.time() - args.older_than * 3600
    live, unseen, hidden = open_files()
    roster = coordinator_ids()
    eligible, total, index_only = [], 0, 0
    skip_open = skip_live = skip_hot = warm = 0
    for path, disk, _p, _a, _h, kind, st in discover(roots):
        if disk != path:
            continue
        if kind == "claude":
            index_only += 1
            continue
        total += 1
        if path in live or path + ".zst" in live:
            skip_open += 1
        elif any(sid in path.lower() for sid in roster):
            skip_live += 1
        elif st.st_mtime > cutoff:
            skip_hot, warm = skip_hot + 1, warm + st.st_size
        else:
            eligible.append((path, st))
    eligible.sort(key=lambda e: -e[1].st_size)
    eligible = eligible[:args.max_files] if args.max_files else eligible
    ebytes = sum(st.st_size for _, st in eligible)
    print(f"corpus     {total} uncompressed transcripts under "
          f"{pal.dim}{', '.join(r[0] for r in roots)}{pal.off}")
    print(f"never      {index_only} Claude transcripts (index-only)")
    print(f"eligible   {len(eligible)} files  {gib(ebytes)}  "
          f"(untouched for {args.older_than:g}h, no open fd, not on the roster)")
    print(f"held back  {skip_hot} still warm ({gib(warm)}) · {skip_open} open by a process · "
          f"{skip_live} named by a coordinator lane")
    if unseen:
        names = sorted(set(unseen))
        print(f"unseen     {len(unseen)} of this user's processes hide their open files "
              f"({', '.join(names[:6])}{f', +{len(names) - 6}' if len(names) > 6 else ''})")
    if hidden:
        print(f"           {hidden} more belong to other users")
    if not eligible:
        return 0
    if args.dry_run:
        after = sum(next(st.st_size / r for floor, r in BAND_RATIOS if st.st_size >= floor)
                    for _, st in eligible)
        print(f"projected  {gib(ebytes)} → {gib(after)}  saving {gib(ebytes - after)} "
              f"({ebytes / after:.2f}x, from measured band ratios)")
        return 0
    t0, done, failed, was, after = time.time(), 0, 0, 0, 0
    for i, (path, st) in enumerate(eligible, 1):
        try:
            after += compress_one(path, st)
            was, done = was + st.st_size, done + 1
        except (Unsafe, OSError) as e:
            failed += 1
            sys.stderr.write(f"convo: left alone: {path}: {e}\n")
        if not args.quiet and sys.stderr.isatty():
            sys.stderr.write(f"\r\033[Kcompressing {i}/{len(eligible)}  {gib(after)} written")
    if not args.quiet and sys.stderr.isatty():
        sys.stderr.write("\r\033[K")
    print(f"compressed {done} files  {gib(was)} → {gib(after)}  saving {gib(was - after)}"
          + (f" ({was / after:.2f}x)" if after else "") + f"  in {time.time() - t0:.0f}s")
    if failed:
        print(f"{pal.yellow}left alone {failed} file(s); see above{pal.off}")
    return 0


def cmd_restore(args, pal):
    """Turn `.jsonl.zst` back into `.jsonl`; zstd's frame checksum proves integrity."""
    import subprocess
    rc = 0
    for name in args.query:
        logical = name.removesuffix(".zst")
        src = logical + ".zst"
        if not os.path.exists(src) or os.path.exists(logical):
            sys.stderr.write(f"convo: {'no archive at ' + src if not os.path.exists(src) else logical + ' already exists'}\n")
            rc = 1
            continue
        tmp = f"{logical}.tmp{os.getpid()}"
        try:
            r = subprocess.run([ZSTD, "-dq", "-f", "-o", tmp, "--", src],
                               stderr=subprocess.PIPE, text=True)
            if r.returncode != 0:
                sys.stderr.write(f"convo: {src}: {r.stderr.strip()}\n")
                rc = 1
                continue
            st = os.stat(src)
            os.utime(tmp, (st.st_atime, st.st_mtime))
            fsync_path(tmp)
            os.replace(tmp, logical)
            fsync_path(os.path.dirname(logical))
            os.unlink(src)
            fsync_path(os.path.dirname(logical))
            print(f"restored {logical} ({gib(os.path.getsize(logical))})")
        finally:
            try:
                os.unlink(tmp)
            except OSError:
                pass
    return rc


# ------------------------------------------------------------------- CLI

CMDS = ("search", "show", "session", "status", "index", "compress", "restore")
VALUE_OPTS = {"-n", "--limit", "-p", "--project", "-r", "--role", "-t", "--tool",
              "--since", "--until", "-s", "--session", "--provider", "--color",
              "-C", "--context", "--older-than", "--max-files"}

EPILOG = """\
commands:
  convo [search] TERMS     sessions ranked by relevance (default command)
  convo show ID…           one message in full, with -C neighbours
  convo session ID         a session's transcripts, its first ask, and mentions
  convo status | index [--full] | compress [--dry-run] | restore FILE…

query:
  words must all appear in one message; a token with punctuation
  (c289-ko-bottom, tools/x.ts) is matched as a phrase; "quoted phrase",
  AND/OR/NOT, ( ) and prefix* work. Stemmed: test matches tests.
  A message holding the words as typed, adjacent and in order, ranks higher.
  When fewer than three sessions have a message with every word, sessions
  covering the most words follow, marked partial (-a disables this).
  -x matches the literal string.

output:
  one entry per session: id prefix, best-hit time, project, title, hit count,
  then the best message's role, snippet and [id]. -m lists messages instead.
  --json keys: session agent title project provider id ts role tool snippet
  path line hits partial (text with --full; show --json always has text).
  Times are UTC.

exit: 0 found · 1 conclusive miss · 2 inconclusive (index busy, root
missing, -u) or bad usage. Calls to convo itself are not results; the
current session (CLAUDE_CODE_SESSION_ID, CODEX_THREAD_ID) ranks last.

examples:
  convo stage backdrop contrast           where was this discussed?
  convo -r user --since 3d tests          what did the human say?
  convo -t Bash -x 'wisp pad --helper'    which exact command ran?
  convo -r user --since 1d                newest human messages, no query
  convo show 4276825 -C 3                 read a hit with context
"""


def parse_args(argv):
    i, cmd = 0, None
    while i < len(argv):
        a = argv[i]
        if a in VALUE_OPTS:
            i += 2
        elif a.startswith("-"):
            i += 1
        else:
            if a in CMDS:
                cmd, argv = a, argv[:i] + argv[i + 1:]
            break
    p = argparse.ArgumentParser(
        prog="convo", formatter_class=argparse.RawDescriptionHelpFormatter,
        description="find past agent work across Claude Code and Codex transcripts",
        epilog=EPILOG)
    p.add_argument("query", nargs="*", help="search terms, or the id for show/session")
    p.add_argument("-x", "--exact", action="store_true", help="literal string")
    p.add_argument("-a", "--all-terms", action="store_true",
                   help="no partial-match fallback")
    p.add_argument("-r", "--role", metavar="ROLE",
                   help="user|assistant|thinking|tool|system, comma-separated")
    p.add_argument("-t", "--tool", metavar="NAME", help="tool calls of one tool (Bash, Skill…)")
    p.add_argument("-p", "--project", metavar="NAME", help="project name substring")
    p.add_argument("-s", "--session", metavar="ID", help="session or subagent id prefix")
    p.add_argument("--provider", choices=tuple(PROVIDERS), help="claude or codex")
    p.add_argument("--since", metavar="WHEN", help="12h, 3d, 2w, 6m, 1y or YYYY-MM-DD")
    p.add_argument("--until", metavar="WHEN", help="same forms as --since")
    p.add_argument("-m", "--messages", action="store_true", help="list messages, not sessions")
    p.add_argument("-n", "--limit", type=int, default=0,
                   help="results (10 sessions or 20 messages)")
    p.add_argument("--full", action="store_true",
                   help="whole message text; with index: rebuild from scratch")
    p.add_argument("-C", "--context", type=int, default=2, metavar="N",
                   help="show: neighbouring messages (default 2)")
    p.add_argument("--json", action="store_true")
    p.add_argument("-u", "--no-update", action="store_true",
                   help="skip the refresh; a miss is then inconclusive")
    p.add_argument("-q", "--quiet", action="store_true")
    p.add_argument("-v", "--verbose", action="store_true")
    p.add_argument("--color", choices=("auto", "always", "never"), default="auto")
    p.add_argument("--dry-run", action="store_true", help="compress: report only")
    p.add_argument("--older-than", type=float, metavar="HOURS", default=CLOSED_AFTER_S / 3600,
                   help="compress: only transcripts untouched this long")
    p.add_argument("--max-files", type=int, default=0, metavar="N",
                   help="compress: only the N largest eligible files")
    args = p.parse_args(argv)
    args.cmd = cmd or "search"
    if args.cmd in ("show", "session", "restore") and not args.query:
        p.error(f"{args.cmd} needs an argument")
    return p, args


def main(argv=None):
    p, args = parse_args(list(sys.argv[1:] if argv is None else argv))
    pal = Palette(args.color == "always" or (args.color == "auto" and sys.stdout.isatty()))
    if args.cmd == "restore":
        return cmd_restore(args, pal)
    if args.cmd == "compress":
        if not (args.dry_run or args.no_update) and os.path.exists(DB):
            refresh(quiet=args.quiet)
        return cmd_compress(args, pal)
    if args.cmd == "index":
        t0 = time.time()
        r = refresh(quiet=args.quiet, verbose=args.verbose, rebuild=args.full)
        if r is None:
            sys.stderr.write("convo: another index run holds the lock\n")
            return 2
        print(f"indexed {r[1]} messages from {r[0]} changed files "
              f"({r[2] / 2**30:.2f} GiB read) in {time.time() - t0:.1f}s")
        return 0
    if args.cmd == "search" and not args.query and not any(
            (args.role, args.tool, args.project, args.session, args.since, args.until,
             args.provider)):
        p.print_help()
        return 0
    if not os.path.exists(DB):
        sys.stderr.write("convo: no index yet; build it once with `convo index` "
                         "(reads every transcript; run it under a machine-capacity lease)\n")
        return 2
    issue = "update disabled" if args.no_update else None
    if not args.no_update and refresh(quiet=True) is None:
        issue = "index lock busy"
    con = connect(readonly=True)
    try:
        if args.cmd == "status":
            return cmd_status(con, args, pal)
        if args.cmd == "show":
            return cmd_show(con, args, pal)
        try:
            rc = cmd_session(con, args, pal) if args.cmd == "session" else cmd_search(con, args, pal)
        except ValueError as e:
            sys.stderr.write(f"convo: {e}\n")
            return 2
        if issue and rc == 1:
            sys.stderr.write(f"convo: refresh inconclusive ({issue}); a miss proves nothing\n")
            return 2
        if issue and rc == 0 and not args.no_update:
            sys.stderr.write(f"convo: refresh inconclusive ({issue}); results may be stale\n")
        return rc
    finally:
        con.close()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Unsafe as e:
        sys.stderr.write(f"convo: refusing to sweep: {e}\n")
        sys.exit(3)
    except Unreconciled as e:
        sys.stderr.write(f"convo: refresh inconclusive: {e}\n")
        sys.exit(2)
    except BrokenPipeError:
        os._exit(0)
    except KeyboardInterrupt:
        sys.stderr.write("\ninterrupted (index progress is committed)\n")
        sys.exit(130)
