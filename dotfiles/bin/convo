#!/bin/sh
""":"
exec "${CONVO_PYTHON:-$HOME/.local/libexec/convo/python3}" "$0" "$@"
":"""
"""convo — full-text search over local agent conversation transcripts.

Indexes JSONL transcripts under the configured North account and Codex homes into a SQLite
FTS5 index at ~/.local/state/convo/index.db, then searches it.

The index is self-sufficient: it stores the extracted message text alongside
the postings, so a query never opens a transcript. The whole indexable text of
a 87 GiB corpus is under a gigabyte — the transcripts are base64 image payload
and compaction replays, not conversation. Keeping the text here is what lets
the sources be compressed, moved, or archived underneath it. The (file, offset)
locator survives as provenance for the path:line each hit prints.

`convo compress` is the other half: it rewrites closed transcripts as
`.jsonl.zst`, which the indexer reads transparently.
"""

import argparse
import fcntl
import hashlib
import json
import os
import re
import shlex
import sqlite3
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
# north-data is the canonical tree; ~/.local/state/north is a symlink to it.
# Scanning both would read the same 75 GiB twice.
ROOT = os.path.realpath(os.environ.get(
    "CONVO_ROOT", os.path.join(HOME, "code/north-data/accounts")))
STATE = os.environ.get("CONVO_STATE", os.path.join(HOME, ".local/state/convo"))
DB = os.path.join(STATE, "index.db")
LOCK = os.path.join(STATE, "index.lock")

# A line longer than this is a compaction replay, a base64 image, or a dumped
# build log. None of those are conversation, and all of them are unbounded.
LINE_CAP = 1 << 20
# Longest single extracted message kept. Anything past this is machine output.
TEXT_CAP = 32 << 10
CHUNK = 1 << 20
COMMIT_EVERY = 20000

ZSTD = os.environ.get("CONVO_ZSTD", "zstd")
# -3 with a 128 MiB window. The window is the whole story on this corpus: a
# Codex rollout repeats its entire history in every compaction record, tens of
# megabytes apart, so the default window finds 1.5x and this finds 19x. 2^27 is
# exactly the standard decoder's maximum, so `zstd -d` reads it back with no
# flags — anything larger would need --memory= at every read site forever.
ZSTD_ARGS = ("-3", "--long=27")
# A transcript is compressible once nothing can still be appending to it.
CLOSED_AFTER_S = 48 * 3600
# Ratios measured 2026-08-12 over a stratified 90-file sample at the settings
# above, keyed by file size. Only ever used to project a --dry-run; a real run
# reports the ratio it actually achieved.
BAND_RATIOS = ((256 << 20, 15.83), (64 << 20, 7.13), (8 << 20, 5.70),
               (1 << 20, 4.25), (0, 4.00))

SCHEMA_VERSION = "3"
# Bytes hashed from the head of a file to detect rewrite-in-place. An append
# preserves the head; a truncate-and-rewrite almost never does. The hash is
# always of the *logical* (uncompressed) content, so it survives compression.
HEAD_BYTES = 4096

# `files.size`/`files.off` are logical byte counts of the uncompressed
# transcript; `files.dsize` is what the file costs on disk. They differ only
# for a compressed source, and keeping size logical is what lets
# `off == size` mean "fully indexed" across a compress or a restore.
SCHEMA = """
CREATE TABLE IF NOT EXISTS meta(k TEXT PRIMARY KEY, v TEXT);
CREATE TABLE IF NOT EXISTS files(
  id INTEGER PRIMARY KEY,
  path TEXT UNIQUE NOT NULL,
  dev INTEGER, ino INTEGER,
  size INTEGER NOT NULL DEFAULT 0,
  dsize INTEGER NOT NULL DEFAULT 0,
  zst INTEGER NOT NULL DEFAULT 0,
  mtime REAL,
  head TEXT,
  off INTEGER NOT NULL DEFAULT 0,
  nline INTEGER NOT NULL DEFAULT 0,
  provider TEXT, account TEXT, project TEXT, session_id TEXT,
  title TEXT, cwd TEXT, branch TEXT,
  first_ts TEXT, last_ts TEXT,
  nmsg INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS files_session ON files(session_id);
CREATE INDEX IF NOT EXISTS files_project ON files(project);
CREATE TABLE IF NOT EXISTS msg(
  id INTEGER PRIMARY KEY,
  file_id INTEGER NOT NULL,
  line INTEGER NOT NULL,
  off INTEGER NOT NULL,
  blk INTEGER NOT NULL DEFAULT 0,
  ts TEXT, role TEXT,
  content TEXT
);
CREATE INDEX IF NOT EXISTS msg_file ON msg(file_id);
CREATE INDEX IF NOT EXISTS msg_ts ON msg(ts);
CREATE VIRTUAL TABLE IF NOT EXISTS ftx USING fts5(
  text, content='', contentless_delete=1,
  tokenize='unicode61 remove_diacritics 2'
);
"""


# ---------------------------------------------------------------- discovery

def transcript_roots():
    """Return configured transcript roots, de-duplicated by real path.

    Account stores contain ``<provider>/<account>/sessions`` while a direct
    CODEX_HOME (notably the credential-free pooled home) contains
    ``sessions`` itself.  Symlinked North projections therefore resolve to one
    identity and cannot duplicate messages in the index.
    """
    if os.environ.get("CONVO_ROOT"):
        return [(ROOT, "", "")]
    candidates = [
        (ROOT, "", ""),
        (os.environ.get("CODEX_HOME"), "openai", "configured"),
        (os.environ.get("NORTH_CODEX_POOLED_HOME"), "openai", "pooled"),
        (os.path.join(HOME, ".local/state/north/codex-pooled"), "openai", "pooled"),
    ]
    out, seen = [], set()
    for root, provider, account in candidates:
        if not root or not os.path.isdir(root):
            continue
        canonical = os.path.realpath(root)
        if canonical in seen:
            continue
        seen.add(canonical)
        out.append((canonical, provider, account))
    return out


def discover():
    """Yield (logical, disk, provider, account, project_hint) per transcript.

    `logical` always names the `.jsonl`; `disk` is what actually exists, which
    may be `<logical>.zst`. Identity is the logical path, so compressing a
    transcript never forks it into two index entries. When both forms exist —
    a sweep interrupted between writing the archive and unlinking the source —
    the uncompressed one wins, because it is the one a writer could still be
    appending to.
    """
    for root, direct_provider, direct_account in transcript_roots():
        if direct_provider:
            trees = [(direct_provider, direct_account or os.path.basename(root),
                      os.path.join(root, "sessions"))]
        else:
            trees = []
            for provider in sorted(os.listdir(root)):
                pdir = os.path.join(root, provider)
                if not os.path.isdir(pdir):
                    continue
                for account in sorted(os.listdir(pdir)):
                    trees.append((provider, account,
                                  os.path.join(pdir, account, "sessions")))
        for provider, account, base in trees:
            if not os.path.isdir(base):
                continue
            for dirpath, dirnames, filenames in os.walk(base):
                dirnames.sort()
                here = set(filenames)
                for fn in sorted(filenames):
                    if fn.endswith(".jsonl"):
                        logical = disk = os.path.join(dirpath, fn)
                    elif fn.endswith(".jsonl.zst"):
                        if fn[:-4] in here:
                            continue
                        logical = os.path.join(dirpath, fn[:-4])
                        disk = os.path.join(dirpath, fn)
                    else:
                        continue
                    yield logical, disk, provider, account, ""


# ------------------------------------------------------------- line reader

def scan_lines(fh, start):
    """Yield (line_start, line_end, line_bytes_or_None) for complete lines.

    `fh` must already be positioned at `start`, which is only a base for the
    offsets reported — the reader never seeks, so a decompressor pipe works
    exactly like a file.

    Memory is bounded by LINE_CAP regardless of input: a 59 MB line is
    consumed and discarded without ever being materialised. Only lines
    terminated by a newline are yielded, so a session being appended to
    right now never produces a torn record.
    """
    base = start
    line_start = start
    buf = bytearray()
    over = False
    while True:
        chunk = fh.read(CHUNK)
        if not chunk:
            return
        pos = 0
        while True:
            nl = chunk.find(b"\n", pos)
            if nl < 0:
                seg = chunk[pos:]
                if not over:
                    if len(buf) + len(seg) > LINE_CAP:
                        over = True
                        buf = bytearray()
                    else:
                        buf += seg
                break
            seg = chunk[pos:nl]
            if over or len(buf) + len(seg) > LINE_CAP:
                line = None
            else:
                buf += seg
                line = bytes(buf)
            end = base + nl + 1
            yield line_start, end, line
            buf = bytearray()
            over = False
            pos = nl + 1
            line_start = end
        base += len(chunk)


# -------------------------------------------------------------- extraction

def _clip(s):
    if not isinstance(s, str):
        return ""
    s = s.strip()
    return s[:TEXT_CAP] if len(s) > TEXT_CAP else s


def _tool_text(name, args):
    """Compact rendering of a tool invocation: what was run, not what it printed."""
    if isinstance(args, str):
        body = args
    elif isinstance(args, dict):
        keep = ("command", "file_path", "path", "pattern", "query", "prompt",
                "description", "old_string", "new_string", "url", "content")
        parts = []
        for k in keep:
            v = args.get(k)
            if isinstance(v, str) and v.strip():
                parts.append(f"{k}={v}")
        body = "\n".join(parts) if parts else json.dumps(args)[:2000]
    else:
        body = ""
    return _clip(f"{name} {body}")


def extract_openai(d):
    out = []
    meta = {}
    t = d.get("type")
    p = d.get("payload")
    if not isinstance(p, dict):
        return out, meta
    if t == "session_meta":
        for k, key in (("session_id", "session_id"), ("cwd", "cwd")):
            if p.get(k):
                meta[key] = p[k]
        if p.get("id"):
            meta.setdefault("session_id", p["id"])
        if p.get("agent_nickname"):
            meta["title"] = p["agent_nickname"]
        return out, meta
    # event_msg replays what response_item already holds; compacted replays the
    # whole conversation. Indexing either double-counts.
    if t != "response_item":
        return out, meta
    pt = p.get("type")
    if pt == "message":
        role = p.get("role") or "user"
        if role == "developer":
            return out, meta  # injected system boilerplate, identical every session
        c = p.get("content")
        if isinstance(c, str):
            s = _clip(c)
            if s:
                out.append((role, s))
        elif isinstance(c, list):
            for b in c:
                if isinstance(b, dict) and b.get("type") in (
                        "input_text", "output_text", "text"):
                    s = _clip(b.get("text"))
                    if s:
                        out.append((role, s))
    elif pt == "reasoning":
        for b in (p.get("summary") or []):
            if isinstance(b, dict):
                s = _clip(b.get("text"))
                if s:
                    out.append(("thinking", s))
        c = p.get("content")
        if isinstance(c, list):
            for b in c:
                if isinstance(b, dict):
                    s = _clip(b.get("text"))
                    if s:
                        out.append(("thinking", s))
    elif pt in ("function_call", "custom_tool_call"):
        s = _tool_text(p.get("name") or "tool",
                       p.get("arguments") if p.get("arguments") is not None
                       else p.get("input"))
        if s:
            out.append(("tool", s))
    # *_output payloads are command output: deliberately not indexed.
    return out, meta


def slug_of(cwd):
    return cwd.replace("/", "-") if cwd else ""


def short_project(project):
    if not project:
        return "?"
    s = project
    for pre in ("-home-tom-code-client-", "-home-tom-code-", "-home-tom-"):
        if s.startswith(pre):
            s = s[len(pre):]
            break
    return s.lstrip("-") or "home"


# ----------------------------------------------------------------- indexing

def head_hash(path):
    """Fingerprint of a fixed-length prefix, or None if the file is shorter.

    The length must not depend on the file's size: hashing "as much as there
    is" would change on every append and make each append look like a rewrite.
    A file below the window is re-read in full instead, which costs nothing.
    """
    try:
        with open(path, "rb") as fh:
            b = fh.read(HEAD_BYTES)
    except OSError:
        return None
    return hashlib.sha256(b).hexdigest() if len(b) == HEAD_BYTES else None


class Source:
    """A transcript opened for reading, compressed or not.

    A `.zst` source is a decompressor pipe: it can only be read forward from
    zero, so it is never resumed mid-file. That costs nothing, because a
    compressed transcript is closed by definition and is read exactly once.
    The head fingerprint is taken from the decompressed bytes, so it means the
    same thing before and after a sweep.
    """

    def __init__(self, disk, start):
        self.proc = None
        self._head = None
        if disk.endswith(".zst"):
            if start:
                raise ValueError("a compressed transcript is read from zero")
            self.proc = subprocess.Popen(
                [ZSTD, "-dcq", "--", disk],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            self.fh = self.proc.stdout
            self._head = bytearray()
        else:
            self.fh = open(disk, "rb", buffering=0)
            self.fh.seek(start)

    def read(self, n):
        b = self.fh.read(n)
        if self._head is not None and len(self._head) < HEAD_BYTES:
            self._head += b[:HEAD_BYTES - len(self._head)]
        return b

    def head(self):
        """Fingerprint of the logical head, or None if it was not captured."""
        if self._head is None or len(self._head) < HEAD_BYTES:
            return None
        return hashlib.sha256(bytes(self._head)).hexdigest()

    def advise(self, flag):
        try:
            os.posix_fadvise(self.fh.fileno(), 0, 0, flag)
        except (AttributeError, OSError):
            pass

    def close(self):
        """Close, returning False if a decompressor reported a bad archive."""
        ok = True
        if self.proc is not None:
            self.fh.close()
            ok = self.proc.wait() == 0
        else:
            self.fh.close()
        return ok


class StaleIndex(Exception):
    """The index on disk was written by a different schema version."""


def connect(readonly=False):
    os.makedirs(STATE, exist_ok=True)
    if readonly and os.path.exists(DB):
        con = sqlite3.connect(f"file:{DB}?mode=ro", uri=True)
        # A read-only connection cannot rebuild, and querying a foreign schema
        # raises somewhere deep in a SELECT instead. Say what happened here,
        # where the fix can be named.
        try:
            row = con.execute("SELECT v FROM meta WHERE k='schema'").fetchone()
        except sqlite3.DatabaseError:
            row = None
        if row is None or row[0] != SCHEMA_VERSION:
            con.close()
            raise StaleIndex(row[0] if row else "unknown")
    else:
        con = sqlite3.connect(DB)
        con.executescript(SCHEMA)
        row = con.execute("SELECT v FROM meta WHERE k='schema'").fetchone()
        if row is None or row[0] != SCHEMA_VERSION:
            # The index is a derived artefact: rebuilding is always correct and
            # always cheaper than a migration nobody will test.
            for stmt in ("DROP TABLE IF EXISTS ftx", "DROP TABLE IF EXISTS msg",
                         "DROP TABLE IF EXISTS files"):
                con.execute(stmt)
            con.commit()
            con.executescript(SCHEMA)
            con.execute("INSERT OR REPLACE INTO meta(k,v) VALUES('schema',?)",
                        (SCHEMA_VERSION,))
            con.commit()
    con.execute("PRAGMA journal_mode=WAL")
    con.execute("PRAGMA synchronous=NORMAL")
    con.execute("PRAGMA temp_store=MEMORY")
    con.execute("PRAGMA cache_size=-64000")
    con.row_factory = sqlite3.Row
    return con


class Progress:
    def __init__(self, total_files, total_bytes, quiet=False):
        self.tf, self.tb = total_files, total_bytes
        self.f = self.b = self.m = 0
        self.t0 = time.time()
        self.last = 0.0
        self.quiet = quiet or not sys.stderr.isatty()
        self.ever = False

    def tick(self, force=False):
        now = time.time()
        if not force and now - self.last < 1.0:
            return
        self.last = now
        el = now - self.t0
        rate = self.b / el if el > 0 else 0
        if self.quiet:
            return
        eta = ""
        if rate > 0 and self.tb > self.b:
            r = (self.tb - self.b) / rate
            eta = f" eta {int(r // 60)}m{int(r % 60):02d}s"
        sys.stderr.write(
            f"\r\033[Kindexing {self.f}/{self.tf} files  "
            f"{self.b / 1073741824:.1f}/{self.tb / 1073741824:.1f} GiB  "
            f"{rate / 1048576:.0f} MiB/s  {self.m} msgs{eta}")
        sys.stderr.flush()
        self.ever = True

    def done(self):
        if self.ever and not self.quiet:
            sys.stderr.write("\r\033[K")
            sys.stderr.flush()


def index(con, quiet=False, verbose=False):
    """Incremental index pass. Returns (files_touched, msgs_added, bytes_read)."""
    try:
        os.nice(10)  # a cold build must not compete with the user's work
    except OSError:
        pass

    known = {}
    for r in con.execute(
            "SELECT id,path,dev,ino,size,dsize,zst,mtime,head,off,nline "
            "FROM files"):
        known[r["path"]] = r

    def adopt(row, st, zst):
        """Record a new on-disk form of an already fully-indexed transcript."""
        con.execute(
            "UPDATE files SET zst=?,dev=?,ino=?,dsize=?,mtime=? WHERE id=?",
            (1 if zst else 0, st.st_dev, st.st_ino, st.st_size,
             st.st_mtime, row["id"]))

    todo = []
    total_new = 0
    adopted = 0
    for path, disk, provider, account, hint in discover():
        try:
            st = os.stat(disk)
        except OSError:
            continue
        is_zst = disk != path
        row = known.get(path)
        if row is not None:
            if (bool(row["zst"]) == is_zst
                    and row["ino"] == st.st_ino and row["dev"] == st.st_dev
                    and st.st_size == row["dsize"]
                    and abs(st.st_mtime - (row["mtime"] or 0)) < 0.001):
                continue  # untouched: not opened at all
            # A transcript that was indexed to its last byte holds no more
            # information, so changing how it is stored costs nothing: adopt
            # the new form without re-reading it. This is what makes a sweep
            # over the whole corpus free for the index rather than a rebuild.
            complete = row["size"] > 0 and row["off"] == row["size"]
            if is_zst != bool(row["zst"]) and complete:
                if is_zst or st.st_size == row["size"]:
                    adopt(row, st, is_zst)
                    adopted += 1
                    continue
            if is_zst:
                todo.append((path, disk, provider, account, hint, st, row, True))
                total_new += row["size"] or st.st_size
                continue
            # Size or mtime moved, so the file must be looked at. Anything but
            # a pure append invalidates every byte offset already recorded for
            # it, and a stale offset silently misattributes a message — so
            # re-read from zero unless the head still matches.
            h = head_hash(path)
            reset = (row["ino"] != st.st_ino or row["dev"] != st.st_dev
                     or st.st_size < row["off"]
                     or h is None or h != row["head"])
            todo.append((path, disk, provider, account, hint, st, row, reset))
            total_new += st.st_size if reset else max(0, st.st_size - row["off"])
        else:
            todo.append((path, disk, provider, account, hint, st, None, False))
            total_new += st.st_size

    if adopted:
        con.commit()
    if not todo:
        return 0, 0, 0

    prog = Progress(len(todo), total_new, quiet=quiet)
    nmsg_total = 0
    nbytes = 0
    next_id = con.execute("SELECT COALESCE(MAX(id),0)+1 FROM msg").fetchone()[0]

    for path, disk, provider, account, hint, st, row, reset in todo:
        fid = row["id"] if row else None
        is_zst = disk != path
        start = 0 if (row is None or reset or is_zst) else row["off"]
        line_no = 0 if (row is None or reset or is_zst) else row["nline"]

        if reset and fid is not None:
            con.execute(
                "DELETE FROM ftx WHERE rowid IN "
                "(SELECT id FROM msg WHERE file_id=?)", (fid,))
            con.execute("DELETE FROM msg WHERE file_id=?", (fid,))
            con.execute("UPDATE files SET off=0,nline=0,nmsg=0 WHERE id=?", (fid,))
            con.commit()

        if fid is None:
            project = hint or ""
            cur = con.execute(
                "INSERT INTO files(path,dev,ino,size,mtime,off,nline,"
                "provider,account,project) VALUES(?,?,?,?,?,0,0,?,?,?)",
                (path, st.st_dev, st.st_ino, 0, 0.0, provider, account, project))
            fid = cur.lastrowid

        meta = {}
        pend = []
        added = 0
        off = start
        first_ts = None
        last_ts = None
        def flush(final_off):
            # msg.id and ftx.rowid are the same number by construction — ids are
            # assigned here rather than inferred from last_insert_rowid(), so a
            # snippet can never be resolved against the wrong message.
            nonlocal pend, added, next_id
            if pend:
                con.executemany(
                    "INSERT INTO msg(id,file_id,line,off,blk,ts,role,content) "
                    "VALUES(?,?,?,?,?,?,?,?)",
                    [(next_id + i,) + p[0] + (p[1],)
                     for i, p in enumerate(pend)])
                con.executemany(
                    "INSERT INTO ftx(rowid,text) VALUES(?,?)",
                    [(next_id + i, p[1]) for i, p in enumerate(pend)])
                next_id += len(pend)
                added += len(pend)
                pend = []
            con.execute("UPDATE files SET off=?,nline=? WHERE id=?",
                        (final_off, line_no, fid))
            con.commit()

        try:
            src = Source(disk, start)
        except (OSError, ValueError):
            continue
        try:
            src.advise(os.POSIX_FADV_SEQUENTIAL)
            for ls, le, line in scan_lines(src, start):
                line_no += 1
                off = le
                nbytes += le - ls
                prog.b += le - ls
                if line is None:
                    continue
                # Cheap prefix reject: drops compaction replays, token counts,
                # world_state and event_msg duplicates before parsing.
                head = line[:200]
                if (b"response_item" not in head
                        and b"session_meta" not in head):
                    continue
                if not line.strip():
                    continue
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                if not isinstance(d, dict):
                    continue
                msgs, mu = extract_openai(d)
                for k, v in mu.items():
                    if v:
                        meta[k] = v
                ts = d.get("timestamp")
                if isinstance(ts, str) and ts:
                    if first_ts is None:
                        first_ts = ts
                    last_ts = ts
                for i, (role, text) in enumerate(msgs):
                    pend.append((
                        (fid, line_no, ls, i, ts if isinstance(ts, str) else None,
                         role), text))
                if len(pend) >= COMMIT_EVERY:
                    prog.m += len(pend)
                    flush(off)
                    prog.tick()
            prog.m += len(pend)
            flush(off)
            src.advise(os.POSIX_FADV_DONTNEED)
        finally:
            intact = src.close()

        if not intact:
            # A truncated or corrupt archive would otherwise be recorded as a
            # complete transcript and never looked at again. Drop what it gave
            # us and leave the row untouched, so the next pass retries it.
            con.execute(
                "DELETE FROM ftx WHERE rowid IN "
                "(SELECT id FROM msg WHERE file_id=?)", (fid,))
            con.execute("DELETE FROM msg WHERE file_id=?", (fid,))
            con.execute(
                "UPDATE files SET off=0,nline=0,nmsg=0,size=0,dsize=0 WHERE id=?",
                (fid,))
            con.commit()
            sys.stderr.write(f"convo: unreadable archive, skipped: {disk}\n")
            prog.f += 1
            continue

        project = meta.get("cwd") and slug_of(meta["cwd"]) or hint
        con.execute(
            # dev/ino are refreshed here and not only at insert: a transcript
            # replaced by rename gets a new inode, and a row still naming the
            # old one reports "changed" on every pass and re-reads forever.
            "UPDATE files SET size=?,dsize=?,zst=?,mtime=?,head=?,dev=?,ino=?,"
            "session_id=COALESCE(?,session_id),"
            "title=COALESCE(?,title),cwd=COALESCE(?,cwd),"
            "branch=COALESCE(?,branch),project=COALESCE(NULLIF(?,''),project),"
            "first_ts=COALESCE(first_ts,?),last_ts=COALESCE(?,last_ts),"
            "nmsg=nmsg+? WHERE id=?",
            # For an archive the logical size is what we actually consumed:
            # a trailing partial line is not a record and never will be one.
            (off if is_zst else st.st_size, st.st_size, 1 if is_zst else 0,
             st.st_mtime, src.head() if is_zst else head_hash(path),
             st.st_dev, st.st_ino,
             meta.get("session_id"),
             meta.get("title") or meta.get("slug"), meta.get("cwd"),
             meta.get("branch"), project, first_ts, last_ts, added, fid))
        con.commit()
        nmsg_total += added
        prog.f += 1
        if verbose and added:
            sys.stderr.write(f"\r\033[K{added:6d} msgs  {path}\n")
        prog.tick()

    prog.tick(force=True)
    prog.done()
    con.execute("INSERT OR REPLACE INTO meta(k,v) VALUES('last_index',?)",
                (str(time.time()),))
    con.commit()
    return len(todo), nmsg_total, nbytes


def with_lock(fn, *a, **kw):
    """Run fn holding the index lock; return None if another run holds it."""
    os.makedirs(STATE, exist_ok=True)
    fd = os.open(LOCK, os.O_CREAT | os.O_RDWR, 0o644)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return None
        return fn(*a, **kw)
    finally:
        os.close(fd)


# ------------------------------------------------------------------ search

WORD = re.compile(r"[0-9A-Za-z_]+")


def make_snippet(text, terms, width=220):
    if not text:
        return ""
    flat = " ".join(text.split())
    low = flat.lower()
    pos = -1
    for t in terms:
        p = low.find(t)
        if p >= 0 and (pos < 0 or p < pos):
            pos = p
    if pos < 0:
        return flat[:width] + ("…" if len(flat) > width else "")
    a = max(0, pos - width // 3)
    b = min(len(flat), a + width)
    s = flat[a:b]
    return ("…" if a > 0 else "") + s + ("…" if b < len(flat) else "")


def fts_query(args):
    if args.exact:
        esc = args.query.replace('"', '""')
        return f'"{esc}"'
    q = args.query.strip()
    if args.all_terms:
        toks = WORD.findall(q)
        return " AND ".join(toks) if toks else q
    return q


def parse_since(s):
    if not s:
        return None
    m = re.fullmatch(r"(\d+)([dwmy])", s.strip())
    if m:
        n = int(m.group(1))
        days = {"d": 1, "w": 7, "m": 30, "y": 365}[m.group(2)] * n
        return time.strftime("%Y-%m-%d", time.gmtime(time.time() - days * 86400))
    return s


def cmd_search(con, args):
    q = fts_query(args)
    where = ["ftx MATCH ?"]
    params = [q]
    if args.project:
        where.append("f.project LIKE ?")
        params.append(f"%{args.project}%")
    if args.role:
        where.append("m.role = ?")
        params.append(args.role)
    since = parse_since(args.since)
    if since:
        where.append("m.ts >= ?")
        params.append(since)
    if args.session:
        where.append("f.session_id = ?")
        params.append(args.session)
    sql = (
        "SELECT m.id, m.line, m.content, m.ts, m.role, f.path, f.project, "
        "f.session_id, f.title, f.provider, f.branch, bm25(ftx) AS rank "
        "FROM ftx JOIN msg m ON m.id = ftx.rowid "
        "JOIN files f ON f.id = m.file_id "
        f"WHERE {' AND '.join(where)} ORDER BY rank LIMIT ?")
    params.append(args.limit)
    try:
        rows = con.execute(sql, params).fetchall()
    except sqlite3.OperationalError as e:
        # People type questions, and a stray ':' or '(' is FTS5 syntax. Retry
        # as a plain conjunction of words before giving up on them.
        toks = WORD.findall(args.query)
        if not toks:
            sys.stderr.write(f"convo: bad query: {e}\n")
            return 2
        params[0] = " AND ".join(toks)
        try:
            rows = con.execute(sql, params).fetchall()
        except sqlite3.OperationalError as e2:
            sys.stderr.write(f"convo: bad query: {e2}\n")
            return 2
    if not rows:
        print(f"no matches for {q}")
        return 1
    terms = [t.lower() for t in WORD.findall(args.query)] or [args.query.lower()]
    # The snippet comes from the index, never from the transcript: rendering a
    # page of results opens no files at all, so the sources are free to be
    # compressed or archived.
    out = [(r, make_snippet(r["content"], terms)) for r in rows]
    if args.json:
        print(json.dumps([{
            "ts": r["ts"], "role": r["role"], "project": r["project"],
            "session": r["session_id"], "title": r["title"],
            "path": r["path"], "line": r["line"], "snippet": s,
        } for r, s in out], indent=1))
        return 0
    for i, (r, s) in enumerate(out, 1):
        ts = (r["ts"] or "")[:16].replace("T", " ")
        title = r["title"] or ""
        sid = (r["session_id"] or "")[:8]
        print(f"{C.dim}{i:3d}.{C.off} {C.bold}{ts}{C.off}  "
              f"{C.cyan}{short_project(r['project']):<22}{C.off} "
              f"{C.dim}{sid}{C.off}  {title}")
        print(f"     {C.yellow}{r['role']}{C.off} · {s}")
        print(f"     {C.dim}{r['path']}:{r['line']}{C.off}")
    return 0


def cmd_session(con, args):
    sid = args.id.strip().lower()
    rows = con.execute(
        "SELECT * FROM files WHERE session_id = ? OR path LIKE ? "
        "ORDER BY nmsg DESC, first_ts", (sid, f"%{sid}%")).fetchall()
    # Sidecars (workflow journals, empty spool files) carry the id in their
    # path but hold no conversation; they are noise unless asked for.
    empty = [r for r in rows if not r["nmsg"]]
    if not getattr(args, "verbose", False):
        rows = [r for r in rows if r["nmsg"]]
    mentions = []
    try:
        esc = sid.replace('"', '""')
        mentions = con.execute(
            "SELECT m.line, m.ts, m.role, f.path, f.project, f.session_id, "
            "f.title FROM ftx JOIN msg m ON m.id = ftx.rowid "
            "JOIN files f ON f.id = m.file_id "
            "WHERE ftx MATCH ? LIMIT ?", (f'"{esc}"', args.limit)).fetchall()
    except sqlite3.OperationalError:
        pass
    if not rows and not mentions:
        print(f"no transcript or mention found for {sid}")
        return 1
    if rows:
        print(f"{C.bold}transcripts owned by {sid}{C.off}")
        for r in rows[:args.limit]:
            span = f"{(r['first_ts'] or '')[:16]} → {(r['last_ts'] or '')[:16]}"
            print(f"  {C.cyan}{short_project(r['project']):<22}{C.off} "
                  f"{span.replace('T', ' ')}  {r['nmsg']} msgs  "
                  f"{r['title'] or ''}")
            print(f"    {C.dim}{r['path']}{C.off}")
        if len(rows) > args.limit:
            print(f"  {C.dim}… {len(rows) - args.limit} more{C.off}")
        if empty:
            print(f"  {C.dim}({len(empty)} sidecar file(s) with no "
                  f"conversation; -v to list){C.off}")
    if mentions:
        print(f"\n{C.bold}mentioned in {len(mentions)} indexed message(s){C.off}")
        for r in mentions:
            ts = (r["ts"] or "")[:16].replace("T", " ")
            print(f"  {ts}  {C.cyan}{short_project(r['project']):<22}{C.off}"
                  f"{r['role']:<10} {C.dim}{r['path']}:{r['line']}{C.off}")
    return 0


def cmd_status(con, args):
    f = con.execute(
        "SELECT COUNT(*) n, SUM(size) b, SUM(dsize) d, SUM(nmsg) m, "
        "SUM(zst) z FROM files").fetchone()
    size = os.path.getsize(DB) if os.path.exists(DB) else 0
    wal = DB + "-wal"
    if os.path.exists(wal):
        size += os.path.getsize(wal)
    last = con.execute("SELECT v FROM meta WHERE k='last_index'").fetchone()
    logical, disk = f["b"] or 0, f["d"] or 0
    print(f"index    {DB}")
    print(f"size     {size / 1048576:.1f} MiB")
    print(f"corpus   {logical / 1073741824:.1f} GiB in {f['n']} transcripts")
    print(f"on disk  {disk / 1073741824:.1f} GiB  ({f['z'] or 0} compressed"
          + (f", {logical / disk:.2f}x)" if disk else ")"))
    print(f"messages {f['m'] or 0}")
    if last:
        age = time.time() - float(last["v"])
        print(f"updated  {age:.0f}s ago")
    print(f"ratio    {100 * size / (f['b'] or 1):.2f}% of corpus bytes")
    top = con.execute(
        "SELECT project, SUM(nmsg) m FROM files GROUP BY project "
        "ORDER BY m DESC LIMIT 8").fetchall()
    print("\ntop projects")
    for r in top:
        print(f"  {short_project(r['project']):<28} {r['m']}")
    return 0


# ------------------------------------------------------------- compression

UUID_RE = re.compile(
    r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", re.I)


class Unsafe(Exception):
    """Raised when closure cannot be proven. Never caught to continue a file."""


def open_files():
    """(paths, unseen): every transcript held open by a running process.

    Reads /proc directly rather than shelling out, because the answer has to
    be exact: this set is the difference between compressing a dead transcript
    and corrupting a live session.

    `unseen` is the honest hole: the names of THIS USER's processes that have
    marked themselves non-dumpable — ssh-agent, sd-pam, a setuid helper — and
    so hide their fd table from their own owner. No tool on the machine sees
    past that, lsof included. They are named in the sweep's report rather than
    assumed empty. Other users' hidden processes are counted, not named: they
    are ordinary system noise, hundreds of them, and a line nobody reads is
    not a safety check. The age window and the post-compression re-stat are
    what actually stand between any of them and a lost write.
    """
    live = set()
    unseen = []
    others = 0
    me = os.getuid()
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        fdd = os.path.join("/proc", pid, "fd")
        try:
            names = os.listdir(fdd)
        except FileNotFoundError:
            continue  # the process exited between listing and reading
        except OSError:
            if pid_uid(pid) == me:
                unseen.append(pid_comm(pid))
            else:
                others += 1
            continue
        for n in names:
            try:
                t = os.readlink(os.path.join(fdd, n))
            except OSError:
                continue
            if t.endswith(" (deleted)"):
                t = t[:-10]
            if t.startswith("/") and (t.endswith(".jsonl")
                                      or t.endswith(".jsonl.zst")):
                live.add(t)
    return live, unseen, others


def pid_comm(pid):
    try:
        with open(os.path.join("/proc", pid, "comm")) as fh:
            return fh.read().strip() or pid
    except OSError:
        return pid


def pid_uid(pid):
    try:
        with open(os.path.join("/proc", pid, "status")) as fh:
            for ln in fh:
                if ln.startswith("Uid:"):
                    return int(ln.split()[1])
    except (OSError, ValueError, IndexError):
        return None
    return None


def coordinator_ids():
    """Session ids the coordinator currently accounts for.

    A failure here is fatal to the sweep. The roster is one of the two pieces
    of positive evidence that a transcript is closed; without it there is no
    safe file, only unexamined ones.
    """
    cmd = shlex.split(os.environ.get("CONVO_ROSTER_CMD", "north agents --json"))
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=180)
    except (OSError, subprocess.SubprocessError) as e:
        raise Unsafe(f"could not ask the coordinator which sessions are live: {e}")
    if r.returncode != 0:
        raise Unsafe("the coordinator refused to report live sessions: "
                     + (r.stderr.strip().splitlines() or ["exit "
                        + str(r.returncode)])[-1])
    try:
        d = json.loads(r.stdout)
    except Exception as e:
        raise Unsafe(f"the coordinator roster was not readable JSON: {e}")
    if d.get("version") != "north:agent-roster:v1" or not isinstance(
            d.get("agents"), list):
        raise Unsafe("the coordinator roster is not north:agent-roster:v1")
    ids = set()
    for row in d["agents"]:
        if isinstance(row, dict):
            for v in row.values():
                if isinstance(v, str):
                    ids.update(m.lower() for m in UUID_RE.findall(v))
    return ids


def fsync_dir(path):
    fd = os.open(path, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def round_trips(archive, original):
    """True when decompressing `archive` reproduces `original` byte for byte."""
    d = subprocess.Popen([ZSTD, "-dcq", "--", archive],
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    try:
        c = subprocess.Popen(["cmp", "-s", "-", "--", original],
                             stdin=d.stdout, stderr=subprocess.DEVNULL)
    finally:
        d.stdout.close()
    return c.wait() == 0 and d.wait() == 0


def compress_one(path, st):
    """Replace `path` with `path`.zst. Returns the archive's size.

    Order is: write, verify, prove the source never moved, publish, unlink.
    An interruption anywhere leaves the original in place — the source is only
    ever removed after its replacement has been read back and matched.
    """
    dst = path + ".zst"
    tmp = f"{dst}.tmp{os.getpid()}"
    try:
        if os.path.exists(dst) and round_trips(dst, path):
            # A previous run was interrupted after publishing the archive.
            os.unlink(path)
            return os.path.getsize(dst)
        r = subprocess.run([ZSTD, *ZSTD_ARGS, "-q", "-f", "-o", tmp, "--", path],
                           stderr=subprocess.PIPE, text=True)
        if r.returncode != 0:
            raise Unsafe(f"zstd failed: {r.stderr.strip()}")
        if not round_trips(tmp, path):
            raise Unsafe("round-trip did not reproduce the original")
        now = os.stat(path)
        if (now.st_ino, now.st_dev, now.st_size, now.st_mtime) != (
                st.st_ino, st.st_dev, st.st_size, st.st_mtime):
            raise Unsafe("the transcript was written during compression")
        fd = os.open(tmp, os.O_RDONLY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
        # The archive stands in for the transcript, so it carries its mtime:
        # everything that reasons about session age keeps working.
        os.utime(tmp, (st.st_atime, st.st_mtime))
        os.replace(tmp, dst)
        fsync_dir(os.path.dirname(path))
        os.unlink(path)
        fsync_dir(os.path.dirname(path))
        return os.path.getsize(dst)
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def projected(size):
    for floor, ratio in BAND_RATIOS:
        if size >= floor:
            return size / ratio
    return size


def gib(n):
    return f"{n / 1073741824:.2f} GiB"


def cmd_compress(args):
    root_note = f"{C.dim}{', '.join(r[0] for r in transcript_roots())}{C.off}"
    cutoff = time.time() - args.older_than * 3600
    live, unseen, hidden_others = open_files()
    roster = coordinator_ids()

    eligible = []
    skip_open = skip_live = skip_hot = 0
    warm_bytes = 0
    total = 0
    for path, disk, _prov, _acct, _hint in discover():
        if disk != path:
            continue  # already an archive
        total += 1
        try:
            st = os.stat(path)
        except OSError:
            continue
        if path in live or path + ".zst" in live:
            skip_open += 1
            continue
        if any(sid in path.lower() for sid in roster):
            skip_live += 1
            continue
        if st.st_mtime > cutoff:
            skip_hot += 1
            warm_bytes += st.st_size
            continue
        eligible.append((path, st))

    eligible.sort(key=lambda e: -e[1].st_size)
    if args.max_files:
        eligible = eligible[:args.max_files]
    ebytes = sum(st.st_size for _, st in eligible)

    print(f"corpus     {total} uncompressed transcripts under {root_note}")
    print(f"eligible   {len(eligible)} files  {gib(ebytes)}  "
          f"(untouched for {args.older_than}h, no open fd, not on the roster)")
    print(f"held back  {skip_hot} still warm ({gib(warm_bytes)}) · "
          f"{skip_open} open by a process · "
          f"{skip_live} named by a coordinator lane")
    if unseen:
        names = sorted(set(unseen))
        shown = ", ".join(names[:6]) + (f", +{len(names) - 6}" if len(names) > 6
                                        else "")
        print(f"unseen     {len(unseen)} of this user's processes hide their "
              f"open files from every tool ({shown})")
    if hidden_others:
        print(f"           {hidden_others} more belong to other users")
    if not eligible:
        return 0
    if args.dry_run:
        after = sum(projected(st.st_size) for _, st in eligible)
        print(f"projected  {gib(ebytes)} → {gib(after)}  "
              f"saving {gib(ebytes - after)} "
              f"({ebytes / after:.2f}x, from measured band ratios)")
        return 0

    t0 = time.time()
    done = failed = 0
    was = after = 0
    for i, (path, st) in enumerate(eligible, 1):
        try:
            after += compress_one(path, st)
            was += st.st_size
            done += 1
        except Unsafe as e:
            failed += 1
            sys.stderr.write(f"convo: left alone: {path}: {e}\n")
        except OSError as e:
            failed += 1
            sys.stderr.write(f"convo: left alone: {path}: {e}\n")
        if not args.quiet and sys.stderr.isatty():
            sys.stderr.write(f"\r\033[Kcompressing {i}/{len(eligible)}  "
                             f"{gib(after)} written")
            sys.stderr.flush()
    if not args.quiet and sys.stderr.isatty():
        sys.stderr.write("\r\033[K")
    print(f"compressed {done} files  {gib(was)} → {gib(after)}  "
          f"saving {gib(was - after)}"
          + (f" ({was / after:.2f}x)" if after else "")
          + f"  in {time.time() - t0:.0f}s")
    if failed:
        print(f"{C.yellow}left alone {failed} file(s) — see above{C.off}")
    return 0


def cmd_restore(args):
    """Turn `.jsonl.zst` back into `.jsonl`.

    zstd frames carry a content checksum that `-d` verifies, so a decompression
    that exits zero is the integrity proof here; the archive is only unlinked
    after the transcript is back on disk and synced.
    """
    rc = 0
    for name in args.query:
        logical = name[:-4] if name.endswith(".jsonl.zst") else name
        src = logical + ".zst"
        if not os.path.exists(src):
            sys.stderr.write(f"convo: no archive at {src}\n")
            rc = 1
            continue
        if os.path.exists(logical):
            sys.stderr.write(f"convo: {logical} already exists\n")
            rc = 1
            continue
        tmp = f"{logical}.tmp{os.getpid()}"
        try:
            r = subprocess.run([ZSTD, "-dq", "-f", "-o", tmp, "--", src],
                               stderr=subprocess.PIPE, text=True)
            if r.returncode != 0:
                sys.stderr.write(f"convo: {src}: {r.stderr.strip()}\n")
                rc = 1
                continue
            st = os.stat(src)
            os.utime(tmp, (st.st_atime, st.st_mtime))
            fd = os.open(tmp, os.O_RDONLY)
            try:
                os.fsync(fd)
            finally:
                os.close(fd)
            os.replace(tmp, logical)
            fsync_dir(os.path.dirname(logical))
            os.unlink(src)
            fsync_dir(os.path.dirname(logical))
            print(f"restored {logical} ({gib(os.path.getsize(logical))})")
        finally:
            try:
                os.unlink(tmp)
            except OSError:
                pass
    return rc


class C:
    bold = dim = cyan = yellow = off = ""

    @classmethod
    def enable(cls, on):
        if on:
            cls.bold, cls.dim, cls.off = "\033[1m", "\033[2m", "\033[0m"
            cls.cyan, cls.yellow = "\033[36m", "\033[33m"


CMDS = ("index", "session", "status", "compress", "restore")
VALUE_OPTS = {"-n", "--limit", "-p", "--project", "-r", "--role", "--since",
              "-s", "--session", "--color", "--older-than", "--max-files"}


def split_cmd(argv):
    """Pull out a leading subcommand, tolerating options before it.

    argparse cannot have both an open positional and subparsers, so the
    subcommand is removed here and the rest is parsed as a query.
    """
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in VALUE_OPTS:
            i += 2
            continue
        if a.startswith("-"):
            i += 1
            continue
        if a in CMDS:
            return a, argv[:i] + argv[i + 1:]
        break
    return None, argv


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    cmd, argv = split_cmd(argv)

    p = argparse.ArgumentParser(
        prog="convo",
        description="search local agent conversation transcripts")
    p.add_argument("query", nargs="*", help="search terms (FTS5 syntax)")
    p.add_argument("-s", "--session", metavar="UUID",
                   help="restrict search to one session id")
    p.add_argument("-x", "--exact", action="store_true",
                   help="exact phrase match (use for ids and literal strings)")
    p.add_argument("-a", "--all-terms", action="store_true",
                   help="require every term (default: FTS5 syntax as given)")
    p.add_argument("-p", "--project", metavar="NAME", help="filter by project")
    p.add_argument("-r", "--role", metavar="ROLE",
                   help="user|assistant|thinking|tool")
    p.add_argument("--since", metavar="N[dwmy]", help="only newer than")
    p.add_argument("-n", "--limit", type=int, default=20)
    p.add_argument("--json", action="store_true")
    p.add_argument("-u", "--no-update", action="store_true",
                   help="skip the incremental index refresh")
    p.add_argument("-q", "--quiet", action="store_true")
    p.add_argument("-v", "--verbose", action="store_true")
    p.add_argument("--color", choices=("auto", "always", "never"), default="auto")
    p.add_argument("--full", action="store_true",
                   help="index: rebuild from scratch")
    p.add_argument("--dry-run", action="store_true",
                   help="compress: report what would be compressed, touch nothing")
    p.add_argument("--older-than", type=float, metavar="HOURS",
                   default=CLOSED_AFTER_S / 3600,
                   help="compress: only transcripts untouched this long")
    p.add_argument("--max-files", type=int, default=0, metavar="N",
                   help="compress: stop after the N largest eligible files")
    p.epilog = ("subcommands: index [--full] | session <uuid> | status\n"
                "             compress [--dry-run] | restore <file>…\n"
                "examples:\n"
                "  convo policy graph            search everything\n"
                "  convo -x 'exact phrase'       literal match\n"
                "  convo session <uuid>          locate one session, no grep\n"
                "  convo compress --dry-run      what a sweep would reclaim\n")
    p.formatter_class = argparse.RawDescriptionHelpFormatter
    args = p.parse_args(argv)
    args.cmd = cmd
    if cmd == "session":
        if not args.query:
            p.error("session needs a session id")
        args.id = args.query[0]

    C.enable(args.color == "always"
             or (args.color == "auto" and sys.stdout.isatty()))

    if args.cmd == "restore":
        if not args.query:
            p.error("restore needs at least one path")
        return cmd_restore(args)

    if args.cmd == "compress":
        # Index before rewriting: a transcript the index has already read to
        # its last byte is adopted in its compressed form for free, while one
        # it has not must be decompressed in full to catch up.
        if not (args.dry_run or args.no_update):
            con = connect()
            with_lock(index, con, quiet=args.quiet)
            con.close()
        return cmd_compress(args)

    if args.cmd == "index":
        if args.full and os.path.exists(DB):
            for suf in ("", "-wal", "-shm"):
                try:
                    os.unlink(DB + suf)
                except OSError:
                    pass
        con = connect()
        t0 = time.time()
        r = with_lock(index, con, quiet=args.quiet, verbose=args.verbose)
        if r is None:
            sys.stderr.write("convo: another index run holds the lock\n")
            return 0
        nf, nm, nb = r
        el = time.time() - t0
        print(f"indexed {nm} messages from {nf} changed files "
              f"({nb / 1073741824:.2f} GiB read) in {el:.1f}s")
        return 0

    # Query-time refresh: cheap when nothing changed, so no daemon or timer.
    if not args.no_update:
        con = connect()
        with_lock(index, con, quiet=args.quiet)
        con.close()

    if not os.path.exists(DB):
        sys.stderr.write("convo: no index yet; run `convo index`\n")
        return 1
    try:
        con = connect(readonly=True)
    except StaleIndex as e:
        sys.stderr.write(
            f"convo: the index on disk is schema {e}, this convo speaks "
            f"{SCHEMA_VERSION}; run `convo index` to rebuild it\n")
        return 1
    try:
        if args.cmd == "status":
            return cmd_status(con, args)
        if args.cmd == "session":
            return cmd_session(con, args)
        if args.session and not args.query:
            return cmd_session(con, argparse.Namespace(
                id=args.session, limit=args.limit))
        if not args.query:
            p.print_help()
            return 0
        args.query = " ".join(args.query)
        return cmd_search(con, args)
    finally:
        con.close()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Unsafe as e:
        sys.stderr.write(f"convo: refusing to sweep: {e}\n")
        sys.exit(3)
    except BrokenPipeError:
        os._exit(0)
    except KeyboardInterrupt:
        sys.stderr.write("\ninterrupted (index progress is committed)\n")
        sys.exit(130)
