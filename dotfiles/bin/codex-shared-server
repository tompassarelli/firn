#!/usr/bin/env bash
# Ensure the selected conversation home's app-server exists; clients never own its lifetime.
set -euo pipefail
umask 077

fail() { printf 'codex: %s\n' "$*" >&2; exit 1; }
self="$(realpath "$0")"
pooled_home="$(realpath -e "${NORTH_CODEX_CONVERSATION_HOME:-${NORTH_CODEX_POOLED_HOME:-$HOME/.local/state/north/codex-pooled}}")" ||
  fail "shared conversation home is unavailable"
sqlite_home="$(realpath -m "${NORTH_CODEX_CONVERSATION_SQLITE_HOME:-$pooled_home/sqlite}")"
runtime="$(realpath -e "${CODEX_RUNTIME:-$HOME/.local/lib/codex/current/bin/codex}")" ||
  fail "selected runtime is unavailable"
[[ -x "$runtime" ]] || fail "selected runtime is not executable"
[[ -n "${XDG_RUNTIME_DIR:-}" && -d "$XDG_RUNTIME_DIR" ]] ||
  fail "user runtime directory is unavailable"
[[ "$(stat -c '%u:%a' "$XDG_RUNTIME_DIR")" = "$UID:700" ]] ||
  fail "user runtime directory must be private and owned by this user"

home_key="$(printf '%s\n%s' "$pooled_home" "$sqlite_home" | sha256sum)"
home_key="${home_key:0:16}"
directory="$XDG_RUNTIME_DIR/codex-shared-$home_key"
# The lock must outlive systemd's removal of the service runtime directory.
exec {lock_fd}>"$XDG_RUNTIME_DIR/codex-shared-$home_key.lock"
flock -w 15 "$lock_fd" || fail "shared server startup is still busy"
mkdir -p "$directory"
[[ ! -L "$directory" && "$(stat -c '%u:%a' "$directory")" = "$UID:700" ]] ||
  fail "shared server directory must be private and owned by this user"
socket="$directory/app-server.sock"
endpoint="unix://$socket"
unit="codex-shared-$home_key.service"
state="$(systemctl --user show "$unit" --property=ActiveState --value)" ||
  fail "cannot determine shared server state; inspect $unit"
case "$state" in
  active) ;;
  inactive|failed)
  if [[ -e "$socket" || -L "$socket" ]]; then
    [[ ! -L "$socket" && -S "$socket" && "$(stat -c '%u' "$socket")" = "$UID" ]] ||
      fail "unexpected shared server socket owner or file type; inspect $socket"
    listeners="$(ss -H -xl src "$socket")" || fail "cannot inspect shared server listener"
    [[ -z "$listeners" ]] || fail "shared server socket still has a listener; inspect $unit"
    # Older units did not give systemd ownership of socket cleanup.
    rm -- "$socket"
  fi
  systemd-run --user --quiet --collect --unit="$unit" --service-type=exec \
    --property=UMask=0077 --property=Slice=agent.slice \
    --property="RuntimeDirectory=codex-shared-$home_key" --property=RuntimeDirectoryMode=0700 \
    --working-directory="$HOME" \
    --setenv="HOME=$HOME" --setenv="PATH=$PATH" \
    --setenv="XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR" \
    --setenv="NORTH_CODEX_CONVERSATION_HOME=$pooled_home" \
    --setenv="NORTH_CODEX_CONVERSATION_SQLITE_HOME=$sqlite_home" \
    --setenv="CODEX_RUNTIME=$runtime" --setenv=NORTH_NO_SLICE=1 \
    -- "$(dirname "$self")/codex-pooled" app-server --listen "$endpoint" --enable multi_agent_v2 ||
    fail "shared server could not start; inspect $unit"
  ;;
  *) fail "shared server is $state; wait for $unit to finish its transition" ;;
esac

for ((attempt = 0; attempt < 100; attempt++)); do
  systemctl --user is-active --quiet "$unit" ||
    fail "shared server exited before becoming ready; inspect $unit"
  if [[ -S "$socket" ]]; then
    [[ "$(stat -Lc '%u' "$socket")" = "$UID" ]] ||
      fail "shared server socket belongs to another user"
    # Codex may publish this endpoint as a symlink; the kernel lists its target.
    listener_socket="$(realpath -e "$socket")" || fail "cannot resolve shared server socket"
    listeners="$(ss -H -xl src "$listener_socket")" || fail "cannot inspect shared server listener"
    if [[ -n "$listeners" ]]; then
      printf '%s\n' "$endpoint"
      exit 0
    fi
  fi
  sleep 0.1
done
fail "shared server did not become ready within 10 seconds; inspect $unit"
