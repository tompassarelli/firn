#!/usr/bin/env python3
"""Report structural problems in a flat todo record directory.

The default deliberately exits successfully: it is the migration baseline for
an inherited corpus.  --strict turns every reported finding into exit status 1
once the corpus is ready to be ratcheted.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import tomllib
from dataclasses import asdict, dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


REQUIRED_FIELDS = ("id", "title", "shape", "life", "updated_at", "owners")
REFERENCE_FIELDS = {
    "realizes": "scalar",
    "plan": "scalar",
    "requires": "list",
    "supports": "list",
    "relates_to": "list",
}
ROOT_ALLOWED_FIELDS = set(REQUIRED_FIELDS) | set(REFERENCE_FIELDS) | {
    "assigned_to",
    "attempt",
    "conversation_ids",
    "coordination",
    "delegated_by",
    "expires_at",
    "lane",
    "quality_debt",
}
LIVE_LANE_STATES = {"active", "live"}
ATTEMPT_REQUIRED_FIELDS = (
    "id",
    "seam",
    "class",
    "wall_time_estimate",
    "agent_time_estimate",
    "calibration_sample_count",
    "started_at",
    "model",
    "reasoning",
    "route",
    "assignment_id",
    "role",
    "review_budget",
)
ATTEMPT_SETTLEMENT_FIELDS = (
    "ended_at",
    "outcome",
    "wall_time_actual",
    "agent_time_actual",
    "queue_block_time_actual",
    "verification_time_actual",
    "execution_observation",
)
ATTEMPT_TIME_FIELDS = {
    "wall_time_estimate",
    "agent_time_estimate",
    "wall_time_actual",
    "agent_time_actual",
    "queue_block_time_actual",
    "verification_time_actual",
    "review_repair_time_actual",
}
ATTEMPT_OPTIONAL_FIELDS = {
    "queue_block_cause",
    "verification_summary",
    "race",
    "race_outcome",
    "reviewed_commit",
    "review_outcome",
    "review_summary",
    "reviewer_model",
    "reviewer_reasoning",
    "review_repair_time_actual",
}
ATTEMPT_ALLOWED_FIELDS = set(ATTEMPT_REQUIRED_FIELDS) | set(ATTEMPT_SETTLEMENT_FIELDS) | ATTEMPT_OPTIONAL_FIELDS
OBSERVATION_FIELDS = {
    "version",
    "coverage",
    "source",
    "turn_unit",
    "tool_call_unit",
    "evidence",
    "segments",
}
OBSERVATION_EVIDENCE_FIELDS = {"provider", "attempt_sha256", "session_sha256"}
SEGMENT_FIELDS = {"mode", "turn_count", "tool_call_count", "turn_sha256"}
OBSERVATION_COVERAGE = {"exact", "unknown"}
OBSERVATION_VERSION = "agent-execution-observation/v1"
EXECUTION_MODES = {"standard", "fast"}
EXECUTION_SHAPES = {"project", "task"}
REVIEW_BUDGETS = {"none", "owner", "independent"}
REVIEW_OUTCOMES = {"clean", "findings", "not-run"}
ESTIMATED_DURATION_PATTERN = re.compile(r"^(?:~|under )?(?:\d+(?:\.\d+)?(?:ms|s|m|h|d))+$")
ACTUAL_DURATION_PATTERN = re.compile(r"^(?:\d+(?:\.\d+)?(?:ms|s|m|h|d))+$")
OBSERVATION_TOKEN_PATTERN = re.compile(r"^[a-z0-9][a-z0-9._:/-]*$")
SHA256_PATTERN = re.compile(r"^[0-9a-f]{64}$")


@dataclass(frozen=True)
class Finding:
    code: str
    severity: str
    path: str
    message: str


@dataclass
class Record:
    path: Path
    data: dict[str, Any]


class Linter:
    def __init__(self, root: Path, now: datetime, drift_seconds: int) -> None:
        self.root = root
        self.now = now
        self.drift_seconds = drift_seconds
        self.findings: list[Finding] = []
        self.records: list[Record] = []
        self.worktrees: dict[str, dict[str, str | None]] = {}

    def add(self, code: str, path: Path | str, message: str, severity: str = "error") -> None:
        try:
            shown = str(Path(path).relative_to(self.root))
        except ValueError:
            shown = str(path)
        self.findings.append(Finding(code, severity, shown, message))

    def run(self) -> list[Finding]:
        if not self.root.is_dir():
            self.add("TODO_ROOT_MISSING", self.root, "todo root is not a directory")
            return self.sorted_findings()
        self.check_top_level()
        self.check_records()
        self.check_attempts()
        self.check_references()
        self.check_lanes()
        return self.sorted_findings()

    def sorted_findings(self) -> list[Finding]:
        return sorted(self.findings, key=lambda item: (item.path, item.code, item.message))

    def check_top_level(self) -> None:
        for entry in sorted(self.root.iterdir(), key=lambda item: item.name):
            if entry.name == ".git":
                continue
            if entry.is_dir():
                self.add("TOP_LEVEL_SUBDIRECTORY", entry, "todo storage must stay flat")
            elif not entry.is_file() or entry.suffix.lower() != ".md":
                self.add("TOP_LEVEL_NON_MARKDOWN", entry, "only Markdown records belong at the todo root")

    def check_records(self) -> None:
        by_id: dict[str, list[Record]] = {}
        for path in sorted(self.root.glob("*.md")):
            if path.name in {"AGENTS.md", "agent-coord.md"}:
                continue
            record = self.parse_record(path)
            if record is None:
                continue
            self.records.append(record)
            record_id = record.data.get("id")
            if isinstance(record_id, str) and record_id:
                by_id.setdefault(record_id, []).append(record)
                if record_id != path.stem:
                    self.add(
                        "ID_FILENAME_MISMATCH",
                        path,
                        f'id is "{record_id}", but filename stem is "{path.stem}"',
                    )
            self.check_record_fields(record)
            self.check_timestamps(record)

        for record_id, matches in by_id.items():
            if len(matches) > 1:
                for record in matches:
                    self.add("DUPLICATE_ID", record.path, f'id "{record_id}" appears in {len(matches)} records')

    def parse_record(self, path: Path) -> Record | None:
        try:
            lines = path.read_text(encoding="utf-8").splitlines()
        except UnicodeDecodeError as error:
            self.add("FRONT_MATTER_INVALID", path, f"record is not UTF-8: {error}")
            return None
        if not lines or lines[0] != "+++":
            self.add("FRONT_MATTER_MISSING", path, "record must start with TOML front matter delimited by +++")
            return None
        try:
            end = lines.index("+++", 1)
        except ValueError:
            self.add("FRONT_MATTER_INVALID", path, "opening +++ has no closing delimiter")
            return None
        try:
            data = tomllib.loads("\n".join(lines[1:end]))
        except tomllib.TOMLDecodeError as error:
            self.add("FRONT_MATTER_INVALID", path, f"invalid TOML: {error}")
            return None
        if not isinstance(data, dict):
            self.add("FRONT_MATTER_INVALID", path, "front matter must decode to a TOML table")
            return None
        return Record(path, data)

    def check_record_fields(self, record: Record) -> None:
        for field in sorted(set(record.data).difference(ROOT_ALLOWED_FIELDS)):
            self.add("ROOT_FIELD_UNKNOWN", record.path, f'front matter has unknown root field "{field}"')
        for field in REQUIRED_FIELDS:
            if field not in record.data:
                self.add("FRONT_MATTER_REQUIRED_FIELD", record.path, f'missing required field "{field}"')
        if not isinstance(record.data.get("id"), str) or not record.data.get("id"):
            self.add("ID_INVALID", record.path, 'id must be a non-empty string')
        if "owners" in record.data and not self.is_string_list(record.data["owners"]):
            self.add("FIELD_TYPE_INVALID", record.path, 'owners must be an array of strings')
        for field, kind in REFERENCE_FIELDS.items():
            if field not in record.data:
                continue
            value = record.data[field]
            expected = "a string" if kind == "scalar" else "an array of strings"
            valid = isinstance(value, str) and bool(value) if kind == "scalar" else self.is_string_list(value)
            if not valid:
                self.add("REFERENCE_TYPE_INVALID", record.path, f'{field} must be {expected}')

    @staticmethod
    def is_string_list(value: Any) -> bool:
        return isinstance(value, list) and all(isinstance(item, str) and item for item in value)

    def check_references(self) -> None:
        records_by_id = {
            record.data["id"]: record
            for record in self.records
            if isinstance(record.data.get("id"), str) and record.data["id"]
        }
        known_ids = set(records_by_id)
        for record in self.records:
            for field, kind in REFERENCE_FIELDS.items():
                value = record.data.get(field)
                if value is None:
                    continue
                if kind == "scalar":
                    values = [value] if isinstance(value, str) and value else []
                else:
                    values = value if self.is_string_list(value) else []
                for reference in values:
                    if field == "requires" and reference.startswith("external:"):
                        continue
                    if reference not in known_ids:
                        self.add(
                            "REFERENCE_UNRESOLVED",
                            record.path,
                            f'{field} references unknown record id "{reference}"',
                        )
        self.check_requires_graph(records_by_id)

    def check_requires_graph(self, records_by_id: dict[str, Record]) -> None:
        graph: dict[str, list[str]] = {}
        for record_id, record in records_by_id.items():
            values = record.data.get("requires")
            internal = [] if not self.is_string_list(values) else [value for value in values if value in records_by_id]
            graph[record_id] = internal
            if record_id in internal:
                self.add("REQUIRES_SELF", record.path, f'requires contains its own record id "{record_id}"')

        state: dict[str, int] = {}
        reported: set[str] = set()

        def visit(record_id: str, stack: list[str]) -> None:
            state[record_id] = 1
            stack.append(record_id)
            for required_id in graph[record_id]:
                if required_id == record_id:
                    continue
                if state.get(required_id, 0) == 0:
                    visit(required_id, stack)
                elif state.get(required_id) == 1:
                    cycle = stack[stack.index(required_id):] + [required_id]
                    key = " -> ".join(cycle)
                    if key not in reported:
                        reported.add(key)
                        self.add("REQUIRES_CYCLE", records_by_id[record_id].path, f"requires cycle: {key}")
            stack.pop()
            state[record_id] = 2

        for record_id in sorted(graph):
            if state.get(record_id, 0) == 0:
                visit(record_id, [])

    def check_timestamps(self, record: Record) -> None:
        updated = self.parse_timestamp(record, "updated_at")
        expires = self.parse_timestamp(record, "expires_at") if "expires_at" in record.data else None
        if updated is not None:
            if updated > self.now:
                self.add("TIMESTAMP_FUTURE", record.path, "updated_at is in the future")
            mtime = datetime.fromtimestamp(record.path.stat().st_mtime, tz=timezone.utc)
            drift = abs((updated.astimezone(timezone.utc) - mtime).total_seconds())
            if drift > self.drift_seconds:
                self.add(
                    "TIMESTAMP_MTIME_DRIFT",
                    record.path,
                    f"updated_at differs from file mtime by {int(drift)} seconds",
                    severity="warning",
                )
        if record.data.get("life") == "active":
            if "expires_at" not in record.data:
                self.add("ACTIVE_EXPIRES_AT_MISSING", record.path, "active records must be reasserted with expires_at", "warning")
            elif expires is not None and expires <= self.now:
                self.add("ACTIVE_EXPIRES_AT_OVERDUE", record.path, "active record has an overdue expires_at", "warning")

    def parse_timestamp(self, record: Record, field: str) -> datetime | None:
        value = record.data.get(field)
        if isinstance(value, datetime):
            parsed = value
        elif isinstance(value, str):
            try:
                parsed = datetime.fromisoformat(value)
            except ValueError:
                self.add("TIMESTAMP_INVALID", record.path, f'{field} is not an ISO 8601 timestamp')
                return None
        else:
            self.add("TIMESTAMP_INVALID", record.path, f'{field} must be an ISO 8601 timestamp')
            return None
        if parsed.tzinfo is None:
            self.add("TIMESTAMP_INVALID", record.path, f'{field} must include a UTC offset')
            return None
        return parsed

    def check_attempts(self) -> None:
        for record in self.records:
            attempts = record.data.get("attempt")
            lanes = record.data.get("lane")
            owns_live_lane = isinstance(lanes, list) and any(
                isinstance(lane, dict)
                and isinstance(lane.get("state"), str)
                and lane["state"].strip().casefold() in LIVE_LANE_STATES
                for lane in lanes
            )
            shape = record.data.get("shape")
            execution_record = isinstance(shape, str) and shape in EXECUTION_SHAPES
            needs_attempt = execution_record and (record.data.get("life") == "active" or owns_live_lane)
            if attempts is None:
                if needs_attempt:
                    self.add("ACTIVE_EXECUTION_ATTEMPT_MISSING", record.path, "an active task or project needs an attempt")
                continue
            if not execution_record:
                self.add("ATTEMPT_RECORD_SHAPE_INVALID", record.path, "only task and project records may have attempts")
            if not isinstance(attempts, list):
                self.add("ATTEMPT_TYPE_INVALID", record.path, "attempt must be an array of tables")
                continue
            if not attempts:
                self.add("ATTEMPT_EMPTY", record.path, "attempt must contain at least one table")
                continue
            seen_ids: set[str] = set()
            for index, attempt in enumerate(attempts, 1):
                self.check_attempt(record.path, index, attempt, seen_ids)

    def check_attempt(self, path: Path, index: int, attempt: Any, seen_ids: set[str]) -> None:
        label = f"attempt {index}"
        if not isinstance(attempt, dict):
            self.add("ATTEMPT_TYPE_INVALID", path, f"{label} must be a TOML table")
            return
        for field in sorted(set(attempt).difference(ATTEMPT_ALLOWED_FIELDS)):
            self.add("ATTEMPT_FIELD_UNKNOWN", path, f'{label} has unknown field "{field}"')
        missing = [field for field in ATTEMPT_REQUIRED_FIELDS if field not in attempt]
        if missing:
            self.add("ATTEMPT_FIELD_REQUIRED", path, f"{label} is missing {', '.join(missing)}")
        attempt_id = attempt.get("id")
        if isinstance(attempt_id, str) and attempt_id:
            if attempt_id in seen_ids:
                self.add("ATTEMPT_ID_DUPLICATE", path, f'{label} repeats id "{attempt_id}"')
            seen_ids.add(attempt_id)
        elif "id" in attempt:
            self.add("ATTEMPT_FIELD_INVALID", path, f"{label} id must be a non-empty string")
        for field in ATTEMPT_REQUIRED_FIELDS:
            if field in {"calibration_sample_count", "id"} or field not in attempt:
                continue
            if not isinstance(attempt[field], str) or not attempt[field]:
                self.add("ATTEMPT_FIELD_INVALID", path, f"{label} {field} must be a non-empty string")
        sample_count = attempt.get("calibration_sample_count")
        if sample_count is not None and (not isinstance(sample_count, int) or isinstance(sample_count, bool) or sample_count < 0):
            self.add("ATTEMPT_FIELD_INVALID", path, f"{label} calibration_sample_count must be a non-negative integer")
        for field in sorted(ATTEMPT_TIME_FIELDS.intersection(attempt)):
            pattern = ESTIMATED_DURATION_PATTERN if field.endswith("_estimate") else ACTUAL_DURATION_PATTERN
            if not isinstance(attempt[field], str) or pattern.fullmatch(attempt[field]) is None:
                qualifier = "estimated " if field.endswith("_estimate") else "exact actual "
                self.add("ATTEMPT_FIELD_INVALID", path, f"{label} {field} must be an {qualifier}compact duration")
        settled = any(field in attempt for field in ATTEMPT_SETTLEMENT_FIELDS)
        if settled:
            missing_settlement = [field for field in ATTEMPT_SETTLEMENT_FIELDS if field not in attempt]
            if missing_settlement:
                self.add("ATTEMPT_SETTLEMENT_INCOMPLETE", path, f"{label} is missing {', '.join(missing_settlement)}")
        review_budget = attempt.get("review_budget")
        if not isinstance(review_budget, str) or review_budget not in REVIEW_BUDGETS:
            self.add("ATTEMPT_REVIEW_BUDGET_INVALID", path, f"{label} review_budget must be none, owner, or independent")
        review_outcome = attempt.get("review_outcome")
        if "review_outcome" in attempt and (
            not isinstance(review_outcome, str) or review_outcome not in REVIEW_OUTCOMES
        ):
            self.add("ATTEMPT_REVIEW_OUTCOME_INVALID", path, f"{label} review_outcome must be clean, findings, or not-run")
        timestamps = {
            field: self.check_attempt_timestamp(path, label, field, attempt[field])
            for field in ("started_at", "ended_at")
            if field in attempt
        }
        if timestamps.get("started_at") is not None and timestamps.get("ended_at") is not None:
            if timestamps["ended_at"] < timestamps["started_at"]:
                self.add("ATTEMPT_CHRONOLOGY_INVALID", path, f"{label} ended_at precedes started_at")
        if "outcome" in attempt and (not isinstance(attempt["outcome"], str) or not attempt["outcome"]):
            self.add("ATTEMPT_FIELD_INVALID", path, f"{label} outcome must be a non-empty string")
        for field in (
            "queue_block_cause",
            "verification_summary",
            "review_summary",
            "reviewed_commit",
            "reviewer_model",
            "reviewer_reasoning",
            "race",
            "race_outcome",
        ):
            if field in attempt and (not isinstance(attempt[field], str) or not attempt[field]):
                self.add("ATTEMPT_FIELD_INVALID", path, f"{label} {field} must be a non-empty string")
        if "execution_observation" in attempt:
            self.check_execution_observation(
                path, label, attempt["execution_observation"]
            )
        self.check_attempt_review(path, label, attempt, settled)

    def check_execution_observation(
        self, path: Path, label: str, observation: Any
    ) -> None:
        observation_label = f"{label} execution_observation"
        if not isinstance(observation, dict):
            self.add(
                "ATTEMPT_EXECUTION_OBSERVATION_INVALID",
                path,
                f"{observation_label} must be one object",
            )
            return
        missing = sorted(OBSERVATION_FIELDS - set(observation))
        unknown = sorted(set(observation) - OBSERVATION_FIELDS)
        if missing:
            self.add(
                "ATTEMPT_EXECUTION_OBSERVATION_INVALID",
                path,
                f"{observation_label} is missing {', '.join(missing)}",
            )
        if unknown:
            self.add(
                "ATTEMPT_EXECUTION_OBSERVATION_INVALID",
                path,
                f"{observation_label} has unknown fields {', '.join(unknown)}",
            )
        coverage = observation.get("coverage")
        if observation.get("version") != OBSERVATION_VERSION:
            self.add(
                "ATTEMPT_EXECUTION_OBSERVATION_INVALID",
                path,
                f"{observation_label} version must be {OBSERVATION_VERSION}",
            )
        if coverage not in OBSERVATION_COVERAGE:
            self.add(
                "ATTEMPT_EXECUTION_OBSERVATION_INVALID",
                path,
                f"{observation_label} coverage must be exact or unknown",
            )
        for field in ("source", "turn_unit", "tool_call_unit"):
            value = observation.get(field)
            if not isinstance(value, str) or OBSERVATION_TOKEN_PATTERN.fullmatch(value) is None:
                self.add(
                    "ATTEMPT_EXECUTION_OBSERVATION_INVALID",
                    path,
                    f"{observation_label} {field} must be one stable token",
                )
        segments = observation.get("segments")
        evidence = observation.get("evidence")
        if not isinstance(segments, list):
            self.add(
                "ATTEMPT_EXECUTION_OBSERVATION_INVALID",
                path,
                f"{observation_label} segments must be an ordered array",
            )
            return
        if coverage == "unknown":
            if segments:
                self.add(
                    "ATTEMPT_EXECUTION_OBSERVATION_INVALID",
                    path,
                    f"{observation_label} unknown coverage cannot carry segments",
                )
            if observation.get("turn_unit") != "unknown" or observation.get("tool_call_unit") != "unknown":
                self.add(
                    "ATTEMPT_EXECUTION_OBSERVATION_INVALID",
                    path,
                    f"{observation_label} unknown coverage needs unknown units",
                )
            if evidence != {}:
                self.add(
                    "ATTEMPT_EXECUTION_OBSERVATION_INVALID",
                    path,
                    f"{observation_label} unknown coverage cannot fabricate evidence",
                )
            return
        if coverage == "exact":
            if not segments:
                self.add(
                    "ATTEMPT_EXECUTION_OBSERVATION_INVALID",
                    path,
                    f"{observation_label} exact coverage needs a segment",
                )
            if observation.get("turn_unit") != "assistant-turn" or observation.get("tool_call_unit") != "admitted-tool-call":
                self.add(
                    "ATTEMPT_EXECUTION_OBSERVATION_INVALID",
                    path,
                    f"{observation_label} exact coverage needs assistant-turn and admitted-tool-call units",
                )
            if not isinstance(evidence, dict) or set(evidence) != OBSERVATION_EVIDENCE_FIELDS:
                self.add(
                    "ATTEMPT_EXECUTION_OBSERVATION_INVALID",
                    path,
                    f"{observation_label} exact evidence must name provider and hashed attempt/session joins",
                )
            elif (
                not isinstance(evidence.get("provider"), str)
                or OBSERVATION_TOKEN_PATTERN.fullmatch(evidence["provider"]) is None
                or any(
                    not isinstance(evidence.get(field), str)
                    or SHA256_PATTERN.fullmatch(evidence[field]) is None
                    for field in ("attempt_sha256", "session_sha256")
                )
            ):
                self.add(
                    "ATTEMPT_EXECUTION_OBSERVATION_INVALID",
                    path,
                    f"{observation_label} exact evidence contains an invalid provider or digest",
                )
        prior_mode: str | None = None
        observed_turns: set[str] = set()
        for index, segment in enumerate(segments, 1):
            segment_label = f"{observation_label} segment {index}"
            if not isinstance(segment, dict) or set(segment) != SEGMENT_FIELDS:
                self.add(
                    "ATTEMPT_EXECUTION_SEGMENT_INVALID",
                    path,
                    f"{segment_label} must use the exact segment fields",
                )
                continue
            mode = segment.get("mode")
            if mode not in EXECUTION_MODES:
                self.add(
                    "ATTEMPT_EXECUTION_SEGMENT_INVALID",
                    path,
                    f"{segment_label} mode must be standard or fast",
                )
            elif mode == prior_mode:
                self.add(
                    "ATTEMPT_EXECUTION_SEGMENT_INVALID",
                    path,
                    f"{segment_label} repeats the preceding mode",
                )
            prior_mode = mode if isinstance(mode, str) else None
            turn_count = segment.get("turn_count")
            tool_count = segment.get("tool_call_count")
            turn_digests = segment.get("turn_sha256")
            if not isinstance(turn_count, int) or isinstance(turn_count, bool) or turn_count <= 0:
                self.add(
                    "ATTEMPT_EXECUTION_SEGMENT_INVALID",
                    path,
                    f"{segment_label} turn_count must be a positive integer",
                )
            if not isinstance(tool_count, int) or isinstance(tool_count, bool) or tool_count < 0:
                self.add(
                    "ATTEMPT_EXECUTION_SEGMENT_INVALID",
                    path,
                    f"{segment_label} tool_call_count must be a non-negative integer",
                )
            if (
                not isinstance(turn_digests, list)
                or not turn_digests
                or any(
                    not isinstance(item, str) or SHA256_PATTERN.fullmatch(item) is None
                    for item in turn_digests
                )
                or len(set(turn_digests)) != len(turn_digests)
                or bool(observed_turns.intersection(turn_digests))
                or (
                    isinstance(turn_count, int)
                    and not isinstance(turn_count, bool)
                    and len(turn_digests) != turn_count
                )
            ):
                self.add(
                    "ATTEMPT_EXECUTION_SEGMENT_INVALID",
                    path,
                    f"{segment_label} turn_sha256 must uniquely account for turn_count",
                )
            if isinstance(turn_digests, list):
                observed_turns.update(
                    item for item in turn_digests if isinstance(item, str)
                )

    def check_attempt_review(self, path: Path, label: str, attempt: dict[str, Any], settled: bool) -> None:
        review_outcome = attempt.get("review_outcome")
        reviewer_fields = ("reviewer_model", "reviewer_reasoning")
        if settled and "review_outcome" not in attempt:
            self.add("ATTEMPT_REVIEW_OUTCOME_REQUIRED", path, f"{label} settled without review_outcome")
        if isinstance(review_outcome, str) and review_outcome in {"clean", "findings"}:
            if not isinstance(attempt.get("reviewed_commit"), str) or not attempt["reviewed_commit"]:
                self.add("ATTEMPT_REVIEW_INCOMPLETE", path, f"{label} {review_outcome} review needs reviewed_commit")
            if attempt.get("review_budget") == "independent" and any(field not in attempt for field in reviewer_fields):
                self.add(
                    "ATTEMPT_REVIEW_INCOMPLETE",
                    path,
                    f"{label} independent review needs reviewer_model and reviewer_reasoning",
                )
        if any(field in attempt for field in reviewer_fields) and any(field not in attempt for field in reviewer_fields):
            self.add(
                "ATTEMPT_REVIEW_INCOMPLETE",
                path,
                f"{label} reviewer_model and reviewer_reasoning must appear together",
            )
        if "review_repair_time_actual" in attempt and review_outcome != "findings":
            self.add("ATTEMPT_REVIEW_REPAIR_INVALID", path, f"{label} review repair time requires findings")

    def check_attempt_timestamp(self, path: Path, label: str, field: str, value: Any) -> datetime | None:
        if isinstance(value, datetime):
            parsed = value
        elif isinstance(value, str):
            try:
                parsed = datetime.fromisoformat(value)
            except ValueError:
                self.add("ATTEMPT_TIMESTAMP_INVALID", path, f"{label} {field} is not an ISO 8601 timestamp")
                return None
        else:
            self.add("ATTEMPT_TIMESTAMP_INVALID", path, f"{label} {field} must be an ISO 8601 timestamp")
            return None
        if parsed.tzinfo is None:
            self.add("ATTEMPT_TIMESTAMP_INVALID", path, f"{label} {field} must include a UTC offset")
            return None
        return parsed

    def check_lanes(self) -> None:
        for record in self.records:
            lanes = record.data.get("lane")
            if lanes is None:
                continue
            if not isinstance(lanes, list):
                self.add("LANE_TYPE_INVALID", record.path, "lane must be an array of tables")
                continue
            for index, lane in enumerate(lanes, 1):
                self.check_lane(record.path, index, lane)

    def check_lane(self, path: Path, index: int, lane: Any) -> None:
        label = f"lane {index}"
        if not isinstance(lane, dict):
            self.add("LANE_TYPE_INVALID", path, f"{label} must be a TOML table")
            return
        missing = [field for field in ("repo", "worktree", "branch", "owner", "state") if not isinstance(lane.get(field), str) or not lane[field]]
        if missing:
            self.add("LANE_FIELD_INVALID", path, f"{label} needs non-empty {', '.join(missing)}")
            return
        state = lane["state"].strip().casefold()
        if state not in LIVE_LANE_STATES and state != "reaped":
            return
        repo_main = self.code_root() / lane["repo"] / "main"
        registered = self.registered_worktrees(repo_main, path, label)
        if registered is None:
            return
        worktree = self.expand_path(lane["worktree"])
        expected_path = os.path.realpath(worktree)
        registered_entry = registered.get(expected_path)
        expected_branch = lane["branch"]
        expected_ref = expected_branch if expected_branch.startswith("refs/heads/") else f"refs/heads/{expected_branch}"
        if state in LIVE_LANE_STATES:
            if not worktree.is_dir():
                self.add("LANE_WORKTREE_MISSING", path, f"{label} live worktree is absent: {worktree}")
            if registered_entry is None:
                self.add("LANE_WORKTREE_UNREGISTERED", path, f"{label} is not registered by {repo_main}")
            elif registered_entry.get("branch") != expected_ref:
                actual = registered_entry.get("branch") or "detached HEAD"
                self.add("LANE_BRANCH_MISMATCH", path, f"{label} expects {expected_ref}, registered {actual}")
            branch = self.git_branch_exists(repo_main, expected_ref)
            if branch is False:
                self.add("LANE_BRANCH_MISSING", path, f"{label} live branch is absent: {expected_ref}")
        else:
            if os.path.lexists(worktree) or registered_entry is not None:
                self.add("LANE_REAPED_WORKTREE_PRESENT", path, f"{label} is marked reaped but its worktree remains")
            branch = self.git_branch_exists(repo_main, expected_ref)
            if branch is None:
                return
            if branch:
                self.add("LANE_REAPED_BRANCH_PRESENT", path, f"{label} is marked reaped but {expected_ref} remains")

    def code_root(self) -> Path:
        return Path(os.environ.get("CODE_ROOT", str(Path.home() / "code"))).expanduser()

    @staticmethod
    def expand_path(value: str) -> Path:
        return Path(value).expanduser()

    def registered_worktrees(self, repo_main: Path, path: Path, label: str) -> dict[str, dict[str, str | None]] | None:
        if not repo_main.is_dir():
            self.add("LANE_REPOSITORY_UNAVAILABLE", path, f"{label} repository checkout is absent: {repo_main}")
            return None
        result = subprocess.run(
            ["git", "-C", str(repo_main), "worktree", "list", "--porcelain"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
        if result.returncode != 0:
            self.add("LANE_REPOSITORY_UNAVAILABLE", path, f"{label} cannot read Git worktree registration: {result.stderr.strip()}")
            return None
        entries: dict[str, dict[str, str | None]] = {}
        current: dict[str, str | None] = {}
        for line in [*result.stdout.splitlines(), ""]:
            if not line:
                if current.get("worktree"):
                    entries[os.path.realpath(str(current["worktree"]))] = current
                current = {}
            elif " " in line:
                key, value = line.split(" ", 1)
                current[key] = value
            else:
                current[line] = None
        return entries

    def git_branch_exists(self, repo_main: Path, ref: str) -> bool | None:
        result = subprocess.run(
            ["git", "-C", str(repo_main), "show-ref", "--verify", "--quiet", ref],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if result.returncode in (0, 1):
            return result.returncode == 0
        return None


def parse_now(value: str | None) -> datetime:
    if value is None:
        return datetime.now(timezone.utc)
    parsed = datetime.fromisoformat(value)
    if parsed.tzinfo is None:
        raise argparse.ArgumentTypeError("--now must include a UTC offset")
    return parsed


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="report structural todo-record problems")
    parser.add_argument("root", nargs="?", default=os.environ.get("TODO_ROOT", str(Path.home() / "code" / "todo")))
    parser.add_argument("--strict", action="store_true", help="exit 1 when findings are present")
    parser.add_argument("--format", choices=("text", "json"), default="text")
    parser.add_argument("--now", help="ISO 8601 timestamp for deterministic expiry checks")
    parser.add_argument(
        "--mtime-drift-seconds",
        type=int,
        default=172800,
        help="report updated_at/file-mtime drift beyond this many seconds (default: 172800)",
    )
    args = parser.parse_args(argv)
    if args.mtime_drift_seconds < 0:
        parser.error("--mtime-drift-seconds must be non-negative")
    try:
        args.now = parse_now(args.now)
    except (ValueError, argparse.ArgumentTypeError) as error:
        parser.error(f"invalid --now: {error}")
    return args


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    linter = Linter(Path(args.root).expanduser(), args.now, args.mtime_drift_seconds)
    findings = linter.run()
    if args.format == "json":
        errors = sum(finding.severity == "error" for finding in findings)
        warnings = len(findings) - errors
        print(json.dumps({"root": str(linter.root), "findings": [asdict(finding) for finding in findings], "summary": {"findings": len(findings), "errors": errors, "warnings": warnings}}, sort_keys=True))
    elif findings:
        for finding in findings:
            print(f"{finding.severity.upper():7} {finding.code:<30} {finding.path}: {finding.message}")
        mode = "strict" if args.strict else "report-only"
        print(f"todo-lint: {len(findings)} finding(s) ({mode})")
    else:
        print("todo-lint: clean")
    return 1 if args.strict and findings else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
