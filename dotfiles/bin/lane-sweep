#!/usr/bin/env python3
# Archive and remove idle worktree lanes and stale branches under ~/code/*/worktrees.
"""lane-sweep: archive, then remove, abandoned worktree lanes and branches.

For every ~/code/<repo> container (client repositories under ~/code/clients are
never visited), each lane under <repo>/worktrees/ that no process sits in and
that has no file modified within --idle-hours is snapshotted, including
uncommitted, untracked and ignored files except build output and
dependency caches, into refs/archive/<date>/<slug>.
Branches not checked out anywhere whose tip is older than --idle-hours get an
archive ref at their tip. All archive refs go into a verified bundle under
~/.local/state/agents/lane-archive/ before anything is removed. Lanes whose
issue is open and whose work is not on main get one comment per issue listing
them with the restore command.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass, field
from datetime import datetime
from pathlib import Path

HOME = Path.home()
GH = os.environ.get("LANE_SWEEP_GH", "gh")
SKIP_CONTAINERS = {"clients", "resources", "archive"}
# Regenerated by a build or install; never archived, and their contents do not
# count as activity.
DISPOSABLE = {"node_modules", "build", "_build", "target", "toolchain", "dist", ".direnv",
              ".beagle-cache", ".cache", ".lsp", ".clj-kondo", "result", "__pycache__"}


def git(repo: Path | str, *args: str, env: dict | None = None, check: bool = True) -> str:
    r = subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True, env=env)
    if check and r.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)} in {repo}: {r.stderr.strip()}")
    return r.stdout.strip() if r.returncode == 0 else ""


def ok(repo: Path | str, *args: str) -> bool:
    return subprocess.run(["git", "-C", str(repo), *args], capture_output=True).returncode == 0


def tilde(p: Path | str) -> str:
    s = str(p)
    h = str(HOME)
    return "~" + s[len(h):] if s == h or s.startswith(h + "/") else s


@dataclass
class Lane:
    slug: str
    path: Path | None  # None for a branch with no worktree
    branch: str | None
    head: str
    ref: str = ""
    archive: str = ""
    category: str = ""  # landed | closed | open | no-issue
    issue: tuple[str, int] | None = None
    files: list[str] = field(default_factory=list)
    summary: str = ""
    note: str = ""


def process_cwds() -> list[str]:
    cwds = []
    for p in Path("/proc").iterdir():
        if p.name.isdigit():
            try:
                cwds.append(os.readlink(p / "cwd"))
            except OSError:
                pass
    return cwds


def newest_mtime_after(paths: list[Path], cutoff: float) -> bool:
    for root in paths:
        try:
            if root.lstat().st_mtime > cutoff:
                return True
        except OSError:
            continue
        if not root.is_dir() or root.is_symlink():
            continue
        stack = [str(root)]
        while stack:
            d = stack.pop()
            try:
                with os.scandir(d) as it:
                    for e in it:
                        try:
                            st = e.stat(follow_symlinks=False)
                        except OSError:
                            continue
                        if st.st_mtime > cutoff:
                            return True
                        if e.is_dir(follow_symlinks=False) and e.name not in DISPOSABLE:
                            stack.append(e.path)
            except OSError:
                continue
    return False


def worktrees(main: Path) -> list[dict]:
    out, cur = [], {}
    for line in git(main, "worktree", "list", "--porcelain").splitlines() + [""]:
        if not line:
            if cur:
                out.append(cur)
            cur = {}
            continue
        k, _, v = line.partition(" ")
        cur[k] = v or True
    return out


def github_slug(main: Path) -> str | None:
    url = git(main, "remote", "get-url", "origin", check=False)
    m = re.search(r"github\.com[:/]([^/]+)/([^/]+?)(?:\.git)?$", url)
    return f"{m.group(1)}/{m.group(2)}" if m else None


def name_issues(name: str) -> list[int]:
    found = []
    for seg in re.split(r"[-_/#.]", name):
        m = re.fullmatch(r"[A-Za-z]*?(\d{2,4})", seg)
        if m and not re.fullmatch(r"20\d{6}", seg):
            found.append(int(m.group(1)))
    return found


class Sweeper:
    def __init__(self, args):
        self.args = args
        self.cutoff = time.time() - args.idle_hours * 3600
        self.date = args.date or datetime.now().strftime("%Y%m%d")
        self.archive_dir = Path(args.archive_dir).expanduser()
        self.cwds = process_cwds()
        self.keep = {os.path.realpath(os.path.expanduser(k)) for k in args.keep}
        self.issue_cache: dict[str, dict[int, str]] = {}
        self.comments: dict[tuple[str, int], list[tuple[str, Lane]]] = {}
        self.rows: list[str] = []

    def log(self, msg: str) -> None:
        print(msg, flush=True)

    def active(self, path: Path, gitdir: Path | None) -> str:
        p = os.path.realpath(path)
        if p in self.keep:
            return "kept by --keep"
        for c in self.cwds:
            if c == p or c.startswith(p + "/"):
                return "process inside"
        probes = [path]
        if gitdir:
            # Not the index: a plain `git status` rewrites it.
            probes += [gitdir / "HEAD", gitdir / "logs" / "HEAD"]
        if newest_mtime_after(probes, self.cutoff):
            return f"modified within {self.args.idle_hours:g}h"
        return ""

    def issues_of(self, gh_repo: str) -> dict[int, str]:
        if gh_repo not in self.issue_cache:
            states: dict[int, str] = {}
            if not self.args.no_github:
                r = subprocess.run(
                    [GH, "issue", "list", "-R", gh_repo, "--state", "all", "--limit", "5000",
                     "--json", "number,state"], capture_output=True, text=True)
                if r.returncode == 0:
                    states = {i["number"]: i["state"] for i in json.loads(r.stdout or "[]")}
                else:
                    self.log(f"  issues unavailable for {gh_repo}: {r.stderr.strip()}")
            self.issue_cache[gh_repo] = states
        return self.issue_cache[gh_repo]

    def sweep_repo(self, container: Path) -> None:
        main = container / "main"
        name = container.name
        common = Path(git(main, "rev-parse", "--path-format=absolute", "--git-common-dir"))
        base = "refs/heads/main" if ok(main, "rev-parse", "--verify", "-q", "refs/heads/main") else "HEAD"
        base = git(main, "rev-parse", base)
        owner_repo = github_slug(main)
        lanes: list[Lane] = []
        checked_out: set[str] = set()
        primary = os.path.realpath(common.parent)
        self.log(f"{name}:")
        if not self.args.dry_run:
            git(main, "worktree", "prune")
        wts = worktrees(main)
        for wt in wts:
            if wt.get("branch"):
                checked_out.add(wt["branch"].removeprefix("refs/heads/"))
        for wt in wts:
            path = Path(wt["worktree"])
            branch = wt.get("branch", "").removeprefix("refs/heads/") or None
            if path.parent != container / "worktrees":
                continue
            if os.path.realpath(path) == primary:
                self.row(name, path.name, "kept", "holds the repository's .git")
                continue
            if wt.get("locked"):
                self.row(name, path.name, "kept", "locked")
                continue
            if wt.get("prunable") or not path.is_dir():
                self.row(name, path.name, "kept", "directory missing; run git worktree prune")
                continue
            gitdir = Path(git(path, "rev-parse", "--path-format=absolute", "--git-dir"))
            why = self.active(path, gitdir)
            if why:
                self.row(name, path.name, "active", why)
                continue
            lanes.append(Lane(path.name, path, branch, wt["HEAD"]))
        lane_branches = {l.branch for l in lanes if l.branch}
        for line in git(main, "for-each-ref", "--format=%(refname:short)\t%(objectname)\t%(committerdate:unix)",
                        "refs/heads").splitlines():
            b, oid, when = line.split("\t")
            if b == "main" or b in checked_out:
                continue
            log = common / "logs" / "refs" / "heads" / b
            touched = max(int(when or 0), log.stat().st_mtime if log.exists() else 0)
            if touched > self.cutoff:
                self.row(name, b, "active", f"branch moved within {self.args.idle_hours:g}h")
                continue
            lanes.append(Lane(b, None, b, oid))
        lanes = [l for l in lanes if l.path or l.branch not in lane_branches]
        if not lanes:
            return
        for lane in lanes:
            self.archive(main, lane)
            self.classify(main, base, lane, owner_repo)
        if self.args.dry_run:
            for lane in lanes:
                self.row(name, lane.slug, lane.category, lane.note, lane)
            return
        bundle = self.bundle(main, name)
        if not bundle:
            self.log(f"  bundle failed; nothing removed in {name}")
            return
        for lane in lanes:
            self.remove(main, lane)
            self.row(name, lane.slug, lane.category, lane.note, lane)
            if lane.category == "open" and lane.issue:
                self.comments.setdefault(lane.issue, []).append((name, lane))
        self.write_readme()

    def archive(self, main: Path, lane: Lane) -> None:
        commit = lane.head
        if lane.path:
            with tempfile.TemporaryDirectory() as tmp:
                env = dict(os.environ, GIT_INDEX_FILE=f"{tmp}/index")
                src = Path(git(lane.path, "rev-parse", "--path-format=absolute", "--git-path", "index"))
                if src.exists():
                    shutil.copyfile(src, f"{tmp}/index")
                else:
                    git(lane.path, "read-tree", lane.head, env=env)
                git(lane.path, "add", "-A", env=env)
                ignored = git(lane.path, "ls-files", "-z", "--others", "--ignored", "--exclude-standard",
                              "--directory").split("\0")
                keep = [f for f in ignored if f and not DISPOSABLE & set(f.rstrip("/").split("/"))]
                if keep:
                    git(lane.path, "add", "-f", "--", *keep, env=env)
                tree = git(lane.path, "write-tree", env=env)
            if tree != git(main, "rev-parse", f"{lane.head}^{{tree}}"):
                commit = git(main, "commit-tree", tree, "-p", lane.head, "-m",
                             f"lane-sweep: uncommitted state of {lane.slug}"
                             + (f" (branch {lane.branch})" if lane.branch else ""))
                lane.note = "uncommitted work archived"
        ref, n = f"refs/archive/{self.date}/{lane.slug}", 1
        while True:
            have = git(main, "rev-parse", "-q", "--verify", ref, check=False)
            if not have or have == commit:
                break
            n += 1
            ref = f"refs/archive/{self.date}/{lane.slug}-{n}"
        if not self.args.dry_run:
            git(main, "update-ref", ref, commit)
            if not ok(main, "cat-file", "-e", f"{ref}^{{commit}}") or git(main, "rev-parse", ref) != commit:
                raise RuntimeError(f"archive ref {ref} did not verify")
        lane.ref, lane.archive = ref, commit

    def classify(self, main: Path, base: str, lane: Lane, owner_repo: str | None) -> None:
        mb = git(main, "merge-base", base, lane.archive, check=False)
        lane.files = git(main, "diff", "--name-only", mb, lane.archive).splitlines() if mb else ["(unrelated history)"]
        on_main = bool(mb) and (
            not lane.files
            or ok(main, "merge-base", "--is-ancestor", lane.archive, base)
            or ok(main, "diff", "--quiet", base, lane.archive, "--", *lane.files)
            or (lane.archive == lane.head
                and not any(l.startswith("+") for l in git(main, "cherry", base, lane.archive).splitlines())))
        subjects = git(main, "log", "--format=%s", f"{base}..{lane.head}").splitlines() if mb else []
        dirty = lane.archive != lane.head
        lane.summary = (subjects[0] if subjects else "uncommitted changes") + (
            f" (+{len(subjects) - 1} earlier commits)" if len(subjects) > 1 else "") + (
            "; plus uncommitted changes" if dirty and subjects else "")
        candidates: list[tuple[str, int]] = []
        bodies = git(main, "log", "--format=%B", f"{base}..{lane.head}") if mb else ""
        for m in re.finditer(r"\b(?:Refs|Fixes|Closes|Part of)\s+([\w.-]+)?#(\d+)", bodies, re.I):
            repo = m.group(1)
            if owner_repo and repo:
                candidates.append((f"{owner_repo.split('/')[0]}/{repo}", int(m.group(2))))
            elif owner_repo:
                candidates.append((owner_repo, int(m.group(2))))
        if owner_repo:
            for nm in (lane.branch or "", lane.slug):
                candidates += [(owner_repo, n) for n in name_issues(nm)]
            if lane.path:
                for f in lane.path.glob("*"):
                    if re.search(r"handoff", f.name, re.I) and f.is_file():
                        txt = f.read_text(errors="replace")[:20000]
                        candidates += [(owner_repo, int(n)) for n in re.findall(r"#(\d+)", txt)]
        for repo, n in candidates:
            state = self.issues_of(repo).get(n)
            if state:
                lane.issue = (repo, n)
                break
        if on_main:
            lane.category = "landed"
        elif lane.issue is None:
            lane.category = "no-issue"
        elif self.issues_of(lane.issue[0])[lane.issue[1]] == "OPEN":
            lane.category = "open"
        else:
            lane.category = "closed"

    def bundle(self, main: Path, name: str) -> Path | None:
        self.archive_dir.mkdir(parents=True, exist_ok=True)
        out = self.archive_dir / f"{name}-{self.date}.bundle"
        tmp = out.with_suffix(".bundle.tmp")
        r = subprocess.run(["git", "-C", str(main), "bundle", "create", str(tmp), "--glob=refs/archive"],
                           capture_output=True, text=True)
        if r.returncode != 0 or not ok(main, "bundle", "verify", str(tmp)):
            tmp.unlink(missing_ok=True)
            self.log(f"  bundle: {r.stderr.strip()}")
            return None
        listed = set(git(main, "bundle", "list-heads", str(tmp)).splitlines())
        want = set(git(main, "for-each-ref", "--format=%(objectname) %(refname)", "refs/archive").splitlines())
        if not want <= listed:
            tmp.unlink(missing_ok=True)
            return None
        tmp.replace(out)
        for old in self.archive_dir.glob(f"{name}-[0-9]*.bundle"):
            if old != out and re.fullmatch(rf"{re.escape(name)}-\d{{8}}\.bundle", old.name):
                if set(git(main, "bundle", "list-heads", str(old), check=False).splitlines()) <= listed:
                    old.unlink()
        self.log(f"  bundle verified: {tilde(out)}")
        return out

    def remove(self, main: Path, lane: Lane) -> None:
        if not ok(main, "cat-file", "-e", f"{lane.ref}^{{commit}}"):
            lane.category, lane.note = "kept", "archive ref missing"
            return
        if lane.path:
            r = subprocess.run(["git", "-C", str(main), "worktree", "remove", "--force", str(lane.path)],
                               capture_output=True, text=True)
            if r.returncode != 0:
                lane.note = f"remove failed: {r.stderr.strip().splitlines()[-1] if r.stderr.strip() else '?'}"
                if lane.path.exists():
                    return
        if lane.branch and ok(main, "merge-base", "--is-ancestor", f"refs/heads/{lane.branch}", lane.ref):
            git(main, "branch", "-D", lane.branch, check=False)

    def row(self, repo: str, slug: str, cat: str, note: str, lane: Lane | None = None) -> None:
        issue = f"{lane.issue[0].split('/')[1]}#{lane.issue[1]}" if lane and lane.issue else "-"
        line = f"{repo}\t{slug}\t{cat}\t{issue}\t{note}"
        self.rows.append(line)
        self.log("  " + line.split("\t", 1)[1].replace("\t", "  "))

    def write_readme(self) -> None:
        (self.archive_dir / "README.md").write_text(
            "# Archived worktree lanes\n\n"
            "`lane-sweep` stores each removed lane's full state (commits, uncommitted and\n"
            "untracked files; build output and dependency caches are not kept) as\n"
            "`refs/archive/<date>/<slug>` in the repository, and every archive ref in\n"
            "`<repo>-<date>.bundle` here (the newest bundle holds all of them).\n\n"
            "Restore a lane as a worktree:\n\n"
            "    git -C ~/code/<repo>/main worktree add ~/code/<repo>/worktrees/<slug> refs/archive/<date>/<slug>\n\n"
            "Uncommitted work comes back as the top commit; `git reset HEAD~1` turns it\n"
            "back into uncommitted changes. If the refs are gone from the repository,\n"
            "fetch them from the bundle first:\n\n"
            "    git -C ~/code/<repo>/main fetch ~/.local/state/agents/lane-archive/<repo>-<date>.bundle 'refs/archive/*:refs/archive/*'\n\n"
            "List what is archived: `git -C ~/code/<repo>/main for-each-ref refs/archive`.\n")

    def post_comments(self) -> None:
        for (gh_repo, n), items in sorted(self.comments.items()):
            lines = [f"Archived {len(items)} idle lane(s) that held work for this issue not yet on main:", ""]
            for repo, lane in items:
                files = ", ".join(f"`{f}`" for f in lane.files[:12]) + (
                    f" and {len(lane.files) - 12} more" if len(lane.files) > 12 else "")
                lines += [f"- `{lane.slug}`" + (f" (branch `{lane.branch}`)" if lane.branch and lane.branch != lane.slug else "")
                          + f": {lane.summary}",
                          f"  - files: {files}",
                          f"  - restore: `git -C ~/code/{repo}/main worktree add ~/code/{repo}/worktrees/{lane.slug}"
                          f" {lane.ref}`"]
            lines += ["", f"Backup bundle: `~/.local/state/agents/lane-archive/{items[0][0]}-{self.date}.bundle`"]
            r = subprocess.run([GH, "issue", "comment", str(n), "-R", gh_repo, "--body", "\n".join(lines)],
                               capture_output=True, text=True)
            self.log(f"comment {gh_repo}#{n}: {'posted' if r.returncode == 0 else r.stderr.strip()}")


def containers(root: Path, only: list[str]) -> list[Path]:
    out = []
    for c in sorted(root.iterdir()):
        if c.name in SKIP_CONTAINERS or c.name.endswith("-data") or (only and c.name not in only):
            continue
        if (c / "main").is_dir() and (c / "worktrees").is_dir() and ok(c / "main", "rev-parse", "--git-dir"):
            out.append(c)
    return out


def main() -> int:
    ap = argparse.ArgumentParser(description="Archive, then remove, idle worktree lanes and stale branches.")
    ap.add_argument("--idle-hours", type=float, default=24)
    ap.add_argument("--keep", action="append", default=[], help="never touch this worktree path")
    ap.add_argument("--repo", action="append", default=[], help="only this container under the root")
    ap.add_argument("--root", default=str(HOME / "code"))
    ap.add_argument("--archive-dir", default="~/.local/state/agents/lane-archive")
    ap.add_argument("--date", help="archive date stamp (YYYYMMDD); default today")
    ap.add_argument("--dry-run", action="store_true", help="classify only; write no refs, remove nothing")
    ap.add_argument("--no-github", action="store_true", help="skip issue lookups and comments")
    args = ap.parse_args()
    s = Sweeper(args)
    for c in containers(Path(args.root).expanduser(), args.repo):
        try:
            s.sweep_repo(c)
        except RuntimeError as e:
            s.log(f"  {c.name}: stopped: {e}")
    if not args.dry_run and not args.no_github:
        s.post_comments()
    counts: dict[str, int] = {}
    for r in s.rows:
        repo, _, cat = r.split("\t")[:3]
        counts[f"{repo} {cat}"] = counts.get(f"{repo} {cat}", 0) + 1
    print("summary: " + ", ".join(f"{k}={v}" for k, v in sorted(counts.items())))
    return 0


if __name__ == "__main__":
    sys.exit(main())
