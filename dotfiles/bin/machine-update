#!/usr/bin/env bash
set -euo pipefail

lock_inputs() {
  jq -c '. as $l | $l.nodes[$l.root].inputs | to_entries | map({name: .key, modified: (if (.value | type) == "string" then ($l.nodes[.value].locked.lastModified // 0) else 0 end)}) | sort_by(.name)' "$1"
}
select_lock() {
  local fresh="$1" running="$2" out="$3" today cutoff fresh_names running_inputs name stamp chosen=""
  today="$(date +%F)"
  cutoff="$(date -d '7 days ago' +%F)"
  cp -- "$fresh" "$candidates/$today.lock"
  find "$candidates" -maxdepth 1 -name '*.lock' -mtime +30 -delete
  fresh_names="$(lock_inputs "$fresh" | jq -c 'map(.name)')"
  running_inputs="$(lock_inputs "$running")"
  while IFS= read -r name; do
    stamp="$(basename "$name" .lock)"
    [[ "$stamp" > "$cutoff" ]] && continue
    lock_inputs "$name" | jq -e --argjson names "$fresh_names" --argjson running "$running_inputs" \
      'map(.name) == $names and all(.[]; . as $c | ($running | map(select(.name == $c.name)) | all(.modified <= $c.modified)))' >/dev/null || continue
    chosen="$name"
    break
  done < <(find "$candidates" -maxdepth 1 -name '????-??-??.lock' | sort -r)
  if [[ -n "$chosen" ]]; then
    printf 'adopt candidate %s\n' "$(basename "$chosen" .lock)"
    cp -- "$chosen" "$out"
  else
    printf 'keep running lock: no candidate ≥7 days\n'
    cp -- "$running" "$out"
  fi
  jq --slurpfile fresh "$fresh" '
    ($fresh[0] | .nodes[.root].inputs.nixpkgs) as $new |
    (.nodes[.root].inputs.nixpkgs) as $old |
    if ($new | type) != "string" or ($old | type) != "string" then error("nixpkgs must be a direct root input")
    elif (($fresh[0].nodes[$new].inputs // {}) | length) != 0 then error("nixpkgs input unexpectedly has dependencies")
    else .nodes[$old] = $fresh[0].nodes[$new] end
  ' "$out" > "$out.next"
  mv -- "$out.next" "$out"
}

main() {
  local mode=${1:---write} source_dir repo state candidates work south container lane branch south_branch south_lane
  case "$mode" in --write|--apply|--plan) ;; *) echo 'usage: machine-update [--write|--apply|--plan]' >&2; return 2 ;; esac
  source_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
  repo="$(git -C "$source_dir" rev-parse --show-toplevel)"
  state="${XDG_STATE_HOME:-$HOME/.local/state}/machine-updates"
  mkdir -p "$state"
  exec 9>"$state/machine-update.lock"
  flock 9
  south="$HOME/code/south/main" # hardcoded-repo-path:allow
  [[ -e "$south/.git" ]] || { echo 'machine-update: required south checkout is missing; input bump cannot land' >&2; return 1; }
  git -C "$repo" fetch origin main && git -C "$repo" merge --ff-only origin/main
  git -C "$south" fetch origin main
  if [[ "$mode" == --apply ]]; then
    sudo -n -v
    git -C "$south" merge --ff-only origin/main
    cd "$repo" && firn-runtime-update
    firn rebuild
  else
    candidates="$state/flake-candidates"
    mkdir -p "$candidates"
    if [[ "$mode" == --plan ]]; then
      (
        work="$(mktemp -d)"
        trap 'rm -f -- "$work/fresh.lock" "$work/running.lock" "$work/plan.lock" "$work/plan.lock.next"; rmdir -- "$work"' EXIT
        git -C "$repo" show origin/main:flake.lock > "$work/running.lock"
        nix flake update --flake "$repo" --output-lock-file "$work/fresh.lock"
        select_lock "$work/fresh.lock" "$work/running.lock" "$work/plan.lock"
      )
      return
    fi
    container="$(dirname "$(dirname "$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)")")"
    branch="nightly-$(date +%Y%m%d-%H%M%S)-$$"
    lane="$container/worktrees/$branch"
    git -C "$repo" worktree add -b "$branch" "$lane" origin/main
    cd "$lane"
    git show origin/main:flake.lock > "$state/running.lock"
    nix flake update
    cp -- flake.lock "$state/fresh.lock"
    select_lock "$state/fresh.lock" "$state/running.lock" flake.lock
    jq -e --argjson now "$(date +%s)" '. as $l | $l.nodes[$l.nodes[$l.root].inputs.nixpkgs].locked.lastModified | type == "number" and ($now - . <= 259200)' flake.lock >/dev/null || {
      echo 'machine-update: selected nixpkgs is older than three days; refusing a missing security bump' >&2; return 1;
    }
    bun "$(dirname "$(agents path machine-capacity)")/scripts/machine-capacity.mjs" run \
      --class moderate --owner automatic-machine-update-build --timeout-seconds 1800 -- bash -c 'firn-runtime-update && firn repo build'
    bun "$(dirname "$(agents path machine-capacity)")/scripts/machine-capacity.mjs" run \
      --class moderate --owner automatic-machine-update-validate --timeout-seconds 1800 -- firn repo validate
    if [[ -n "$(git status --porcelain)" ]]; then
      while IFS= read -r -d '' path; do
        case "$path" in
          flake.lock|*.nix|*.json) git add -- "$path" ;;
          *) printf 'machine-update: unexpected generated change: %s\n' "$path" >&2; return 1 ;;
        esac
      done < <(git ls-files --modified --others --exclude-standard -z)
      git commit -m "Nightly inputs $(date +%F)"
      safe-push --to main
    else
      printf 'No input changes; upstream nixpkgs is already current.\n'
      cd "$repo"
      git worktree remove "$lane"
      git branch -d "$branch"
    fi
    cd "$repo"
    south_branch="nightly-firn-$(date +%Y%m%d-%H%M%S)-$$"
    south_lane="$(dirname "$south")/worktrees/$south_branch"
    git -C "$south" worktree add -b "$south_branch" "$south_lane" origin/main
    (
      cd "$south_lane"
      nix flake update firn
      if [[ -n "$(git status --porcelain)" ]]; then
        git add -- flake.lock
        git commit -m "Nightly firn input $(date +%F)"
        safe-push --to main
      else
        cd "$south"
        git worktree remove "$south_lane"
        git branch -d "$south_branch"
      fi
    )
    git -C "$south" merge --ff-only origin/main
  fi
  date +%s > "$state/.machine-update.success.$$"
  mv -f -- "$state/.machine-update.success.$$" "$state/machine-update.success"
  if [[ "$mode" == --apply && "$(readlink -f /run/booted-system/kernel)" != "$(readlink -f /run/current-system/kernel)" ]]; then
    notify-send 'Machine updated' 'The new kernel waits for your next reboot. No reboot was scheduled.'
  fi
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  if [[ "${1:---write}" == --apply ]]; then
    exec bun "$(dirname "$(agents path machine-capacity)")/scripts/machine-capacity.mjs" run \
      --class heavy --owner automatic-machine-update --timeout-seconds 3600 -- \
      bash -c 'source "$1"; shift; main "$@"' machine-update-bootstrap "$0" "$@"
  fi
  main "$@"
fi
