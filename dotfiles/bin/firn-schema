#!/usr/bin/env bash
set -euo pipefail
root="${FIRN_REPO:-$HOME/code/nixos-config/main}" # hardcoded-repo-path:allow
usage() {
  printf 'Usage: firn schema extract [<host>]\n       firn repo validate [all|<file>...]\n' >&2
  exit 64
}
case "${1:-} ${2:-}" in
  "schema extract")
    shift 2
    [[ "$#" -le 1 && "${1:-}" != -* ]] || usage
    mkdir -p "$root/.firn-cache"
    host="${1:-whiterabbit}"
    output="$root/.firn-cache/schema.json"
    temporary="$(mktemp "$root/.firn-cache/.schema.XXXXXX")"
    trap 'rm -f -- "$temporary"' EXIT
    nix eval --json "path:$root#nixosConfigurations.$host.options" --apply '
      options: let
        walk = prefix: value:
          if builtins.isAttrs value && (value._type or "") == "option" then [{
            name = builtins.concatStringsSep "." prefix;
            t = value.type.name or "unknown";
            description = if builtins.isString (value.description or null) then value.description else "";
            declarations = map builtins.toString (value.declarations or []);
            default = if value ? default then
              (let serialized = builtins.tryEval (builtins.toJSON value.default);
               in if serialized.success then builtins.fromJSON serialized.value else "<unevaluated>")
              else "<none>";
          }] else if builtins.isAttrs value then builtins.concatLists
            (map (name: walk (prefix ++ [name]) value.${name}) (builtins.attrNames value))
          else [];
      in walk [] options' >"$temporary"
    mv -- "$temporary" "$output"
    ;;
  "repo validate")
    shift 2
    if [[ "$#" -gt 0 && "$1" != all ]]; then
      for source in "$@"; do [[ "$source" != -* ]] || usage; done
      (cd "$root" && nix-instantiate --parse "$@" >/dev/null)
    fi
    exec bash "$root/dotfiles/bin/firn-check"
    ;;
  *) usage ;;
esac
