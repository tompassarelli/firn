#!/usr/bin/env bash
set -euo pipefail

firn_repo="${FIRN_REPO:-$HOME/code/nixos-config/main}" # hardcoded-repo-path:allow
firn_runtime_root="${FIRN_RUNTIME_ROOT:-$HOME/.local/lib/firn/cli}"
bun="${FIRN_BUN:-$firn_runtime_root/current/bin/bun}"
runtime_root="${FIRN_ACTIVITY_RUNTIME_ROOT:-$HOME/.local/lib/firn/activity}"
versions="$runtime_root/versions"
next=""

if [[ -z "$bun" || ! -x "$bun" ]]; then
  printf 'activity-runtime-update: Bun runtime is unavailable\n' >&2
  exit 127
fi

sources=(
  "$firn_repo/native/native_json.ts"
  "$firn_repo/native/activity_core.ts"
  "$firn_repo/native/activity_driver.ts"
  "$firn_repo/native/activity_native.ts"
  "$firn_repo/native/activity_menu.ts"
  "$firn_repo/native/activity_host.mjs"
)
for source in "${sources[@]}"; do
  if [[ ! -f "$source" ]]; then
    printf 'activity-runtime-update: required source is unavailable: %s\n' \
      "$source" >&2
    exit 1
  fi
done

mkdir -p "$versions"
stage="$(mktemp -d "$runtime_root/.stage.XXXXXX")"
cleanup() {
  if [[ -n "${stage:-}" ]]; then
    rm -rf -- "${stage:?}"
  fi
  if [[ -n "$next" ]]; then
    rm -f -- "$next"
  fi
}
trap cleanup EXIT INT TERM HUP
mkdir -p "$stage/bin" "$stage/lib/activity"

cp -- "$firn_repo/native/native_json.ts" \
  "$firn_repo/native/activity_core.ts" \
  "$firn_repo/native/activity_driver.ts" \
  "$firn_repo/native/activity_native.ts" "$stage/lib/activity/"
cp -- "$firn_repo/native/activity_host.mjs" "$stage/bin/activity.mjs"
cp -- "$firn_repo/native/activity_menu.ts" "$stage/bin/activity-menu.ts"
cat >"$stage/bin/activity" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export FIRN_ACTIVITY_MODULE="$root/lib/activity/activity_native.ts"
firn_runtime_root="${FIRN_RUNTIME_ROOT:-$HOME/.local/lib/firn/cli}"
bun="${FIRN_BUN:-$firn_runtime_root/current/bin/bun}"
if [[ ! -x "$bun" ]]; then
  printf 'activity: Firn Bun runtime is unavailable: %s\n' "$bun" >&2
  exit 127
fi
exec "$bun" "$root/bin/activity.mjs" "$@"
EOF
chmod +x "$stage/bin/activity"
cat >"$stage/bin/activity-menu" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
firn_runtime_root="${FIRN_RUNTIME_ROOT:-$HOME/.local/lib/firn/cli}"
bun="${FIRN_BUN:-$firn_runtime_root/current/bin/bun}"
if [[ ! -x "$bun" ]]; then
  printf 'activity-menu: Firn Bun runtime is unavailable: %s\n' "$bun" >&2
  exit 127
fi
exec "$bun" "$root/bin/activity-menu.ts" "$@"
EOF
chmod +x "$stage/bin/activity-menu"

source_id="$(sha256sum "${sources[@]}" | sha256sum | cut -d' ' -f1)"
artifact_id="$(find "$stage/bin" "$stage/lib" -type f -print0 \
  | sort -z | xargs -0 sha256sum | sha256sum | cut -d' ' -f1)"
destination="$versions/$artifact_id"
cat >"$stage/provenance" <<EOF
format=firn-activity-runtime/v3
entry=activity_native.ts/run
entry=activity_menu.ts/run
source_sha256=$source_id
artifact_sha256=$artifact_id
firn_revision=$(git -C "$firn_repo" rev-parse HEAD)
EOF

if [[ -e "$destination" ]]; then
  if [[ ! -x "$destination/bin/activity" \
        || ! -x "$destination/bin/activity-menu" ]]; then
    printf 'activity-runtime-update: existing runtime is incomplete: %s\n' \
      "$destination" >&2
    exit 1
  fi
  if ! grep -Fxq "artifact_sha256=$artifact_id" "$destination/provenance"; then
    printf 'activity-runtime-update: existing runtime identity mismatch: %s\n' \
      "$destination" >&2
    exit 1
  fi
else
  mv -- "$stage" "$destination"
  stage=""
fi

next="$runtime_root/.current.$$"
ln -s "versions/$artifact_id" "$next"
mv -Tf -- "$next" "$runtime_root/current"
next=""

printf 'activity runtime active: %s\n' "$destination"
printf 'provenance: %s\n' "$destination/provenance"
