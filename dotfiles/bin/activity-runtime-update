#!/usr/bin/env bash
set -euo pipefail

firn_repo="${FIRN_REPO:-$HOME/code/nixos-config/main}" # hardcoded-repo-path:allow
beagle_path="${BEAGLE_PATH:-$HOME/code/beagle/main}" # hardcoded-repo-path:allow
beagle="$beagle_path/bin/beagle"
bun="${FIRN_BUN:-$(command -v bun || true)}"
runtime_root="${FIRN_ACTIVITY_RUNTIME_ROOT:-$HOME/.local/lib/firn/activity}"
versions="$runtime_root/versions"
next=""

if [[ ! -x "$beagle" ]]; then
  printf 'activity-runtime-update: BEAGLE_PATH has no executable bin/beagle: %s\n' \
    "$beagle_path" >&2
  exit 1
fi
if [[ -z "$bun" || ! -x "$bun" ]]; then
  printf 'activity-runtime-update: Bun runtime is unavailable\n' >&2
  exit 127
fi

sources=(
  "$beagle_path/native-core/src/native/json.bjs"
  "$firn_repo/native/activity_core.bjs"
  "$firn_repo/native/activity_driver.bjs"
  "$firn_repo/native/activity_native.bjs"
  "$firn_repo/native/activity_host.mjs"
  "$firn_repo/native/activity_assignments_migrate.mjs"
)
for source in "${sources[@]}"; do
  if [[ ! -f "$source" ]]; then
    printf 'activity-runtime-update: required source is unavailable: %s\n' \
      "$source" >&2
    exit 1
  fi
done

mkdir -p "$versions"
stage="$(mktemp -d "$runtime_root/.stage.XXXXXX")"
cleanup() {
  if [[ -n "${stage:-}" ]]; then
    rm -rf -- "${stage:?}"
  fi
  if [[ -n "$next" ]]; then
    rm -f -- "$next"
  fi
}
trap cleanup EXIT INT TERM HUP
mkdir -p "$stage/bin" "$stage/lib"

mkdir -p "$stage/lib/activity"
if ! "$beagle" build \
  "$firn_repo/native/activity_native.bjs" \
  "$stage/lib/activity/native.js"; then
  printf 'activity-runtime-update: Beagle/JS compilation failed\n' >&2
  exit 1
fi

if [[ ! -f "$stage/lib/activity/native.js" ]]; then
  printf 'activity-runtime-update: compiler produced no activity module\n' >&2
  exit 1
fi
cp -- "$firn_repo/native/activity_host.mjs" "$stage/bin/activity.mjs"
cat >"$stage/bin/activity" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export FIRN_ACTIVITY_MODULE="$root/lib/activity/native.js"
exec "${FIRN_BUN:-bun}" "$root/bin/activity.mjs" "$@"
EOF
chmod +x "$stage/bin/activity"

source_id="$(sha256sum "${sources[@]}" | sha256sum | cut -d' ' -f1)"
artifact_id="$(find "$stage/bin" "$stage/lib" -type f -print0 \
  | sort -z | xargs -0 sha256sum | sha256sum | cut -d' ' -f1)"
destination="$versions/$artifact_id"
cat >"$stage/provenance" <<EOF
format=firn-activity-runtime/v2
entry=activity.native/run
source_sha256=$source_id
artifact_sha256=$artifact_id
firn_revision=$(git -C "$firn_repo" rev-parse HEAD)
beagle_revision=$(git -C "$beagle_path" rev-parse HEAD)
EOF

if [[ -e "$destination" ]]; then
  if [[ ! -x "$destination/bin/activity" ]]; then
    printf 'activity-runtime-update: existing runtime is incomplete: %s\n' \
      "$destination" >&2
    exit 1
  fi
  if ! grep -Fxq "artifact_sha256=$artifact_id" "$destination/provenance"; then
    printf 'activity-runtime-update: existing runtime identity mismatch: %s\n' \
      "$destination" >&2
    exit 1
  fi
else
  mv -- "$stage" "$destination"
  stage=""
fi

"$bun" "$firn_repo/native/activity_assignments_migrate.mjs"

next="$runtime_root/.current.$$"
ln -s "versions/$artifact_id" "$next"
mv -Tf -- "$next" "$runtime_root/current"
next=""

printf 'activity runtime active: %s\n' "$destination"
printf 'provenance: %s\n' "$destination/provenance"
