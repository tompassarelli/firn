#!/usr/bin/env bash
# worker-ledger: a running Claude Code worker holds its brief's issue in
# threads; a finished one releases it and is recorded as a run
# (issue ref, follows and category from its brief; tier, ETA vs actual
# minutes, output tokens, peak context, outcome, handoff note path), and a
# category x tier summary of runs.
set -uo pipefail

usage() {
  cat >&2 <<'EOF'
usage: worker-ledger [--session ID] [--since DATE]   record finished workers as runs in threads
       worker-ledger --summary [--since DATE]        per category x tier: runs against ETA, and issues closed
  --session ID  only that session's workers (default: every session's, active in the last day)
  --since DATE  only workers active on or after DATE (e.g. 2026-10-08)
A running worker whose brief names `Item:` holds that issue until it finishes.
Briefs carry `Item: <repo#N>`, `Follows: <agent id>` and `Category: <name>` lines.
Runs live in threads' database (${THREADS_DB:-~/.local/state/threads/threads.db}).
EOF
  exit 2
}

session="" since="" summary=0
while [ $# -gt 0 ]; do
  case "$1" in
    --session) [ $# -ge 2 ] || usage; session=$2; shift 2 ;;
    --since) [ $# -ge 2 ] || usage; since=$2; shift 2 ;;
    --summary) summary=1; shift ;;
    -h|--help) usage ;;
    *) usage ;;
  esac
done

threads="$(dirname "$(readlink -f "$0")")/threads"

if [ "$summary" -eq 1 ]; then
  exec "$threads" summary ${since:+--since "$since"}
fi

projects="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"
known=$("$threads" run-ids) || exit 1
rows=""

while IFS= read -r f; do
  id=$(basename "$f" .jsonl)
  id=${id#agent-}
  grep -qxF "$id" <<<"$known" && continue
  tier=$(jq -r '.agentType // empty' "${f%.jsonl}.meta.json" 2>/dev/null)
  row=$(jq -cRn --arg id "$id" --arg tier "$tier" --arg since "$since" '
    def texts: [(.message.content | if type == "array" then .[] | select(.type == "text") | .text else tostring end)] | join("\n");
    def ts: sub("\\.[0-9]+Z$"; "Z") | fromdate;
    [inputs | fromjson? | select(type == "object")] as $lines
    | [$lines[] | select(.type == "assistant" and .message.usage != null)] as $a
    | select(($a | length) > 0)
    | (if $tier != "" then $tier else ($a[-1].attributionAgent // "") end) as $agent
    | select($agent | startswith("worker"))
    | [$lines[] | select(.type == "user" or .type == "assistant")] as $m
    | ($m[-1]) as $last
    | ($last.type == "assistant" and ($last.message.content | type) == "array"
        and ([$last.message.content[].type] | index("tool_use") | not)
        and ($last | texts | length) > 0
        and (($last | texts | length) > 200 or ($last | texts | test("^\\W*(waiting|i.ll wait|i.ll pick|the test run)"; "i") | not))) as $finished
    | ([$lines[] | select(.type == "user")][0] | texts) as $brief
    | ([$a[] | select(.message.content | type == "array" and any(.[]; .type == "text")) | texts] | .[-3:] | max_by(length)) as $report
    | ($report | .[0:400]) as $head
    | ($lines | map(.timestamp // empty)) as $times
    | ($times | last) as $ended
    | select($ended >= $since)
    | (($agent | ltrimstr("worker") | ltrimstr("-")) | if . == "" then "medium" else . end) as $tiername
    | ($brief | [scan("(?i)\\bETA\\b[^0-9\\n]{0,12}([0-9]+(?:\\.[0-9]+)?)\\s*(hours?|hrs?|h|minutes?|mins?|m)\\b")] | first
       | if . == null then null else (.[0] | tonumber) * (if (.[1] | test("^h")) then 60 else 1 end) end) as $eta
    | if ($finished | not) then
        {id: $id, session: ($lines[0].sessionId // null), brief: ($brief | .[0:4000]), started: $times[0],
         tier: $tiername, eta_min: $eta,
         status: (if (now - ($ended | ts)) < 7200 then "running" else "stale" end)}
      else {
        status: "finished",
        id: $id,
        session: ($lines[0].sessionId // null),
        ended: $ended,
        brief: ($brief | .[0:4000]),
        started: $times[0],
        tier: $tiername,
        eta_min: $eta,
        actual_min: ((($ended | ts) - ($times[0] | ts)) / 60 | floor),
        tokens: ([$a | group_by(.requestId // .message.id)[] | .[-1].message.usage.output_tokens // 0] | add),
        peak_ctx: ($a[-1].message.usage | (.input_tokens // 0) + (.cache_read_input_tokens // 0) + (.cache_creation_input_tokens // 0)),
        outcome: (if ($head | test("HANDOFF")) then "handoff"
                  elif ($head | test("^\\W*(not|partly|mostly|half) done"; "i")) then "not done"
                  elif ($head | test("^\\W*blocked"; "i")) then "escalated"
                  elif ($head | test("^\\W*done\\b"; "i")) then "done"
                  else "unclear" end),
        note: ([$report | scan("(?:~|/home/[^/\\s]+)/[^\\s`]*handoffs?/[^\\s`]+?\\.md")] | first),
        report: ($head | gsub("\\s+"; " ") | .[0:160])
      } end
  ' <"$f" 2>/dev/null)
  [ -n "$row" ] || continue
  rows+=$row$'\n'
done < <(
  if [ -n "$session" ]; then
    find "$projects" -mindepth 4 -maxdepth 4 -path "*/$session/subagents/agent-*.jsonl" 2>/dev/null
  else
    find "$projects" -mindepth 4 -maxdepth 4 -path '*/subagents/agent-*.jsonl' -newermt "${since:-1 day ago}" 2>/dev/null
  fi | sort
)
printf '%s' "$rows" | "$threads" ingest
