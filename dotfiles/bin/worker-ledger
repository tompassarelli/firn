#!/usr/bin/env bash
# worker-ledger: a running Claude Code or Codex worker holds its brief's issue in
# threads; a finished one releases it and is recorded as a run
# (issue ref, follows and category from its brief; tier, ETA vs actual
# minutes, output tokens, peak context, outcome, handoff note path), and a
# category x tier summary of runs.
set -uo pipefail

usage() {
  cat >&2 <<'EOF'
usage: worker-ledger [--session ID] [--since DATE]   record finished workers as runs in threads
       worker-ledger --summary [--since DATE]        per category x tier: runs against ETA, and issues closed
  --session ID  only that session's workers (default: every provider, active in the last day)
  --since DATE  only workers active on or after DATE (e.g. 2026-10-08)
A running worker whose brief names `Item:` holds that issue until it finishes.
Codex workers repeat their brief fields in commentary when the runtime encrypts prompts.
Briefs carry `Item: <repo#N>`, `Follows: <agent id>` and `Category: <name>` lines.
Runs live in threads' database (${THREADS_DB:-~/.local/state/threads/threads.db}).
EOF
  exit 2
}

session="" since="" summary=0
while [ $# -gt 0 ]; do
  case "$1" in
    --session) [ $# -ge 2 ] || usage; session=$2; shift 2 ;;
    --since) [ $# -ge 2 ] || usage; since=$2; shift 2 ;;
    --summary) summary=1; shift ;;
    -h|--help) usage ;;
    *) usage ;;
  esac
done

threads="$(dirname "$(readlink -f "$0")")/threads"

if [ "$summary" -eq 1 ]; then
  exec "$threads" summary ${since:+--since "$since"}
fi

projects="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"
known=$("$threads" run-ids) || exit 1
rows=""

while IFS= read -r f; do
  id=$(basename "$f" .jsonl)
  id=${id#agent-}
  grep -qxF "$id" <<<"$known" && continue
  tier=$(jq -r '.agentType // empty' "${f%.jsonl}.meta.json" 2>/dev/null)
  row=$(jq -cRn --arg id "$id" --arg tier "$tier" --arg since "$since" '
    def texts: [(.message.content | if type == "array" then .[] | select(.type == "text") | .text else tostring end)] | join("\n");
    def ts: sub("\\.[0-9]+Z$"; "Z") | fromdate;
    [inputs | fromjson? | select(type == "object")] as $lines
    | [$lines[] | select(.type == "assistant" and .message.usage != null)] as $a
    | select(($a | length) > 0)
    | (if $tier != "" then $tier else ($a[-1].attributionAgent // "") end) as $agent
    | select($agent | startswith("worker"))
    | [$lines[] | select(.type == "user" or .type == "assistant")] as $m
    | ($m[-1]) as $last
    | ($last.type == "assistant" and ($last.message.content | type) == "array"
        and ([$last.message.content[].type] | index("tool_use") | not)
        and ($last | texts | length) > 0
        and (($last | texts | length) > 200 or ($last | texts | test("^\\W*(waiting|i.ll wait|i.ll pick|the test run)"; "i") | not))) as $finished
    | ([$lines[] | select(.type == "user")][0] | texts) as $brief
    | ([$a[] | select(.message.content | type == "array" and any(.[]; .type == "text")) | texts] | .[-3:] | max_by(length)) as $report
    | ($report | .[0:400]) as $head
    | ($lines | map(.timestamp // empty)) as $times
    | ($times | last) as $ended
    | select($ended >= $since)
    | (if ($a[-1].message.model // "" | test("haiku")) then "haiku"
       else ($agent | ltrimstr("worker") | ltrimstr("-")) | if . == "" then "medium" else . end end) as $tiername
    | ($brief | [scan("(?i)\\bETA\\b[^0-9\\n]{0,12}([0-9]+(?:\\.[0-9]+)?)\\s*(hours?|hrs?|h|minutes?|mins?|m)\\b")] | first
       | if . == null then null else (.[0] | tonumber) * (if (.[1] | test("^h")) then 60 else 1 end) end) as $eta
    | if ($finished | not) then
        {id: $id, session: ($lines[0].sessionId // null), brief: ($brief | .[0:4000]), started: $times[0],
         tier: $tiername, eta_min: $eta,
         status: (if (now - ($ended | ts)) < 7200 then "running" else "stale" end)}
      else {
        status: "finished",
        id: $id,
        session: ($lines[0].sessionId // null),
        ended: $ended,
        brief: ($brief | .[0:4000]),
        started: $times[0],
        tier: $tiername,
        eta_min: $eta,
        actual_min: ((($ended | ts) - ($times[0] | ts)) / 60 | floor),
        tokens: ([$a | group_by(.requestId // .message.id)[] | .[-1].message.usage.output_tokens // 0] | add),
        peak_ctx: ($a[-1].message.usage | (.input_tokens // 0) + (.cache_read_input_tokens // 0) + (.cache_creation_input_tokens // 0)),
        outcome: (if ($head | test("HANDOFF")) then "handoff"
                  elif ($head | test("^\\W*(not|partly|mostly|half) done"; "i")) then "not done"
                  elif ($head | test("^\\W*blocked"; "i")) then "escalated"
                  elif ($head | test("^\\W*done\\b"; "i")) then "done"
                  else "unclear" end),
        note: ([$report | scan("(?:~|/home/[^/\\s]+)/[^\\s`]*handoffs?/[^\\s`]+?\\.md")] | first),
        report: ($head | gsub("\\s+"; " ") | .[0:160])
      } end
  ' <"$f" 2>/dev/null)
  [ -n "$row" ] || continue
  rows+=$row$'\n'
done < <(
  if [ -n "$session" ]; then
    find "$projects" -mindepth 4 -maxdepth 4 -path "*/$session/subagents/agent-*.jsonl" 2>/dev/null
  else
    find "$projects" -mindepth 4 -maxdepth 4 -path '*/subagents/agent-*.jsonl' -newermt "${since:-1 day ago}" 2>/dev/null
  fi | sort
)
printf '%s' "$rows" | "$threads" ingest

# Join plaintext spawn briefs by parent thread and task path. Encrypted
# prompts require the worker to repeat its brief fields in commentary.
python3 - "$session" "$since" "$known" <<'PY' | "$threads" ingest
import json, os, re, sqlite3, sys, time
from datetime import datetime, timezone
from pathlib import Path

session, since, known = sys.argv[1:]
known = set(known.splitlines())
root = Path(os.environ.get("CODEX_CONFIG_DIR", os.path.expanduser("~/code/north-data/codex-pooled")))
cutoff = datetime.fromisoformat(since.replace("Z", "+00:00")).replace(tzinfo=timezone.utc).timestamp() if since else time.time() - 86400

def records(path):
    try:
        with open(path) as f:
            for line in f:
                try:
                    yield json.loads(line)
                except json.JSONDecodeError:
                    continue
    except OSError:
        return

def stamp(s):
    return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()

def texts(p):
    c = p.get("content", [])
    return c if isinstance(c, str) else "\n".join(v.get("text", "") for v in c if isinstance(v, dict))

paths = {}
state = root / "sqlite/state_5.sqlite"
if state.exists():
    db = sqlite3.connect(f"file:{state}?mode=ro", uri=True)
    paths = dict(db.execute("SELECT id, rollout_path FROM threads"))
    candidates = [p for (p,) in db.execute("SELECT rollout_path FROM threads WHERE updated_at >= ?", (cutoff,))]
    db.close()
else:
    candidates = [p for p in (root / "sessions").glob("*/*/*/rollout-*.jsonl") if p.stat().st_mtime >= cutoff]
    for path in candidates:
        for r in records(path):
            if r.get("type") == "session_meta":
                paths[r["payload"]["id"]] = str(path)
                break

parent_briefs = {}
def briefs(parent):
    if parent in parent_briefs:
        return parent_briefs[parent]
    calls, out = {}, {}
    for r in records(paths.get(parent, "")):
        p = r.get("payload", {})
        if p.get("type") == "function_call" and p.get("name", "").endswith("spawn_agent"):
            try:
                calls[p["call_id"]] = json.loads(p["arguments"])
            except (KeyError, json.JSONDecodeError):
                continue
        if p.get("type") == "function_call_output" and p.get("call_id") in calls:
            try:
                name = json.loads(p["output"])["task_name"]
                out[name] = calls[p["call_id"]]
            except (KeyError, TypeError, json.JSONDecodeError):
                continue
    parent_briefs[parent] = out
    return out

for path in candidates:
    meta, model, effort, brief, report = None, None, None, "", ""
    ended, final, tokens, peak = None, False, 0, 0
    for r in records(path):
        p, kind = r.get("payload", {}), r.get("type")
        if kind == "session_meta" and meta is None:
            meta = p
            source = p.get("source", {})
            spawn = source.get("subagent", {}).get("thread_spawn", {}) if isinstance(source, dict) else {}
            parent = spawn.get("parent_thread_id") or p.get("parent_thread_id")
            if not parent or p.get("id") in known or (session and parent != session and p.get("id") != session):
                break
            assignment = briefs(parent).get(spawn.get("agent_path") or p.get("agent_path"), {})
            brief = assignment.get("message", "")
            model, effort = assignment.get("model"), assignment.get("reasoning_effort")
        if meta is None or not parent or r.get("timestamp", "") < meta["timestamp"]:
            continue
        ended = r.get("timestamp") or ended
        if kind == "turn_context":
            model, effort = p.get("model") or model, p.get("effort") or effort
        elif kind == "response_item":
            if p.get("type") == "message" and p.get("role") == "user":
                t = texts(p)
                if re.search(r"\bItem:\s*(?:[\w-]+/)?[\w-]+#\d+", t):
                    brief = t
                final = False
            elif p.get("type") == "message" and p.get("role") == "assistant":
                t = texts(p)
                if re.search(r"\bItem:\s*(?:[\w-]+/)?[\w-]+#\d+", t):
                    brief = t
                final = p.get("phase") == "final"
                if final:
                    report = texts(p)
            elif p.get("type") in ("function_call", "custom_tool_call"):
                final = False
        elif kind == "event_msg":
            if p.get("type") in ("task_started", "user_message"):
                final = False
            elif p.get("type") == "task_complete":
                final = True
                report = p.get("last_agent_message") or report
            elif p.get("type") == "token_count" and p.get("info"):
                info = p["info"]
                tokens = info.get("total_token_usage", {}).get("output_tokens", tokens)
                peak = max(peak, info.get("last_token_usage", {}).get("input_tokens", 0))
    if not meta or not parent or meta["id"] in known or not ended or stamp(ended) < cutoff or not model or not effort:
        continue
    if session and parent != session and meta["id"] != session:
        continue
    if not re.search(r"\bItem:\s*(?:[\w-]+/)?[\w-]+#\d+", brief):
        continue
    eta = re.search(r"(?i)\bETA\b[^0-9\n]{0,12}([0-9]+(?:\.[0-9]+)?)\s*(hours?|hrs?|h|minutes?|mins?|m)\b", brief)
    eta = float(eta[1]) * (60 if eta[2].lower().startswith("h") else 1) if eta else None
    fields = re.findall(r"\b(?:Item|Follows|Category):[^\n]+", brief)
    head = report[:400]
    outcome = "handoff" if "HANDOFF" in head else "not done" if re.match(r"\W*(not|partly|mostly|half) done", head, re.I) else "escalated" if re.match(r"\W*blocked", head, re.I) else "done" if re.match(r"\W*done\b", head, re.I) else "unclear"
    note = re.search(r"(?:~|/home/[^/\s]+)/[^\s`]*handoffs?/[^\s`]+?\.md", report)
    row = dict(id=meta["id"], session=parent, brief="\n".join(fields), started=meta["timestamp"],
               ended=ended, tier=f"{model} {effort}", eta_min=eta,
               status="finished" if final else "running" if time.time() - stamp(ended) < 7200 else "stale",
               actual_min=max(0, int((stamp(ended) - stamp(meta["timestamp"])) / 60)),
               tokens=tokens, peak_ctx=peak, outcome=outcome, note=note[0] if note else None,
               report=re.sub(r"\s+", " ", head)[:160])
    print(json.dumps(row))
PY
