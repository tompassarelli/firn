#!/usr/bin/env bash
# Resolve one provider session UUID to the config home that owns its native
# transcript. This is deliberately read-only: callers activate the returned
# home process-locally rather than changing any global account selection.
set -uo pipefail

usage() {
  echo "usage: north-session-resolve <anthropic|openai> <session-uuid>" >&2
  exit 64
}

[ "$#" -eq 2 ] || usage
provider="$1"
session_id="${2,,}"
uuid_re='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
[[ "$session_id" =~ $uuid_re ]] || usage

case "$provider" in
  anthropic)
    provider_word="claude"
    account_base="$HOME/.local/state/north/accounts/anthropic"
    ambient_home="$HOME/.claude"
    ;;
  openai)
    provider_word="codex"
    account_base="$HOME/.local/state/north/accounts/openai"
    ambient_home="$HOME/.codex"
    ;;
  *)
    usage
    ;;
esac

declare -a match_kinds=()
declare -a match_names=()
declare -a match_homes=()
declare -A seen_homes=()

canonical_home() {
  realpath -e -- "$1" 2>/dev/null || realpath -m -- "$1"
}

home_has_claude_session() {
  local home="$1" candidate
  [ -d "$home/projects" ] || return 1
  while IFS= read -r candidate; do
    [ -n "$candidate" ] || continue
    if LC_ALL=C grep -m 1 -Eq \
       '"sessionId"[[:space:]]*:[[:space:]]*"'"$session_id"'"' "$candidate"; then
      return 0
    fi
  done < <(find "$home/projects" -mindepth 2 -maxdepth 2 \
    -type f -name "$session_id.jsonl" -print 2>/dev/null)
  return 1
}

home_has_codex_session() {
  local home="$1" candidate first
  [ -d "$home/sessions" ] || return 1
  while IFS= read -r candidate; do
    [ -n "$candidate" ] || continue
    first="$(head -n 1 -- "$candidate" 2>/dev/null)" || continue
    if printf '%s\n' "$first" |
       LC_ALL=C grep -Eq '"type"[[:space:]]*:[[:space:]]*"session_meta".*"id"[[:space:]]*:[[:space:]]*"'"$session_id"'"'; then
      return 0
    fi
  done < <(find "$home/sessions" -mindepth 4 -maxdepth 4 \
    -type f -name "rollout-*-$session_id.jsonl" -print 2>/dev/null)
  return 1
}

home_has_session() {
  case "$provider" in
    anthropic) home_has_claude_session "$1" ;;
    openai) home_has_codex_session "$1" ;;
  esac
}

add_home_if_match() {
  local kind="$1" name="$2" home="$3" canonical
  [ -d "$home" ] || return 0
  home_has_session "$home" || return 0
  canonical="$(canonical_home "$home")"
  [ -n "$canonical" ] || return 0
  [ -z "${seen_homes[$canonical]+x}" ] || return 0
  seen_homes["$canonical"]=1
  match_kinds+=("$kind")
  match_names+=("$name")
  match_homes+=("$canonical")
}

add_home_if_match ambient ambient "$ambient_home"

if [ -d "$account_base" ]; then
  shopt -s nullglob
  for account_home in "$account_base"/*; do
    [ -d "$account_home" ] || continue
    add_home_if_match account "${account_home##*/}" "$account_home"
  done
  shopt -u nullglob
fi

# Stock profiles are real, independently authenticated provider homes. Include
# them in lookup so a UUID remains resumable even when it was created through
# claude-stock/codex-stock rather than an isolated subscription account.
profiles_base="$HOME/.local/state/north/profiles"
if [ -d "$profiles_base" ]; then
  shopt -s nullglob
  for profile_home in "$profiles_base"/*; do
    [ -d "$profile_home" ] || continue
    add_home_if_match profile "${profile_home##*/}" "$profile_home"
  done
  shopt -u nullglob
fi

if [ "${#match_homes[@]}" -eq 0 ]; then
  echo "$provider_word: session $session_id was not found in any ambient, account, or profile home" >&2
  exit 1
fi

if [ "${#match_homes[@]}" -gt 1 ]; then
  echo "$provider_word: session $session_id exists under multiple authorities; choose one explicitly:" >&2
  for index in "${!match_homes[@]}"; do
    printf '  %s:%s  %s\n' \
      "${match_kinds[$index]}" "${match_names[$index]}" "${match_homes[$index]}" >&2
  done
  exit 2
fi

printf 'v1\t%s\t%s\t%s\t%s\t%s\n' \
  "$provider" "${match_kinds[0]}" "${match_names[0]}" \
  "${match_homes[0]}" "$session_id"
