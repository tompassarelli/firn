#!/usr/bin/env bb

(require '[cheshire.core :as json]
         '[clojure.edn :as edn]
         '[clojure.java.io :as io]
         '[clojure.string :as str])
(import '[java.lang ProcessHandle]
        '[java.io FileOutputStream RandomAccessFile]
        '[java.nio.channels FileChannel]
        '[java.nio.file CopyOption Files LinkOption Path StandardCopyOption StandardOpenOption])

(def allowed-keys #{:tx :op :l :p :r :frame :ts})

(defn fail! [message]
  (binding [*out* *err*] (println (str "wm-world-migrate-jsonl: " message)))
  (System/exit 1))

(defn record-valid? [record]
  (and (map? record)
       (every? allowed-keys (keys record))
       (integer? (:tx record))
       (pos? (:tx record))
       (#{"assert" "retract"} (:op record))
       (string? (:l record))
       (string? (:frame record))
       (string? (:ts record))
       (case (:op record)
         "assert" (and (string? (:p record))
                        (or (string? (:r record)) (integer? (:r record))))
         "retract" (and (or (nil? (:p record)) (string? (:p record)))
                        (nil? (:r record)))
         false)))

(defn read-records [input]
  (with-open [reader (io/reader input)]
    (->> (line-seq reader)
         (map-indexed vector)
         (keep (fn [[index line]]
                 (when-not (str/blank? line)
                   (let [record
                         (try (edn/read-string line)
                              (catch Exception error
                                (fail! (str input ":" (inc index)
                                            ": invalid EDN: " (.getMessage error)))))]
                     (when-not (record-valid? record)
                       (fail! (str input ":" (inc index)
                                   ": invalid wm-world record")))
                     record))))
         vec)))

(defn write-forced! [path text]
  (with-open [stream (FileOutputStream. (str path))]
    (.write stream (.getBytes text "UTF-8"))
    (.force (.getChannel stream) true)))

(defn force-file! [path]
  (with-open [file (RandomAccessFile. (str path) "rw")]
    (.force (.getChannel file) true)))

(defn force-directory! [directory]
  (with-open [channel (FileChannel/open (.toPath (io/file directory))
                         (into-array StandardOpenOption
                           [StandardOpenOption/READ]))]
    (.force channel true)))

(defn atomic-move! [source target]
  (Files/move (.toPath (io/file source)) (.toPath (io/file target))
    (into-array CopyOption [StandardCopyOption/ATOMIC_MOVE])))

(defn migrate-one! [{:keys [input output rollback records]}]
  (let [directory (.getParentFile (io/file input))
        token (str (ProcessHandle/current) "." (java.util.UUID/randomUUID))
        rollback-temp (io/file directory (str "." (.getName (io/file rollback)) "." token))
        output-temp (io/file directory (str "." (.getName (io/file output)) "." token))]
    (try
      (Files/copy (.toPath (io/file input)) (.toPath rollback-temp)
        (make-array CopyOption 0))
      (force-file! rollback-temp)
      (when-not (= -1 (Files/mismatch (.toPath (io/file input))
                         (.toPath rollback-temp)))
        (fail! (str input ": rollback copy verification failed")))
      (atomic-move! rollback-temp rollback)
      (write-forced! output-temp
        (apply str (map #(str (json/generate-string %) "\n") records)))
      (atomic-move! output-temp output)
      (force-directory! directory)
      (println (str "migrated " input " -> " output
                    " (rollback: " rollback ")"))
      (catch Exception error
        (fail! (str input ": migration failed: " (.getMessage error))))
      (finally
        (Files/deleteIfExists (.toPath rollback-temp))
        (Files/deleteIfExists (.toPath output-temp))))))

(defn state-directory []
  (or (first *command-line-args*)
      (System/getenv "WM_WORLD_STATE_DIR")
      (when-let [xdg (System/getenv "XDG_STATE_HOME")]
        (str xdg "/wm-world"))
      (when-let [home (System/getenv "HOME")]
        (str home "/.local/state/wm-world"))
      (fail! "state directory, XDG_STATE_HOME, and HOME are not set")))

(let [directory (io/file (state-directory))
      specs (for [name ["facts" "marks"]
                  :let [input (io/file directory (str name ".log"))]
                  :when (.exists input)]
              {:input input
               :output (io/file directory (str name ".jsonl"))
               :rollback (io/file directory (str name ".edn.rollback"))})]
  (doseq [{:keys [input output rollback]} specs]
    (when-not (.isFile input) (fail! (str input ": not a regular file")))
    (when (.exists output) (fail! (str output ": target already exists")))
    (when (.exists rollback) (fail! (str rollback ": rollback already exists"))))
  (let [validated (mapv #(assoc % :records (read-records (:input %))) specs)]
    (doseq [spec validated] (migrate-one! spec))
    (when (empty? validated)
      (println (str "no legacy wm-world files under " directory)))))
