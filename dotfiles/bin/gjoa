#!/usr/bin/env bash
# gjoa launcher + dev CLI
set -u

container="$HOME/code/gjoa"
root="$container/worktrees/dev-runtime"
nix_bin="$container/result/bin/gjoa"
mach_bin="$root/engine/obj-x86_64-pc-linux-gnu/dist/bin/gjoa"

# ── auto-sync: keep the mach (dev) binary's loose chrome + toolkit overlays
# current without ceremony. `gjoa sync` bundles chrome AND mirrors the loose
# toolkit overlays (dark-mode actor + fixes) into engine/ (chrome-bundle/
# install.bjs). A stamp tracks the last sync; if anything under src/gjoa/
# changed since, re-sync before launch. Fresh = an instant find(1) check, no
# sync. This is why "youtube went light again" kept recurring: the dark-mode
# files only synced on a heavy `gjoa import`, never on a normal launch.
sync_stamp="$root/.gjoa-sync-stamp"
sync_dev() {
  direnv exec "$root" sh -c 'cd "$1" && bun run chrome:dist && bun run chrome:install' _ "$root"
}
sync_if_stale() {
  if [ ! -f "$sync_stamp" ] || \
     [ -n "$(find "$root/src/gjoa" -type f -newer "$sync_stamp" -print -quit 2>/dev/null)" ]; then
    echo "gjoa: src changed since last sync — syncing chrome + dark-mode…" >&2
    if sync_dev; then
      touch "$sync_stamp"
    else
      echo "gjoa: sync FAILED — launching with the last-synced build" >&2
    fi
  fi
}

if [ ! -d "$root" ]; then
  echo "gjoa: $root not found" >&2
  exit 1
fi

case "${1:-}" in
  # ── launch nix (release): bare = detached, -f = foreground ──────────────
  ""|-f)
    if [ ! -x "$nix_bin" ]; then
      echo "gjoa: no nix build at $nix_bin" >&2
      echo "    build it:  nix build .#gjoa --impure" >&2
      exit 1
    fi
    if [ "${1:-}" = "-f" ]; then
      shift
      exec "$nix_bin" "$@"
    else
      setsid -f "$nix_bin" </dev/null >/dev/null 2>&1
      exit 0
    fi
    ;;

  # ── launch mach (hotreload): bare = detached, -f = foreground ───────────
  hotreload)
    if [ ! -x "$mach_bin" ]; then
      echo "gjoa hotreload: no mach build at $mach_bin" >&2
      echo "    build it:  gjoa import && gjoa build  (full, 30-60 min cold)" >&2
      echo "    after that, daily rebuilds:  gjoa build faster  (~30 sec, omni.ja re-zip)" >&2
      exit 1
    fi
    sync_if_stale
    # Borrow the nix wrapper's runtime library paths (audio, GL, GTK, etc).
    # The mach binary is unwrapped so NixOS can't find these otherwise.
    nix_libs=""
    if [ -r "$nix_bin" ]; then
      nix_libs=$(
        {
          grep -oP "'/nix/store/[^']*'" "$nix_bin" | tr -d "'"
          if command -v nix-store >/dev/null 2>&1 && [ -e "$container/result" ]; then
            nix-store --query --requisites "$(readlink -f "$container/result")" 2>/dev/null |
              while IFS= read -r store_path; do
                if [ -d "$store_path/lib" ]; then
                  printf '%s\n' "$store_path/lib"
                fi
              done
          fi
        } | awk 'NF && !seen[$0]++' | paste -sd: -
      )
    fi
    if [ -n "$nix_libs" ]; then
      export LD_LIBRARY_PATH="$nix_libs${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    else
      # Hardware WebRender needs BOTH the glvnd loader (modules/bash ships
      # libglvnd into ~/.nix-profile/lib) and vendor mesa in /run/opengl-driver/lib.
      echo "gjoa hotreload: nix result missing — using system GL fallback" >&2
      if [ ! -r "$HOME/.nix-profile/lib/libEGL.so.1" ]; then
        echo "gjoa hotreload: libEGL.so.1 not in ~/.nix-profile/lib — expect SOFTWARE rendering until the next rebuild lands libglvnd" >&2
      fi
      export LD_LIBRARY_PATH="$HOME/.nix-profile/lib:/run/opengl-driver/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    fi
    # Dev mode = load edited chrome from <install_root>/gjoa-dev/ (the symlink to
    # dist/chrome that `gjoa sync` / chrome:ensure maintains). GjoaLoader's F4
    # gate only sources it when GJOA_DEV_LOADER=1; without this, `gjoa hotreload`
    # runs the STALE chrome baked into omni.ja and every chrome edit is invisible.
    export GJOA_DEV_LOADER=1
    # ── FRESH-INSTANCE GUARANTEE ──────────────────────────────────────────
    # Without this, running `gjoa hotreload` while a gjoa window is already open
    # just REMOTES a new tab into the running (stale-chrome) instance — your synced
    # edits look invisible and the build seems broken. Kill any running DEV
    # instance by executable identity, so symlinked launch paths still match but
    # the separate nix daily browser remains untouched.
    mach_exe="$(readlink -f "$mach_bin")"
    dev_pids() {
      local proc pid exe
      for proc in /proc/[0-9]*; do
        pid="${proc#/proc/}"
        exe="$(readlink -f "$proc/exe" 2>/dev/null)" || continue
        if [ "$exe" = "$mach_exe" ]; then
          printf '%s\n' "$pid"
        fi
      done
    }
    running_dev_pids="$(dev_pids)"
    stopped_dev=0
    if [ -n "$running_dev_pids" ]; then
      while IFS= read -r pid; do
        if kill "$pid" 2>/dev/null; then
          stopped_dev=1
        fi
      done <<<"$running_dev_pids"
    fi
    if (( stopped_dev )); then
      echo "gjoa hotreload: stopped the running dev instance — relaunching fresh" >&2
      # AWAIT the old instance (parent + all content procs) to actually EXIT before
      # relaunching — a fixed `sleep 1` was a smell: under load (e.g. a concurrent
      # build) the content procs take >1s to reap, so the profile lock is still held
      # and the -no-remote relaunch fails SILENTLY ("profile already in use") → the
      # window never appears ("Gjoa Dev doesn't load"). Poll up to ~10s, then a
      # small buffer for the .parentlock file to clear after the last proc dies.
      for _ in $(seq 1 50); do
        [ -n "$(dev_pids)" ] || break
        sleep 0.2
      done
      sleep 0.3
    fi
    echo "gjoa hotreload: launching FRESH (chrome synced, new instance)" >&2
    if [ "${2:-}" = "-f" ]; then
      shift 2
      exec "$mach_bin" -no-remote "$@"
    else
      setsid -f "$mach_bin" -no-remote </dev/null >/dev/null 2>&1
      exit 0
    fi
    ;;

  # ── help ────────────────────────────────────────────────────────────────
  -h|--help|help)
    cat <<EOF
gjoa — launcher + dev CLI

Launch:
  gjoa                     nix build, detached (closes terminal)
  gjoa -f                  nix build, foreground (shows logs)
  gjoa hotreload           mach build, detached (auto-syncs if src changed)
  gjoa hotreload -f        mach build, foreground (auto-syncs if src changed)

Status:
  gjoa status              operational dashboard (versions, CVEs, budget)

Dev loop:
  gjoa import              sync src/gjoa/ → engine/ (run before mach build)
  gjoa build [faster|…]    mach build in engine/
  gjoa sync                bundle chrome + mirror dark-mode overlays into engine
  gjoa watch               auto-rebundle chrome TS on save

Tests:
  gjoa test [path|…]       bun unit tests
  gjoa test:integration    Marionette tests against mach binary
  gjoa test:integration:nix   same suite against result/bin/gjoa (nix)

Misc:
  gjoa icons               regenerate icons from assets/gjoa.svg
  gjoa clean               mach clobber (wipe objdir)
EOF
    ;;

  # ── operational dashboard ───────────────────────────────────────────────
  # Fresh pulls every call: version delta vs Mozilla/nixpkgs/Zen/LibreWolf,
  # CVE count against your pin, build state, weekly rebuild budget, what
  # command to run next. ~1-2 sec. No caching.
  status) shift; direnv exec "$root" env -C "$root" bun run status -- "$@" ;;

  # ── preflight gate (mandatory before any nix/full-mach build) ───────────
  # Runs every gate mechanically and exits non-zero if any fails.
  preflight) shift; direnv exec "$root" env -C "$root" bun run preflight -- "$@" ;;

  # ── dev-loop verbs ──────────────────────────────────────────────────────
  build) shift; direnv exec "$root" env -C "$root/engine" ./mach build "$@" ;;
  import) direnv exec "$root" env -C "$root" bun run import ;;
  sync) sync_dev && touch "$sync_stamp" ;;
  watch) direnv exec "$root" env -C "$root" bun run chrome:watch ;;

  # ── tests + misc ────────────────────────────────────────────────────────
  test) shift; direnv exec "$root" env -C "$root" bun test "$@" ;;
  test:integration) direnv exec "$root" env -C "$root" bun run test:integration ;;
  test:integration:nix) direnv exec "$root" env -C "$root" bun run test:integration:nix ;;
  icons) direnv exec "$root" env -C "$root" bun run icons ;;
  clean) direnv exec "$root" env -C "$root/engine" ./mach clobber ;;

  *)
    echo "gjoa: unknown subcommand '$1'" >&2
    exit 1
    ;;
esac
