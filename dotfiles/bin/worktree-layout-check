#!/usr/bin/env bash
# Every git worktree under ~/code lives at ~/code/<project>/worktrees/<slug>,
# except an immutable externally-consumed pin at
# ~/code/<project>/pins/<full-object-id>. Nothing else.
# The directory IS the lifecycle policy: worktrees/ is what the sweepers may
# delete, pins/ is what they must never see.
#
# WHY THIS IS A CHECK AND NOT A DOC
#   The layout was written down and re-stated repeatedly, and on 2026-07-29 a
#   sweep found 63 worktrees spread across FOUR conventions at once:
#     ~/code/worktrees/<project>/<slug>     (the previous documented layout)
#     ~/code/<project>-<slug>               (siblings of the checkout)
#     ~/code/north-data/worktrees/<slug>    (inside the runtime DATA directory)
#     /tmp/...                              (scratch that outlived its session)
#   plus seven full clones of north sitting at ~/code root, and orphaned trees
#   whose gitdir no longer existed. A rule with no detector is a rule that
#   silently stops being true.
#
# WHAT IS DELIBERATELY EXEMPT
#   - the project's own checkout (~/code/<project>/main)
#   - pins (~/code/<project>/pins/<full-object-id>) — detached at exactly the commit
#     named by the leaf, accompanied by a nonempty same-name `.pin` sidecar;
#     reported as pins, never strays
#   - tool-owned runtimes: ~/code/north-data/store-runtime/deployments/<rev>,
#     created and owned by `north-coord-runtime promote`. Moving one breaks the
#     running coordinator.
#   - third-party submodules under ~/code/resources (read-only context)
#   - experiment fixtures generated by a harness under */experiments/*
#
# EXIT 0 clean, 1 when any worktree is out of format.
set -uo pipefail

CODE="${CODE_ROOT:-$HOME/code}"
strays=0
checked=0
pins=0

exempt() {
  case "$1" in
    */store-runtime/deployments/*) return 0 ;;
    "$CODE"/resources/*)          return 0 ;;
    */experiments/*)              return 0 ;;
    *) return 1 ;;
  esac
}

repos_found=0
for repo_dir in "$CODE"/*/; do
  container="${repo_dir%/}"
  repo="$(basename "$container")"
  # The checkout is <container>/main. One shape only: accepting a second one
  # here is the compatibility machinery that lets drift read as clean.
  if [ -d "$container/main/.git" ]; then checkout="$container/main"
  else continue
  fi
  repos_found=$((repos_found + 1))
  while IFS= read -r wt; do
    [ -n "$wt" ] || continue
    checked=$((checked + 1))
    [ "$wt" = "$checkout" ] && continue               # the checkout itself
    case "$wt" in "$container"/worktrees/*) continue ;; esac
    # A pin is legal but is NOT a lane. Its full object ID is its immutable
    # address, HEAD must equal that address and be detached, and the same-name
    # sidecar must identify at least one consumer.
    case "$wt" in
      "$container"/pins/*)
        pin_leaf="${wt#"$container"/pins/}"
        pin_problem=""
        case "$pin_leaf" in
          */*) pin_problem="pin must be directly under pins/" ;;
        esac
        if ! pin_head="$(git -C "$wt" rev-parse HEAD 2>/dev/null)"; then
          pin_problem="checkout HEAD is unreadable"
        elif [ "$pin_head" != "$pin_leaf" ]; then
          pin_problem="leaf is not the checkout's full object ID (HEAD is $pin_head)"
        elif git -C "$wt" symbolic-ref -q HEAD >/dev/null 2>&1; then
          pin_problem="HEAD is attached to a branch"
        elif [ ! -f "$container/pins/$pin_leaf.pin" ]; then
          pin_problem="same-name consumer sidecar is missing"
        elif ! grep -q '[^[:space:]]' "$container/pins/$pin_leaf.pin" 2>/dev/null; then
          pin_problem="same-name consumer sidecar is empty"
        fi
        if [ -n "$pin_problem" ]; then
          printf 'INVALID %-14s %s — %s\n' "$repo" "${wt/#$HOME/\~}" "$pin_problem"
          strays=$((strays + 1))
          continue
        fi
        printf 'PIN    %-14s %s\n' "$repo" "${wt/#$HOME/\~}"
        pins=$((pins + 1))
        continue
        ;;
    esac
    exempt "$wt" && continue
    printf 'STRAY  %-14s %s\n' "$repo" "${wt/#$HOME/\~}"
    strays=$((strays + 1))
  done < <(git -C "$checkout" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}')
done

# Finding almost nothing means the discovery is broken, not that the tree is
# clean. Refuse to report OK in that case.
if [ "$repos_found" -lt 5 ]; then
  echo "worktree-layout: FAILED — only $repos_found repositories discovered under $CODE;" >&2
  echo "  discovery is broken, not the tree. Refusing to report a clean result." >&2
  exit 1
fi

if [ "$strays" -eq 0 ]; then
  echo "worktree-layout: OK — $checked trees, all at ~/<project>/main, /worktrees/<slug>, or /pins/<full-object-id> ($pins pin(s))"
  exit 0
fi

cat >&2 <<EOF

worktree-layout: $strays worktree(s) out of format.

The layout is:
  ~/code/<project>/                  container only — never a checkout
  ~/code/<project>/main/             the clean checkout — read-only product
  ~/code/<project>/worktrees/<slug>/ ephemeral lanes — sweepable
  ~/code/<project>/pins/<full-object-id>/    immutable detached checkout
  ~/code/<project>/pins/<full-object-id>.pin nonempty consumer metadata sidecar

Move a lane with:
  git -C ~/code/<project>/main worktree move <old> ~/code/<project>/worktrees/<slug>

If it is on a different filesystem (rename(2) cannot cross devices, which is
why /tmp worktrees fail), copy and repair instead:
  cp -a <old> ~/code/<project>/worktrees/<slug>
  git -C ~/code/<project>/main worktree repair ~/code/<project>/worktrees/<slug>
  git -C ~/code/<project>/main worktree prune

Create a pin at its immutable content address:
  PIN_OBJECT_ID=FULL_GIT_OBJECT_ID
  git -C ~/code/<project>/main worktree add --detach \
    ~/code/<project>/pins/\$PIN_OBJECT_ID \$PIN_OBJECT_ID
  # write ~/code/<project>/pins/\$PIN_OBJECT_ID.pin, then update the consumer
EOF
exit 1
