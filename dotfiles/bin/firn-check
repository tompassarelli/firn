#!/usr/bin/env bash
set -euo pipefail

root="${FIRN_REPO:-$(git rev-parse --show-toplevel)}"
script="$(readlink -f "${BASH_SOURCE[0]}")"
cd "$root"

if ! command -v statix >/dev/null || ! command -v deadnix >/dev/null; then
  exec nix shell --inputs-from "path:$root" nixpkgs#statix nixpkgs#deadnix \
    --command env FIRN_REPO="$root" bash "$script"
fi

if command -v firn-tools >/dev/null; then
  printf 'firn check: units run only north subcommands and flags the installed runtime lists\n'
  firn-tools unit-flags --repo "$root"
else
  printf 'firn check: ⚠ firn-tools is not installed (run firn-runtime-update), so units were not checked against north --help.\n'
fi
printf 'firn check: every NixOS host derivation\n'
nix eval --json "path:$root#nixosConfigurations" \
  --apply 'hosts: builtins.mapAttrs (_: host: host.config.system.build.toplevel.drvPath) hosts'
printf 'firn check: flake evaluation and assertions\n'
nix flake check --no-build "path:$root"
printf '\nfirn check: statix %s\n' "$(basename "$(dirname "$(dirname "$(readlink -f "$(command -v statix)")")")")"
statix check .
printf 'firn check: deadnix\n'
deadnix --fail .
printf 'firn check: nixfmt\n'
nix fmt -- --ci
printf 'firn check: passed\n'
