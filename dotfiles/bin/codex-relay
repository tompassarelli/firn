#!/usr/bin/env bash
# codex-relay SESSION_ID WINDOW_ID < message
# Hands a commander message to a Codex root session. The behavior hook
# delivers the relay file after the session's next tool call; a session that
# runs no tools for a while never sees it, so after RELAY_WAIT seconds the
# message is typed into the session's terminal window instead and its goal
# resumed (Escape pauses a goal).
set -euo pipefail
session="${1:?usage: codex-relay SESSION_ID WINDOW_ID < message}"
window="${2:?usage: codex-relay SESSION_ID WINDOW_ID < message}"
wait_seconds="${RELAY_WAIT:-90}"
dir="${CODEX_BEHAVIOR_STATE:-${XDG_RUNTIME_DIR:-/tmp}/codex-behavior}"
file="$dir/relay-${session//[^A-Za-z0-9_.-]/_}.txt"
mkdir -p "$dir"
message="$(cat)"
[ -n "$message" ] || { echo "codex-relay: empty message" >&2; exit 2; }
printf '%s\n' "$message" >>"$file"
for _ in $(seq 1 "$wait_seconds"); do
  [ -e "$file" ] || { echo "delivered by hook"; exit 0; }
  sleep 1
done
pending="$(cat "$file")"
rm -f "$file"
wtype="$(command -v wtype || echo "$(nix build --no-link --print-out-paths nixpkgs#wtype)/bin/wtype")"
focused() { niri msg --json focused-window | jq -r '.id // empty'; }
previous="$(focused)"
niri msg action focus-window --id "$window"
sleep 1
if [ "$(focused)" != "$window" ]; then
  printf '%s\n' "$pending" >>"$file"
  echo "codex-relay: window $window not focusable; message left for the hook" >&2
  exit 1
fi
"$wtype" -k Escape
sleep 3
"$wtype" -- "$(printf '%s' "$pending" | tr '\n' ' ')"
sleep 1
"$wtype" -k Return
sleep 3
"$wtype" '/goal resume'
sleep 0.5
"$wtype" -k Return
if [ -n "$previous" ]; then niri msg action focus-window --id "$previous"; fi
echo "delivered by terminal"
