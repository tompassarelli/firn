#!/usr/bin/env bash
# firn-liveness-floor — narrow, non-switching proof that Firn can still deliver.
set -euo pipefail

repo="${FIRN_LIVENESS_REPO:-$HOME/code/nixos-config/main}" # hardcoded-repo-path:allow
host="${FIRN_LIVENESS_HOST:-whiterabbit}"
git_bin="${FIRN_LIVENESS_GIT:-git}"
nix_bin="${FIRN_LIVENESS_NIX:-nix}"
firn_bin="${FIRN_LIVENESS_CURRENT_FIRN:-/run/current-system/sw/bin/firn}"
agents_bin="${FIRN_LIVENESS_AGENTS:-$HOME/.local/bin/agents}"
flock_bin="${FIRN_LIVENESS_FLOCK:-flock}"
system="${FIRN_LIVENESS_SYSTEM:-x86_64-linux}"
state_dir="${FIRN_LIVENESS_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/firn}"
state_file="$state_dir/delivery-liveness.json"
freshness_seconds=3600
mkdir -p "$state_dir"
exec 9>"$state_file.lock"
if ! "$flock_bin" -n 9; then
  printf 'firn-liveness-floor: another floor check is already running\n' >&2
  exit 75
fi
observed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
revision=""
candidate_path=""
failing_check="bootstrap"

store_path_or_null() {
  local resolved=""
  resolved="$(readlink -f "$1" 2>/dev/null || true)"
  case "$resolved" in /nix/store/*) printf '%s\n' "$resolved" ;; esac
}

current_path="$(store_path_or_null "$firn_bin")"

write_fact() {
  local status=$? tmp digest_tmp
  trap - EXIT
  tmp="$state_file.tmp.$$"
  digest_tmp="$state_file.sha256.tmp.$$"
  LIVENESS_OBSERVED_AT="$observed_at" \
  LIVENESS_FRESHNESS_SECONDS="$freshness_seconds" \
  LIVENESS_BUILDABLE="$([[ "$status" == 0 ]] && printf true || printf false)" \
  LIVENESS_FAILING_CHECK="$([[ "$status" == 0 ]] && printf '' || printf "$failing_check")" \
  LIVENESS_REVISION="$revision" LIVENESS_CURRENT="$current_path" \
  LIVENESS_CANDIDATE="$candidate_path" \
    python3 - "$tmp" <<'PY'
import json, os, sys

def nullable(value):
    return value or None

payload = {
    "version": 1,
    "observed_at": os.environ["LIVENESS_OBSERVED_AT"],
    "freshness_seconds": int(os.environ["LIVENESS_FRESHNESS_SECONDS"]),
    "buildable": os.environ["LIVENESS_BUILDABLE"] == "true",
    "failing_check": nullable(os.environ["LIVENESS_FAILING_CHECK"]),
    "inputs": {"nixos_config": os.environ["LIVENESS_REVISION"]},
    "firn": {
        "current": nullable(os.environ["LIVENESS_CURRENT"]),
        "candidate": nullable(os.environ["LIVENESS_CANDIDATE"]),
    },
}
with open(sys.argv[1], "w") as fh:
    json.dump(payload, fh, sort_keys=True, separators=(",", ":"))
    fh.write("\n")
PY
  sha256sum "$tmp" | awk '{print $1 "  delivery-liveness.json"}' >"$digest_tmp"
  mv -f "$digest_tmp" "$state_file.sha256"
  mv -f "$tmp" "$state_file"
  exit "$status"
}
trap write_fact EXIT

fail() {
  printf 'firn-liveness-floor: %s\n' "$*" >&2
  exit 1
}

run() {
  printf 'firn-liveness-floor: %s\n' "$1" >&2
  shift
  "$@"
}

failing_check="repository"
[[ -d "$repo" ]] || fail "repository is absent: $repo"
revision="$("$git_bin" -C "$repo" rev-parse --verify HEAD^{commit})"
failing_check="current_firn"
[[ -x "$firn_bin" ]] || fail "current Firn is missing or non-executable: $firn_bin"
failing_check="agents"
[[ -x "$agents_bin" ]] || fail "agents command is missing or non-executable: $agents_bin"

failing_check="branch"
branch="$("$git_bin" -C "$repo" branch --show-current)"
[[ "$branch" == main ]] || fail "repository must be on main, found ${branch:-detached}"
failing_check="clean_worktree"
[[ -z "$("$git_bin" -C "$repo" status --porcelain --untracked-files=all)" ]] \
  || fail "repository is not clean"
source="git+file://$repo?rev=$revision&ref=main"

failing_check="hook_projection"
run "checking active hook targets and projections" "$agents_bin" check
failing_check="pin_ancestry"
run "checking direct first-party pin ancestry" \
  env FIRN_REPO="$repo" "$firn_bin" repo doctor

failing_check="current_firn_output"
current_output="$("$firn_bin" host list all)"
[[ -n "$current_output" ]] || fail "current Firn produced no host-list output"

failing_check="candidate_firn_build"
candidate_root="$(run "building candidate Firn" "$nix_bin" build --no-link --print-out-paths \
  "$source#packages.$system.firn-launchers")"
candidate_firn="$candidate_root/bin/firn"
candidate_path="$(store_path_or_null "$candidate_firn")"
failing_check="candidate_firn"
[[ -x "$candidate_firn" ]] || fail "candidate Firn is missing or non-executable: $candidate_firn"
failing_check="candidate_firn_output"
candidate_output="$("$candidate_firn" host list all)"
[[ -n "$candidate_output" ]] || fail "candidate Firn produced no host-list output"

failing_check="toplevel_build"
run "building committed $host toplevel" "$nix_bin" build --no-link --print-out-paths \
  "$source#nixosConfigurations.$host.config.system.build.toplevel"
printf 'firn-liveness-floor: OK %s\n' "$revision"
