#!/usr/bin/env bash
# cfg — the volatile-preference channel.
#
# A volatile preference file is one a human tunes LIVE (a compositor config, a
# theme knob). Projecting it into $HOME as a symlink back into the checkout
# makes every live tweak dirty the repo working tree, which collides with the
# clean-checkout invariant every guard and rebuild depends on. So: the live file
# is a MUTABLE copy the user owns, the repo holds the settled record, and moving
# between them is a deliberate verb.
#
# Adding a future volatile file = one CFG_REGISTRY row.
set -euo pipefail

# name|live path (relative to $HOME)|record path (relative to the repo root)
CFG_REGISTRY=(
  "niri|.config/niri/config.kdl|dotfiles/niri/config.kdl"
)

usage() {
  cat <<'USAGE'
Usage: cfg <verb> [name]

  status [name]        in-sync / drifted (with diffstat) per registered file
  diff <name>          record -> live unified diff
  promote <name>       live -> record, committed and landed on the repo's main
  reset <name> --yes   record -> live, overwriting local tweaks
  materialize [name]   seed/detach the live file; idempotent (activation verb)

Registry rows live at the top of this script.
USAGE
}

die() { printf 'cfg: %s\n' "$1" >&2; exit 1; }

# The repo root. CFG_REPO wins so activation and tests can point elsewhere;
# otherwise probe the container checkout before the legacy flat one. A row's
# record path is meaningless without this, so an unresolvable root is fatal.
resolve_repo() {
  local cand
  if [ -n "${CFG_REPO:-}" ]; then
    [ -d "$CFG_REPO/dotfiles" ] || die "CFG_REPO=$CFG_REPO has no dotfiles/"
    printf '%s\n' "$CFG_REPO"
    return 0
  fi
  # The record lives in a checkout, so this tool cannot be topology-free;
  # CFG_REPO is the override for anyone laid out differently.
  for cand in "$HOME/code/nixos-config/main" "$HOME/code/nixos-config"; do # world:allow
    if [ -e "$cand/.git" ] && [ -d "$cand/dotfiles" ]; then
      printf '%s\n' "$cand"
      return 0
    fi
  done
  die "cannot locate the nixos-config checkout (set CFG_REPO)"
}

row_for() {
  local want="$1" row
  for row in "${CFG_REGISTRY[@]}"; do
    [ "${row%%|*}" = "$want" ] || continue
    printf '%s\n' "$row"
    return 0
  done
  return 1
}

known_names() {
  local row
  for row in "${CFG_REGISTRY[@]}"; do printf '%s ' "${row%%|*}"; done
}

# Lines added / removed going record -> live. diffstat(1) is not guaranteed on
# PATH, so count from the unified diff directly.
diffstat_of() {
  local record="$1" live="$2" added removed
  added=$(diff -u -- "$record" "$live" | grep -c '^+[^+]' || true)
  removed=$(diff -u -- "$record" "$live" | grep -c '^-[^-]' || true)
  printf '+%s -%s' "$added" "$removed"
}

# Write $2 into $1 as a fresh regular, user-writable file. Never writes THROUGH
# an existing symlink: that is exactly the leak into the checkout this tool
# exists to stop.
install_regular() {
  local dest="$1" src="$2" tmp
  mkdir -p -- "$(dirname -- "$dest")"
  tmp=$(mktemp -- "$dest.cfg.XXXXXX")
  cat -- "$src" >"$tmp"
  chmod 644 -- "$tmp"
  rm -f -- "$dest"
  mv -f -- "$tmp" "$dest"
}

cmd_status() {
  local repo="$1" only="${2:-}" row name live record state stat
  repo=${repo%/}
  for row in "${CFG_REGISTRY[@]}"; do
    IFS='|' read -r name live record <<<"$row"
    [ -z "$only" ] || [ "$only" = "$name" ] || continue
    live="$HOME/$live"
    record="$repo/$record"
    stat=""
    if [ ! -e "$record" ]; then
      state="no-record"
    elif [ -L "$live" ]; then
      state="wired"
    elif [ ! -e "$live" ]; then
      state="absent"
    elif cmp -s -- "$record" "$live"; then
      state="in-sync"
    else
      state="drifted"
      stat=$(diffstat_of "$record" "$live")
    fi
    printf '%-10s %-9s %-10s %s\n' "$name" "$state" "$stat" "$live"
  done
}

cmd_diff() {
  local repo="$1" name="$2" row live record
  row=$(row_for "$name") || die "unknown name '$name' (known: $(known_names))"
  IFS='|' read -r _ live record <<<"$row"
  live="$HOME/$live"
  record="${repo%/}/$record"
  [ -e "$record" ] || die "no record at $record"
  [ -e "$live" ] || die "no live file at $live"
  diff -u --label "record $record" --label "live $live" -- "$record" "$live" || true
}

CFG_CLEAN_REPO=""
CFG_CLEAN_WT=""
CFG_CLEAN_BRANCH=""
cleanup_promote() {
  [ -n "$CFG_CLEAN_WT" ] || return 0
  git -C "$CFG_CLEAN_REPO" worktree remove --force "$CFG_CLEAN_WT" >/dev/null 2>&1 || true
  git -C "$CFG_CLEAN_REPO" branch -D "$CFG_CLEAN_BRANCH" >/dev/null 2>&1 || true
}

# live -> record. The checkout's main is never edited in place (a half-written
# primary is a broken engine for every other reader), so the change is made on a
# throwaway sibling worktree and fast-forwarded in. --ff-only is the sanctioned
# landing verb: it either advances main or refuses, never conflicts.
cmd_promote() {
  local repo="$1" name="$2" row live record container wt branch
  row=$(row_for "$name") || die "unknown name '$name' (known: $(known_names))"
  IFS='|' read -r _ live record <<<"$row"
  repo=${repo%/}
  live="$HOME/$live"

  if [ -L "$live" ]; then
    die "live file $live is still a symlink — run 'cfg materialize $name' first"
  fi
  [ -f "$live" ] || die "live file $live is missing or not a regular file"
  [ -e "$repo/.git" ] || die "$repo is not a git checkout"

  if [ -e "$repo/$record" ] && cmp -s -- "$repo/$record" "$live"; then
    printf 'cfg: %s already in sync with the record; nothing to promote\n' "$name"
    return 0
  fi
  if [ -n "$(git -C "$repo" status --porcelain -- "$record")" ]; then
    die "$repo/$record has uncommitted changes; resolve them before promoting"
  fi

  container=$(dirname -- "$repo")
  branch="cfg-promote-$name-$$"
  wt="$container/wt-$branch"

  git -C "$repo" worktree add -q "$wt" -b "$branch" >/dev/null
  # Globals, not locals: the EXIT trap outlives this frame. Any failure past
  # this point must not strand a worktree on the container.
  CFG_CLEAN_REPO="$repo" CFG_CLEAN_WT="$wt" CFG_CLEAN_BRANCH="$branch"
  trap cleanup_promote EXIT

  install_regular "$wt/$record" "$live"
  git -C "$wt" add -- "$record"
  git -C "$wt" commit -q -m "cfg promote $name: settle $record from the live file"

  if ! git -C "$repo" merge --ff-only -q "$branch"; then
    die "fast-forward into $repo failed (main moved); re-run cfg promote $name"
  fi

  trap - EXIT
  git -C "$repo" worktree remove "$wt"
  git -C "$repo" branch -d "$branch" >/dev/null

  printf 'cfg: promoted %s -> %s (%s)\n' "$name" "$record" \
    "$(git -C "$repo" rev-parse --short HEAD)"

  if git -C "$repo" remote get-url origin >/dev/null 2>&1; then
    if command -v safe-push >/dev/null 2>&1; then
      (cd "$repo" && safe-push)
    else
      printf 'cfg: landed locally; run safe-push in %s to publish\n' "$repo"
    fi
  fi
}

cmd_reset() {
  local repo="$1" name="$2" confirm="${3:-}" row live record
  [ "$confirm" = "--yes" ] || die "reset overwrites live tweaks; pass --yes to confirm"
  row=$(row_for "$name") || die "unknown name '$name' (known: $(known_names))"
  IFS='|' read -r _ live record <<<"$row"
  live="$HOME/$live"
  record="${repo%/}/$record"
  [ -e "$record" ] || die "no record at $record"
  install_regular "$live" "$record"
  printf 'cfg: reset %s from the record (%s)\n' "$name" "$record"
}

# Idempotent. A symlinked live path is detached into a regular file holding the
# symlink's RESOLVED content, so an uncommitted live preference survives the
# unwiring. An absent one is seeded from the record. A regular file is already
# the user's and is never touched.
cmd_materialize() {
  local repo="$1" only="${2:-}" row name live record
  repo=${repo%/}
  for row in "${CFG_REGISTRY[@]}"; do
    IFS='|' read -r name live record <<<"$row"
    [ -z "$only" ] || [ "$only" = "$name" ] || continue
    live="$HOME/$live"
    record="$repo/$record"
    if [ -L "$live" ]; then
      if [ -r "$live" ]; then
        install_regular "$live" "$live"
        printf 'cfg: materialized %s from its symlink target\n' "$name"
      elif [ -e "$record" ]; then
        install_regular "$live" "$record"
        printf 'cfg: materialized %s from the record (dangling symlink)\n' "$name"
      else
        printf 'cfg: skipped %s (dangling symlink, no record)\n' "$name" >&2
      fi
    elif [ -e "$live" ]; then
      if [ -f "$live" ]; then
        printf 'cfg: %s already live-owned\n' "$name"
      else
        printf 'cfg: skipped %s (%s is not a regular file)\n' "$name" "$live" >&2
      fi
    elif [ -e "$record" ]; then
      install_regular "$live" "$record"
      printf 'cfg: seeded %s from the record\n' "$name"
    else
      printf 'cfg: skipped %s (no live file, no record)\n' "$name" >&2
    fi
  done
}

main() {
  local verb="${1:-}" repo
  case "$verb" in
    -h|--help|help) usage; exit 0 ;;
    '') usage >&2; exit 2 ;;
  esac
  shift
  repo=$(resolve_repo)
  case "$verb" in
    status)      cmd_status "$repo" "${1:-}" ;;
    diff)        [ $# -ge 1 ] || die "diff needs a name (known: $(known_names))"
                 cmd_diff "$repo" "$1" ;;
    promote)     [ $# -ge 1 ] || die "promote needs a name (known: $(known_names))"
                 cmd_promote "$repo" "$1" ;;
    reset)       [ $# -ge 1 ] || die "reset needs a name (known: $(known_names))"
                 cmd_reset "$repo" "$1" "${2:-}" ;;
    materialize) cmd_materialize "$repo" "${1:-}" ;;
    *)           usage >&2; die "unknown verb '$verb'" ;;
  esac
}

main "$@"
