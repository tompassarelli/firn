#!/usr/bin/env bash
# Managed North lanes already own their exact @agent identity and bootstrap.
# Native Codex sessions retain North's native session projection.
set -uo pipefail

if [ "${NORTH_MANAGED_LANE:-}" = 1 ]; then
  case "${AGENT_TOPOLOGY:-}" in
    worker|orchestrator)
      if [[ "${AGENT_ID:-}" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,511}$ ]]; then
        cat >/dev/null
        exit 0
      fi
      ;;
  esac
fi

HERE="$(
  CDPATH='' builtin cd -- "${BASH_SOURCE[0]%/*}" 2>/dev/null &&
    builtin pwd -P
)" || exit 0
BASH_BIN="$HERE/runtime/bash"
NORTH_HOME="$HERE/north"
TARGET="$NORTH_HOME/bin/north-on-spawn"
[ -x "$BASH_BIN" ] && [ -x "$TARGET" ] || exit 0

unset AGENT_ID AGENT_TOPOLOGY NORTH_MANAGED_LANE
export AGENT_PROVIDER=openai NORTH_HOME
exec "$BASH_BIN" "$TARGET" "$@"
