#!/usr/bin/env bash
# Managed North lanes are renewed and finalized by the harness. Running the
# native hook would derive a second session row and could rewrite kind=lane.
set -uo pipefail

drain_stdin() {
  while IFS= builtin read -r -N 65536; do
    :
  done
}

if [ "${NORTH_MANAGED_LANE:-}" = 1 ]; then
  case "${AGENT_TOPOLOGY:-}" in
    worker|orchestrator)
      if [[ "${AGENT_ID:-}" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,511}$ ]]; then
        drain_stdin
        exit 0
      fi
      ;;
  esac
fi

HERE="$(
  CDPATH='' builtin cd -- "${BASH_SOURCE[0]%/*}" 2>/dev/null &&
    builtin pwd -P
)" || {
  drain_stdin
  exit 0
}
ACTIVATION_LIB="$HERE/lib/north-agent-activation.sh"
# shellcheck disable=SC2034  # Read by the sourced activation library.
NORTH_AGENT_PYTHON="$HERE/runtime/python3"
# shellcheck disable=SC1090
if [ ! -r "$ACTIVATION_LIB" ] ||
   ! source "$ACTIVATION_LIB" ||
   ! north_agent_unit_active hook north-on-tooluse; then
  drain_stdin
  exit 0
fi
BASH_BIN="$HERE/runtime/bash"
NORTH_HOME="$HERE/north"
TARGET="$NORTH_HOME/bin/north-on-tooluse"
[ -x "$BASH_BIN" ] && [ -x "$TARGET" ] || {
  drain_stdin
  exit 0
}

unset AGENT_ID AGENT_TOPOLOGY NORTH_MANAGED_LANE
export AGENT_PROVIDER=openai NORTH_HOME
unset NORTH_AGENT_PYTHON
exec "$BASH_BIN" "$TARGET" "$@"
