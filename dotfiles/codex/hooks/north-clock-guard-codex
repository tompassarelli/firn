#!/usr/bin/env bash
# Codex protocol adapter for the provider-neutral billable clock guard.
# The core emits private allow/not-applicable attestations only when explicitly
# requested. This adapter consumes them and emits only Codex-valid output.
set -uo pipefail
umask 077

NOOP='{"hookSpecificOutput":{"hookEventName":"PreToolUse"}}'
UNAVAILABLE='{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"billable_clock_guard_unavailable"}}'

noop() {
  builtin printf '%s\n' "$NOOP"
  exit 0
}

deny_unavailable() {
  builtin printf '%s\n' "$UNAVAILABLE"
  exit 0
}

HERE="$(
  CDPATH='' builtin cd -- "${BASH_SOURCE[0]%/*}" 2>/dev/null &&
    builtin pwd -P
)" ||
  deny_unavailable
RUNTIME="$HERE/runtime"
BASH_BIN="$RUNTIME/bash"
CAT="$RUNTIME/cat"
GIT="$RUNTIME/git"
MKTEMP="$RUNTIME/mktemp"
PYTHON="$RUNTIME/python3"
RM="$RUNTIME/rm"
TIMEOUT="$RUNTIME/timeout"
for dependency in "$BASH_BIN" "$CAT" "$GIT" "$MKTEMP" "$PYTHON" "$RM" "$TIMEOUT"; do
  [ -x "$dependency" ] || deny_unavailable
done
PYTHON_STORE="$("$PYTHON" -I -S -c \
  'import os,sys; print(os.path.realpath(sys.argv[1]))' "$PYTHON" 2>/dev/null)" ||
  deny_unavailable

WORK="$(
  "$TIMEOUT" --signal=TERM --kill-after=0.1s 0.5s \
    "$MKTEMP" -d "${TMPDIR:-/tmp}/north-clock-codex.XXXXXX" 2>/dev/null
)" || deny_unavailable
[ -n "$WORK" ] && [ -d "$WORK" ] || deny_unavailable
INPUT="$WORK/input.json"
OUTPUT="$WORK/output.json"
# Invoked indirectly by the EXIT trap below.
# shellcheck disable=SC2329
cleanup() {
  "$RM" -rf "$WORK" 2>/dev/null || true
}
trap cleanup EXIT

# Drain the complete hook envelope before any kill-switch/no-op exit. Retain at
# most MAX_INPUT_BYTES+1 while continuing to EOF, so a disabled guard cannot
# close Codex's writer early and an oversized envelope remains memory-bounded.
# shellcheck disable=SC2016
if ! "$TIMEOUT" --signal=TERM --kill-after=0.2s 1s \
    "$PYTHON_STORE" -I -S -c '
import sys

limit = 1 << 20
remaining = limit + 1
total = 0
with open(sys.argv[1], "wb") as output:
    while True:
        chunk = sys.stdin.buffer.read(65536)
        if not chunk:
            break
        total += len(chunk)
        if remaining:
            retained = chunk[:remaining]
            output.write(retained)
            remaining -= len(retained)
raise SystemExit(0 if total <= limit else 65)
' "$INPUT" 2>/dev/null; then
  deny_unavailable
fi

KILLSWITCH="$HERE/lib/authoring-killswitch.sh"
[ -r "$KILLSWITCH" ] || deny_unavailable
# shellcheck disable=SC1090
builtin source "$KILLSWITCH" 2>/dev/null || deny_unavailable
authoring_guards_off && noop

CORE="$HERE/north-clock-guard.py"
[ -r "$CORE" ] || deny_unavailable
GIT_STORE="$("$PYTHON" -I -S -c \
  'import os,sys; print(os.path.realpath(sys.argv[1]))' "$GIT" 2>/dev/null)" ||
  deny_unavailable

core_status=0
# shellcheck disable=SC2016
{
  "$TIMEOUT" --signal=TERM --kill-after=0.2s 3s \
    "$BASH_BIN" -c '
      ulimit -f 128
      export AGENT_NO_AUTHORING_HOOKS=0
      export NORTH_CLOCK_GUARD_ATTEST=1
      export NORTH_CLOCK_GUARD_GIT="$4"
      exec "$1" -I -S "$2" <"$3" >"$5"
    ' _ "$PYTHON_STORE" "$CORE" "$INPUT" "$GIT_STORE" "$OUTPUT"
} 2>/dev/null || core_status=$?
[ "$core_status" -eq 0 ] || deny_unavailable
[ -f "$OUTPUT" ] || deny_unavailable

classification="$(
  "$TIMEOUT" --signal=TERM --kill-after=0.1s 1s \
    "$PYTHON" -I -S - "$OUTPUT" <<'PY' 2>/dev/null
import json
import sys

path = sys.argv[1]
raw = open(path, "rb").read(65537)
if not raw or len(raw) > 65536 or b"\0" in raw or b"\r" in raw:
    raise SystemExit(1)
line = raw[:-1] if raw.endswith(b"\n") else raw
if not line or b"\n" in line or raw not in (line, line + b"\n"):
    raise SystemExit(1)

def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON key")
        result[key] = value
    return result

payload = json.loads(line.decode("utf-8"), object_pairs_hook=unique_object)
if (isinstance(payload, dict)
        and set(payload) == {"northClockGuard"}
        and payload["northClockGuard"] in ("allow", "not-applicable")):
    print("NOOP")
    raise SystemExit(0)

if not isinstance(payload, dict) or set(payload) != {"hookSpecificOutput"}:
    raise SystemExit(1)
specific = payload["hookSpecificOutput"]
if (not isinstance(specific, dict)
        or set(specific) != {
            "hookEventName", "permissionDecision", "permissionDecisionReason"
        }
        or specific["hookEventName"] != "PreToolUse"
        or specific["permissionDecision"] != "deny"
        or not isinstance(specific["permissionDecisionReason"], str)
        or not specific["permissionDecisionReason"].strip()):
    raise SystemExit(1)
print("DENY")
PY
)" || deny_unavailable

case "$classification" in
  NOOP) noop ;;
  DENY)
    "$CAT" "$OUTPUT" || deny_unavailable
    ;;
  *) deny_unavailable ;;
esac
exit 0
