use firn/tags

eyedropper is a Module
eyedropper is tagged desktop

nix module
  arguments: config, lib, pkgs, ...
  config when config.myConfig.modules.eyedropper.enable
    "environment"
      "systemPackages": [pkgs.eyedropper]
  option "myConfig"."modules"."eyedropper"."enable": enable "Wayland color picker"
