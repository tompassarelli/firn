#lang beagle/nix

(ns default)

(nix/module [config lib pkgs ...]
  (let [username config.myConfig.modules.users.username]
    {:options.myConfig.modules.ironbar.enable
      (lib.mkEnableOption "Ironbar status bar for Wayland")
     :config
      (lib.mkIf config.myConfig.modules.ironbar.enable
        {:environment.systemPackages [pkgs.unstable.ironbar]
         :home-manager.users
          {username
            (nix/module [config ...]
              {:systemd.user.services.ironbar
                {:Unit
                  {:Description "Customizable GTK4 status bar for Wayland"
                   :PartOf      ["graphical-session.target"]
                   :After       ["graphical-session.target"]
                   :Requisite   ["graphical-session.target"]}
                 :Service
                  {:ExecStart (s pkgs.unstable.ironbar "/bin/ironbar")
                   :Restart   "on-failure"}
                 :Install {:WantedBy ["niri.service"]}}
               :systemd.user.services.ironbar-overview
                {:Unit
                  {:Description "Ironbar overview listener script"
                   :PartOf      ["graphical-session.target"]
                   :After       ["ironbar.service"]
                   :Requires    ["ironbar.service"]}
                 :Service
                  {:ExecStart "%h/.config/ironbar/overview-ironbar.py"
                   :Restart   "on-failure"}
                 :Install {:WantedBy ["niri.service"]}}
               :xdg.configFile
                {"ironbar/config.toml"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/nixos-config/dotfiles/ironbar/config.toml"))}
                 "ironbar/stylix.css"
                  {:text
                    (nix/with config.lib.stylix.colors
                      (ms (s "@define-color base00 #" base00 ";") (s "@define-color base01 #" base01 ";") (s "@define-color base02 #" base02 ";") (s "@define-color base03 #" base03 ";") (s "@define-color base04 #" base04 ";") (s "@define-color base05 #" base05 ";") (s "@define-color base06 #" base06 ";") (s "@define-color base07 #" base07 ";") (s "@define-color base08 #" base08 ";") (s "@define-color base09 #" base09 ";") (s "@define-color base0A #" base0A ";") (s "@define-color base0B #" base0B ";") (s "@define-color base0C #" base0C ";") (s "@define-color base0D #" base0D ";") (s "@define-color base0E #" base0E ";") (s "@define-color base0F #" base0F ";") "" "* {" (s "  font-family: \"" config.stylix.fonts.monospace.name "\";") (s "  font-size: " (toString config.stylix.fonts.sizes.desktop) "pt;") "}" "" ".background {" (s "  background: alpha(@base00, " (toString config.stylix.opacity.desktop) ");") "  color: @base05;" "}" "" "tooltip {" (s "  background: alpha(@base00, " (toString config.stylix.opacity.desktop) ");") "  color: @base05;" "  border-color: @base0D;" "}" ""))}
                 "ironbar/style.css"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/nixos-config/dotfiles/ironbar/style.css"))}
                 "ironbar/overview-ironbar.py"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/nixos-config/dotfiles/ironbar/overview-ironbar.py"))}
                 "ironbar/battery.sh"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/nixos-config/dotfiles/ironbar/battery.sh"))}}})}})}))
