#lang beagle/nix

(ns default)

;; Convoy — the cockpit command over the agentic stack (fram fact engine ·
;; tern coordination · gaffer staffing · beagle/firn authoring). One entry
;; point: dashboard, help router, spawn/watch/steer, profile rungs.
;; Thin PATH wrapper exec'ing the tree bin ON PURPOSE: convoy is glue over
;; tree-local tools (tern/fram bins, gaffer docs) and must track them live —
;; a hermetic package would pin yesterday's stack. Requires ~/code/convoy.
(nix/module [config lib pkgs ...]
  {:tags [cli-tools]
   :options.myConfig.modules.convoy.enable
    (lib.mkEnableOption "Convoy — cockpit command for the agentic stack")
   :config
    (lib.mkIf config.myConfig.modules.convoy.enable
      {:environment.systemPackages
        [(pkgs.writeShellScriptBin "convoy"
           (ms "exec /home/tom/code/convoy/bin/convoy \"$@\""))]})})
