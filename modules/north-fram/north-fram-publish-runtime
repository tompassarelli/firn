selection="${NORTH_STORE_SELECTION:?north-fram: NORTH_STORE_SELECTION must name the FRAMRPC selection file}"
unit="${NORTH_COORD_SYSTEMD_UNIT:?north-fram: NORTH_COORD_SYSTEMD_UNIT must name the controller unit}"
main_pid="${1:?north-fram: the listener PID is required}"

set -a
# shellcheck disable=SC1090
. "$selection"
set +a

receipt="$BEAGLE_STORE_HOME/RELEASE"
[ -r "$receipt" ] || { echo "north-fram: sealed release has no receipt: $receipt" >&2; exit 1; }

receipt_value() {
  sed -n "s/^$1=//p" "$receipt" | head -n 1
}

revision="$(receipt_value revision)"
tree="$(receipt_value tree)"
[ -n "$revision" ] && [ -n "$tree" ] ||
  { echo "north-fram: sealed release receipt lacks revision or tree" >&2; exit 1; }

# Field 22 of /proc/<pid>/stat, counted after the parenthesised comm, is the
# process start time in clock ticks. It is what distinguishes this listener
# from a later process that reuses its PID.
stat_line="$(cat "/proc/$main_pid/stat")" ||
  { echo "north-fram: listener $main_pid is gone" >&2; exit 1; }
after_comm="${stat_line##*) }"
start_ticks="$(printf '%s\n' "$after_comm" | cut -d' ' -f20)"
case "$start_ticks" in
  ''|*[!0-9]*) echo "north-fram: cannot read listener birth for $main_pid" >&2; exit 1 ;;
esac

record_dir="${XDG_STATE_HOME:-$HOME/.local/state}/north/store-runtime"
record="$record_dir/north-store.runtime"
mkdir -p "$record_dir"

# The attestation reads one 0600 regular file with an exact field order.
temp="$record.next.$$"
umask 077
{
  echo "FORMAT=north-store-runtime/v1"
  echo "BEAGLE_STORE_SOURCE=$BEAGLE_STORE_HOME"
  echo "BEAGLE_STORE_REVISION=$revision"
  echo "BEAGLE_STORE_TREE=$tree"
  echo "BEAGLE_STORE_NATIVE_ARTIFACT_DIR=$BEAGLE_STORE_NATIVE_ARTIFACT_DIR"
  echo "BEAGLE_STORE_NATIVE_CLOSURE_SHA256=$BEAGLE_STORE_NATIVE_CLOSURE_SHA256"
  echo "BEAGLE_STORE_SERVER_ARTIFACT=$BEAGLE_STORE_SERVER_ARTIFACT"
  echo "BEAGLE_STORE_SERVER_ARTIFACT_SHA256=$BEAGLE_STORE_SERVER_ARTIFACT_SHA256"
  echo "BEAGLE_STORE_SPACE_ID=$BEAGLE_STORE_SPACE_ID"
  echo "BEAGLE_STORE_PORT=$BEAGLE_STORE_SERVER_PORT"
  echo "BEAGLE_STORE_LOG=$BEAGLE_STORE_LOG"
  echo "PID=$main_pid"
  echo "PID_BIRTH=proc:$start_ticks"
  echo "CONTROLLER_UNIT=$unit"
  echo "CONTROLLER_MAIN_PID=$main_pid"
} >"$temp"
chmod 600 "$temp"
mv -f "$temp" "$record"
