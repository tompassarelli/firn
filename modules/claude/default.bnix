#lang beagle/nix

(ns default)

(nix/module [config lib pkgs ...]
  (let [username config.myConfig.modules.users.username]
    {:tags-opt-in [development]

     :options.myConfig.modules.claude.enable
      (lib.mkEnableOption "Claude Code fallback coding agent")

     :config
      (lib.mkIf config.myConfig.modules.claude.enable
        ;; Stable nixpkgs freezes claude-code far behind upstream; the agent
        ;; must track the release its instructions and hooks are written for.
        {:environment.systemPackages
          [(pkgs.unstable.claude-code.overrideAttrs
            (fn [old] Any
              {:version "2.1.293"
               :src (pkgs.fetchurl
                     {:url "https://downloads.claude.ai/claude-code-releases/2.1.293/linux-x64/claude.zst"
                      :hash "sha256-JXhto0fDBkHcbFBzPQkNd8tUDxBaYa9+mJW1bjn+FqU="})}))]

         :home-manager.users
          {username
           (nix/module [config ...]
             {:home.file
              {".claude/CLAUDE.md"
               {:source
                (config.lib.file.mkOutOfStoreSymlink
                  (s config.home.homeDirectory
                     "/.local/state/north/agents/current/instructions/shared/AGENTS.md"))}
               ;; Worker tiers by reasoning effort. A spawn can't set effort,
               ;; so escalation re-runs a task on the next tier's agent.
               ".claude/agents"
               {:source
                (config.lib.file.mkOutOfStoreSymlink
                  (s config.home.homeDirectory
                     "/code/nixos-config/main/dotfiles/agents/claude/agents"))}}})}})}))
