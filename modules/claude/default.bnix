#lang beagle/nix

(ns default)

(nix/module [config lib pkgs inputs flakeRoot ...]
  (let [username config.myConfig.modules.users.username
        ;; Preserve the explicitly pinned native Linux binary while using the
        ;; pinned nixpkgs-master package that actually supports aarch64-darwin.
        claudePackage
         (if pkgs.stdenv.hostPlatform.isDarwin
           pkgs.master.claude-code
           pkgs.claude-code-latest)
        psBin
         (if pkgs.stdenv.hostPlatform.isDarwin
           "/bin/ps"
           (s pkgs.procps "/bin/ps"))
        northPkg
         (get (get inputs.north.packages pkgs.stdenv.hostPlatform.system) :default)
        framPkg
         (get (get inputs.fram.packages pkgs.stdenv.hostPlatform.system) :default)
        claudeSettingsSeed
         (pkgs.writeText "claude-settings.json"
           (builtins.readFile
             (s flakeRoot "/dotfiles/claude/settings.json")))
        claudeSettingsSeeder
         (pkgs.writeShellScript "claude-settings-seed"
           (builtins.readFile
             (s flakeRoot "/scripts/claude-settings-seed.sh")))
        northSessionEnd
         (pkgs.writeShellScriptBin "north-session-end"
           (builtins.readFile
             (s flakeRoot "/dotfiles/agents/hooks/north-session-end.sh")))
        mcpRegister
         (pkgs.writeShellScript "claude-mcp-register"
           (builtins.readFile
             (s flakeRoot "/scripts/claude-mcp-register.sh")))]
    {:tags [development]
     :options.myConfig.modules.claude.enable
      (lib.mkEnableOption "Claude Code CLI configuration")
     :config
      (lib.mkIf config.myConfig.modules.claude.enable
        {:environment.systemPackages [claudePackage northSessionEnd]
         :home-manager.users
          {username
            (nix/module [config ...]
              {:home.file
                {".claude/commands"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/nixos-config/dotfiles/claude/commands"))}
                 ".claude/skills"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/nixos-config/dotfiles/agents/skills"))}
                 ".claude/CLAUDE.md"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/nixos-config/dotfiles/claude/CLAUDE.md"))}
                 ".claude/hooks"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/nixos-config/dotfiles/agents/hooks"))}
                 ".claude/agents"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/nixos-config/dotfiles/claude/agents"))}
                 ;; ~/code root routing instruction — reproducible symlink.
                 "code/CLAUDE.md"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/nixos-config/dotfiles/code/CLAUDE.md"))}
                 ;; caveman defaultMode — lives in the dotfile now, flipped by
                 ;; `my-config caveman default <mode>`. Out-of-store symlink so
                 ;; the flip takes effect without a rebuild.
                 ".config/caveman/config.json"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/nixos-config/dotfiles/caveman/config.json"))}}
               ;; Atomically seed settings from this exact generation into a
               ;; writable regular file. Claude may mutate it at runtime; the next
               ;; generation converges it before plugin reconciliation runs.
               :home.activation.seedClaudeSettings
                (config.lib.dag.entryAfter ["writeBoundary"]
                  (s "run env INSTALL_BIN="
                     pkgs.coreutils
                     "/bin/install MKDIR_BIN="
                     pkgs.coreutils
                     "/bin/mkdir MV_BIN="
                     pkgs.coreutils
                     "/bin/mv REALPATH_BIN="
                     pkgs.coreutils
                     "/bin/realpath RM_BIN="
                     pkgs.coreutils
                     "/bin/rm FLOCK_BIN="
                     pkgs.util-linux
                     "/bin/flock JQ_BIN="
                     pkgs.jq
                     "/bin/jq "
                     claudeSettingsSeeder
                     " "
                     claudeSettingsSeed
                     " $HOME/.claude/settings.json\n"))
               ;; Runs AFTER seedClaudeSettings so settings.json is a writable
               ;; regular file before `claude plugin install` atomically rewrites it.
               :home.activation.installCaveman
                (config.lib.dag.entryAfter ["writeBoundary" "seedClaudeSettings"]
                  (s "CLAUDE=" claudePackage "/bin/claude\n"
                     ;; Bump WANT together with the fork's .claude-plugin/
                     ;; marketplace.json pin: it's the first 12 chars of the
                     ;; pinned commit sha = the on-disk cache dir name.
                     "WANT=37c28ebb1e0a\n"
                     ;; `claude plugin install` clones the plugin repo over SSH
                     ;; (git@github.com); this host talks to GitHub over HTTPS,
                     ;; so redirect that one clone with a throwaway git config
                     ;; (public repo → no creds needed).
                     ;; run-wrapped for dry-run purity ($(run mktemp), not `run GITC=…`
                     ;; — an assignment word after `run` would be command-not-found).
                     "GITC=$(run mktemp)\n"
                     "run " pkgs.git "/bin/git config -f \"$GITC\" url.\"https://github.com/\".insteadOf \"git@github.com:\"\n"
                     "if [ ! -e $HOME/.claude/plugins/cache/caveman ]; then\n"
                     "  run timeout 90 $CLAUDE plugin marketplace add tompassarelli/caveman || true\n"
                     "  run timeout 90 env GIT_CONFIG_GLOBAL=\"$GITC\" $CLAUDE plugin install caveman@caveman || true\n"
                     "elif [ ! -e $HOME/.claude/plugins/cache/caveman/caveman/$WANT ]; then\n"
                     ;; Pin moved. `install` no-ops when present and `update`
                     ;; needs SSH, so the only reliable upgrade is uninstall +
                     ;; install after refreshing the marketplace metadata.
                     "  run timeout 90 $CLAUDE plugin marketplace update caveman || true\n"
                     "  run timeout 90 $CLAUDE plugin uninstall caveman@caveman || true\n"
                     "  run timeout 90 env GIT_CONFIG_GLOBAL=\"$GITC\" $CLAUDE plugin install caveman@caveman || true\n"
                     ;; Reap stale pin dirs — uninstall+install leaves the old
                     ;; $WANT cache behind forever otherwise.
                     "  run find $HOME/.claude/plugins/cache/caveman/caveman -mindepth 1 -maxdepth 1 ! -name \"$WANT\" -exec rm -rf {} + || true\n"
                     "fi\n"
                     "run rm -f \"$GITC\"\n"))
               ;; MCP server registration — reproducible, so a fresh rebuild wires the
               ;; North, FRAM, and Linear user-scope servers instead of relying on
               ;; loose `claude mcp add` state in ~/.claude.json. Presence and shape
               ;; are decided STRUCTURALLY from the generated ~/.claude.json: the
               ;; `claude mcp get`/`list` surface always health-checks the server and
               ;; has no config-only mode, so a transiently-down server must never
               ;; masquerade as a missing declaration and trigger a destructive
               ;; remove/add. Bounded health lives behind the script's separate
               ;; `--health` mode; activation reconciles declarations only. fram is
               ;; the GENERIC engine MCP: its corpus is selected at deployment via env
               ;; (point it at the life store; never hardcode life paths into the
               ;; engine itself). north's wrapper resolves XDG on its own.
               :home.activation.registerMcpServers
                (config.lib.dag.entryAfter ["writeBoundary"]
                  (s "if ! run env CLAUDE_BIN="
                     claudePackage
                     "/bin/claude JQ_BIN="
                     pkgs.jq
                     "/bin/jq TIMEOUT_BIN="
                     pkgs.coreutils
                     "/bin/timeout CLAUDE_JSON=$HOME/.claude.json "
                     "LIFE=$HOME/.local/state/north "
                     "FRAM_MCP_BIN=" framPkg "/bin/fram-mcp "
                     "NORTH_MCP_BIN=" northPkg "/bin/north-mcp "
                     "WANT_NORTH_PORT=7977 "
                     mcpRegister
                     "; then\n"
                     "  echo \"warning: MCP server registration failed; agent-config-check --local will report the drift\" >&2\n"
                     "fi\n"))})}})}))
