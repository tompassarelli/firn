use firn/tags

tags: cli-tools

config
  "environment"
    "systemPackages": [pkgs.tealdeer]
  "home-manager"
    "users"
      {config.myConfig.modules.users.username}: (hm) => {"xdg": {"configFile": {"tealdeer/config.toml": {"source": (((hm.config).lib).file).mkOutOfStoreSymlink(("" ++ ((hm.config).home).homeDirectory) ++ "/code/nixos-config/dotfiles/tealdeer/config.toml")}}}}
