#lang beagle/nix

(ns kanata)

(nix/module [config lib pkgs ...]
  (let [cfg config.myConfig.modules.kanata]
    {:config
      (lib.mkIf cfg.enable
        {:hardware.uinput.enable true
         :services.udev.extraRules
          (ms "KERNEL==\"uinput\", MODE=\"0660\", GROUP=\"uinput\", OPTIONS+=\"static_node=uinput\"" "")
         :users.groups.uinput {}
         :users.users.kanata
          {:isSystemUser true :group "kanata" :extraGroups ["input" "uinput"]}
         :users.groups.kanata {}
         :services.kanata
          {:enable    true
           :package   pkgs.kanata-git
           :keyboards
            (lib.mkIf (not= cfg.devices [])
              {:main
                {:devices     cfg.devices
                 :port        (lib.mkIf (not= cfg.port nil) cfg.port)
                 :extraDefCfg "process-unmapped-keys yes"
                 :extraArgs   cfg.extraArgs
                 :config      (builtins.readFile cfg.configFile)}})}
         :systemd.services.kanata-main.serviceConfig
          (lib.mkIf (not= cfg.devices [])
            {:DynamicUser (lib.mkForce false) :User "kanata"})})}))
