use firn/tags

tags: development

arguments: config, lib, ...
config
  "home-manager"
    "users"
      {config.myConfig.modules.users.username}
        "programs"
          "direnv"
            "enable": true
            "nix-direnv"
              "enable": true
  "programs"
    "direnv"
      "enable": true
      "nix-direnv"
        "enable": true
"enable": "direnv for automatic dev shell activation"
