#lang beagle/nix

(ns default)

;; Periodic trigger for the exact packaged `north-stream-sync` — the zero-AI
;; cursor-based mirror of Claude Code transcripts into streams/raw/. Runs the
;; -all sweep, which covers EVERY per-account transcript root under
;; ~/.local/state/north/accounts as well as the pre-account ~/.claude/projects;
;; scanning only the latter silently froze the mirror at the account migration.
;; User-level timer (not a
;; system service like north-coord): it only touches files under $HOME, needs
;; no privileges, and should not block boot. SessionEnd hook flush is a
;; second, complementary trigger (dotfiles/agents/hooks/north-session-end.sh) —
;; the lock in the stream-sync script itself keeps the two from interleaving.
(nix/module [config lib pkgs inputs ...]
  (let [username config.myConfig.modules.users.username
        northPkg (get (get inputs.north.packages pkgs.stdenv.hostPlatform.system) :default)]
    {:options.myConfig.modules.north-stream-sync.enable
      (lib.mkEnableOption "North stream-sync timer — periodic transcript log-shipping into streams/raw")
     :config
      (lib.mkIf config.myConfig.modules.north-stream-sync.enable
        {:home-manager.users
          {username
            (nix/module [config ...]
              {:systemd.user.services.north-stream-sync
                {:Unit
                  {:Description "North stream-sync — mirror Claude Code transcripts into streams/raw"}
                 :Service
                  {:Type      "oneshot"
                   :ExecStart (s northPkg "/bin/north-stream-sync-all")}}
               :systemd.user.timers.north-stream-sync
                {:Unit
                  {:Description "Run north-stream-sync periodically"}
                 :Timer
                  {:OnStartupSec    "2m"
                   :OnUnitActiveSec "5m"
                   :Persistent      true}
                 :Install {:WantedBy ["timers.target"]}}})}})}))
