#lang beagle/nix

(ns default)

;; Periodic trigger for `north-stream-sync-all`, resolved through the promoted
;; runtime channel with the flake package as fallback — the zero-AI
;; cursor-based mirror of Claude and Codex transcripts into streams/raw/. Runs
;; the -all sweep across ambient, account, profile, and managed provider roots;
;; scanning only pre-account ~/.claude/projects silently froze the mirror at the
;; account migration and omitted Codex entirely.
;; User-level timer (not a
;; system service like north-coord): it only touches files under $HOME, needs
;; no privileges, and should not block boot. SessionEnd hook flush is a
;; second, complementary trigger (~/.agents/hooks/north-session-end.sh) —
;; the lock in the stream-sync script itself keeps the two from interleaving.
(nix/module [config lib pkgs inputs ...]
  (let [username config.myConfig.modules.users.username
        homeDir config.myConfig.modules.users.homeDir
        ;; Fallback root for the promoted runtime channel: the live checkout,
        ;; never a built package.
        northPkg (s homeDir "/code/north/main")
        ;; Shared with North coordination workers; modules/north owns the one definition of
        ;; promoted-channel resolution.
        northRuntimeExec
         (pkgs.writeShellApplication
           {:name "north-runtime-exec"
            :runtimeInputs (nix/with pkgs [coreutils])
            :text (builtins.readFile (p "../north/north-runtime-exec"))})]
    {:options.myConfig.modules.north-stream-sync.enable
      (lib.mkEnableOption "North stream-sync timer — periodic transcript log-shipping into streams/raw")
     :config
      (lib.mkIf config.myConfig.modules.north-stream-sync.enable
        {:home-manager.users
          {username
            (nix/module [config ...]
              {:systemd.user.services.north-stream-sync
                {:Unit
                  {:Description "North stream-sync — mirror Claude and Codex transcripts into streams/raw"
                   ;; A sweep can outlive a Home Manager activation. Keep the
                   ;; running one-shot: a later timer tick picks up this unit's
                   ;; new definition without making activation wait for it.
                   :X-SwitchMethod "keep-old"}
                 :Service
                  {:Type      "oneshot"
                   ;; Exit 2 means "mirrored, but at least one source was
                   ;; quarantined" — a report about one diverged transcript, not
                   ;; a failure of the sync. Without this the unit sits red
                   ;; whenever any single transcript has diverged, which is how
                   ;; a real outage learns to hide among the false alarms. Exit
                   ;; 1 still fails the unit.
                   :SuccessExitStatus "2"
                   :ExecStart (s northRuntimeExec "/bin/north-runtime-exec " northPkg " bin/north-stream-sync-all")}}
               :systemd.user.timers.north-stream-sync
                {:Unit
                  {:Description "Run north-stream-sync periodically"}
                 :Timer
                  {:OnStartupSec    "2m"
                   :OnUnitInactiveSec "5m"
                   :Persistent      true}
                 :Install {:WantedBy ["timers.target"]}}})}})}))
