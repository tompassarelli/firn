use firn/tags


arguments: config, lib, ...
config
  "boot"
    "loader"
      "systemd-boot"
        "configurationLimit": 10
  "nix"
    "gc"
      "automatic": true
      "dates": "weekly"
      "options": "--delete-older-than 30d"
    "settings"
      "auto-optimise-store": true
      "builders-use-substitutes": true
      # max-jobs=auto is 24 here, so cores is the per-derivation half of
      # the product. 8 = one third of 24: a lone big build still gets
      # 8-way make, three concurrent ones exactly fill the box.
      "cores": 8
      "experimental-features": ["nix-command", "flakes"]
      "extra-substituters": ["https://nix-community.cachix.org", "https://walker.cachix.org", "https://walker-git.cachix.org", "https://devenv.cachix.org", "https://quickshell.cachix.org"]
      "extra-trusted-public-keys": ["nix-community.cachix.org-1:mB9FSh9qf2dCimDSUo8Zy7bkq5CX+/rkCWyvRCYg3Fs=", "walker.cachix.org-1:fG8q+uAaMqhsMxWjwvk0IMb4mFPFLqHjuvfwQxE4oJM=", "walker-git.cachix.org-1:vmC0ocfPWh0S/vRAQGtChuiZBTAe4wiKDeyyXM0/7pM=", "devenv.cachix.org-1:w1cLUi8dv3hnoSPGAuibQv+f9TZLr6cv/Hm9XgU50cw=", "quickshell.cachix.org-1:vBm3s5tZThc5KDLj6zhHVCMp8wX/AZJwle9wqdi81ts="]
      "keep-derivations": true
      # A rooted .drv keeps its build outputs alive: without these, GC
      # collects a long-compile closure the moment its out-link goes.
      "keep-outputs": true
      "max-jobs": "auto"
      "trusted-users": ["root", "@wheel"]
  "nixpkgs"
    "config"
      "allowUnfree": true
  # Builders run inside nix-daemon.service's cgroup; 50 makes them the
  # yielding half of system.slice.
  "systemd"
    "services"
      "nix-daemon"
        "serviceConfig"
          "CPUWeight": 50
"enable": "Nix configuration and package settings"
