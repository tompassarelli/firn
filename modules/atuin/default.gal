use firn/tags

tags: terminal

arguments: config, lib, ...
config
  "home-manager"
    "users"
      {config.myConfig.modules.users.username}
        "programs"
          "atuin"
            "enable": true
            "enableFishIntegration": true
            "settings"
              "auto_sync": true
              "search_mode": "fuzzy"
              "sync_frequency": "5m"
"enable": "atuin shell history sync"
