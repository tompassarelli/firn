use firn/tags

tags: javascript

arguments: config, lib, ...
config
  "home-manager"
    "users"
      {config.myConfig.modules.users.username}: (hm) => {"home": {"file": {".bunfig.toml": {"source": (((hm.config).lib).file).mkOutOfStoreSymlink(("" ++ ((hm.config).home).homeDirectory) ++ "/code/nixos-config/dotfiles/bun/bunfig.toml")}}}}
"enable": "Global Bun settings: 7-day release cooldown, no auto-install"
