use firn/tags

libsecret is a Module
libsecret is tagged cli-tools

nix module
  arguments: config, lib, pkgs, ...
  config when config.myConfig.modules.libsecret.enable
    "environment"
      "systemPackages": [pkgs.libsecret]
  option "myConfig"."modules"."libsecret"."enable": enable "secret-tool CLI for the login-keyring secret service"
