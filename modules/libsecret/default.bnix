#lang beagle/nix

(ns default)

(nix/module [config lib pkgs ...]
  {:tags [cli-tools]
   :options.myConfig.modules.libsecret.enable
    (lib.mkEnableOption "secret-tool CLI for the login-keyring secret service")
   :config
    (lib.mkIf config.myConfig.modules.libsecret.enable
      {:environment.systemPackages (nix/with pkgs [libsecret])})})
