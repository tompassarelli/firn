#lang beagle/nix
(ns default)
(nix/module [config lib pkgs ...]
  (let [cfg config.myConfig.modules.laptop-runner
        homeDir config.myConfig.modules.users.homeDir
        username config.myConfig.modules.users.username
        notify (if config.myConfig.modules.nexus-alerts.enable "nexus-notify@%n.service" "update-notify@%n.service")
        description "laptop-runner: each minute and on wake, run jobs queued on the ledger for this host's placement, one at a time"]
    {:tags-opt-in [development]
     :options.myConfig.modules.laptop-runner.enable (lib.mkEnableOption description)
     :options.myConfig.modules.laptop-runner.placement
      (lib.mkOption
        {:type lib.types.str
         :default "laptop"
         :description "ledger queue placement this host's runner takes jobs for"})
     :config (lib.mkIf cfg.enable
       {:home-manager.users {username (nix/module [config ...]
         {:systemd.user.services.laptop-runner
           {:Unit {:Description description :OnFailure [notify]}
            :Service {:Type "oneshot"
              :Environment [(s "PATH=" homeDir "/.local/bin:" homeDir "/.local/share/firn/bin:" homeDir "/.local/share/north/bin:" (lib.makeBinPath [pkgs.bash pkgs.coreutils pkgs.jq pkgs.util-linux pkgs.openssh pkgs.python3]) ":/etc/profiles/per-user/" username "/bin:/run/current-system/sw/bin")
                            (s "LAPTOP_RUNNER_PLACEMENT=" cfg.placement)]
              :ExecStart (s homeDir "/.local/share/north/bin/laptop-runner")}}
          :systemd.user.timers.laptop-runner
           {:Unit {:Description description}
            :Timer {:OnCalendar "minutely" :Persistent true}
            :Install {:WantedBy ["timers.target"]}}})}})}))
