use firn/tags

laptop-runner is a Module
laptop-runner can opt into development

nix module
  arguments: config, lib, pkgs, ...
  let cfg = config.myConfig.modules.laptop-runner
  let homeDir = config.myConfig.modules.users.homeDir
  let username = config.myConfig.modules.users.username
  let notify = if config.myConfig.modules.nexus-alerts.enable then "nexus-notify@%n.service" else "update-notify@%n.service"
  let description = "laptop-runner: each minute and on wake, run jobs queued on the ledger for this host's placement, one at a time"
  option myConfig.modules.laptop-runner.enable: enable description
  option myConfig.modules.laptop-runner.placement: Text
    default: "laptop"
    description: "ledger queue placement this host's runner takes jobs for"
  config when cfg.enable
    home-manager.users.{username}: ({config, ...}) => {systemd.user.services.laptop-runner: {Unit: {Description: description, OnFailure: [notify]}, Service: {Type: "oneshot", Environment: ["PATH={homeDir}/.local/bin:{homeDir}/.local/share/firn/bin:{homeDir}/.local/share/north/bin:{lib.makeBinPath([pkgs.bash, pkgs.coreutils, pkgs.jq, pkgs.util-linux, pkgs.openssh, pkgs.python3, pkgs.git])}:/etc/profiles/per-user/{username}/bin:/run/current-system/sw/bin", "LAPTOP_RUNNER_PLACEMENT={cfg.placement}"], ExecStart: "{homeDir}/.local/share/north/bin/laptop-runner"}}, systemd.user.timers.laptop-runner: {Unit: {Description: description}, Timer: {OnCalendar: "minutely", Persistent: true}, Install: {WantedBy: ["timers.target"]}}}
