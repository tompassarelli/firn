#lang beagle/nix
(ns default)
(nix/module [config lib pkgs jobRun ...]
  (let [homeDir config.myConfig.modules.users.homeDir
        username config.myConfig.modules.users.username
        description "Twice-daily ranked public watch digest"]
    {:tags-opt-in [development]
     :options.myConfig.modules.model-watch.enable (lib.mkEnableOption description)
     :config (lib.mkIf config.myConfig.modules.model-watch.enable
       {:home-manager.users {username (nix/module [config ...]
         {:systemd.user.services.model-watch
           {:Unit {:Description description
                   :After ["agent-runtime-update.service"]
                   :OnFailure ["update-notify@%n.service"]}
            :Service {:Type "oneshot" :Nice 10 :TimeoutStartSec "10min"
              :Environment [(s "PATH=/run/wrappers/bin:/run/current-system/sw/bin:" homeDir "/.local/bin:" (lib.makeBinPath [pkgs.python3]))]
              :ExecStart (jobRun "model-watch" (s homeDir "/.local/share/north/bin/model-watch"))}}
          :systemd.user.timers.model-watch
           {:Unit {:Description description}
            :Timer {:OnCalendar ["08:00" "18:00"] :Persistent true}
            :Install {:WantedBy ["timers.target"]}}})}})}))
