#lang beagle/nix

(ns default)

;; Ordinary North and MCP commands execute the exact flake package selected by
;; the system generation. Mutable checkout execution is an explicit development
;; surface with visible provenance; it never masquerades as a production name.
(nix/module [config lib pkgs inputs ...]
  (let
    [homeDir config.myConfig.modules.users.homeDir
     stageA config.myConfig.modules.north-coord.stageATelemetryPartition
     clientEnvironment
      (if stageA
        (ms "export NORTH_TELEMETRY_PARTITION=1"
            "export NORTH_TELEMETRY_PORT=7978"
            (s "export FRAM_TELEMETRY_LOG="
               homeDir "/.local/state/north/telemetry.log"))
        "")
     northPkg
      (get (get inputs.north.packages pkgs.stdenv.hostPlatform.system) :default)
     codexPkg
      (get (get inputs.north.packages pkgs.stdenv.hostPlatform.system) :codex)
     liveInputs (nix/with pkgs [bash coreutils git babashka bun jq])
     northRuntimeOwnerGuard
      (pkgs.writeShellApplication
        {:name "north-runtime-owner-guard"
         :runtimeInputs (nix/with pkgs [bash coreutils])
         :text (builtins.readFile (p "./north-runtime-owner-guard"))})
     northProduction
      (pkgs.writeShellApplication
        {:name "north"
         :text
          (ms clientEnvironment
              "unset NORTH_CHECKOUT"
              (s northRuntimeOwnerGuard "/bin/north-runtime-owner-guard \"$@\"")
              (s "exec " northPkg "/bin/north \"$@\""))})
     northMcpProduction
      (pkgs.writeShellApplication
        {:name "north-mcp"
         :text
          (ms clientEnvironment
              "unset NORTH_CHECKOUT"
              (s "exec " northPkg "/bin/north-mcp \"$@\""))})
     mkPinnedCommand
      (fn [name]
        (pkgs.writeShellApplication
          {:name name
           :text
            (ms clientEnvironment
                "unset NORTH_CHECKOUT"
                (s "exec " northPkg "/bin/" name " \"$@\""))}))
     pinnedCommandNames
      ["north-on-spawn" "north-on-tooluse" "north-mark-delegated"
       "north-on-stop" "concern" "north-stream-sync"
       ;; oversight surfaces: the pinned big-fish board and the per-thread
       ;; effort rollup. Shipped but unexposed is the same as not shipped.
       "north-pinned" "north-effort"]
     pinnedCommands (builtins.map mkPinnedCommand pinnedCommandNames)
     mkDev
      (fn [name]
        (pkgs.writeShellApplication
          {:name (s name "-dev")
         :runtimeInputs liveInputs
         :text
          (ms clientEnvironment
              "checkout=${NORTH_CHECKOUT:-$HOME/code/north/main}"
              (s "target=$checkout/bin/" name)
              "if [ ! -x \"$target\" ]; then"
              (s "  echo \"" name "-dev: checkout executable missing: $target\" >&2")
              "  exit 127"
              "fi"
              (s "echo \"" name "-dev: provenance=checkout path=$target\" >&2")
              (s "export NORTH_MANAGED_CODEX_BIN='" codexPkg "/bin/codex'")
              "exec /run/current-system/sw/bin/north-coord-runtime exec-checkout \"$target\" \"$@\"")}))
     northDev (mkDev "north")
     northMcpDev (mkDev "north-mcp")
     northPackaged
      (pkgs.writeShellApplication
        {:name "north-packaged"
         :text
          (ms clientEnvironment
              "unset NORTH_CHECKOUT"
              (s northRuntimeOwnerGuard "/bin/north-runtime-owner-guard \"$@\"")
              (s "exec " northPkg "/bin/north \"$@\""))})
     northMcpPackaged
      (pkgs.writeShellApplication
        {:name "north-mcp-packaged"
         :text
          (ms clientEnvironment
              "unset NORTH_CHECKOUT"
              (s "exec " northPkg "/bin/north-mcp \"$@\""))})]
    {:tags [cli-tools]
     :flake-inputs
      {:north {:url "git+file:///home/tom/code/north/main?ref=main"
               :inputs.fram.follows "fram"
               :inputs.nixpkgs-master.follows "nixpkgs-master"}}
     :options.myConfig.modules.north.enable
      (lib.mkEnableOption
        "immutable North CLI/MCP with explicit checkout-only development commands")
     :config
      (lib.mkIf config.myConfig.modules.north.enable
        {:environment.systemPackages
          (++ [northProduction northMcpProduction northDev northMcpDev
               northPackaged northMcpPackaged]
              pinnedCommands)})}))
