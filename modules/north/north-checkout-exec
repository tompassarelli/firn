#!/usr/bin/env bash
# Second stage of checkout execution.
#
# north-env (inputs.north.packages.<sys>.north-env) owns the RUNTIME contract —
# engine root, Fram classpath, bb/bun/git/python selectors, managed codex bin —
# and ends by exec'ing whatever NORTH_BIN names. It cannot know the two facts
# that make this a checkout run, because it is built from the pinned package:
#   * the application code is a live checkout, not the nix-store package;
#   * WHICH checkout executable was asked for (north vs north-mcp).
# So the wrapper points NORTH_BIN here, and this stage restores both before the
# final exec. Duplicating north-env's variables in the Firn module instead would
# reintroduce exactly the drift north-env exists to prevent.
set -euo pipefail

checkout=${NORTH_CHECKOUT:?north-checkout-exec: NORTH_CHECKOUT is unset}
target=${NORTH_CHECKOUT_TARGET:?north-checkout-exec: NORTH_CHECKOUT_TARGET is unset}
unset NORTH_CHECKOUT_TARGET

export NORTH_HOME="$checkout"
# NORTH_BIN names the North CLI, never the process being executed: an MCP server
# started through this stage must still be able to shell out to `north`.
export NORTH_BIN="$checkout/bin/north"

# Provenance, so `north doctor` shows what actually ran. Deliberately NOT the
# packaged rev north-env exported: describe --dirty is the honest identity of a
# mutable tree, and `unknown` is honest when the tree cannot answer.
export NORTH_PACKAGE_MODE=checkout

# The split, named. north-env pins FRAM_HOME/FRAM_BIN at the packaged engine, and
# a checkout-launched `north up` refuses an inherited /nix/store Fram until the
# caller says it meant it (bin/north-coord-up). Checkout code on a packaged
# engine IS the two-speed configuration, so declare it here rather than leaving
# every run to trip coord-safety. A developer wanting a checkout engine too
# overrides this together with FRAM_HOME.
export NORTH_FRAM_RUNTIME="${NORTH_FRAM_RUNTIME:-package}"
NORTH_PACKAGE_REV=$("${NORTH_GIT_BIN:-git}" -C "$checkout" describe --always --dirty 2>/dev/null || echo unknown)
export NORTH_PACKAGE_REV

exec "$target" "$@"
