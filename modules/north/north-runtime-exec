#!/usr/bin/env bash
# north-runtime-exec [--chdir] [--interp PATH] FALLBACK_ROOT REL_PATH [ARGS...]
#
# Runs REL_PATH out of the promoted runtime channel
# (~/.local/state/north/runtime/current, moved by `north-runtime promote`) so
# adopting north code costs a promote, not a generation. FALLBACK_ROOT is the
# generation-pinned package and is load-bearing only before the first promote.
set -euo pipefail

chdir=0
interp=""
while true; do
  case "${1:-}" in
    --chdir) chdir=1; shift ;;
    --interp) interp=${2:?north-runtime-exec: --interp needs a path}; shift 2 ;;
    *) break ;;
  esac
done

fallback=${1:?north-runtime-exec: fallback root required}
rel=${2:?north-runtime-exec: relative path required}
shift 2

promoted="$HOME/.local/state/north/runtime/current"

# -e follows the symlink, so a dangling `current` falls back instead of failing.
if [ -e "$promoted/$rel" ]; then
  root=$promoted
  provenance=promoted
else
  root=$fallback
  provenance=packaged
fi

# Which tree served the unit is the first question a promoted-fix-did-not-take
# report has to answer.
printf 'north-runtime-exec: provenance=%s root=%s resolved=%s target=%s\n' \
  "$provenance" "$root" "$(readlink -f "$root")" "$rel" >&2

if [ "$chdir" = 1 ]; then
  cd "$root"
fi

if [ -n "$interp" ]; then
  exec "$interp" "$root/$rel" "$@"
fi
exec "$root/$rel" "$@"
