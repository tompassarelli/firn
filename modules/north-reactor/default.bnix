#lang beagle/nix

(ns default)

;; The user-level timer fires `north-reactor.clj sweep-once` every ~5min.
;; Each one-shot owns liveness cleanup and rebuild-window coalescing, then exits.
;;
;; Resolve code through north-runtime-exec so reactor fixes can be promoted without
;; first requiring the rebuild they queue. The flake package is the fallback.
;;
;; PATH supplies the interpreter and the reactor's runtime subprocesses. The sweep
;; runs as the user and is only a :7977 client.
(nix/module [config lib pkgs inputs ...]
  (let [username config.myConfig.modules.users.username
        northPkg (get (get inputs.north.packages pkgs.stdenv.hostPlatform.system) :default)
        ;; The modules/north script is the single definition of runtime
        ;; resolution; both hot-loop modules launch through it rather than
        ;; restating the promoted-channel path.
        northRuntimeExec
         (pkgs.writeShellApplication
           {:name "north-runtime-exec"
            :runtimeInputs (nix/with pkgs [coreutils])
            :text (builtins.readFile (p "../north/north-runtime-exec"))})]
    {:options.myConfig.modules.north-reactor.enable
      (lib.mkEnableOption "North reactor periodic liveness and rebuild-window sweep")
     :config
      (lib.mkIf config.myConfig.modules.north-reactor.enable
        {:home-manager.users
          {username
            (nix/module [config ...]
              {:systemd.user.services.north-reactor-sweep
                {:Unit
                  {:Description "North reactor sweep — reap stale concerns + silently-dead lanes"
                   ;; keep-old IS the HM mechanism for "don't restart me at
                   ;; switch" — restartIfChanged is a NixOS system-service
                   ;; option and fails HM's unit-section typecheck.
                   :X-SwitchMethod "keep-old"}
                 :Service
                  {:Type             "oneshot"
                   :Environment      [(s "PATH=" pkgs.systemd "/bin:" pkgs.babashka "/bin:" pkgs.coreutils "/bin:" pkgs.git "/bin")]
                   ;; --chdir replaces a static WorkingDirectory: bb resolves the
                   ;; script's deps against the tree it was loaded from, so cwd
                   ;; has to track whichever root won.
                   :ExecStart        (s northRuntimeExec "/bin/north-runtime-exec --chdir --interp " pkgs.babashka "/bin/bb " northPkg " cli/north-reactor.clj sweep-once")}}
               :systemd.user.timers.north-reactor-sweep
                {:Unit
                  {:Description "Run the north reactor liveness sweep periodically"}
                 :Timer
                  {:OnStartupSec    "3m"
                   :OnUnitInactiveSec "5m"
                   :Persistent      true}
                 :Install {:WantedBy ["timers.target"]}}})}})}))
