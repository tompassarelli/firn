#lang beagle/nix

(ns default)

;; North reactor SWEEP timer — the liveness reaper that was RUNNING NEVER. Nothing
;; ever started it, so stale `building` concerns and silently-dead lanes accumulated
;; unswept (same failure class as north-web's 11-day unsupervised death). A user-level
;; timer (mirror north-stream-sync) fires `north-reactor.clj sweep-once` every ~5min:
;; one-shot, exits each run — no port, no linger, no daemon to supervise.
;;
;; SCOPE = the sweep ONLY. The reactor's long-lived loop mode (-main) ALSO runs
;; feed-triggered thread-md reprojection (subscribe the :7977 commit firehose ->
;; debounce -> `north heal`); it does NOT handle @cmd or any other verb. That
;; reprojection is a SEPARATE concern from reaping and is deliberately NOT daemonized
;; here — the sweep is idempotent and writes its verdicts through :7977
;; (coord append!/put!), so a periodic one-shot fully covers the reap responsibility.
;;
;; PATH carries babashka so both the ExecStart `bb` and the reactor's own
;; ping-coordinator shell-out (bare `bb msg-cli.clj` when a reaped lane names a
;; coordinator) resolve. Runs as the user: the sweep is a :7977 client, needs no root.
(nix/module [config lib pkgs ...]
  (let [username config.myConfig.modules.users.username
        codeDir  config.myConfig.modules.users.codeDir]
    {:options.myConfig.modules.north-reactor.enable
      (lib.mkEnableOption "North reactor sweep timer — periodic liveness reap of stale concerns + silently-dead lanes")
     :config
      (lib.mkIf config.myConfig.modules.north-reactor.enable
        {:home-manager.users
          {username
            (nix/module [config ...]
              {:systemd.user.services.north-reactor-sweep
                {:Unit
                  {:Description "North reactor sweep — reap stale concerns + silently-dead lanes"}
                 :Service
                  {:Type             "oneshot"
                   :Environment      [(s "PATH=" pkgs.babashka "/bin:" pkgs.coreutils "/bin")]
                   :WorkingDirectory (s codeDir "/north")
                   :ExecStart        (s pkgs.babashka "/bin/bb " codeDir "/north/cli/north-reactor.clj sweep-once")}}
               :systemd.user.timers.north-reactor-sweep
                {:Unit
                  {:Description "Run the north reactor liveness sweep periodically"}
                 :Timer
                  {:OnStartupSec    "3m"
                   :OnUnitActiveSec "5m"
                   :Persistent      true}
                 :Install {:WantedBy ["timers.target"]}}})}})}))
