#lang beagle/nix

(ns default)

;; North reactor SWEEP timer — the liveness reaper that was RUNNING NEVER. Nothing
;; ever started it, so stale `building` concerns and silently-dead lanes accumulated
;; unswept (same failure class as an unsupervised service's death). A user-level
;; timer (mirror north-stream-sync) fires `north-reactor.clj sweep-once` every ~5min:
;; one-shot, exits each run — no port, no linger, no daemon to supervise.
;;
;; The reactor's long-lived loop mode (-main) is the SECOND unit here: it subscribes
;; the :7977 commit firehose and reprojects touched threads (`north heal`, debounced).
;; It was started by hand under nohup and died twice on 2026-07-30; it now owns the
;; rebuild QUEUE window, so an unsupervised death parks every agent's rebuild ask
;; silently. Restart=always is the whole point of the unit.
;;
;; The loop runs the LIVE checkout through the packaged `north` wrapper, not the store
;; copy: its heal must be byte-identical to the `north heal` a human runs (north.clj
;; derives its north-bin from its own repo root). Both entry points call sweep!; the
;; fixed systemd-run unit name is the double-fire mutex on the rebuild window.
;;
;; Both entry points resolve their code through north-runtime-exec: this unit is also
;; the rebuild-window owner, so leaving it on the flake input made every north fix cost
;; the rebuild it was queueing. The flake package stays the pre-first-promote fallback.
;;
;; PATH carries babashka
;; so both the ExecStart `bb`, the reactor's worktree provenance `git` probes, and the reactor's own
;; ping-coordinator shell-out (bare `bb msg-cli.clj` when a reaped lane names a
;; coordinator) resolve. Runs as the user: the sweep is a :7977 client, needs no root.
(nix/module [config lib pkgs inputs ...]
  (let [username config.myConfig.modules.users.username
        northPkg (get (get inputs.north.packages pkgs.stdenv.hostPlatform.system) :default)
        ;; The modules/north script is the single definition of runtime
        ;; resolution; both hot-loop modules launch through it rather than
        ;; restating the promoted-channel path.
        northRuntimeExec
         (pkgs.writeShellApplication
           {:name "north-runtime-exec"
            :runtimeInputs (nix/with pkgs [coreutils])
            :text (builtins.readFile (p "../north/north-runtime-exec"))})]
    {:options.myConfig.modules.north-reactor.enable
      (lib.mkEnableOption "North reactor — supervised reprojection/window-owner loop plus the periodic liveness sweep")
     :config
      (lib.mkIf config.myConfig.modules.north-reactor.enable
        {:home-manager.users
          {username
            (nix/module [config ...]
              {:systemd.user.services.north-reactor
                {:Unit
                  {:Description "North reactor — thread reprojection, liveness sweep, rebuild-window owner"
                   :After ["network.target"]
                   ;; A crash loop must degrade into retrying, never into a
                   ;; permanently disabled window owner.
                   :StartLimitIntervalSec 0}
                 :Service
                  {:Type       "simple"
                   ;; systemd-run launches the rebuild window out of this cgroup;
                   ;; git + coreutils serve the worktree-provenance probes.
                   :Environment [(s "PATH=" pkgs.systemd "/bin:" pkgs.git "/bin:" pkgs.coreutils "/bin")]
                   :WorkingDirectory (s config.home.homeDirectory "/code/north/main")
                   :ExecStart  (s northRuntimeExec "/bin/north-runtime-exec " northPkg " bin/north reactor 7977")
                   :Restart    "always"
                   :RestartSec 5}
                 :Install {:WantedBy ["default.target"]}}
               :systemd.user.services.north-reactor-sweep
                {:Unit
                  {:Description "North reactor sweep — reap stale concerns + silently-dead lanes"
                   ;; keep-old IS the HM mechanism for "don't restart me at
                   ;; switch" — restartIfChanged is a NixOS system-service
                   ;; option and fails HM's unit-section typecheck.
                   :X-SwitchMethod "keep-old"}
                 :Service
                  {:Type             "oneshot"
                   :Environment      [(s "PATH=" pkgs.systemd "/bin:" pkgs.babashka "/bin:" pkgs.coreutils "/bin:" pkgs.git "/bin")]
                   ;; --chdir replaces a static WorkingDirectory: bb resolves the
                   ;; script's deps against the tree it was loaded from, so cwd
                   ;; has to track whichever root won.
                   :ExecStart        (s northRuntimeExec "/bin/north-runtime-exec --chdir --interp " pkgs.babashka "/bin/bb " northPkg " cli/north-reactor.clj sweep-once")}}
               :systemd.user.timers.north-reactor-sweep
                {:Unit
                  {:Description "Run the north reactor liveness sweep periodically"}
                 :Timer
                  {:OnStartupSec    "3m"
                   :OnUnitInactiveSec "5m"
                   :Persistent      true}
                 :Install {:WantedBy ["timers.target"]}}})}})}))
