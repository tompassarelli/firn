#!/usr/bin/env bash

set -u

state_dir=${NORTH_WATCHDOG_STATE_DIR:-/var/lib/north-watchdog}
route_map=${NORTH_WATCHDOG_ROUTE_MAP:-/var/lib/north-coord-cutover/route.map}
log_file=${NORTH_WATCHDOG_LOG_FILE:-$state_dir/probe.log}
proc_root=${NORTH_WATCHDOG_PROC_ROOT:-/proc}
cooldown_seconds=${NORTH_WATCHDOG_COOLDOWN_SECONDS:-600}
max_log_bytes=${NORTH_WATCHDOG_MAX_LOG_BYTES:-52428800}

date_bin=${NORTH_WATCHDOG_DATE:-date}
nc_bin=${NORTH_WATCHDOG_NC:-nc}
stat_bin=${NORTH_WATCHDOG_STAT:-stat}
systemctl_bin=${NORTH_WATCHDOG_SYSTEMCTL:-systemctl}
timeout_bin=${NORTH_WATCHDOG_TIMEOUT:-timeout}

request='{:op :for-log :expected-log "/home/tom/.local/state/north/coordination.log" :request {:op :version-free}}'

mkdir -p -- "$state_dir" "${log_file%/*}"
touch "$log_file"

log_size=$($stat_bin -c %s "$log_file" 2>/dev/null || printf '0\n')
if [[ $log_size =~ ^[0-9]+$ ]] && ((log_size >= max_log_bytes)); then
  : >"$log_file"
fi

read -r route_key slot route_extra <"$route_map" 2>/dev/null || exit 0
[[ $route_key == active && -z ${route_extra:-} ]] || exit 0

case $slot in
  blue)
    port=17977
    unit=north-coord-blue.service
    ;;
  green)
    port=27977
    unit=north-coord-green.service
    ;;
  *) exit 0 ;;
esac

rss_kb=0
pid=$($systemctl_bin show --property=MainPID --value "$unit" 2>/dev/null || printf '0\n')
if [[ $pid =~ ^[1-9][0-9]*$ && -r $proc_root/$pid/status ]]; then
  rss_kb=$(awk '$1 == "VmRSS:" { print $2; exit }' "$proc_root/$pid/status")
  [[ $rss_kb =~ ^[0-9]+$ ]] || rss_kb=0
fi

started_ms=$($date_bin +%s%3N)
if response=$(printf '%s\n' "$request" | \
    "$timeout_bin" 3s "$nc_bin" -N 127.0.0.1 "$port" 2>/dev/null) && \
    [[ -n $response ]]; then
  result=ok
else
  result=fail
fi
ended_ms=$($date_bin +%s%3N)
latency_ms=$((ended_ms - started_ms))
((latency_ms >= 0)) || latency_ms=0
now=$($date_bin +%s)

printf '%s %s %s %s %s\n' "$now" "$slot" "$latency_ms" "$result" "$rss_kb" \
  >>"$log_file"

[[ $result == fail ]] || exit 0

consecutive_failures=$(awk -v slot="$slot" '
  $1 == "RESTART" { failures = 0; next }
  NF == 5 {
    if ($2 == slot && $4 == "fail") failures++
    else failures = 0
  }
  END { print failures + 0 }
' "$log_file")
((consecutive_failures >= 3)) || exit 0

last_restart=$(awk '$1 == "RESTART" && $2 ~ /^[0-9]+$/ { last = $2 } END { print last + 0 }' \
  "$log_file")
((now - last_restart >= cooldown_seconds)) || exit 0

if "$systemctl_bin" restart "$unit"; then
  restart_result=ok
else
  restart_result=fail
fi
printf 'RESTART %s %s three_consecutive_failures %s\n' \
  "$now" "$slot" "$restart_result" >>"$log_file"
