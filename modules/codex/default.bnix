#lang beagle/nix

(ns default)

(nix/module
  [config
   lib
   pkgs
   flakeRoot
   ...]
  (let [username config.myConfig.modules.users.username
        homeDir config.myConfig.modules.users.homeDir
        agentGeneration (s homeDir "/.local/state/north/agents/current")
        providerAdapter (fn [adapterId String] String
          (s "L+ /etc/codex/hooks/" adapterId " - - - - "
            agentGeneration "/provider-hooks/" adapterId))]
    {:options.myConfig.modules.codex.enable
      (lib.mkEnableOption "OpenAI Codex CLI (exact North managed runtime)")
     :config
      (lib.mkIf config.myConfig.modules.codex.enable
        {:environment.etc
          {"codex/requirements.toml"
            {:source (s flakeRoot "/modules/codex/requirements.toml")}
           "codex/hooks/runtime/bash"
            {:source (s pkgs.bash "/bin/bash")}
           "codex/hooks/runtime/cat"
            {:source (s pkgs.coreutils "/bin/cat")}
           "codex/hooks/runtime/env"
            {:source (s pkgs.coreutils "/bin/env")}
           "codex/hooks/runtime/git"
            {:source (s pkgs.git "/bin/git")}
           "codex/hooks/runtime/mktemp"
            {:source (s pkgs.coreutils "/bin/mktemp")}
           "codex/hooks/runtime/python3"
            {:source (s pkgs.python3 "/bin/python3")}
           "codex/hooks/runtime/rm"
            {:source (s pkgs.coreutils "/bin/rm")}
           "codex/hooks/runtime/timeout"
            {:source (s pkgs.coreutils "/bin/timeout")}
           }
         ;; Other North enforcement hooks occupy this shared directory.
         ;; Firn owns only these individual runtime and provider adapter paths.
         :systemd.tmpfiles.rules
          ["d /etc/codex/hooks/lib 0755 root root -"
           (providerAdapter "lib/north-agent-activation.sh")
           (providerAdapter "firn-system-policy")
           (providerAdapter "concrete-model-identity-guard.sh")
           (providerAdapter "launch-critical-worktree-guard.sh")
           (providerAdapter "lib/launch_critical_decide.py")
           (providerAdapter "lib/launch_critical_paths.py")
           (providerAdapter "tripwire-guard.sh")
           (providerAdapter "corpus-scan-guard.sh")
           (providerAdapter "resource-safe-search-guard.sh")
           (providerAdapter "modern-search-guard.sh")
           (providerAdapter "session-kill-guard.sh")
           (providerAdapter "lib/authoring-killswitch.sh")
           (providerAdapter "codex-behavior-guard.sh")
           (providerAdapter "lib/codex_behavior.py")]
         :home-manager.users
          {username
            (nix/module
              [config
               ...]
              {:home.file
                {;; North renders instructions and skills into one immutable
                 ;; activation generation; Firn owns only these stable provider
                 ;; discovery pointers.
                 ".codex/AGENTS.md"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/.local/state/north/agents/current/instructions/codex/AGENTS.md"))}
                 ".codex/config.toml"
                  {:source (s flakeRoot "/dotfiles/codex/config.toml")}
                 ".codex/prompts"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/nixos-config/dotfiles/codex/prompts"))}}
               ;; A locked default secret collection stops Codex before a
               ;; session starts: it waits on an unlock prompt that a session
               ;; without a graphical prompter never answers. PAM unlocks only
               ;; `login`, and a keyring restart relocks everything, so select
               ;; an already-unlocked collection on every login. The secrets
               ;; service is D-Bus activated and publishes collections lazily,
               ;; so the command owns that wait rather than unit ordering.
               :systemd.user.services.codex-keyring-default
                {:Unit
                  {:Description
                    "Select an unlocked secret collection as the Secret Service default"
                   :After ["dbus.service"]}
                 :Service
                  {:Type "oneshot"
                   :RemainAfterExit true
                   :Environment
                    [(s "PATH=" pkgs.bash "/bin:" pkgs.systemd "/bin:"
                       pkgs.coreutils "/bin:" pkgs.gnugrep "/bin")]
                   :ExecStart (s homeDir "/.local/bin/codex-keyring-default")}
                 :Install {:WantedBy ["default.target"]}}})}})}))
