#lang beagle/nix

(ns default)

(nix/module
  [config
   lib
   pkgs
   flakeRoot
   ...]
  (let [username config.myConfig.modules.users.username
        homeDir config.myConfig.modules.users.homeDir
        agentGeneration (s homeDir "/.local/state/north/agents/current")
        codexHooks (pkgs.linkFarm
         "codex-hooks"
         [{:name "requirements.toml"
           :path "${flakeRoot}/modules/codex/requirements.toml"}
          {:name "runtime/bash" :path "${pkgs.bash}/bin/bash"}
          {:name "runtime/cat" :path "${pkgs.coreutils}/bin/cat"}
          {:name "runtime/env" :path "${pkgs.coreutils}/bin/env"}
          {:name "runtime/git" :path "${pkgs.git}/bin/git"}
          {:name "runtime/mktemp" :path "${pkgs.coreutils}/bin/mktemp"}
          {:name "runtime/python3" :path "${pkgs.python3}/bin/python3"}
          {:name "runtime/rm" :path "${pkgs.coreutils}/bin/rm"}
          {:name "runtime/timeout" :path "${pkgs.coreutils}/bin/timeout"}
          {:name "lib/north-agent-activation.sh"
           :path (s agentGeneration "/provider-hooks/lib/north-agent-activation.sh")}
          {:name "beagle-session-start.sh"
           :path (s agentGeneration "/provider-hooks/beagle-session-start.sh")}
          {:name "firn-system-policy"
           :path (s agentGeneration "/provider-hooks/firn-system-policy")}
          {:name "concrete-model-identity-guard.sh"
           :path (s agentGeneration "/provider-hooks/concrete-model-identity-guard.sh")}
          {:name "launch-critical-worktree-guard.sh"
           :path (s agentGeneration "/provider-hooks/launch-critical-worktree-guard.sh")}
          {:name "lib/launch_critical_decide.py"
           :path (s agentGeneration "/provider-hooks/lib/launch_critical_decide.py")}
          {:name "lib/launch_critical_paths.py"
           :path (s agentGeneration "/provider-hooks/lib/launch_critical_paths.py")}
          {:name "tripwire-guard.sh"
           :path (s agentGeneration "/provider-hooks/tripwire-guard.sh")}
          {:name "corpus-scan-guard.sh"
           :path (s agentGeneration "/provider-hooks/corpus-scan-guard.sh")}
          {:name "resource-safe-search-guard.sh"
           :path (s agentGeneration "/provider-hooks/resource-safe-search-guard.sh")}
          {:name "session-kill-guard.sh"
           :path (s agentGeneration "/provider-hooks/session-kill-guard.sh")}
          {:name "lib/authoring-killswitch.sh"
           :path (s agentGeneration "/provider-hooks/lib/authoring-killswitch.sh")}])]
    {:options.myConfig.modules.codex.enable
      (lib.mkEnableOption "OpenAI Codex CLI (exact North managed runtime)")
     :config
      (lib.mkIf config.myConfig.modules.codex.enable
        {:environment.etc
          {"codex/requirements.toml"
            {:source (s flakeRoot "/modules/codex/requirements.toml")}
           }
         :systemd.tmpfiles.rules
       [(s "L+ /etc/codex/hooks - - - - " codexHooks)
        ]
         :home-manager.users
          {username
            (nix/module
              [config
               ...]
              {:home.file
                {;; North renders instructions and skills into one immutable
                 ;; activation generation; Firn owns only these stable provider
                 ;; discovery pointers.
                 ".codex/AGENTS.md"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/.local/state/north/agents/current/instructions/codex/AGENTS.md"))}
                 ".codex/config.toml"
                  {:source (s flakeRoot "/dotfiles/codex/config.toml")}
                 ".codex/prompts"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/nixos-config/dotfiles/codex/prompts"))}}})}})}))
