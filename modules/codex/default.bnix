#lang beagle/nix

(ns default)

(nix/module
  [config
   lib
   pkgs
   flakeRoot
   ...]
  (let [username config.myConfig.modules.users.username
        homeDir config.myConfig.modules.users.homeDir
        ;; North's hook surface is delivered by its live checkout, so /etc points
        ;; at the checkout instead of building the whole project.
        northPkg (s homeDir "/code/north/main")
        ;; Codex is the upstream nixpkgs-master package, taken here rather than
        ;; re-exported by a project flake: no project flake may sit in the
        ;; system closure's eval graph. Identity is pinned so a master bump
        ;; cannot silently move the managed runtime out from under the hook
        ;; contract — drift fails the build with both identities named.
        codexExpectedIdentity
         {:version "0.146.0"
          :owner "openai"
          :repo "codex"
          :rev "refs/tags/rust-v0.146.0"
          :tag "rust-v0.146.0"
          :srcHash "sha256-/kTIOX/klxm1nq2bJsBqS8f1jZZp2ilaTeULQFPJgDk="
          :cargoHash "sha256-N9jbH/cgAyu2QxneSnpkdaF0MgV3ZtDmN9q6rr9u+hE="}
        codexUpstreamPkg pkgs.master.codex
        codexObservedIdentity
         {:version (get-or codexUpstreamPkg version nil)
          :owner (get-or codexUpstreamPkg src.owner nil)
          :repo (get-or codexUpstreamPkg src.repo nil)
          :rev (get-or codexUpstreamPkg src.rev nil)
          :tag (get-or codexUpstreamPkg src.tag nil)
          :srcHash (get-or codexUpstreamPkg src.outputHash nil)
          :cargoHash (get-or codexUpstreamPkg cargoHash nil)}
        codexPkg
         (lib.throwIfNot
           (== codexObservedIdentity codexExpectedIdentity)
           (s "codex: managed runtime identity drifted; expected "
             (builtins.toJSON codexExpectedIdentity)
             "; observed "
             (builtins.toJSON codexObservedIdentity))
           codexUpstreamPkg)
        ;; Codex trusts a managed hook by the provenance of requirements.toml,
        ;; never by the hook file's own residency — so North/Beagle enforcement
        ;; can move at promote speed behind a stable /etc name.
        enforcement "/var/lib/north-enforcement/active/current"
        promoted
         (fn [(relative String) (source String)] String
           (s "L+ /etc/codex/hooks/" relative " - - - - " enforcement "/" source))]
    {:options.myConfig.modules.codex.enable
      (lib.mkEnableOption "OpenAI Codex CLI (exact North managed runtime)")
     :config
      (lib.mkIf config.myConfig.modules.codex.enable
        {:environment.systemPackages [codexPkg]
         :environment.etc
          {"codex/requirements.toml"
            {:source (s flakeRoot "/modules/codex/requirements.toml")}
           "codex/runtime"
            {:source codexPkg}
           "codex/hooks/north-on-spawn-codex"
            {:source (s flakeRoot "/dotfiles/codex/hooks/north-on-spawn-codex")}
           "codex/hooks/north-on-tooluse-codex"
            {:source (s flakeRoot "/dotfiles/codex/hooks/north-on-tooluse-codex")}
           "codex/hooks/north-mark-delegated-codex"
            {:source (s flakeRoot "/dotfiles/codex/hooks/north-mark-delegated-codex")}
           "codex/hooks/north-on-stop-codex"
            {:source (s flakeRoot "/dotfiles/codex/hooks/north-on-stop-codex")}
           "codex/hooks/north-on-terminal-codex"
            {:source (s flakeRoot "/dotfiles/codex/hooks/north-on-terminal-codex")}
           "codex/hooks/north-clock-guard-codex"
            {:source (s flakeRoot "/dotfiles/codex/hooks/north-clock-guard-codex")}
           "codex/hooks/lib/switchboard-activity.sh"
            {:source (s flakeRoot "/dotfiles/agents/lib/switchboard-activity.sh")}
           "codex/hooks/runtime/bash"
            {:source (s pkgs.bash "/bin/bash")}
           "codex/hooks/runtime/cat"
            {:source (s pkgs.coreutils "/bin/cat")}
           "codex/hooks/runtime/env"
            {:source (s pkgs.coreutils "/bin/env")}
           "codex/hooks/runtime/git"
            {:source (s pkgs.git "/bin/git")}
           "codex/hooks/runtime/mktemp"
            {:source (s pkgs.coreutils "/bin/mktemp")}
           "codex/hooks/runtime/node"
            {:source (s pkgs.nodejs "/bin/node")}
           "codex/hooks/runtime/python3"
            {:source (s pkgs.python3 "/bin/python3")}
           "codex/hooks/runtime/rm"
            {:source (s pkgs.coreutils "/bin/rm")}
           "codex/hooks/runtime/timeout"
            {:source (s pkgs.coreutils "/bin/timeout")}
           "codex/hooks/north"
            {:source northPkg}}
         :systemd.tmpfiles.rules
          ["d /var/lib/north-enforcement 0755 root root -"
           "d /etc/codex/hooks/lib 0755 root root -"
           (promoted "agent-spawn-guard.sh" "north/profiles/tom/hooks/agent-spawn-guard.sh")
           (promoted "launch-critical-worktree-guard.sh" "north/profiles/tom/hooks/launch-critical-worktree-guard.sh")
           (promoted "lib/launch_critical_decide.py" "north/profiles/tom/hooks/lib/launch_critical_decide.py")
           (promoted "lib/launch_critical_paths.py" "north/profiles/tom/hooks/lib/launch_critical_paths.py")
           (promoted "tripwire-guard.sh" "north/profiles/tom/hooks/tripwire-guard.sh")
           (promoted "corpus-scan-guard.sh" "north/profiles/tom/hooks/corpus-scan-guard.sh")
           (promoted "session-kill-guard.sh" "north/profiles/tom/hooks/session-kill-guard.sh")
           (promoted "logcompress-hook.js" "north/profiles/tom/hooks/logcompress-hook.js")
           (promoted "logcompress.js" "north/profiles/tom/hooks/logcompress.js")
           (promoted "registry.tsv" "north/profiles/tom/hooks/registry.tsv")
           (promoted "lib/authoring-killswitch.sh" "north/profiles/tom/hooks/lib/authoring-killswitch.sh")
           (promoted "lib/harness-dial.sh" "north/profiles/tom/hooks/lib/harness-dial.sh")
           (promoted "beagle-session-start.sh" "beagle/integrations/north/hooks/beagle-session-start.sh")]
         :home-manager.users
          {username
            (nix/module
              [config
               ...]
              {:home.file
                {;; Switchboard-owned, exactly like ~/.claude/CLAUDE.md and
                 ;; ~/.agents/AGENTS.md: `agents apply` is the sole writer under
                 ;; ~/.config/agents, so every provider sees the same set
                 ;; composition.
                 ".codex/AGENTS.md"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/.config/agents/AGENTS.md"))}
                 ".codex/config.toml"
                  {:source (s flakeRoot "/dotfiles/codex/config.toml")}
                 ".codex/prompts"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/nixos-config/dotfiles/claude/commands"))}}})}})}))
