use firn/tags

codex is a Module

nix module
  arguments: config, lib, pkgs, flakeRoot, ...
  let username = config.myConfig.modules.users.username
  let homeDir = config.myConfig.modules.users.homeDir
  let codexConfigFile = config.myConfig.modules.codex.configFile
  let agentGeneration = "{homeDir}/.local/state/north/agents/current"
  let providerAdapter = (adapterId) => "L+ /etc/codex/hooks/{adapterId} - - - - {agentGeneration}/provider-hooks/{adapterId}"
  option myConfig.modules.codex.enable: enable "OpenAI Codex CLI (exact North managed runtime)"
  option myConfig.modules.codex.configFile: Path
    default: builtins.path({path: "{flakeRoot}/dotfiles/codex/config.toml", name: "config.toml"})
    description: "Codex config.toml linked at ~/.codex/config.toml"
  config when config.myConfig.modules.codex.enable
    environment.etc
      "codex/requirements.toml".source: builtins.path({path: "{flakeRoot}/modules/codex/requirements.toml", name: "requirements.toml"})
      "codex/hooks/runtime/bash"
        source: "{pkgs.bash}/bin/bash"
      "codex/hooks/runtime/cat"
        source: "{pkgs.coreutils}/bin/cat"
      "codex/hooks/runtime/env"
        source: "{pkgs.coreutils}/bin/env"
      "codex/hooks/runtime/git"
        source: "{pkgs.git}/bin/git"
      "codex/hooks/runtime/mktemp"
        source: "{pkgs.coreutils}/bin/mktemp"
      "codex/hooks/runtime/python3"
        source: "{pkgs.python3}/bin/python3"
      "codex/hooks/runtime/rm"
        source: "{pkgs.coreutils}/bin/rm"
      "codex/hooks/runtime/timeout"
        source: "{pkgs.coreutils}/bin/timeout"
    # Other North enforcement hooks occupy this shared directory.
    # Firn owns only these individual runtime and provider adapter paths.
    systemd.tmpfiles.rules: ["d /etc/codex/hooks/lib 0755 root root -", providerAdapter("lib/north-agent-activation.sh"), providerAdapter("firn-system-policy"), providerAdapter("concrete-model-identity-guard.sh"), providerAdapter("launch-critical-worktree-guard.sh"), providerAdapter("lib/launch_critical_decide.py"), providerAdapter("lib/launch_critical_paths.py"), providerAdapter("tripwire-guard.sh"), providerAdapter("corpus-scan-guard.sh"), providerAdapter("git-stash-guard.sh"), providerAdapter("native-item-guard.sh"), providerAdapter("clipboard-guard.sh"), providerAdapter("generated-policy-guard.sh"), providerAdapter("git-blind-stage-guard.sh"), providerAdapter("heavy-command-guard.sh"), providerAdapter("resource-safe-search-guard.sh"), providerAdapter("modern-search-guard.sh"), providerAdapter("session-kill-guard.sh"), providerAdapter("lib/authoring-killswitch.sh"), providerAdapter("chat-post.sh"), providerAdapter("lib/chat_post.py"), providerAdapter("codex-behavior-guard.sh"), providerAdapter("lib/codex_behavior.py"), providerAdapter("lib/spawn_capacity.py"), providerAdapter("lib/shellcmd.py"), providerAdapter("lib/defaults.toml")]
    # activation generation; Firn owns only these stable provider
    # discovery pointers.
    # A locked default secret collection stops Codex before a
    # session starts: it waits on an unlock prompt that a session
    # without a graphical prompter never answers. PAM unlocks only
    # `login`, and a keyring restart relocks everything, so select
    # an already-unlocked collection on every login. The secrets
    # service is D-Bus activated and publishes collections lazily,
    # so the command owns that wait rather than unit ordering.
    home-manager.users.{username}: ({config, ...}) => {home.file: {".codex/AGENTS.md".source: config.lib.file.mkOutOfStoreSymlink("{config.home.homeDirectory}/.local/state/north/agents/current/instructions/codex/AGENTS.md"), ".codex/config.toml".source: codexConfigFile, ".codex/prompts".source: config.lib.file.mkOutOfStoreSymlink("{config.home.homeDirectory}/code/north/main/harness/codex/prompts")}, systemd.user.services.codex-keyring-default: {Unit: {Description: "Select an unlocked secret collection as the Secret Service default", After: ["dbus.service"]}, Service: {Type: "oneshot", RemainAfterExit: true, Environment: ["PATH={pkgs.bash}/bin:{pkgs.systemd}/bin:{pkgs.coreutils}/bin:{pkgs.gnugrep}/bin"], ExecStart: "{homeDir}/.local/share/north/bin/codex-keyring-default"}, Install: {WantedBy: ["default.target"]}}}
