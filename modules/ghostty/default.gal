use firn/tags

ghostty is a Module
ghostty is tagged terminal

nix module
  arguments: config, lib, pkgs, ...
  config when config.myConfig.modules.ghostty.enable
    "home-manager"
      "users"
        {config.myConfig.modules.users.username}
          "programs"
            "ghostty"
              "enable": true
              "package": if pkgs.stdenv.hostPlatform.isDarwin then builtins.`null` else pkgs.unstable.ghostty
              "settings"
                "app-notifications": "no-clipboard-copy"
                "async-backend": "epoll"
                "command": "/run/current-system/sw/bin/bash"
                "keybind": ["ctrl+z=text:\\x1f"]
                "window-padding-x": 6
                "window-padding-y": 4
                "working-directory": "home"
  option "myConfig"."modules"."ghostty"."enable": enable "Ghostty terminal"
