use firn/tags

kitty is a Module
kitty can opt into terminal

nix module
  arguments: config, lib, ...
  config when config.myConfig.modules.kitty.enable
    "home-manager"
      "users"
        {config.myConfig.modules.users.username}
          "programs"
            "kitty"
              "enable": true
              "settings"
                "tab_bar_edge": "top"
                "tab_bar_style": "powerline"
                "window_padding_width": "2 0 0 3"
  option "myConfig"."modules"."kitty"."enable": enable "Kitty terminal configuration"
