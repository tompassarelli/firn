#lang beagle/nix
(ns default)
(nix/module [config lib pkgs ...]
  (let [homeDir config.myConfig.modules.users.homeDir
        username config.myConfig.modules.users.username
        description "Weekly skill review queue: open or update the north issue listing skill reviews older than 30 days"]
    {:tags-opt-in [development]
     :options.myConfig.modules.skill-review-queue.enable (lib.mkEnableOption description)
     :config (lib.mkIf config.myConfig.modules.skill-review-queue.enable
       {:home-manager.users {username (nix/module [config ...]
         {:systemd.user.services.skill-review-queue
           {:Unit {:Description description :OnFailure ["update-notify@%n.service"]}
            :Service {:Type "oneshot"
              :Environment [(s "PATH=" homeDir "/.local/share/north/bin:" homeDir "/.local/bin:" (lib.makeBinPath [pkgs.bash pkgs.coreutils pkgs.jq pkgs.gh pkgs.git]))]
              :ExecStart (s homeDir "/.local/share/north/bin/skill-review-queue")}}
          :systemd.user.timers.skill-review-queue
           {:Unit {:Description description}
            :Timer {:OnCalendar "Mon 09:00" :Persistent true}
            :Install {:WantedBy ["timers.target"]}}})}})}))
