use firn/tags


config
  "environment"
    "systemPackages": [pkgs.remmina]
  "home-manager"
    "users"
      {config.myConfig.modules.users.username}
        "xdg"
          "configFile"
            "autostart/remmina-applet.desktop"
              "text": "[Desktop Entry]\nHidden=true\n\n"
"enable": "Remmina remote desktop client"
