use firn/tags

remmina is a Module

nix module
  arguments: config, lib, pkgs, ...
  config when config.myConfig.modules.remmina.enable
    "environment"
      "systemPackages": [pkgs.remmina]
    "home-manager"
      "users"
        {config.myConfig.modules.users.username}
          "xdg"
            "configFile"
              "autostart/remmina-applet.desktop"
                "text": "[Desktop Entry]\nHidden=true\n\n"
  option "myConfig"."modules"."remmina"."enable": enable "Remmina remote desktop client"
