#lang beagle/nix

(ns default)

(nix/module [config lib pkgs ...]
  {:options.myConfig.modules.g203-led.enable
    (lib.mkEnableOption "Logitech G102/G203 LED control")
   :config
    (lib.mkIf config.myConfig.modules.g203-led.enable
      {:environment.systemPackages (nix/with pkgs [g203-led])
       :services.udev.extraRules
        (ms (s "ACTION==\"add\", SUBSYSTEM==\"usb\", ATTR{idVendor}==\"046d\", ATTR{idProduct}==\"c092\", RUN+=\"" pkgs.g203-led "/bin/g203-led lightsync solid 000000\"") "")})})
