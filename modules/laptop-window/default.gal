use firn/tags

tags: server

let cfg = config.myConfig.modules.laptop-window
let username = config.myConfig.modules.users.username
let homeDir = config.myConfig.modules.users.homeDir
enable: "laptop-window: every minute run laptop tick, opening the laptop at the window's open time, draining it at its close and settling drained state"
option myConfig.modules.laptop-window.timeZone: Text
  default: "UTC"
  description: "time zone the window and laptop until HH:MM are read in"
option myConfig.modules.laptop-window.open: Text
  default: "23:00"
  description: "local time the window makes the laptop available"
option myConfig.modules.laptop-window.close: Text
  default: "10:00"
  description: "local time the window drains the laptop"
config when cfg.enable
  environment.etc."placement/laptop-window.json".text: builtins.toJSON({tz: cfg.timeZone, open: cfg.open, close: cfg.close})
  systemd.services.laptop-window
    description: "laptop tick: apply the laptop availability window and settle a finished drain"
    path: [pkgs.python3, pkgs.coreutils, pkgs.gitleaks, "{homeDir}/.local/share/north", "/run/current-system/sw"]
    serviceConfig
      Type: "oneshot"
      User: username
      TimeoutStartSec: "50s"
      ExecStart: "{homeDir}/.local/share/north/bin/laptop tick"
  systemd.timers.laptop-window
    wantedBy: ["timers.target"]
    timerConfig
      OnCalendar: "minutely"
      AccuracySec: "1s"
