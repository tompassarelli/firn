use firn/tags

chrome is a Module
chrome can opt into browsers

nix module
  arguments: config, lib, pkgs, ...
  config when config.myConfig.modules.chrome.enable
    "environment"
      "systemPackages": [pkgs.google-chrome]
    "xdg"
      "mime"
        "defaultApplications" when config.myConfig.modules.chrome.default
          "text/html": "google-chrome.desktop"
          "x-scheme-handler/about": "google-chrome.desktop"
          "x-scheme-handler/http": "google-chrome.desktop"
          "x-scheme-handler/https": "google-chrome.desktop"
          "x-scheme-handler/unknown": "google-chrome.desktop"
  option "myConfig"."modules"."chrome"."default": Bool
    default: false
    description: "Set Chrome as the default browser via MIME types"
  option "myConfig"."modules"."chrome"."enable": enable "Enable Google Chrome browser"
