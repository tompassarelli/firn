use firn/tags

sqlcmd is a Module
sqlcmd is tagged csharp

nix module
  arguments: config, lib, pkgs, ...
  config when config.myConfig.modules.sqlcmd.enable
    "environment"
      "systemPackages": [pkgs.sqlcmd]
  option "myConfig"."modules"."sqlcmd"."enable": enable "sqlcmd for Microsoft SQL Server"
