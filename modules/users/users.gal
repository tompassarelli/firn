let username = config.myConfig.modules.users.username
let homeDir = config.myConfig.modules.users.homeDir
enable: "Enable user configuration"
option myConfig.modules.users.username: Text
  default: "user"
  description: "Primary system username (instance binds the real one)"
# --- identity surface ---
# One home for the per-user facts that were scattered across modules
# (git email/name, ~/code paths). Defaults preserve current behavior;
# the INSTANCE (each host) overrides these — a fork sets them once here
# instead of editing git/, auto-upgrade/, timezone/, agent-coord/.
option myConfig.modules.users.email: Text
  default: ""
  description: "Primary git/commit email"
option myConfig.modules.users.fullName: Text
  default: ""
  description: "Git author / display name (git user.name)"
option myConfig.modules.users.homeDir: Text
  default: "/home/{username}"
  description: "User home directory"
option myConfig.modules.users.codeDir: Text
  default: "{homeDir}/code"
  description: "Root of source checkouts (the ~/code convention)"
option myConfig.modules.users.mutable: Bool
  default: true
  description: "Allow imperative user changes (users.mutableUsers)"
option myConfig.modules.users.authorizedKeys: List Text
  default: []
  description: "SSH public keys allowed to log in as the primary user"
option myConfig.modules.users.extraGroups: List Text
  default: ["wheel", "networkmanager", "plugdev"]
  description: "Supplementary groups of the primary user"
option myConfig.modules.users.passwordHashSopsFile: maybe Path
  default: null
  description: "sops file whose `password_hash` key holds the primary user's password hash"
config
  users.mutableUsers: config.myConfig.modules.users.mutable
  users.users.{username}
    shell: pkgs.bashInteractive
    isNormalUser: true
    home: homeDir
    extraGroups: config.myConfig.modules.users.extraGroups
    openssh.authorizedKeys.keys: config.myConfig.modules.users.authorizedKeys
    hashedPasswordFile: config.sops.secrets.user-password-hash.path when config.myConfig.modules.users.passwordHashSopsFile != null
  sops.secrets when config.myConfig.modules.users.passwordHashSopsFile != null
    "user-password-hash"
      sopsFile: config.myConfig.modules.users.passwordHashSopsFile
      key: "password_hash"
      neededForUsers: true
  security.sudo.extraConfig: '''
    Defaults timestamp_timeout=30
    Defaults timestamp_type=global

    '''
  systemd.tmpfiles.rules: ["d {homeDir}/Documents 0755 {username} users -", "d {homeDir}/Pictures/Screenshots 0755 {username} users -", "d {homeDir}/code 0755 {username} users -", "d {homeDir}/src 0755 {username} users -"]
