use firn/tags

ssh is a Module
ssh is tagged server

nix module
  arguments: config, lib, ...
  config when config.myConfig.modules.ssh.enable
    "services"
      "openssh"
        "enable": true
        "settings"
          "KbdInteractiveAuthentication": false
          "PasswordAuthentication": false
  option "myConfig"."modules"."ssh"."enable": enable "SSH server"
