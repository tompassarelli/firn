#lang beagle/nix

(ns default)

(nix/module [config lib pkgs ...]
  {:options.myConfig.modules.boot.enable
    (lib.mkEnableOption "boot configuration")
   :config
    (lib.mkIf config.myConfig.modules.boot.enable
      {:boot.loader.systemd-boot.enable true
       :boot.loader.efi.canTouchEfiVariables true

       ;; --- crash forensics: whiterabbit silent-freeze hunt (diagnostic) ---
       ;; Goal: convert a no-trace freeze into a CAPTURED event. nmi_watchdog
       ;; already DETECTS hard lockups but is log-only by default — and a dying
       ;; box never flushes that log. We turn detection into a PANIC so efi-pstore
       ;; (firmware vars, archived to /var/lib/systemd/pstore next boot) grabs the
       ;; backtrace, then panic=20 auto-reboots. Remove once root cause is found.
       ;; Paths NOT taken:
       ;;  - ramoops: this kernel runs ONE pstore backend (efi_pstore wins, ramoops
       ;;    -16) and without CONFIG_PSTORE_CONSOLE it's redundant. Needs a
       ;;    PSTORE_CONSOLE kernel rebuild + pstore.backend=ramoops to be worth it.
       ;;  - kdump (boot.crashDump): reserves crashkernel but NixOS ships no vmcore
       ;;    save unit — the capture kernel drops to a shell, no auto-save/reboot,
       ;;    so it STRANDS an unattended box. Revisit only with a real save+reboot
       ;;    capture init if the pstore backtrace proves insufficient.
       :boot.kernelModules ["uinput"]

       ;; gpu_recovery=1: amdgpu resets+logs a hung GPU instead of freezing silent.
       ;; nmi_watchdog=panic: hard-lockup detector panics from early boot (cmdline
       ;; covers the window before systemd-sysctl applies hardlockup_panic).
       ;; cwsr_enable=0: ROOT-CAUSE mitigation for the gfx1150 (Radeon 890M) MES
       ;; ring-hang — broken CWSR saturates the MES ring -> SQC/UTCL2 page-fault ->
       ;; gfx ring-timeout/reset loop. Known-open regression across kernel 6.18.x +
       ;; 6.19.x; no upstream fix. Do NOT bump kernel/firmware — newer MES ucode
       ;; (0x82/0x83) is the trigger, not the fix. Ref: community.frame.work/t/79221.
       :boot.kernelParams
         ["amdgpu.gpu_recovery=1"
          "nmi_watchdog=panic"
          "amdgpu.cwsr_enable=0"]

       ;; softlockup_panic is the aggressive knob (rare false reboot on a >20s
       ;; stall); set 0 if it ever fires spuriously. panic=20 auto-reboots 20s
       ;; after a panic so the box recovers — the capture is already archived.
       :boot.kernel.sysctl
         {"kernel.hardlockup_panic" 1
          "kernel.softlockup_panic" 1
          "kernel.panic_on_oops" 1
          "kernel.panic" 20}})})
