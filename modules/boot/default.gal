use firn/tags

boot is a Module

nix module
  arguments: config, lib, ...
  config when config.myConfig.modules.boot.enable
    "boot"
      "kernel"
        "sysctl"
          "kernel.hardlockup_panic": 1
          "kernel.panic": 20
          "kernel.panic_on_oops": 1
          "kernel.softlockup_panic": 1
      "kernelModules": ["uinput"]
      "kernelParams": ["amdgpu.gpu_recovery=1", "nmi_watchdog=panic", "amdgpu.cwsr_enable=0", "amdgpu.dcdebugmask=0x10"]
      "loader"
        "efi"
          "canTouchEfiVariables": true
        "systemd-boot"
          "enable": true
  option "myConfig"."modules"."boot"."enable": enable "boot configuration"
