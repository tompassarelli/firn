#lang beagle/nix

(ns default)

;; North owns the composed personal agent profile. Firn only materialises the
;; stable discovery paths consumed by provider adapters.
(nix/module [config lib ...]
  (let [username config.myConfig.modules.users.username]
    {:tags [development]
     :options.myConfig.modules.agent-core.enable
      (lib.mkEnableOption "Shared provider-neutral agent configuration")
     :config
      (lib.mkIf config.myConfig.modules.agent-core.enable
        {:home-manager.users
          {username
            (nix/module [config ...]
              {:home.file
                {;; The shared provider-neutral constitution, resolvable at the
                 ;; canonical ~/.agents/AGENTS.md path every adapter can point to.
                 ".agents/AGENTS.md"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/north/main/profiles/tom/AGENTS.md"))}
                 ".agents/skills"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/north/main/profiles/tom/skills"))}
                 ".agents/docs"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/north/main/profiles/tom/docs"))}
                 ".agents/hooks"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/north/main/profiles/tom/hooks"))}
                 ;; Provider-neutral routing instructions for the ~/code root.
                 "code/AGENTS.md"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/nixos-config/dotfiles/code/AGENTS.md"))}}})}})}))
