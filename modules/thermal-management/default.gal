use firn/tags


arguments: config, lib, ...
config
  "boot"
    "kernelParams": ["amd_pstate=active"]
  "services"
    "auto-cpufreq"
      "enable": true
      "settings"
        "battery"
          "energy_performance_preference": "power"
          "governor": "powersave"
          "turbo": "never"
        "charger"
          "energy_performance_preference": "balance_performance"
          "governor": "performance"
          "turbo": "never"
"enable": "CPU thermal management for sustained builds"
