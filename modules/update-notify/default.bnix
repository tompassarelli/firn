#lang beagle/nix
(ns default)
(nix/module [config lib pkgs ...]
  (let [homeDir config.myConfig.modules.users.homeDir username config.myConfig.modules.users.username]
    {:tags-opt-in [development]
     :options.myConfig.modules.update-notify.enable (lib.mkEnableOption "Visible automatic-update failures")
     :config (lib.mkIf config.myConfig.modules.update-notify.enable
       {:home-manager.users {username (nix/module [config ...]
         {:systemd.user.services {"update-notify@"
            {:Unit {:Description "Report an automatic-update failure"}
             :Service {:Type "oneshot"
               :Environment [(s "PATH=" homeDir "/.local/bin:" (lib.makeBinPath [pkgs.bash pkgs.coreutils pkgs.libnotify]))]
               :ExecStart (s homeDir "/.local/bin/update-notify %i")}}}})}})}))
