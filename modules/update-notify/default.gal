use firn/tags

update-notify can opt into development

let homeDir = config.myConfig.modules.users.homeDir
let username = config.myConfig.modules.users.username
let nexusNotify = pkgs.writeShellScript("update-notify-nexus", '''
  set -eu
  unit=$1
  unit=${unit%.service}.service
  exec {{pkgs.systemd}}/bin/systemctl --user start "nexus-notify@$unit.service"
  ''')
let notify = if config.myConfig.modules.nexus-alerts.enable then "{nexusNotify} %i" else "{homeDir}/.local/share/firn/bin/update-notify %i"
enable: "Visible automatic-update failures"
config
  home-manager.users.{username}: ({config, ...}) => {systemd.user.services."update-notify@": {Unit: {Description: "Report an automatic-update failure"}, Service: {Type: "oneshot", Environment: ["PATH={homeDir}/.local/share/firn/bin:{lib.makeBinPath([pkgs.bash, pkgs.coreutils, pkgs.libnotify])}"], ExecStart: notify}}}
