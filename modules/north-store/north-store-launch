fail() {
  echo "north-store: $*" >&2
  exit 78
}

validation_only=0
case "$#" in
  0)
    selection="${NORTH_STORE_SELECTION:?north-store: NORTH_STORE_SELECTION must name the Store RPC selection file}"
    ;;
  2)
    [ "$1" = --validate-only ] ||
      fail "usage: north-store-launch [--validate-only SELECTION]"
    validation_only=1
    selection=$2
    ;;
  *)
    fail "usage: north-store-launch [--validate-only SELECTION]"
    ;;
esac

# systemd's EnvironmentFile parser accepts KEY=VALUE only; every line of
# beagle-store.env is `export KEY='value'`, so EnvironmentFile= imports nothing from
# it. Sourcing keeps the selection file the single place the engine, Store transaction log,
# port, and SpaceId are chosen.
if [ ! -r "$selection" ]; then
  fail "Store RPC selection is unreadable: $selection"
fi

required_selection_values=(
  BEAGLE_STORE_SERVER_RUNTIME
  BEAGLE_STORE_NATIVE_ARTIFACT_DIR
  BEAGLE_STORE_NATIVE_CLOSURE_SHA256
  BEAGLE_STORE_SERVER_ARTIFACT
  BEAGLE_STORE_SERVER_ARTIFACT_SHA256
  BEAGLE_STORE_SERVER_PORT
  BEAGLE_STORE_SPACE_ID
  BEAGLE_STORE_LOG
)
governed_selection_values=(
  BEAGLE_STORE_HOME
  "${required_selection_values[@]}"
)
for variable in "${governed_selection_values[@]}"; do
  unset "$variable"
done

set -a
# shellcheck disable=SC1090
. "$selection"
set +a

: "${BEAGLE_STORE_HOME:?north-store: the selection file must set BEAGLE_STORE_HOME}"
case "$BEAGLE_STORE_HOME" in
  /*) ;;
  *) fail "BEAGLE_STORE_HOME must be absolute: $BEAGLE_STORE_HOME" ;;
esac

for variable in "${required_selection_values[@]}"; do
  [ -n "${!variable:-}" ] || fail "the selection file must set $variable"
done
[ "$BEAGLE_STORE_SERVER_RUNTIME" = native ] ||
  fail "the selected Store runtime must be native"

receipt="$BEAGLE_STORE_HOME/RELEASE"
[ -r "$receipt" ] || fail "sealed release has no readable receipt: $receipt"
release_keys=(
  format
  protocol
  source
  revision
  tree
  native_artifact_dir
  native_closure_sha256
  server_artifact_sha256
  created
)
release_lines=()
mapfile -t release_lines <"$receipt"
[ "${#release_lines[@]}" -eq "${#release_keys[@]}" ] ||
  fail "sealed release receipt has the wrong exact field set: $receipt"
release_values=()
for index in "${!release_keys[@]}"; do
  line=${release_lines[$index]}
  key=${line%%=*}
  value=${line#*=}
  [ "$key" = "${release_keys[$index]}" ] &&
    [ "$value" != "$line" ] &&
    [ -n "${value//[[:space:]]/}" ] ||
    fail "sealed release receipt has the wrong exact field set: $receipt"
  release_values+=("$value")
done
[ "${release_values[0]}" = north-store-release/v2 ] ||
  fail "sealed release receipt is not north-store-release/v2: $receipt"
[ "${release_values[1]}" = STORERPC/2.0 ] ||
  fail "sealed release protocol is not STORERPC/2.0: $receipt"

native_artifact_dir=${release_values[5]}
native_closure_sha256=${release_values[6]}
server_artifact_sha256=${release_values[7]}
[[ "$native_closure_sha256" =~ ^[0-9a-f]{64}$ ]] ||
  fail "sealed release native closure digest is invalid: $receipt"
[[ "$server_artifact_sha256" =~ ^[0-9a-f]{64}$ ]] ||
  fail "sealed release server digest is invalid: $receipt"
[ "$BEAGLE_STORE_NATIVE_ARTIFACT_DIR" = "$native_artifact_dir" ] ||
  fail "selected native artifact differs from the sealed release"
[ "$BEAGLE_STORE_NATIVE_CLOSURE_SHA256" = "$native_closure_sha256" ] ||
  fail "selected native closure differs from the sealed release"
expected_server="$native_artifact_dir/bin/beagle-store-server-native"
[ "$BEAGLE_STORE_SERVER_ARTIFACT" = "$expected_server" ] ||
  fail "selected server artifact differs from the sealed release"
[ "$BEAGLE_STORE_SERVER_ARTIFACT_SHA256" = "$server_artifact_sha256" ] ||
  fail "selected server digest differs from the sealed release"
ready="$native_artifact_dir/READY"
[ -r "$ready" ] || fail "selected native artifact has no READY marker: $ready"
[ "$(<"$ready")" = "beagle-store-native-build/v1 $native_closure_sha256" ] ||
  fail "selected native artifact READY identity is invalid: $ready"
[ -x "$expected_server" ] ||
  fail "selected native server is not executable: $expected_server"
observed_server_sha256=$(sha256sum "$expected_server")
observed_server_sha256=${observed_server_sha256%% *}
[ "$observed_server_sha256" = "$server_artifact_sha256" ] ||
  fail "selected native server digest differs from the sealed release"

launcher="$BEAGLE_STORE_HOME/bin/beagle-store-server"
if [ ! -x "$launcher" ]; then
  fail "sealed release has no executable launcher: $launcher"
fi

if (( validation_only )); then
  echo "north-store: compatible STORERPC/2.0 selection: $selection"
  exit 0
fi

# The port is passed, never inherited: beagle-store-server assigns
# BEAGLE_STORE_SERVER_PORT="${1:-7977}", overwriting whatever the selection file set,
# so an unargumented launch silently ignores the selected port and binds 7977.
# Store transaction log and SpaceId do come from the environment. The launcher's own argv is
# irrelevant to attestation, which reads the exec'd Native process.
exec "$launcher" "${BEAGLE_STORE_SERVER_PORT:?north-store: the selection file must set BEAGLE_STORE_SERVER_PORT}"
