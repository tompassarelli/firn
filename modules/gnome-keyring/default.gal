use firn/tags

tags: auth

arguments: config, lib, ...
config
  "programs"
    "seahorse"
      "enable": true
  "security"
    "pam"
      "services"
        "login"
          "enableGnomeKeyring": true
  "services"
    "gnome"
      "gnome-keyring"
        "enable": true
"enable": "GNOME Keyring (secrets storage + Seahorse GUI)"
