use firn/tags

tags: cli-tools

arguments: config, lib, ...
config
  "home-manager"
    "users"
      {config.myConfig.modules.users.username}
        "programs"
          "yazi"
            "enable": true
            "settings"
              "opener"
                "edit": [{"block": true, "for": "unix", "run": "nvim \"$@\""}]
            "shellWrapperName": "yy"
"enable": "Yazi file manager"
