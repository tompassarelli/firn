use firn/tags

tags: desktop

arguments: config, lib, ...
config
  "home-manager"
    "users"
      {config.myConfig.modules.users.username}
        "services"
          "mako"
            "enable": true
            "settings"
              "app-name=Spotify"
                "invisible": 1
              "app-name=kitty"
                "default-timeout": 0
              "default-timeout": 0
              "icons": 0
"enable": "Mako notification daemon"
