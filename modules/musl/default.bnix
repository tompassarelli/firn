#lang beagle/nix

(ns default)

(nix/module [config lib pkgs ...]
  {:tags [development]
   :options.myConfig.modules.musl.enable
    (lib.mkEnableOption "musl C compiler toolchain")
   :config
    (lib.mkIf config.myConfig.modules.musl.enable
      {:environment.systemPackages (nix/with pkgs [musl])})})
