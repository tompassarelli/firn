use firn/tags

wl-gammarelay is a Module
wl-gammarelay is tagged desktop

nix module
  arguments: config, lib, pkgs, ...
  config when config.myConfig.modules.wl-gammarelay.enable
    "environment"
      "systemPackages": [pkgs.wl-gammarelay-rs]
    "home-manager"
      "users"
        {config.myConfig.modules.users.username}: (__clause_argument_10) => {"systemd": {"user": {"services": {"wl-gammarelay": {"Install": {"WantedBy": ["niri.service"]}, "Service": {"BusName": "rs.wl-gammarelay", "ExecStart": ("" ++ builtins.toString(pkgs.wl-gammarelay-rs)) ++ "/bin/wl-gammarelay-rs", "Restart": "on-failure", "Type": "dbus"}, "Unit": {"After": ["graphical-session.target"], "Description": "Gamma control for Wayland", "PartOf": ["graphical-session.target"], "Requisite": ["graphical-session.target"]}}}}}, "xdg": {"configFile": {"wl-gammarelay/temperature-control": {"source": (((__clause_argument_10.config).lib).file).mkOutOfStoreSymlink(("" ++ ((__clause_argument_10.config).home).homeDirectory) ++ "/code/nixos-config/dotfiles/wl-gammarelay/temperature-control")}}}}
  option "myConfig"."modules"."wl-gammarelay"."enable": enable "Wayland gamma/temperature control"
