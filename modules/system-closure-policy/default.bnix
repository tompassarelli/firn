#lang beagle/nix

(ns default)

(nix/module [config lib ...]
  (let
    [forbiddenExact
      ["babashka"
       "bun"
       "cargo"
       "clippy"
       "clj-kondo"
       "cljfmt"
       "clojure"
       "clojure-lsp"
       "codex"
       "devenv"
       "firn"
       "firn-compiler"
       "firn-launchers"
       "firn-native"
       "framework-tool"
       "gcc-wrapper"
       "jet"
       "nodejs"
       "opencode"
       "racket"
       "rust-analyzer"
       "rustc"
       "rustfmt"]
     forbiddenPrefixes ["beagle" "fram" "north"]
     packageId
      (fn [package] String
        (lib.toLower (get-or package pname (get-or package name ""))))
     forbidden?
      (fn [package] Bool
        (let [id (packageId package)]
          (or
            (builtins.elem id forbiddenExact)
            (builtins.any
              (fn [prefix] Bool
                (or (== id prefix) (lib.hasPrefix (s prefix "-") id)))
              forbiddenPrefixes)
            (!= (builtins.match "python3-[0-9.]+-env" id) nil))))
     forbiddenPackages (builtins.filter forbidden? config.environment.systemPackages)
     forbiddenIds (lib.unique (builtins.map packageId forbiddenPackages))]
    {:assertions
      [{:assertion (== forbiddenPackages [])
        :message
         (s
           "system closure policy: high-churn authoring packages must use "
           "live out-of-store entrypoints; forbidden environment.systemPackages: "
           (lib.concatStringsSep ", " forbiddenIds))}]}))
