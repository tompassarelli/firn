#lang beagle/nix

(ns default)

(nix/module [config lib pkgs ...]
  (let [username config.myConfig.modules.users.username]
    {:options.myConfig.modules.waybar.enable
      (lib.mkEnableOption "Waybar status bar for Wayland")
     :config
      (lib.mkIf config.myConfig.modules.waybar.enable
        {:environment.systemPackages (nix/with pkgs [waybar])
         :home-manager.users
          {username
            (nix/module [config ...]
              {:xdg.configFile
                {"waybar/config"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/nixos-config/dotfiles/waybar/config"))}
                 "waybar/stylix.css"
                  {:text
                    (nix/with config.lib.stylix.colors
                      (ms (s "@define-color base00 #" base00 ";") (s "@define-color base01 #" base01 ";") (s "@define-color base02 #" base02 ";") (s "@define-color base03 #" base03 ";") (s "@define-color base04 #" base04 ";") (s "@define-color base05 #" base05 ";") (s "@define-color base06 #" base06 ";") (s "@define-color base07 #" base07 ";") (s "@define-color base08 #" base08 ";") (s "@define-color base09 #" base09 ";") (s "@define-color base0A #" base0A ";") (s "@define-color base0B #" base0B ";") (s "@define-color base0C #" base0C ";") (s "@define-color base0D #" base0D ";") (s "@define-color base0E #" base0E ";") (s "@define-color base0F #" base0F ";") "" "* {" (s "  font-family: \"" config.stylix.fonts.monospace.name "\";") (s "  font-size: " (toString config.stylix.fonts.sizes.desktop) "pt;") "}" "" "window#waybar, tooltip {" (s "  background: alpha(@base00, " (toString config.stylix.opacity.desktop) ");") "  color: @base05;" "}" "" "tooltip {" "  border-color: @base0D;" "}" "" ".modules-left #workspaces button {" "  border-bottom: 3px solid transparent;" "}" ".modules-left #workspaces button.focused," ".modules-left #workspaces button.active {" "  border-bottom: 3px solid @base05;" "}" "" ".modules-center #workspaces button {" "  border-bottom: 3px solid transparent;" "}" ".modules-center #workspaces button.focused," ".modules-center #workspaces button.active {" "  border-bottom: 3px solid @base05;" "}" "" ".modules-right #workspaces button {" "  border-bottom: 3px solid transparent;" "}" ".modules-right #workspaces button.focused," ".modules-right #workspaces button.active {" "  border-bottom: 3px solid @base05;" "}" ""))}
                 "waybar/style.css"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/nixos-config/dotfiles/waybar/style.css"))}
                 "waybar/overview-waybar.py"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/nixos-config/dotfiles/waybar/overview-waybar.py"))}}
               :systemd.user.services.waybar
                {:Unit
                  {:Description "Highly customizable Wayland bar"
                   :PartOf      ["graphical-session.target"]
                   :After
                    ["graphical-session.target" "xdg-desktop-portal.service"]
                   :Requisite   ["graphical-session.target"]}
                 :Service
                  {:ExecStart (s pkgs.waybar "/bin/waybar")
                   :Restart   "on-failure"}
                 :Install {:WantedBy ["niri.service"]}}
               :systemd.user.services.waybar-overview
                {:Unit
                  {:Description
                    "Waybar visibility controller (overview + workspace switch)"
                   :PartOf      ["graphical-session.target"]
                   :After       ["waybar.service"]
                   :Requires    ["waybar.service"]}
                 :Service
                  {:ExecStart "%h/.config/waybar/overview-waybar.py"
                   :Restart   "on-failure"}
                 :Install {:WantedBy ["niri.service"]}}})}})}))
