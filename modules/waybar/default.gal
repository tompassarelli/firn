use firn/tags

waybar is a Module

nix module
  arguments: config, lib, pkgs, ...
  config when config.myConfig.modules.waybar.enable
    "environment"
      "systemPackages": [pkgs.waybar]
    "home-manager"
      "users"
        {config.myConfig.modules.users.username}: (__clause_argument_0) => {"systemd": {"user": {"services": {"waybar": {"Install": {"WantedBy": ["niri.service"]}, "Service": {"ExecStart": ("" ++ builtins.toString(pkgs.waybar)) ++ "/bin/waybar", "Restart": "on-failure"}, "Unit": {"After": ["graphical-session.target", "xdg-desktop-portal.service"], "Description": "Highly customizable Wayland bar", "PartOf": ["graphical-session.target"], "Requisite": ["graphical-session.target"]}}, "waybar-overview": {"Install": {"WantedBy": ["niri.service"]}, "Service": {"ExecStart": "%h/.config/waybar/overview-waybar.py", "Restart": "on-failure"}, "Unit": {"After": ["waybar.service"], "Description": "Waybar visibility controller (overview + workspace switch)", "PartOf": ["graphical-session.target"], "Requires": ["waybar.service"]}}}}}, "xdg": {"configFile": {"waybar/config": {"source": (((__clause_argument_0.config).lib).file).mkOutOfStoreSymlink(("" ++ ((__clause_argument_0.config).home).homeDirectory) ++ "/code/nixos-config/dotfiles/waybar/config")}, "waybar/overview-waybar.py": {"source": (((__clause_argument_0.config).lib).file).mkOutOfStoreSymlink(("" ++ ((__clause_argument_0.config).home).homeDirectory) ++ "/code/nixos-config/dotfiles/waybar/overview-waybar.py")}, "waybar/style.css": {"source": (((__clause_argument_0.config).lib).file).mkOutOfStoreSymlink(("" ++ ((__clause_argument_0.config).home).homeDirectory) ++ "/code/nixos-config/dotfiles/waybar/style.css")}, "waybar/stylix.css": {"text": ((((((((((((((((((((((((((((((((((((("@define-color base00 #" ++ ((((__clause_argument_0.config).lib).stylix).colors).base00) ++ ";\n@define-color base01 #") ++ ((((__clause_argument_0.config).lib).stylix).colors).base01) ++ ";\n@define-color base02 #") ++ ((((__clause_argument_0.config).lib).stylix).colors).base02) ++ ";\n@define-color base03 #") ++ ((((__clause_argument_0.config).lib).stylix).colors).base03) ++ ";\n@define-color base04 #") ++ ((((__clause_argument_0.config).lib).stylix).colors).base04) ++ ";\n@define-color base05 #") ++ ((((__clause_argument_0.config).lib).stylix).colors).base05) ++ ";\n@define-color base06 #") ++ ((((__clause_argument_0.config).lib).stylix).colors).base06) ++ ";\n@define-color base07 #") ++ ((((__clause_argument_0.config).lib).stylix).colors).base07) ++ ";\n@define-color base08 #") ++ ((((__clause_argument_0.config).lib).stylix).colors).base08) ++ ";\n@define-color base09 #") ++ ((((__clause_argument_0.config).lib).stylix).colors).base09) ++ ";\n@define-color base0A #") ++ ((((__clause_argument_0.config).lib).stylix).colors).base0A) ++ ";\n@define-color base0B #") ++ ((((__clause_argument_0.config).lib).stylix).colors).base0B) ++ ";\n@define-color base0C #") ++ ((((__clause_argument_0.config).lib).stylix).colors).base0C) ++ ";\n@define-color base0D #") ++ ((((__clause_argument_0.config).lib).stylix).colors).base0D) ++ ";\n@define-color base0E #") ++ ((((__clause_argument_0.config).lib).stylix).colors).base0E) ++ ";\n@define-color base0F #") ++ ((((__clause_argument_0.config).lib).stylix).colors).base0F) ++ ";\n\n* \{\n  font-family: \"") ++ ((((__clause_argument_0.config).stylix).fonts).monospace).name) ++ "\";\n  font-size: ") ++ builtins.toString(((((__clause_argument_0.config).stylix).fonts).sizes).desktop)) ++ "pt;\n}\n\nwindow#waybar, tooltip \{\n  background: alpha(@base00, ") ++ builtins.toString((((__clause_argument_0.config).stylix).opacity).desktop)) ++ ");\n  color: @base05;\n}\n\ntooltip \{\n  border-color: @base0D;\n}\n\n.modules-left #workspaces button \{\n  border-bottom: 3px solid transparent;\n}\n.modules-left #workspaces button.focused,\n.modules-left #workspaces button.active \{\n  border-bottom: 3px solid @base05;\n}\n\n.modules-center #workspaces button \{\n  border-bottom: 3px solid transparent;\n}\n.modules-center #workspaces button.focused,\n.modules-center #workspaces button.active \{\n  border-bottom: 3px solid @base05;\n}\n\n.modules-right #workspaces button \{\n  border-bottom: 3px solid transparent;\n}\n.modules-right #workspaces button.focused,\n.modules-right #workspaces button.active \{\n  border-bottom: 3px solid @base05;\n}\n\n"}}}}
  option "myConfig"."modules"."waybar"."enable": enable "Waybar status bar for Wayland"
