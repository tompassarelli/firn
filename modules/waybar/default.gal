use firn/tags


config
  "environment"
    "systemPackages": [pkgs.waybar]
  "home-manager"
    "users"
      {config.myConfig.modules.users.username}: (hm) => {"systemd": {"user": {"services": {"waybar": {"Install": {"WantedBy": ["niri.service"]}, "Service": {"ExecStart": ("" ++ builtins.toString(pkgs.waybar)) ++ "/bin/waybar", "Restart": "on-failure"}, "Unit": {"After": ["graphical-session.target", "xdg-desktop-portal.service"], "Description": "Highly customizable Wayland bar", "PartOf": ["graphical-session.target"], "Requisite": ["graphical-session.target"]}}, "waybar-overview": {"Install": {"WantedBy": ["niri.service"]}, "Service": {"ExecStart": "%h/.config/waybar/overview-waybar.py", "Restart": "on-failure"}, "Unit": {"After": ["waybar.service"], "Description": "Waybar visibility controller (overview + workspace switch)", "PartOf": ["graphical-session.target"], "Requires": ["waybar.service"]}}}}}, "xdg": {"configFile": {"waybar/config": {"source": (((hm.config).lib).file).mkOutOfStoreSymlink(("" ++ ((hm.config).home).homeDirectory) ++ "/code/nixos-config/dotfiles/waybar/config")}, "waybar/overview-waybar.py": {"source": (((hm.config).lib).file).mkOutOfStoreSymlink(("" ++ ((hm.config).home).homeDirectory) ++ "/code/nixos-config/dotfiles/waybar/overview-waybar.py")}, "waybar/style.css": {"source": (((hm.config).lib).file).mkOutOfStoreSymlink(("" ++ ((hm.config).home).homeDirectory) ++ "/code/nixos-config/dotfiles/waybar/style.css")}, "waybar/stylix.css": {"text": ((((((((((((((((((((((((((((((((((((("@define-color base00 #" ++ ((((hm.config).lib).stylix).colors).base00) ++ ";\n@define-color base01 #") ++ ((((hm.config).lib).stylix).colors).base01) ++ ";\n@define-color base02 #") ++ ((((hm.config).lib).stylix).colors).base02) ++ ";\n@define-color base03 #") ++ ((((hm.config).lib).stylix).colors).base03) ++ ";\n@define-color base04 #") ++ ((((hm.config).lib).stylix).colors).base04) ++ ";\n@define-color base05 #") ++ ((((hm.config).lib).stylix).colors).base05) ++ ";\n@define-color base06 #") ++ ((((hm.config).lib).stylix).colors).base06) ++ ";\n@define-color base07 #") ++ ((((hm.config).lib).stylix).colors).base07) ++ ";\n@define-color base08 #") ++ ((((hm.config).lib).stylix).colors).base08) ++ ";\n@define-color base09 #") ++ ((((hm.config).lib).stylix).colors).base09) ++ ";\n@define-color base0A #") ++ ((((hm.config).lib).stylix).colors).base0A) ++ ";\n@define-color base0B #") ++ ((((hm.config).lib).stylix).colors).base0B) ++ ";\n@define-color base0C #") ++ ((((hm.config).lib).stylix).colors).base0C) ++ ";\n@define-color base0D #") ++ ((((hm.config).lib).stylix).colors).base0D) ++ ";\n@define-color base0E #") ++ ((((hm.config).lib).stylix).colors).base0E) ++ ";\n@define-color base0F #") ++ ((((hm.config).lib).stylix).colors).base0F) ++ ";\n\n* \{\n  font-family: \"") ++ ((((hm.config).stylix).fonts).monospace).name) ++ "\";\n  font-size: ") ++ builtins.toString(((((hm.config).stylix).fonts).sizes).desktop)) ++ "pt;\n}\n\nwindow#waybar, tooltip \{\n  background: alpha(@base00, ") ++ builtins.toString((((hm.config).stylix).opacity).desktop)) ++ ");\n  color: @base05;\n}\n\ntooltip \{\n  border-color: @base0D;\n}\n\n.modules-left #workspaces button \{\n  border-bottom: 3px solid transparent;\n}\n.modules-left #workspaces button.focused,\n.modules-left #workspaces button.active \{\n  border-bottom: 3px solid @base05;\n}\n\n.modules-center #workspaces button \{\n  border-bottom: 3px solid transparent;\n}\n.modules-center #workspaces button.focused,\n.modules-center #workspaces button.active \{\n  border-bottom: 3px solid @base05;\n}\n\n.modules-right #workspaces button \{\n  border-bottom: 3px solid transparent;\n}\n.modules-right #workspaces button.focused,\n.modules-right #workspaces button.active \{\n  border-bottom: 3px solid @base05;\n}\n\n"}}}}
"enable": "Waybar status bar for Wayland"
