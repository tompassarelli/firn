#lang beagle/nix

(ns default)

;; North owns the composed personal agent profile. Firn only materialises the
;; stable discovery paths consumed by provider adapters.
(nix/module [config lib ...]
  (let [username config.myConfig.modules.users.username]
    {:tags [development]
     :options.myConfig.modules.north-profile.enable
      (lib.mkEnableOption "Publish North's agent profile at ~/.agents (see north:agent-profile contract)")
     :config
      (lib.mkIf config.myConfig.modules.north-profile.enable
        {:home-manager.users
          {username
            (nix/module [config ...]
              {:home.file
                {;; The shared provider-neutral constitution, resolvable at the
                 ;; canonical ~/.agents/AGENTS.md path every adapter can point to.
                 ".agents/AGENTS.md"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/north/main/agent-profile/AGENTS.md"))}
                 ".agents/skills"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/.local/state/north/skills"))}
                 ".agents/docs"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/north/main/agent-profile/docs"))}
                 ".agents/hooks"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/code/north/main/agent-profile/hooks"))}
                 ;; Provider-neutral routing instructions for the ~/code root.
                 ;; Switchboard-owned, exactly like ~/code/CLAUDE.md: the
                 ;; `code-md` slot feeds both surfaces and `agents apply` is the
                 ;; sole writer under ~/.config/agents. Linking dotfiles/code
                 ;; directly would inject the routing note on every session in
                 ;; ~/code, outside the blackout the switch exists to enforce.
                 "code/AGENTS.md"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/.config/agents/code-AGENTS.md"))}}})}})}))
