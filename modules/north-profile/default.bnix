#lang beagle/nix

(ns default)

;; Firn materialises stable provider-neutral discovery paths. North owns the
;; immutable activation generation behind them.
(nix/module [config lib pkgs ...]
  (let [username config.myConfig.modules.users.username
        claudeHookProjection (pkgs.writeText "north-claude-hooks.json"
           (builtins.readFile (p "./claude-hooks.json")))
        claudeHookProjector (pkgs.writeShellScript "north-claude-hook-projector"
           (builtins.readFile (p "./claude-hook-projector.sh")))]
    {:tags [development]
     :options.myConfig.modules.north-profile.enable
      (lib.mkEnableOption "Publish shared agent surfaces at ~/.agents")
     :config
      (lib.mkIf config.myConfig.modules.north-profile.enable
        {:home-manager.users
          {username
            (nix/module [config ...]
              {:home.file
                {;; Instructions have one authority: the current North
                 ;; generation. Pointing this at a source checkout would bypass
                 ;; set permission and provenance.
                 ".agents/AGENTS.md"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/.local/state/north/agents/current/instructions/shared/AGENTS.md"))}
                 ".agents/skills"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/.local/state/north/agents/current/skills/shared"))}
                 ".agents/hooks"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/.local/state/north/agents/current/provider-hooks"))}
                 ;; Provider-neutral routing instructions for the ~/code root.
                 ;; North renders this exact distribution in the same atomic
                 ;; generation as sets, skills, hooks, and provider views.
                 "code/AGENTS.md"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/.local/state/north/agents/current/instructions/code/AGENTS.md"))}}
               ;; Native Claude owns every setting except this exact hook
               ;; subtree. Merge it atomically so provider preferences survive
               ;; while hook commands converge to managed runtimes.
               :home.activation.projectNorthClaudeHooks
                (config.lib.dag.entryAfter ["writeBoundary"]
                  (s "run " pkgs.coreutils "/bin/env"
                     " CHMOD_BIN=" pkgs.coreutils "/bin/chmod"
                     " FLOCK_BIN=" pkgs.util-linux "/bin/flock"
                     " JQ_BIN=" pkgs.jq "/bin/jq"
                     " MKDIR_BIN=" pkgs.coreutils "/bin/mkdir"
                     " MV_BIN=" pkgs.coreutils "/bin/mv"
                     " REALPATH_BIN=" pkgs.coreutils "/bin/realpath"
                     " RM_BIN=" pkgs.coreutils "/bin/rm "
                     claudeHookProjector " " claudeHookProjection
                     " $HOME/.claude/settings.json\n"))})}})}))
