#lang beagle/nix

(ns default)

;; Firn materialises stable provider-neutral discovery paths. North owns the
;; immutable activation generation behind them.
(nix/module [config lib ...]
  (let [username config.myConfig.modules.users.username]
    {:tags [development]
     :options.myConfig.modules.north-profile.enable
      (lib.mkEnableOption "Publish shared agent surfaces at ~/.agents")
     :config
      (lib.mkIf config.myConfig.modules.north-profile.enable
        {:home-manager.users
          {username
            (nix/module [config ...]
              {:home.file
                {;; Instructions have one authority: the current North
                 ;; generation. Pointing this at a source checkout would bypass
                 ;; set permission and provenance.
                 ".agents/AGENTS.md"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/.local/state/north/agents/current/instructions/shared/AGENTS.md"))}
                 ".agents/skills"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/.local/state/north/agents/current/skills/shared"))}
                 ".agents/hooks"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/.local/state/north/agents/current/provider-hooks"))}
                 ;; Provider-neutral routing instructions for the ~/code root.
                 ;; North renders this exact distribution in the same atomic
                 ;; generation as sets, skills, hooks, and provider views.
                 "code/AGENTS.md"
                  {:source
                    (config.lib.file.mkOutOfStoreSymlink
                      (s config.home.homeDirectory
                        "/.local/state/north/agents/current/instructions/code/AGENTS.md"))}}})}})}))
