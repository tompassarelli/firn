#lang beagle/nix

(ns default)

;; The Beagle compiler is DEV-CHANNEL ONLY: the packaged flake build of
;; beagle no longer enters environment.systemPackages, so it no longer enters
;; the system closure. Only the checkout-execution `*-dev` shims ship from
;; Beagle; the generation-owned Firn native driver below remains installed.
;; Each shim execs ~/code/beagle/main's own bin/<name> so the racket that runs is
;; whatever that checkout's own direnv resolves — never a packaged racket, and
;; never the packaged beagle. This matches the north and fram delivery
;; contract: ordinary names are immutable generation-owned surfaces, *-dev
;; names are checkout surfaces that announce their provenance, and the two
;; never select one another silently. A missing checkout is a clear, loud
;; failure (exit 127 + message), never a silent fallback to a packaged binary.
;;
;; The dev wrappers deliberately do NOT export _BEAGLE_RACKET. The checkout's
;; own bin/_beagle-racket resolves racket through that checkout's direnv, which
;; is the racket its .zo bytecode was compiled against. Injecting a package's
;; pinned racket instead would reintroduce exactly the stale-bytecode skew the
;; dev/prod split exists to prevent ("body of .../raco.rkt"). A dev command
;; runs the checkout on the checkout's own terms; direnv is supplied so that
;; resolution works outside a direnv shell (dispatched agent, CI, cron, plain
;; subshell).
(nix/module [config flakeRoot lib pkgs ...]
  (let
    [firnNative
      (get (get flakeRoot.packages pkgs.stdenv.hostPlatform.system) :firn-native)
     liveInputs
      (nix/with pkgs [bash coreutils direnv findutils gawk git gnugrep gnused])
     devCommandNames
      ["beagle" "beagle-build" "beagle-check" "beagle-validate" "beagle-syntax"
       "beagle-fix" "beagle-repair" "beagle-doctor" "beagle-daemon" "beagle-lsp"]
     mkDev
      (fn [name]
        (pkgs.writeShellApplication
          {:name (s name "-dev")
           :runtimeInputs liveInputs
           :text
            (ms "checkout=${BEAGLE_CHECKOUT:-$HOME/code/beagle/main}"
                (s "target=$checkout/bin/" name)
                "if [ ! -x \"$target\" ]; then"
                (s "  echo \"" name "-dev: checkout executable missing: $target\" >&2")
                "  exit 127"
                "fi"
                (s "echo \"" name "-dev: provenance=checkout path=$target\" >&2")
                "exec \"$target\" \"$@\"")}))
     devCommands (builtins.map mkDev devCommandNames)]
    {:tags [development]
     :options.myConfig.modules.beagle.enable
      (lib.mkEnableOption
        "Beagle checkout development commands and the packaged Firn native driver")
     :config
      (lib.mkIf config.myConfig.modules.beagle.enable
        {:environment.systemPackages (++ devCommands [firnNative])})}))
