use firn/tags

fastfetch is a Module
fastfetch is tagged cli-tools

nix module
  arguments: config, lib, pkgs, ...
  config when config.myConfig.modules.fastfetch.enable
    "environment"
      "systemPackages": [pkgs.fastfetch]
    "home-manager"
      "users"
        {config.myConfig.modules.users.username}: (hm) => {"xdg": {"configFile": {"fastfetch/config.jsonc": {"source": (((hm.config).lib).file).mkOutOfStoreSymlink(("" ++ ((hm.config).home).homeDirectory) ++ "/code/nixos-config/dotfiles/fastfetch/config.jsonc")}}}}
  option "myConfig"."modules"."fastfetch"."enable": enable "Enable fastfetch system info display"
