use firn/tags

smashcraft-controller is a Module
smashcraft-controller is tagged desktop

# Tom's Xbox controller in Warcraft III: the always-on wc3-controller service
# (github.com/tompassarelli/wc3-controller) with Smashcraft's map plug-in
# (smashcraft:controller/README.md). ExecStart runs direct out-of-store
# launchers that `bun wisp controller` and `bun wisp play` point at the pinned
# service and the current plug-in, so the projects stay out of the system
# closure; without the service the unit is skipped, and without the plug-in
# the service plays every map with its Any map profile.
nix module
  arguments: config, lib, ...
  config when config.myConfig.modules.smashcraft-controller.enable
    "home-manager"
      "users"
        {config.myConfig.modules.users.username}: (__clause_argument_0) => {"systemd": {"user": {"services": {"wc3-controller": {"Install": {"WantedBy": ["niri.service"]}, "Service": {"ExecStart": ((("" ++ ((__clause_argument_0.config).home).homeDirectory) ++ "/.local/share/wc3-controller/bin/wc3-controller --service --plugin ") ++ ((__clause_argument_0.config).home).homeDirectory) ++ "/.local/share/smashcraft-build-inputs/controller/wc3-journal", "Restart": "always", "RestartSec": "5"}, "Unit": {"After": ["graphical-session.target"], "ConditionPathExists": ("" ++ ((__clause_argument_0.config).home).homeDirectory) ++ "/.local/share/wc3-controller/bin/wc3-controller", "Description": "wc3-controller service", "PartOf": ["graphical-session.target"]}}}}}}
  option "myConfig"."modules"."smashcraft-controller"."enable": enable "wc3-controller service: Tom's Xbox controller in Warcraft III, with Smashcraft's plug-in"
