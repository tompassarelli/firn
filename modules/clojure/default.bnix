#lang beagle/nix

(ns default)

(nix/module [config lib pkgs ...]
  {:tags [lisp]
   :options.myConfig.modules.clojure.enable
    (lib.mkEnableOption
      "Clojure tooling — LSP, linting, formatting (native binaries, no JVM)")
   :config
    ;; Every package here is a GraalVM-compiled native binary with an empty
    ;; JVM closure. A JDK or the `clojure` CLI would put `java` back on the
    ;; system PATH; work that needs one takes a dev shell (`init-clj`).
    (lib.mkIf config.myConfig.modules.clojure.enable
      {:environment.systemPackages
        (nix/with pkgs.unstable
          [clj-kondo clojure-lsp jet cljfmt])})})
