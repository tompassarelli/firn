#lang beagle/nix

(ns default)

;; Agent-autonomous rebuilds: NOPASSWD sudo for exactly the rebuild binary.
;; Honest security note (decided 2026-07-09): on this single-user box the
;; password on nixos-rebuild is a speed bump, not a boundary — anything running
;; as tom can edit the user-owned flake and becomes root at the next legitimate
;; activation anyway. Scoping to the one binary keeps `sudo bash` etc. gated.
;; The real discipline lives in the firn-guard hook (build+validate green and
;; committed build inputs). There is no rebuild broker or coordination layer.
(nix/module [config lib pkgs ...]
  {:tags [cli-tools]
   :options.myConfig.modules.rebuild-nopasswd.enable
    (lib.mkEnableOption "Passwordless sudo for nixos-rebuild (agent-autonomous firn rebuild)")
   :config
    (lib.mkIf config.myConfig.modules.rebuild-nopasswd.enable
      ;; Blanket: activation sudo-execs PER-GENERATION store paths (nh, ng
      ;; internals) — unscopeable statically. Owner-decided 2026-07-09: the
      ;; password is a speed bump on this box (user owns the flake => eventual
      ;; root anyway). Discipline stays in the firn-guard green gates.
      {:security.sudo.wheelNeedsPassword false})})
