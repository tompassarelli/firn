#lang beagle/nix

(ns default)

;; North coordinator (:7977) — sole-writer daemon serving Tom's canonical
;; fact log (~/.local/state/north/coordination.log; the 2026-07-16 log split
;; peeled telemetry into telemetry.log beside it — facts.log is the frozen
;; pre-split backup). Sibling of agent-coord (:7978)
;; and attention-coord (:7980): same coordinator family, different stores. JVM
;; runtime — long-lived server wants JIT throughput + real threads. Systemd owns
;; the one serving process so :7977 survives logout + reboot without racing a
;; checkout-side supervisor. Before every start, the service ensures that one
;; valid sealed selection exists, under ONE desired-mode rule per system
;; generation: package mode is the steady state and is re-pointed at this
;; generation's pinned Fram package on every start, so identical code never
;; reads as source-mode divergence after a switch; an explicit development
;; promotion is an announced override that survives until an explicit package
;; reset. north-coord-runtime serializes writers, materializes exact detached
;; Fram revisions, and atomically publishes complete current/previous
;; generations.

(nix/module [config lib pkgs inputs ...]
  (let [username config.myConfig.modules.users.username
        homeDir  config.myConfig.modules.users.homeDir
        framPkg
          (get (get inputs.fram.packages pkgs.stdenv.hostPlatform.system)
               :default)
        framRev inputs.fram.rev
        northPkg
          (get (get inputs.north.packages pkgs.stdenv.hostPlatform.system)
               :default)
        northCoordSdListenChecked
          (pkgs.runCommand
            "north-coord-sd-listen-checked"
            {}
            (ms (s "wrapper=" northPkg "/bin/north-coord-sd-listen")
                "if [ ! -x \"$wrapper\" ]; then"
                "  echo \"north-coord socketActivation requires executable $wrapper\" >&2"
                "  exit 1"
                "fi"
                "mkdir -p \"$out/bin\""
                "ln -s \"$wrapper\" \"$out/bin/north-coord-sd-listen\""))
        runtimeState (s homeDir "/.local/state/north/fram-runtime")
        northCoordRuntime
          (pkgs.writeShellApplication
            {:name "north-coord-runtime"
             :runtimeInputs (nix/with pkgs [bash coreutils git iproute2 systemd util-linux])
             :text
              (ms (s "export NORTH_COORD_RUNTIME_STATE=" runtimeState)
                  (s "export NORTH_COORD_FRAM_PACKAGE=" framPkg)
                  (s "export NORTH_COORD_FRAM_PACKAGE_REV=" framRev)
                  (s "export NORTH_COORD_FRAM_CHECKOUT=" homeDir "/code/fram")
                  (s "export NORTH_COORD_NORTH_PACKAGE=" northPkg)
                  (s "export NORTH_COORD_FRAM_LOG=" homeDir "/.local/state/north/coordination.log")
                  (s "export NORTH_COORD_TELEMETRY_LOG=" homeDir "/.local/state/north/telemetry.log")
                  "export NORTH_COORD_SYSTEMD_UNIT=north-coord.service"
                  "export NORTH_COORD_FRAM_PORT=7977"
                  (builtins.readFile (p "./north-coord-runtime")))})]
    {:options.myConfig.modules.north-coord.enable
      (lib.mkEnableOption "Personal North coordinator daemon (:7977) — sole-writer fact-graph service for Tom's canonical log")
     ;; Socket activation is gated OFF until the Fram daemon consumes the
     ;; inherited fd and the selected North package ships north-coord-sd-listen.
     ;; The wrapper currently exists only on an unlanded North lane, not on
     ;; North main or in the pinned package.
     :options.myConfig.modules.north-coord.socketActivation
      (lib.mkEnableOption "systemd socket activation for :7977 (requires the Fram fd-consumer and north-coord-sd-listen)")
     :config
      (lib.mkIf config.myConfig.modules.north-coord.enable
        {:environment.systemPackages [northCoordRuntime]
         :systemd.sockets.north-coord
          (lib.mkIf config.myConfig.modules.north-coord.socketActivation
            {:description  "North coordinator activation socket (:7977)"
             :wantedBy     ["sockets.target"]
             :listenStreams ["127.0.0.1:7977"]
             :socketConfig {:Backlog 4096
                            :FileDescriptorName "north-coord"}})
         :systemd.services.north-coord
          {:description           "North coordinator — personal fact-graph daemon (:7977)"
           :wantedBy              ["multi-user.target"]
           :requires
             (lib.mkIf config.myConfig.modules.north-coord.socketActivation
               ["north-coord.socket"])
           :after
             (concat ["network.target"]
                     (lib.optional config.myConfig.modules.north-coord.socketActivation
                                   "north-coord.socket"))
           :path                  (nix/with pkgs [clojure jdk bash coreutils git])
           ;; The socket unit owns :7977 across service restarts. A foreign
           ;; listener therefore fails north-coord.socket itself; the service
           ;; never mistakes its inherited system socket for a foreign owner.
           :startLimitIntervalSec 0
           :restartIfChanged      false  ;; Decoupled 2026-07-28 (tom): the engine comes
           ;; from the PROMOTED checkout, not the nix package - system rebuilds must
           ;; not bounce the coordinator. Engine updates go through the explicit
           ;; promote path (mutexed + broadcast). Unit changes that truly need a
           ;; restart use the drill: systemctl restart after rebuild-intent.
           :environment           {:HOME homeDir
                                   :FRAM_REQUIRE_LOG_FENCE "1"
                                   ;; Query wall-clock ceiling. The engine default
                                   ;; (5s) fell below production agg-scan cost at
                                   ;; ~100k facts (2026-07-28 read-path outage:
                                   ;; concern ls, presence, spawn admission).
                                   ;; Interim until the index/caching cuts land;
                                   ;; clients can still lower it per-request,
                                   ;; never raise it.
                                   :FRAM_QUERY_TIMEOUT_MS "30000"
                                   :FRAM_TELEMETRY_LOG (s homeDir "/.local/state/north/telemetry.log")
                                   ;; JDK launcher seam (java itself honors this env
                                   ;; var since JDK 9, ahead of any app args) — applies
                                   ;; identically whether north-coord-runtime execs the
                                   ;; packaged $FRAM_JAVA classpath launch or the
                                   ;; checkout's `clojure -M` (which itself invokes
                                   ;; java), so it doesn't depend on fram-daemon's mode
                                   ;; branch. Sizing per empirical live-set measurement
                                   ;; (jcmd GC: 1.28GB live / 12MB log corpus): 6g is
                                   ;; ~4.7x headroom.
                                   :JDK_JAVA_OPTIONS "-Xmx6g"}
           :serviceConfig
            {:Type             "simple"
             :User             username
             :WorkingDirectory homeDir
             ;; Socket ownership removes the old stop/bind race. The adapter
             ;; validates LISTEN_FDS before the selected Fram runtime starts.
             :ExecStartPre [(s northCoordRuntime "/bin/north-coord-runtime ensure-default")
                            (s northCoordRuntime "/bin/north-coord-runtime prepare")]
             ;; Direct start is the safe default. Socket activation references a
             ;; checked derivation, so a package without the wrapper fails while
             ;; building the system closure instead of at activation with 203/EXEC.
             :ExecStart
               (if config.myConfig.modules.north-coord.socketActivation
                 (s northCoordSdListenChecked "/bin/north-coord-sd-listen "
                    northCoordRuntime "/bin/north-coord-runtime start")
                 (s northCoordRuntime "/bin/north-coord-runtime start"))
             :ExecStartPost (s northCoordRuntime "/bin/north-coord-runtime settle")
             :Restart          "always"
             :RestartSec       2
             ;; Heap-adjacent RSS overhead (metaspace, native, mmapped log/index
             ;; files) sits above -Xmx6g; 8G ceiling governs OOM behavior instead
             ;; of leaving it uncapped (see thread progress: 18GB uncapped RSS
             ;; observed pre-GC on this host before the leak-ruled-out finding).
             :MemoryMax        "8G"
             :MemorySwapMax    "0"}}})}))
