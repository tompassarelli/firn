#lang beagle/nix

(ns default)

;; North coordinator (:7977) — sole-writer daemon serving Tom's canonical
;; fact log (~/.local/state/north/coordination.log; the 2026-07-16 log split
;; peeled telemetry into telemetry.log beside it — facts.log is the frozen
;; pre-split backup). Sibling of agent-coord (:7978)
;; and attention-coord (:7980): same coordinator family, different stores. JVM
;; runtime — long-lived server wants JIT throughput + real threads. Systemd owns
;; the one serving process so :7977 survives logout + reboot without racing a
;; checkout-side supervisor. Before every start, the service ensures that one
;; valid sealed selection exists, under ONE desired-mode rule per system
;; generation: package mode is the steady state and is re-pointed at this
;; generation's pinned Fram package on every start, so identical code never
;; reads as source-mode divergence after a switch; an explicit development
;; promotion is an announced override that survives until an explicit package
;; reset. north-coord-runtime serializes writers, materializes exact detached
;; Fram revisions, and atomically publishes complete current/previous
;; generations.

(nix/module [config lib pkgs inputs ...]
  (let [username config.myConfig.modules.users.username
        homeDir  config.myConfig.modules.users.homeDir
        framPkg
          (get (get inputs.fram.packages pkgs.stdenv.hostPlatform.system)
               :default)
        framRev inputs.fram.rev
        northPkg
          (get (get inputs.north.packages pkgs.stdenv.hostPlatform.system)
               :default)
        northCoordSdListenChecked
          (pkgs.runCommand
            "north-coord-sd-listen-checked"
            {}
            (ms (s "wrapper=" northPkg "/bin/north-coord-sd-listen")
                "if [ ! -x \"$wrapper\" ]; then"
                "  echo \"north-coord socketActivation requires executable $wrapper\" >&2"
                "  exit 1"
                "fi"
                "mkdir -p \"$out/bin\""
                "ln -s \"$wrapper\" \"$out/bin/north-coord-sd-listen\""))
        runtimeState (s homeDir "/.local/state/north/fram-runtime")
        telemetryRuntimeState
          (s homeDir "/.local/state/north/fram-telemetry-runtime")
        stageA
          config.myConfig.modules.north-coord.stageATelemetryPartition
        pairTarget "north-coord-pair.target"
        pairPrepareUnit "north-coord-pair-prepare.service"
        mkNorthCoordRuntime
          (fn [name state primaryLog peerLog port unit transactionOwner]
            (pkgs.writeShellApplication
              {:name name
               :runtimeInputs (nix/with pkgs [bash coreutils git iproute2 systemd util-linux])
               :text
                (ms (s "export NORTH_COORD_RUNTIME_STATE=" state)
                    (s "export NORTH_COORD_FRAM_PACKAGE=" framPkg)
                    (s "export NORTH_COORD_FRAM_PACKAGE_REV=" framRev)
                    (s "export NORTH_COORD_FRAM_CHECKOUT=" homeDir "/code/fram")
                    (s "export NORTH_COORD_NORTH_PACKAGE=" northPkg)
                    (s "export NORTH_COORD_FRAM_LOG=" primaryLog)
                    (s "export NORTH_COORD_TELEMETRY_LOG=" peerLog)
                    (s "export NORTH_COORD_SYSTEMD_UNIT=" unit)
                    (s "export NORTH_COORD_FRAM_PORT=" port)
                    "export NORTH_COORD_TELEMETRY_PORT=7978"
                    (s "export NORTH_COORD_SINGLE_ORIGIN=" (if stageA "1" "0"))
                    (s "export NORTH_COORD_TRANSACTION_OWNER=" transactionOwner)
                    (s "export NORTH_COORD_CORPUS_SYSTEMD_UNIT="
                       (if stageA pairTarget unit))
                    (s "export NORTH_COORD_RESTART_SYSTEMD_UNIT="
                       (if stageA pairTarget unit))
                    (s "export NORTH_COORD_RESTART_PREPARE_SYSTEMD_UNIT="
                       (if stageA pairPrepareUnit ""))
                    (builtins.readFile (p "./north-coord-runtime")))}))
        northCoordRuntime
          (mkNorthCoordRuntime
            "north-coord-runtime"
            runtimeState
            (s homeDir "/.local/state/north/coordination.log")
            (s homeDir "/.local/state/north/telemetry.log")
            "7977"
            "north-coord.service"
            "1")
        northTelemetryCoordRuntime
          (mkNorthCoordRuntime
            "north-telemetry-coord-runtime"
            telemetryRuntimeState
            (s homeDir "/.local/state/north/telemetry.log")
            (s homeDir "/.local/state/north/coordination.log")
            "7978"
            "north-telemetry-coord.service"
            "0")
        coordinationLog (s homeDir "/.local/state/north/coordination.log")
        telemetryLog (s homeDir "/.local/state/north/telemetry.log")
        cutoverState "/var/lib/north-coord-cutover"
        cutoverToken (s cutoverState "/cutover.token")
        selectorMap (s cutoverState "/route.map")
        selectorTransaction (s cutoverState "/selector.transaction")
        selectorLock (s cutoverState "/selector.lock")
        bootstrapMarker (s cutoverState "/bootstrap-complete")
        legacyHoldMarker "/run/north-coord-legacy-hold"
        proxyRuntime "/run/north-coord-proxy"
        proxyAdminSocket (s proxyRuntime "/admin.sock")
        proxyFrontend "north-public"
        blueCoordPort "17977"
        blueTelemetryPort "17978"
        greenCoordPort "27977"
        greenTelemetryPort "27978"
        blueCoordRuntime
          (mkNorthCoordRuntime
            "north-coord-blue-runtime"
            (s runtimeState "-blue")
            coordinationLog
            telemetryLog
            blueCoordPort
            "north-coord-blue.service"
            "1")
        blueTelemetryRuntime
          (mkNorthCoordRuntime
            "north-telemetry-coord-blue-runtime"
            (s telemetryRuntimeState "-blue")
            telemetryLog
            coordinationLog
            blueTelemetryPort
            "north-telemetry-coord-blue.service"
            "0")
        greenCoordRuntime
          (mkNorthCoordRuntime
            "north-coord-green-runtime"
            (s runtimeState "-green")
            coordinationLog
            telemetryLog
            greenCoordPort
            "north-coord-green.service"
            "1")
        greenTelemetryRuntime
          (mkNorthCoordRuntime
            "north-telemetry-coord-green-runtime"
            (s telemetryRuntimeState "-green")
            telemetryLog
            coordinationLog
            greenTelemetryPort
            "north-telemetry-coord-green.service"
            "0")
        framCutoverChecked
          (pkgs.runCommand
            "fram-cutover-checked"
            {}
            (ms (s "cutover=" framPkg "/bin/fram-cutover")
                "if [ ! -x \"$cutover\" ]; then"
                "  echo \"pinned Fram lacks fram-cutover\" >&2"
                "  exit 1"
                "fi"
                "mkdir -p \"$out/bin\""
                "cp \"$cutover\" \"$out/bin/fram-cutover\""))
        slotStart
          (pkgs.writeShellApplication
            {:name "north-coord-slot-start"
             :runtimeInputs (nix/with pkgs [bash coreutils])
             :text (builtins.readFile (p "./north-coord-slot-start"))})
        cutoverGate
          (pkgs.writeShellApplication
            {:name "north-coord-cutover-gate"
             :runtimeInputs (nix/with pkgs [babashka bash coreutils])
             :text
              (ms (s "export NORTH_COORD_CUTOVER_BIN="
                     framCutoverChecked "/bin/fram-cutover")
                  (s "export NORTH_COORD_CUTOVER_TOKEN_FILE=" cutoverToken)
                  (s "export NORTH_COORD_CUTOVER_STATE=" cutoverState)
                  (s "export NORTH_COORD_COORD_LOG=" coordinationLog)
                  (s "export NORTH_COORD_TELEMETRY_LOG=" telemetryLog)
                  (s "export NORTH_COORD_BLUE_COORD_PORT=" blueCoordPort)
                  (s "export NORTH_COORD_BLUE_TELEMETRY_PORT="
                     blueTelemetryPort)
                  (s "export NORTH_COORD_GREEN_COORD_PORT=" greenCoordPort)
                  (s "export NORTH_COORD_GREEN_TELEMETRY_PORT="
                     greenTelemetryPort)
                  (builtins.readFile (p "./north-coord-cutover-gate")))})
        selectorPromote
          (pkgs.writeShellApplication
            {:name "north-coord-selector-promote"
             :runtimeInputs [cutoverGate]
             :text
              (ms (s "exec " cutoverGate
                     "/bin/north-coord-cutover-gate promote \"$@\""))})
        selectorPrepare
          (pkgs.writeShellApplication
            {:name "north-coord-selector-prepare"
             :runtimeInputs [cutoverGate]
             :text
              (ms (s "exec " cutoverGate
                     "/bin/north-coord-cutover-gate prepare \"$@\""))})
        selectorRollback
          (pkgs.writeShellApplication
            {:name "north-coord-selector-rollback"
             :runtimeInputs [cutoverGate]
             :text
              (ms (s "exec " cutoverGate
                     "/bin/north-coord-cutover-gate rollback \"$@\""))})
        selectorVerify
          (pkgs.writeShellApplication
            {:name "north-coord-selector-verify"
             :runtimeInputs [cutoverGate]
             :text
              (ms (s "exec " cutoverGate
                     "/bin/north-coord-cutover-gate verify \"$@\""))})
        selector
          (pkgs.writeShellApplication
            {:name "north-coord-selector"
             :runtimeInputs
              (nix/with pkgs [bash coreutils gawk socat util-linux])
             :text
              (ms (s "export NORTH_COORD_SELECTOR_SOCKET=" proxyAdminSocket)
                  (s "export NORTH_COORD_SELECTOR_MAP=" selectorMap)
                  (s "export NORTH_COORD_SELECTOR_FRONTEND=" proxyFrontend)
                  (s "export NORTH_COORD_SELECTOR_LOCK=" selectorLock)
                  (s "export NORTH_COORD_SELECTOR_OWNER=" username)
                  "export NORTH_COORD_SELECTOR_GROUP=users"
                  (s "export NORTH_COORD_SELECTOR_TRANSACTION="
                     selectorTransaction)
                  (s "export NORTH_COORD_SELECTOR_PREPARE_COMMAND="
                     selectorPrepare "/bin/north-coord-selector-prepare")
                  (s "export NORTH_COORD_SELECTOR_PROMOTE_COMMAND="
                     selectorPromote "/bin/north-coord-selector-promote")
                  (s "export NORTH_COORD_SELECTOR_ROLLBACK_COMMAND="
                     selectorRollback "/bin/north-coord-selector-rollback")
                  (s "export NORTH_COORD_SELECTOR_VERIFY_COMMAND="
                     selectorVerify "/bin/north-coord-selector-verify")
                  ;; Long-lived listen/subscription sockets do not drain by
                  ;; themselves. Preserve a short grace for ordinary requests,
                  ;; then close only old-generation backend sessions and prove
                  ;; the frontend drained before authority changes.
                  "export NORTH_COORD_SELECTOR_DRAIN_GRACE_MS=1500"
                  "export NORTH_COORD_SELECTOR_DRAIN_TIMEOUT=5"
                  (builtins.readFile (p "./north-coord-selector")))})
        proxyConfig
          (pkgs.writeText
            "north-coord-haproxy.cfg"
            (ms "global"
                (s "  stats socket " proxyAdminSocket
                   " mode 600 level admin")
                "  maxconn 4096"
                ""
                "defaults"
                "  mode tcp"
                "  timeout connect 2s"
                ;; North listeners are intentionally idle between peer
                ;; messages. Keep those subscriptions stable in steady state;
                ;; selector cutover explicitly closes old-backend sessions.
                "  timeout client 1h"
                "  timeout server 1h"
                ""
                (s "frontend " proxyFrontend)
                "  bind fd@3"
                "  bind fd@4"
                "  acl is_coord dst_port 7977"
                (s "  acl route_blue str(active),map(" selectorMap
                   ") -m str blue")
                "  use_backend coord-blue if is_coord route_blue"
                "  use_backend coord-green if is_coord !route_blue"
                "  use_backend telemetry-blue if !is_coord route_blue"
                "  default_backend telemetry-green"
                ""
                "backend coord-blue"
                (s "  server only 127.0.0.1:" blueCoordPort)
                "backend coord-green"
                (s "  server only 127.0.0.1:" greenCoordPort)
                "backend telemetry-blue"
                (s "  server only 127.0.0.1:" blueTelemetryPort)
                "backend telemetry-green"
                (s "  server only 127.0.0.1:" greenTelemetryPort)))
        proxyStart
          (pkgs.writeShellApplication
            {:name "north-coord-proxy-start"
             :runtimeInputs (nix/with pkgs [bash coreutils haproxy])
             :text
              (ms (s "export NORTH_COORD_HAPROXY=" pkgs.haproxy
                     "/bin/haproxy")
                  (s "export NORTH_COORD_HAPROXY_CONFIG=" proxyConfig)
                  (builtins.readFile (p "./north-coord-proxy-start")))})
        bootstrap
          (pkgs.writeShellApplication
            {:name "north-coord-bootstrap"
             :runtimeInputs
              (nix/with pkgs [bash coreutils procps systemd])
             :text
              (ms (s "export NORTH_COORD_CUTOVER_USER=" username)
                  "export NORTH_COORD_CUTOVER_GROUP=users"
                  (s "export NORTH_COORD_CUTOVER_STATE=" cutoverState)
                  (s "export NORTH_COORD_CUTOVER_TOKEN_FILE=" cutoverToken)
                  (s "export NORTH_COORD_SELECTOR_MAP=" selectorMap)
                  (s "export NORTH_COORD_BOOTSTRAP_MARKER=" bootstrapMarker)
                  (s "export NORTH_COORD_LEGACY_HOLD_MARKER="
                     legacyHoldMarker)
                  (s "export NORTH_COORD_CUTOVER_GATE=" cutoverGate
                     "/bin/north-coord-cutover-gate")
                  (s "export NORTH_COORD_SELECTOR=" selector
                     "/bin/north-coord-selector")
                  (s "export NORTH_COORD_COORD_LOG=" coordinationLog)
                  (s "export NORTH_COORD_TELEMETRY_LOG=" telemetryLog)
                  ;; Private JVMs become systemd-active before the initial
                  ;; whole-log fold opens their cutover endpoints. Keep the
                  ;; authority proof exact, but give each started pair a
                  ;; finite readiness window.
                  "export NORTH_COORD_BOOTSTRAP_READY_TIMEOUT_SECONDS=90"
                  "export NORTH_COORD_BOOTSTRAP_READY_INTERVAL_SECONDS=1"
                  ;; Type=simple also marks HAProxy active before its runtime
                  ;; admin socket accepts selector probes.
                  "export NORTH_COORD_PROXY_READY_TIMEOUT_SECONDS=15"
                  (builtins.readFile (p "./north-coord-bootstrap")))})
        serviceEnvironment
          {:HOME homeDir
           :FRAM_REQUIRE_LOG_FENCE "1"
           :FRAM_QUERY_TIMEOUT_MS "30000"
           :FRAM_TELEMETRY_LOG (s homeDir "/.local/state/north/telemetry.log")
           :JDK_JAVA_OPTIONS "-Xmx6g"}
        serviceConfigBase
          {:Type             "simple"
           :User             username
           :WorkingDirectory homeDir
           :Restart          "always"
           :RestartSec       2
           ;; Fram's coordinated shutdown has an internal eight-second bound.
           ;; Preserve a small diagnostic margin, then let systemd terminate a
           ;; wedged generation instead of holding the pair cutover for 90s.
           :TimeoutStopSec   "15s"
           :SendSIGKILL      true
           :MemorySwapMax    "0"}
        mkSlotService
          (fn [description slot runtimeCommand peerLog heapMax memoryMax]
            {:description description
             ;; Private generations are staged explicitly. Ordinary Firn
             ;; activation updates their definitions but never bounces a live
             ;; database or proxy process.
             :restartIfChanged false
             :stopIfChanged false
             :after ["network.target"]
             :path (nix/with pkgs [clojure jdk bash coreutils git])
             :startLimitIntervalSec 0
             :unitConfig {:ConditionPathExists cutoverToken}
             :environment
              (// serviceEnvironment
                  {:FRAM_TELEMETRY_LOG peerLog
                   :JDK_JAVA_OPTIONS heapMax
                   :NORTH_COORD_SLOT slot
                   :NORTH_COORD_SELECTOR_MAP selectorMap
                   :NORTH_COORD_CUTOVER_TOKEN_FILE cutoverToken
                   :NORTH_COORD_SLOT_RUNTIME runtimeCommand})
             :serviceConfig
              (// serviceConfigBase
                  {:MemoryMax memoryMax
                   ;; Private candidates fold and fence their own one-log
                   ;; endpoint on start. The legacy pair-level `prepare`
                   ;; transaction is coordination-owner-only and must never
                   ;; run for telemetry or a private standby.
                   :ExecStartPre
                    [(s runtimeCommand " ensure-default")]
                   :ExecStart
                    (s slotStart "/bin/north-coord-slot-start")})})]
    {:options.myConfig.modules.north-coord.enable
      (lib.mkEnableOption "Personal North coordinator daemon (:7977) — sole-writer fact-graph service for Tom's canonical log")
     ;; Socket activation is gated OFF until the Fram daemon consumes the
     ;; inherited fd and the selected North package ships north-coord-sd-listen.
     ;; The wrapper currently exists only on an unlanded North lane, not on
     ;; North main or in the pinned package.
     :options.myConfig.modules.north-coord.socketActivation
      (lib.mkEnableOption "systemd socket activation for :7977 (requires the Fram fd-consumer and north-coord-sd-listen)")
     :options.myConfig.modules.north-coord.stageATelemetryPartition
      (lib.mkEnableOption
        "independent single-origin coordination (:7977) and telemetry (:7978) writers; option-off is the no-data-migration rollback")
     :config
      (lib.mkIf config.myConfig.modules.north-coord.enable
        {:assertions
          [{:assertion (or (not stageA)
                           config.myConfig.modules.north-coord.socketActivation)
            :message
             "north-coord.stageATelemetryPartition requires socketActivation so both writer ports remain systemd-owned"}]
         :environment.systemPackages
          (++ [northCoordRuntime]
              (lib.optional stageA northTelemetryCoordRuntime)
              (if stageA
                [selector cutoverGate bootstrap]
                []))
         :environment.variables
          (lib.mkIf stageA
            {:NORTH_TELEMETRY_PARTITION "1"
             :NORTH_TELEMETRY_PORT "7978"
             :FRAM_TELEMETRY_LOG
              (s homeDir "/.local/state/north/telemetry.log")})
         :home-manager.users
          {username
            (nix/module [config ...]
              {:home.sessionVariables
                (lib.mkIf stageA
                  {:NORTH_TELEMETRY_PARTITION "1"
                   :NORTH_TELEMETRY_PORT "7978"
                   :FRAM_TELEMETRY_LOG
                    (s homeDir "/.local/state/north/telemetry.log")})})}
         :systemd.sockets.north-coord
          (lib.mkIf config.myConfig.modules.north-coord.socketActivation
            {:description  "North coordinator activation socket (:7977)"
             ;; The public socket is infrastructure, not a member of one
             ;; database generation. Keep it bound across pair replacement and
             ;; ordinary NixOS activation so clients queue instead of seeing
             ;; ECONNREFUSED.
             :wantedBy     ["sockets.target"]
             :listenStreams ["127.0.0.1:7977"]
             :socketConfig {;; HOLD deliberately leaves the permanent listener
                            ;; open while neither legacy writer is eligible.
                            ;; Keep PollLimit throttling, but disable systemd's
                            ;; fatal activation limit so queued clients cannot
                            ;; permanently fail the public socket.
                            :TriggerLimitIntervalSec 0
                            :Backlog 4096
                            :FileDescriptorName "north-coord"}})
         :systemd.sockets.north-telemetry-coord
          (lib.mkIf stageA
            {:description  "North telemetry coordinator activation socket (:7978)"
             :wantedBy     ["sockets.target"]
             :listenStreams ["127.0.0.1:7978"]
             :socketConfig {:TriggerLimitIntervalSec 0
                            :Backlog 4096
                            ;; north-coord-sd-listen validates the inherited
                            ;; descriptor contract, not the unit name. Both
                            ;; isolated writers use the same adapter contract.
                            :FileDescriptorName "north-coord"}})
         :systemd.targets.north-coord-pair
          (lib.mkIf stageA
            {:description "North Stage-A coordination + telemetry writer pair"
             :wantedBy ["multi-user.target"]
             :requires ["north-coord-pair-prepare.service"]
             :after ["north-coord-pair-prepare.service"]
             :wants ["north-coord.socket"
                     "north-telemetry-coord.socket"
                     "north-coord.service"
                     "north-telemetry-coord.service"
                     "north-coord-pair-settle.service"]})
         :systemd.targets.north-coord-blue-green
          (lib.mkIf stageA
            {:description "North durable blue/green coordinator pair"
             :unitConfig {:ConditionPathExists bootstrapMarker}
             :requires ["north-coord.socket"
                        "north-telemetry-coord.socket"]
             :wants ["north-coord-blue.service"
                     "north-telemetry-coord-blue.service"
                     "north-coord-green.service"
                     "north-telemetry-coord-green.service"
                     "north-coord-proxy.service"]
             :after ["north-coord-blue.service"
                     "north-telemetry-coord-blue.service"
                     "north-coord-green.service"
                     "north-telemetry-coord-green.service"
                     "north-coord-proxy.service"]})
         :systemd.services.north-coord-pair-prepare
          (lib.mkIf stageA
            {:description "Prepare both North Stage-A writer runtimes"
             :unitConfig
              {:ConditionPathExists (s "!" bootstrapMarker)}
             ;; A system generation may stage a new Fram package, but staging
             ;; is not a database cutover. Keep this required oneshot active so
             ;; activation cannot cascade-stop either writer through Requires=.
             ;; The explicit pair cutover restarts preparation deliberately.
             :restartIfChanged false
             :stopIfChanged false
             :before ["north-coord.service" "north-telemetry-coord.service"]
             :serviceConfig
              {:Type "oneshot"
               :User username
               :WorkingDirectory homeDir
               :RemainAfterExit true
               :ExecStartPre
                [(s northCoordRuntime "/bin/north-coord-runtime ensure-default")
                 (s northTelemetryCoordRuntime
                    "/bin/north-telemetry-coord-runtime ensure-default")]
               :ExecStart
                (s northCoordRuntime "/bin/north-coord-runtime prepare")}})
         :systemd.services.north-coord-pair-settle
          (lib.mkIf stageA
            {:description "Settle the North Stage-A pair after both writers start"
             :unitConfig
              {:ConditionPathExists (s "!" bootstrapMarker)}
             :restartIfChanged false
             :stopIfChanged false
             :requires ["north-coord.service" "north-telemetry-coord.service"]
             :after ["north-coord.service" "north-telemetry-coord.service"]
             :serviceConfig
              {:Type "oneshot"
               :User username
               :WorkingDirectory homeDir
               :ExecStart
                (s northCoordRuntime "/bin/north-coord-runtime settle")}})
         :systemd.services.north-coord
          {:description           "North coordinator — personal fact-graph daemon (:7977)"
           :wantedBy              (if stageA [] ["multi-user.target"])
           :unitConfig
            (lib.mkIf stageA
              {:ConditionPathExists
                [(s "!" bootstrapMarker)
                 (s "!" legacyHoldMarker)]})
           :partOf                (lib.optional stageA pairTarget)
           :requires
             (concat
               (lib.optional
                 config.myConfig.modules.north-coord.socketActivation
                 "north-coord.socket")
               (lib.optional stageA "north-coord-pair-prepare.service"))
           :after
             (concat ["network.target"]
                     (lib.optional config.myConfig.modules.north-coord.socketActivation
                                   "north-coord.socket")
                     (lib.optional stageA "north-coord-pair-prepare.service"))
           :path                  (nix/with pkgs [clojure jdk bash coreutils git])
           ;; The socket unit owns :7977 across service restarts. A foreign
           ;; listener therefore fails north-coord.socket itself; the service
           ;; never mistakes its inherited system socket for a foreign owner.
           :startLimitIntervalSec 0
           ;; A system generation change is not a database cutover. Keep the
           ;; serving process alive; an explicit, readiness-gated coordinator
           ;; handoff promotes the new Fram runtime separately. The permanent
           ;; socket above remains owned by systemd throughout either operation.
           :restartIfChanged      false
           :stopIfChanged         false
           :environment
            (// serviceEnvironment
                {:JDK_JAVA_OPTIONS "-Xmx16g"})
           :serviceConfig
            (//
             serviceConfigBase
             {
             ;; A merged coordination graph can transiently retain an old
             ;; immutable Store, a candidate Store, and query indexes together.
             ;; Keep native/JVM overhead outside the -Xmx16g heap from tripping a
             ;; cgroup kill while the incremental reload path bounds that peak.
             :MemoryMax "32G"
             :Sockets
              (lib.mkIf
                config.myConfig.modules.north-coord.socketActivation
                "north-coord.socket")
             ;; Socket ownership removes the old stop/bind race. The adapter
             ;; validates LISTEN_FDS before the selected Fram runtime starts.
             :ExecStartPre
              (if stageA
                []
                [(s northCoordRuntime "/bin/north-coord-runtime ensure-default")
                 (s northCoordRuntime "/bin/north-coord-runtime prepare")])
             ;; Direct start is the safe default. Socket activation references a
             ;; checked derivation, so a package without the wrapper fails while
             ;; building the system closure instead of at activation with 203/EXEC.
             :ExecStart
               (if config.myConfig.modules.north-coord.socketActivation
                 (s northCoordSdListenChecked "/bin/north-coord-sd-listen "
                    northCoordRuntime "/bin/north-coord-runtime start")
                 (s northCoordRuntime "/bin/north-coord-runtime start"))
             :ExecStartPost
              (lib.mkIf (not stageA)
                (s northCoordRuntime "/bin/north-coord-runtime settle"))})}
         :systemd.services.north-telemetry-coord
          (lib.mkIf stageA
            {:description "North telemetry coordinator — sole writer (:7978)"
             :unitConfig
              {:ConditionPathExists
                [(s "!" bootstrapMarker)
                 (s "!" legacyHoldMarker)]}
             :partOf [pairTarget]
             :requires ["north-telemetry-coord.socket"
                        "north-coord-pair-prepare.service"]
             :after ["network.target"
                     "north-telemetry-coord.socket"
                     "north-coord-pair-prepare.service"]
             :path (nix/with pkgs [clojure jdk bash coreutils git])
             :startLimitIntervalSec 0
             :restartIfChanged false
             :stopIfChanged false
             :environment
              (// serviceEnvironment
                  {:FRAM_TELEMETRY_LOG
                    (s homeDir "/.local/state/north/coordination.log")})
             :serviceConfig
              (//
              serviceConfigBase
               {:MemoryMax "8G"
                :Sockets "north-telemetry-coord.socket"
                :ExecStart
                 (s northCoordSdListenChecked "/bin/north-coord-sd-listen "
                    northTelemetryCoordRuntime
                    "/bin/north-telemetry-coord-runtime start")})})
         :systemd.services.north-coord-blue
          (lib.mkIf stageA
            (mkSlotService
              "North coordination private blue generation (:17977)"
              "blue"
              (s blueCoordRuntime "/bin/north-coord-blue-runtime")
              telemetryLog
              "-Xmx16g"
              "32G"))
         :systemd.services.north-telemetry-coord-blue
          (lib.mkIf stageA
            (mkSlotService
              "North telemetry private blue generation (:17978)"
              "blue"
              (s blueTelemetryRuntime
                 "/bin/north-telemetry-coord-blue-runtime")
              coordinationLog
              "-Xmx6g"
              "8G"))
         :systemd.services.north-coord-green
          (lib.mkIf stageA
            (mkSlotService
              "North coordination private green generation (:27977)"
              "green"
              (s greenCoordRuntime "/bin/north-coord-green-runtime")
              telemetryLog
              "-Xmx16g"
              "32G"))
         :systemd.services.north-telemetry-coord-green
          (lib.mkIf stageA
            (mkSlotService
              "North telemetry private green generation (:27978)"
              "green"
              (s greenTelemetryRuntime
                 "/bin/north-telemetry-coord-green-runtime")
              coordinationLog
              "-Xmx6g"
              "8G"))
         :systemd.services.north-coord-proxy
          (lib.mkIf stageA
            {:description
              "North permanent public selector for coordination + telemetry"
             :requires ["north-coord.socket"
                        "north-telemetry-coord.socket"]
             :wants ["north-coord-blue.service"
                     "north-telemetry-coord-blue.service"
                     "north-coord-green.service"
                     "north-telemetry-coord-green.service"]
             :after ["north-coord.socket"
                     "north-telemetry-coord.socket"
                     "north-coord-blue.service"
                     "north-telemetry-coord-blue.service"
                     "north-coord-green.service"
                     "north-telemetry-coord-green.service"]
             ;; Installing or updating this definition is not a database
             ;; cutover. The explicit selector/bootstrap commands own process
             ;; replacement.
             :restartIfChanged false
             :stopIfChanged false
             :unitConfig
              {:ConditionPathExists bootstrapMarker}
             :environment
              {:NORTH_COORD_BOOTSTRAP_MARKER bootstrapMarker}
             :path (nix/with pkgs [bash coreutils haproxy socat util-linux])
             :serviceConfig
              {:Type "simple"
               :User username
               :WorkingDirectory homeDir
               :RuntimeDirectory "north-coord-proxy"
               :RuntimeDirectoryMode "0700"
               :Restart "always"
               :RestartSec 1
               :TimeoutStopSec "15s"
               :SendSIGKILL true
               :Sockets ["north-coord.socket"
                         "north-telemetry-coord.socket"]
               :ExecStartPre
                [(s selector "/bin/north-coord-selector prestart")]
               :ExecStart
                (s proxyStart "/bin/north-coord-proxy-start")}})
         :systemd.services.north-coord-bootstrap
          (lib.mkIf stageA
            {:description
              "One-time bounded legacy-to-blue-green North migration"
             ;; Explicit operator action only: `sudo north-coord-bootstrap`.
             :restartIfChanged false
             :stopIfChanged false
             :serviceConfig
              {:Type "oneshot"
               :ExecStart
                (s bootstrap "/bin/north-coord-bootstrap")}})
         :systemd.services.north-coord-blue-green-resume
          (lib.mkIf stageA
            {:description
              "Resume the durable North blue/green pair after boot"
             :wantedBy ["multi-user.target"]
             ;; Conditions cannot conditionalize Wants=. Keep this boot unit
             ;; dependency-free except for the permanent sockets; its ordered,
             ;; idempotent bootstrap command starts and verifies the selected
             ;; pair, then the read-only pair, then the proxy.
             :unitConfig {:ConditionPathExists bootstrapMarker}
             :requires ["north-coord.socket"
                        "north-telemetry-coord.socket"]
             :after ["network.target"
                     "north-coord.socket"
                     "north-telemetry-coord.socket"]
             :restartIfChanged false
             :stopIfChanged false
             :serviceConfig
              {:Type "oneshot"
               :RemainAfterExit true
               :ExecStart
                (s bootstrap "/bin/north-coord-bootstrap")}})})}))
