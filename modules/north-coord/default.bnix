#lang beagle/nix

(ns default)

;; North coordinator (:7977) — sole-writer daemon serving Tom's canonical
;; fact log (~/.local/state/north/coordination.log; the 2026-07-16 log split
;; peeled telemetry into telemetry.log beside it — facts.log is the frozen
;; pre-split backup). Sibling of agent-coord (:7978)
;; and attention-coord (:7980): same coordinator family, different stores. JVM
;; runtime — long-lived server wants JIT throughput + real threads. Systemd owns
;; the one serving process so :7977 survives logout + reboot without racing a
;; checkout-side supervisor. Before every start, the service ensures that one
;; valid sealed selection exists, under ONE desired-mode rule per system
;; generation: package mode is the steady state and is re-pointed at this
;; generation's pinned Fram package on every start, so identical code never
;; reads as source-mode divergence after a switch; an explicit development
;; promotion is an announced override that survives until an explicit package
;; reset. north-coord-runtime serializes writers, materializes exact detached
;; Fram revisions, and atomically publishes complete current/previous
;; generations.

(nix/module [config lib pkgs inputs ...]
  (let [username config.myConfig.modules.users.username
        homeDir  config.myConfig.modules.users.homeDir
        framPkg
          (get (get inputs.fram.packages pkgs.stdenv.hostPlatform.system)
               :default)
        framRev inputs.fram.rev
        northPkg
          (get (get inputs.north.packages pkgs.stdenv.hostPlatform.system)
               :default)
        northCoordSdListenChecked
          (pkgs.runCommand
            "north-coord-sd-listen-checked"
            {}
            (ms (s "wrapper=" northPkg "/bin/north-coord-sd-listen")
                "if [ ! -x \"$wrapper\" ]; then"
                "  echo \"north-coord socketActivation requires executable $wrapper\" >&2"
                "  exit 1"
                "fi"
                "mkdir -p \"$out/bin\""
                "ln -s \"$wrapper\" \"$out/bin/north-coord-sd-listen\""))
        runtimeState (s homeDir "/.local/state/north/fram-runtime")
        telemetryRuntimeState
          (s homeDir "/.local/state/north/fram-telemetry-runtime")
        stageA
          config.myConfig.modules.north-coord.stageATelemetryPartition
        pairTarget "north-coord-pair.target"
        mkNorthCoordRuntime
          (fn [name state primaryLog peerLog port unit transactionOwner]
            (pkgs.writeShellApplication
              {:name name
               :runtimeInputs (nix/with pkgs [bash coreutils git iproute2 systemd util-linux])
               :text
                (ms (s "export NORTH_COORD_RUNTIME_STATE=" state)
                    (s "export NORTH_COORD_FRAM_PACKAGE=" framPkg)
                    (s "export NORTH_COORD_FRAM_PACKAGE_REV=" framRev)
                    (s "export NORTH_COORD_FRAM_CHECKOUT=" homeDir "/code/fram")
                    (s "export NORTH_COORD_NORTH_PACKAGE=" northPkg)
                    (s "export NORTH_COORD_FRAM_LOG=" primaryLog)
                    (s "export NORTH_COORD_TELEMETRY_LOG=" peerLog)
                    (s "export NORTH_COORD_SYSTEMD_UNIT=" unit)
                    (s "export NORTH_COORD_FRAM_PORT=" port)
                    "export NORTH_COORD_TELEMETRY_PORT=7978"
                    (s "export NORTH_COORD_SINGLE_ORIGIN=" (if stageA "1" "0"))
                    (s "export NORTH_COORD_TRANSACTION_OWNER=" transactionOwner)
                    (s "export NORTH_COORD_CORPUS_SYSTEMD_UNIT="
                       (if stageA pairTarget unit))
                    (s "export NORTH_COORD_RESTART_SYSTEMD_UNIT="
                       (if stageA pairTarget unit))
                    (builtins.readFile (p "./north-coord-runtime")))}))
        northCoordRuntime
          (mkNorthCoordRuntime
            "north-coord-runtime"
            runtimeState
            (s homeDir "/.local/state/north/coordination.log")
            (s homeDir "/.local/state/north/telemetry.log")
            "7977"
            "north-coord.service"
            "1")
        northTelemetryCoordRuntime
          (mkNorthCoordRuntime
            "north-telemetry-coord-runtime"
            telemetryRuntimeState
            (s homeDir "/.local/state/north/telemetry.log")
            (s homeDir "/.local/state/north/coordination.log")
            "7978"
            "north-telemetry-coord.service"
            "0")
        serviceEnvironment
          {:HOME homeDir
           :FRAM_REQUIRE_LOG_FENCE "1"
           :FRAM_QUERY_TIMEOUT_MS "30000"
           :FRAM_TELEMETRY_LOG (s homeDir "/.local/state/north/telemetry.log")
           :JDK_JAVA_OPTIONS "-Xmx6g"}
        serviceConfigBase
          {:Type             "simple"
           :User             username
           :WorkingDirectory homeDir
           :Restart          "always"
           :RestartSec       2
           :MemorySwapMax    "0"}]
    {:options.myConfig.modules.north-coord.enable
      (lib.mkEnableOption "Personal North coordinator daemon (:7977) — sole-writer fact-graph service for Tom's canonical log")
     ;; Socket activation is gated OFF until the Fram daemon consumes the
     ;; inherited fd and the selected North package ships north-coord-sd-listen.
     ;; The wrapper currently exists only on an unlanded North lane, not on
     ;; North main or in the pinned package.
     :options.myConfig.modules.north-coord.socketActivation
      (lib.mkEnableOption "systemd socket activation for :7977 (requires the Fram fd-consumer and north-coord-sd-listen)")
     :options.myConfig.modules.north-coord.stageATelemetryPartition
      (lib.mkEnableOption
        "independent single-origin coordination (:7977) and telemetry (:7978) writers; option-off is the no-data-migration rollback")
     :config
      (lib.mkIf config.myConfig.modules.north-coord.enable
        {:assertions
          [{:assertion (or (not stageA)
                           config.myConfig.modules.north-coord.socketActivation)
            :message
             "north-coord.stageATelemetryPartition requires socketActivation so both writer ports remain systemd-owned"}]
         :environment.systemPackages
          (++ [northCoordRuntime]
              (lib.optional stageA northTelemetryCoordRuntime))
         :environment.variables
          (lib.mkIf stageA
            {:NORTH_TELEMETRY_PARTITION "1"
             :NORTH_TELEMETRY_PORT "7978"
             :FRAM_TELEMETRY_LOG
              (s homeDir "/.local/state/north/telemetry.log")})
         :home-manager.users
          {username
            (nix/module [config ...]
              {:home.sessionVariables
                (lib.mkIf stageA
                  {:NORTH_TELEMETRY_PARTITION "1"
                   :NORTH_TELEMETRY_PORT "7978"
                   :FRAM_TELEMETRY_LOG
                    (s homeDir "/.local/state/north/telemetry.log")})})}
         :systemd.sockets.north-coord
          (lib.mkIf config.myConfig.modules.north-coord.socketActivation
            {:description  "North coordinator activation socket (:7977)"
             ;; The public socket is infrastructure, not a member of one
             ;; database generation. Keep it bound across pair replacement and
             ;; NixOS activation so clients queue instead of seeing ECONNREFUSED.
             :wantedBy     ["sockets.target"]
             :stopIfChanged false
             :listenStreams ["127.0.0.1:7977"]
             :socketConfig {:Backlog 4096
                            :FileDescriptorName "north-coord"}})
         :systemd.sockets.north-telemetry-coord
          (lib.mkIf stageA
            {:description  "North telemetry coordinator activation socket (:7978)"
             :wantedBy     ["sockets.target"]
             :stopIfChanged false
             :listenStreams ["127.0.0.1:7978"]
             :socketConfig {:Backlog 4096
                            ;; north-coord-sd-listen validates the inherited
                            ;; descriptor contract, not the unit name. Both
                            ;; isolated writers use the same adapter contract.
                            :FileDescriptorName "north-coord"}})
         :systemd.targets.north-coord-pair
          (lib.mkIf stageA
            {:description "North Stage-A coordination + telemetry writer pair"
             :wantedBy ["multi-user.target"]
             :requires ["north-coord-pair-prepare.service"]
             :after ["north-coord-pair-prepare.service"]
             :wants ["north-coord.socket"
                     "north-telemetry-coord.socket"
                     "north-coord.service"
                     "north-telemetry-coord.service"
                     "north-coord-pair-settle.service"]})
         :systemd.services.north-coord-pair-prepare
          (lib.mkIf stageA
            {:description "Prepare both North Stage-A writer runtimes"
             :before ["north-coord.service" "north-telemetry-coord.service"]
             :serviceConfig
              {:Type "oneshot"
               :User username
               :WorkingDirectory homeDir
               :RemainAfterExit true
               :ExecStartPre
                [(s northCoordRuntime "/bin/north-coord-runtime ensure-default")
                 (s northTelemetryCoordRuntime
                    "/bin/north-telemetry-coord-runtime ensure-default")]
               :ExecStart
                (s northCoordRuntime "/bin/north-coord-runtime prepare")}})
         :systemd.services.north-coord-pair-settle
          (lib.mkIf stageA
            {:description "Settle the North Stage-A pair after both writers start"
             :requires ["north-coord.service" "north-telemetry-coord.service"]
             :after ["north-coord.service" "north-telemetry-coord.service"]
             :serviceConfig
              {:Type "oneshot"
               :User username
               :WorkingDirectory homeDir
               :ExecStart
                (s northCoordRuntime "/bin/north-coord-runtime settle")}})
         :systemd.services.north-coord
          {:description           "North coordinator — personal fact-graph daemon (:7977)"
           :wantedBy              (if stageA [] ["multi-user.target"])
           :partOf                (lib.optional stageA pairTarget)
           :requires
             (concat
               (lib.optional
                 config.myConfig.modules.north-coord.socketActivation
                 "north-coord.socket")
               (lib.optional stageA "north-coord-pair-prepare.service"))
           :after
             (concat ["network.target"]
                     (lib.optional config.myConfig.modules.north-coord.socketActivation
                                   "north-coord.socket")
                     (lib.optional stageA "north-coord-pair-prepare.service"))
           :path                  (nix/with pkgs [clojure jdk bash coreutils git])
           ;; The socket unit owns :7977 across service restarts. A foreign
           ;; listener therefore fails north-coord.socket itself; the service
           ;; never mistakes its inherited system socket for a foreign owner.
           :startLimitIntervalSec 0
           ;; A system generation change is not a database cutover. Keep the
           ;; serving process alive; an explicit, readiness-gated coordinator
           ;; handoff promotes the new Fram runtime separately. The permanent
           ;; socket above remains owned by systemd throughout either operation.
           :restartIfChanged      false
           :stopIfChanged         false
           :environment           serviceEnvironment
           :serviceConfig
            (//
             serviceConfigBase
             {
             ;; A merged coordination graph can transiently retain an old
             ;; immutable Store, a candidate Store, and query indexes together.
             ;; Keep native/JVM overhead outside the -Xmx6g heap from tripping a
             ;; cgroup kill while the incremental reload path bounds that peak.
             :MemoryMax "24G"
             ;; Socket ownership removes the old stop/bind race. The adapter
             ;; validates LISTEN_FDS before the selected Fram runtime starts.
             :ExecStartPre
              (if stageA
                []
                [(s northCoordRuntime "/bin/north-coord-runtime ensure-default")
                 (s northCoordRuntime "/bin/north-coord-runtime prepare")])
             ;; Direct start is the safe default. Socket activation references a
             ;; checked derivation, so a package without the wrapper fails while
             ;; building the system closure instead of at activation with 203/EXEC.
             :ExecStart
               (if config.myConfig.modules.north-coord.socketActivation
                 (s northCoordSdListenChecked "/bin/north-coord-sd-listen "
                    northCoordRuntime "/bin/north-coord-runtime start")
                 (s northCoordRuntime "/bin/north-coord-runtime start"))
             :ExecStartPost
              (lib.mkIf (not stageA)
                (s northCoordRuntime "/bin/north-coord-runtime settle"))})}
         :systemd.services.north-telemetry-coord
          (lib.mkIf stageA
            {:description "North telemetry coordinator — sole writer (:7978)"
             :partOf [pairTarget]
             :requires ["north-telemetry-coord.socket"
                        "north-coord-pair-prepare.service"]
             :after ["network.target"
                     "north-telemetry-coord.socket"
                     "north-coord-pair-prepare.service"]
             :path (nix/with pkgs [clojure jdk bash coreutils git])
             :startLimitIntervalSec 0
             :restartIfChanged false
             :stopIfChanged false
             :environment
              (// serviceEnvironment
                  {:FRAM_TELEMETRY_LOG
                    (s homeDir "/.local/state/north/coordination.log")})
             :serviceConfig
              (//
              serviceConfigBase
               {:MemoryMax "8G"
                :ExecStart
                 (s northCoordSdListenChecked "/bin/north-coord-sd-listen "
                    northTelemetryCoordRuntime
                    "/bin/north-telemetry-coord-runtime start")})})})}))
