#lang beagle/nix

(ns default)

;; North coordinator (:7977) — sole-writer daemon serving Tom's canonical
;; fact log (~/.local/state/north/coordination.log; the 2026-07-16 log split
;; peeled telemetry into telemetry.log beside it — facts.log is the frozen
;; pre-split backup). Sibling of agent-coord (:7978)
;; and attention-coord (:7980): same coordinator family, different stores. JVM
;; runtime — long-lived server wants JIT throughput + real threads. Systemd owns
;; the one serving process so :7977 survives logout + reboot without racing a
;; checkout-side supervisor. Runtime promotion is an independent transaction:
;; north-coord-runtime serializes writers, materializes an exact detached Fram
;; revision, and atomically publishes a complete current/previous generation.
;; The pinned Fram input remains an explicit package-mode selection.

(nix/module [config lib pkgs inputs ...]
  (let [username config.myConfig.modules.users.username
        homeDir  config.myConfig.modules.users.homeDir
        framPkg
          (get (get inputs.fram.packages pkgs.stdenv.hostPlatform.system)
               :default)
        framRev inputs.fram.rev
        runtimeState (s homeDir "/.local/state/north/fram-runtime")
        northCoordRuntime
          (pkgs.writeShellApplication
            {:name "north-coord-runtime"
             :runtimeInputs (nix/with pkgs [bash coreutils git iproute2 util-linux])
             :text
              (ms (s "export NORTH_COORD_RUNTIME_STATE=" runtimeState)
                  (s "export NORTH_COORD_FRAM_PACKAGE=" framPkg)
                  (s "export NORTH_COORD_FRAM_PACKAGE_REV=" framRev)
                  (s "export NORTH_COORD_FRAM_CHECKOUT=" homeDir "/code/fram")
                  (s "export NORTH_COORD_FRAM_LOG=" homeDir "/.local/state/north/coordination.log")
                  "export NORTH_COORD_FRAM_PORT=7977"
                  (builtins.readFile (p "./north-coord-runtime")))})]
    {:options.myConfig.modules.north-coord.enable
      (lib.mkEnableOption "Personal North coordinator daemon (:7977) — sole-writer fact-graph service for Tom's canonical log")
     :config
      (lib.mkIf config.myConfig.modules.north-coord.enable
        {:environment.systemPackages [northCoordRuntime]
         :systemd.services.north-coord
          {:description           "North coordinator — personal fact-graph daemon (:7977)"
           :wantedBy              ["multi-user.target"]
           :after                 ["network.target"]
           :path                  (nix/with pkgs [clojure jdk bash coreutils git])
           :startLimitIntervalSec 60
           :startLimitBurst       3
           :restartIfChanged      true
           :environment           {:HOME homeDir
                                   :FRAM_REQUIRE_LOG_FENCE "1"
                                   :FRAM_TELEMETRY_LOG (s homeDir "/.local/state/north/telemetry.log")}
           :serviceConfig
            {:Type             "simple"
             :User             username
             :WorkingDirectory homeDir
             :ExecCondition (s northCoordRuntime "/bin/north-coord-runtime preflight")
             :ExecStartPre (s northCoordRuntime "/bin/north-coord-runtime initialize")
             :ExecStart (s northCoordRuntime "/bin/north-coord-runtime start")
             :Restart          "always"
             :RestartSec       2}}})}))
