#!/usr/bin/env bash
set -euo pipefail

umask 077

program=${0##*/}

die() {
  printf '%s: %s\n' "$program" "$*" >&2
  exit 2
}

need_setting() {
  local name=$1
  [[ -n "${!name:-}" ]] || die "required deployment setting is missing: $name"
}

need_setting NORTH_COORD_RUNTIME_STATE
need_setting NORTH_COORD_FRAM_PACKAGE
need_setting NORTH_COORD_FRAM_PACKAGE_REV
need_setting NORTH_COORD_FRAM_CHECKOUT
need_setting NORTH_COORD_NORTH_PACKAGE
need_setting NORTH_COORD_FRAM_LOG
need_setting NORTH_COORD_TELEMETRY_LOG
need_setting NORTH_COORD_FRAM_PORT
need_setting NORTH_COORD_SYSTEMD_UNIT

state_root=$NORTH_COORD_RUNTIME_STATE
state_parent=${state_root%/*}
state_name=${state_root##*/}
deployments=$state_root/deployments
generations=$state_root/generations
active_link=$state_root/active
current_link=$state_root/current
previous_link=$state_root/previous
selector_lock=$state_parent/.${state_name}.lock
initialization_marker=$state_parent/.${state_name}.initialized
runtime_port=$NORTH_COORD_FRAM_PORT
north_package=$(realpath -e "$NORTH_COORD_NORTH_PACKAGE") ||
  die "packaged North root is missing: $NORTH_COORD_NORTH_PACKAGE"
north_binary=$north_package/bin/north
telemetry_log=$NORTH_COORD_TELEMETRY_LOG
transaction_state=$state_parent/corpus-transactions
systemd_unit=$NORTH_COORD_SYSTEMD_UNIT

case "$state_root" in
  /*) ;;
  *) die "runtime state path must be absolute: $state_root" ;;
esac
[[ "$state_parent" != "$state_root" && -n "$state_name" ]] ||
  die "runtime state path must have a parent directory: $state_root"
[[ "$north_package" == "$NORTH_COORD_NORTH_PACKAGE" ]] ||
  die "packaged North root is not canonical: $NORTH_COORD_NORTH_PACKAGE"
[[ -x "$north_binary" ]] || die "packaged North CLI is not executable: $north_binary"
case "$NORTH_COORD_FRAM_LOG" in
  /*) ;;
  *) die "coordination log path must be absolute: $NORTH_COORD_FRAM_LOG" ;;
esac
case "$telemetry_log" in
  /*) ;;
  *) die "telemetry log path must be absolute: $telemetry_log" ;;
esac
[[ "$NORTH_COORD_FRAM_LOG" != "$telemetry_log" ]] ||
  die "coordination and telemetry logs must be distinct"
[[ "$systemd_unit" =~ ^[A-Za-z0-9_.@-]+\.service$ ]] ||
  die "systemd unit name is invalid: $systemd_unit"
if ! [[ "$runtime_port" =~ ^[0-9]+$ ]] ||
   (( 10#$runtime_port < 1 || 10#$runtime_port > 65535 )); then
  die "runtime port must be an integer from 1 through 65535: $runtime_port"
fi
runtime_port=$((10#$runtime_port))

valid_revision() {
  [[ "$1" =~ ^[0-9a-f]{40}$ ]]
}

valid_record_value() {
  [[ -n "$1" && "$1" != *$'\n'* && "$1" != *$'\r'* ]]
}

mint_owner_token() {
  local token

  [[ -r /proc/sys/kernel/random/uuid ]] ||
    die "kernel UUID source is unavailable for runtime ownership"
  token=$(</proc/sys/kernel/random/uuid)
  [[ "$token" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] ||
    die "kernel UUID source returned an invalid owner token"
  printf '%s\n' "${token,,}"
}

process_birth_token() {
  local pid=$1 stat_line remainder start_ticks
  local -a fields

  [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/stat" ]] ||
    die "cannot inspect runtime process birth: $pid"
  stat_line=$(<"/proc/$pid/stat")
  remainder=${stat_line##*) }
  read -r -a fields <<<"$remainder"
  start_ticks=${fields[19]:-}
  [[ "$start_ticks" =~ ^[0-9]+$ ]] ||
    die "runtime process birth is malformed: $pid"
  printf 'proc:%s\n' "$start_ticks"
}

crash_at() {
  [[ "${NORTH_COORD_SELECTOR_CRASH_AT:-}" == "$1" ]] || return 0
  kill -KILL "$$"
}

require_real_directory() {
  local path=$1 label=$2
  [[ -d "$path" && ! -L "$path" ]] || die "$label is not a real directory: $path"
}

prepare_lock() {
  mkdir -p "$state_parent"
  chmod 0700 "$state_parent"
  exec 9>"$selector_lock"
  flock -x 9
}

release_lock() {
  flock -u 9
  exec 9>&-
}

checkout_origin() {
  local source=$1 common_dir origin

  common_dir=$(git -C "$source" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ||
    die "cannot resolve checkout deployment origin: $source"
  case "$common_dir" in
    */.git) origin=${common_dir%/.git} ;;
    *) origin=$common_dir ;;
  esac
  realpath -e "$origin" || die "cannot canonicalize checkout deployment origin: $origin"
}

validate_package_target() {
  local source=$1 canonical_package

  valid_revision "$NORTH_COORD_FRAM_PACKAGE_REV" ||
    die "packaged Fram revision is not an exact Git SHA"
  canonical_package=$(realpath -e "$NORTH_COORD_FRAM_PACKAGE") ||
    die "packaged Fram root is missing: $NORTH_COORD_FRAM_PACKAGE"
  [[ "$source" == "$canonical_package" ]] ||
    die "selected package does not name this system generation's Fram package"
  [[ -x "$source/bin/fram-daemon" ]] ||
    die "packaged Fram daemon is not executable: $source/bin/fram-daemon"

  runtime_mode=package
  runtime_source=$canonical_package
  runtime_revision=$NORTH_COORD_FRAM_PACKAGE_REV
  runtime_tree="immutable:$NORTH_COORD_FRAM_PACKAGE_REV"
  runtime_origin=$canonical_package
  runtime_daemon=$canonical_package/bin/fram-daemon
}

validate_checkout_target() {
  local source=$1 expected_revision=${2:-} expected_origin=${3:-}
  local canonical_source canonical_deployments lexical_source observed_revision observed_tree
  local observed_origin top_level worktree_status

  require_real_directory "$deployments" "deployment root"
  [[ -d "$source" && ! -L "$source" ]] ||
    die "checkout deployment is not a real directory: $source"
  canonical_deployments=$(realpath -e "$deployments") ||
    die "cannot canonicalize deployment root: $deployments"
  canonical_source=$(realpath -e "$source") ||
    die "checkout deployment is missing: $source"
  lexical_source=$canonical_deployments/${source##*/}
  [[ "$canonical_source" == "$lexical_source" ]] ||
    die "checkout deployment path was substituted: $source resolves to $canonical_source"
  [[ -x "$canonical_source/bin/fram-daemon" ]] ||
    die "checkout Fram daemon is not executable: $canonical_source/bin/fram-daemon"
  top_level=$(git -C "$canonical_source" rev-parse --show-toplevel 2>/dev/null) ||
    die "checkout deployment is not a Git worktree root: $canonical_source"
  [[ $(realpath -e "$top_level") == "$canonical_source" ]] ||
    die "checkout deployment is not its Git worktree root: $canonical_source"
  if git -C "$canonical_source" symbolic-ref -q HEAD >/dev/null 2>&1; then
    die "checkout deployment HEAD is attached to a mutable branch: $canonical_source"
  fi
  observed_revision=$(git -C "$canonical_source" rev-parse --verify 'HEAD^{commit}' 2>/dev/null) ||
    die "cannot resolve checkout deployment HEAD"
  valid_revision "$observed_revision" || die "checkout revision is not an exact Git SHA"
  [[ "${source##*/}" == "$observed_revision" ]] ||
    die "checkout deployment directory does not match its HEAD: ${source##*/} != $observed_revision"
  [[ -z "$expected_revision" || "$observed_revision" == "$expected_revision" ]] ||
    die "checkout deployment HEAD differs from requested revision: $observed_revision != $expected_revision"
  git -C "$canonical_source" diff --quiet --no-ext-diff HEAD -- ||
    die "checkout deployment has modified tracked files: $canonical_source"
  git -C "$canonical_source" diff --cached --quiet --no-ext-diff HEAD -- ||
    die "checkout deployment has staged tracked files: $canonical_source"
  worktree_status=$(git -C "$canonical_source" status --porcelain=v1 --untracked-files=all) ||
    die "cannot inspect checkout deployment cleanliness: $canonical_source"
  [[ -z "$worktree_status" ]] ||
    die "checkout deployment contains tracked or untracked worktree changes: $canonical_source"
  observed_tree=$(git -C "$canonical_source" rev-parse --verify 'HEAD^{tree}' 2>/dev/null) ||
    die "cannot resolve checkout deployment tree"
  valid_revision "$observed_tree" || die "checkout tree is not an exact Git object ID"
  observed_origin=$(checkout_origin "$canonical_source")
  if [[ -n "$expected_origin" ]]; then
    [[ "$observed_origin" == "$expected_origin" ]] ||
      die "deployment origin mismatch: wanted $expected_origin, found $observed_origin"
  fi

  runtime_mode=checkout
  runtime_source=$canonical_source
  runtime_revision=$observed_revision
  runtime_tree=$observed_tree
  runtime_origin=$observed_origin
  runtime_daemon=$canonical_source/bin/fram-daemon
}

validate_target() {
  local source=$1 canonical_package

  canonical_package=$(realpath -e "$NORTH_COORD_FRAM_PACKAGE") ||
    die "packaged Fram root is missing: $NORTH_COORD_FRAM_PACKAGE"
  if [[ "$source" == "$canonical_package" ]]; then
    validate_package_target "$source"
  else
    validate_checkout_target "$source"
  fi
}

capture_runtime() {
  local prefix=$1 name runtime_name

  for name in mode source revision tree origin daemon; do
    runtime_name=runtime_$name
    printf -v "${prefix}_${name}" '%s' "${!runtime_name}"
  done
}

require_initialized_layout() {
  local active_target generation canonical_generation

  [[ -f "$initialization_marker" && ! -L "$initialization_marker" ]] ||
    die "runtime selector is not initialized; run: $program initialize"
  [[ $(<"$initialization_marker") == initialized ]] ||
    die "runtime selector initialization is incomplete: $initialization_marker"
  require_real_directory "$state_root" "runtime state root"
  require_real_directory "$deployments" "deployment root"
  require_real_directory "$generations" "generation root"
  [[ -L "$current_link" && $(readlink "$current_link") == active/current ]] ||
    die "stable current selector is missing or substituted: $current_link"
  [[ -L "$previous_link" && $(readlink "$previous_link") == active/previous ]] ||
    die "stable previous selector is missing or substituted: $previous_link"
  [[ -L "$active_link" ]] || die "active runtime generation is missing: $active_link"
  active_target=$(readlink "$active_link")
  [[ "$active_target" =~ ^generations/[A-Za-z0-9._-]+$ ]] ||
    die "active runtime generation target is invalid: $active_target"
  generation=$state_root/$active_target
  [[ -d "$generation" && ! -L "$generation" ]] ||
    die "active runtime generation is not a real directory: $generation"
  [[ -L "$generation/current" && -L "$generation/previous" ]] ||
    die "active runtime generation is incomplete: $generation"
  canonical_generation=$(realpath -e "$generation") ||
    die "cannot canonicalize active runtime generation: $generation"
  active_generation=$canonical_generation
}

restore_runtime() {
  local prefix=$1 name prefixed_name

  for name in mode source revision tree origin daemon; do
    prefixed_name=${prefix}_${name}
    printf -v "runtime_${name}" '%s' "${!prefixed_name}"
  done
}

validate_declared_runtime() {
  local declared_mode=$runtime_mode declared_source=$runtime_source
  local declared_revision=$runtime_revision declared_tree=$runtime_tree
  local declared_origin=$runtime_origin declared_daemon=$runtime_daemon
  local canonical_source canonical_daemon canonical_package

  valid_revision "$declared_revision" || die "declared runtime revision is not an exact Git SHA"
  canonical_source=$(realpath -e "$declared_source") ||
    die "declared runtime source is missing: $declared_source"
  [[ "$canonical_source" == "$declared_source" ]] ||
    die "declared runtime source is not canonical: $declared_source"
  canonical_daemon=$(realpath -e "$declared_daemon") ||
    die "declared runtime daemon is missing: $declared_daemon"
  [[ "$canonical_daemon" == "$canonical_source/bin/fram-daemon" ]] ||
    die "declared runtime daemon does not belong to its source: $declared_daemon"
  [[ -x "$canonical_daemon" ]] || die "declared runtime daemon is not executable: $declared_daemon"

  case "$declared_mode" in
    checkout)
      validate_checkout_target "$canonical_source" "$declared_revision" "$declared_origin"
      [[ "$runtime_tree" == "$declared_tree" ]] ||
        die "checkout deployment tree differs from its generation identity"
      ;;
    package)
      [[ "$declared_tree" == "immutable:$declared_revision" ]] ||
        die "package tree marker does not bind its declared revision"
      [[ "$declared_origin" == "$canonical_source" ]] ||
        die "package origin does not name its immutable root"
      canonical_package=$(realpath -e "$NORTH_COORD_FRAM_PACKAGE") ||
        die "packaged Fram root is missing: $NORTH_COORD_FRAM_PACKAGE"
      if [[ "$canonical_source" == "$canonical_package" ]]; then
        [[ "$declared_revision" == "$NORTH_COORD_FRAM_PACKAGE_REV" ]] ||
          die "current system package revision differs from its generation identity"
      else
        [[ "$canonical_source" =~ ^/nix/store/[a-z0-9]{32}-fram[^/]*$ ]] ||
          die "historical package selection is not an immutable Fram store root"
      fi
      runtime_mode=$declared_mode
      runtime_source=$canonical_source
      runtime_revision=$declared_revision
      runtime_tree=$declared_tree
      runtime_origin=$declared_origin
      runtime_daemon=$canonical_daemon
      ;;
    *) die "unknown declared runtime mode: $declared_mode" ;;
  esac

  [[ "$runtime_mode" == "$declared_mode" &&
      "$runtime_source" == "$declared_source" &&
      "$runtime_revision" == "$declared_revision" &&
      "$runtime_tree" == "$declared_tree" &&
      "$runtime_origin" == "$declared_origin" &&
      "$runtime_daemon" == "$declared_daemon" ]] ||
    die "runtime generation identity differs from the selected physical runtime"
}

write_member() {
  local generation=$1 member=$2 prefix=$3 prefixed_name

  prefixed_name=${prefix}_source
  ln -s "${!prefixed_name}" "$generation/$member"
  {
    printf '%s\n' north-fram-runtime-v1
    for field in mode source revision tree origin daemon; do
      prefixed_name=${prefix}_${field}
      printf '%s\n' "${!prefixed_name}"
    done
  } >"$generation/$member.identity"
}

load_member() {
  local member=$1 prefix=$2 target identity
  local -a fields

  identity=$active_generation/$member.identity
  target=$(readlink -f "$active_generation/$member") ||
    die "active $member runtime target is missing"
  [[ -f "$identity" && ! -L "$identity" ]] ||
    die "active $member runtime identity is missing: $identity"
  mapfile -t fields <"$identity"
  [[ ${#fields[@]} -eq 7 && ${fields[0]} == north-fram-runtime-v1 ]] ||
    die "active $member runtime identity is malformed: $identity"
  runtime_mode=${fields[1]}
  runtime_source=${fields[2]}
  runtime_revision=${fields[3]}
  runtime_tree=${fields[4]}
  runtime_origin=${fields[5]}
  runtime_daemon=${fields[6]}
  [[ "$target" == "$runtime_source" ]] ||
    die "active $member symlink differs from its generation identity"
  validate_declared_runtime
  capture_runtime "$prefix"
}

load_pair() {
  require_initialized_layout
  load_member current pair_current
  load_member previous pair_previous
}

load_selected() {
  require_initialized_layout
  load_member current selected
  restore_runtime selected
}

commit_pair() {
  local current_prefix=$1 previous_prefix=$2
  local generation_name generation active_temp

  restore_runtime "$current_prefix"
  validate_declared_runtime
  capture_runtime "$current_prefix"
  restore_runtime "$previous_prefix"
  validate_declared_runtime
  capture_runtime "$previous_prefix"

  generation_name="$(date +%s%N)-$$-$RANDOM"
  generation=$generations/$generation_name
  mkdir "$generation"
  crash_at generation-created
  write_member "$generation" current "$current_prefix"
  crash_at current-written
  write_member "$generation" previous "$previous_prefix"
  crash_at previous-written
  sync -f "$generation"
  sync -f "$generations"
  crash_at generation-synced

  restore_runtime "$current_prefix"
  validate_declared_runtime
  restore_runtime "$previous_prefix"
  validate_declared_runtime
  active_temp=$state_root/.active.next.$$
  [[ ! -e "$active_temp" && ! -L "$active_temp" ]] ||
    die "temporary active selector already exists: $active_temp"
  ln -s "generations/$generation_name" "$active_temp"
  crash_at active-prepared
  mv -T "$active_temp" "$active_link"
  crash_at active-published
  sync -f "$state_root"
  crash_at state-synced
}

initialize_runtime() {
  local canonical_package init_temp incomplete_state marker_status=''

  if [[ -f "$initialization_marker" && ! -L "$initialization_marker" ]]; then
    marker_status=$(<"$initialization_marker")
    case "$marker_status" in
      initialized)
        load_pair
        return 0
        ;;
      initializing)
        if [[ -e "$state_root" || -L "$state_root" ]]; then
          incomplete_state=$state_parent/.${state_name}.incomplete.$(date +%s%N).$$
          [[ ! -e "$incomplete_state" && ! -L "$incomplete_state" ]] ||
            die "incomplete-state quarantine path already exists: $incomplete_state"
          mv -T "$state_root" "$incomplete_state"
          sync -f "$state_parent"
        fi
        ;;
      *) die "runtime initialization marker is invalid: $initialization_marker" ;;
    esac
  else
    [[ ! -e "$initialization_marker" && ! -L "$initialization_marker" ]] ||
      die "runtime initialization marker is invalid: $initialization_marker"
    [[ ! -e "$state_root" && ! -L "$state_root" ]] ||
      die "unmarked runtime state already exists; refusing implicit migration: $state_root"
    init_temp=$state_parent/.${state_name}.initialized.next.$$
    printf '%s\n' initializing >"$init_temp"
    sync -f "$init_temp"
    mv -T "$init_temp" "$initialization_marker"
    sync -f "$state_parent"
    crash_at initialization-marked
  fi

  canonical_package=$(realpath -e "$NORTH_COORD_FRAM_PACKAGE") ||
    die "packaged Fram root is missing: $NORTH_COORD_FRAM_PACKAGE"
  validate_package_target "$canonical_package"
  mkdir "$state_root"
  mkdir "$deployments" "$generations"
  chmod 0700 "$state_root" "$deployments" "$generations"
  ln -s active/current "$current_link"
  ln -s active/previous "$previous_link"
  capture_runtime initial_package
  commit_pair initial_package initial_package

  init_temp=$state_parent/.${state_name}.initialized.next.$$
  printf '%s\n' initialized >"$init_temp"
  sync -f "$init_temp"
  mv -T "$init_temp" "$initialization_marker"
  sync -f "$state_parent"
}

ensure_initialized_for_mutation() {
  if [[ ! -e "$initialization_marker" && ! -L "$initialization_marker" &&
        ! -e "$state_root" && ! -L "$state_root" ]]; then
    initialize_runtime
  else
    load_pair
  fi
}

select_target() {
  local target=$1 target_source current_source current_source_name=pair_current_source

  load_pair
  validate_target "$target"
  target_source=$runtime_source
  capture_runtime selected_target
  current_source=${!current_source_name}
  if [[ "$target_source" != "$current_source" ]]; then
    commit_pair selected_target pair_current
  fi
}

print_restart_instruction() {
  printf 'selected %s@%s\n' "$runtime_mode" "$runtime_revision"
  printf 'apply with: sudo systemctl restart north-coord.service\n'
}

promote_checkout() {
  local origin=${1:-$NORTH_COORD_FRAM_CHECKOUT}
  local requested=${2:-HEAD}
  local canonical_origin revision deployment

  ensure_initialized_for_mutation
  canonical_origin=$(realpath -e "$origin") || die "Fram checkout is missing: $origin"
  [[ $(realpath -e "$(git -C "$canonical_origin" rev-parse --show-toplevel 2>/dev/null)") == "$canonical_origin" ]] ||
    die "Fram checkout is not a Git worktree root: $canonical_origin"
  revision=$(git -C "$canonical_origin" rev-parse --verify "${requested}^{commit}" 2>/dev/null) ||
    die "cannot resolve Fram revision: $requested"
  valid_revision "$revision" || die "resolved Fram revision is not an exact Git SHA: $revision"

  deployment=$deployments/$revision
  if [[ ! -e "$deployment" && ! -L "$deployment" ]]; then
    git -C "$canonical_origin" worktree add --detach "$deployment" "$revision" >/dev/null
    sync -f "$deployments"
  fi
  validate_checkout_target "$deployment" "$revision" "$canonical_origin"
  select_target "$runtime_source"
  load_selected
  print_restart_instruction
}

select_package() {
  local canonical_package

  ensure_initialized_for_mutation
  canonical_package=$(realpath -e "$NORTH_COORD_FRAM_PACKAGE") ||
    die "packaged Fram root is missing: $NORTH_COORD_FRAM_PACKAGE"
  validate_package_target "$canonical_package"
  select_target "$runtime_source"
  load_selected
  print_restart_instruction
}

rollback_runtime() {
  load_pair
  commit_pair pair_previous pair_current
  load_selected
  print_restart_instruction
}

show_status() {
  load_selected
  printf 'mode=%s\n' "$runtime_mode"
  printf 'source=%s\n' "$runtime_source"
  printf 'revision=%s\n' "$runtime_revision"
  printf 'tree=%s\n' "$runtime_tree"
  printf 'origin=%s\n' "$runtime_origin"
  printf 'daemon=%s\n' "$runtime_daemon"
  printf 'selector=%s\n' "$current_link"
}

export_runtime_identity() {
  local generation_identity runtime_record

  generation_identity=$active_generation/current.identity
  runtime_record=$active_generation/active.runtime
  export NORTH_FRAM_RUNTIME=$runtime_mode
  export NORTH_COORD_RUNTIME_GENERATION=$active_generation
  export NORTH_COORD_RUNTIME_IDENTITY=$generation_identity
  export NORTH_COORD_RUNTIME_FILE=$runtime_record
  export NORTH_COORD_SYSTEMD_UNIT=$systemd_unit
  export FRAM_HOME=$runtime_source
  export FRAM_BIN=$runtime_source/bin
  export FRAM_LOG=$NORTH_COORD_FRAM_LOG
  export FRAM_TELEMETRY_LOG=$telemetry_log
  export FRAM_PORT=$runtime_port
  export FRAM_REQUIRE_LOG_FENCE=1
  export FRAM_RUNTIME_SOURCE=$runtime_source
  export FRAM_RUNTIME_REV=$runtime_revision
  export FRAM_RUNTIME_TREE=$runtime_tree
  export FRAM_RUNTIME_ORIGIN=$runtime_origin
  export FRAM_RUNTIME_DAEMON=$runtime_daemon
  unset FRAM_RUNTIME_OWNER_TOKEN
}

acquire_generation_start_lock() {
  local start_lock=$active_generation/.active-runtime.start.lock
  local expected_identity

  expected_identity="$EUID:600:1"
  if [[ ! -e "$start_lock" && ! -L "$start_lock" ]]; then
    if ! (
      set -o noclobber
      umask 077
      : >"$start_lock"
    ); then
      die "cannot create generation start lock: $start_lock"
    fi
    sync -f "$active_generation" ||
      die "cannot sync generation start lock: $active_generation"
  fi
  [[ -f "$start_lock" && ! -L "$start_lock" ]] ||
    die "generation start lock is missing or unsafe: $start_lock"
  [[ $(realpath -e "$start_lock") == "$start_lock" ]] ||
    die "generation start lock is not canonical: $start_lock"
  [[ $(stat -c '%u:%a:%h' "$start_lock") == "$expected_identity" ]] ||
    die "generation start lock ownership, mode, or link count is unsafe: $start_lock"

  exec 8<>"$start_lock" || die "cannot open generation start lock: $start_lock"
  if ! flock -n 8; then
    exec 8>&-
    die "selected runtime generation already has an active start: $active_generation"
  fi
}

publish_active_runtime() {
  local owner_token=$1 pid=$$ birth generation_identity identity_sha
  local runtime_record record_temp line key value
  local -a record_lines

  generation_identity=$active_generation/current.identity
  [[ -f "$generation_identity" && ! -L "$generation_identity" ]] ||
    die "selected generation identity is missing or unsafe: $generation_identity"
  [[ $(realpath -e "$generation_identity") == "$generation_identity" ]] ||
    die "selected generation identity is not canonical: $generation_identity"
  read -r identity_sha _ < <(sha256sum "$generation_identity")
  [[ "$identity_sha" =~ ^[0-9a-f]{64}$ ]] ||
    die "cannot hash selected generation identity: $generation_identity"
  birth=$(process_birth_token "$pid")
  runtime_record=$active_generation/active.runtime
  record_temp=$active_generation/.active.runtime.next.$pid.$RANDOM

  record_lines=(
    'FORMAT=north-fram-active-runtime/v1'
    "GENERATION=$active_generation"
    "GENERATION_IDENTITY=$generation_identity"
    "GENERATION_IDENTITY_SHA256=$identity_sha"
    "NORTH_FRAM_RUNTIME=$runtime_mode"
    "FRAM_RUNTIME_SOURCE=$runtime_source"
    "FRAM_RUNTIME_REV=$runtime_revision"
    "FRAM_RUNTIME_TREE=$runtime_tree"
    "FRAM_RUNTIME_ORIGIN=$runtime_origin"
    "FRAM_RUNTIME_DAEMON=$runtime_daemon"
    "FRAM_PORT=$runtime_port"
    "FRAM_LOG=$NORTH_COORD_FRAM_LOG"
    "FRAM_TELEMETRY_LOG=$telemetry_log"
    "PID=$pid"
    "PID_BIRTH=$birth"
    "OWNER_TOKEN=$owner_token"
    "CONTROLLER_UNIT=$systemd_unit"
    "CONTROLLER_MAIN_PID=$pid"
  )
  for line in "${record_lines[@]}"; do
    key=${line%%=*}
    value=${line#*=}
    valid_record_value "$value" ||
      die "active runtime record has an invalid $key value"
  done

  if ! (
    set -o noclobber
    umask 077
    printf '%s\n' "${record_lines[@]}" >"$record_temp"
  ); then
    die "cannot stage active runtime identity: $record_temp"
  fi
  crash_at active-runtime-written
  if ! sync -f "$record_temp"; then
    rm -f -- "${record_temp:?}"
    die "cannot sync staged active runtime identity: $record_temp"
  fi
  crash_at active-runtime-synced
  if ! mv -T "$record_temp" "$runtime_record"; then
    rm -f -- "${record_temp:?}"
    die "cannot publish active runtime identity: $runtime_record"
  fi
  crash_at active-runtime-published
  sync -f "$active_generation" ||
    die "cannot sync active runtime generation: $active_generation"
  crash_at active-runtime-generation-synced
}

run_corpus_transaction() {
  env \
    FRAM_LOG="$NORTH_COORD_FRAM_LOG" \
    FRAM_TELEMETRY_LOG="$telemetry_log" \
    FRAM_PORT="$runtime_port" \
    NORTH_PORT="$runtime_port" \
    NORTH_CORPUS_CONTROLLER=systemd \
    NORTH_COORD_SYSTEMD_UNIT="$systemd_unit" \
    NORTH_CORPUS_TRANSACTION_DIR="$transaction_state" \
    "$north_binary" corpus-transaction "$@"
}

start_runtime() {
  local launcher_owner_token

  load_selected
  export_runtime_identity
  acquire_generation_start_lock
  launcher_owner_token=$(mint_owner_token)
  export FRAM_RUNTIME_OWNER_TOKEN=$launcher_owner_token
  publish_active_runtime "$launcher_owner_token"
  release_lock
  cd "$runtime_source"
  exec "$runtime_daemon" "$runtime_port" "$NORTH_COORD_FRAM_LOG"
}

preflight_runtime() {
  local listeners pid cgroup

  listeners=$(ss -H -ltnp "sport = :$runtime_port") ||
    die "cannot inspect coordinator socket before startup"
  if [[ -n "$listeners" ]]; then
    printf '%s: coordinator port %s is already occupied; skipping systemd startup before runtime load\n' \
      "$program" "$runtime_port" >&2
    printf '%s\n' "$listeners" >&2
    while IFS= read -r pid; do
      [[ -n "$pid" ]] || continue
      cgroup=$(tr '\n' ' ' <"/proc/$pid/cgroup" 2>/dev/null || printf unreadable)
      printf '%s: listener pid=%s cgroup=%s\n' "$program" "$pid" "$cgroup" >&2
    done < <(grep -oE 'pid=[0-9]+' <<<"$listeners" | cut -d= -f2 | sort -nu)
    return 1
  fi
}

prepare_runtime() {
  initialize_runtime
  run_corpus_transaction recover --launcher
}

settle_runtime() {
  run_corpus_transaction settle --wait --launcher
}

exec_checkout() {
  local target=$1
  shift
  load_selected
  [[ "$runtime_mode" == checkout ]] ||
    die "selected Fram runtime is package mode; promote an exact checkout deployment"
  [[ "$target" = /* && -x "$target" ]] || die "checkout executable is missing: $target"
  export_runtime_identity
  release_lock
  exec "$target" "$@"
}

usage() {
  cat >&2 <<EOF
usage: $program initialize
       $program preflight
       $program prepare
       $program start
       $program settle
       $program status
       $program promote [FRAM_CHECKOUT] [REVISION]
       $program package
       $program rollback
       $program exec-checkout EXECUTABLE [ARG ...]
EOF
  exit 2
}

prepare_lock
case "${1:-}" in
  initialize) [[ $# -eq 1 ]] || usage; initialize_runtime ;;
  preflight) [[ $# -eq 1 ]] || usage; preflight_runtime ;;
  prepare) [[ $# -eq 1 ]] || usage; prepare_runtime ;;
  start) [[ $# -eq 1 ]] || usage; start_runtime ;;
  settle) [[ $# -eq 1 ]] || usage; settle_runtime ;;
  status) [[ $# -eq 1 ]] || usage; show_status ;;
  promote) shift; [[ $# -le 2 ]] || usage; promote_checkout "$@" ;;
  package) [[ $# -eq 1 ]] || usage; select_package ;;
  rollback) [[ $# -eq 1 ]] || usage; rollback_runtime ;;
  exec-checkout) shift; [[ $# -ge 1 ]] || usage; exec_checkout "$@" ;;
  *) usage ;;
esac
