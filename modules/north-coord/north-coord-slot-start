#!/usr/bin/env bash
set -euo pipefail

umask 077

program=${0##*/}

die() {
  printf '%s: %s\n' "$program" "$*" >&2
  exit 2
}

: "${NORTH_COORD_SLOT:?missing NORTH_COORD_SLOT}"
: "${NORTH_COORD_SELECTOR_MAP:?missing NORTH_COORD_SELECTOR_MAP}"
: "${NORTH_COORD_CUTOVER_TOKEN_FILE:?missing NORTH_COORD_CUTOVER_TOKEN_FILE}"
: "${NORTH_COORD_SLOT_RUNTIME:?missing NORTH_COORD_SLOT_RUNTIME}"

case "$NORTH_COORD_SLOT" in
  blue|green) ;;
  *) die "invalid slot: $NORTH_COORD_SLOT" ;;
esac

[[ "$NORTH_COORD_SELECTOR_MAP" == /* ]] ||
  die "selector map must be an absolute path"
[[ "$NORTH_COORD_CUTOVER_TOKEN_FILE" == /* ]] ||
  die "token file must be an absolute path"
[[ -x "$NORTH_COORD_SLOT_RUNTIME" && ! -L "$NORTH_COORD_SLOT_RUNTIME" ]] ||
  die "runtime must be an executable, non-symlink path"
[[ -f "$NORTH_COORD_CUTOVER_TOKEN_FILE" &&
   ! -L "$NORTH_COORD_CUTOVER_TOKEN_FILE" ]] ||
  die "token file is missing or unsafe"

token_mode=$(stat -Lc '%a' "$NORTH_COORD_CUTOVER_TOKEN_FILE")
[[ "$token_mode" == 400 || "$token_mode" == 600 ]] ||
  die "token file must have mode 0400 or 0600, observed $token_mode"

selected=
if [[ -f "$NORTH_COORD_SELECTOR_MAP" &&
      ! -L "$NORTH_COORD_SELECTOR_MAP" ]]; then
  read -r key selected extra <"$NORTH_COORD_SELECTOR_MAP" ||
    die "cannot read selector map"
  [[ "$key" == active && -z "${extra:-}" ]] ||
    die "selector map is malformed"
  case "$selected" in
    blue|green) ;;
    *) die "selector map names an invalid slot: $selected" ;;
  esac
fi

# Role is derived from the durable selector on every service start. A service
# restart after a blue/green cutover therefore preserves, rather than reverses,
# writer authority.
if [[ "$selected" == "$NORTH_COORD_SLOT" ]]; then
  export FRAM_COORD_ROLE=active
else
  export FRAM_COORD_ROLE=standby
fi

FRAM_CUTOVER_TOKEN=$(<"$NORTH_COORD_CUTOVER_TOKEN_FILE")
[[ -n "${FRAM_CUTOVER_TOKEN//[[:space:]]/}" ]] ||
  die "token file is empty"
export FRAM_CUTOVER_TOKEN
export FRAM_REQUIRE_LOG_FENCE=1

exec "$NORTH_COORD_SLOT_RUNTIME" start
