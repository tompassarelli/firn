#!/usr/bin/env bash
set -euo pipefail

umask 077

program=${0##*/}

die() {
  printf '%s: %s\n' "$program" "$*" >&2
  exit 2
}

for setting in \
  NORTH_COORD_CUTOVER_BIN \
  NORTH_COORD_CUTOVER_TOKEN_FILE \
  NORTH_COORD_CUTOVER_STATE \
  NORTH_COORD_COORD_LOG \
  NORTH_COORD_TELEMETRY_LOG \
  NORTH_COORD_SYSTEMCTL_BIN \
  NORTH_COORD_JCMD_BIN \
  NORTH_COORD_BLUE_COORD_UNIT \
  NORTH_COORD_BLUE_TELEMETRY_UNIT \
  NORTH_COORD_GREEN_COORD_UNIT \
  NORTH_COORD_GREEN_TELEMETRY_UNIT \
  NORTH_COORD_BLUE_COORD_PORT \
  NORTH_COORD_BLUE_TELEMETRY_PORT \
  NORTH_COORD_GREEN_COORD_PORT \
  NORTH_COORD_GREEN_TELEMETRY_PORT
do
  [[ -n "${!setting:-}" ]] || die "missing setting: $setting"
done

cutover=$NORTH_COORD_CUTOVER_BIN
token_file=$NORTH_COORD_CUTOVER_TOKEN_FILE
state=$NORTH_COORD_CUTOVER_STATE
systemctl_bin=$NORTH_COORD_SYSTEMCTL_BIN
jcmd_bin=$NORTH_COORD_JCMD_BIN
proc_root=${NORTH_COORD_PROC_ROOT:-/proc}
control_timeout_ms=${NORTH_COORD_CUTOVER_TIMEOUT_MS:-120000}
settle_timeout_ms=${NORTH_COORD_CUTOVER_SETTLE_TIMEOUT_MS:-120000}
settle_poll_seconds=${NORTH_COORD_CUTOVER_SETTLE_POLL_SECONDS:-0.1}
readiness_systemctl_timeout_seconds=${NORTH_COORD_PROMOTION_SYSTEMCTL_TIMEOUT_SECONDS:-5}
readiness_jcmd_timeout_seconds=${NORTH_COORD_PROMOTION_JCMD_TIMEOUT_SECONDS:-10}
readiness_expected_memory_swap_max_bytes=${NORTH_COORD_PROMOTION_EXPECTED_MEMORY_SWAP_MAX_BYTES:-0}
readiness_coord_expected_memory_max_bytes=${NORTH_COORD_PROMOTION_COORD_EXPECTED_MEMORY_MAX_BYTES:-8589934592}
readiness_telemetry_expected_memory_max_bytes=${NORTH_COORD_PROMOTION_TELEMETRY_EXPECTED_MEMORY_MAX_BYTES:-6442450944}
readiness_coord_max_memory_current_bytes=${NORTH_COORD_PROMOTION_COORD_MAX_MEMORY_CURRENT_BYTES:-4294967296}
readiness_telemetry_max_memory_current_bytes=${NORTH_COORD_PROMOTION_TELEMETRY_MAX_MEMORY_CURRENT_BYTES:-3221225472}
readiness_coord_expected_max_heap_bytes=${NORTH_COORD_PROMOTION_COORD_EXPECTED_MAX_HEAP_BYTES:-6442450944}
readiness_telemetry_expected_max_heap_bytes=${NORTH_COORD_PROMOTION_TELEMETRY_EXPECTED_MAX_HEAP_BYTES:-4294967296}
readiness_coord_max_heap_used_bytes=${NORTH_COORD_PROMOTION_COORD_MAX_HEAP_USED_BYTES:-3221225472}
readiness_telemetry_max_heap_used_bytes=${NORTH_COORD_PROMOTION_TELEMETRY_MAX_HEAP_USED_BYTES:-2147483648}
readiness_expected_cpu_quota=${NORTH_COORD_PROMOTION_EXPECTED_CPU_QUOTA:-infinity}
readiness_expected_restart=${NORTH_COORD_PROMOTION_EXPECTED_RESTART:-always}
readiness_max_restarts=${NORTH_COORD_PROMOTION_MAX_RESTARTS:-0}
readiness_max_tasks=${NORTH_COORD_PROMOTION_MAX_TASKS:-128}
unknown_state=$state/outcome.unknown

[[ "$cutover" == /* && -x "$cutover" && ! -L "$cutover" ]] ||
  die "cutover command is not a safe executable"
[[ "$systemctl_bin" == /* && -x "$systemctl_bin" &&
   ! -L "$systemctl_bin" ]] ||
  die "systemctl command is not a safe executable"
[[ "$jcmd_bin" == /* && -x "$jcmd_bin" ]] ||
  die "jcmd command is not a safe executable"
[[ "$proc_root" == /* && -d "$proc_root" && ! -L "$proc_root" ]] ||
  die "proc root is not a safe directory"
[[ "$token_file" == /* && -f "$token_file" && ! -L "$token_file" ]] ||
  die "cutover token is missing or unsafe"
[[ "$state" == /* ]] || die "cutover state path must be absolute"
[[ "$control_timeout_ms" =~ ^[1-9][0-9]*$ ]] ||
  die "cutover control timeout must be a positive integer"
[[ "$settle_timeout_ms" =~ ^[1-9][0-9]*$ ]] ||
  die "cutover settle timeout must be a positive integer"
for setting in \
  readiness_systemctl_timeout_seconds \
  readiness_jcmd_timeout_seconds \
  readiness_coord_expected_memory_max_bytes \
  readiness_telemetry_expected_memory_max_bytes \
  readiness_coord_max_memory_current_bytes \
  readiness_telemetry_max_memory_current_bytes \
  readiness_coord_expected_max_heap_bytes \
  readiness_telemetry_expected_max_heap_bytes \
  readiness_coord_max_heap_used_bytes \
  readiness_telemetry_max_heap_used_bytes \
  readiness_max_tasks
do
  [[ "${!setting}" =~ ^[1-9][0-9]*$ ]] ||
    die "${setting#readiness_} must be a positive integer"
done
[[ "$readiness_expected_memory_swap_max_bytes" =~ ^[0-9]+$ ]] ||
  die "expected memory swap max must be a non-negative integer"
[[ "$readiness_expected_cpu_quota" == infinity ||
   "$readiness_expected_cpu_quota" =~ ^[1-9][0-9]*$ ]] ||
  die "expected CPU quota is malformed"
[[ "$readiness_expected_restart" =~ ^[A-Za-z-]+$ ]] ||
  die "expected restart policy is malformed"
[[ "$readiness_max_restarts" =~ ^[0-9]+$ ]] ||
  die "maximum restart count must be a non-negative integer"
for origin in coord telemetry; do
  memory_max_name=readiness_${origin}_expected_memory_max_bytes
  memory_current_name=readiness_${origin}_max_memory_current_bytes
  heap_max_name=readiness_${origin}_expected_max_heap_bytes
  heap_used_name=readiness_${origin}_max_heap_used_bytes
  (( ${!memory_current_name} < ${!memory_max_name} )) ||
    die "$origin maximum memory current must be below its cgroup limit"
  (( ${!heap_used_name} < ${!heap_max_name} )) ||
    die "$origin maximum heap used must be below its JVM heap limit"
done

valid_slot() {
  [[ "$1" == blue || "$1" == green ]]
}

valid_origin() {
  [[ "$1" == coord || "$1" == telemetry ]]
}

port_for() {
  case "$1:$2" in
    blue:coord) printf '%s\n' "$NORTH_COORD_BLUE_COORD_PORT" ;;
    blue:telemetry) printf '%s\n' "$NORTH_COORD_BLUE_TELEMETRY_PORT" ;;
    green:coord) printf '%s\n' "$NORTH_COORD_GREEN_COORD_PORT" ;;
    green:telemetry) printf '%s\n' "$NORTH_COORD_GREEN_TELEMETRY_PORT" ;;
    *) die "invalid endpoint: $1/$2" ;;
  esac
}

log_for() {
  case "$1" in
    coord) printf '%s\n' "$NORTH_COORD_COORD_LOG" ;;
    telemetry) printf '%s\n' "$NORTH_COORD_TELEMETRY_LOG" ;;
    *) die "invalid origin: $1" ;;
  esac
}

unit_for() {
  case "$1:$2" in
    blue:coord) printf '%s\n' "$NORTH_COORD_BLUE_COORD_UNIT" ;;
    blue:telemetry) printf '%s\n' "$NORTH_COORD_BLUE_TELEMETRY_UNIT" ;;
    green:coord) printf '%s\n' "$NORTH_COORD_GREEN_COORD_UNIT" ;;
    green:telemetry) printf '%s\n' "$NORTH_COORD_GREEN_TELEMETRY_UNIT" ;;
    *) die "invalid unit endpoint: $1/$2" ;;
  esac
}

contract_for() {
  local origin=$1 name=$2 variable
  valid_origin "$origin" || die "invalid contract origin: $origin"
  case "$name" in
    memory-max) variable=readiness_${origin}_expected_memory_max_bytes ;;
    memory-current) variable=readiness_${origin}_max_memory_current_bytes ;;
    max-heap) variable=readiness_${origin}_expected_max_heap_bytes ;;
    heap-used) variable=readiness_${origin}_max_heap_used_bytes ;;
    *) die "invalid runtime contract field: $name" ;;
  esac
  printf '%s\n' "${!variable}"
}

status_file() {
  local slot=$1 origin=$2 output=$3
  "$cutover" status \
    --port "$(port_for "$slot" "$origin")" \
    --log "$(log_for "$origin")" \
    --token-file "$token_file" \
    --timeout-ms 15000 >"$output"
}

# Validate the complete status contract and print:
#   phase
#   instance
#   logical version
# Normalize the daemon lifecycle and nested cutover protocol into one controller
# phase. Transitional phases own or retain the kernel authority lock even though
# write-authorized is false; callers must wait for a terminal phase before
# issuing another authority operation.
inspect_status() {
  local input=$1 expected=$2
  bb -e '
    (require (quote [clojure.edn :as edn]))
    (let [[path expected] *command-line-args*
          m (edn/read-string (slurp path))
          outer-phase (:phase m)
          cutover-phase (get-in m [:cutover :phase])
          writer-role (get-in m [:writer-authority :role])
          authorized (get-in m [:writer-authority :write-authorized])
          phase (cond
                  (and (= outer-phase :active)
                       (= writer-role :active)
                       (= authorized true))
                  :active

                  (and (= outer-phase :standby)
                       (= writer-role :standby)
                       (= authorized false)
                       (not= cutover-phase :promotion-rejected))
                  :standby

                  (and (= outer-phase :retired)
                       (= writer-role :retired)
                       (= authorized false)
                       (contains? #{:demoted :prepared} cutover-phase))
                  :demoted

                  (and (= outer-phase :promoting)
                       (= writer-role :promoting)
                       (= authorized false)
                       (= cutover-phase :promoting))
                  :promoting

                  (and (= outer-phase :demoting)
                       (= writer-role :demoting)
                       (= authorized false)
                       (= cutover-phase :demoting))
                  :demoting

                  (and (contains? #{:standby :retired} outer-phase)
                       (= authorized false)
                       (= cutover-phase :promotion-rejected))
                  :rejected

                  :else :invalid)
          cutover-id (get-in m [:cutover :cutover-id])]
      (when-not (and (= true (:ok m))
                     (= "fram-coordinator-cutover/v1" (:protocol m))
                     (contains? #{:active :standby :demoted
                                  :promoting :demoting :rejected} phase)
                     (or (= expected "any")
                         (= expected (name phase)))
                     (string? (:instance m))
                     (not-empty (:instance m))
                     (integer? (:version m))
                     (not (neg? (:version m))))
        (binding [*out* *err*]
          (println "invalid cutover status" (pr-str m)))
        (System/exit 1))
      (println (name phase))
      (println (:instance m))
      (println (:version m))
      (println (if (keyword? cutover-phase) (name cutover-phase) "none"))
      (println (if (string? cutover-id) cutover-id "none")))' \
    "$input" "$expected"
}

inspect_prepare() {
  local input=$1 expected_cutover_id=$2 origin=$3
  bb -e '
    (require (quote [clojure.edn :as edn]))
    (let [[path expected-cutover-id origin coord-log telemetry-log]
          *command-line-args*
          canonical (fn [p] (.getCanonicalPath (java.io.File. ^String p)))
          coord-path (canonical coord-log)
          telemetry-path (canonical telemetry-log)
          expected-logs
          (case origin
            "coord" {:primary coord-path :telemetry telemetry-path}
            "telemetry" {:primary telemetry-path :telemetry coord-path}
            nil)]
      (with-open [reader
                  (java.io.PushbackReader.
                   (java.io.BufferedReader.
                    (java.io.FileReader. ^String path)))]
        (let [m (edn/read {:eof ::eof} reader)
              trailing (edn/read {:eof ::eof} reader)
              role (:phase m)
              writer-role (get-in m [:writer-authority :role])
              authorized (get-in m [:writer-authority :write-authorized])
              marker (:marker m)
              sync (:sync m)
              logs (:logs marker)
              valid-log?
              (fn [proof]
                (and (map? proof)
                     (keyword? (:label proof))
                     (string? (:path proof))
                     (.startsWith ^String (:path proof) "/")
                     (integer? (:bytes proof))
                     (not (neg? (:bytes proof)))
                     (string? (:file-key proof))
                     (not-empty (:file-key proof))
                     (string? (:identity proof))
                     (not-empty (:identity proof))
                     (string? (:boundary-sha proof))
                     (re-matches #"[0-9a-f]{64}"
                                 (:boundary-sha proof))))]
          (when-not
           (and (= ::eof trailing)
                (map? m)
                (map? expected-logs)
                (not= coord-path telemetry-path)
                (= true (:ok m))
                (= "fram-coordinator-cutover/v1" (:protocol m))
                (= true (:prepared m))
                (= expected-cutover-id (:cutover-id m))
                (contains? #{:standby :retired} role)
                (= role writer-role)
                (= false authorized)
                (string? (:instance m))
                (not-empty (:instance m))
                (integer? (:version m))
                (not (neg? (:version m)))
                (= "fram-coordinator-cutover-marker/v1" (:format marker))
                (= expected-cutover-id (:cutover-id marker))
                (= (:version m) (:version marker))
                (= (:instance m) (:source-instance marker))
                (vector? logs)
                (= 2 (count logs))
                (every? valid-log? logs)
                (= #{:primary :telemetry} (set (map :label logs)))
                (= 2 (count (distinct (map :path logs))))
                (every?
                 (fn [proof]
                   (= (get expected-logs (:label proof)) (:path proof)))
                 logs)
                (= true (:prewarmed sync))
                (contains? #{:unchanged :installed :superseded}
                           (:reload sync))
                (integer? (:attempts sync))
                (pos? (:attempts sync))
                (integer? (:elapsed-ms sync))
                (not (neg? (:elapsed-ms sync))))
            (binding [*out* *err*]
              (println "invalid cutover prepare response" (pr-str m)))
            (System/exit 1))
          (println (:instance m) (:version m)))))' \
    "$input" "$expected_cutover_id" "$origin" \
    "$NORTH_COORD_COORD_LOG" "$NORTH_COORD_TELEMETRY_LOG"
}

read_status() {
  local slot=$1 origin=$2 expected=$3 output inspect_rc=0 cleanup_rc=0
  output=$(mktemp "$state/status.XXXXXX")
  if ! status_file "$slot" "$origin" "$output"; then
    rm -f -- "$output"
    return 1
  fi
  inspect_status "$output" "$expected" || inspect_rc=$?
  rm -f -- "$output" || cleanup_rc=$?
  if (( inspect_rc != 0 )); then
    return "$inspect_rc"
  fi
  return "$cleanup_rc"
}

await_status() {
  local slot=$1 origin=$2 expected=$3 expected_cutover_id=${4:-}
  local deadline now status phase observed_cutover_id
  deadline=$(( $(date +%s%3N) + settle_timeout_ms ))
  while :; do
    if status=$(read_status "$slot" "$origin" any 2>/dev/null); then
      phase=$(sed -n '1p' <<<"$status")
      observed_cutover_id=$(sed -n '5p' <<<"$status")
      if [[ -n "$expected_cutover_id" &&
            "$observed_cutover_id" != "$expected_cutover_id" &&
            "$observed_cutover_id" != none ]]; then
        printf '%s/%s changed cutover identity: expected %s, observed %s\n' \
          "$slot" "$origin" "$expected_cutover_id" \
          "$observed_cutover_id" >&2
        return 1
      fi
      if [[ "$phase" == rejected ]]; then
        printf '%s/%s rejected cutover %s\n' \
          "$slot" "$origin" "$observed_cutover_id" >&2
        return 1
      fi
      if [[ "$phase" == "$expected" &&
            ( -z "$expected_cutover_id" ||
              "$observed_cutover_id" == "$expected_cutover_id" ) ]]; then
        printf '%s\n' "$status"
        return 0
      fi
    else
      phase=invalid
    fi
    now=$(date +%s%3N)
    if (( now >= deadline )); then
      printf '%s/%s did not settle to %s (last phase: %s)\n' \
        "$slot" "$origin" "$expected" "$phase" >&2
      return 1
    fi
    sleep "$settle_poll_seconds"
  done
}

await_terminal() {
  local slot=$1 origin=$2
  local deadline now status phase
  deadline=$(( $(date +%s%3N) + settle_timeout_ms ))
  while :; do
    if status=$(read_status "$slot" "$origin" any 2>/dev/null); then
      phase=$(sed -n '1p' <<<"$status")
      if [[ "$phase" != promoting && "$phase" != demoting ]]; then
        printf '%s\n' "$status"
        return 0
      fi
    else
      phase=invalid
    fi
    now=$(date +%s%3N)
    if (( now >= deadline )); then
      printf '%s/%s did not reach a terminal phase (last phase: %s)\n' \
        "$slot" "$origin" "$phase" >&2
      return 1
    fi
    sleep "$settle_poll_seconds"
  done
}

write_unknown_state() {
  local transition=$1 slot=$2 origin=$3 cutover_id=$4 temp
  temp=$unknown_state.next.$$
  printf '%s %s %s %s\n' \
    "$transition" "$slot" "$origin" "$cutover_id" >"$temp"
  sync -f "$temp"
  mv -T "$temp" "$unknown_state"
  sync -f "$state"
}

clear_unknown_state() {
  rm -f -- "$unknown_state"
  sync -f "$state"
}

read_unknown_state() {
  local transition slot origin cutover_id extra
  [[ -f "$unknown_state" && ! -L "$unknown_state" ]] ||
    return 1
  read -r transition slot origin cutover_id extra <"$unknown_state" ||
    die "cannot read unresolved cutover outcome"
  [[ "$transition" == demote || "$transition" == promote ]] ||
    die "unresolved cutover transition is malformed"
  valid_slot "$slot" || die "unresolved cutover slot is malformed"
  valid_origin "$origin" || die "unresolved cutover origin is malformed"
  [[ "$cutover_id" =~ ^[A-Za-z0-9_.:-]+$ && -z "${extra:-}" ]] ||
    die "unresolved cutover identity is malformed"
  printf '%s %s %s %s\n' "$transition" "$slot" "$origin" "$cutover_id"
}

reconcile_unknown_transition() {
  local transition=$1 slot=$2 origin=$3 cutover_id=$4
  local deadline now status phase observed_cutover_phase
  local observed_cutover_id observed_instance marker rc
  deadline=$(( $(date +%s%3N) + settle_timeout_ms ))
  while :; do
    if status=$(read_status "$slot" "$origin" any 2>/dev/null); then
      phase=$(sed -n '1p' <<<"$status")
      observed_cutover_phase=$(sed -n '4p' <<<"$status")
      observed_cutover_id=$(sed -n '5p' <<<"$status")
      if [[ "$observed_cutover_id" == "$cutover_id" ]]; then
        case "$transition:$phase" in
          demote:demoted)
            observed_instance=$(sed -n '2p' <<<"$status")
            if [[ "$cutover_id" == rollback-* ]]; then
              marker=$state/$origin.rollback.edn
            else
              marker=$state/$origin.old-demotion.edn
            fi
            # The timed-out client may not have received or published the
            # daemon's marker. Once demotion is terminal, replaying the same ID
            # is idempotent and safely materializes that exact marker.
            if "$cutover" demote \
              --port "$(port_for "$slot" "$origin")" \
              --log "$(log_for "$origin")" \
              --token-file "$token_file" \
              --cutover-id "$cutover_id" \
              --expected-instance "$observed_instance" \
              --marker-out "$marker" \
              --timeout-ms "$control_timeout_ms" >/dev/null; then
              rc=0
            else
              rc=$?
            fi
            if (( rc == 0 )) && [[ -f "$marker" && ! -L "$marker" ]]; then
              clear_unknown_state
              return 0
            fi
            ;;
          promote:active)
            clear_unknown_state
            return 0
            ;;
          promote:rejected)
            clear_unknown_state
            return 1
            ;;
          promote:standby|promote:demoted)
            # PREPARE deliberately uses the same per-origin operation ID as
            # PROMOTE. A transport failure can therefore leave the endpoint in
            # its exact-ID prepared/read-only state while the promotion request
            # is still queued behind the control lock. Keep polling until that
            # request installs :promoting or reaches a terminal result.
            if [[ "$observed_cutover_phase" != prepared ]]; then
              printf '%s/%s returned %s with unexpected cutover phase %s\n' \
                "$slot" "$origin" "$phase" \
                "$observed_cutover_phase" >&2
              return 2
            fi
            ;;
          demote:active)
            if [[ "$observed_cutover_phase" == demotion-rolled-back ]]; then
              clear_unknown_state
              return 1
            fi
            printf '%s/%s returned active with unexpected cutover phase %s\n' \
              "$slot" "$origin" "$observed_cutover_phase" >&2
            return 2
            ;;
          demote:demoting|promote:promoting)
            ;;
          *)
            printf '%s/%s reached incompatible phase %s for %s\n' \
              "$slot" "$origin" "$phase" "$cutover_id" >&2
            return 2
            ;;
        esac
      elif [[ "$observed_cutover_id" != none ]]; then
        case "$transition:$phase" in
          demote:active|promote:standby|promote:demoted|promote:rejected)
            # The timed-out request may still be queued behind the prior
            # terminal state. Keep the frontend held and continue observing.
            ;;
          *)
            printf '%s/%s reports unrelated cutover %s while waiting for %s\n' \
              "$slot" "$origin" "$observed_cutover_id" "$cutover_id" >&2
            return 2
            ;;
        esac
      fi
    fi
    now=$(date +%s%3N)
    if (( now >= deadline )); then
      printf '%s/%s transport outcome remains unknown for %s\n' \
        "$slot" "$origin" "$cutover_id" >&2
      return 2
    fi
    sleep "$settle_poll_seconds"
  done
}

settle_recorded_unknown() {
  local recorded transition slot origin cutover_id
  [[ -e "$unknown_state" || -L "$unknown_state" ]] || return 0
  recorded=$(read_unknown_state) ||
    die "unresolved cutover outcome is unsafe"
  # An unresolved transport outcome may still begin on the server after the
  # client timed out. Never resume or issue competing authority operations
  # until that exact request reaches a terminal, observable phase.
  read -r transition slot origin cutover_id <<<"$recorded"
  reconcile_unknown_transition \
    "$transition" "$slot" "$origin" "$cutover_id"
}

verify_pair() {
  local slot=$1 expected=$2 origin phase
  valid_slot "$slot" || die "invalid slot: $slot"
  case "$expected" in active|standby|demoted|read-only) ;; *)
    die "invalid expected phase: $expected" ;;
  esac
  for origin in coord telemetry; do
    if [[ "$expected" == read-only ]]; then
      phase=$(read_status "$slot" "$origin" any | sed -n '1p') ||
        die "$slot/$origin has no valid cutover status"
      [[ "$phase" == standby || "$phase" == demoted ||
         "$phase" == rejected ]] ||
        die "$slot/$origin is not read-only: $phase"
    else
      read_status "$slot" "$origin" "$expected" >/dev/null ||
        die "$slot/$origin is not a valid $expected endpoint"
    fi
  done
}

demote_endpoint() {
  local slot=$1 origin=$2 cutover_id=$3 marker=$4
  local status instance operation_id rc
  status=$(read_status "$slot" "$origin" active) ||
    die "$slot/$origin is not active before demotion"
  instance=$(sed -n '2p' <<<"$status")
  operation_id=$cutover_id-$origin
  # Persist intent before the RPC. If this controller process dies at any point
  # after the request can become visible to the daemon, selector rollback sees
  # the intent and refuses to resume until the exact ID is terminal.
  write_unknown_state demote "$slot" "$origin" "$operation_id"
  if "$cutover" demote \
    --port "$(port_for "$slot" "$origin")" \
    --log "$(log_for "$origin")" \
    --token-file "$token_file" \
    --cutover-id "$operation_id" \
    --expected-instance "$instance" \
    --marker-out "$marker" \
    --timeout-ms "$control_timeout_ms" >/dev/null; then
    rc=0
  else
    rc=$?
  fi
  if (( rc == 4 )); then
    reconcile_unknown_transition demote "$slot" "$origin" "$operation_id" ||
      die "$slot/$origin demotion transport outcome is unresolved"
  elif (( rc == 3 )); then
    clear_unknown_state
    die "$slot/$origin demotion was rejected"
  elif (( rc != 0 )); then
    die "$slot/$origin demotion failed with unresolved local status $rc"
  fi
  await_status "$slot" "$origin" demoted "$operation_id" >/dev/null ||
    die "$slot/$origin did not become demoted"
  clear_unknown_state
}

promote_endpoint() {
  local slot=$1 origin=$2 cutover_id=$3 marker=$4 operation_id rc
  [[ -f "$marker" && ! -L "$marker" ]] ||
    die "promotion marker is missing or unsafe: $marker"
  operation_id=$cutover_id-$origin
  write_unknown_state promote "$slot" "$origin" "$operation_id"
  if "$cutover" promote \
    --port "$(port_for "$slot" "$origin")" \
    --log "$(log_for "$origin")" \
    --token-file "$token_file" \
    --cutover-id "$operation_id" \
    --marker-file "$marker" \
    --timeout-ms "$control_timeout_ms" >/dev/null; then
    rc=0
  else
    rc=$?
  fi
  if (( rc == 4 )); then
    reconcile_unknown_transition promote "$slot" "$origin" "$operation_id" ||
      die "$slot/$origin promotion transport outcome is unresolved"
  elif (( rc == 3 )); then
    clear_unknown_state
    die "$slot/$origin promotion was rejected"
  elif (( rc != 0 )); then
    die "$slot/$origin promotion failed with unresolved local status $rc"
  fi
  await_status "$slot" "$origin" active "$operation_id" >/dev/null ||
    die "$slot/$origin did not become active"
  clear_unknown_state
}

verify_prepared_endpoint() {
  local slot=$1 origin=$2 cutover_id=$3
  local operation_id status phase cutover_phase observed_cutover_id
  operation_id=$cutover_id-$origin
  status=$(read_status "$slot" "$origin" any) ||
    die "$slot/$origin has no valid status after preparation"
  phase=$(sed -n '1p' <<<"$status")
  cutover_phase=$(sed -n '4p' <<<"$status")
  observed_cutover_id=$(sed -n '5p' <<<"$status")
  [[ "$phase" == standby || "$phase" == demoted ]] ||
    die "$slot/$origin gained authority during preparation: $phase"
  [[ "$cutover_phase" == prepared &&
     "$observed_cutover_id" == "$operation_id" ]] ||
    die "$slot/$origin lacks preparation proof for $operation_id"
}

prepare_endpoint() {
  local slot=$1 origin=$2 cutover_id=$3 identity_out=$4
  local operation_id response rc prepared_identity
  operation_id=$cutover_id-$origin
  response=$(mktemp "$state/prepare.$origin.XXXXXX")
  if "$cutover" prepare \
    --port "$(port_for "$slot" "$origin")" \
    --log "$(log_for "$origin")" \
    --token-file "$token_file" \
    --cutover-id "$operation_id" \
    --timeout-ms "$control_timeout_ms" >"$response"; then
    rc=0
  else
    rc=$?
  fi
  if (( rc != 0 )); then
    printf '%s/%s preparation failed with status %s\n' \
      "$slot" "$origin" "$rc" >&2
    rm -f -- "$response"
    return 1
  fi
  if ! prepared_identity=$(
    inspect_prepare "$response" "$operation_id" "$origin"
  ); then
    rm -f -- "$response"
    return 1
  fi
  rm -f -- "$response"
  if ! verify_prepared_endpoint "$slot" "$origin" "$cutover_id"; then
    return 1
  fi
  printf '%s\n' "$prepared_identity" >"$identity_out"
}

sample_runtime_unit() {
  local unit=$1 properties rc
  local load_state="" fragment_path="" drop_in_paths="" need_reload=""
  local active_state="" sub_state="" main_pid="" invocation_id=""
  local exec_start="" memory_current="" memory_max="" memory_swap_max=""
  local cpu_quota="" tasks_current="" tasks_max="" n_restarts="" restart=""
  local exec_command="" exec_start_pre="" runtime_name=${unit%.service}-runtime
  local key value

  if properties=$(
    timeout --signal=TERM --kill-after=1s \
      "${readiness_systemctl_timeout_seconds}s" \
      "$systemctl_bin" show "$unit" --no-pager \
      --property=LoadState \
      --property=FragmentPath \
      --property=DropInPaths \
      --property=NeedDaemonReload \
      --property=ActiveState \
      --property=SubState \
      --property=MainPID \
      --property=InvocationID \
      --property=ExecMainStartTimestampMonotonic \
      --property=MemoryCurrent \
      --property=MemoryMax \
      --property=MemorySwapMax \
      --property=CPUQuotaPerSecUSec \
      --property=TasksCurrent \
      --property=TasksMax \
      --property=NRestarts \
      --property=Restart \
      --property=ExecStart \
      --property=ExecStartPre
  ); then
    :
  else
    rc=$?
    printf 'systemd inspection exited %s\n' "$rc" >&2
    return 1
  fi
  while IFS='=' read -r key value; do
    case "$key" in
      LoadState) load_state=$value ;;
      FragmentPath) fragment_path=$value ;;
      DropInPaths) drop_in_paths=$value ;;
      NeedDaemonReload) need_reload=$value ;;
      ActiveState) active_state=$value ;;
      SubState) sub_state=$value ;;
      MainPID) main_pid=$value ;;
      InvocationID) invocation_id=$value ;;
      ExecMainStartTimestampMonotonic) exec_start=$value ;;
      MemoryCurrent) memory_current=$value ;;
      MemoryMax) memory_max=$value ;;
      MemorySwapMax) memory_swap_max=$value ;;
      CPUQuotaPerSecUSec) cpu_quota=$value ;;
      TasksCurrent) tasks_current=$value ;;
      TasksMax) tasks_max=$value ;;
      NRestarts) n_restarts=$value ;;
      Restart) restart=$value ;;
      ExecStart) exec_command=$value ;;
      ExecStartPre) exec_start_pre=$value ;;
    esac
  done <<<"$properties"

  [[ "$load_state" == loaded &&
     "$fragment_path" == "/etc/systemd/system/$unit" &&
     -z "$drop_in_paths" &&
     "$need_reload" == no &&
     "$active_state" == active && "$sub_state" == running &&
     "$main_pid" =~ ^[1-9][0-9]*$ &&
     "$invocation_id" =~ ^[0-9a-f]{32}$ &&
     "$exec_start" =~ ^[1-9][0-9]*$ &&
     "$memory_current" =~ ^[0-9]+$ &&
     "$memory_max" =~ ^[1-9][0-9]*$ &&
     "$memory_swap_max" =~ ^[0-9]+$ &&
     "$cpu_quota" == "$readiness_expected_cpu_quota" &&
     "$tasks_current" =~ ^[0-9]+$ &&
     ( "$tasks_max" == infinity || "$tasks_max" =~ ^[1-9][0-9]*$ ) &&
     "$n_restarts" =~ ^[0-9]+$ &&
     "$restart" == "$readiness_expected_restart" ]] || return 1
  (( n_restarts <= readiness_max_restarts )) || return 1
  if [[ "$tasks_max" != infinity ]]; then
    (( tasks_current <= tasks_max )) || return 1
  fi
  [[ "$exec_command" =~ path=/nix/store/[0-9a-z]{32}-north-coord-slot-start[^/]*/bin/north-coord-slot-start &&
     "$exec_start_pre" =~ path=/nix/store/[0-9a-z]{32}-${runtime_name}[^/]*/bin/${runtime_name} &&
     "$exec_start_pre" == *"/$runtime_name ensure-default "* ]] || return 1
  printf '%s %s %s %s %s %s %s %s %s %s %s\n' \
    "$main_pid" "$invocation_id" "$exec_start" \
    "$memory_current" "$memory_max" "$memory_swap_max" "$cpu_quota" \
    "$tasks_current" "$tasks_max" "$n_restarts" "$restart"
}

sample_process_identity() {
  local unit=$1 port=$2 main_pid=$3 entry key value stat_line remainder birth
  local mode="" source="" revision="" tree="" origin="" daemon=""
  local controller="" observed_port=""
  local -a stat_fields
  declare -A seen=()

  [[ -r "$proc_root/$main_pid/stat" &&
     -r "$proc_root/$main_pid/environ" ]] || return 1
  stat_line=$(<"$proc_root/$main_pid/stat")
  remainder=${stat_line##*) }
  read -r -a stat_fields <<<"$remainder"
  birth=${stat_fields[19]:-}
  [[ "$birth" =~ ^[1-9][0-9]*$ ]] || return 1

  while IFS= read -r -d '' entry; do
    key=${entry%%=*}
    value=${entry#*=}
    case "$key" in
      NORTH_FRAM_RUNTIME|FRAM_RUNTIME_SOURCE|FRAM_RUNTIME_REV|\
      FRAM_RUNTIME_TREE|FRAM_RUNTIME_ORIGIN|FRAM_RUNTIME_DAEMON|\
      NORTH_COORD_SYSTEMD_UNIT|FRAM_PORT)
        [[ -z "${seen[$key]+x}" ]] || return 1
        seen[$key]=$value
        ;;
    esac
  done <"$proc_root/$main_pid/environ"

  mode=${seen[NORTH_FRAM_RUNTIME]:-}
  source=${seen[FRAM_RUNTIME_SOURCE]:-}
  revision=${seen[FRAM_RUNTIME_REV]:-}
  tree=${seen[FRAM_RUNTIME_TREE]:-}
  origin=${seen[FRAM_RUNTIME_ORIGIN]:-}
  daemon=${seen[FRAM_RUNTIME_DAEMON]:-}
  controller=${seen[NORTH_COORD_SYSTEMD_UNIT]:-}
  observed_port=${seen[FRAM_PORT]:-}
  [[ "$mode" == package || "$mode" == checkout ]] || return 1
  [[ "$source" == /* && "$origin" == /* && "$daemon" == /* ]] || return 1
  [[ "$revision" =~ ^[0-9a-f]{40}$ ]] || return 1
  if [[ "$mode" == package ]]; then
    [[ "$tree" == "immutable:$revision" &&
       "$origin" =~ ^/nix/store/[0-9a-z]{32}-fram[^/]*$ &&
       "$source" == "$origin/libexec/fram" &&
       "$daemon" == "$origin/bin/fram-daemon" ]] || return 1
  else
    [[ "$tree" =~ ^[0-9a-f]{40}$ &&
       "$daemon" == "$source/bin/fram-daemon" ]] || return 1
  fi
  [[ "$controller" == "$unit" && "$observed_port" == "$port" ]] || return 1
  printf '%s %s %s\n' "$birth" "$revision" "$tree"
}

sample_jvm_health() {
  local main_pid=$1 flags heap max_heap heap_numbers
  if ! flags=$(
    timeout --signal=TERM --kill-after=1s \
      "${readiness_jcmd_timeout_seconds}s" \
      "$jcmd_bin" "$main_pid" VM.flags
  ); then
    return 1
  fi
  if ! max_heap=$(
    gawk '
      {
        for (i = 1; i <= NF; i += 1) {
          if ($i == "-XX:+UseG1GC") g1 += 1
          if ($i == "-XX:+UseSerialGC") serial += 1
          if (match($i, /^-XX:MaxHeapSize=([0-9]+)$/, m)) {
            heaps += 1
            max_heap = m[1]
          }
        }
      }
      END {
        if (g1 != 1 || serial != 0 || heaps != 1) exit 1
        print max_heap
      }
    ' <<<"$flags"
  ); then
    return 1
  fi
  if ! heap=$(
    timeout --signal=TERM --kill-after=1s \
      "${readiness_jcmd_timeout_seconds}s" \
      "$jcmd_bin" "$main_pid" GC.heap_info
  ); then
    return 1
  fi
  if ! heap_numbers=$(
    gawk '
      function bytes(value, unit) {
        if (unit == "G") return value * 1024 * 1024 * 1024
        if (unit == "M") return value * 1024 * 1024
        return value * 1024
      }
      match($0, /^[[:space:]]*garbage-first heap[[:space:]]+total[[:space:]]+([0-9]+)([KMG]),[[:space:]]+used[[:space:]]+([0-9]+)([KMG])[[:space:]]/, m) {
        rows += 1
        total = bytes(m[1], m[2])
        used = bytes(m[3], m[4])
      }
      END {
        if (rows != 1 || used < 0 || total <= 0 || used > total) exit 1
        printf "%.0f %.0f\n", used, total
      }
    ' <<<"$heap"
  ); then
    return 1
  fi
  printf '%s %s\n' "$max_heap" "$heap_numbers"
}

verify_target_runtime_readiness() {
  local slot=$1 origin=$2 expected_phase=$3 expected_instance=$4
  local expected_version=$5 expected_pid=$6 expected_invocation=$7
  local expected_start=$8 expected_birth=$9 expected_revision=${10}
  local expected_tree=${11} expected_cutover_id=${12}
  local unit port status_before status_after
  local phase instance version observed_cutover_id
  local after_phase after_instance after_version after_cutover_id
  local unit_before unit_after main_pid invocation_id exec_start
  local memory_current memory_max memory_swap_max cpu_quota
  local tasks_current tasks_max n_restarts restart
  local after_pid after_invocation after_start after_memory_current
  local after_memory_max after_memory_swap_max after_cpu_quota
  local after_tasks_current after_tasks_max after_n_restarts after_restart
  local jvm_health max_heap heap_used heap_total
  local process_identity after_process_identity birth revision tree
  local after_birth after_revision after_tree
  local expected_memory_max max_memory_current expected_max_heap max_heap_used

  valid_slot "$slot" || die "invalid runtime readiness slot: $slot"
  valid_origin "$origin" || die "invalid runtime readiness origin: $origin"
  unit=$(unit_for "$slot" "$origin")
  port=$(port_for "$slot" "$origin")
  expected_memory_max=$(contract_for "$origin" memory-max)
  max_memory_current=$(contract_for "$origin" memory-current)
  expected_max_heap=$(contract_for "$origin" max-heap)
  max_heap_used=$(contract_for "$origin" heap-used)
  [[ "$unit" =~ ^[A-Za-z0-9_.@:-]+\.service$ ]] ||
    die "$slot/$origin readiness rejected: unsafe unit name"

  status_before=$(read_status "$slot" "$origin" any) ||
    die "$slot/$origin readiness rejected: cutover status is unavailable"
  phase=$(sed -n '1p' <<<"$status_before")
  instance=$(sed -n '2p' <<<"$status_before")
  version=$(sed -n '3p' <<<"$status_before")
  observed_cutover_id=$(sed -n '5p' <<<"$status_before")
  case "$expected_phase" in
    read-only)
      [[ "$phase" == standby || "$phase" == demoted ]] ||
        die "$slot/$origin readiness rejected: endpoint is not read-only"
      ;;
    active)
      [[ "$phase" == active ]] ||
        die "$slot/$origin readiness rejected: endpoint is not active"
      ;;
    *) die "invalid runtime readiness phase: $expected_phase" ;;
  esac
  [[ "$expected_instance" == any || "$instance" == "$expected_instance" ]] ||
    die "$slot/$origin readiness rejected: prepared instance changed"
  [[ "$expected_version" == any || "$version" == "$expected_version" ]] ||
    die "$slot/$origin readiness rejected: prepared version changed"
  [[ "$observed_cutover_id" == "$expected_cutover_id" ]] ||
    die "$slot/$origin readiness rejected: cutover identity changed"

  unit_before=$(sample_runtime_unit "$unit") ||
    die "$slot/$origin readiness rejected: systemd evidence is unavailable or malformed"
  read -r main_pid invocation_id exec_start \
    memory_current memory_max memory_swap_max cpu_quota \
    tasks_current tasks_max n_restarts restart <<<"$unit_before"
  [[ "$expected_pid" == any || "$main_pid" == "$expected_pid" ]] ||
    die "$slot/$origin readiness rejected: MainPID changed"
  [[ "$expected_invocation" == any ||
     "$invocation_id" == "$expected_invocation" ]] ||
    die "$slot/$origin readiness rejected: InvocationID changed"
  [[ "$expected_start" == any || "$exec_start" == "$expected_start" ]] ||
    die "$slot/$origin readiness rejected: process start changed"
  [[ "$memory_max" == "$expected_memory_max" ]] ||
    die "$slot/$origin readiness rejected: live MemoryMax is $memory_max, expected $expected_memory_max"
  [[ "$memory_swap_max" == "$readiness_expected_memory_swap_max_bytes" ]] ||
    die "$slot/$origin readiness rejected: live MemorySwapMax is $memory_swap_max, expected $readiness_expected_memory_swap_max_bytes"
  (( memory_current < max_memory_current )) ||
    die "$slot/$origin readiness rejected: MemoryCurrent $memory_current is not below $max_memory_current"
  (( tasks_current <= readiness_max_tasks )) ||
    die "$slot/$origin readiness rejected: TasksCurrent $tasks_current exceeds $readiness_max_tasks"

  jvm_health=$(sample_jvm_health "$main_pid") ||
    die "$slot/$origin readiness rejected: live G1/heap evidence is unavailable or malformed"
  read -r max_heap heap_used heap_total <<<"$jvm_health"
  [[ "$max_heap" == "$expected_max_heap" ]] ||
    die "$slot/$origin readiness rejected: live MaxHeapSize is $max_heap, expected $expected_max_heap"
  (( heap_total <= max_heap )) ||
    die "$slot/$origin readiness rejected: committed heap exceeds MaxHeapSize"
  (( heap_used < max_heap_used )) ||
    die "$slot/$origin readiness rejected: live heap used $heap_used is not below $max_heap_used"

  process_identity=$(sample_process_identity "$unit" "$port" "$main_pid") ||
    die "$slot/$origin readiness rejected: process runtime identity is unavailable or malformed"
  read -r birth revision tree <<<"$process_identity"
  [[ "$expected_birth" == any || "$birth" == "$expected_birth" ]] ||
    die "$slot/$origin readiness rejected: process birth changed"
  [[ "$expected_revision" == any || "$revision" == "$expected_revision" ]] ||
    die "$slot/$origin readiness rejected: runtime revision changed"
  [[ "$expected_tree" == any || "$tree" == "$expected_tree" ]] ||
    die "$slot/$origin readiness rejected: runtime tree changed"

  unit_after=$(sample_runtime_unit "$unit") ||
    die "$slot/$origin readiness rejected: post-jcmd systemd evidence is unavailable or malformed"
  read -r after_pid after_invocation after_start \
    after_memory_current after_memory_max after_memory_swap_max after_cpu_quota \
    after_tasks_current after_tasks_max after_n_restarts after_restart \
    <<<"$unit_after"
  [[ "$after_pid" == "$main_pid" &&
     "$after_invocation" == "$invocation_id" &&
     "$after_start" == "$exec_start" ]] ||
    die "$slot/$origin readiness rejected: process invocation changed during jcmd"
  [[ "$after_memory_max" == "$expected_memory_max" ]] ||
    die "$slot/$origin readiness rejected: post-jcmd MemoryMax changed"
  [[ "$after_memory_swap_max" == "$readiness_expected_memory_swap_max_bytes" ]] ||
    die "$slot/$origin readiness rejected: post-jcmd MemorySwapMax changed"
  (( after_memory_current < max_memory_current )) ||
    die "$slot/$origin readiness rejected: post-jcmd MemoryCurrent is over the limit"
  (( after_tasks_current <= readiness_max_tasks )) ||
    die "$slot/$origin readiness rejected: post-jcmd TasksCurrent is over the limit"

  after_process_identity=$(sample_process_identity "$unit" "$port" "$main_pid") ||
    die "$slot/$origin readiness rejected: post-jcmd runtime identity is unavailable"
  read -r after_birth after_revision after_tree <<<"$after_process_identity"
  [[ "$after_birth" == "$birth" &&
     "$after_revision" == "$revision" &&
     "$after_tree" == "$tree" ]] ||
    die "$slot/$origin readiness rejected: runtime identity changed during jcmd"

  status_after=$(read_status "$slot" "$origin" any) ||
    die "$slot/$origin readiness rejected: post-jcmd cutover status is unavailable"
  after_phase=$(sed -n '1p' <<<"$status_after")
  after_instance=$(sed -n '2p' <<<"$status_after")
  after_version=$(sed -n '3p' <<<"$status_after")
  after_cutover_id=$(sed -n '5p' <<<"$status_after")
  [[ "$after_phase" == "$phase" &&
     "$after_instance" == "$instance" &&
     "$after_cutover_id" == "$observed_cutover_id" ]] ||
    die "$slot/$origin readiness rejected: prepared Fram instance changed during jcmd"
  if [[ "$expected_phase" == read-only ]]; then
    [[ "$after_version" == "$version" ]] ||
      die "$slot/$origin readiness rejected: prepared version changed during jcmd"
  fi

  printf '%s %s %s %s %s %s %s %s\n' \
    "$instance" "$version" "$main_pid" "$invocation_id" "$exec_start" \
    "$birth" "$revision" "$tree"
}

write_gate_state() {
  local cutover_id=$1 old=$2 target=$3 instance=$4 version=$5
  local main_pid=$6 invocation_id=$7 exec_start=$8 temp
  mkdir -p "$state"
  temp=$state/gate.current.next.$$
  printf '%s %s %s %s %s %s %s %s\n' \
    "$cutover_id" "$old" "$target" "$instance" "$version" \
    "$main_pid" "$invocation_id" "$exec_start" >"$temp"
  sync -f "$temp"
  mv -T "$temp" "$state/gate.current"
  sync -f "$state"
}

read_gate_state() {
  local cutover_id old target instance version main_pid invocation_id
  local exec_start extra
  [[ -f "$state/gate.current" && ! -L "$state/gate.current" ]] ||
    die "gate recovery state is missing"
  read -r cutover_id old target instance version main_pid invocation_id \
    exec_start extra <"$state/gate.current" ||
    die "cannot read gate recovery state"
  [[ "$cutover_id" =~ ^[A-Za-z0-9_.:-]+$ && -z "${extra:-}" ]] ||
    die "gate recovery state is malformed"
  valid_slot "$old" || die "gate state has invalid old slot"
  valid_slot "$target" || die "gate state has invalid target slot"
  if [[ -z "${instance:-}" ]]; then
    instance=none
    version=none
    main_pid=none
    invocation_id=none
    exec_start=none
  else
    [[ "$instance" =~ ^[A-Za-z0-9_.:-]+$ &&
       "$version" =~ ^[0-9]+$ &&
       "$main_pid" =~ ^[1-9][0-9]*$ &&
       "$invocation_id" =~ ^[0-9a-f]{32}$ &&
       "$exec_start" =~ ^[1-9][0-9]*$ ]] ||
      die "gate readiness identity is malformed"
  fi
  printf '%s %s %s %s %s %s %s %s\n' \
    "$cutover_id" "$old" "$target" "$instance" "$version" \
    "$main_pid" "$invocation_id" "$exec_start"
}

write_readiness_state() {
  local origin=$1 identity=$2 temp
  valid_origin "$origin" || die "invalid readiness origin: $origin"
  temp=$state/readiness.$origin.next.$$
  printf '%s\n' "$identity" >"$temp"
  sync -f "$temp"
  mv -T "$temp" "$state/readiness.$origin"
  sync -f "$state"
}

read_readiness_state() {
  local origin=$1 instance version main_pid invocation_id exec_start
  local birth revision tree extra
  valid_origin "$origin" || die "invalid readiness origin: $origin"
  [[ -f "$state/readiness.$origin" &&
     ! -L "$state/readiness.$origin" ]] ||
    die "$origin readiness state is missing"
  read -r instance version main_pid invocation_id exec_start \
    birth revision tree extra <"$state/readiness.$origin" ||
    die "$origin readiness state cannot be read"
  [[ "$instance" =~ ^[A-Za-z0-9_.:-]+$ &&
     "$version" =~ ^[0-9]+$ &&
     "$main_pid" =~ ^[1-9][0-9]*$ &&
     "$invocation_id" =~ ^[0-9a-f]{32}$ &&
     "$exec_start" =~ ^[1-9][0-9]*$ &&
     "$birth" =~ ^[1-9][0-9]*$ &&
     "$revision" =~ ^[0-9a-f]{40}$ &&
     ( "$tree" =~ ^[0-9a-f]{40}$ ||
       "$tree" == "immutable:$revision" ) &&
     -z "${extra:-}" ]] ||
    die "$origin readiness state is malformed"
  printf '%s %s %s %s %s %s %s %s\n' \
    "$instance" "$version" "$main_pid" "$invocation_id" "$exec_start" \
    "$birth" "$revision" "$tree"
}

prepare_pair() {
  local old=$1 target=$2 transaction_file=$3 cutover_id
  local coord_pid telemetry_pid coord_ok=0 telemetry_ok=0
  local coord_identity=$state/prepare.coord.identity
  local telemetry_identity=$state/prepare.telemetry.identity
  local origin prepared_instance prepared_version readiness_identity
  local coord_readiness telemetry_readiness
  local main_pid invocation_id exec_start
  valid_slot "$old" || die "invalid old slot: $old"
  valid_slot "$target" || die "invalid target slot: $target"
  [[ "$old" != "$target" ]] || die "old and target slots are identical"
  [[ "$transaction_file" == /* ]] ||
    die "selector transaction path must be absolute"
  [[ ! -e "$transaction_file" && ! -L "$transaction_file" ]] ||
    die "selector transaction exists before standby preparation"

  mkdir -p "$state"
  settle_recorded_unknown ||
    die "cannot prepare while a prior transport outcome is unresolved"
  verify_pair "$old" active
  verify_pair "$target" read-only

  rm -f -- "$coord_identity" "$telemetry_identity" \
    "$state/readiness.coord" "$state/readiness.telemetry"
  cutover_id="selector-$(date -u +%Y%m%dT%H%M%S)-$$"
  prepare_endpoint "$target" coord "$cutover_id" "$coord_identity" &
  coord_pid=$!
  prepare_endpoint "$target" telemetry "$cutover_id" "$telemetry_identity" &
  telemetry_pid=$!
  if wait "$coord_pid"; then coord_ok=1; fi
  if wait "$telemetry_pid"; then telemetry_ok=1; fi
  if (( coord_ok != 1 || telemetry_ok != 1 )); then
    die "target preparation failed; source authority was not changed"
  fi
  for origin in coord telemetry; do
    read -r prepared_instance prepared_version \
      <"$state/prepare.$origin.identity" ||
      die "$origin preparation identity is missing"
    readiness_identity=$(
      verify_target_runtime_readiness \
        "$target" "$origin" read-only \
        "$prepared_instance" "$prepared_version" \
        any any any any any any "$cutover_id-$origin"
    )
    printf -v "${origin}_readiness" '%s' "$readiness_identity"
  done
  write_readiness_state coord "$coord_readiness"
  write_readiness_state telemetry "$telemetry_readiness"
  read -r prepared_instance prepared_version main_pid invocation_id exec_start \
    _ _ _ < <(read_readiness_state telemetry)

  # This is written only after both explicit acknowledgements and status
  # proofs. The selector still has no transaction and the frontend is still
  # OPEN; a crash here is therefore a harmless, read-only prepared standby.
  write_gate_state \
    "$cutover_id" "$old" "$target" "$prepared_instance" "$prepared_version" \
    "$main_pid" "$invocation_id" "$exec_start"
}

promote_pair() {
  local old=$1 target=$2 transaction_file=$3
  local cutover_id prepared_old prepared_target origin marker
  local prepared_instance prepared_version main_pid invocation_id exec_start
  local birth revision tree
  valid_slot "$old" || die "invalid old slot: $old"
  valid_slot "$target" || die "invalid target slot: $target"
  [[ "$old" != "$target" ]] || die "old and target slots are identical"
  [[ "$transaction_file" == /* ]] ||
    die "selector transaction path must be absolute"

  mkdir -p "$state"
  settle_recorded_unknown ||
    die "cannot cut over while a prior transport outcome is unresolved"
  verify_pair "$old" active
  # A never-promoted candidate is :standby; a previously active candidate is
  # :demoted. Both are valid read-only successors. This is what makes repeated
  # blue -> green -> blue cutovers possible without restarting either slot.
  verify_pair "$target" read-only

  read -r cutover_id prepared_old prepared_target prepared_instance \
    prepared_version main_pid invocation_id exec_start < <(read_gate_state)
  [[ "$prepared_old" == "$old" && "$prepared_target" == "$target" ]] ||
    die "prepared cutover state does not match $old -> $target"
  [[ "$prepared_instance" != none ]] ||
    die "prepared cutover lacks a process-bound readiness proof"
  for origin in coord telemetry; do
    verify_prepared_endpoint "$target" "$origin" "$cutover_id"
  done
  # Preparation is a proof about a captured prefix, not a durable claim that
  # the target remains operational. Recheck both origins immediately before
  # the first source demotion.
  for origin in coord telemetry; do
    read -r prepared_instance prepared_version main_pid invocation_id \
      exec_start birth revision tree < <(read_readiness_state "$origin")
    verify_target_runtime_readiness \
      "$target" "$origin" read-only \
      "$prepared_instance" "$prepared_version" \
      "$main_pid" "$invocation_id" "$exec_start" \
      "$birth" "$revision" "$tree" "$cutover_id-$origin" >/dev/null
  done

  rm -f -- "$state"/*.old-demotion.edn "$state"/*.rollback.edn

  # Demote both logs before either target endpoint is promoted. If any turn
  # fails, selector keeps the public frontend held and invokes rollback_pair.
  for origin in coord telemetry; do
    marker=$state/$origin.old-demotion.edn
    demote_endpoint "$old" "$origin" "$cutover_id" "$marker"
  done
  for origin in coord telemetry; do
    marker=$state/$origin.old-demotion.edn
    promote_endpoint "$target" "$origin" "$cutover_id" "$marker"
  done
  verify_pair "$target" active
  # Promotion synchronizes the exact final marker under writer authority.
  # Before the selector routes or resumes, prove both prepared JVMs remain
  # active under the same effective unit and runtime identities.
  for origin in coord telemetry; do
    read -r prepared_instance _ main_pid invocation_id \
      exec_start birth revision tree < <(read_readiness_state "$origin")
    verify_target_runtime_readiness \
      "$target" "$origin" active "$prepared_instance" any \
      "$main_pid" "$invocation_id" "$exec_start" \
      "$birth" "$revision" "$tree" "$cutover_id-$origin" >/dev/null
  done
}

rollback_pair() {
  local target_arg=$1 old_arg=$2 transaction_file=$3
  local cutover_id old target origin old_status old_phase
  local target_status target_phase marker marker_cutover_id
  [[ "$transaction_file" == /* ]] ||
    die "selector transaction path must be absolute"
  settle_recorded_unknown ||
    die "cannot rollback while a cutover transport outcome is unresolved"
  if [[ ! -e "$state/gate.current" &&
        ! -L "$state/gate.current" ]]; then
    # Selector durably records gate-started immediately before invoking this
    # program. A crash in that tiny pre-invocation window has no gate state
    # and, crucially, no authority mutation. Prove the old pair is still
    # active and treat rollback as an idempotent no-op.
    valid_slot "$target_arg" || die "invalid rollback target: $target_arg"
    valid_slot "$old_arg" || die "invalid rollback old slot: $old_arg"
    verify_pair "$old_arg" active
    return 0
  fi
  read -r cutover_id old target _ _ _ _ _ < <(read_gate_state)
  if [[ "$target_arg" != "$target" || "$old_arg" != "$old" ]]; then
    # A completed prior cutover intentionally leaves its gate proof available
    # until the next gate invocation overwrites it. If the selector crashes
    # after recording a new gate-started transaction but before this program
    # writes new state, the prior state is stale. No authority mutation was
    # possible in that window; prove the requested old pair still owns both
    # logs and the target is read-only before treating rollback as a no-op.
    verify_pair "$old_arg" active
    verify_pair "$target_arg" read-only
    return 0
  fi

  # First settle every transition and demote every target that reached active.
  # Never reacquire an old authority while another origin is still transitional.
  for origin in coord telemetry; do
    old_status=$(read_status "$old" "$origin" any) ||
      die "cannot inspect old $origin endpoint during rollback"
    old_phase=$(sed -n '1p' <<<"$old_status")
    if [[ "$old_phase" == demoting || "$old_phase" == promoting ]]; then
      old_status=$(await_terminal "$old" "$origin") ||
        die "old $origin transition did not settle during rollback"
      old_phase=$(sed -n '1p' <<<"$old_status")
    fi

    target_status=$(read_status "$target" "$origin" any) ||
      die "cannot inspect target $origin endpoint during rollback"
    target_phase=$(sed -n '1p' <<<"$target_status")
    if [[ "$target_phase" == promoting || "$target_phase" == demoting ]]; then
      target_status=$(await_terminal "$target" "$origin") ||
        die "target $origin transition did not settle during rollback"
      target_phase=$(sed -n '1p' <<<"$target_status")
    fi

    [[ ! ( "$old_phase" == active && "$target_phase" == active ) ]] ||
      die "split writer authority observed for $origin during rollback"

    if [[ "$target_phase" == active ]]; then
      marker=$state/$origin.rollback.edn
      demote_endpoint "$target" "$origin" "rollback-$cutover_id" "$marker"
    fi
  done

  # With every target terminal and read-only, restore each old authority.
  for origin in coord telemetry; do
    old_status=$(read_status "$old" "$origin" any) ||
      die "cannot re-inspect old $origin endpoint during rollback"
    old_phase=$(sed -n '1p' <<<"$old_status")
    [[ "$old_phase" != active ]] || continue
    [[ "$old_phase" == demoted || "$old_phase" == rejected ||
       "$old_phase" == standby ]] ||
      die "old $origin is not safely promotable: $old_phase"

    if [[ -f "$state/$origin.rollback.edn" &&
          ! -L "$state/$origin.rollback.edn" ]]; then
      marker=$state/$origin.rollback.edn
      marker_cutover_id=rollback-$cutover_id
    else
      marker=$state/$origin.old-demotion.edn
      marker_cutover_id=$cutover_id
    fi

    # Marker and request retain the same transaction ID. If the exact prefix
    # has advanced, Fram rejects the marker and the selector remains held for
    # bounded durable-slot restart recovery.
    promote_endpoint "$old" "$origin" "$marker_cutover_id" "$marker"
  done
  verify_pair "$old" active
  rm -f -- "$state/gate.current" \
    "$state/readiness.coord" "$state/readiness.telemetry" \
    "$state"/*.old-demotion.edn "$state"/*.rollback.edn
  sync -f "$state"
}

mkdir -p "$state"

case "${1:-}" in
  prepare)
    [[ $# -eq 4 ]] || die "usage: $program prepare OLD TARGET TRANSACTION"
    prepare_pair "$2" "$3" "$4"
    ;;
  verify)
    [[ $# -eq 2 ]] || die "usage: $program verify SLOT"
    verify_pair "$2" active
    ;;
  verify-phase)
    [[ $# -eq 3 ]] || die "usage: $program verify-phase SLOT PHASE"
    verify_pair "$2" "$3"
    ;;
  promote)
    [[ $# -eq 4 ]] || die "usage: $program promote OLD TARGET TRANSACTION"
    promote_pair "$2" "$3" "$4"
    ;;
  rollback)
    [[ $# -eq 4 ]] || die "usage: $program rollback TARGET OLD TRANSACTION"
    rollback_pair "$2" "$3" "$4"
    ;;
  *)
    die "usage: $program {prepare|verify|verify-phase|promote|rollback} ..."
    ;;
esac
