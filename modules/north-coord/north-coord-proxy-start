#!/usr/bin/env bash
set -euo pipefail

program=${0##*/}

die() {
  printf '%s: %s\n' "$program" "$*" >&2
  exit 2
}

: "${NORTH_COORD_HAPROXY:?missing NORTH_COORD_HAPROXY}"
: "${NORTH_COORD_HAPROXY_CONFIG:?missing NORTH_COORD_HAPROXY_CONFIG}"
: "${NORTH_COORD_BOOTSTRAP_MARKER:?missing NORTH_COORD_BOOTSTRAP_MARKER}"

[[ -f "$NORTH_COORD_BOOTSTRAP_MARKER" &&
   ! -L "$NORTH_COORD_BOOTSTRAP_MARKER" ]] ||
  die "authority bootstrap marker is missing or unsafe"

[[ "${LISTEN_PID:-}" == "$$" ]] ||
  die "public socket descriptors were not passed to this process"
[[ "${LISTEN_FDS:-0}" == 2 ]] ||
  die "expected exactly two public descriptors, observed ${LISTEN_FDS:-0}"
[[ -r /proc/self/fd/3 && -r /proc/self/fd/4 ]] ||
  die "public descriptors 3 and 4 are not open"

# HAProxy consumes both permanent systemd-owned listeners. Routing is selected
# by dst_port plus one durable map key, so the pair swaps atomically.
exec "$NORTH_COORD_HAPROXY" -W -db -f "$NORTH_COORD_HAPROXY_CONFIG"
