#!/usr/bin/env bash
set -euo pipefail

umask 077

program=${0##*/}

die() {
  printf '%s: %s\n' "$program" "$*" >&2
  exit 2
}

need_setting() {
  local name=$1
  [[ -n "${!name:-}" ]] || die "required selector setting is missing: $name"
}

need_setting NORTH_COORD_SELECTOR_SOCKET
need_setting NORTH_COORD_SELECTOR_MAP
need_setting NORTH_COORD_SELECTOR_FRONTEND
need_setting NORTH_COORD_SELECTOR_LOCK

admin_socket=$NORTH_COORD_SELECTOR_SOCKET
route_map=$NORTH_COORD_SELECTOR_MAP
frontend=$NORTH_COORD_SELECTOR_FRONTEND
selector_lock=$NORTH_COORD_SELECTOR_LOCK
transaction_file=${NORTH_COORD_SELECTOR_TRANSACTION:-${route_map}.transaction}
drain_timeout=${NORTH_COORD_SELECTOR_DRAIN_TIMEOUT:-15}
promote_command=${NORTH_COORD_SELECTOR_PROMOTE_COMMAND:-}
rollback_command=${NORTH_COORD_SELECTOR_ROLLBACK_COMMAND:-}
verify_command=${NORTH_COORD_SELECTOR_VERIFY_COMMAND:-}

[[ "$admin_socket" == /* ]] || die "admin socket path must be absolute: $admin_socket"
[[ "$route_map" == /* ]] || die "route map path must be absolute: $route_map"
[[ "$selector_lock" == /* ]] || die "selector lock path must be absolute: $selector_lock"
[[ "$transaction_file" == /* ]] ||
  die "transaction path must be absolute: $transaction_file"
[[ "$frontend" =~ ^[A-Za-z0-9_.:-]+$ ]] ||
  die "frontend name is invalid: $frontend"
if ! [[ "$drain_timeout" =~ ^[0-9]+$ ]] ||
   (( 10#$drain_timeout < 1 )); then
  die "drain timeout must be a positive integer"
fi

route_parent=${route_map%/*}
transaction_parent=${transaction_file%/*}
lock_parent=${selector_lock%/*}

[[ "$route_parent" != "$route_map" && "$transaction_parent" != "$transaction_file" &&
   "$lock_parent" != "$selector_lock" ]] ||
  die "selector paths must have parent directories"

valid_slot() {
  [[ "$1" == blue || "$1" == green ]]
}

other_slot() {
  case "$1" in
    blue) printf '%s\n' green ;;
    green) printf '%s\n' blue ;;
    *) die "invalid coordinator slot: $1" ;;
  esac
}

sync_path() {
  sync -f "$1" || die "cannot sync selector path: $1"
}

write_one_line() {
  local path=$1 line=$2 parent temp
  parent=${path%/*}
  mkdir -p "$parent"
  temp=$parent/.${path##*/}.next.$$
  [[ ! -e "$temp" && ! -L "$temp" ]] ||
    die "temporary selector path already exists: $temp"
  printf '%s\n' "$line" >"$temp"
  sync_path "$temp"
  mv -T "$temp" "$path"
  sync_path "$parent"
}

read_route() {
  local key slot extra
  [[ -f "$route_map" && ! -L "$route_map" ]] ||
    die "route map is missing or unsafe: $route_map"
  read -r key slot extra <"$route_map" ||
    die "cannot read route map: $route_map"
  [[ "$key" == active && -z "${extra:-}" ]] ||
    die "route map is malformed: $route_map"
  valid_slot "$slot" || die "route map has an invalid slot: $slot"
  printf '%s\n' "$slot"
}

persist_route() {
  valid_slot "$1" || die "cannot persist invalid slot: $1"
  write_one_line "$route_map" "active $1"
}

cli() {
  local command=$1
  printf '%s\n' "$command" |
    socat -t 3 - "UNIX-CONNECT:$admin_socket"
}

cli_mutation() {
  local command=$1 output
  output=$(cli "$command") ||
    die "HAProxy command failed: $command"
  if [[ -n "${output//$'\n'/}" ]]; then
    die "HAProxy rejected '$command': $output"
  fi
}

runtime_route() {
  local output key slot
  output=$(cli "show map $route_map") ||
    die "cannot read HAProxy route map"
  read -r _ key slot _ < <(
    awk '$2 == "active" { print; exit }' <<<"$output"
  )
  [[ "$key" == active ]] || die "HAProxy route map lacks the active key"
  valid_slot "$slot" || die "HAProxy route map has an invalid slot: $slot"
  printf '%s\n' "$slot"
}

frontend_sample() {
  cli "show stat" |
    awk -F, -v frontend="$frontend" '
      NR == 1 {
        sub(/^# /, "", $1)
        for (i = 1; i <= NF; i++) column[$i] = i
        next
      }
      $1 == frontend && $2 == "FRONTEND" {
        print $(column["status"]) " " $(column["scur"])
        found = 1
        exit
      }
      END {
        # HAProxy omits a frontend that was configured `disabled` from
        # `show stat` until its first enable. Runtime-disabled frontends may
        # be omitted as well. Treat absence as STOP; `enable frontend` remains
        # the authoritative existence check and rejects a misspelled name.
        if (!found) print "STOP 0"
      }
    '
}

frontend_status() {
  local status sessions
  read -r status sessions < <(frontend_sample) ||
    die "cannot read HAProxy frontend state: $frontend"
  [[ "$status" == OPEN || "$status" == STOP || "$status" == PAUSED ]] ||
    die "unexpected HAProxy frontend state: $status"
  [[ "$sessions" =~ ^[0-9]+$ ]] ||
    die "HAProxy frontend session count is malformed: $sessions"
  printf '%s %s\n' "$status" "$sessions"
}

hold_frontend() {
  local status sessions
  read -r status sessions < <(frontend_status)
  if [[ "$status" == OPEN ]]; then
    cli_mutation "disable frontend $frontend"
  fi
  read -r status sessions < <(frontend_status)
  [[ "$status" == STOP || "$status" == PAUSED ]] ||
    die "HAProxy frontend did not enter a held state: $status"
}

resume_frontend() {
  local status sessions
  read -r status sessions < <(frontend_status)
  if [[ "$status" == STOP || "$status" == PAUSED ]]; then
    cli_mutation "enable frontend $frontend"
  fi
  read -r status sessions < <(frontend_status)
  [[ "$status" == OPEN ]] ||
    die "HAProxy frontend did not enter OPEN: $status"
}

wait_for_drain() {
  local deadline status sessions
  deadline=$((SECONDS + 10#$drain_timeout))
  while :; do
    read -r status sessions < <(frontend_status)
    [[ "$status" == STOP || "$status" == PAUSED ]] ||
      die "frontend resumed while waiting for drain: $status"
    (( sessions == 0 )) && return 0
    (( SECONDS < deadline )) ||
      die "frontend did not drain within ${drain_timeout}s: $sessions session(s)"
    sleep 0.05
  done
}

set_runtime_route() {
  local target=$1
  valid_slot "$target" || die "cannot route to invalid slot: $target"
  cli_mutation "set map $route_map active $target"
  [[ $(runtime_route) == "$target" ]] ||
    die "HAProxy route map did not select $target"
}

write_transaction() {
  local phase=$1 old=$2 target=$3
  valid_slot "$old" || die "transaction old slot is invalid: $old"
  valid_slot "$target" || die "transaction target slot is invalid: $target"
  write_one_line "$transaction_file" "$phase $old $target"
}

read_transaction() {
  local phase old target extra
  [[ -f "$transaction_file" && ! -L "$transaction_file" ]] ||
    die "cutover transaction is missing or unsafe: $transaction_file"
  read -r phase old target extra <"$transaction_file" ||
    die "cannot read cutover transaction: $transaction_file"
  case "$phase" in
    holding|gate-started|promoted|routed|committed) ;;
    *) die "cutover transaction phase is invalid: $phase" ;;
  esac
  valid_slot "$old" || die "cutover transaction old slot is invalid: $old"
  valid_slot "$target" || die "cutover transaction target slot is invalid: $target"
  [[ "$old" != "$target" && -z "${extra:-}" ]] ||
    die "cutover transaction is malformed: $transaction_file"
  printf '%s %s %s\n' "$phase" "$old" "$target"
}

remove_transaction() {
  rm -f -- "$transaction_file"
  sync_path "$transaction_parent"
}

need_executable() {
  local path=$1 label=$2
  [[ "$path" == /* && -x "$path" && ! -L "$path" ]] ||
    die "$label must be an absolute, non-symlink executable: $path"
}

rollback_to() {
  local old=$1 target=$2 gate_started=$3
  local rollback_ok=1

  # A rollback never exposes a route until authority reconciliation succeeds.
  hold_frontend
  if [[ "$gate_started" -eq 1 ]]; then
    if ! "$rollback_command" "$target" "$old" "$transaction_file"; then
      rollback_ok=0
    fi
  fi
  if [[ "$rollback_ok" -eq 1 ]]; then
    set_runtime_route "$old"
    persist_route "$old"
    resume_frontend
    remove_transaction
    return 0
  fi
  printf '%s: rollback failed; frontend remains held and transaction remains at %s\n' \
    "$program" "$transaction_file" >&2
  return 1
}

switch_route() {
  local target=$1 old status sessions gate_started=0 succeeded=0

  valid_slot "$target" || die "invalid target slot: $target"
  need_executable "$promote_command" "promotion command"
  need_executable "$rollback_command" "rollback command"

  exec 9>"$selector_lock"
  flock -x 9
  [[ ! -e "$transaction_file" && ! -L "$transaction_file" ]] ||
    die "unfinished cutover transaction exists; run '$program recover'"

  old=$(read_route)
  if [[ "$old" == "$target" ]]; then
    [[ $(runtime_route) == "$target" ]] ||
      die "durable and runtime routes disagree for $target"
    resume_frontend
    return 0
  fi
  [[ $(other_slot "$old") == "$target" ]] ||
    die "target is not the inactive slot: $target"
  [[ $(runtime_route) == "$old" ]] ||
    die "durable and runtime routes disagree before cutover"
  read -r status sessions < <(frontend_status)
  [[ "$status" == OPEN ]] ||
    die "frontend is not open before cutover: $status"

  write_transaction holding "$old" "$target"
  hold_frontend
  wait_for_drain
  write_transaction gate-started "$old" "$target"
  gate_started=1

  if "$promote_command" "$old" "$target" "$transaction_file"; then
    write_transaction promoted "$old" "$target"
    if set_runtime_route "$target"; then
      write_transaction routed "$old" "$target"
      persist_route "$target"
      write_transaction committed "$old" "$target"
      if resume_frontend; then
        remove_transaction
        succeeded=1
      fi
    fi
  fi

  if [[ "$succeeded" -eq 1 ]]; then
    printf 'active=%s\n' "$target"
    return 0
  fi

  rollback_to "$old" "$target" "$gate_started" ||
    die "cutover failed and rollback could not restore $old"
  die "cutover to $target failed; restored $old"
}

recover_route() {
  local phase old target gate_started=0

  exec 9>"$selector_lock"
  flock -x 9
  if [[ ! -e "$transaction_file" && ! -L "$transaction_file" ]]; then
    [[ $(runtime_route) == "$(read_route)" ]] ||
      die "durable and runtime routes disagree without a transaction"
    resume_frontend
    return 0
  fi
  need_executable "$rollback_command" "rollback command"
  read -r phase old target < <(read_transaction)
  case "$phase" in
    gate-started|promoted|routed|committed) gate_started=1 ;;
  esac
  rollback_to "$old" "$target" "$gate_started" ||
    die "recovery could not restore $old"
  printf 'active=%s\n' "$old"
}

prestart_route() {
  local phase old target active gate_started=0

  need_executable "$verify_command" "authority verification command"
  exec 9>"$selector_lock"
  flock -x 9

  if [[ -e "$transaction_file" || -L "$transaction_file" ]]; then
    need_executable "$rollback_command" "rollback command"
    read -r phase old target < <(read_transaction)
    case "$phase" in
      gate-started|promoted|routed|committed) gate_started=1 ;;
    esac
    if [[ "$gate_started" -eq 1 ]]; then
      "$rollback_command" "$target" "$old" "$transaction_file" ||
        die "prestart authority rollback could not restore $old"
    fi
    persist_route "$old"
    remove_transaction
    active=$old
  else
    active=$(read_route)
  fi

  # This gate runs before HAProxy receives the inherited public descriptors.
  # The socket unit keeps accepting into its backlog, but the proxy cannot
  # expose either private pair until the durable slot proves both authorities.
  "$verify_command" "$active" ||
    die "prestart authority verification rejected $active"
  printf 'active=%s\n' "$active"
}

show_status() {
  local durable runtime status sessions transaction=none
  durable=$(read_route)
  runtime=$(runtime_route)
  read -r status sessions < <(frontend_status)
  if [[ -e "$transaction_file" || -L "$transaction_file" ]]; then
    transaction=$(read_transaction)
  fi
  printf 'durable=%s\n' "$durable"
  printf 'runtime=%s\n' "$runtime"
  printf 'frontend=%s\n' "$status"
  printf 'sessions=%s\n' "$sessions"
  printf 'transaction=%s\n' "$transaction"
  [[ "$durable" == "$runtime" && "$transaction" == none ]]
}

case "${1:-}" in
  switch)
    [[ $# -eq 2 ]] || die "usage: $program switch <blue|green>"
    switch_route "$2"
    ;;
  recover)
    [[ $# -eq 1 ]] || die "usage: $program recover"
    recover_route
    ;;
  prestart)
    [[ $# -eq 1 ]] || die "usage: $program prestart"
    prestart_route
    ;;
  status)
    [[ $# -eq 1 ]] || die "usage: $program status"
    show_status
    ;;
  *)
    die "usage: $program <switch <blue|green>|recover|prestart|status>"
    ;;
esac
