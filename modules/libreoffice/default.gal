use firn/tags

libreoffice is a Module
libreoffice is tagged office

nix module
  arguments: config, lib, pkgs, ...
  config when config.myConfig.modules.libreoffice.enable
    "environment"
      "systemPackages": [pkgs.libreoffice-fresh]
  option "myConfig"."modules"."libreoffice"."enable": enable "Enable LibreOffice office suite"
