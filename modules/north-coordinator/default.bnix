#lang beagle/nix

(ns default)

;; North owns the sole coordination writer. Its source stays live and
;; out-of-store; the selected Store package supplies only the sealed JVM and
;; classpath needed to host Beagle Store in that North process.
(nix/module [config lib pkgs ...]
  (let [username config.myConfig.modules.users.username
        homeDir config.myConfig.modules.users.homeDir
        selectionEnv (s homeDir "/.local/state/north/beagle-store.env")
        coordinator (s homeDir "/code/north/main/bin/north-coordinator")
        launch
          (pkgs.writeShellApplication
            {:name "north-coordinator-launch"
             :runtimeInputs (nix/with pkgs [coreutils gnused])
             :text (builtins.readFile (p "./north-coordinator-launch"))})]
    {:options.myConfig.modules.north-coordinator.enable
      (lib.mkEnableOption
        "North's embedded Beagle Store coordinator on :7977")
     :config
      (lib.mkIf config.myConfig.modules.north-coordinator.enable
        {:home-manager.users
          {username
            (nix/module [config ...]
              {:systemd.user.services.north-coordinator
                {:Unit
                  {:Description "North coordinator with embedded Beagle Store on :7977"
                   :ConditionPathExists [selectionEnv coordinator]
                   ;; Conflicts schedules the retired standalone writer down;
                   ;; After makes that stop complete before this writer starts.
                   :Conflicts ["north-store.service"]
                   :After ["network.target" "north-store.service"]}
                 :Service
                  {:Type "simple"
                   :Environment
                    [(s "NORTH_COORDINATOR_SELECTION=" selectionEnv)
                     (s "NORTH_COORDINATOR_EXECUTABLE=" coordinator)]
                   :ExecStart (s launch "/bin/north-coordinator-launch")
                   :Restart "on-failure"
                   :RestartSec "2s"
                   :TimeoutStartSec "120"
                   :RuntimeMaxSec "86400"
                   :CPUQuota "100%"
                   :MemoryHigh "2G"
                   :MemoryMax "3G"
                   :TasksMax "128"}
                 :Install {:WantedBy ["default.target"]}}})}})}))
