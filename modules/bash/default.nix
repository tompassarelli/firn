{
  config,
  lib,
  pkgs,
  ...
}:
let
  cfg = config.myConfig.modules.bash;
in
{
  config = lib.mkIf cfg.enable {
    environment = {
      etc.bash_logout.text = lib.mkForce ''
        # /etc/bash_logout: generated by Firn.

        # A login command may enable nounset before Bash sources this file.
        if [ -n "''${__ETC_BASHLOGOUT_SOURCED:-}" ] || [ -n "''${NOSYSBASHLOGOUT:-}" ]; then
          return 0
        fi
        __ETC_BASHLOGOUT_SOURCED=1

        ${config.programs.bash.logout}

        if test -f /etc/bash_logout.local; then
          . /etc/bash_logout.local
        fi

      '';
      systemPackages = [ pkgs.fzf ];
    };
    home-manager.users.${config.myConfig.modules.users.username} = hm: {
      home = {
        activation.linkLocalBin = hm.config.lib.dag.entryAfter [ "linkGeneration" ] ''
          run ${builtins.toString (pkgs.writeShellScript "local-bin-links" (builtins.readFile ./local-bin-links.sh))}
        '';
        file = {
          ".local/libexec/convo/python3".source = "${builtins.toString pkgs.python3}/bin/python3";
          ".local/share/firn/bin".source =
            hm.config.lib.file.mkOutOfStoreSymlink "${hm.config.home.homeDirectory}/code/nixos-config/main/dotfiles/bin";
          ".local/share/north/bin".source =
            hm.config.lib.file.mkOutOfStoreSymlink "${hm.config.home.homeDirectory}/code/north/main/bin";
          ".local/share/south/bin".source =
            hm.config.lib.file.mkOutOfStoreSymlink "${hm.config.home.homeDirectory}/code/south/main/bin";
        };
        packages = lib.mkMerge [ [ pkgs.libglvnd ] ];
        sessionPath = [
          "${hm.config.home.homeDirectory}/.local/share/firn/bin"
          "${hm.config.home.homeDirectory}/.local/share/north/bin"
          "${hm.config.home.homeDirectory}/.local/share/south/bin"
        ];
      };
      programs.bash = {
        bashrcExtra = ''

          # Ensure ~/.local/bin (per-tool links and uv tools) is on PATH.
          case ":$PATH:" in
            *":$HOME/.local/bin:"*) ;;
            *) export PATH="$HOME/.local/bin:$PATH" ;;
          esac

          # Firn, North and South tools follow ~/.local/bin, in that order.
          for d in "$HOME/.local/share/firn/bin" "$HOME/.local/share/north/bin" "$HOME/.local/share/south/bin"; do
            case ":$PATH:" in
              *":$d:"*) ;;
              *) export PATH="$PATH:$d" ;;
            esac
          done

          # Readline-dependent setup. Skip cleanly on bash builds without
          # readline (pkgs.bash in nix dev shells) — `set -o vi`, `bind`,
          # `complete`, and the fzf bindings all need readline. The cd-to-home
          # block below is intentionally outside this gate.
          if [[ $- == *i* ]] && type bind >/dev/null 2>&1; then
            # vi-mode (use 'set -o emacs' to switch back temporarily)
            set -o vi

            # Ctrl+L → clear screen, in every keymap. vi-mode doesn't
            # bind this by default (it's an emacs-mode default), so
            # set it explicitly in both vi-insert and vi-command.
            bind -m emacs       '"\C-l": clear-screen'
            bind -m vi-insert   '"\C-l": clear-screen'
            bind -m vi-command  '"\C-l": clear-screen'

            # fzf integration (Ctrl-R for fuzzy history, Alt-C for cd)
            if command -v fzf-share >/dev/null 2>&1; then
              source "$(fzf-share)/key-bindings.bash"
              source "$(fzf-share)/completion.bash"
            fi
          fi

          # Change to home dir on interactive start (skip in Emacs vterm).
          # No readline dep, runs even in stripped bash.
          if [ -z "$INSIDE_EMACS" ] && [ -t 0 ]; then
            case "$PWD" in
              "$HOME"*) ;;
              *) cd "$HOME" ;;
            esac
          fi

        '';
        enable = true;
        historyControl = [
          "ignoredups"
          "erasedups"
        ];
        historyFileSize = 100000;
        historySize = 100000;
        shellAliases = {
          dsp = "--dangerously-skip-permissions";
          du = "dust";
          e = "emacsclient -n -c -a emacs";
          etui = "emacsclient -t -a emacs";
          gita = "git add -v . && git status";
          gitd = "git diff";
          gitdc = "git diff --cached";
          gitp = "git push";
          gits = "git status";
          ls = "eza";
          ps = "procs";
          v = "nvim";
        };
        shellOptions = [
          "histappend"
          "checkwinsize"
          "cmdhist"
          "globstar"
          "autocd"
          "cdspell"
          "dirspell"
        ];
      };
      systemd.user.startServices = "sd-switch";
    };
    programs.bash.completion.enable = true;
  };
  options.myConfig.modules.bash.enable = lib.mkEnableOption "Bash shell configuration";
}
