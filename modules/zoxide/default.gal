use firn/tags

tags: terminal

arguments: config, lib, ...
config
  "home-manager"
    "users"
      {config.myConfig.modules.users.username}
        "programs"
          "bash"
            "shellAliases"
              "cd": "z"
          "zoxide"
            "enable": true
            "enableBashIntegration": true
"enable": "zoxide smart directory jumper"
