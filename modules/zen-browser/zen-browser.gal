nix module
  arguments: config, lib, pkgs, inputs, ...
  config when config.myConfig.modules.zen-browser.enable
    environment.systemPackages: [(inputs.zen-browser.packages."{pkgs.stdenv.hostPlatform.system}").default]
    xdg.mime.defaultApplications when config.myConfig.modules.zen-browser.default
      "text/html": "zen.desktop"
      "x-scheme-handler/http": "zen.desktop"
      "x-scheme-handler/https": "zen.desktop"
      "x-scheme-handler/about": "zen.desktop"
      "x-scheme-handler/unknown": "zen.desktop"
