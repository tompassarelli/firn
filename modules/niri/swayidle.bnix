#lang beagle/nix

(ns swayidle)

(nix/module [config lib pkgs ...]
  (let [username config.myConfig.modules.users.username
        busy (s config.myConfig.modules.users.homeDir "/.local/bin/agents-busy")]
    {:config
      (lib.mkIf config.myConfig.modules.niri.enable
        {:home-manager.users
          {username
            (nix/module [config ...]
              {:systemd.user.services.swayidle
                {:Unit
                  {:Description "Idle manager for Wayland"
                   :PartOf      ["graphical-session.target"]
                   :After       ["graphical-session.target"]
                   :Requisite   ["graphical-session.target"]}
                 :Service
                  {:ExecStart
                    ;; Idle never locks or blanks the screen while an agent
                    ;; workflow is running; suspend still locks.
                    (s pkgs.swayidle
                      "/bin/swayidle -w timeout 601 '" busy " || niri msg action power-off-monitors' timeout 600 '" busy " || swaylock -f' before-sleep 'swaylock -f'")
                   :Restart   "on-failure"}
                 :Install {:WantedBy ["niri.service"]}}})}})}))
