use firn/tags

clipboard-tools is a Module
clipboard-tools is tagged desktop

nix module
  arguments: config, lib, pkgs, ...
  config when config.myConfig.modules.clipboard-tools.enable
    "environment"
      "systemPackages": [pkgs.wl-clip-persist, pkgs.xlsclients]
    "home-manager"
      "users"
        {config.myConfig.modules.users.username}: (__clause_argument_10) => {"systemd": {"user": {"services": {"wl-clip-persist": {"Install": {"WantedBy": ["niri.service"]}, "Service": {"ExecStart": ("" ++ builtins.toString(pkgs.wl-clip-persist)) ++ "/bin/wl-clip-persist --clipboard regular", "Restart": "on-failure"}, "Unit": {"After": ["graphical-session.target"], "Description": "Keep the Wayland clipboard after the source client exits", "PartOf": ["graphical-session.target"], "Requisite": ["graphical-session.target"]}}}}}}
  option "myConfig"."modules"."clipboard-tools"."enable": enable "Clipboard persistence daemon and X selection diagnostics"
