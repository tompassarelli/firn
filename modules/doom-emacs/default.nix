{
  config,
  lib,
  pkgs,
  ...
}:
let
  cfg = config.myConfig.modules.doom-emacs;
in
{
  config = lib.mkIf cfg.enable {
    home-manager.users.${config.myConfig.modules.users.username} = hm: {
      home = {
        activation.cloneDoomEmacs = hm.config.lib.dag.entryAfter [ "writeBoundary" ] ''
          DOOM_DIR="${hm.config.home.homeDirectory}/.config/emacs"

          # A symlink is externally managed, even when its target is absent.
          if [ -L "$DOOM_DIR" ]; then
            if [ ! -d "$DOOM_DIR" ]; then
              echo "warning: $DOOM_DIR is a broken or non-directory symlink; leaving it untouched" >&2
            fi
          elif [ ! -e "$DOOM_DIR" ]; then
            $DRY_RUN_CMD ${builtins.toString pkgs.git}/bin/git clone --depth 1 https://github.com/doomemacs/doomemacs "$DOOM_DIR"
            echo "Doom Emacs cloned to ~/.config/emacs"
            echo "Run: ~/.config/emacs/bin/doom install"
          elif [ ! -d "$DOOM_DIR" ]; then
            echo "error: $DOOM_DIR exists but is not a directory" >&2
            exit 1
          fi

        '';
        file.".config/doom".source =
          hm.config.lib.file.mkOutOfStoreSymlink "${hm.config.home.homeDirectory}/code/nixos-config/dotfiles/doom";
        sessionPath = [ "${hm.config.home.homeDirectory}/.config/emacs/bin" ];
        sessionVariables = {
          DOOMDIR = "${hm.config.home.homeDirectory}/.config/doom";
          NIXOS_MONO_FONT = hm.config.stylix.fonts.monospace.name;
          NIXOS_SANS_FONT = hm.config.stylix.fonts.sansSerif.name;
          NIXOS_SERIF_FONT = hm.config.stylix.fonts.serif.name;
        };
      };
      services.emacs = {
        enable = true;
        package = pkgs.emacs-pgtk;
        startWithUserSession = "graphical";
      };
      xdg.configFile."doom-stylix/stylix-theme-theme.el".text = ''
        ;;; stylix-theme-theme.el --- Generated by NixOS stylix -*- lexical-binding: t; no-byte-compile: t; -*-
        (require 'base16-theme)
        (defvar base16-stylix-theme-colors
          '(:base00 "#${hm.config.lib.stylix.colors.base00}"
            :base01 "#${hm.config.lib.stylix.colors.base01}"
            :base02 "#${hm.config.lib.stylix.colors.base02}"
            :base03 "#${hm.config.lib.stylix.colors.base03}"
            :base04 "#${hm.config.lib.stylix.colors.base04}"
            :base05 "#${hm.config.lib.stylix.colors.base05}"
            :base06 "#${hm.config.lib.stylix.colors.base06}"
            :base07 "#${hm.config.lib.stylix.colors.base07}"
            :base08 "#${hm.config.lib.stylix.colors.base08}"
            :base09 "#${hm.config.lib.stylix.colors.base09}"
            :base0A "#${hm.config.lib.stylix.colors.base0A}"
            :base0B "#${hm.config.lib.stylix.colors.base0B}"
            :base0C "#${hm.config.lib.stylix.colors.base0C}"
            :base0D "#${hm.config.lib.stylix.colors.base0D}"
            :base0E "#${hm.config.lib.stylix.colors.base0E}"
            :base0F "#${hm.config.lib.stylix.colors.base0F}"))
        (deftheme stylix-theme)
        (base16-theme-define 'stylix-theme base16-stylix-theme-colors)
        (provide-theme 'stylix-theme)

      '';
    };
  };
  options.myConfig.modules.doom-emacs.enable =
    lib.mkEnableOption "Doom Emacs configuration (dotfiles, daemon, secrets)";
}
