#lang beagle/nix

(ns default)

;; Fram's ordinary core commands launch the live checkout — the system closure
;; must not compile Fram to put its CLIs on PATH. The explicit *-dev names keep
;; announcing their provenance before handing control to the checkout.
(nix/module
  [config
   lib
   pkgs
   inputs
   ...]
  (let
    [homeDir config.myConfig.modules.users.homeDir
     framPkg (s homeDir "/code/fram/main")
     liveInputs
      (++
        (nix/with pkgs [babashka clojure jdk coreutils bash gnused gnugrep git])
        (lib.optionals pkgs.stdenv.hostPlatform.isLinux
          (nix/with pkgs [iproute2])))
     framCodeStatus
      (pkgs.writeShellApplication
        {:name "fram-code-status"
         :runtimeInputs
          (++
            (nix/with pkgs
              [bash coreutils findutils gawk git gnugrep procps])
            (lib.optionals pkgs.stdenv.hostPlatform.isLinux
              (nix/with pkgs [iproute2])))
         :text
          (builtins.readFile (s inputs.fram "/bin/fram-code-status"))})
     devCommandNames
      ["fram" "fram-server" "fram-mcp" "fram-primer" "fram-up"
       "fram-code-author"]
     packagedCommandNames
      ["fram" "fram-server" "fram-mcp" "fram-primer"]
     mkDev
      (fn [name]
        (pkgs.writeShellApplication
            {:name (s name "-dev")
             :runtimeInputs liveInputs
             :text
              (ms "checkout=${FRAM_CHECKOUT:-$HOME/code/fram/main}"
                  (s "target=$checkout/bin/" name)
                  "if [ ! -x \"$target\" ]; then"
                  (s "  echo \"" name "-dev: checkout executable missing: $target\" >&2")
                  "  exit 127"
                  "fi"
                  (s "echo \"" name "-dev: provenance=checkout path=$target\" >&2")
                  "exec \"$target\" \"$@\"")}))
     mkPackaged
      (fn [name]
        (pkgs.writeShellApplication
          {:name (s name "-packaged")
           :text (ms (s "exec " framPkg "/bin/" name " \"$@\""))}))
     mkLive
      (fn [name]
        (pkgs.writeShellApplication
          {:name name
           :runtimeInputs liveInputs
           :text (ms (s "exec " framPkg "/bin/" name " \"$@\""))}))
     devCommands (builtins.map mkDev devCommandNames)
     packagedCommands (builtins.map mkPackaged packagedCommandNames)
     liveCommands (builtins.map mkLive packagedCommandNames)]
    {:tags [development]
     :flake-inputs
      {:fram {:url "git+file:///home/tom/code/fram/main?ref=control-plane-stability-2026-07-31.1"}}
     :options.myConfig.modules.fram.enable
      (lib.mkEnableOption
        "immutable Fram core commands with explicit checkout-only development commands")
     :config
      (lib.mkIf config.myConfig.modules.fram.enable
        {:environment.systemPackages
          (++ [framCodeStatus] liveCommands devCommands packagedCommands)})}))
