#lang beagle/nix

(ns default)

;; Personal development mode is checkout-first for Fram's supported command
;; surface. Shell/Clojure/script edits are immediate; .bclj edits require
;; ~/code/fram/build.sh to refresh out/ before the runtime changes. The pinned
;; package remains at low priority for internal helper compatibility, while
;; explicit *-packaged commands expose the six supported programs for smoke
;; tests. A missing checkout is an error, never an implicit stale fallback.
(nix/module [config lib pkgs inputs ...]
  (let
    [framPkg
      (get (get inputs.fram.packages pkgs.stdenv.hostPlatform.system) :default)
     liveInputs
      (++
        (nix/with pkgs [babashka clojure jdk coreutils bash gnused gnugrep git])
        (lib.optionals pkgs.stdenv.hostPlatform.isLinux
          (nix/with pkgs [iproute2])))
     commands
      ["fram" "fram-daemon" "fram-mcp" "fram-primer" "fram-up"
       "fram-code-author"]
     mkLive
      (fn [name]
        (lib.hiPrio
          (pkgs.writeShellApplication
            {:name name
             :runtimeInputs liveInputs
             :text
              (ms "checkout=${FRAM_CHECKOUT:-$HOME/code/fram}"
                  (s "target=$checkout/bin/" name)
                  "if [ ! -x \"$target\" ]; then"
                  (s "  echo \"" name
                     ": live checkout executable missing: $target\" >&2")
                  (s "  echo \"" name
                     ": restore that checkout or use " name
                     "-packaged for the pinned closure\" >&2")
                  "  exit 127"
                  "fi"
                  "exec \"$target\" \"$@\"")})))
     mkPackaged
      (fn [name]
        (pkgs.writeShellApplication
          {:name (s name "-packaged")
           :text (ms (s "exec " framPkg "/bin/" name " \"$@\""))}))
     liveCommands (builtins.map mkLive commands)
     packagedCommands (builtins.map mkPackaged commands)]
    {:tags [development]
     :flake-inputs
      {:fram {:url "git+file:///home/tom/code/fram?ref=main"}}
     :options.myConfig.modules.fram.enable
      (lib.mkEnableOption
        "checkout-first Fram CLI suite with pinned helper compatibility")
     :config
      (lib.mkIf config.myConfig.modules.fram.enable
        {:environment.systemPackages
          (++ liveCommands packagedCommands [(lib.lowPrio framPkg)])})}))
