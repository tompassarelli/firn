#lang beagle/nix

(ns enabled-tags)

{:platform linux
 :enabled
  [terminal
   cli-tools
   [desktop -mako +river]
   theming
   auth
   development
   javascript
   python
   [database -postgresql]
   rust
   lisp
   racket
   doom-emacs
   [browsers +chrome +qutebrowser +zen-browser]
   gaming
   [creative -blender -gimp -godot]
   [media -youtube-music]
   communication
   [office -libreoffice]
   notes
   writing
   [vpn -protonvpn-cli]]
 :disabled [glide wine wowup zoom]
}
