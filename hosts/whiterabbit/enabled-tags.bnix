#lang beagle/nix

(ns enabled-tags)

{:platform linux
 :enabled
  [terminal
   cli-tools
   [desktop -mako +river]
   theming
   auth
   [development -beagle +claude +machine-update +agent-runtime-update +update-notify +proton-log-watchdog +skill-review-queue +vast-reaper +socat +procps +alsa-lib]
   javascript
   python
   [database -postgresql]
   rust
   lisp
   racket
   doom-emacs
   [browsers +chrome +qutebrowser +zen-browser]
   gaming
   [creative -godot]
   [media -youtube-music]
   communication
   [office -libreoffice]
   notes
   writing
   [vpn -protonvpn-cli]]
 :disabled [antigravity-cli anytype blender bun cargo clang clippy clojure dbeaver drracket gcc glide mail nodejs obs-studio obsidian promptfoo racket rust-analyzer rustc rustfmt slack spotify wine wowup zoom]
}
