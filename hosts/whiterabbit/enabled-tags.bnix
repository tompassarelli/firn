#lang beagle/nix

(ns enabled-tags)

{:platform linux
 :enabled
  [terminal
   ;; north/beagle tools are live-linked from dotfiles/bin, never
   ;; store-placed: a dev-loop tool in the closure is stale by construction.
   ;; north has no module left to exclude — the module is gone.
   cli-tools
   [desktop -mako +river]
   theming
   auth
   [development -beagle]
   javascript
   python
   [database -postgresql]
   rust
   lisp
   racket
   doom-emacs
   [browsers +chrome +qutebrowser +zen-browser]
   gaming
   [creative -godot]
   [media -youtube-music]
   communication
   [office -libreoffice]
   notes
   writing
   [vpn -protonvpn-cli]]
 :disabled
  [anytype
   bun
   cargo
   clang
   clippy
   clojure
   drracket
   gcc
   glide
   lutris
   mail
   nodejs
   obs-studio
   promptfoo
   python
   racket
   rust-analyzer
   rustc
   rustfmt
   slack
   spotify
   wine
   wowup
   zoom]
}
