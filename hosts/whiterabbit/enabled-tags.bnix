#lang beagle/nix

(ns enabled-tags)

{:platform linux
 :enabled
  [terminal
   ;; north/fram/beagle tools are live-linked from dotfiles/bin, never
   ;; store-placed: a dev-loop tool in the closure is stale by construction.
   [cli-tools -north]
   [desktop -mako +river]
   theming
   auth
   [development -fram -beagle]
   javascript
   python
   [database -postgresql]
   rust
   lisp
   racket
   doom-emacs
   [browsers +chrome +qutebrowser +zen-browser]
   gaming
   [creative -blender -godot]
   [media -youtube-music]
   communication
   [office -libreoffice]
   notes
   writing
   [vpn -protonvpn-cli]]
 :disabled [anytype clang glide lutris mail obs-studio promptfoo slack spotify wine wowup zoom]
}
