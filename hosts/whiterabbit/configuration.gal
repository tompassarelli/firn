use firn/tags

whiterabbit turns on users
whiterabbit turns on nix-settings
whiterabbit turns on boot
whiterabbit turns on networking
whiterabbit turns on remmina
whiterabbit turns on timezone
whiterabbit turns off ssh
whiterabbit turns on swap
whiterabbit turns on tmp-retention
whiterabbit turns on auto-upgrade
whiterabbit turns on framework
whiterabbit turns on framework13-mic
whiterabbit turns on fwupd
whiterabbit turns on thermal-management
whiterabbit turns on pipewire
whiterabbit turns off bluetooth
whiterabbit turns on input
whiterabbit turns off piper
whiterabbit turns on g203-led
whiterabbit turns on kanata
whiterabbit turns off glide
whiterabbit turns off guix
whiterabbit turns on neovim
whiterabbit turns on vscode
whiterabbit turns on mini-serve
whiterabbit turns on bitwarden-desktop
whiterabbit turns on libsecret
whiterabbit turns on parted
whiterabbit turns on nix-ld
whiterabbit turns on musl
whiterabbit turns on appimage
whiterabbit turns on codex
whiterabbit turns on codex-runtime
whiterabbit turns on claude
whiterabbit turns off windows-vm
whiterabbit turns on nh
# agent.slice + the session.slice mirror weight. Inert until a launcher
# actually enters the scope; the slice itself costs nothing.
whiterabbit turns on agent-slice
whiterabbit turns on delivery-liveness
whiterabbit turns on lane-gc
whiterabbit turns on worker-ledger
whiterabbit turns on capacity-watchdog
whiterabbit turns on airplane
whiterabbit turns on nexus-pull

nix file
  arguments: config, lib, pkgs, ...
  value
    myConfig.modules.system.stateVersion: "25.05"
    for ?m where whiterabbit turns on ?m
      myConfig.modules.{?m}.enable: true
    for ?m where whiterabbit turns off ?m
      myConfig.modules.{?m}.enable: false
    myConfig.modules.users.username: "tom"
    myConfig.modules.users.fullName: "tompassarelli"
    myConfig.modules.chrome.default: true
    myConfig.modules.kanata
      configFile: ../../dotfiles/kanata/kanata.kbd
      port: 7070
      extraArgs: ["--log-layer-changes"]
    myConfig.modules.capacity-watchdog.rest
      system: ["auto-cpufreq.service", "dbus-broker.service", "getty@*.service", "kanata-*.service", "mini-serve.service", "NetworkManager.service", "NetworkManager-dispatcher.service", "wpa_supplicant.service", "nix-daemon.service", "nscd.service", "polkit.service", "rfkill-guard.service", "systemd-journald.service", "systemd-logind.service", "systemd-oomd.service", "systemd-resolved.service", "systemd-timesyncd.service", "systemd-udevd.service", "user@*.service", "wireguard-watchdog.service", "init.scope", "session-*.scope", "logrotate.timer", "systemd-tmpfiles-clean.timer", "nixos-upgrade.timer", "nix-gc.timer", "fstrim.timer"]
      user: ["niri.service", "quickshell.service", "swaybg.service", "swayidle.service", "wl-clip-persist.service", "wl-gammarelay.service", "emacs.service", "pipewire.service", "pipewire-pulse.service", "wireplumber.service", "xdg-desktop-portal*.service", "xdg-document-portal.service", "xdg-permission-store.service", "gvfs-daemon.service", "gcr-ssh-agent.service", "dbus-broker.service", "app-nm*applet@autostart.service", "activity-daemon.service", "socrates-chat.service", "capacity-watchdog.service", "wc3-controller.service", "dconf.service", "app-niri-*.scope", "init.scope", "laptop-runner.timer", "worker-ledger.timer", "agents-flow-stall.timer", "watch-alerts.timer", "vast-reaper.timer", "lane-gc.timer", "lane-gc-remote.timer", "nexus-pull.timer", "nexus-restore-test.timer", "machine-update.timer", "git-maintenance-nightly.timer", "agent-runtime-update.timer", "firn-delivery-liveness.timer", "model-watch.timer", "skill-prune.timer", "supply-chain-scan.timer", "cross-project-scan.timer", "proton-log-watchdog.timer", "proton-spam-autopurge.timer", "systemd-tmpfiles-clean.timer"]
      sockets: ["* 127.0.0.53:53 systemd-resolved.service", "* 127.0.0.54:53 systemd-resolved.service", "* *:5353 systemd-resolved.service", "* *:5355 systemd-resolved.service", "tcp 127.0.0.1:7070 kanata-*.service", "tcp 127.0.0.1:39847 mini-serve.service", "tcp 127.0.0.1:* wc3-controller.service", "udp *:* -"]
      cores: builtins.fromJSON("0.02")
      budgets: ["auto-cpufreq.service 0.08", "niri.service 0.06", "activity-daemon.service 0.05", "socrates-chat.service 0.04", "wireguard-watchdog.service 0.03"]
    # Home Manager activates this user service during a system switch. Bound
    # that activation independently of a periodic worker which may be hung.
    # mkForce: home-manager's nixos module pins its own 5m at equal priority.
    systemd.services.home-manager-tom.serviceConfig.TimeoutStartSec: lib.mkForce("90s")
    # Framework's airplane-mode key (HID Wireless Radio Control, usage 0x100c6)
    # sends KEY_RFKILL; the owner wants F10 to only ever be F10. Airplane mode
    # changes only through the `airplane` command (module airplane).
    services.udev.extraHwdb: "evdev:input:b0018v32ACp0006*\n KEYBOARD_KEY_100c6=f10\n"
    myConfig.modules.stylix.chosenTheme: "everforest-dark-hard"
    imports: [./_generated-enables.nix]
