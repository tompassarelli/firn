#!/usr/bin/env bash
# firn-extract-schema — thin wrapper around `beagle-extract-schema`.
#
# Configures the extractor for this repo:
#   target: nixosConfigurations.$HOST.options  (default HOST: whiterabbit)
#   out:    .beagle-cache/schema.json
#
# Usage:
#   firn-extract-schema [host]                    # NixOS (default)
#   firn-extract-schema --darwin [host]           # nix-darwin (default host: ashashi)

set -euo pipefail

REPO="${FIRN_REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
BEAGLE_PATH="${BEAGLE_PATH:-$(cd "$REPO/.." && pwd)/beagle}"
BEAGLE_EXTRACT="$BEAGLE_PATH/bin/beagle-extract-schema"

DARWIN=false
if [[ "${1:-}" == "--darwin" ]]; then
  DARWIN=true
  shift
fi

if $DARWIN; then
  HOST="${1:-ashashi}"
  TARGET="darwinConfigurations.$HOST.options"
  OUT="$REPO/.beagle-cache/schema-darwin.json"
  FINGERPRINT_OUT="$REPO/.beagle-cache/schema-darwin.inputs.sha256"
  FINGERPRINT_MODE=darwin
else
  HOST="${1:-whiterabbit}"
  TARGET="nixosConfigurations.$HOST.options"
  OUT="$REPO/.beagle-cache/schema.json"
  FINGERPRINT_OUT="$REPO/.beagle-cache/schema.inputs.sha256"
  FINGERPRINT_MODE=nixos
fi

if [[ ! -x "$BEAGLE_EXTRACT" ]]; then
  echo "firn-extract-schema: beagle-extract-schema not found at $BEAGLE_EXTRACT" >&2
  echo "  clone beagle: git clone https://github.com/tompassarelli/beagle \"$BEAGLE_PATH\"" >&2
  echo "  or set BEAGLE_PATH=/path/to/beagle" >&2
  exit 2
fi

FINGERPRINT_HELPER="$REPO/scripts/firn-schema-input-fingerprint"
if [[ ! -x "$FINGERPRINT_HELPER" ]]; then
  echo "firn-extract-schema: fingerprint helper missing at $FINGERPRINT_HELPER" >&2
  exit 2
fi

before_fingerprint="$($FINGERPRINT_HELPER --mode "$FINGERPRINT_MODE" --lock "$REPO/flake.lock")"

"$BEAGLE_EXTRACT" \
  --target "$TARGET" \
  --out "$OUT" \
  --flake "$REPO"

after_fingerprint="$($FINGERPRINT_HELPER --mode "$FINGERPRINT_MODE" --lock "$REPO/flake.lock")"
if [[ "$before_fingerprint" != "$after_fingerprint" ]]; then
  echo "firn-extract-schema: flake.lock changed during extraction; refusing a mismatched fingerprint" >&2
  exit 1
fi

mkdir -p "$(dirname "$FINGERPRINT_OUT")"
fingerprint_tmp="$(mktemp "${FINGERPRINT_OUT}.tmp.XXXXXX")"
trap 'rm -f "$fingerprint_tmp"' EXIT
printf '%s\n' "$after_fingerprint" >"$fingerprint_tmp"
mv "$fingerprint_tmp" "$FINGERPRINT_OUT"
trap - EXIT
