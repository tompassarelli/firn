#!/usr/bin/env bash
# firn-build-bin — prepare a revision-keyed compiled runtime for scripts/firn.rkt.
#
# RACKET PINNING (the load-bearing decision): firn depends on beagle —
# beagle-lib at build time, the beagle CLIs (beagle-validate, ...) at run
# time — so it MUST share beagle's racket: the flake-pinned dev-shell racket
# resolved by beagle's bin/_beagle-racket, NOT the system racket.
#
# Why it matters: when a nixpkgs bump moves *system* racket ahead of beagle's
# pin (e.g. 9.1 -> 9.2), building firn under system racket recompiles beagle-lib
# IN-PLACE into beagle's shared, gitignored compiled/ tree with the new version
# stamp — and every beagle CLI (still on the pinned racket) then dies with
# "version mismatch: expected 9.1 found 9.2". Pinning firn to beagle's racket
# keeps the two on one version, immune to system racket bumps. (Learned the
# hard way during the 9.1->9.2 bump; see git log.)
#
# Immutable cache:
# ~/.local/share/firn/<racket-store-hash>/<source-hash>/runtime.
# Racket and exact source identity are independent cache dimensions. Every
# compiler also gets a private compiled-file root, so ignored `compiled/*.zo`
# beside transitive sources can neither override current source nor race with a
# concurrent build.

set -euo pipefail

cd "${FIRN_REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
# beagle was a SIBLING of this checkout. Under the container layout the checkout
# is <container>/main, so ../beagle no longer resolves. Probe the real
# locations: container checkout, legacy flat checkout, then historical sibling.
if [ -z "${BEAGLE_PATH:-}" ]; then
  for _bp in "$HOME/code/beagle/main" "$HOME/code/beagle" "$(cd .. && pwd)/beagle"; do
    if [ -d "$_bp/bin" ]; then BEAGLE_PATH="$_bp"; break; fi
  done
  unset _bp
fi
BEAGLE_PATH="${BEAGLE_PATH:-$(cd .. && pwd)/beagle}"

BIN_DIR="${BIN_DIR:-$PWD/dotfiles/bin}"
SHARE_DIR="${SHARE_DIR:-$HOME/.local/share/firn}"
mkdir -p "$BIN_DIR" "$SHARE_DIR"

# ---- resolve beagle's pinned racket (decoupled from system racket) ----
RACKET="racket"; RACO="raco"
if [ -f "$BEAGLE_PATH/bin/_beagle-racket" ]; then
  # shellcheck disable=SC1091
  source "$BEAGLE_PATH/bin/_beagle-racket"   # sets RACKET / RACO to beagle's dev-shell racket
fi
if ! command -v "$RACKET" >/dev/null 2>&1; then
  echo "firn-build-bin: racket not found ($RACKET)" >&2
  exit 1
fi

# ---- per-racket cache key (resolved beagle racket store path) ----
RACKET_BIN="$(readlink -f "$(command -v "$RACKET")")"
RACKET_HASH="$(printf '%s' "$RACKET_BIN" | sha1sum | cut -c1-12)"
RACKET_VERSION="$("$RACKET" --version 2>/dev/null | grep -oP 'v\K[0-9.]+' || echo unknown)"
RACKET_PREFIX="$(dirname "$(dirname "$RACKET_BIN")")"
RACKET_COMPILED_ROOT="$RACKET_PREFIX/lib/racket/compiled"

SOURCE_HASH="$("$PWD/scripts/firn-source-hash")"
CACHE_DIR="$SHARE_DIR/$RACKET_HASH/$SOURCE_HASH"
RUNTIME="$CACHE_DIR/runtime"
COMPAT_ZO="$CACHE_DIR/firn.zo"
WRAPPER="$BIN_DIR/firn"
mkdir -p "$CACHE_DIR"
RUNTIME_BUILD=''
COMPAT_TMP=''
WRAPPER_TMP=''
cleanup_publish_temps() {
  [ -z "$RUNTIME_BUILD" ] || rm -rf "${RUNTIME_BUILD:?}"
  [ -z "$COMPAT_TMP" ] || rm -f "${COMPAT_TMP:?}"
  [ -z "$WRAPPER_TMP" ] || rm -f "${WRAPPER_TMP:?}"
}
trap cleanup_publish_temps EXIT

trace_now_ms() {
  [ -r /proc/uptime ] || return 1
  awk '{ printf "%.3f", $1 * 1000 }' /proc/uptime
}

trace_revision_start() {
  local now
  [ -n "${FIRN_TRACE_PATH:-}" ] || return 0
  now="$(trace_now_ms)" || return 0
  printf '{"schema":"firn.rebuild/v1","event":"span_start","trace_id":"%s","monotonic_ms":%s,"name":"firn revision cache build"}\n' \
    "${FIRN_TRACE_ID:-}" "$now" >>"$FIRN_TRACE_PATH" 2>/dev/null || true
  printf '%s' "$now"
}

trace_revision_end() {
  local start="$1" now duration
  [ -n "$start" ] || return 0
  now="$(trace_now_ms)" || return 0
  duration="$(awk -v start="$start" -v end="$now" \
    'BEGIN { printf "%.3f", end - start }')"
  printf '{"schema":"firn.rebuild/v1","event":"span_end","trace_id":"%s","monotonic_ms":%s,"duration_ms":%s,"name":"firn revision cache build","status":"ok","cache":"miss"}\n' \
    "${FIRN_TRACE_ID:-}" "$now" "$duration" >>"$FIRN_TRACE_PATH" 2>/dev/null || true
}

echo "firn-build-bin: beagle racket $RACKET_VERSION at $RACKET_BIN"
echo "firn-build-bin: cache key $RACKET_HASH/$SOURCE_HASH"

if { [ -e "$RUNTIME" ] || [ -L "$RUNTIME" ]; } &&
   [ ! -f "$RUNTIME/.complete" ]; then
  echo "firn-build-bin: refusing incomplete immutable cache entry: $RUNTIME" >&2
  exit 1
fi
if [ ! -f "$RUNTIME/.complete" ]; then
  revision_start="$(trace_revision_start)"
  # Retry, because on a machine with concurrent agents a single attempt can
  # publish bytecode compiled from a tree that moved. Each attempt re-reads the
  # source hash and re-keys to the current tree.
  FIRN_COMPILE_ATTEMPTS="${FIRN_COMPILE_ATTEMPTS:-4}"
  attempt=1
  while :; do
    CACHE_DIR="$SHARE_DIR/$RACKET_HASH/$SOURCE_HASH"
    RUNTIME="$CACHE_DIR/runtime"
    COMPAT_ZO="$CACHE_DIR/firn.zo"
    mkdir -p "$CACHE_DIR"
    if [ -f "$RUNTIME/.complete" ]; then
      echo "firn-build-bin: $SOURCE_HASH already published; using it" >&2
      break
    fi

    RUNTIME_BUILD="$(mktemp -d "$CACHE_DIR/generation.XXXXXX")"
    mkdir -p "$RUNTIME_BUILD/compiled" "$RUNTIME_BUILD/collects"
    ln -s "$BEAGLE_PATH/beagle-lib" "$RUNTIME_BUILD/collects/beagle"
    COMPILED_ROOTS="$RUNTIME_BUILD/compiled"
    if [ -d "$RACKET_COMPILED_ROOT" ]; then
      COMPILED_ROOTS="$COMPILED_ROOTS:$RACKET_COMPILED_ROOT"
    fi
    echo "firn-build-bin: compiling revision runtime (attempt $attempt/$FIRN_COMPILE_ATTEMPTS)"
    PLTCOLLECTS="$RUNTIME_BUILD/collects:${PLTCOLLECTS:-}" \
      PLTCOMPILEDROOTS="$COMPILED_ROOTS" \
      "$RACO" make scripts/firn.rkt
    SOURCE_HASH_AFTER="$("$PWD/scripts/firn-source-hash")"
    if [ "$SOURCE_HASH" = "$SOURCE_HASH_AFTER" ]; then
      : >"$RUNTIME_BUILD/.complete"
      runtime_target="$(basename "$RUNTIME_BUILD")"
      if ln -s "$runtime_target" "$RUNTIME" 2>/dev/null; then
        RUNTIME_BUILD=''
      elif [ -f "$RUNTIME/.complete" ]; then
        rm -rf "${RUNTIME_BUILD:?}"
        RUNTIME_BUILD=''
      else
        echo "firn-build-bin: runtime publication failed: $RUNTIME" >&2
        exit 1
      fi
      break
    fi

    if [ "$attempt" -ge "$FIRN_COMPILE_ATTEMPTS" ]; then
      {
        echo "firn-build-bin: source changed during compilation $FIRN_COMPILE_ATTEMPTS time(s); refusing to publish stale bytecode"
        echo "  Another process is editing $PWD while this compiles — on this box that is"
        echo "  normally a concurrent agent landing commits."
        echo "  Retry when the tree settles, raise FIRN_COMPILE_ATTEMPTS, or build from a"
        echo "  quiet checkout:  git -C $PWD worktree add /tmp/firn-build <ref>"
      } >&2
      exit 1
    fi

    # A moved source belongs to a different immutable cache entry.
    rm -rf "${RUNTIME_BUILD:?}"
    RUNTIME_BUILD=''
    SOURCE_HASH="$SOURCE_HASH_AFTER"
    echo "firn-build-bin: tree moved mid-compile; re-keying to $SOURCE_HASH" >&2
    attempt=$((attempt + 1))
  done
  trace_revision_end "$revision_start"
else
  echo "firn-build-bin: cached revision runtime → $RUNTIME"
fi

# The previously installed wrapper resumes here after invoking this newer build
# recipe and still expects firn.zo. Its source shim hands that one in-flight
# invocation to the newly published wrapper, which re-attests the source.
if [ ! -s "$COMPAT_ZO" ]; then
  COMPAT_TMP="$(mktemp "$CACHE_DIR/.firn.zo.XXXXXX")"
  cat >"$COMPAT_TMP" <<'RKT'
#lang racket/base
(require racket/path racket/system)
(define repo
  (or (getenv "FIRN_REPO")
      (error 'firn "FIRN_REPO is required for cache adoption")))
(define wrapper (build-path repo "dotfiles" "bin" "firn"))
(define bash
  (or (find-executable-path "bash")
      (error 'firn "bash is required for cache adoption")))
(exit
 (apply system*/exit-code
        bash
        (path->string wrapper)
        (vector->list (current-command-line-arguments))))
RKT
  ln "$COMPAT_TMP" "$COMPAT_ZO" 2>/dev/null || [ -s "$COMPAT_ZO" ]
  rm -f "$COMPAT_TMP"
  COMPAT_TMP=''
fi

# ---- wrapper ----
# The fast path uses the exact pinned Racket and revision runtime without
# direnv or per-call compilation. A moved Racket pin re-resolves once.
WRAPPER_TMP="$(mktemp "$BIN_DIR/.firn.XXXXXX")"
cat > "$WRAPPER_TMP" <<EOF
#!/usr/bin/env bash
# firn — run source-attested compiled Racket bytecode.
# The Racket path is pinned to BEAGLE's runtime, not the system runtime.
set -euo pipefail

SHARE_DIR="\${FIRN_RUNTIME_SHARE_DIR:-\$HOME/.local/share/firn}"
BUILT_RACKET_BIN="$RACKET_BIN"
BUILT_RACKET_HASH="$RACKET_HASH"
BUILT_RACKET_COMPILED_ROOT="$RACKET_COMPILED_ROOT"
if [ -z "\${FIRN_REPO:-}" ]; then
  for _repo in "\$HOME/code/nixos-config/main" "\$HOME/code/nixos-config"; do
    [ -x "\$_repo/scripts/firn-build-bin" ] && { FIRN_REPO="\$_repo"; break; }
  done
  unset _repo
fi
REPO="\${FIRN_REPO:-\$HOME/code/nixos-config}"
export FIRN_REPO="\$REPO"

for _bp in "\$HOME/code/beagle/main" "\$HOME/code/beagle" "\$REPO/../beagle"; do
  [ -d "\$_bp/bin" ] && { BEAGLE_PATH="\${BEAGLE_PATH:-\$_bp}"; break; }
done
BEAGLE_PATH="\${BEAGLE_PATH:-\$REPO/../beagle}"
export BEAGLE_PATH
BUILD_SCRIPT="\$REPO/scripts/firn-build-bin"
SOURCE_HASH_SCRIPT="\$REPO/scripts/firn-source-hash"

trace_now_ms() {
  [ -r /proc/uptime ] || return 1
  awk '{ printf "%.3f", \$1 * 1000 }' /proc/uptime
}

trace_start() {
  local name="\$1" now
  [ -n "\${FIRN_TRACE_PATH:-}" ] || return 0
  now="\$(trace_now_ms)" || return 0
  printf '{"schema":"firn.rebuild/v1","event":"span_start","trace_id":"%s","monotonic_ms":%s,"name":"%s"}\\n' \
    "\${FIRN_TRACE_ID:-}" "\$now" "\$name" >>"\$FIRN_TRACE_PATH" 2>/dev/null || true
  printf '%s' "\$now"
}

trace_end() {
  local name="\$1" start="\$2" cache="\${3:-}" now duration
  [ -n "\$start" ] || return 0
  now="\$(trace_now_ms)" || return 0
  duration="\$(awk -v start="\$start" -v end="\$now" \
    'BEGIN { printf "%.3f", end - start }')"
  printf '{"schema":"firn.rebuild/v1","event":"span_end","trace_id":"%s","monotonic_ms":%s,"duration_ms":%s,"name":"%s","status":"ok","cache":"%s"}\\n' \
    "\${FIRN_TRACE_ID:-}" "\$now" "\$duration" "\$name" "\$cache" \
    >>"\$FIRN_TRACE_PATH" 2>/dev/null || true
}

exec_runtime() {
  local racket_bin="\$1" racket_compiled_root="\$2" runtime="\$3" cache_state="\$4"
  local startup_start
  shift 4
  runtime="\$(readlink -f "\$runtime")"
  if [ ! -f "\$runtime/.complete" ]; then
    echo "firn: revision cache is incomplete at \$runtime" >&2
    exit 1
  fi
  startup_start="\$(trace_start "racket startup")"
  export FIRN_RUNTIME_START_MS="\$startup_start"
  export FIRN_RUNTIME_CACHE_STATE="\$cache_state"
  exec env \
    PLTCOLLECTS="\$runtime/collects:\${PLTCOLLECTS:-}" \
    PLTCOMPILEDROOTS="\$runtime/compiled:\$racket_compiled_root" \
    "\$racket_bin" "\$REPO/scripts/firn.rkt" "\$@"
}

source_start="\$(trace_start "firn source attestation")"
CURRENT_SOURCE_HASH="\$("\$SOURCE_HASH_SCRIPT")"
trace_end "firn source attestation" "\$source_start" ""
RUNTIME="\$SHARE_DIR/\$BUILT_RACKET_HASH/\$CURRENT_SOURCE_HASH/runtime"
runtime_start="\$(trace_start "firn runtime preparation")"
if [ -x "\$BUILT_RACKET_BIN" ] && [ -f "\$RUNTIME/.complete" ]; then
  trace_end "firn runtime preparation" "\$runtime_start" "hit"
  exec_runtime "\$BUILT_RACKET_BIN" "\$BUILT_RACKET_COMPILED_ROOT" \
    "\$RUNTIME" "hit" "\$@"
fi

RACKET="racket"
if [ -f "\$BEAGLE_PATH/bin/_beagle-racket" ]; then
  # shellcheck disable=SC1091
  source "\$BEAGLE_PATH/bin/_beagle-racket"
fi
if ! command -v "\$RACKET" >/dev/null 2>&1; then
  echo "firn: racket not found (\$RACKET)" >&2
  exit 1
fi
CURRENT_RACKET_BIN="\$(readlink -f "\$(command -v "\$RACKET")")"
CURRENT_RACKET_HASH="\$(printf '%s' "\$CURRENT_RACKET_BIN" | sha1sum | cut -c1-12)"
CURRENT_RACKET_PREFIX="\$(dirname "\$(dirname "\$CURRENT_RACKET_BIN")")"
CURRENT_RACKET_COMPILED_ROOT="\$CURRENT_RACKET_PREFIX/lib/racket/compiled"
RUNTIME="\$SHARE_DIR/\$CURRENT_RACKET_HASH/\$CURRENT_SOURCE_HASH/runtime"

cache_state="hit"
if [ ! -f "\$RUNTIME/.complete" ]; then
  cache_state="miss"
  CURRENT_RACKET_VERSION="\$("\$RACKET" --version 2>/dev/null | grep -oP 'v\K[0-9.]+' || echo unknown)"
  echo "firn: source or Beagle racket changed; preparing revision cache under \$CURRENT_RACKET_VERSION..." >&2
  if [ ! -x "\$BUILD_SCRIPT" ]; then
    echo "firn: build script missing at \$BUILD_SCRIPT — cannot self-build." >&2
    exit 1
  fi
  "\$BUILD_SCRIPT" >&2
  CURRENT_SOURCE_HASH="\$("\$SOURCE_HASH_SCRIPT")"
  RUNTIME="\$SHARE_DIR/\$CURRENT_RACKET_HASH/\$CURRENT_SOURCE_HASH/runtime"
  if [ ! -f "\$RUNTIME/.complete" ]; then
    echo "firn: revision cache was not published at \$RUNTIME" >&2
    exit 1
  fi
fi

trace_end "firn runtime preparation" "\$runtime_start" "\$cache_state"
exec_runtime "\$CURRENT_RACKET_BIN" "\$CURRENT_RACKET_COMPILED_ROOT" \
  "\$RUNTIME" "\$cache_state" "\$@"
EOF
chmod +x "$WRAPPER_TMP"
mv -f "$WRAPPER_TMP" "$WRAPPER"
WRAPPER_TMP=''

# one-time cleanup: drop the legacy single-marker file if present
rm -f "${SHARE_DIR:?}/racket-version"

# shellcheck disable=SC2012
ls -ldh "$RUNTIME" "$COMPAT_ZO" "$WRAPPER" | awk '{print "  ", $5, $9}'
echo "firn-build-bin: done. Declarative wrapper published at $WRAPPER."
