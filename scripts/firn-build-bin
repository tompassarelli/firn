#!/usr/bin/env bash
# firn-build-bin — compile scripts/firn.rkt to a small fast binary.
#
# RACKET PINNING (the load-bearing decision): firn depends on beagle —
# beagle-lib at build time, the beagle CLIs (beagle-validate, ...) at run
# time — so it MUST share beagle's racket: the flake-pinned dev-shell racket
# resolved by beagle's bin/_beagle-racket, NOT the system racket.
#
# Why it matters: when a nixpkgs bump moves *system* racket ahead of beagle's
# pin (e.g. 9.1 -> 9.2), building firn under system racket recompiles beagle-lib
# IN-PLACE into beagle's shared, gitignored compiled/ tree with the new version
# stamp — and every beagle CLI (still on the pinned racket) then dies with
# "version mismatch: expected 9.1 found 9.2". Pinning firn to beagle's racket
# keeps the two on one version, immune to system racket bumps. (Learned the
# hard way during the 9.1->9.2 bump; see git log.)
#
# Immutable cache: ~/.local/share/firn/<racket-store-hash>/<source-hash>/firn.zo.
# Racket and exact source identity are independent cache dimensions: two
# worktrees may build concurrently without sharing a mutable bytecode target.
# `raco demod` (whole-program optimizer + DCE) yields a ~2 MB standalone .zo
# (no runtime collection deps) that loads in ~80ms.

set -euo pipefail

cd "${FIRN_REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
BEAGLE_PATH="${BEAGLE_PATH:-$(cd .. && pwd)/beagle}"

BIN_DIR="${BIN_DIR:-$PWD/dotfiles/bin}"
SHARE_DIR="${SHARE_DIR:-$HOME/.local/share/firn}"
mkdir -p "$BIN_DIR" "$SHARE_DIR"

# ---- resolve beagle's pinned racket (decoupled from system racket) ----
RACKET="racket"; RACO="raco"
if [ -f "$BEAGLE_PATH/bin/_beagle-racket" ]; then
  # shellcheck disable=SC1091
  source "$BEAGLE_PATH/bin/_beagle-racket"   # sets RACKET / RACO to beagle's dev-shell racket
fi
if ! command -v "$RACKET" >/dev/null 2>&1; then
  echo "firn-build-bin: racket not found ($RACKET)" >&2
  exit 1
fi

# ---- per-racket cache key (resolved beagle racket store path) ----
RACKET_BIN="$(readlink -f "$(command -v "$RACKET")")"
RACKET_HASH="$(printf '%s' "$RACKET_BIN" | sha1sum | cut -c1-12)"
RACKET_VERSION="$("$RACKET" --version 2>/dev/null | grep -oP 'v\K[0-9.]+' || echo unknown)"

SOURCE_HASH="$("$PWD/scripts/firn-source-hash")"
ZO_DIR="$SHARE_DIR/$RACKET_HASH/$SOURCE_HASH"
ZO="$ZO_DIR/firn.zo"
WRAPPER="$BIN_DIR/firn"
mkdir -p "$ZO_DIR"
ZO_TMP=''
WRAPPER_TMP=''
cleanup_publish_temps() {
  [ -z "$ZO_TMP" ] || rm -f "${ZO_TMP:?}"
  [ -z "$WRAPPER_TMP" ] || rm -f "${WRAPPER_TMP:?}"
}
trap cleanup_publish_temps EXIT

echo "firn-build-bin: beagle racket $RACKET_VERSION at $RACKET_BIN"
echo "firn-build-bin: cache key $RACKET_HASH/$SOURCE_HASH"

# ---- ensure beagle-lib resolves for THIS racket ----
# demod follows `(require beagle-lib/...)` in firn.rkt, so beagle must be on
# this racket's collection path. Link it into beagle-racket's OWN pkg db
# (idempotent; --no-setup so we never recompile beagle's bytecode — that is
# beagle's job, under the same racket, so no version skew is ever introduced).
if [ -d "$BEAGLE_PATH" ] && ! "$RACO" pkg show --all 2>/dev/null | grep -q '^ beagle '; then
  echo "firn-build-bin: linking beagle into racket $RACKET_VERSION pkg db (first run)"
  "$RACO" pkg install --link --batch --no-setup --skip-installed \
    "$BEAGLE_PATH/beagle-lib" "$BEAGLE_PATH/beagle" "$BEAGLE_PATH/beagle-test" \
    2>&1 | tail -3 || true
fi

# Sanity: this racket must ship `raco demod` (racket-minimal doesn't).
if ! "$RACO" help demod >/dev/null 2>&1; then
  echo "" >&2
  echo "firn-build-bin: ERROR — \`raco demod\` not available in this racket ($RACKET)." >&2
  echo "  Missing compiler-lib (likely racket-minimal). firn needs full racket;" >&2
  echo "  ensure beagle's dev shell provides pkgs.racket (not racket-minimal)." >&2
  exit 1
fi

if [ -e "$ZO" ] && [ ! -s "$ZO" ]; then
  echo "firn-build-bin: refusing incomplete immutable cache entry: $ZO" >&2
  exit 1
fi
if [ ! -e "$ZO" ]; then
  ZO_TMP="$(mktemp "$ZO_DIR/.firn.zo.XXXXXX")"
  echo "firn-build-bin: compiling scripts/firn.rkt → $ZO"
  "$RACO" demod -o "$ZO_TMP" scripts/firn.rkt
  SOURCE_HASH_AFTER="$("$PWD/scripts/firn-source-hash")"
  if [ "$SOURCE_HASH" != "$SOURCE_HASH_AFTER" ]; then
    echo "firn-build-bin: source changed during compilation; refusing to publish stale bytecode" >&2
    exit 1
  fi
  # link(2) publishes only one complete immutable image when identical builds
  # race. The loser discards its private completed temp file.
  ln "$ZO_TMP" "$ZO" 2>/dev/null || [ -s "$ZO" ]
  rm -f "$ZO_TMP"
  ZO_TMP=''
else
  echo "firn-build-bin: cached scripts/firn.rkt → $ZO"
fi

# ---- wrapper ----
# Embeds the resolved beagle racket + cache key. Fast path: if that exact
# racket store path still exists and its source-specific .zo is built, exec directly (no
# direnv/per-call resolution). Slow path (beagle racket moved, or first run
# on a new machine): re-resolve via _beagle-racket and rebuild once.
WRAPPER_TMP="$(mktemp "$BIN_DIR/.firn.XXXXXX")"
cat > "$WRAPPER_TMP" <<EOF
#!/usr/bin/env bash
# firn — wrapper for compiled bytecode. Pinned to BEAGLE's racket, not system
# racket (see scripts/firn-build-bin for why). A system racket bump must never
# break or silently rebuild firn.
set -euo pipefail

SHARE_DIR="$SHARE_DIR"
BUILT_RACKET_BIN="$RACKET_BIN"
BUILT_RACKET_HASH="$RACKET_HASH"
REPO="\${FIRN_REPO:-\$HOME/code/nixos-config}"
BEAGLE_PATH="\${BEAGLE_PATH:-\$REPO/../beagle}"
BUILD_SCRIPT="\$REPO/scripts/firn-build-bin"
SOURCE_HASH_SCRIPT="\$REPO/scripts/firn-source-hash"

# Fast path requires both the pinned runtime and the exact Racket source set.
CURRENT_SOURCE_HASH="\$("\$SOURCE_HASH_SCRIPT")"
ZO="\$SHARE_DIR/\$BUILT_RACKET_HASH/\$CURRENT_SOURCE_HASH/firn.zo"
if [ -x "\$BUILT_RACKET_BIN" ] \
   && [ -s "\$ZO" ]; then
  exec "\$BUILT_RACKET_BIN" "\$ZO" "\$@"
fi

# Slow path: beagle's racket moved store paths (a beagle flake bump) or this is
# a fresh machine. Re-resolve beagle's pinned racket and rebuild once.
RACKET="racket"
if [ -f "\$BEAGLE_PATH/bin/_beagle-racket" ]; then
  # shellcheck disable=SC1091
  source "\$BEAGLE_PATH/bin/_beagle-racket"
fi
if ! command -v "\$RACKET" >/dev/null 2>&1; then
  echo "firn: racket not found (\$RACKET)" >&2
  exit 1
fi
CURRENT_RACKET_BIN="\$(readlink -f "\$(command -v "\$RACKET")")"
CURRENT_RACKET_HASH="\$(printf '%s' "\$CURRENT_RACKET_BIN" | sha1sum | cut -c1-12)"
ZO="\$SHARE_DIR/\$CURRENT_RACKET_HASH/\$CURRENT_SOURCE_HASH/firn.zo"

if [ ! -s "\$ZO" ]; then
  CURRENT_RACKET_VERSION="\$("\$RACKET" --version 2>/dev/null | grep -oP 'v\K[0-9.]+' || echo unknown)"
  echo "firn: source or Beagle racket changed; rebuilding cache under \$CURRENT_RACKET_VERSION (~20s)..." >&2
  if [ ! -x "\$BUILD_SCRIPT" ]; then
    echo "firn: build script missing at \$BUILD_SCRIPT — cannot self-build." >&2
    exit 1
  fi
  "\$BUILD_SCRIPT" >&2
fi

exec "\$RACKET" "\$ZO" "\$@"
EOF
chmod +x "$WRAPPER_TMP"
mv -f "$WRAPPER_TMP" "$WRAPPER"
WRAPPER_TMP=''

# one-time cleanup: drop the legacy single-marker file if present
rm -f "${SHARE_DIR:?}/racket-version"

# shellcheck disable=SC2012
ls -lh "$ZO" "$WRAPPER" | awk '{print "  ", $5, $9}'
echo "firn-build-bin: done. Declarative wrapper published at $WRAPPER."
