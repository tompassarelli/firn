#!/usr/bin/env bash
set -euo pipefail

# Local development inputs (beagle/fram/north) are git+file flake inputs pinned
# by flake.lock to committed revisions. `firn rebuild` builds a COMMIT snapshot
# of this repo, so nothing in any working tree can enter a generation; this
# script only decides which committed revs to PROMOTE.
#
#   --plan            Read-only. Prints a human status line per input, and for
#                     each promotable move a machine line:
#                       plan <input> <locked-rev> <target-rev> <repo-path>
#                     rebuild.rkt turns plan lines into --override-input flags,
#                     builds/verifies with them, and only then calls --commit.
#   --commit <in>=<rev>...
#                     After the snapshot build verified these exact targets:
#                     re-point flake.lock (targeted nix flake update) and make
#                     the mechanical "refresh verified local inputs" commit.
#
# NEVER a rebuild blocker. Eligibility comes from the repo's committed local
# refs/heads/main, never from whichever branch a developer has checked out.
# Exact-rev Git URLs exclude every working-tree change by construction, and the
# status line makes that exclusion visible. --commit degrades to a notice +
# exit 0 on any non-promotable or raced state (the system has already switched
# at that point).
# Hard `die` is reserved for structural breakage (missing lock entry, not a
# git checkout, missing tools).

ROOT="${FIRN_REPO:-$(git rev-parse --show-toplevel)}"
LOCK="$ROOT/flake.lock"
# No local input auto-promotes through the flake pin any more. Fram adopts a
# reviewed revision through `north-coord-runtime promote`, and North/Beagle
# enforcement through `north-enforcement-promote`; both are attested transactions
# that do not spend a rebuild.
PLAN_INPUTS=()
# Targeted settlement still supports every local input and must detect if nix
# rewrites any unrequested one.
LOCAL_INPUTS=(beagle fram north)

die() {
  printf 'firn rebuild: %s\n' "$*" >&2
  exit 1
}

notice() {
  printf '  %s\n' "$*"
}

MODE=""
case "${1:-}" in
  --plan) MODE=plan ;;
  --provisional) MODE=plan ;;   # legacy alias: planning no longer mutates the lock
  --commit) MODE=commit ;;
  *) die "usage: firn-sync-local-inputs --plan | --commit <input>=<verified-rev>..." ;;
esac
shift

short_rev() {
  printf '%.8s' "$1"
}

repo_for() {
  local input="$1" upper override default
  upper="$(printf '%s' "$input" | tr '[:lower:]' '[:upper:]')"
  override="FIRN_${upper}_REPO"
  # ~/code/<input> is a CONTAINER holding main/ + wt-<slug>/; the checkout is
  # <container>/main. Before that migration the container WAS the checkout, so
  # both are probed and the container is used when it still holds a .git —
  # otherwise this aborts every rebuild with "is not a Git checkout", which is
  # exactly what happened on 2026-07-29 once the layout moved.
  default="${HOME}/code/${input}"
  [ -e "${default}/main/.git" ] && default="${default}/main"
  printf '%s' "${!override:-$default}"
}

# Locked rev of an input as of the snapshot (HEAD's lock, not the worktree's —
# the snapshot build reads flake.lock from the commit).
locked_rev() {
  git -C "$ROOT" show HEAD:flake.lock 2>/dev/null \
    | jq -r --arg input "$1" '.nodes[$input].locked.rev // empty'
}

# Promotable target for an input: the committed local main ref, but only when
# it is equal to or an ancestry-proven fast-forward of the verified lock. The
# active checkout and its dirty state are never input bytes. Prints the human
# status line as a side effect. Sets REPLY_TARGET and REPLY_HOLD_REASON.
resolve_target() {
  local input="$1" repo head locked main branch checkout_note relation
  repo="$(repo_for "$input")"
  [ -d "$repo/.git" ] || git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 ||
    die "$repo is not a Git checkout"
  head="$(git -C "$repo" rev-parse HEAD)"
  locked="$(locked_rev "$input")"
  [ -n "$locked" ] || die "flake.lock has no locked revision for '$input'"
  main="$(git -C "$repo" rev-parse --verify 'refs/heads/main^{commit}' 2>/dev/null || true)"
  branch="$(git -C "$repo" branch --show-current)"
  REPLY_HOLD_REASON=""

  checkout_note=""
  if [ "$branch" != main ] || [ "$head" != "$main" ]; then
    checkout_note="$(printf ' (checkout %s@%s excluded' \
      "${branch:-detached-HEAD}" "$(short_rev "$head")")"
    if [ -n "$(git -C "$repo" status --porcelain --untracked-files=no)" ]; then
      checkout_note="$checkout_note; tracked WIP excluded"
    fi
    checkout_note="$checkout_note)"
  elif [ -n "$(git -C "$repo" status --porcelain --untracked-files=no)" ]; then
    checkout_note=" (tracked WIP excluded; only committed local main is eligible)"
  fi

  if [ -z "$main" ]; then
    REPLY_HOLD_REASON="local refs/heads/main is missing"
    notice "$(printf '%-6s %s; holding verified %s%s' \
      "$input" "$REPLY_HOLD_REASON" "$(short_rev "$locked")" "$checkout_note")"
    REPLY_TARGET="$locked"
    return 0
  fi

  if [ "$main" != "$locked" ] &&
     ! git -C "$repo" merge-base --is-ancestor "$locked" "$main" 2>/dev/null; then
    if git -C "$repo" merge-base --is-ancestor "$main" "$locked" 2>/dev/null; then
      relation="behind"
    elif git -C "$repo" cat-file -e "$locked^{commit}" 2>/dev/null; then
      relation="diverged from"
    else
      relation="not ancestry-provable from"
    fi
    REPLY_HOLD_REASON="local main $(short_rev "$main") is $relation verified $(short_rev "$locked"); non-fast-forward not promoted"
    notice "$(printf '%-6s %s; holding verified pin%s' \
      "$input" "$REPLY_HOLD_REASON" "$checkout_note")"
    REPLY_TARGET="$locked"
    return 0
  fi

  if [ "$main" != "$locked" ]; then
    notice "$(printf '%-6s %s → %s%s' \
      "$input" "$(short_rev "$locked")" "$(short_rev "$main")" "$checkout_note")"
  else
    notice "$(printf '%-6s current at %s%s' \
      "$input" "$(short_rev "$locked")" "$checkout_note")"
  fi
  REPLY_TARGET="$main"
}

[ -f "$LOCK" ] || die "missing $LOCK"
command -v jq >/dev/null || die "jq is required to inspect flake.lock"

if [ "$MODE" = plan ]; then
  for input in "${PLAN_INPUTS[@]}"; do
    REPLY_TARGET=""
    resolve_target "$input"
    locked="$(locked_rev "$input")"
    if [ "$REPLY_TARGET" != "$locked" ]; then
      printf 'plan %s %s %s %s\n' "$input" "$locked" "$REPLY_TARGET" "$(repo_for "$input")"
    fi
  done
  exit 0
fi

# ── --commit ────────────────────────────────────────────────────────────────
command -v nix >/dev/null || die "nix is required to refresh local inputs"
[ "$#" -ge 1 ] || { notice "no inputs to promote"; exit 0; }

# The lock rewrite goes through `nix flake update` against the worktree flake.
# Any foreign edit in the way just defers promotion — the switched generation
# already carries the verified revs via --override-input.
if ! git -C "$ROOT" diff --quiet -- flake.lock ||
   ! git -C "$ROOT" diff --cached --quiet -- flake.lock; then
  notice "flake.lock has local edits; deferring pin promotion (generation already carries verified revs)"
  exit 0
fi
if ! git -C "$ROOT" diff --quiet -- flake.nix flake.bnix ||
   ! git -C "$ROOT" diff --cached --quiet -- flake.nix flake.bnix; then
  notice "flake source has local edits; deferring pin promotion (generation already carries verified revs)"
  exit 0
fi

declare -A target seen
inputs=()
for spec in "$@"; do
  case "$spec" in
    *=*) input="${spec%%=*}"; verified="${spec#*=}" ;;
    *) die "--commit target '$spec' must be <input>=<verified-rev>" ;;
  esac
  case "$input" in
    beagle|fram|north) ;;
    *) die "unknown local input '$input'" ;;
  esac
  if [[ -v "seen[$input]" ]]; then
    die "duplicate --commit target for '$input'"
  fi
  seen["$input"]=1
  [[ "$verified" =~ ^[0-9a-f]{40}$ ]] ||
    die "invalid verified revision for '$input': '$verified'"
  target["$input"]="$verified"
  inputs+=("$input")
done

for input in "${inputs[@]}"; do
  verified="${target[$input]}"
  REPLY_TARGET=""
  REPLY_HOLD_REASON=""
  resolve_target "$input" >/dev/null
  if [ "$REPLY_TARGET" != "$verified" ]; then
    if [ -n "$REPLY_HOLD_REASON" ]; then
      notice "$input $REPLY_HOLD_REASON; built target $(short_rev "$verified") is not promotable, deferring"
    else
      notice "$input local main is now $(short_rev "$REPLY_TARGET"), not built target $(short_rev "$verified"); deferring promotion"
    fi
    exit 0
  fi
  if [ "$verified" = "$(locked_rev "$input")" ]; then
    notice "$input no longer promotable; deferring"
    exit 0
  fi
done

backup="$(mktemp "${TMPDIR:-/tmp}/firn-flake-lock.XXXXXX")"
promoted_lock=''
cp "$LOCK" "$backup"
restore_lock() {
  local head_lock_blob='' promoted_lock_blob=''

  git -C "$ROOT" reset --quiet HEAD -- flake.lock >/dev/null 2>&1 || true
  if [ -n "$promoted_lock" ] && [ -f "$promoted_lock" ]; then
    head_lock_blob="$(git -C "$ROOT" rev-parse HEAD:flake.lock 2>/dev/null || true)"
    promoted_lock_blob="$(git hash-object "$promoted_lock" 2>/dev/null || true)"
  fi
  if [ -n "$head_lock_blob" ] &&
     [ "$head_lock_blob" = "$promoted_lock_blob" ]; then
    # The mechanical commit landed before an EXIT/TERM crash. Preserve its
    # exact verified lock and heal the index/worktree to committed HEAD rather
    # than copying the pre-promotion backup over the new commit.
    cp "$promoted_lock" "$LOCK"
  else
    cp "$backup" "$LOCK"
  fi
  rm -f "$backup" "${promoted_lock:-}"
}
trap restore_lock EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# One targeted invocation preserves unrelated remote input pins.
nix flake update --flake "$ROOT" "${inputs[@]}"

for input in "${inputs[@]}"; do
  locked="$(jq -r --arg input "$input" '.nodes[$input].locked.rev // empty' "$LOCK")"
  if [ "$locked" != "${target[$input]}" ]; then
    # The input's main advanced between plan and commit (concurrent land).
    # Not an error: the switched generation used the verified rev; the newer
    # commit promotes on the next rebuild after its own verification.
    notice "$input moved to $(short_rev "$locked") since planning $(short_rev "${target[$input]}"); deferring promotion"
    restore_lock
    trap - EXIT INT TERM
    exit 0
  fi
  main_now="$(git -C "$(repo_for "$input")" rev-parse --verify 'refs/heads/main^{commit}' 2>/dev/null || true)"
  if [ "$main_now" != "${target[$input]}" ]; then
    if [ -n "$main_now" ]; then
      raced_main="$(short_rev "$main_now")"
    else
      raced_main="missing"
    fi
    notice "$input local main raced to $raced_main after resolution; deferring promotion"
    restore_lock
    trap - EXIT INT TERM
    exit 0
  fi
done

for input in "${LOCAL_INPUTS[@]}"; do
  if [[ -v "seen[$input]" ]]; then
    continue
  fi
  before_locked="$(git -C "$ROOT" show HEAD:flake.lock 2>/dev/null |
    jq -cS --arg input "$input" '.nodes[$input].locked // null')"
  after_locked="$(jq -cS --arg input "$input" '.nodes[$input].locked // null' "$LOCK")"
  if [ "$after_locked" != "$before_locked" ]; then
    before_rev="$(jq -r '.rev // "missing"' <<<"$before_locked")"
    after_rev="$(jq -r '.rev // "missing"' <<<"$after_locked")"
    notice "nix rewrote unrequested local input $input from $(short_rev "$before_rev") to $(short_rev "$after_rev"); deferring promotion"
    restore_lock
    trap - EXIT INT TERM
    exit 0
  fi
done

promoted_lock="$(mktemp "${TMPDIR:-/tmp}/firn-promoted-lock.XXXXXX")"
cp "$LOCK" "$promoted_lock"
git -C "$ROOT" add flake.lock
if ! git -C "$ROOT" commit --only -m "refresh verified local inputs" -- flake.lock; then
  notice "mechanical lock commit failed (hook?); deferring promotion"
  restore_lock
  trap - EXIT INT TERM
  exit 0
fi
if [ "${FIRN_INJECT_CRASH_AFTER_COMMIT:-0}" -eq 1 ]; then
  exit 99
fi
trap - EXIT INT TERM
rm -f "$backup" "$promoted_lock"

for input in "${inputs[@]}"; do
  notice "$input promoted to $(short_rev "${target[$input]}")"
done
