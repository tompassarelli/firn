#!/usr/bin/env bash
set -euo pipefail

ROOT="${FIRN_REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
BEAGLE_PATH="${BEAGLE_PATH:-$ROOT/../beagle}"

{
  printf '%s\0' "$ROOT/scripts/firn.rkt"
  find "$ROOT/scripts/firn-cmds" -type f -name '*.rkt' -print0 | sort -z
  # Firn's demod image embeds Beagle library code. Hash the linked library and
  # the pin/toolchain inputs that select its Racket, so dependency-only changes
  # cannot leave a stale but apparently current Firn binary.
  for path in "$BEAGLE_PATH/bin/_beagle-racket" "$BEAGLE_PATH/flake.nix" "$BEAGLE_PATH/flake.lock"; do
    [ ! -f "$path" ] || printf '%s\0' "$path"
  done
  [ ! -d "$BEAGLE_PATH/beagle-lib" ] ||
    find "$BEAGLE_PATH/beagle-lib" -type f \( -name '*.rkt' -o -name 'info.rkt' \) -print0 | sort -z
} | xargs -0 sha256sum | sha256sum | cut -d' ' -f1
