#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
readonly REPO_ROOT
readonly FIRN="$REPO_ROOT/dotfiles/bin/firn"
readonly TARGET="${WORLD_MANIFEST_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/world/manifest.env}"
TARGET_DIR="$(dirname "$TARGET")"
readonly TARGET_DIR

value_from_firn() {
  local name="$1"
  sed -n "s/^${name}=\"\\([^\"]*\\)\"$/\\1/p" "$FIRN" | head -n 1
}

write_value() {
  printf '%s=%q\n' "$1" "$2"
}

code_root="$HOME/code"
repo_nixos_config="$code_root/nixos-config/main"
repo_north="$code_root/north/main"
repo_fram="$code_root/fram/main"
repo_beagle="$code_root/beagle/main"
north_state="$HOME/.local/state/north"
racket_bin="$(value_from_firn BUILT_RACKET_BIN)"
racket_hash="$(value_from_firn BUILT_RACKET_HASH)"
[[ -n "$racket_bin" && -n "$racket_hash" ]] || {
  printf 'world-manifest-gen: could not extract firn rebuild pins from %s\n' "$FIRN" >&2
  exit 1
}

mkdir -p "$TARGET_DIR"
tmp="$(mktemp "$TARGET_DIR/.manifest.env.tmp.XXXXXX")"
trap 'rm -f "${tmp:?}"' EXIT
{
  printf '# Generated by scripts/world-manifest-gen; do not edit.\n'
  printf '# checkouts\n'
  write_value WORLD_CODE_ROOT "$code_root"
  write_value WORLD_REPO_NIXOS_CONFIG "$repo_nixos_config"
  write_value WORLD_REPO_NORTH "$repo_north"
  write_value WORLD_REPO_FRAM "$repo_fram"
  write_value WORLD_REPO_BEAGLE "$repo_beagle"
  printf '\n# state/logs\n'
  write_value WORLD_NORTH_STATE "$north_state"
  write_value WORLD_COORD_LOG "$north_state/coordination.log"
  write_value WORLD_TELEMETRY_LOG "$north_state/telemetry.log"
  write_value WORLD_THREADS_DIR "$north_state/threads"
  write_value WORLD_HARNESS_CONF "$north_state/harness.conf"
  write_value WORLD_FIRN_CACHE "$HOME/.cache/firn"
  write_value WORLD_NORTH_DATA_LEGACY "/home/tom/code/north-data" # world:allow
  write_value WORLD_AGENT_DATA "$code_root/agent-data"
  printf '\n# identity\n'
  write_value WORLD_HOST "$(hostname -s)"
  write_value WORLD_NORTH_PORT "7977"
  write_value WORLD_TELEMETRY_PORT "7978"
  printf '\n# rebuild-coupled pins\n'
  write_value WORLD_RACKET_BIN "$racket_bin"
  write_value WORLD_RACKET_HASH "$racket_hash"
  printf '\n# meta\n'
  write_value WORLD_MANIFEST_VERSION "1"
  write_value WORLD_GENERATED_AT "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  write_value WORLD_GENERATED_FROM "$(git -C "$REPO_ROOT" rev-parse HEAD)"
} >"$tmp"
chmod 0600 "$tmp"
mv -f "$tmp" "$TARGET"
trap - EXIT
printf '%s\n' "$TARGET"
