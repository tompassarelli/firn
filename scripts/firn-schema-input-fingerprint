#!/usr/bin/env python3
"""Fingerprint every locked input and Beagle tool byte that produces schemas."""

import argparse
import hashlib
import json
import pathlib
import sys
from typing import NoReturn


INPUTS = {
    "nixos": ("nixpkgs", "home-manager"),
    "darwin": ("nixpkgs", "home-manager", "nix-darwin"),
}


def fail(message: str) -> NoReturn:
    raise SystemExit(f"firn-schema-input-fingerprint: {message}")


def resolve_node_id(reference, nodes, root_id):
    if isinstance(reference, str):
        if reference not in nodes:
            fail(f"lock node {reference!r} is missing")
        return reference
    if not isinstance(reference, list) or not reference:
        fail(f"invalid input reference: {reference!r}")

    current = root_id
    for name in reference:
        if not isinstance(name, str):
            fail(f"invalid follows path: {reference!r}")
        inputs = nodes.get(current, {}).get("inputs", {})
        if name not in inputs:
            fail(f"follows path {reference!r} cannot resolve {name!r}")
        current = resolve_node_id(inputs[name], nodes, root_id)
    return current


def tool_files(beagle_path):
    roots = (
        beagle_path / "bin" / "beagle-extract-schema",
        beagle_path / "bin" / "beagle-validate",
        beagle_path / "bin" / "_beagle-racket",
        beagle_path / "flake.nix",
        beagle_path / "flake.lock",
    )
    required = roots[:2]
    for path in required:
        if not path.is_file():
            fail(f"required Beagle tool is missing: {path}")

    selected = [path for path in roots if path.is_file()]
    for dirname in ("beagle", "beagle-lib"):
        root = beagle_path / dirname
        if root.is_dir():
            selected.extend(
                path
                for path in root.rglob("*")
                if path.is_file()
                and "compiled" not in path.relative_to(root).parts
                and path.suffix in {".rkt", ".scrbl"}
            )
    return sorted(set(selected), key=lambda path: path.relative_to(beagle_path).as_posix())


def tool_fingerprint(beagle_path):
    try:
        canonical = beagle_path.resolve(strict=True)
    except OSError as error:
        fail(f"cannot resolve Beagle path {beagle_path}: {error}")
    digest = hashlib.sha256()
    digest.update(b"firn-beagle-schema-tools-v1\0")
    for path in tool_files(canonical):
        relative = path.relative_to(canonical).as_posix().encode("utf-8")
        try:
            contents = path.read_bytes()
        except OSError as error:
            fail(f"cannot read Beagle tool input {path}: {error}")
        digest.update(len(relative).to_bytes(8, "big"))
        digest.update(relative)
        digest.update(len(contents).to_bytes(8, "big"))
        digest.update(contents)
    return digest.hexdigest()


def fingerprint(lock, mode, beagle_path):
    nodes = lock.get("nodes")
    root_id = lock.get("root")
    if not isinstance(nodes, dict) or root_id not in nodes:
        fail("malformed flake.lock root or nodes")
    root_inputs = nodes[root_id].get("inputs", {})

    selected = {}
    for name in INPUTS[mode]:
        if name not in root_inputs:
            fail(f"root input {name!r} is missing")
        node_id = resolve_node_id(root_inputs[name], nodes, root_id)
        locked = nodes[node_id].get("locked")
        if not isinstance(locked, dict):
            fail(f"root input {name!r} has no locked source")
        selected[name] = locked

    payload = {
        "format": "firn-schema-inputs-v2",
        "mode": mode,
        "inputs": selected,
        "beagleToolSha256": tool_fingerprint(beagle_path),
    }
    canonical = json.dumps(
        payload, sort_keys=True, separators=(",", ":"), ensure_ascii=True
    ).encode("utf-8")
    return hashlib.sha256(canonical).hexdigest()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--mode", required=True, choices=sorted(INPUTS))
    parser.add_argument("--lock", required=True, type=pathlib.Path)
    parser.add_argument("--beagle-path", required=True, type=pathlib.Path)
    args = parser.parse_args()
    try:
        lock = json.loads(args.lock.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        fail(f"cannot read {args.lock}: {error}")
    print(fingerprint(lock, args.mode, args.beagle_path))


if __name__ == "__main__":
    main()
