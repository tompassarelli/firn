#!/usr/bin/env bash
# firn-validate — validates .bnix source files against the NixOS option schema.
#
# Uses beagle-validate for source-level validation (option paths, types,
# duplicates, cross-file conflicts).
#
# Also runs firn-lint-nix to syntax-check generated .nix files.

set -euo pipefail

REPO="${FIRN_REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
BEAGLE_PATH="${BEAGLE_PATH:-$(cd "$REPO/.." && pwd)/beagle}"
BEAGLE_VALIDATE="$BEAGLE_PATH/bin/beagle-validate"

echo "firn-validate: [1/2] syntax-checking generated .nix files..." >&2
if ! "$REPO/scripts/firn-lint-nix"; then
  echo "firn-validate: generated .nix has syntax errors (firn-build codegen bug?)" >&2
  exit 1
fi
echo "firn-validate: [2/2] schema-validating .bnix sources..." >&2

if [[ ! -x "$BEAGLE_VALIDATE" ]]; then
  echo "firn-validate: beagle-validate not found at $BEAGLE_VALIDATE" >&2
  echo "  set BEAGLE_PATH=/path/to/beagle" >&2
  exit 2
fi

# Schema-cache identity check: .beagle-cache/schema.json is only truthful
# for the exact nixpkgs/home-manager revisions it was extracted against
# (recorded by firn-extract-schema as schema.inputs.sha256). If flake.lock
# has moved since extraction, the cached option table can silently omit or
# invent options — refuse to validate against a cache that can no longer
# prove it matches the pinned revision, rather than emitting unknown-option
# diagnostics that may just be schema-cache drift.
SCHEMA_JSON="$REPO/.beagle-cache/schema.json"
if [[ -f "$SCHEMA_JSON" ]]; then
  SCHEMA_FP="$REPO/.beagle-cache/schema.inputs.sha256"
  FP_HELPER="$REPO/scripts/firn-schema-input-fingerprint"
  FLAKE_LOCK="$REPO/flake.lock"

  if [[ ! -x "$FP_HELPER" ]]; then
    echo "firn-validate: fingerprint helper missing at $FP_HELPER" >&2
    exit 2
  fi
  if [[ ! -f "$FLAKE_LOCK" ]]; then
    echo "firn-validate: flake.lock missing at $FLAKE_LOCK; cannot verify schema-cache identity" >&2
    exit 2
  fi
  if [[ ! -f "$SCHEMA_FP" ]]; then
    echo "firn-validate: .beagle-cache/schema.json has no recorded input fingerprint ($SCHEMA_FP missing)" >&2
    echo "  cache identity is unverifiable — re-run: ./scripts/firn-extract-schema" >&2
    exit 1
  fi
  recorded_fp="$(<"$SCHEMA_FP")"
  current_fp="$("$FP_HELPER" --mode nixos --lock "$FLAKE_LOCK")"
  if [[ "$recorded_fp" != "$current_fp" ]]; then
    echo "firn-validate: schema cache is stale — .beagle-cache/schema.json was extracted for a" >&2
    echo "  different nixpkgs/home-manager revision than flake.lock currently pins." >&2
    echo "  recorded fingerprint: $recorded_fp" >&2
    echo "  current  fingerprint: $current_fp" >&2
    echo "  re-run: ./scripts/firn-extract-schema" >&2
    exit 1
  fi
fi

cd "$REPO"

# If the caller passed explicit files, validate exactly those. Otherwise
# auto-discover .bnix files excluding tests/fixtures (which contain
# intentionally-broken fixtures invoked individually by validator-test.rkt).
if (( $# > 0 )); then
  exec "$BEAGLE_VALIDATE" "$@"
else
  mapfile -t FILES < <(find . -type f -name '*.bnix' \
    -not -path './tests/fixtures/*' \
    -not -path './result/*' \
    -not -path './.direnv/*' | sort)
  exec "$BEAGLE_VALIDATE" "${FILES[@]}"
fi
