#!/usr/bin/env bash
# firn-validate — validates .bnix source files against the NixOS option schema.
#
# Uses beagle-validate for source-level validation (option paths, types,
# duplicates, cross-file conflicts).
#
# Also runs firn-lint-nix to syntax-check generated .nix files.

set -euo pipefail

REPO="${FIRN_REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
if [ -z "${BEAGLE_PATH:-}" ]; then
  for _bp in "$HOME/code/beagle/main" "$HOME/code/beagle" "$REPO/../beagle"; do
    if [ -x "$_bp/bin/beagle-validate" ]; then BEAGLE_PATH="$_bp"; break; fi
  done
  unset _bp
fi
BEAGLE_PATH="${BEAGLE_PATH:-$(cd "$REPO/.." && pwd)/beagle}"
BEAGLE_VALIDATE="$BEAGLE_PATH/bin/beagle-validate"

echo "firn-validate: [1/2] syntax-checking generated .nix files..." >&2
if ! "$REPO/scripts/firn-lint-nix"; then
  echo "firn-validate: generated .nix has syntax errors (firn-build codegen bug?)" >&2
  exit 1
fi
echo "firn-validate: [2/2] schema-validating .bnix sources..." >&2

if [[ ! -x "$BEAGLE_VALIDATE" ]]; then
  echo "firn-validate: beagle-validate not found at $BEAGLE_VALIDATE" >&2
  echo "  set BEAGLE_PATH=/path/to/beagle" >&2
  exit 2
fi

# The schema cache is derived state. A clean worktree must be able to validate
# without borrowing another checkout's ignored cache, and a partial/stale cache
# must never be trusted. firn-extract-schema publishes complete JSON through
# same-directory atomic renames and writes the input fingerprint last.
SCHEMA_JSON="$REPO/.beagle-cache/schema.json"
SCHEMA_HM="$REPO/.beagle-cache/schema-hm.json"
SCHEMA_FP="$REPO/.beagle-cache/schema.inputs.sha256"
SCHEMA_CONFIG="$REPO/.beagle-cache/validate-config.json"
SCHEMA_CONFIG_SOURCE="${FIRN_SCHEMA_CONFIG:-$REPO/config/beagle-validate.json}"
FP_HELPER="$REPO/scripts/firn-schema-input-fingerprint"
FLAKE_LOCK="$REPO/flake.lock"
SCHEMA_EXTRACT="${FIRN_EXTRACT_SCHEMA:-$REPO/scripts/firn-extract-schema}"

schema_cache_is_current() {
  local recorded_fp current_fp

  SCHEMA_CACHE_REASON=''
  for required in "$SCHEMA_JSON" "$SCHEMA_HM" "$SCHEMA_FP" "$SCHEMA_CONFIG"; do
    if [[ ! -f "$required" ]]; then
      SCHEMA_CACHE_REASON="missing ${required#"$REPO"/}"
      return 1
    fi
  done
  if ! cmp -s "$SCHEMA_CONFIG_SOURCE" "$SCHEMA_CONFIG"; then
    SCHEMA_CACHE_REASON='validator policy differs from tracked config/beagle-validate.json'
    return 1
  fi
  if ! python3 - "$SCHEMA_JSON" "$SCHEMA_HM" "$SCHEMA_CONFIG" <<'PY'
import json
import pathlib
import sys

for path_arg in sys.argv[1:3]:
    path = pathlib.Path(path_arg)
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        raise SystemExit(1)
    if not isinstance(value, list) or not value:
        raise SystemExit(1)
try:
    config = json.loads(pathlib.Path(sys.argv[3]).read_text(encoding="utf-8"))
except (OSError, UnicodeError, json.JSONDecodeError):
    raise SystemExit(1)
if not isinstance(config, dict):
    raise SystemExit(1)
PY
  then
    SCHEMA_CACHE_REASON='schema JSON is partial or malformed'
    return 1
  fi
  recorded_fp="$(<"$SCHEMA_FP")"
  current_fp="$("$FP_HELPER" --mode nixos --lock "$FLAKE_LOCK" --beagle-path "$BEAGLE_PATH" 2>/dev/null)" || {
    SCHEMA_CACHE_REASON='cannot fingerprint flake.lock and Beagle schema tool inputs'
    return 1
  }
  if [[ "$recorded_fp" != "$current_fp" ]]; then
    SCHEMA_CACHE_REASON='schema input fingerprint differs from flake.lock or Beagle tool identity'
    return 1
  fi
  return 0
}

if [[ ! -x "$FP_HELPER" ]]; then
  echo "firn-validate: fingerprint helper missing at $FP_HELPER" >&2
  exit 2
fi
if [[ ! -f "$FLAKE_LOCK" ]]; then
  echo "firn-validate: flake.lock missing at $FLAKE_LOCK; cannot identify the schema cache" >&2
  exit 2
fi
if [[ ! -f "$SCHEMA_CONFIG_SOURCE" ]]; then
  echo "firn-validate: tracked validator policy missing at $SCHEMA_CONFIG_SOURCE" >&2
  exit 2
fi
if ! schema_cache_is_current; then
  refresh_reason=$SCHEMA_CACHE_REASON
  if [[ ! -x "$SCHEMA_EXTRACT" ]]; then
    echo "firn-validate: schema cache needs refresh ($refresh_reason), but extractor is missing at $SCHEMA_EXTRACT" >&2
    exit 2
  fi
  echo "firn-validate: refreshing schema cache ($refresh_reason)..." >&2
  FIRN_REPO="$REPO" BEAGLE_PATH="$BEAGLE_PATH" FIRN_SCHEMA_CONFIG="$SCHEMA_CONFIG_SOURCE" \
    "$SCHEMA_EXTRACT"
  if ! schema_cache_is_current; then
    echo "firn-validate: refreshed schema cache is not valid: $SCHEMA_CACHE_REASON" >&2
    exit 1
  fi
fi

cd "$REPO"

# If the caller passed explicit files, validate exactly those. Otherwise
# auto-discover .bnix files excluding tests/fixtures (which contain
# intentionally-broken fixtures invoked individually by validator-test.rkt).
if (( $# > 0 )); then
  exec "$BEAGLE_VALIDATE" "$@"
else
  mapfile -t FILES < <(find . -type f -name '*.bnix' \
    -not -path './tests/fixtures/*' \
    -not -path './result/*' \
    -not -path './.direnv/*' | sort)
  exec "$BEAGLE_VALIDATE" "${FILES[@]}"
fi
