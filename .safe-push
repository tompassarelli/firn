[landing]
	capacity = north capacity host run --class heavy --owner land-check --priority tom-ask --timeout-seconds 3600 --
[ci]
	budget = tests.yml 345
[land]
	check-local = true
	inferred = false
	check = ** :: nix run "path:$PWD#formatter.x86_64-linux" -- --ci
	check = modules/ :: bash .github/scripts/land-checks.sh scripts
	check = "modules/,hosts/,config/,native/nix/,flake.nix :: nix shell --inputs-from path:$PWD nixpkgs#statix nixpkgs#deadnix --command sh -c 'statix check . && deadnix --fail .'"
	after = . :: north config agents check-owners --north-root \"$HOME/code/north/main\" --south-root \"$HOME/code/south/main\" --nixos-root \"$PWD\" # hardcoded-repo-path:allow
	after = "tools/firn/ :: nix shell --inputs-from . nixpkgs#cargo nixpkgs#rustc nixpkgs#gcc --command cargo test --locked --manifest-path tools/firn/Cargo.toml"
	after = native/,.github/scripts/host-diff.sh :: bash .github/scripts/land-checks.sh native
	after = modules/,hosts/,config/,native/nix/,flake.nix,flake.lock,dotfiles/bin/firn-check,.github/scripts/host-diff.sh,.github/scripts/land-checks.sh :: bash .github/scripts/land-checks.sh drift
	after = dotfiles/bin/ :: bash .github/scripts/land-checks.sh dotfiles
	after = . :: nix flake check --offline --no-update-lock-file --no-build
	after = . :: bash .github/scripts/land-checks.sh flake
	after = . :: bash .github/scripts/land-checks.sh host
	local-only = "only whiterabbit's store holds its own system check; with laptop_system_check_gate on it only prints that the delivery-liveness floor builds this host's toplevel once the landing queues are empty, and off it runs the whole nix flake check here as before (north#1036) :: bash .github/scripts/land-checks.sh host"
	host-input = "/dev/kvm :: bash .github/scripts/land-checks.sh flake"
	after-only = it judges firn against the north and south checkouts on main beside the host, which a lane tree does not hold :: north config agents check-owners --north-root \"$HOME/code/north/main\" --south-root \"$HOME/code/south/main\" --nixos-root \"$PWD\" # hardcoded-repo-path:allow
	after-only = "north#633 lands firn first and checks it after the push, reverting only the lane a red run names: it builds and tests the firn Rust tool in a nix shell, minutes per lane :: nix shell --inputs-from . nixpkgs#cargo nixpkgs#rustc nixpkgs#gcc --command cargo test --locked --manifest-path tools/firn/Cargo.toml"
	after-only = the native host tests run the installed firn runtime of the host (FIRN_RUNTIME_BIN), which an offload slot does not have :: bash .github/scripts/land-checks.sh native
	after-only = "north#633 lands firn first and checks it after the push, reverting only the lane a red run names: it evaluates every host's derivations against the base and, on the after-landing run's build host, builds each changed host toplevel but its own, so a lane that breaks whiterabbit's system is blamed by the landing's run, minutes per lane and up to the 60 min deadline, the capacity gate's ceiling, for a cold toplevel build on a shared slot :: bash .github/scripts/land-checks.sh drift"
	deadline = "3600 :: bash .github/scripts/land-checks.sh drift"
	after-only = "north#633 lands firn first and checks it after the push, reverting only the lane a red run names: it runs the changed dotfiles/bin tests :: bash .github/scripts/land-checks.sh dotfiles"
	after-only = "north#633 lands firn first and checks it after the push, reverting only the lane a red run names: it evaluates every flake output, about 30 s per lane (c589e73c) :: nix flake check --offline --no-update-lock-file --no-build"
	after-only = "north#633 lands firn first and checks it after the push, reverting only the lane a red run names: it builds every flake check but the host toplevels, the NixOS VM tests among them, on the after-landing run's build host, minutes per lane :: bash .github/scripts/land-checks.sh flake"
	after-only = "north#1036 keeps the laptop's own system build out of the landing: it defers to the delivery-liveness floor, or with the switch off builds the whole flake check here :: bash .github/scripts/land-checks.sh host"
	after-only = "north#633 lands firn first and checks it after the push, reverting only the lane a red run names: it builds whiterabbit's system closure on a clean runner, minutes per lane, where the formatter and module checks run before the push :: .github/workflows/build.yml:build"
	after-only = safe-push's outgoing secret scan judges each lane before the push, and this scans the whole history with betterleaks' own rules :: .github/workflows/secret-scan.yml:betterleaks
	after-only = "north#633 lands firn first and checks it after the push, reverting only the lane a red run names: it installs the firn runtime and runs every discovered shell test on a clean runner, minutes per lane, where the changed ones run after the push as land checks :: .github/workflows/tests.yml:tests"
