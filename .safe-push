[ci]
	budget = tests.yml 345
[land]
	check = "tools/firn/ :: nix shell --inputs-from . nixpkgs#cargo nixpkgs#rustc nixpkgs#gcc --command bun \"$(dirname \"$(agents path machine-capacity)\")/scripts/machine-capacity.mjs\" run --class heavy --owner rust-port --timeout-seconds 1800 -- cargo test --locked --manifest-path tools/firn/Cargo.toml"
	check = native/,.github/scripts/host-diff.sh :: bun \"$(dirname \"$(agents path machine-capacity)\")/scripts/machine-capacity.mjs\" run --owner land-check --timeout-seconds 1800 -- bash .github/scripts/land-checks.sh native
	check = modules/,hosts/,config/,native/nix/,flake.nix,flake.lock,dotfiles/bin/firn-check,.github/scripts/host-diff.sh,.github/scripts/land-checks.sh :: bun \"$(dirname \"$(agents path machine-capacity)\")/scripts/machine-capacity.mjs\" run --owner land-check --timeout-seconds 1800 -- bash .github/scripts/land-checks.sh drift
	check = dotfiles/bin/ :: bash .github/scripts/land-checks.sh dotfiles
