[landing]
	capacity = north capacity host run --class heavy --owner land-check --priority tom-ask --timeout-seconds 3600 --
[ci]
	budget = tests.yml 345
[land]
	check-local = true
	inferred = false
	check = ** :: nix run "path:$PWD#formatter.x86_64-linux" -- --ci
	after = . :: north config agents check-owners --north-root \"$HOME/code/north/main\" --south-root \"$HOME/code/south/main\" --nixos-root \"$PWD\" # hardcoded-repo-path:allow
	after = "tools/firn/ :: nix shell --inputs-from . nixpkgs#cargo nixpkgs#rustc nixpkgs#gcc --command cargo test --locked --manifest-path tools/firn/Cargo.toml"
	after = native/,.github/scripts/host-diff.sh :: bash .github/scripts/land-checks.sh native
	after = modules/,hosts/,config/,native/nix/,flake.nix,flake.lock,dotfiles/bin/firn-check,.github/scripts/host-diff.sh,.github/scripts/land-checks.sh :: bash .github/scripts/land-checks.sh drift
	after = dotfiles/bin/ :: bash .github/scripts/land-checks.sh dotfiles
	after = . :: nix flake check --offline --no-update-lock-file --no-build
	after = . :: nix flake check --no-update-lock-file
	local-only = builds checks.host-whiterabbit, whose system closure only whiterabbit's store holds, so an offload host would rebuild it from source, gcc included; it runs with the binary cache on, since --offline turned substituters off and built every path missing here from source :: nix flake check --no-update-lock-file
