#lang beagle/js
(ns firn.flake-input-driver
  (:require [firn.flake-input :as input]))

(js/export
 (defunion FlakeInputArgv
  (ParsedFlakeInputEmit [token Bool])
  (OtherFirnCommand [argv (Vec String)])
  (InvalidFlakeInputArgv [argv (Vec String)])))

(js/export
 (defn parse-flake-input-argv [argv (Vec String)] FlakeInputArgv
  (if (and (>= (count argv) 2)
           (= (nth argv 0) "flake-input")
           (= (nth argv 1) "resolve"))
    (if (and (= (count argv) 3) (= (nth argv 2) "emit"))
      (->ParsedFlakeInputEmit false)
      (->InvalidFlakeInputArgv argv))
    (->OtherFirnCommand argv))))

(js/export
 (defn inputs-from-rows [rows (Vec (Vec String))] (Vec input/FlakeInput)
  (loop [index Int 0
         declared (Vec input/FlakeInput) []]
    (if (>= index (count rows))
      (input/collect declared)
      (let [row (Vec String) (nth rows index)]
        (recur (+ index 1)
          (conj declared
            (input/->FlakeInput (nth row 1) (nth row 0) (nth row 2)))))))))

(defn source-module-lines
  [inputs (Vec input/FlakeInput)
   names (Vec String)
   index Int] String
  (if (>= index (count names))
    ""
    (let [name String (nth names index)]
      (str "  " name " (from "
        (input/flakeinput-source-module (input/find-input inputs name)) ")\n"
        (source-module-lines inputs names (+ index 1))))))

(defn plural-suffix [count Int] String
  (if (= count 1) "" "s"))

(js/export
 (defn summary-text
  [inputs (Vec input/FlakeInput)
   changed Bool] String
  (let [input-count Int (count inputs)
        module-count Int (input/source-module-count inputs)]
    (str
      (if (= input-count 0)
        "flake-inputs: no module inputs found\n"
        (str "flake-inputs: " input-count " module input"
          (plural-suffix input-count) " from " module-count " module"
          (plural-suffix module-count) "\n"
          (source-module-lines inputs (input/sorted-input-names inputs) 0)))
      (if changed
        "flake-inputs: updated flake.nix\n"
        "flake-inputs: flake.nix is up to date\n")))))
