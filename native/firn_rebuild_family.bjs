#lang beagle/js
(ns firn.rebuild-family
  (:require [clojure.string :as str]
            [firn.impact :as impact]
            [firn.rebuild-native :as rebuild]))

(declare-extern firn-host-get (Fn [Any Int] Any))
(declare-extern firn-host-env (Fn [String] (U String Nil)))
(declare-extern firn-host-out (Fn [String] Nil))
(declare-extern firn-host-err (Fn [String] Nil))
(declare-extern firn-host-capture (Fn [(Vec String) Int] Any))

(defunion CaptureResult
  (CaptureOk
    [status Int
     stdout String
     stderr String])
  (CaptureError [errno Int]))

(defn capture
  [argv (Vec String)
   limit Int] CaptureResult
  (let [result Any (firn-host-capture argv limit)
        tag String (firn-host-get result 0)]
    (if (= tag "ok")
      (->CaptureOk
        (firn-host-get result 1)
        (firn-host-get result 2)
        (firn-host-get result 3))
      (->CaptureError (firn-host-get result 1)))))

(def max-impact-output Int 16777216)

(defn repository-root [] (U String Nil)
  (let [explicit (U String Nil) (firn-host-env "FIRN_REPO")]
    (if (some? explicit)
      explicit
      (let [home (U String Nil) (firn-host-env "HOME")]
        (if (some? home)
          (str home "/code/nixos-config/main")
          nil)))))

(defn current-host [] String
  (let [configured (U String Nil) (firn-host-env "FIRN_HOST")]
    (if (some? configured)
      configured
      (match (capture ["hostname"] 4096)
        [(CaptureError errno) "whiterabbit"]
        [(CaptureOk status stdout stderr)
         (let [hostname String (str/trim stdout)]
           (if (and (= status 0) (> (count hostname) 0))
             hostname
             "whiterabbit"))]))))

(defn current-system-derivations [] (Vec String)
  (match (capture
           ["nix" "path-info" "/run/current-system" "--derivation"]
           max-impact-output)
    [(CaptureError errno) []]
    [(CaptureOk status stdout stderr)
     (if (= status 0) (impact/split-lines stdout) [])]))

(defn run-impact [host String] Int
  (let [root (U String Nil) (repository-root)]
    (if (nil? root)
      (do
        (firn-host-err
          "firn impact: FIRN_REPO and HOME are not set\n")
        1)
      (let [attribute String (str root "#nixosConfigurations." host
              ".config.system.build.toplevel")]
        (match (capture
                 ["nix" "build" attribute "--dry-run"]
                 max-impact-output)
          [(CaptureError errno)
           (do
             (firn-host-err
               (str "firn impact: cannot run nix: errno " errno "\n"))
             1)]
          [(CaptureOk status stdout stderr)
           (match (impact/interpret
                    (impact/->ImpactInput host
                      (impact/->DryRunResult status (str stdout stderr))
                      (current-system-derivations)))
             [(ImpactFailed text)
              (do (firn-host-err text) 1)]
             [(ImpactReady assessment text)
              (do (firn-host-out text) 0)])])))))

(defn requested-leaf [args (Vec String)] String
  (if (= (count args) 3) (nth args 2) (current-host)))

(defn usage-error [] Int
  (do
    (firn-host-err
      (str "Usage:\n"
        "  firn host impact [<host>]\n"
        "  firn host prepare [<host>]\n"
        "  firn host activate <exact-store-path>\n"
        "  firn host rebuild [<host>]\n"
        "  firn host rollback <generation>\n"))
    64))

(js/export
  (defn run [args (Vec String)] Int
  (if (not (and (or (= (count args) 2) (= (count args) 3))
                (= (nth args 0) "host")))
    (usage-error)
    (let [edge String (nth args 1)
          leaf String (requested-leaf args)]
      (cond
        (= edge "impact") (run-impact leaf)
        (= edge "prepare") (rebuild/run-command ["host" "prepare" leaf])
        (= edge "activate")
        (if (= (count args) 3)
          (rebuild/run-command ["host" "activate" leaf])
          (usage-error))
        (= edge "rebuild") (rebuild/run-command ["host" "rebuild" leaf])
        (= edge "rollback")
        (if (= (count args) 3)
          (rebuild/run-command ["host" "rollback" leaf])
          (usage-error))
        :else (usage-error))))))
