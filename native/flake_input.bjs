#lang beagle/js
(ns firn.flake-input)

(js/export
  (defrecord FlakeInput
    [name String
     source-module String
     url String]))

(defn input-index
  [inputs (Vec FlakeInput)
   name String] Int
  (loop [index Int 0]
    (if (>= index (count inputs))
      -1
      (if (= name (flakeinput-name (nth inputs index)))
        index
        (recur (+ index 1))))))

(js/export
 (defn collect [declared (Vec FlakeInput)] (Vec FlakeInput)
  (loop [index Int 0
         collected (Vec FlakeInput) []]
    (if (>= index (count declared))
      collected
      (let [candidate FlakeInput (nth declared index)]
        (recur (+ index 1)
          (if (< (input-index collected (flakeinput-name candidate)) 0)
            (conj collected candidate)
            collected)))))))

(js/export
 (defn sorted-input-names [inputs (Vec FlakeInput)] (Vec String)
  (loop [index Int 0
         names (Vec String) []]
    (if (>= index (count inputs))
      (sort names)
      (recur (+ index 1)
        (conj names (flakeinput-name (nth inputs index))))))))

(js/export
 (defn find-input
  [inputs (Vec FlakeInput)
   name String] FlakeInput
  (nth inputs (input-index inputs name))))

(defn member?
  [values (Vec String)
   wanted String] Bool
  (loop [index Int 0]
    (cond
      (>= index (count values)) false
      (= (nth values index) wanted) true
      :else (recur (+ index 1)))))

(js/export
 (defn source-module-count [inputs (Vec FlakeInput)] Int
  (loop [index Int 0
         modules (Vec String) []]
    (if (>= index (count inputs))
      (count modules)
      (let [module String (flakeinput-source-module (nth inputs index))]
        (recur (+ index 1)
          (if (member? modules module)
            modules
            (conj modules module))))))))
