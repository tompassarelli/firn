#lang beagle
(ns firn.system-policy-native
  (:require [native.json :as json]
            [firn.system-policy :as policy]))

(def max-hook-bytes Int 1048576)
(def max-activation-bytes Int 1048576)

(defunion HookPayload
  (HookPayloadParsed
    [tool-name String
     command (U String Nil)
     file-path (U String Nil)
     session-id String])
  (HookPayloadRejected [token Bool]))

(defunion KillSwitchEnv
  (KillSwitchEnvDecision [guards-off Bool])
  (KillSwitchEnvUnset [token Bool]))

(defn json-value-end
  [events (Vec json/JsonEvent)
   start Int]
  Int
  (if (or (< start 0) (>= start (count events)))
    -1
    (match (nth events start)
      [(JsonObjectStart offset)
       (loop [index Int (+ start 1)
              depth Int 0]
         (if (>= index (count events))
           -1
           (match (nth events index)
             [(JsonObjectStart nested-offset)
              (recur (+ index 1) (+ depth 1))]
             [(JsonArrayStart nested-offset)
              (recur (+ index 1) (+ depth 1))]
             [(JsonObjectEnd nested-offset)
              (if (= depth 0)
                (+ index 1)
                (recur (+ index 1) (- depth 1)))]
             [(JsonArrayEnd nested-offset)
              (recur (+ index 1) (- depth 1))]
             [(JsonKey nested-offset value) (recur (+ index 1) depth)]
             [(JsonString nested-offset value) (recur (+ index 1) depth)]
             [(JsonNumber nested-offset lexeme) (recur (+ index 1) depth)]
             [(JsonBoolean nested-offset value) (recur (+ index 1) depth)]
             [(JsonNull nested-offset) (recur (+ index 1) depth)])))]
      [(JsonArrayStart offset)
       (loop [index Int (+ start 1)
              depth Int 0]
         (if (>= index (count events))
           -1
           (match (nth events index)
             [(JsonObjectStart nested-offset)
              (recur (+ index 1) (+ depth 1))]
             [(JsonArrayStart nested-offset)
              (recur (+ index 1) (+ depth 1))]
             [(JsonArrayEnd nested-offset)
              (if (= depth 0)
                (+ index 1)
                (recur (+ index 1) (- depth 1)))]
             [(JsonObjectEnd nested-offset)
              (recur (+ index 1) (- depth 1))]
             [(JsonKey nested-offset value) (recur (+ index 1) depth)]
             [(JsonString nested-offset value) (recur (+ index 1) depth)]
             [(JsonNumber nested-offset lexeme) (recur (+ index 1) depth)]
             [(JsonBoolean nested-offset value) (recur (+ index 1) depth)]
             [(JsonNull nested-offset) (recur (+ index 1) depth)])))]
      [(JsonObjectEnd offset) -1]
      [(JsonArrayEnd offset) -1]
      [(JsonKey offset value) -1]
      [(JsonString offset value) (+ start 1)]
      [(JsonNumber offset lexeme) (+ start 1)]
      [(JsonBoolean offset value) (+ start 1)]
      [(JsonNull offset) (+ start 1)])))

(defn object-string-field
  [events (Vec json/JsonEvent)
   object-start Int
   wanted String]
  (U String Nil)
  (loop [index Int (+ object-start 1)]
    (if (>= index (count events))
      nil
      (match (nth events index)
        [(JsonObjectEnd offset) nil]
        [(JsonKey offset key)
         (let [value-index Int (+ index 1)
               next Int (json-value-end events value-index)]
           (if (< next 0)
             nil
             (if (= key wanted)
               (match (nth events value-index)
                 [(JsonString value-offset value) value]
                 [(JsonObjectStart value-offset) nil]
                 [(JsonObjectEnd value-offset) nil]
                 [(JsonArrayStart value-offset) nil]
                 [(JsonArrayEnd value-offset) nil]
                 [(JsonKey value-offset value) nil]
                 [(JsonNumber value-offset lexeme) nil]
                 [(JsonBoolean value-offset value) nil]
                 [(JsonNull value-offset) nil])
               (recur next))))]
        [(JsonObjectStart offset) nil]
        [(JsonArrayStart offset) nil]
        [(JsonArrayEnd offset) nil]
        [(JsonString offset value) nil]
        [(JsonNumber offset lexeme) nil]
        [(JsonBoolean offset value) nil]
        [(JsonNull offset) nil]))))

(defn object-field-start
  [events (Vec json/JsonEvent)
   object-start Int
   wanted String]
  Int
  (loop [index Int (+ object-start 1)]
    (if (>= index (count events))
      -1
      (match (nth events index)
        [(JsonObjectEnd offset) -1]
        [(JsonKey offset key)
         (let [value-index Int (+ index 1)
               next Int (json-value-end events value-index)]
           (if (< next 0)
             -1
             (if (= key wanted)
               (match (nth events value-index)
                 [(JsonObjectStart value-offset) value-index]
                 [(JsonObjectEnd value-offset) -1]
                 [(JsonArrayStart value-offset) -1]
                 [(JsonArrayEnd value-offset) -1]
                 [(JsonKey value-offset value) -1]
                 [(JsonString value-offset value) -1]
                 [(JsonNumber value-offset lexeme) -1]
                 [(JsonBoolean value-offset value) -1]
                 [(JsonNull value-offset) -1])
               (recur next))))]
        [(JsonObjectStart offset) -1]
        [(JsonArrayStart offset) -1]
        [(JsonArrayEnd offset) -1]
        [(JsonString offset value) -1]
        [(JsonNumber offset lexeme) -1]
        [(JsonBoolean offset value) -1]
        [(JsonNull offset) -1]))))

(defn object-array-field-start
  [events (Vec json/JsonEvent)
   object-start Int
   wanted String]
  Int
  (loop [index Int (+ object-start 1)]
    (if (>= index (count events))
      -1
      (match (nth events index)
        [(JsonObjectEnd offset) -1]
        [(JsonKey offset key)
         (let [value-index Int (+ index 1)
               next Int (json-value-end events value-index)]
           (if (< next 0)
             -1
             (if (= key wanted)
               (match (nth events value-index)
                 [(JsonArrayStart value-offset) value-index]
                 [(JsonObjectStart value-offset) -1]
                 [(JsonObjectEnd value-offset) -1]
                 [(JsonArrayEnd value-offset) -1]
                 [(JsonKey value-offset value) -1]
                 [(JsonString value-offset value) -1]
                 [(JsonNumber value-offset lexeme) -1]
                 [(JsonBoolean value-offset value) -1]
                 [(JsonNull value-offset) -1])
               (recur next))))]
        [(JsonObjectStart offset) -1]
        [(JsonArrayStart offset) -1]
        [(JsonArrayEnd offset) -1]
        [(JsonString offset value) -1]
        [(JsonNumber offset lexeme) -1]
        [(JsonBoolean offset value) -1]
        [(JsonNull offset) -1]))))

(defn object-bool-field
  [events (Vec json/JsonEvent)
   object-start Int
   wanted String]
  (U Bool Nil)
  (loop [index Int (+ object-start 1)]
    (if (>= index (count events))
      nil
      (match (nth events index)
        [(JsonObjectEnd offset) nil]
        [(JsonKey offset key)
         (let [value-index Int (+ index 1)
               next Int (json-value-end events value-index)]
           (if (< next 0)
             nil
             (if (= key wanted)
               (match (nth events value-index)
                 [(JsonBoolean value-offset value) value]
                 [(JsonObjectStart value-offset) nil]
                 [(JsonObjectEnd value-offset) nil]
                 [(JsonArrayStart value-offset) nil]
                 [(JsonArrayEnd value-offset) nil]
                 [(JsonKey value-offset value) nil]
                 [(JsonString value-offset value) nil]
                 [(JsonNumber value-offset lexeme) nil]
                 [(JsonNull value-offset) nil])
               (recur next))))]
        [(JsonObjectStart offset) nil]
        [(JsonArrayStart offset) nil]
        [(JsonArrayEnd offset) nil]
        [(JsonString offset value) nil]
        [(JsonNumber offset lexeme) nil]
        [(JsonBoolean offset value) nil]
        [(JsonNull offset) nil]))))

(defn decode-hook-payload [text String] HookPayload
  (match (json/decode text)
    [(JsonDecodeError offset message) (->HookPayloadRejected true)]
    [(JsonDecoded events)
     (if (or (empty? events)
             (not= (json-value-end events 0) (count events)))
       (->HookPayloadRejected true)
       (match (nth events 0)
         [(JsonObjectStart offset)
          (let [tool-input Int (object-field-start events 0 "tool_input")
                tool (U String Nil) (object-string-field events 0 "tool_name")
                session (U String Nil) (object-string-field events 0 "session_id")
                command (U String Nil) (if (< tool-input 0)
                  nil
                  (object-string-field events tool-input "command"))
                snake-path (U String Nil) (if (< tool-input 0)
                  nil
                  (object-string-field events tool-input "file_path"))
                camel-path (U String Nil) (if (< tool-input 0)
                  nil
                  (object-string-field events tool-input "filePath"))]
            (->HookPayloadParsed
              (or tool "")
              command
              (if (some? snake-path) snake-path camel-path)
              (or session "nosession")))]
         [(JsonObjectEnd offset) (->HookPayloadRejected true)]
         [(JsonArrayStart offset) (->HookPayloadRejected true)]
         [(JsonArrayEnd offset) (->HookPayloadRejected true)]
         [(JsonKey offset value) (->HookPayloadRejected true)]
         [(JsonString offset value) (->HookPayloadRejected true)]
         [(JsonNumber offset lexeme) (->HookPayloadRejected true)]
         [(JsonBoolean offset value) (->HookPayloadRejected true)]
         [(JsonNull offset) (->HookPayloadRejected true)]))]))

(defn env-kill-switch-value [value (U String Nil)] KillSwitchEnv
  (if (or (nil? value) (= value ""))
    (->KillSwitchEnvUnset true)
    (if (or (= value "0") (= value "false"))
      (->KillSwitchEnvDecision false)
      (->KillSwitchEnvDecision true))))

(defn kill-switch-env [] KillSwitchEnv
  (env-kill-switch-value (System/getenv "AGENT_NO_AUTHORING_HOOKS")))

(defn activation-path [] (U String Nil)
  (let [explicit (U String Nil) (System/getenv "NORTH_AGENT_STATE_ROOT")]
    (cond
      (and (some? explicit) (not= explicit ""))
      (str explicit "/current/activation.json")
      :else
      (let [home (U String Nil) (System/getenv "HOME")]
        (if (or (nil? home) (= home ""))
          nil
          (str home "/.local/state/north/agents/current/activation.json"))))))

(defn activation-unit-active-events?
  [events (Vec json/JsonEvent)
   units-start Int
   wanted-kind String
   wanted-id String]
  Bool
  (loop [index Int (+ units-start 1)
         matched Bool false
         active Bool false
         valid Bool true]
    (if (or (>= index (count events)) (not valid))
      false
      (match (nth events index)
        [(JsonArrayEnd offset) (and matched active)]
        [(JsonObjectStart offset)
         (let [next Int (json-value-end events index)
               kind (U String Nil) (object-string-field events index "kind")
               id (U String Nil) (object-string-field events index "id")
               permission (U String Nil) (object-string-field events index "permission")
               unit-active (U Bool Nil) (object-bool-field events index "active")
               wanted Bool (and (= kind wanted-kind) (= id wanted-id))]
           (if (< next 0)
             false
             (recur next
               (if matched true wanted)
               (if wanted
                 (and (= permission "on") (= unit-active true))
                 active)
               (if (or (and matched wanted)
                       (and wanted (or (nil? permission) (nil? unit-active))))
                 false
                 true))))]
        [(JsonObjectEnd offset) false]
        [(JsonArrayStart offset) false]
        [(JsonKey offset value) false]
        [(JsonString offset value) false]
        [(JsonNumber offset lexeme) false]
        [(JsonBoolean offset value) false]
        [(JsonNull offset) false]))))

(defn activation-unit-active?
  [text String
   wanted-kind String
   wanted-id String]
  Bool
  (match (json/decode text)
    [(JsonDecodeError offset message) false]
    [(JsonDecoded events)
     (if (or (empty? events)
             (not= (json-value-end events 0) (count events)))
       false
       (match (nth events 0)
         [(JsonObjectStart offset)
          (let [schema (U String Nil) (object-string-field events 0 "schema")
                catalog-digest (U String Nil) (object-string-field events 0 "catalogDigest")
                generation-id (U String Nil) (object-string-field events 0 "generationId")
                units Int (object-array-field-start events 0 "units")]
            (and (= schema "north.agent-activation/v1")
                 (some? catalog-digest)
                 (some? generation-id)
                 (>= units 0)
                 (activation-unit-active-events?
                   events units wanted-kind wanted-id)))]
         [(JsonObjectEnd offset) false]
         [(JsonArrayStart offset) false]
         [(JsonArrayEnd offset) false]
         [(JsonKey offset value) false]
         [(JsonString offset value) false]
         [(JsonNumber offset lexeme) false]
         [(JsonBoolean offset value) false]
         [(JsonNull offset) false]))]))

(defn activation-guards-off? [] Bool
  (let [path (U String Nil) (activation-path)]
    (if (nil? path)
      true
      (match (host.fs/read-text-bounded path max-activation-bytes)
        [(host.fs/ReadTextBoundedOk text)
         (not (activation-unit-active? text "hook" "firn-system-policy"))]
        [(host.fs/ReadTextBoundedError errno) true]))))

(defn guards-off? [] Bool
  (match (kill-switch-env)
    [(KillSwitchEnvDecision off) off]
    [(KillSwitchEnvUnset token) (activation-guards-off?)]))

(defn safe-session-byte? [byte Int] Bool
  (or (and (>= byte 65) (<= byte 90))
      (and (>= byte 97) (<= byte 122))
      (and (>= byte 48) (<= byte 57))
      (= byte 95)
      (= byte 46)
      (= byte 45)))

(defn safe-session-id [session-id String] String
  (let [bytes (Vec Int) (utf8-encode session-id)]
    (utf8-decode
      (loop [index Int 0
             result (Vec Int) []]
        (if (>= index (count bytes))
          result
          (let [byte Int (nth bytes index)]
            (recur (+ index 1)
              (conj result (if (safe-session-byte? byte) byte 95)))))))))

(defn marker-path [session-id String] String
  (let [runtime (U String Nil) (System/getenv "XDG_RUNTIME_DIR")
        directory String (if (or (nil? runtime) (= runtime "")) "/tmp" runtime)]
    (str directory "/firn-system-policy." (safe-session-id session-id))))

(defn intro-unseen? [session-id String] Bool
  (let [marker String (marker-path session-id)]
    (match (host.fs/path-kind marker)
      [(host.fs/PathKindOk kind) false]
      [(host.fs/PathKindError errno)
       (if (not= errno 2)
         false
         (match (host.fs/write-text-atomic marker "")
           [(host.fs/WriteTextAtomicOk) true]
           [(host.fs/WriteTextAtomicError write-errno) true]))])))

(defn canonical-hook-path [path String] String
  (match (host.fs/real-path path)
    [(host.fs/RealPathOk canonical) canonical]
    [(host.fs/RealPathError errno) path]))

(defn additional-context-json [context String] String
  (str
    "{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\","
    "\"additionalContext\":" (json/encode-string context) "}}"))

(defn permission-deny-json [reason String] String
  (str
    "{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\","
    "\"permissionDecision\":\"deny\",\"permissionDecisionReason\":"
    (json/encode-string reason) "}}"))

(defn emit-decision [decision policy/HookDecision] Int
  (match decision
    [(HookPass token) 0]
    [(HookInject context) (do (println (additional-context-json context)) 0)]
    [(HookRefuse reason) (do (println (permission-deny-json reason)) 0)]))

(defn handle-payload [text String] Int
  (if (guards-off?)
    0
    (match (decode-hook-payload text)
      [(HookPayloadRejected token) 0]
      [(HookPayloadParsed tool command file-path session-id)
       (let [resolved-path (U String Nil) (if (some? file-path) (canonical-hook-path file-path) nil)
             intro-unseen Bool (if (and (some? resolved-path)
                      (or (= tool "Edit")
                          (= tool "Write")
                          (= tool "MultiEdit"))
                      (policy/firn-path? resolved-path))
               (intro-unseen? session-id)
               false)]
         (emit-decision
           (policy/decide-hook
             (policy/->RawHookEvent
               tool command resolved-path session-id false false intro-unseen))))])))

(defn -main [args (Vec String)] Int
  (match (host.stdin/read-text-bounded max-hook-bytes)
    [(host.stdin/ReadTextBoundedOk text) (handle-payload text)]
    [(host.stdin/ReadTextBoundedOverflow) 0]
    [(host.stdin/ReadTextBoundedError errno) 0]))
