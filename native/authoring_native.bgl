#lang beagle
(ns firn.authoring-native
  (:require [firn.authoring :as authoring]))

(def max-schema-bytes Int 67108864)
(def max-directory-entries Int 16384)

(defunion SchemaLoadResult
  (SchemaLoaded [(entries (Vec authoring/SchemaEntry))])
  (SchemaLoadRejected [(message String)]))

(defunion OperationResult
  OperationOk
  (OperationRejected [(message String)]))

(defunion SecretNamesResult
  (SecretNamesLoaded [(names (Vec String))])
  (SecretNamesRejected [(message String)]))

(defunion SecretSelectionResult
  (SecretSelected [(absolute String)])
  SecretMissing
  (SecretSelectionRejected [(message String)]))

(defn path [(root String) (relative String)] String
  (str root "/" relative))

(defn errno-message [(operation String) (relative String) (errno Int)] String
  (str "firn authoring: " operation " '" relative "': errno " errno "\n"))

(defn emit-error [(message String)] Int
  (do (host.stderr/write-text message) 1))

(defn repository-root [] (U String Nil)
  (let [(explicit (U String Nil)) (System/getenv "FIRN_REPO")]
    (if (some? explicit)
      explicit
      (let [(home (U String Nil)) (System/getenv "HOME")]
        (if (some? home)
          (str home "/code/nixos-config/main")
          nil)))))

(defn usage-error [] Int
  (do
    (host.stderr/write-text
      (str
        "Usage: firn module add <name>\n"
        "       firn template service <name>\n"
        "       firn template submodule <name>\n"
        "       firn template home <name>\n"
        "       firn template host <name>\n"
        "       firn secret list [all]\n"
        "       firn secret show <name>\n"
        "       firn secret edit <name>\n"))
    64))

(defn load-schema [(root String)] SchemaLoadResult
  (let [(relative String) ".beagle-cache/schema.json"
        (absolute String) (path root relative)]
    (match (host.fs/path-kind absolute)
      [(host.fs/PathKindError errno)
       (if (= errno 2)
         (->SchemaLoaded [])
         (->SchemaLoadRejected
           (errno-message "cannot inspect schema" relative errno)))]
      [(host.fs/PathKindOk kind)
       (if (not (or (= kind 1) (= kind 3)))
         (->SchemaLoadRejected
           (str "firn authoring: schema is not a file '" relative "'\n"))
         (match (host.fs/read-text-bounded absolute max-schema-bytes)
           [(host.fs/ReadTextBoundedError errno)
            (->SchemaLoadRejected
              (errno-message "cannot read schema" relative errno))]
           [(host.fs/ReadTextBoundedOk source)
            (match (authoring/schema-entries-from-json source)
              [(SchemaParsed entries) (->SchemaLoaded entries)]
              [(SchemaRejected message offset)
               (->SchemaLoadRejected
                 (str "firn authoring: invalid schema '" relative
                   "' at offset " offset ": " message "\n"))])]))])))

(defn load-schema-for-action
  [(root String) (action authoring/AuthoringAction)] SchemaLoadResult
  (match action
    [(TemplateService name) (load-schema root)]
    [(ModuleAdd name) (->SchemaLoaded [])]
    [(TemplateSubmodule name) (->SchemaLoaded [])]
    [(TemplateHome name) (->SchemaLoaded [])]
    [(TemplateHost name) (->SchemaLoaded [])]
    [(SecretList) (->SchemaLoaded [])]
    [(SecretShow name) (->SchemaLoaded [])]
    [(SecretEdit name) (->SchemaLoaded [])]))

(defn preflight-module-directory
  [(root String) (action authoring/AuthoringAction)] OperationResult
  (match action
    [(ModuleAdd name)
     (let [(relative String) (str "modules/" name)]
       (match (host.fs/path-kind (path root relative))
         [(host.fs/PathKindError errno)
          (if (= errno 2)
            (->OperationOk)
            (->OperationRejected
              (errno-message "cannot inspect" relative errno)))]
         [(host.fs/PathKindOk kind)
          (->OperationRejected
            (str "Module " name " already exists\n"))]))]
    [(TemplateService name) (->OperationOk)]
    [(TemplateSubmodule name) (->OperationOk)]
    [(TemplateHome name) (->OperationOk)]
    [(TemplateHost name) (->OperationOk)]
    [(SecretList) (->OperationOk)]
    [(SecretShow name) (->OperationOk)]
    [(SecretEdit name) (->OperationOk)]))

(defn preflight-targets
  [(root String)
   (targets (Vec authoring/AuthoringTarget))
   (index Int)]
  OperationResult
  (if (>= index (count targets))
    (->OperationOk)
    (let [(target authoring/AuthoringTarget) (nth targets index)
          (relative String) (authoring/authoringtarget-relative target)
          (absolute String) (path root relative)]
      (match (host.fs/path-kind absolute)
        [(host.fs/PathKindError errno)
         (if (= errno 2)
           (preflight-targets root targets (+ index 1))
           (->OperationRejected
             (errno-message "cannot inspect" relative errno)))]
        [(host.fs/PathKindOk kind)
         (->OperationRejected
           (str "firn scaffold: refusing to overwrite " absolute "\n"))]))))

(defn write-targets
  [(root String)
   (targets (Vec authoring/AuthoringTarget))
   (index Int)]
  OperationResult
  (if (>= index (count targets))
    (->OperationOk)
    (let [(target authoring/AuthoringTarget) (nth targets index)
          (relative String) (authoring/authoringtarget-relative target)
          (absolute String) (path root relative)]
      (match (host.fs/make-parent-directories absolute)
        [(host.fs/MakeParentDirectoriesError errno)
         (->OperationRejected
           (errno-message "cannot create parent for" relative errno))]
        [(host.fs/MakeParentDirectoriesOk)
         (match (host.fs/write-text-atomic absolute
                  (authoring/authoringtarget-contents target))
           [(host.fs/WriteTextAtomicError errno)
            (->OperationRejected
              (errno-message "cannot write" relative errno))]
           [(host.fs/WriteTextAtomicOk)
            (write-targets root targets (+ index 1))])]))))

(defn git-add-argv
  [(root String) (targets (Vec authoring/AuthoringTarget))] (Vec String)
  (loop [(index Int) 0
         (argv (Vec String)) ["git" "-C" root "add" "--"]]
    (if (>= index (count targets))
      argv
      (recur (+ index 1)
        (conj argv
          (path root
            (authoring/authoringtarget-relative (nth targets index))))))))

(defn child-status [(tool String) (status Int)] Int
  (if (< status 0)
    (do
      (host.stderr/write-text
        (str "firn authoring: cannot run " tool ": errno " (- status) "\n"))
      1)
    status))

(defn stage-created [(root String) (plan authoring/AuthoringPlan)] Int
  (let [(status Int)
        (host.process/run-inherit
          (git-add-argv root (authoring/authoringplan-targets plan)))]
    (if (= status 0)
      (do (print (authoring/authoringplan-success-output plan)) 0)
      (child-status "git" status))))

(defn run-scaffold [(root String) (action authoring/AuthoringAction)] Int
  (match (load-schema-for-action root action)
    [(SchemaLoadRejected message) (emit-error message)]
    [(SchemaLoaded entries)
     (match (authoring/plan-authoring action entries)
       [(AuthoringPlanRejected message) (emit-error message)]
       [(AuthoringPlanReady plan)
        (match (preflight-module-directory root action)
          [(OperationRejected message) (emit-error message)]
          [(OperationOk)
           (match (preflight-targets root
                    (authoring/authoringplan-targets plan) 0)
             [(OperationRejected message) (emit-error message)]
             [(OperationOk)
              (match (write-targets root
                       (authoring/authoringplan-targets plan) 0)
                [(OperationRejected message) (emit-error message)]
                [(OperationOk) (stage-created root plan)])])])])]))

(defn yaml-entry? [(entry String)] Bool
  (and (authoring/ends-with? entry ".yaml")
       (authoring/safe-secret-name?
         (authoring/strip-yaml-suffix entry))))

(defn load-secret-names-from
  [(root String)
   (entries (Vec String))
   (index Int)
   (names (Vec String))]
  SecretNamesResult
  (if (>= index (count entries))
    (->SecretNamesLoaded names)
    (let [(entry String) (nth entries index)]
      (if (not (yaml-entry? entry))
        (load-secret-names-from root entries (+ index 1) names)
        (let [(relative String) (str "secrets/" entry)]
          (match (host.fs/path-kind (path root relative))
            [(host.fs/PathKindError errno)
             (if (= errno 2)
               (load-secret-names-from root entries (+ index 1) names)
               (->SecretNamesRejected
                 (errno-message "cannot inspect" relative errno)))]
            [(host.fs/PathKindOk kind)
             (load-secret-names-from root entries (+ index 1)
               (if (= kind 1)
                 (conj names (authoring/strip-yaml-suffix entry))
                 names))]))))))

(defn load-secret-names [(root String)] SecretNamesResult
  (let [(relative String) "secrets"
        (absolute String) (path root relative)]
    (match (host.fs/list-directory-bounded absolute max-directory-entries)
      [(host.fs/ListDirectoryBoundedError errno)
       (if (or (= errno 2) (= errno 20))
         (->SecretNamesLoaded [])
         (->SecretNamesRejected
           (errno-message "cannot list" relative errno)))]
      [(host.fs/ListDirectoryBoundedOk entries)
       (load-secret-names-from root entries 0 [])])))

(defn secret-lines [(names (Vec String))] String
  (loop [(index Int) 0
         (text String) ""]
    (if (>= index (count names))
      text
      (recur (+ index 1) (str text (nth names index) "\n")))))

(defn missing-secret [(name String)] Int
  (emit-error (str "No secret file: secrets/" name ".yaml\n")))

(defn selected-secret-path [(root String) (name String)] SecretSelectionResult
  (match (load-secret-names root)
    [(SecretNamesRejected message) (->SecretSelectionRejected message)]
    [(SecretNamesLoaded names)
     (if (authoring/string-member? names name)
       (->SecretSelected (path root (str "secrets/" name ".yaml")))
       (->SecretMissing))]))

(defn run-secret-list [(root String)] Int
  (match (load-secret-names root)
    [(SecretNamesRejected message) (emit-error message)]
    [(SecretNamesLoaded names) (do (print (secret-lines names)) 0)]))

(defn run-secret-show [(root String) (name String)] Int
  (if (not (authoring/safe-secret-name? name))
    (emit-error "firn secret: invalid secret name\n")
    (match (selected-secret-path root name)
      [(SecretSelectionRejected message) (emit-error message)]
      [(SecretMissing) (missing-secret name)]
      [(SecretSelected absolute)
       (child-status "sops"
         (host.process/run-inherit ["sops" "-d" absolute]))])))

(defn regular-path? [(absolute String)] Bool
  (match (host.fs/path-kind absolute)
    [(host.fs/PathKindError errno) false]
    [(host.fs/PathKindOk kind) (= kind 1)]))

(defn run-secret-edit [(root String) (name String)] Int
  (if (not (authoring/safe-secret-name? name))
    (emit-error "firn secret: invalid secret name\n")
    (match (selected-secret-path root name)
      [(SecretSelectionRejected message) (emit-error message)]
      [(SecretMissing) (missing-secret name)]
      [(SecretSelected absolute)
       (let [(sops-status Int)
             (host.process/run-inherit ["sops" absolute])]
         (cond
           (not= sops-status 0) (child-status "sops" sops-status)
           (not (regular-path? absolute)) (missing-secret name)
           :else
           (let [(git-status Int)
                 (host.process/run-inherit
                   ["git" "-C" root "add" "--" absolute])]
             (if (= git-status 0)
               (do
                 (print (str "secrets/" name ".yaml (git added)\n"))
                 0)
               (child-status "git" git-status)))))])))

(defn run-action [(root String) (action authoring/AuthoringAction)] Int
  (match action
    [(ModuleAdd name) (run-scaffold root action)]
    [(TemplateService name) (run-scaffold root action)]
    [(TemplateSubmodule name) (run-scaffold root action)]
    [(TemplateHome name) (run-scaffold root action)]
    [(TemplateHost name) (run-scaffold root action)]
    [(SecretList) (run-secret-list root)]
    [(SecretShow name) (run-secret-show root name)]
    [(SecretEdit name) (run-secret-edit root name)]))

(defn -main [(args (Vec String))] Int
  (match (authoring/parse-authoring-argv args)
    [(InvalidAuthoringArgv argv) (usage-error)]
    [(ParsedAuthoring action)
     (let [(root (U String Nil)) (repository-root)]
       (if (nil? root)
         (emit-error "firn authoring: FIRN_REPO and HOME are not set\n")
         (run-action root action)))]))
