#lang beagle/js
(ns firn.inventory-test (:require [firn.inventory :as i] [firn.tag-resolve :as r]))

(defn make-module [seed Int name String tags (Vec String)] r/ModuleTags
  (r/->ModuleTags name tags [] []))

(defn alpha-config [seed Int] i/HostConfig
  (i/host-config (str "alpha" (if (= seed 0) "" seed) "-host")
    [(str "alpha" (if (= seed 0) "" seed))]
    [(str "beta" (if (= seed 0) "" seed))]))

(defn zeta-config [seed Int] i/HostConfig
  (i/host-config (str "zeta" (if (= seed 0) "" seed) "-host")
    [(str "beta" (if (= seed 0) "" seed))]
    []))

(defn repository [seed Int] i/InventoryRepository
  (i/->InventoryRepository
    [
      (make-module seed (str "orphan" (if (= seed 0) "" seed)) [])
      (make-module
        seed
        (str "gamma" (if (= seed 0) "" seed))
        [(str "desktop" (if (= seed 0) "" seed))])
      (make-module seed (str "alpha" (if (= seed 0) "" seed)) [])
      (make-module
        seed
        (str "beta" (if (= seed 0) "" seed))
        [(str "terminal" (if (= seed 0) "" seed))])]
    [
      (i/->InventoryHost
        (str "zeta" (if (= seed 0) "" seed) "-host")
        [(str "gamma" (if (= seed 0) "" seed))]
        (zeta-config seed))
      (i/->InventoryHost
        (str "alpha" (if (= seed 0) "" seed) "-host")
        []
        (alpha-config seed))]))

(defn case-canonical-paths-and-states [seed Int] Bool
  (let [config i/HostConfig (alpha-config seed)]
    (and
      (=
        (i/hostconfig-references config)
        [
          (str "alpha" (if (= seed 0) "" seed))
          (str "beta" (if (= seed 0) "" seed))])
      (= (i/state-paths config true) [(str "myConfig.modules.alpha" (if (= seed 0) "" seed))])
      (= (i/state-paths config false) [(str "myConfig.modules.beta" (if (= seed 0) "" seed))]))))

(defn case-live-closure [seed Int] Bool
  (let [(repo i/InventoryRepository) (repository seed)]
    (and
      (=
        (i/live-modules repo)
        [
          (str "alpha" (if (= seed 0) "" seed))
          (str "beta" (if (= seed 0) "" seed))
          (str "gamma" (if (= seed 0) "" seed))])
      (= (i/unused-modules repo) [(str "orphan" (if (= seed 0) "" seed))])
      (=
        (i/direct-hosts repo (str "beta" (if (= seed 0) "" seed)))
        [(str "alpha" (if (= seed 0) "" seed) "-host") (str "zeta" (if (= seed 0) "" seed) "-host")])
      (= (i/tag-hosts repo (str "beta" (if (= seed 0) "" seed))) [])
      (= (i/direct-hosts repo (str "gamma" (if (= seed 0) "" seed))) [])
      (=
        (i/tag-hosts repo (str "gamma" (if (= seed 0) "" seed)))
        [(str "zeta" (if (= seed 0) "" seed) "-host")]))))

(defn module-list-all-action? [seed Int action i/InventoryAction] Bool
  (match action
    [(ModuleListAll token) true]
    [(ModuleListUsed token) false]
    [(ModuleListUnused token) false]
    [(ModuleRefs name) false]
    [(ModuleStatus host) false]
    [(HostList token) false]
    [(HostStatus host) false]))

(defn module-status-host [seed Int action i/InventoryAction] String
  (match action
    [(ModuleListAll token) ""]
    [(ModuleListUsed token) ""]
    [(ModuleListUnused token) ""]
    [(ModuleRefs name) ""]
    [(ModuleStatus host) host]
    [(HostList token) ""]
    [(HostStatus host) ""]))

(defn host-status-host [seed Int action i/InventoryAction] String
  (match action
    [(ModuleListAll token) ""]
    [(ModuleListUsed token) ""]
    [(ModuleListUnused token) ""]
    [(ModuleRefs name) ""]
    [(ModuleStatus host) ""]
    [(HostList token) ""]
    [(HostStatus host) host]))

(defn case-argv-grammar [seed Int] Bool
  (and
    (match (i/parse-inventory-argv ["module" "list"] (str "alpha" (if (= seed 0) "" seed) "-host"))
      [(ParsedInventory action) (module-list-all-action? seed action)]
      [(InvalidInventoryArgv argv) false])
    (match (i/parse-inventory-argv
       ["module" "status" "all"]
       (str "alpha" (if (= seed 0) "" seed) "-host"))
      [
        (ParsedInventory action)
        (= (module-status-host seed action) (str "alpha" (if (= seed 0) "" seed) "-host"))]
      [(InvalidInventoryArgv argv) false])
    (match (i/parse-inventory-argv
       ["host" "status" (str "zeta" (if (= seed 0) "" seed) "-host")]
       (str "alpha" (if (= seed 0) "" seed) "-host"))
      [
        (ParsedInventory action)
        (= (host-status-host seed action) (str "zeta" (if (= seed 0) "" seed) "-host"))]
      [(InvalidInventoryArgv argv) false])
    (match (i/parse-inventory-argv
       ["module" "list" "stale"]
       (str "alpha" (if (= seed 0) "" seed) "-host"))
      [(ParsedInventory action) false]
      [(InvalidInventoryArgv argv) true])))

(js/export
  (defn run-scenarios [] Int
    (if (and
      (case-canonical-paths-and-states 0)
      (case-live-closure 0)
      (case-argv-grammar 0))
      0
      (do (println "FAIL inventory scenarios") 1))))
