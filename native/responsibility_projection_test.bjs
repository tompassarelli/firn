#lang beagle/js
(ns firn.responsibility-projection-test
  (:require [firn.inventory :as inventory]
            [firn.inventory-family :as inventory-family]
            [firn.responsibility-projection :as projection]
            [firn.tag-resolve :as tags]
            [firn.tag-resolve-family :as tag-family]))

(def max-source-bytes Int 1048576)

(def source String
  (str
    "#lang beagle/nix\n"
    "(ns responsibilities)\n"
    "(def machine-responsibility-triples Any\n"
    "  [[:member_of :member_of :relationships]\n"
    "   [:has_responsibility :member_of :relationships]\n"
    "   [:depends_on :member_of :relationships]\n"
    "   [:requires_capability :member_of :relationships]\n"
    "   [:provides_capability :member_of :relationships]\n"
    "   [:requires_software :member_of :relationships]\n"
    "   [:is_realized_by :member_of :relationships]\n"
    "   [:is_realized_in :member_of :relationships]\n"
    "   [:has_criticality :member_of :relationships]\n"
    "   [:has_lifecycle :member_of :relationships]\n"
    "   [:must_realize :member_of :relationships]\n"
    "   [:whiterabbit :has_responsibility :creative-workstation]\n"
    "   [:creative-workstation :depends_on :three-d-workflow]\n"
    "   [:creative-workstation :depends_on :notes-workflow]\n"
    "   [:three-d-workflow :requires_capability :three-d-authoring]\n"
    "   [:notes-workflow :requires_capability :knowledge-authoring]\n"
    "   [:three-d-workflow :requires_software :blender]\n"
    "   [:notes-workflow :requires_software :obsidian]\n"
    "   [:blender :provides_capability :three-d-authoring]\n"
    "   [:obsidian :provides_capability :knowledge-authoring]\n"
    "   [:blender :is_realized_by :blender-module]\n"
    "   [:obsidian :is_realized_by :obsidian-module]\n"
    "   [:three-d-workflow :is_realized_in :environment]\n"
    "   [:notes-workflow :is_realized_in :environment]\n"
    "   [:three-d-workflow :has_criticality :interactive]\n"
    "   [:notes-workflow :has_criticality :interactive]\n"
    "   [:whiterabbit :has_responsibility :remote-access-service]\n"
    "   [:remote-access-service :requires_capability :remote-access]\n"
    "   [:remote-access-service :requires_software :remote-access-runtime]\n"
    "   [:remote-access-runtime :provides_capability :remote-access]\n"
    "   [:remote-access-runtime :is_realized_by :remote-access-runtime-module]\n"
    "   [:remote-access-service :is_realized_in :boot]\n"
    "   [:remote-access-service :has_criticality :essential]\n"
    "   [:remote-access-service :has_lifecycle :long-lived-system-service]])\n"))

(defn expected-obligations [] (Vec projection/Triple)
  [(projection/triple :whiterabbit :must_realize (keyword "remote-access-runtime"))
   (projection/triple :whiterabbit :must_realize :blender)
   (projection/triple :whiterabbit :must_realize :obsidian)])

(defn projection-behavior? [] Bool
  (match (projection/project-source source)
    [(ProjectionRejected message offset) false]
    [(ProjectionParsed propositions)
     (let [explanations (Vec projection/RealizationExplanation) (projection/explain-machine propositions :whiterabbit)
           baseline projection/BootCouplingBudget (projection/assess-boot-coupling
             propositions :whiterabbit ["remote-access-runtime"])
           blender-coupled projection/BootCouplingBudget (projection/assess-boot-coupling
             propositions :whiterabbit ["remote-access-runtime" "blender"])
           dev-lifecycle (Vec projection/Triple) (into propositions
             [(projection/triple :whiterabbit :has_responsibility (keyword "project-build"))
              (projection/triple (keyword "project-build") :requires_software (keyword "project-toolchain"))
              (projection/triple (keyword "project-build") :is_realized_in :boot)
              (projection/triple (keyword "project-build") :has_criticality :interactive)
              (projection/triple (keyword "project-build") :has_lifecycle :development)
              (projection/triple (keyword "project-toolchain") :is_realized_by
                (keyword "project-toolchain-module"))])
           unowned (Vec projection/Triple) (into propositions
             [(projection/triple :whiterabbit :has_responsibility (keyword "unowned-build"))
              (projection/triple (keyword "unowned-build") :requires_software (keyword "unowned-toolchain"))
              (projection/triple (keyword "unowned-build") :is_realized_in :boot)
              (projection/triple (keyword "unowned-build") :has_criticality :interactive)
              (projection/triple (keyword "unowned-toolchain") :is_realized_by
                (keyword "unowned-toolchain-module"))])
           inverted (Vec projection/Triple) (into propositions
             [(projection/triple :whiterabbit :has_responsibility (keyword "boot-workflow"))
              (projection/triple (keyword "boot-workflow") :is_realized_in :boot)
              (projection/triple (keyword "boot-workflow") :depends_on (keyword "three-d-workflow"))])
           incomplete (Vec projection/Triple) (conj propositions
             (projection/triple (keyword "three-d-workflow") :requires_software :unrealized))
           uncovered (Vec projection/Triple) (conj propositions
             (projection/triple (keyword "three-d-workflow") :requires_capability
               (keyword "missing-capability")))]
       (and (= (projection/realization-obligations
                 propositions :whiterabbit)
               (expected-obligations))
            (and (= 3 (count explanations))
                 (empty?
                   (projection/uncovered-capabilities
                     propositions :whiterabbit)))
            (and
              (projection/boot-coupling-budget-passes? baseline)
              (not
                (projection/boot-coupling-budget-passes? blender-coupled)))
            (and
              (not
                (projection/boot-coupling-budget-passes?
                  (projection/assess-boot-coupling
                    dev-lifecycle :whiterabbit
                    ["remote-access-runtime" "project-toolchain"])))
              (not
                (projection/boot-coupling-budget-passes?
                  (projection/assess-boot-coupling
                    unowned :whiterabbit
                    ["remote-access-runtime" "unowned-toolchain"]))))
            (and
              (not
                (projection/boot-coupling-budget-passes?
                  (projection/assess-boot-coupling
                    inverted :whiterabbit ["remote-access-runtime"])))
              (not
                (projection/boot-coupling-budget-passes?
                  (projection/assess-boot-coupling
                    incomplete :whiterabbit ["remote-access-runtime"]))))
            (not
              (projection/boot-coupling-budget-passes?
                (projection/assess-boot-coupling
                  uncovered :whiterabbit ["remote-access-runtime"])))))]))

(defn module-names-from-paths [paths (Vec String)] (Vec String)
  (reduce
    (fn
      [names (Vec String)
       path String] (Vec String)
      (conj names (inventory/module-name-from-path path)))
    []
    paths))

(defn active-boot-modules
  [modules (Vec tags/ModuleTags)
   host inventory/InventoryHost] (Vec String)
  (let [config inventory/HostConfig (inventory/inventoryhost-config host)
        direct-on (Vec String) (module-names-from-paths (inventory/state-paths config true))
        direct-off (Vec String) (module-names-from-paths (inventory/state-paths config false))
        tagged (Vec String) (inventory/tag-active
          (inventory/->InventoryRepository modules [host]) host)]
    (tags/remove-strings (tags/union-strings tagged direct-on) direct-off)))

(defn live-budget-passes? [bridge Any root String] Bool
  (let [read-result Any
        (.readText bridge
          (str root "/hosts/whiterabbit/responsibilities.bnix")
          max-source-bytes)
        errno Int (.status bridge read-result)]
    (if (not (= errno 0))
      false
      (let [responsibility-source String (.value bridge read-result)]
     (match (projection/project-source responsibility-source)
       [(ProjectionRejected message offset) false]
       [(ProjectionParsed propositions)
        (match (tag-family/load-modules bridge root)
          [(ModulesRejected message) false]
          [(ModulesLoaded modules)
           (match
             (inventory-family/load-inventory-host bridge root "whiterabbit")
             [(InventoryHostRejected message) false]
             [(InventoryHostLoaded host)
              (projection/boot-coupling-budget-passes?
                (projection/assess-boot-coupling
                  propositions
                  :whiterabbit
                  (active-boot-modules modules host)))])])])))))

(js/export
 (defn test [bridge Any args (Vec String)] Int
  (if (and (= 1 (count args))
           (and (projection-behavior?)
                (live-budget-passes? bridge (nth args 0))))
    0
    1)))
