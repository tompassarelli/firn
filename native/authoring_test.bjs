#lang beagle/js
(ns firn.authoring-test
  (:require [firn.authoring :as a]))

(defrecord TestResult [(name String) (passed Bool)])

(defn action-kind [(action a/AuthoringAction)] String
  (match action
    [(ModuleAdd name) "module-add"]
    [(TemplateService name) "template-service"]
    [(TemplateSubmodule name) "template-submodule"]
    [(TemplateHome name) "template-home"]
    [(TemplateHost name) "template-host"]
    [(SecretList token) "secret-list"]
    [(SecretShow name) "secret-show"]
    [(SecretEdit name) "secret-edit"]))

(defn action-name [(action a/AuthoringAction)] String
  (match action
    [(ModuleAdd name) name]
    [(TemplateService name) name]
    [(TemplateSubmodule name) name]
    [(TemplateHome name) name]
    [(TemplateHost name) name]
    [(SecretList token) ""]
    [(SecretShow name) name]
    [(SecretEdit name) name]))

(defn case-argv-grammar [] Bool
  (and
    (match (a/parse-authoring-argv ["module" "add" "sample-tool"])
      [(ParsedAuthoring action)
       (and (= (action-kind action) "module-add")
            (= (action-name action) "sample-tool"))]
      [(InvalidAuthoringArgv argv) false])
    (match (a/parse-authoring-argv ["template" "service" "openssh"])
      [(ParsedAuthoring action)
       (and (= (action-kind action) "template-service")
            (= (action-name action) "openssh"))]
      [(InvalidAuthoringArgv argv) false])
    (match (a/parse-authoring-argv ["template" "submodule" "sample"])
      [(ParsedAuthoring action)
       (and (= (action-kind action) "template-submodule")
            (= (action-name action) "sample"))]
      [(InvalidAuthoringArgv argv) false])
    (match (a/parse-authoring-argv ["template" "home" "sample"])
      [(ParsedAuthoring action)
       (and (= (action-kind action) "template-home")
            (= (action-name action) "sample"))]
      [(InvalidAuthoringArgv argv) false])
    (match (a/parse-authoring-argv ["template" "host" "sample-host"])
      [(ParsedAuthoring action)
       (and (= (action-kind action) "template-host")
            (= (action-name action) "sample-host"))]
      [(InvalidAuthoringArgv argv) false])
    (match (a/parse-authoring-argv ["secret" "list"])
      [(ParsedAuthoring action)
       (= (action-kind action) "secret-list")]
      [(InvalidAuthoringArgv argv) false])
    (match (a/parse-authoring-argv ["secret" "list" "all"])
      [(ParsedAuthoring action)
       (= (action-kind action) "secret-list")]
      [(InvalidAuthoringArgv argv) false])
    (match (a/parse-authoring-argv ["secret" "show" "alpha"])
      [(ParsedAuthoring action)
       (and (= (action-kind action) "secret-show")
            (= (action-name action) "alpha"))]
      [(InvalidAuthoringArgv argv) false])
    (match (a/parse-authoring-argv ["secret" "edit" "alpha"])
      [(ParsedAuthoring action)
       (and (= (action-kind action) "secret-edit")
            (= (action-name action) "alpha"))]
      [(InvalidAuthoringArgv argv) false])
    (match (a/parse-authoring-argv ["secret" "list" "stale"])
      [(ParsedAuthoring action) false]
      [(InvalidAuthoringArgv argv) true])
    (match (a/parse-authoring-argv ["host" "gen" "whiterabbit"])
      [(ParsedAuthoring action) false]
      [(InvalidAuthoringArgv argv) true])))

(defn case-name-refusal [] Bool
  (and
    (a/safe-authoring-name? "sample-tool")
    (a/safe-authoring-name? "g203-led")
    (not (a/safe-authoring-name? ""))
    (not (a/safe-authoring-name? "."))
    (not (a/safe-authoring-name? ".."))
    (not (a/safe-authoring-name? "../escape"))
    (not (a/safe-authoring-name? "nested/name"))
    (not (a/safe-authoring-name? "nested\\name"))
    (not (a/safe-authoring-name? "Upper"))
    (not (a/safe-authoring-name? "white space"))
    (a/safe-secret-name? "alpha")
    (a/safe-secret-name? "alpha beta")
    (not (a/safe-secret-name? ""))
    (not (a/safe-secret-name? "."))
    (not (a/safe-secret-name? ".."))
    (not (a/safe-secret-name? "/"))
    (not (a/safe-secret-name? "a/b"))
    (not (a/safe-secret-name? "\\"))
    (not (a/safe-secret-name? "a\\b"))
    (not (a/safe-secret-name? (utf8-decode [0])))
    (match (a/plan-authoring (a/->ModuleAdd "../escape") [])
      [(AuthoringPlanReady plan) false]
      [(AuthoringPlanRejected message)
       true])))

(defn case-schema-json-name-authority [] Bool
  (match (a/schema-entries-from-json
           (str
             "[{\"inner\":{\"t\":\"submodule\"},"
             "\"p\":\"services.openssh.stale\","
             "\"name\":\"services.openssh.port\",\"t\":\"int\"},"
             "{\"name\":\"services.openssh.banner\"}]") )
    [(SchemaRejected message offset) false]
    [(SchemaParsed entries)
     (and (= (a/schemaentry-name (nth entries 0))
             "services.openssh.port")
          (= (a/schemaentry-type (nth entries 0)) "int")
          (= (a/schemaentry-name (nth entries 1))
             "services.openssh.banner")
          (= (a/schemaentry-type (nth entries 1)) "?"))]))

(defn cases [] (Vec TestResult)
  [(->TestResult "argv-grammar" (case-argv-grammar))
   (->TestResult "name-refusal" (case-name-refusal))
   (->TestResult "schema-json-name-authority"
     (case-schema-json-name-authority))])

(js/export
  (defn run-tests [] Int
  (let [(results (Vec TestResult)) (cases)]
    (loop [(index Int) 0
           (failures Int) 0]
      (if (>= index (count results))
        failures
        (let [(result TestResult) (nth results index)]
          (do
            (println
              (str (if (testresult-passed result) "PASS " "FAIL ")
                (testresult-name result)))
            (recur (+ index 1)
              (if (testresult-passed result)
                failures
                (+ failures 1))))))))))
