#lang beagle/js
(ns firn.authoring-test (:require [firn.authoring :as a]))

(defn action-kind [seed Int action a/AuthoringAction] String
  (match action
    [(ModuleAdd name) "module-add"]
    [(TemplateService name) "template-service"]
    [(TemplateSubmodule name) "template-submodule"]
    [(TemplateHome name) "template-home"]
    [(TemplateHost name) "template-host"]
    [(SecretList token) "secret-list"]
    [(SecretShow name) "secret-show"]
    [(SecretEdit name) "secret-edit"]))

(defn action-name [seed Int action a/AuthoringAction] String
  (match action
    [(ModuleAdd name) name]
    [(TemplateService name) name]
    [(TemplateSubmodule name) name]
    [(TemplateHome name) name]
    [(TemplateHost name) name]
    [(SecretList token) ""]
    [(SecretShow name) name]
    [(SecretEdit name) name]))

(defn case-argv-grammar [seed Int] Bool
  (and
    (match (a/parse-authoring-argv ["module" "add" (str "sample-tool" (if (= seed 0) "" seed))])
      [
        (ParsedAuthoring action)
        (and
          (= (action-kind seed action) "module-add")
          (= (action-name seed action) (str "sample-tool" (if (= seed 0) "" seed))))]
      [(InvalidAuthoringArgv argv) false])
    (match (a/parse-authoring-argv ["template" "service" (str "openssh" (if (= seed 0) "" seed))])
      [
        (ParsedAuthoring action)
        (and
          (= (action-kind seed action) "template-service")
          (= (action-name seed action) (str "openssh" (if (= seed 0) "" seed))))]
      [(InvalidAuthoringArgv argv) false])
    (match (a/parse-authoring-argv ["template" "submodule" (str "sample" (if (= seed 0) "" seed))])
      [
        (ParsedAuthoring action)
        (and
          (= (action-kind seed action) "template-submodule")
          (= (action-name seed action) (str "sample" (if (= seed 0) "" seed))))]
      [(InvalidAuthoringArgv argv) false])
    (match (a/parse-authoring-argv ["template" "home" (str "sample" (if (= seed 0) "" seed))])
      [
        (ParsedAuthoring action)
        (and
          (= (action-kind seed action) "template-home")
          (= (action-name seed action) (str "sample" (if (= seed 0) "" seed))))]
      [(InvalidAuthoringArgv argv) false])
    (match (a/parse-authoring-argv ["template" "host" (str "sample-host" (if (= seed 0) "" seed))])
      [
        (ParsedAuthoring action)
        (and
          (= (action-kind seed action) "template-host")
          (= (action-name seed action) (str "sample-host" (if (= seed 0) "" seed))))]
      [(InvalidAuthoringArgv argv) false])
    (match (a/parse-authoring-argv ["secret" "list"])
      [(ParsedAuthoring action) (= (action-kind seed action) "secret-list")]
      [(InvalidAuthoringArgv argv) false])
    (match (a/parse-authoring-argv ["secret" "list" "all"])
      [(ParsedAuthoring action) (= (action-kind seed action) "secret-list")]
      [(InvalidAuthoringArgv argv) false])
    (match (a/parse-authoring-argv ["secret" "show" (str "alpha" (if (= seed 0) "" seed))])
      [
        (ParsedAuthoring action)
        (and
          (= (action-kind seed action) "secret-show")
          (= (action-name seed action) (str "alpha" (if (= seed 0) "" seed))))]
      [(InvalidAuthoringArgv argv) false])
    (match (a/parse-authoring-argv ["secret" "edit" (str "alpha" (if (= seed 0) "" seed))])
      [
        (ParsedAuthoring action)
        (and
          (= (action-kind seed action) "secret-edit")
          (= (action-name seed action) (str "alpha" (if (= seed 0) "" seed))))]
      [(InvalidAuthoringArgv argv) false])
    (match (a/parse-authoring-argv ["secret" "list" "stale"])
      [(ParsedAuthoring action) false]
      [(InvalidAuthoringArgv argv) true])
    (match (a/parse-authoring-argv ["host" "gen" "whiterabbit"])
      [(ParsedAuthoring action) false]
      [(InvalidAuthoringArgv argv) true])))

(defn case-name-refusal [seed Int] Bool
  (and
    (a/safe-authoring-name? (str "sample-tool" (if (= seed 0) "" seed)))
    (a/safe-authoring-name? (str "g203-led" (if (= seed 0) "" seed)))
    (not (a/safe-authoring-name? ""))
    (not (a/safe-authoring-name? "."))
    (not (a/safe-authoring-name? ".."))
    (not (a/safe-authoring-name? "../escape"))
    (not (a/safe-authoring-name? "nested/name"))
    (not (a/safe-authoring-name? "nested\\name"))
    (not (a/safe-authoring-name? (str "Upper" (if (= seed 0) "" seed))))
    (not (a/safe-authoring-name? "white space"))
    (a/safe-secret-name? (str "alpha" (if (= seed 0) "" seed)))
    (a/safe-secret-name? (str "alpha" (if (= seed 0) "" seed) " beta"))
    (not (a/safe-secret-name? ""))
    (not (a/safe-secret-name? "."))
    (not (a/safe-secret-name? ".."))
    (not (a/safe-secret-name? "/"))
    (not (a/safe-secret-name? "a/b"))
    (not (a/safe-secret-name? "\\"))
    (not (a/safe-secret-name? "a\\b"))
    (not (a/safe-secret-name? (utf8-decode [0])))
    (match (a/plan-authoring (a/->ModuleAdd "../escape") [])
      [(AuthoringPlanReady plan) false]
      [(AuthoringPlanRejected message) true])))

(defn case-schema-json-name-authority [seed Int] Bool
  (match (a/schema-entries-from-json
     (str
       "[{\"inner\":{\"t\":\"submodule\"},"
       (str "\"p\":\"services.openssh" (if (= seed 0) "" seed) ".stale\",")
       (str "\"name\":\"services.openssh" (if (= seed 0) "" seed) ".port\",\"t\":\"int\"},")
       (str "{\"name\":\"services.openssh" (if (= seed 0) "" seed) ".banner\"}]")))
    [(SchemaRejected message offset) false]
    [
      (SchemaParsed entries)
      (and
        (=
          (a/schemaentry-name (nth entries 0))
          (str "services.openssh" (if (= seed 0) "" seed) ".port"))
        (= (a/schemaentry-type (nth entries 0)) "int")
        (=
          (a/schemaentry-name (nth entries 1))
          (str "services.openssh" (if (= seed 0) "" seed) ".banner"))
        (= (a/schemaentry-type (nth entries 1)) "?"))]))

(js/export
  (defn run-properties [samples Int] Int
    (if (<= samples 0)
      1
      (loop [index Int 0 seed Int 0]
        (if (>= index samples)
          0
          (if (and
             (case-argv-grammar seed)
             (case-name-refusal seed)
             (case-schema-json-name-authority seed))
            (recur (+ index 1) (if (= seed 0) 73421 (mod (* seed 48271) 2147483647)))
            (do (println (str "FAIL firn.authoring-test property seed=" seed)) 1)))))))
