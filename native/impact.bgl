#lang beagle
(ns firn.impact)

(defrecord DryRunResult
  [exit-status Int
   output String])

(defrecord ImpactInput
  [host String
   dry-run DryRunResult
   current-system-derivations (Vec String)])

(defrecord ExpensiveBuild
  [name String
   estimate String])

(defrecord RebuildImpact
  [builds (Vec String)
   fetches (Vec String)
   notable-builds (Vec ExpensiveBuild)
   new-packages (Vec String)])

(defunion ImpactResult
  (ImpactReady
    [impact RebuildImpact
     text String])
  (ImpactFailed [text String]))

(defn split-lines [text String] (Vec String)
  (loop [(index Int) 0
         (start Int) 0
         (lines (Vec String)) []]
    (if (>= index (count text))
      (if (< start (count text))
        (conj lines (subs text start (count text)))
        lines)
      (if (= (subs text index (+ index 1)) "\n")
        (recur (+ index 1) (+ index 1) (conj lines (subs text start index)))
        (recur (+ index 1) start lines)))))

(defn starts-with?
  [text String
   prefix String]
  Bool
  (and (>= (count text) (count prefix))
       (= (subs text 0 (count prefix)) prefix)))

(defn text-contains?
  [text String
   needle String]
  Bool
  (some? (str/index-of text needle)))

(defn string-member?
  [values (Vec String)
   candidate String]
  Bool
  (loop [(index Int) 0]
    (if (>= index (count values))
      false
      (if (= candidate (nth values index))
        true
        (recur (+ index 1))))))

(defn store-path? [line String] Bool
  (starts-with? (str/trim line) "/nix/store/"))

(defn build-header? [line String] Bool
  (or (text-contains? line " derivations will be built")
      (text-contains? line "will be built:")))

(defn fetch-header? [line String] Bool
  (or (text-contains? line " paths will be fetched")
      (text-contains? line "will be fetched")))

(defn path-basename [path String] String
  (loop [(index Int) 0
         (start Int) 0]
    (if (>= index (count path))
      (subs path start (count path))
      (if (= (subs path index (+ index 1)) "/")
        (recur (+ index 1) (+ index 1))
        (recur (+ index 1) start)))))

(defn drop-suffix
  [text String
   suffix String]
  String
  (if (and (>= (count text) (count suffix))
           (= (subs text (- (count text) (count suffix)) (count text)) suffix))
    (subs text 0 (- (count text) (count suffix)))
    text))

(defn store-name [path String] String
  (let [(basename String) (drop-suffix (path-basename path) ".drv")
        (dash (U Int Nil)) (str/index-of basename "-")]
    (if (nil? dash) basename (subs basename (+ dash 1) (count basename)))))

(defn planned-impact [output String] RebuildImpact
  (let [(lines (Vec String)) (split-lines output)]
    (loop [(index Int) 0
           (section String) ""
           (builds (Vec String)) []
           (fetches (Vec String)) []]
      (if (>= index (count lines))
        (->RebuildImpact builds fetches [] [])
        (let [(line String) (nth lines index)
              (cleaned String) (str/trim line)]
          (cond
            (build-header? line)
            (recur (+ index 1) "build" builds fetches)

            (fetch-header? line)
            (recur (+ index 1) "fetch" builds fetches)

            (= line "")
            (recur (+ index 1) "" builds fetches)

            (and (= section "build") (store-path? line))
            (recur (+ index 1) section (conj builds cleaned) fetches)

            (and (= section "fetch") (store-path? line))
            (recur (+ index 1) section builds (conj fetches cleaned))

            :else
            (recur (+ index 1) section builds fetches)))))))

(defn ascii-lower? [character String] Bool
  (let [(bytes (Vec Int)) (utf8-encode character)]
    (and (= (count character) 1)
         (>= (nth bytes 0) 97)
         (<= (nth bytes 0) 122))))

(defn expensive-estimate [name String] (U String Nil)
  (cond
    (text-contains? name "firefox") "~30-45 min"
    (text-contains? name "librewolf") "~30-45 min"
    (text-contains? name "chromium") "~60 min"
    (starts-with? name "linux-") "~15-20 min"
    (starts-with? name "ghc-") "~30 min"
    (starts-with? name "llvm-") "~20 min"
    (starts-with? name "clang-") "~20 min"
    (starts-with? name "rustc-") "~20 min"
    (starts-with? name "rust-") "~20 min"
    (starts-with? name "nodejs-") "~5 min"
    (starts-with? name "qt6-") "~15 min"
    (text-contains? name "webkit") "~30 min"
    :else nil))

(defn expensive-builds [builds (Vec String)] (Vec ExpensiveBuild)
  (loop [(index Int) 0
         (result (Vec ExpensiveBuild)) []]
    (if (>= index (count builds))
      result
      (let [(name String) (store-name (nth builds index))
            (estimate (U String Nil)) (expensive-estimate name)]
        (recur (+ index 1)
          (if (nil? estimate)
            result
            (conj result (->ExpensiveBuild name estimate))))))))

(defn internal-fetch? [name String] Bool
  (or (text-contains? name "source")
      (text-contains? name "patch")
      (text-contains? name "hook")
      (text-contains? name "setup")
      (text-contains? name "wrapper")
      (text-contains? name "env")
      (text-contains? name "builder")))

(defn current-system-has?
  [derivations (Vec String)
   name String]
  Bool
  (loop [(index Int) 0]
    (if (>= index (count derivations))
      false
      (if (text-contains? (nth derivations index) name)
        true
        (recur (+ index 1))))))

(defn new-packages
  [fetches (Vec String)
   current-system-derivations (Vec String)]
  (Vec String)
  (loop [(index Int) 0
         (packages (Vec String)) []]
    (if (>= index (count fetches))
      packages
      (let [(name String) (store-name (nth fetches index))]
        (recur (+ index 1)
          (if (and (> (count name) 0)
                   (ascii-lower? (subs name 0 1))
                   (not (internal-fetch? name))
                   (not (current-system-has? current-system-derivations name)))
            (conj packages name)
            packages))))))

(defn enrich-impact
  [impact RebuildImpact
   current-system-derivations (Vec String)]
  RebuildImpact
  (->RebuildImpact
    (rebuildimpact-builds impact)
    (rebuildimpact-fetches impact)
    (expensive-builds (rebuildimpact-builds impact))
    (new-packages (rebuildimpact-fetches impact) current-system-derivations)))

(defn build-lines
  [builds (Vec ExpensiveBuild)
   index Int]
  String
  (if (>= index (count builds))
    ""
    (let [(build ExpensiveBuild) (nth builds index)]
      (str "    " (expensivebuild-name build) " ("
        (expensivebuild-estimate build) ", local build)\n"
        (build-lines builds (+ index 1))))))

(defn package-lines
  [packages (Vec String)
   index Int]
  String
  (if (>= index (count packages))
    ""
    (str "    " (nth packages index) " (binary cache hit)\n"
      (package-lines packages (+ index 1)))))

(defn estimated-line [impact RebuildImpact] String
  (cond
    (> (count (rebuildimpact-notable-builds impact)) 0)
    "  Estimated: has expensive local builds — expect significant wait time\n"

    (> (count (rebuildimpact-builds impact)) 10)
    "  Estimated: many small builds, ~5-15 min wall time\n"

    (> (count (rebuildimpact-builds impact)) 0)
    "  Estimated: minor builds + cache hits, ~2-5 min wall time\n"

    :else
    "  Estimated: all cache hits, ~1-2 min wall time\n"))

(defn render-impact
  [host String
   impact RebuildImpact]
  String
  (if (and (= 0 (count (rebuildimpact-builds impact)))
           (= 0 (count (rebuildimpact-fetches impact))))
    (str "Rebuild impact (" host "):\n"
      "  System is up to date — nothing to build or fetch.\n")
    (str
      "Rebuild impact (" host "):\n"
      (if (> (count (rebuildimpact-builds impact)) 0)
        (str "  * " (count (rebuildimpact-builds impact))
          " derivation(s) to build\n")
        "")
      (if (> (count (rebuildimpact-fetches impact)) 0)
        (str "  * " (count (rebuildimpact-fetches impact))
          " path(s) to fetch from cache\n")
        "")
      "\n"
      (if (> (count (rebuildimpact-notable-builds impact)) 0)
        (str "  Notable rebuilds:\n"
          (build-lines (rebuildimpact-notable-builds impact) 0) "\n")
        "")
      (if (and (> (count (rebuildimpact-new-packages impact)) 0)
               (<= (count (rebuildimpact-new-packages impact)) 10))
        (str "  New packages:\n"
          (package-lines (rebuildimpact-new-packages impact) 0) "\n")
        "")
      (estimated-line impact))))

(defn failure-tail [output String] String
  (let [(lines (Vec String)) (split-lines output)
        (start Int) (max 0 (- (count lines) 5))]
    (loop [(index Int) start
           (text String) ""]
      (if (>= index (count lines))
        text
        (recur (+ index 1) (str text (nth lines index) "\n"))))))

(defn interpret [input ImpactInput] ImpactResult
  (let [(dry-run DryRunResult) (impactinput-dry-run input)]
    (if (not= 0 (dryrunresult-exit-status dry-run))
      (->ImpactFailed
        (str "firn impact: dry-run failed (eval error?)\n"
          (failure-tail (dryrunresult-output dry-run))))
      (let [(planned RebuildImpact) (planned-impact (dryrunresult-output dry-run))
            (impact RebuildImpact)
            (enrich-impact planned (impactinput-current-system-derivations input))]
        (->ImpactReady impact (render-impact (impactinput-host input) impact))))))
