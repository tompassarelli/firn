#lang beagle/js
(ns firn.rebuild-test
  (:require [clojure.string :as str]
            [firn.rebuild :as r]))

(def revision String "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")

(defn target [overridden Bool] r/Target
  (let [snapshot r/Snapshot (r/make-snapshot "/repo" revision "native-rebuild-workflow")]
    (if overridden (r/make-system-target snapshot "/system" "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
      (r/make-target snapshot))))

(defn plan [platform r/Platform overridden Bool mode Int] (Vec r/ArgvEffect)
  (let [value r/Target (target overridden) path String "/nix/store/system"]
    (cond
      (= mode 1) (into (r/exact-path-profile-effects path)
                   [(r/system-profile-resolve-effect) (r/activate-verified-closure-effect path)])
      (= mode 2) (into [(r/generation-resolve-effect "40") (r/generation-closure-check-effect path)]
                   (r/rollback-activation-effects "40" path))
      :else (into (into (r/preparation-effects value "fixture" platform "/snapshot")
                       (r/activation-effects value "fixture" platform path))
                  (into [(r/generation-query-effect platform)] (r/generation-tag-effects value "42"))))))

(defn phase-index [effects (Vec r/ArgvEffect) phase String] Int
  (loop [index Int 0]
    (if (>= index (count effects)) -1
      (if (= (r/argveffect-phase (nth effects index)) phase) index (recur (+ index 1))))))

(defn ordered? [effects (Vec r/ArgvEffect) before String after String] Bool
  (and (>= (phase-index effects before) 0)
       (> (phase-index effects after) (phase-index effects before))))

(defn token-count [values (Vec String) value String] Int
  (loop [index Int 0 total Int 0]
    (if (>= index (count values)) total
      (recur (+ index 1) (+ total (if (= value (nth values index)) 1 0))))))

(defn order-rule? [effects (Vec r/ArgvEffect) linux Bool mode Int] Bool
  (cond
    (= mode 1) (and
      (ordered? effects "activation preflight" "select persistent system profile")
      (ordered? effects "select persistent system profile" "verify persistent system profile")
      (ordered? effects "verify persistent system profile" "activate verified closure"))
    (= mode 2) (and
      (ordered? effects "resolve rollback generation" "validate rollback closure")
      (ordered? effects "validate rollback closure" "activation preflight")
      (ordered? effects "activation preflight" "select rollback generation")
      (ordered? effects "select rollback generation" "activate verified closure"))
    :else (and
      (ordered? effects "pin committed snapshot" "materialize committed snapshot")
      (ordered? effects "materialize committed snapshot" "validate committed snapshot")
      (ordered? effects "validate committed snapshot" "retire validation snapshot")
      (ordered? effects "retire validation snapshot" "build committed snapshot")
      (ordered? effects "build committed snapshot" "activation preflight")
      (ordered? effects "activation preflight" "activate verified closure")
      (or (not linux) (and
        (ordered? effects "activation preflight" "activate system profile")
        (ordered? effects "activate system profile" "activate verified closure")))
      (ordered? effects "activate verified closure" "read active generation")
      (ordered? effects "read active generation" "tag active generation"))))

(defn platform-rule? [effects (Vec r/ArgvEffect) linux Bool overridden Bool mode Int] Bool
  (loop [index Int 0]
    (if (>= index (count effects)) true
      (let [effect r/ArgvEffect (nth effects index) argv (Vec String) (r/argveffect-argv effect)
            phase String (r/argveffect-phase effect) text String (str argv)]
        (and
          (if linux (not (str/includes? text "darwin-rebuild"))
            (and (not (str/includes? text "nix-env"))
                 (not (str/includes? text "switch-to-configuration"))))
          (if (= phase "build committed snapshot")
            (and (= (token-count argv "--override-input") (if overridden 1 0))
              (= (nth argv 4)
                (str (if overridden "git+file:///system?rev=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
                       (str "git+file:///repo?rev=" revision "&ref=native-rebuild-workflow"))
                  (if linux "#nixosConfigurations.fixture.config.system.build.toplevel"
                    "#darwinConfigurations.fixture.system")))) true)
          (if (or (= phase "activate system profile") (= phase "select persistent system profile"))
            (= argv ["sudo" "nix-env" "--profile" "/nix/var/nix/profiles/system" "--set" "/nix/store/system"]) true)
          (if (and linux (= phase "activate verified closure"))
            (= argv ["sudo" "/nix/store/system/bin/switch-to-configuration" "switch"]) true)
          (if (= phase "select rollback generation")
            (= argv ["sudo" "nix-env" "--profile" "/nix/var/nix/profiles/system" "--switch-generation" "40"]) true)
          (recur (+ index 1)))))))

(defn statuses [length Int failure Int seed Int] (Vec Int)
  (loop [index Int 0 result (Vec Int) []]
    (if (>= index length) result
      (recur (+ index 1) (conj result
        (if (or (= index failure) (= index (+ failure 2))) (+ 1 (mod (+ seed index) 63)) 0))))))

(defn simulation-rule? [effects (Vec r/ArgvEffect) codes (Vec Int)] Bool
  (let [result r/Simulation (r/simulate effects codes revision)
        expected-length Int (loop [index Int 0]
          (if (or (>= index (count effects)) (>= index (count codes))) index
            (if (= (nth codes index) 0) (recur (+ index 1)) (+ index 1))))
        expected-status Int (cond
          (and (> expected-length 0) (not (= (nth codes (- expected-length 1)) 0)))
          (nth codes (- expected-length 1))
          (< expected-length (count effects)) 70
          :else 0)
        executed (Vec r/ArgvEffect) (r/simulation-executed result)
        events (Vec r/TraceEvent) (r/simulation-events result)]
    (and (= (r/simulation-status result) expected-status)
      (= (count executed) expected-length) (= (count events) (* 2 expected-length))
      (loop [index Int 0]
        (if (>= index expected-length) true
          (let [effect r/ArgvEffect (nth effects index)
                start r/TraceEvent (nth events (* 2 index)) end r/TraceEvent (nth events (+ (* 2 index) 1))]
            (and (= (nth executed index) effect)
              (= (r/traceevent-event start) "span_start") (= (r/traceevent-status start) "started")
              (= (r/traceevent-event end) "span_end")
              (= (r/traceevent-status end) (if (= (nth codes index) 0) "ok" "error"))
              (= (r/traceevent-name start) (r/argveffect-phase effect))
              (= (r/traceevent-name end) (r/argveffect-phase effect))
              (= (r/traceevent-revision start) revision) (= (r/traceevent-revision end) revision)
              (recur (+ index 1)))))))))

(defn generated-workflow? [seed Int variant Int] Bool
  (let [linux Bool (not (= variant 2)) overridden Bool (= (mod seed 2) 1)
        mode Int (if (= variant 3) 1 (if (= variant 4) 2 0))
        effects (Vec r/ArgvEffect) (plan (if linux (r/linux-platform) (r/darwin-platform)) overridden mode)]
    (and (order-rule? effects linux mode) (platform-rule? effects linux overridden mode)
      (loop [index Int -1]
        (if (>= index (count effects)) true
          (and (simulation-rule? effects (statuses (count effects) index seed))
               (simulation-rule? effects (statuses (+ index 1) -3 seed))
               (recur (+ index 1))))))))

(defn input-rules? [seed Int] Bool
  (let [generation String (str (+ 1 (mod seed 1000))) next String (str (+ 2 (mod seed 1000)))
        listing String (str generation " date\n" next " date True\n")]
    (and (r/generation-token? generation) (not (r/generation-token? (str "0" generation)))
      (not (r/generation-token? "latest")) (not (r/generation-token? "0")) (not (r/generation-token? ""))
      (r/generation-present? listing generation) (not (r/generation-present? listing "99999"))
      (r/generation-less? "999" "1000") (r/generation-less? generation next) (not (r/generation-less? next generation))
      (not (r/generation-less? generation generation))
      (= (r/current-generation listing) next)
      (= (r/current-generation (str generation " date\n" next " date current\n")) next)
      (r/store-path? " /nix/store/system\n") (not (r/store-path? "warning only\n"))
      (r/exact-store-path? "/nix/store/system") (not (r/exact-store-path? "relative-system"))
      (not (r/exact-store-path? "/nix/store/one\n/nix/store/two")))))

(js/export
  (defn run-properties [samples Int] Int
    (if (<= samples 0) 1
    (loop [index Int 0 seed Int 73421]
      (if (>= index samples) 0
        (if (and (input-rules? seed)
              (loop [variant Int 0]
                (if (>= variant 5) true
                  (if (generated-workflow? (+ seed variant) variant) (recur (+ variant 1))
                    (do (println (str "FAIL rebuild seed=" seed " variant=" variant)) false)))))
          (recur (+ index 1) (mod (* seed 48271) 2147483647))
          (do (println (str "FAIL rebuild order/prefix seed=" seed " case=" index)) 1)))))))
