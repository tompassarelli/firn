#lang beagle
(ns activity.menu)

(def max-command-output Int 16777216)

(defn stderr-line [(message String)] Nil
  (host.stderr/write-text (str message "\n")))

(defn menu-choice [(prompt String) (items String)] (U String Nil)
  (match (host.process/run-capture
           ["rofi" "-dmenu" "-p" prompt]
           items
           max-command-output)
    [(host.process/CaptureError errno)
     (do
       (stderr-line (str "activity-menu: cannot start rofi: errno " errno))
       nil)]
    [(host.process/CaptureOk status stdout stderr)
     (if (= status 0)
       (let [(choice String) (str/trim stdout)]
         (if (= choice "") nil choice))
       nil)]))

(defn -main [(args (Vec String))] Int
  (let [(mode String) (if (empty? args) "goto" (nth args 0))
        (verb String)
        (cond
          (= mode "--move") "move-to-activity"
          (= mode "--assign") "assign"
          :else "goto")
        (prompt String)
        (cond
          (= mode "--move") "move to activity"
          (= mode "--assign") "assign to activity"
          :else "activity")]
    (match (host.process/run-capture
             ["activity" "list" "--menu"]
             ""
             max-command-output)
      [(host.process/CaptureError errno)
       (do
         (stderr-line
           (str "activity-menu: cannot start activity: errno " errno))
         1)]
      [(host.process/CaptureOk status stdout stderr)
       (if (not= status 0)
         status
         (let [(choice (U String Nil)) (menu-choice prompt stdout)]
           (if (nil? choice)
             0
             (host.process/run-inherit ["activity" verb choice]))))])))
