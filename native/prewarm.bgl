#lang beagle
(ns firn.prewarm)

(defrecord Snapshot
  [repository String
   revision String
   branch (U String Nil)
   host String
   platform String])

(defrecord WarmSpec
  [uri String
   attribute String
   key String])

(defrecord RefUpdate
  [old String
   new String
   ref String])

(defrecord LeaseOwner
  [worker-pid Int
   child-pid Int
   key String])

(defrecord ProcessIdentity
  [pid Int
   argv (Vec String)])

(defunion LeaseOwnerResult
  (LeaseOwnerParsed [owner LeaseOwner])
  (LeaseOwnerInvalid [message String]))

(defunion RefUpdateResult
  (RefUpdateParsed [update RefUpdate])
  (RefUpdateInvalid [line String]))

(defunion SupersedePlan
  (LeaseDeduplicated [key String])
  (LeaseSupersede
    [child-pid Int
     worker-pid Int])
  (LeaseContended [key String]))

(defunion StampPlan
  (StampUnchanged [exit-status Int])
  (StampWrite [key String]))

(defunion HookPlan
  (HookIgnored [state String])
  (HookLaunch [argv (Vec String)]))

(defn starts-with?
  [text String
   prefix String]
  Bool
  (and (>= (count text) (count prefix))
       (= (subs text 0 (count prefix)) prefix)))

(defn ends-with?
  [text String
   suffix String]
  Bool
  (and (>= (count text) (count suffix))
       (= (subs text (- (count text) (count suffix)) (count text)) suffix)))

(defn text-index-from
  [text String
   needle String
   start Int]
  Int
  (cond
    (= needle "") start
    (> (+ start (count needle)) (count text)) -1
    (= (subs text start (+ start (count needle))) needle) start
    :else (text-index-from text needle (+ start 1))))

(defn text-index
  [text String
   needle String]
  Int
  (text-index-from text needle 0))

(defn append-unique
  [values (Vec String)
   candidate String]
  (Vec String)
  (loop [(index Int) 0]
    (if (>= index (count values))
      (conj values candidate)
      (if (= (nth values index) candidate)
        values
        (recur (+ index 1))))))

(defn layout-main [checkout String] (U String Nil)
  (let [(worktree-index Int) (text-index checkout "/worktrees/")
        (pin-index Int) (text-index checkout "/pins/")]
    (cond
      (>= worktree-index 0) (str (subs checkout 0 worktree-index) "/main")
      (>= pin-index 0) (str (subs checkout 0 pin-index) "/main")
      :else nil)))

(defn common-main [common-directory String] (U String Nil)
  (if (ends-with? common-directory "/.git")
    (subs common-directory 0 (- (count common-directory) 5))
    nil))

(defn container-main-candidates
  [checkout String
   common-directory (U String Nil)]
  (Vec String)
  (let [(layout (U String Nil)) (layout-main checkout)
        (with-layout (Vec String))
          (if (some? layout) [layout] [])
        (from-common (U String Nil))
          (if (some? common-directory)
            (common-main common-directory)
            nil)
        (with-common (Vec String))
          (if (some? from-common)
            (append-unique with-layout from-common)
            with-layout)]
    (append-unique with-common checkout)))

(defn trim-line-ending [text String] String
  (loop [(end Int) (count text)]
    (if (and (> end 0)
             (or (= (subs text (- end 1) end) "\n")
                 (= (subs text (- end 1) end) "\r")))
      (recur (- end 1))
      (subs text 0 end))))

(defn short-host [host String] String
  (let [(dot Int) (text-index host ".")]
    (if (< dot 0) host (subs host 0 dot))))

(defn snapshot-uri
  [repository String
   revision String
   branch (U String Nil)]
  String
  (str "git+file://" repository "?rev=" revision
    (if (some? branch) (str "&ref=" branch) "")))

(defn target-attribute
  [platform String
   host String]
  String
  (if (= platform "darwin")
    (str "darwinConfigurations." host ".system")
    (str "nixosConfigurations." host
      ".config.system.build.toplevel")))

(defn warm-spec [snapshot Snapshot] WarmSpec
  (let [(uri String)
          (snapshot-uri
            (snapshot-repository snapshot)
            (snapshot-revision snapshot)
            (snapshot-branch snapshot))
        (attribute String)
          (target-attribute
            (snapshot-platform snapshot)
            (snapshot-host snapshot))]
    (->WarmSpec uri attribute (str uri "#" attribute))))

(defn split-delimited
  [text String
   delimiter String]
  (Vec String)
  (loop [(start Int) 0
         (parts (Vec String)) []]
    (if (>= start (count text))
      parts
      (let [(end Int) (text-index-from text delimiter start)]
        (if (< end 0)
          (conj parts (subs text start (count text)))
          (recur (+ end (count delimiter))
            (conj parts (subs text start end))))))))

(defn parse-positive-int [text String] (U Int Nil)
  (let [(parsed (U Int Nil)) (parse-long text)]
    (if (and (some? parsed) (> parsed 0)) parsed nil)))

(defn parse-lease-owner [text String] LeaseOwnerResult
  (let [(lines (Vec String)) (split-delimited text "\n")]
    (if (not= (count lines) 3)
      (->LeaseOwnerInvalid "expected worker pid, child pid, and key")
      (let [(worker (U Int Nil)) (parse-positive-int (nth lines 0))
            (child (U Int Nil)) (parse-positive-int (nth lines 1))
            (key String) (nth lines 2)]
        (if (and (some? worker) (some? child) (> (count key) 0))
          (->LeaseOwnerParsed (->LeaseOwner worker child key))
          (->LeaseOwnerInvalid "invalid worker pid, child pid, or key"))))))

(defn render-lease-owner [owner LeaseOwner] String
  (str (leaseowner-worker-pid owner) "\n"
    (leaseowner-child-pid owner) "\n"
    (leaseowner-key owner) "\n"))

(defn command-argv [cmdline String] (Vec String)
  (if (= cmdline "")
    []
    (split-delimited cmdline
      (subs cmdline (- (count cmdline) 1) (count cmdline)))))

(defn argv-equal?
  [left (Vec String)
   right (Vec String)]
  Bool
  (if (not= (count left) (count right))
    false
    (loop [(index Int) 0]
      (if (>= index (count left))
        true
        (if (= (nth left index) (nth right index))
          (recur (+ index 1))
          false)))))

(defn worker-argv
  [executable String
   repository String
   key String]
  (Vec String)
  [executable "--worker" executable repository key])

(defn nix-build-argv [key String] (Vec String)
  ["nix" "build" "--no-link" "--print-out-paths" key])

(defn low-priority-build-argv [key String] (Vec String)
  ["nice" "-n" "19" "ionice" "-c" "3"
   "nix" "build" "--no-link" "--print-out-paths" key])

(defn detached-worker-argv
  [executable String
   repository String
   key String]
  (Vec String)
  ["setsid" "-f" "nice" "-n" "19" "ionice" "-c" "3"
   executable "--worker" executable repository key])

(defn identity-matches?
  [identity ProcessIdentity
   pid Int
   expected (Vec String)]
  Bool
  (and (= (processidentity-pid identity) pid)
       (argv-equal? (processidentity-argv identity) expected)))

(defn supersede-plan
  [desired-key String
   current-pid Int
   executable String
   repository String
   owner LeaseOwner
   worker ProcessIdentity
   child ProcessIdentity]
  SupersedePlan
  (let [(worker-pid Int) (leaseowner-worker-pid owner)
        (child-pid Int) (leaseowner-child-pid owner)
        (worker-valid Bool)
          (and (not= worker-pid current-pid)
               (identity-matches? worker worker-pid
                 (worker-argv executable repository
                   (leaseowner-key owner))))
        (child-valid Bool)
          (identity-matches? child child-pid
            (nix-build-argv (leaseowner-key owner)))]
    (if (not (and worker-valid child-valid))
      (->LeaseContended (leaseowner-key owner))
      (if (= desired-key (leaseowner-key owner))
        (->LeaseDeduplicated desired-key)
        (->LeaseSupersede child-pid worker-pid)))))

(defn lock-contention? [errno Int] Bool
  (or (= errno 11) (= errno 35)))

(defn stamp-current?
  [stamp String
   key String]
  Bool
  (= (trim-line-ending stamp) key))

(defn stamp-plan
  [key String
   exit-status Int]
  StampPlan
  (if (= exit-status 0)
    (->StampWrite key)
    (->StampUnchanged exit-status)))

(defn parse-ref-update [line String] RefUpdateResult
  (let [(parts (Vec String)) (split-delimited line " ")]
    (if (= (count parts) 3)
      (->RefUpdateParsed
        (->RefUpdate (nth parts 0) (nth parts 1) (nth parts 2)))
      (->RefUpdateInvalid line))))

(defn all-zero? [text String] Bool
  (and (> (count text) 0)
       (loop [(index Int) 0]
         (if (>= index (count text))
           true
           (if (= (subs text index (+ index 1)) "0")
             (recur (+ index 1))
             false)))))

(defn main-ref-update? [update RefUpdate] Bool
  (and (= (refupdate-ref update) "refs/heads/main")
       (not= (refupdate-old update) (refupdate-new update))
       (not (all-zero? (refupdate-new update)))))

(defn transaction-fires?
  [state String
   lines (Vec String)]
  Bool
  (if (not= state "committed")
    false
    (loop [(index Int) 0]
      (if (>= index (count lines))
        false
        (match (parse-ref-update (nth lines index))
          [(RefUpdateInvalid line) (recur (+ index 1))]
          [(RefUpdateParsed update)
           (if (main-ref-update? update)
             true
             (recur (+ index 1)))])))))

(defn hook-plan
  [state String
   lines (Vec String)
   executable String
   repository String
   key String]
  HookPlan
  (if (transaction-fires? state lines)
    (->HookLaunch (detached-worker-argv executable repository key))
    (->HookIgnored state)))

(defn executable-leaf?
  [value String
   leaf String]
  Bool
  (or (= value leaf) (ends-with? value (str "/" leaf))))

(defn firn-rebuild-at?
  [argv (Vec String)
   index Int]
  Bool
  (and (< index (count argv))
       (executable-leaf? (nth argv index) "firn")
       (or
         (and (< (+ index 1) (count argv))
              (= (nth argv (+ index 1)) "rebuild"))
         (and (< (+ index 2) (count argv))
              (= (nth argv (+ index 1)) "host")
              (= (nth argv (+ index 2)) "rebuild")))))

(defn rebuild-argv? [argv (Vec String)] Bool
  (loop [(index Int) 0]
    (if (>= index (count argv))
      false
      (if (firn-rebuild-at? argv index)
        true
        (recur (+ index 1))))))

(defn rebuild-running?
  [processes (Vec ProcessIdentity)
   current-pid Int]
  Bool
  (loop [(index Int) 0]
    (if (>= index (count processes))
      false
      (let [(process ProcessIdentity) (nth processes index)]
        (if (and (not= (processidentity-pid process) current-pid)
                 (rebuild-argv? (processidentity-argv process)))
          true
          (recur (+ index 1)))))))
