#lang beagle
(ns firn.main
  (:require [firn.authoring-native :as authoring]
            [firn.flake-input-native :as flake-input]
            [firn.impact :as impact]
            [firn.inventory-native :as inventory]
            [firn.prewarm-native :as prewarm]
            [firn.rebuild-native :as rebuild]
            [firn.repo-build-native :as repo-build]
            [firn.repo-workflows-native :as repo-workflows]
            [firn.schema-transaction-native :as schema]
            [firn.tag-commands-native :as tag-commands]
            [firn.tag-resolve-native :as tag-resolve]
            [firn.views-native :as views]))

(defunion CommandId
  (FlakeInputsCommand [token Bool])
  (FlakeInputResolveCommand [token Bool])
  (HostRebuildCommand [token Bool])
  (HostImpactCommand [token Bool])
  (HostListCommand [token Bool])
  (HostStatusCommand [token Bool])
  (HostGenCommand [token Bool])
  (ModuleListCommand [token Bool])
  (ModuleRefsCommand [token Bool])
  (ModuleStatusCommand [token Bool])
  (ModuleAddCommand [token Bool])
  (ModuleEnableCommand [token Bool])
  (ModuleDisableCommand [token Bool])
  (PlatformListCommand [token Bool])
  (PlatformShowCommand [token Bool])
  (PlatformSafelistCommand [token Bool])
  (RepoWatchCommand [token Bool])
  (RepoDiffCommand [token Bool])
  (RepoDoctorCommand [token Bool])
  (RepoUpgradeCommand [token Bool])
  (RepoBuildCommand [token Bool])
  (RepoValidateCommand [token Bool])
  (RepoLintCommand [token Bool])
  (RepoArchitectureCommand [token Bool])
  (SchemaExplainCommand [token Bool])
  (SchemaExtractCommand [token Bool])
  (SecretListCommand [token Bool])
  (SecretShowCommand [token Bool])
  (SecretEditCommand [token Bool])
  (TagListCommand [token Bool])
  (TagShowCommand [token Bool])
  (TagFilterCommand [token Bool])
  (TagIndexCommand [token Bool])
  (TagResolveCommand [token Bool])
  (TagEnableCommand [token Bool])
  (TagDisableCommand [token Bool])
  (TagOptInCommand [token Bool])
  (TagOptOutCommand [token Bool])
  (TagStatusCommand [token Bool])
  (TemplateServiceCommand [token Bool])
  (TemplateSubmoduleCommand [token Bool])
  (TemplateHomeCommand [token Bool])
  (TemplateHostCommand [token Bool]))

(defunion CommandFamily
  (NativeTagFamily [token Bool])
  (NativeFlakeInputFamily [token Bool])
  (NativeInventoryFamily [token Bool])
  (NativeAuthoringFamily [token Bool])
  (NativeViewsFamily [token Bool])
  (NativeRepoBuildFamily [token Bool])
  (NativeSchemaFamily [token Bool])
  (NativeRepoWorkflowFamily [token Bool])
  (NativeRebuildFamily [token Bool])
  (NativeCiPolicyFamily [token Bool]))

(defunion LeafDefault
  (RequiredLeaf [token Bool])
  (CurrentHostLeaf [token Bool])
  (LiteralLeaf [value String]))

(defunion DispatchLeaf
  (ExplicitLeaf [value String])
  (DefaultLeaf [value String])
  (CurrentHostDefault [token Bool]))

(defrecord DispatchStep
  [command CommandId
   owner CommandFamily
   node String
   edge String
   leaf DispatchLeaf])

(defrecord DispatchPlan [steps (Vec DispatchStep)])

(defunion DispatchDecision
  (DispatchPlanned [plan DispatchPlan])
  (DispatchHelp
    [text String
     status Int])
  (DispatchError
    [text String
     status Int]))

(defunion DefaultLookup
  (DefaultFound [leaf DispatchLeaf])
  (DefaultMissing [token Bool]))

(defrecord FirnCommand
  [node String
   edge String
   leaf String
   detail-gap String
   summary String
   common-gap String
   common-summary String
   id CommandId
   owner CommandFamily
   default-leaf LeafDefault])

(defunion CommandLookup
  (CommandFound [command FirnCommand])
  (CommandMissing [token Bool]))

(defrecord CommandGroup [commands (Vec FirnCommand)])

(defrecord CommonCommand
  [command FirnCommand
   usage String])

(def flake-inputs FirnCommand
  (->FirnCommand
    "flake" "inputs" "all" "  "
    "List flake inputs: source, age, locked rev, follows, broken-path check."
    "" ""
    (->FlakeInputsCommand false) (->NativeViewsFamily false)
    (->LiteralLeaf "all")))

