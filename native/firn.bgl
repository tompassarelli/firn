    "flake-input" "resolve" "emit" "  "
    "collect :flake-inputs from active modules; emit splices into flake.bnix"
    "" ""
    (->FlakeInputResolveCommand false)
    (->NativeFlakeInputFamily false)
    (->LiteralLeaf "emit")))

