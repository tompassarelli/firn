(def command-groups (Vec CommandGroup)
  [(->CommandGroup [flake-inputs])
   (->CommandGroup [flake-input-resolve])
   (->CommandGroup
     [host-rebuild host-impact host-list host-status host-gen])
   (->CommandGroup
     [module-list module-refs module-status module-add module-enable
      module-disable])
   (->CommandGroup [platform-list platform-show platform-safelist])
   (->CommandGroup
     [repo-watch repo-diff repo-doctor repo-upgrade repo-build repo-validate
      repo-lint repo-architecture])
   (->CommandGroup [schema-explain schema-extract])
   (->CommandGroup [secret-list secret-show secret-edit])
   (->CommandGroup
     [tag-list tag-show tag-filter tag-index tag-resolve tag-enable tag-disable
      tag-opt-in tag-opt-out tag-status])
   (->CommandGroup
     [template-service template-submodule template-home template-host])])

(def common-commands (Vec CommonCommand)
  [(->CommonCommand repo-build "build")
   (->CommonCommand repo-validate "validate")
   (->CommonCommand host-impact "impact")
   (->CommonCommand repo-doctor "doctor")
   (->CommonCommand tag-status "status")
   (->CommonCommand tag-enable "enable <t>")
   (->CommonCommand tag-opt-in "opt-in <t>+<m>")
   (->CommonCommand module-disable "disable <m>")
   (->CommonCommand repo-diff "diff")])

(defn command-usage [command FirnCommand] String
  (if (= (:leaf command) "")
    (:edge command)
    (str (:edge command) " " (:leaf command))))

(defn common-command-text [common CommonCommand] String
  (let [(command FirnCommand) (:command common)]
    (str "  firn " (:node command) " " (:usage common)
      (:common-gap command) (:common-summary command) "\n")))

(defn command-text [command FirnCommand] String
  (str "  " (command-usage command) (:detail-gap command)
    (:summary command) "\n"))

(defn command-list-text [commands (Vec FirnCommand)] String
  (loop [(index Int) 0 (result String) ""]
    (if (< index (count commands))
      (let [(command FirnCommand) (nth commands index)]
        (recur (+ index 1) (str result (command-text command))))
      result)))

(defn common-commands-text [] String
  (loop [(index Int) 0 (result String) ""]
    (if (< index (count common-commands))
      (let [(common CommonCommand) (nth common-commands index)]
        (recur (+ index 1) (str result (common-command-text common))))
      result)))

(defn command-groups-text [] String
  (loop [(index Int) 0 (result String) ""]
    (if (< index (count command-groups))
      (let [(commands (Vec FirnCommand))
            (:commands (nth command-groups index))]
        (recur (+ index 1)
          (str result (:node (nth commands 0)) "\n"
            (command-list-text commands) "\n")))
      result)))

(defn full-help-text [] String
  (str
    "firn — config management\n\n"
    "Usage:\n"
    "  firn <node> <edge> [<leaf>]  [<node> <edge> [<leaf>] ...]\n\n"
    "Operator shortcut:\n"
    "  firn rebuild          build + validate + switch (current host)\n\n"
    "Common graph commands:\n"
    (common-commands-text)
    "\nFull graph:\n\n"
    (command-groups-text)))

(defn print-help [] Nil
  (print (full-help-text)))

(defn commands-for-node [node String] (Vec FirnCommand)
  (loop [(index Int) 0]
    (if (>= index (count command-groups))
      []
      (let [(commands (Vec FirnCommand))
            (:commands (nth command-groups index))
            (first-command FirnCommand) (nth commands 0)]
        (if (= node (:node first-command))
          commands
          (recur (+ index 1)))))))

(defn node-known? [node String] Bool
  (> (count (commands-for-node node)) 0))

(defn find-command
  [node String
   edge String]
  CommandLookup
  (let [(commands (Vec FirnCommand)) (commands-for-node node)]
    (loop [(index Int) 0]
      (if (>= index (count commands))
        (->CommandMissing false)
        (let [(command FirnCommand) (nth commands index)]
          (if (= edge (:edge command))
            (->CommandFound command)
            (recur (+ index 1))))))))

(defn command-count [] Int
  (loop [(group-index Int) 0 (result Int) 0]
    (if (>= group-index (count command-groups))
      result
      (let [(commands (Vec FirnCommand))
            (:commands (nth command-groups group-index))]
        (recur (+ group-index 1) (+ result (count commands)))))))

(defn joined-node-names [] String
  (loop [(index Int) 0 (result String) ""]
    (if (>= index (count command-groups))
      result
      (let [(commands (Vec FirnCommand))
            (:commands (nth command-groups index))
            (command FirnCommand) (nth commands 0)]
        (recur (+ index 1)
          (str result (if (= index 0) "" ", ") (:node command)))))))

(defn joined-edge-names [commands (Vec FirnCommand)] String
  (loop [(index Int) 0 (result String) ""]
    (if (>= index (count commands))
      result
      (let [(command FirnCommand) (nth commands index)]
        (recur (+ index 1)
          (str result (if (= index 0) "" ", ") (:edge command)))))))

(defn node-help-text [node String] String
  (let [(commands (Vec FirnCommand)) (commands-for-node node)]
    (loop [(index Int) 0 (result String) (str "Edges on '" node "':\n")]
      (if (>= index (count commands))
        result
        (let [(command FirnCommand) (nth commands index)]
          (recur (+ index 1)
            (str result "  firn " (:node command) " "
              (command-usage command) "\n      " (:summary command) "\n")))))))

(defn unknown-walk-text
  [node String
   edge String]
  String
  (let [(commands (Vec FirnCommand)) (commands-for-node node)]
    (if (= (count commands) 0)
      (str "firn: unknown walk '" node " " edge "'\n"
        "  no such node '" node "'\n"
        "  available nodes: " (joined-node-names) "\n")
      (str "firn: unknown walk '" node " " edge "'\n"
        "  edges on '" node "': " (joined-edge-names commands) "\n"))))

(defn edge-usage-text [command FirnCommand] String
  (str "Usage: firn " (:node command) " " (:edge command) " "
    (:leaf command) "\n  " (:summary command) "\n"))

(defn command-default [command FirnCommand] DefaultLookup
  (match (:default-leaf command)
    [(RequiredLeaf token) (->DefaultMissing false)]
    [(CurrentHostLeaf token)
     (->DefaultFound (->CurrentHostDefault false))]
    [(LiteralLeaf value) (->DefaultFound (->DefaultLeaf value))]))

(defn tokens-from
  [tokens (Vec String)
   start Int]
  (Vec String)
  (loop [(index Int) start (result (Vec String)) []]
    (if (>= index (count tokens))
      result
      (let [(token String) (nth tokens index)]
        (recur (+ index 1) (conj result token))))))

(defn chained-next? [tokens (Vec String)] Bool
  (if (< (count tokens) 2)
    false
    (let [(node String) (nth tokens 0)
          (edge String) (nth tokens 1)]
      (match (find-command node edge)
        [(CommandFound command) true]
        [(CommandMissing token) false]))))

(defn append-step
  [steps (Vec DispatchStep)
   command FirnCommand
   leaf DispatchLeaf]
  (Vec DispatchStep)
  (conj steps
    (->DispatchStep
      (:id command) (:owner command) (:node command) (:edge command) leaf)))

(defn missing-leaf-decision [command FirnCommand] DispatchDecision
  (->DispatchError
    (str "firn: '" (:node command) " " (:edge command)
      "' requires a leaf node\n" (edge-usage-text command))
    1))

(defn parse-walk
  [tokens (Vec String)
   steps (Vec DispatchStep)]
  DispatchDecision
  (cond
    (= (count tokens) 0)
    (->DispatchPlanned (->DispatchPlan steps))

    (< (count tokens) 2)
    (->DispatchError
      (str "firn: dangling token after a complete walk: "
        (nth tokens 0) "\n")
      1)

    :else
    (let [(node String) (nth tokens 0)
          (edge String) (nth tokens 1)]
      (match (find-command node edge)
        [(CommandMissing token)
         (->DispatchError (unknown-walk-text node edge) 1)]
        [(CommandFound command)
         (let [(remaining (Vec String)) (tokens-from tokens 2)]
           (match (command-default command)
             [(DefaultFound default-leaf)
              (cond
                (chained-next? remaining)
                (parse-walk remaining
                  (append-step steps command default-leaf))

                (= (count remaining) 0)
                (->DispatchPlanned
                  (->DispatchPlan
                    (append-step steps command default-leaf)))

                :else
                (let [(leaf String) (nth remaining 0)]
                  (parse-walk (tokens-from remaining 1)
                    (append-step steps command (->ExplicitLeaf leaf)))))]
             [(DefaultMissing token)
              (if (= (count remaining) 0)
                (missing-leaf-decision command)
                (let [(leaf String) (nth remaining 0)]
                  (parse-walk (tokens-from remaining 1)
                    (append-step steps command (->ExplicitLeaf leaf)))))]))]))))

(defn starts-with-dash? [value String] Bool
  (and (> (count value) 0) (= (subs value 0 1) "-")))

(defn help-request? [args (Vec String)] Bool
  (or (= (count args) 0)
      (= (nth args 0) "help")
      (= (nth args 0) "-h")
      (= (nth args 0) "--help")))

(defn rebuild-alias? [args (Vec String)] Bool
  (and (> (count args) 0) (= (nth args 0) "rebuild")))

(defn parse-rebuild-alias [args (Vec String)] DispatchDecision
  (if (or (> (count args) 2)
          (and (= (count args) 2) (starts-with-dash? (nth args 1))))
    (->DispatchError "Usage: firn rebuild [host]\n" 1)
    (->DispatchPlanned
      (->DispatchPlan
        [(->DispatchStep
           (->HostRebuildCommand false)
           (->NativeRebuildFamily false)
           "host"
           "rebuild"
           (if (= (count args) 2)
             (->ExplicitLeaf (nth args 1))
             (->CurrentHostDefault false)))]))))

(defn incomplete-walk-text [] String
  (str "firn: incomplete walk; expected <node> <edge> [<leaf>]\n"
    "  available nodes: " (joined-node-names) "\n"))

(defn parse-dispatch [args (Vec String)] DispatchDecision
  (cond
    (help-request? args)
    (->DispatchHelp (full-help-text) 0)

    (rebuild-alias? args)
    (parse-rebuild-alias args)

    (= (count args) 1)
    (let [(node String) (nth args 0)]
      (if (node-known? node)
        (->DispatchHelp (node-help-text node) 0)
        (->DispatchError (incomplete-walk-text) 1)))

    :else
    (parse-walk args [])))

(def max-impact-output Int 16777216)

(defn repository-root [] (U String Nil)
  (let [(explicit (U String Nil)) (System/getenv "FIRN_REPO")]
    (if (some? explicit)
      explicit
      (let [(home (U String Nil)) (System/getenv "HOME")]
        (if (some? home)
          (str home "/code/nixos-config/main")
          nil)))))

(defn current-host [] String
  (let [(configured (U String Nil)) (System/getenv "FIRN_HOST")]
    (if (some? configured)
      configured
      (match (host.process/run-capture ["hostname"] "" 4096)
        [(host.process/CaptureError errno) "whiterabbit"]
        [(host.process/CaptureOk status stdout stderr)
         (let [(hostname String) (str/trim stdout)]
           (if (and (= status 0) (> (count hostname) 0))
             hostname
             "whiterabbit"))]))))

(defn leaf-host [leaf DispatchLeaf] String
  (match leaf
    [(ExplicitLeaf value) value]
    [(DefaultLeaf value) value]
    [(CurrentHostDefault token) (current-host)]))

(defn step-argv [step DispatchStep] (Vec String)
  (match (dispatchstep-leaf step)
    [(ExplicitLeaf value)
     [(dispatchstep-node step) (dispatchstep-edge step) value]]
    [(DefaultLeaf value)
     [(dispatchstep-node step) (dispatchstep-edge step) value]]
    [(CurrentHostDefault token)
     [(dispatchstep-node step) (dispatchstep-edge step)]]))

(defn current-system-derivations [] (Vec String)
  (match (host.process/run-capture
           ["nix" "path-info" "/run/current-system" "--derivation"]
           "" max-impact-output)
    [(host.process/CaptureError errno) []]
    [(host.process/CaptureOk status stdout stderr)
     (if (= status 0) (impact/split-lines stdout) [])]))

(defn run-impact [host String] Int
  (let [(root (U String Nil)) (repository-root)]
    (if (nil? root)
      (do
        (host.stderr/write-text
          "firn impact: FIRN_REPO and HOME are not set\n")
        1)
      (let [(attribute String)
            (str root "#nixosConfigurations." host
              ".config.system.build.toplevel")]
        (match (host.process/run-capture
                 ["nix" "build" attribute "--dry-run"]
                 "" max-impact-output)
          [(host.process/CaptureError errno)
           (do
             (host.stderr/write-text
               (str "firn impact: cannot run nix: errno " errno "\n"))
             1)]
          [(host.process/CaptureOk status stdout stderr)
           (match (impact/interpret
                    (impact/->ImpactInput host
                      (impact/->DryRunResult status (str stdout stderr))
                      (current-system-derivations)))
             [(ImpactFailed text)
              (do (host.stderr/write-text text) 1)]
             [(ImpactReady assessment text)
              (do (print text) 0)])])))))

(defn execute-step [step DispatchStep] Int
  (let [(args (Vec String)) (step-argv step)
        (node String) (dispatchstep-node step)
        (edge String) (dispatchstep-edge step)]
    (match (dispatchstep-owner step)
      [(NativeTagFamily token)
       (if (and (= node "tag") (= edge "resolve"))
         (tag-resolve/-main args)
         (tag-commands/-main args))]
      [(NativeFlakeInputFamily token) (flake-input/-main args)]
      [(NativeInventoryFamily token) (inventory/-main args)]
      [(NativeAuthoringFamily token) (authoring/-main args)]
      [(NativeViewsFamily token) (views/-main args)]
      [(NativeRepoBuildFamily token) (repo-build/-main args)]
      [(NativeSchemaFamily token) (schema/-main args)]
      [(NativeRepoWorkflowFamily token) (repo-workflows/-main args)]
      [(NativeRebuildFamily token)
       (if (= edge "impact")
         (run-impact (leaf-host (dispatchstep-leaf step)))
         (rebuild/-main
           ["host" "rebuild" (leaf-host (dispatchstep-leaf step))]))]
      [(NativeCiPolicyFamily token) 64])))

(defn execute-plan-from
  [steps (Vec DispatchStep)
   index Int]
  Int
  (if (>= index (count steps))
    0
    (let [(status Int) (execute-step (nth steps index))]
      (if (= status 0)
        (execute-plan-from steps (+ index 1))
        status))))

(defn execute-plan [plan DispatchPlan] Int
  (execute-plan-from (dispatchplan-steps plan) 0))

(defn prewarm-request? [args (Vec String)] Bool
  (and (> (count args) 0)
       (let [(mode String) (nth args 0)]
         (or (= mode "--print-warm-key")
             (= mode "--plan-detached")
             (= mode "--plan-reference-transaction")
             (= mode "--reference-transaction")
             (= mode "--worker")))))

(defn -main [args (Vec String)] Int
  (if (prewarm-request? args)
    (prewarm/-main args)
    (match (parse-dispatch args)
      [(DispatchHelp text status) (do (print text) status)]
      [(DispatchError text status)
       (do (host.stderr/write-text text) status)]
      [(DispatchPlanned plan) (execute-plan plan)])))
