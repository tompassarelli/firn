#lang beagle
(ns firn.main
  (:require [firn.authoring-native :as authoring]
            [firn.flake-input-native :as flake-input]
            [firn.inventory-native :as inventory]
            [firn.tag-commands-native :as tag-commands]
            [firn.tag-resolve-native :as tag-resolve]
            [firn.views-native :as views]))

(defn command?
  [(args (Vec String)) (node String) (edge String)] Bool
  (if (< (count args) 2)
    false
    (and (= (nth args 0) node) (= (nth args 1) edge))))

(defn help-request? [(args (Vec String))] Bool
  (or (= (count args) 0)
      (= (nth args 0) "help")
      (= (nth args 0) "-h")
      (= (nth args 0) "--help")))

(defn tag-command? [(args (Vec String))] Bool
  (or (command? args "tag" "list")
      (command? args "tag" "show")
      (command? args "tag" "filter")
      (command? args "tag" "index")
      (command? args "tag" "status")
      (command? args "tag" "enable")
      (command? args "tag" "disable")
      (command? args "tag" "opt-in")
      (command? args "tag" "opt-out")
      (command? args "module" "enable")
      (command? args "module" "disable")))

(defn inventory-command? [(args (Vec String))] Bool
  (or (command? args "module" "list")
      (command? args "module" "refs")
      (command? args "module" "status")
      (command? args "host" "list")
      (command? args "host" "status")))

(defn authoring-command? [(args (Vec String))] Bool
  (or (command? args "module" "add")
      (command? args "template" "service")
      (command? args "template" "submodule")
      (command? args "template" "home")
      (command? args "template" "host")
      (command? args "secret" "list")
      (command? args "secret" "show")
      (command? args "secret" "edit")))

(defn views-command? [(args (Vec String))] Bool
  (or (command? args "flake" "inputs")
      (command? args "platform" "list")
      (command? args "platform" "show")
      (command? args "platform" "safelist")
      (command? args "schema" "explain")
      (command? args "host" "gen")))

(defn print-help [] Nil
  (println "firn — native configuration management")
  (println "")
  (println "Usage:")
  (println "  firn <node> <edge> [<leaf>]")
  (println "")
  (println "flake")
  (println "  inputs [all]")
  (println "")
  (println "flake-input")
  (println "  resolve emit")
  (println "")
  (println "host")
  (println "  gen [<host>]")
  (println "  list [all]")
  (println "  status [<host>]")
  (println "")
  (println "module")
  (println "  add <name>")
  (println "  disable <name>")
  (println "  enable <name>")
  (println "  list [all|used|unused]")
  (println "  refs <name>")
  (println "  status [all]")
  (println "")
  (println "platform")
  (println "  list [all|darwin|linux]")
  (println "  safelist [all]")
  (println "  show <module>")
  (println "")
  (println "schema")
  (println "  explain <path-or-error>")
  (println "")
  (println "secret")
  (println "  edit <name>")
  (println "  list [all]")
  (println "  show <name>")
  (println "")
  (println "tag")
  (println "  disable <tag>")
  (println "  enable <tag>")
  (println "  filter <tag>")
  (println "  index [repo|stdout]")
  (println "  list [all]")
  (println "  opt-in <tag>+<module>")
  (println "  opt-out <tag>+<module>")
  (println "  resolve [<host>|all][+emit]")
  (println "  show <module>")
  (println "  status [<host>]")
  (println "")
  (println "template")
  (println "  home <name>")
  (println "  host <name>")
  (println "  service <name>")
  (println "  submodule <name>"))

(defn usage-error [] Int
  (do
    (host.stderr/write-text
      "Usage: firn <node> <edge> [<leaf>]\n")
    64))

(defn dispatch [(args (Vec String))] Int
  (cond
    (command? args "tag" "resolve") (tag-resolve/-main args)
    (tag-command? args) (tag-commands/-main args)
    (inventory-command? args) (inventory/-main args)
    (authoring-command? args) (authoring/-main args)
    (command? args "flake-input" "resolve") (flake-input/-main args)
    (views-command? args) (views/-main args)
    :else (usage-error)))

(defn -main [(args (Vec String))] Int
  (if (help-request? args)
    (do (print-help) 0)
    (dispatch args)))
