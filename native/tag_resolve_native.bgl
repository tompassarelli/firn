#lang beagle
(ns firn.tag-resolve-native
  (:require [firn.tag-resolve :as r]
            [firn.tag-resolve-driver :as driver]
            [firn.tag-inputs :as input]))

(def max-source-bytes Int 16777216)
(def max-directory-entries Int 16384)

(defunion DirectoryNamesResult
  (DirectoryNamesLoaded [(names (Vec String))])
  (DirectoryNamesRejected [(message String)]))

(defunion ModulesLoadResult
  (ModulesLoaded [(modules (Vec r/ModuleTags))])
  (ModulesRejected [(message String)]))

(defunion HostLoadResult
  (HostLoaded [(data driver/TagResolveHostData)])
  (HostRejected [(message String)]))

(defunion HostsLoadResult
  (HostsLoaded [(hosts (Vec driver/TagResolveHostData))])
  (HostsRejected [(message String)]))

(defunion GeneratedLoadResult
  (GeneratedLoaded [(present Bool) (text String)])
  (GeneratedRejected [(message String)]))

(defunion AllowlistLoadResult
  (AllowlistLoaded [(modules (Vec String))])
  (AllowlistRejected [(message String)]))

(defn path [(root String) (relative String)] String
  (str root "/" relative))

(defn errno-message [(operation String) (relative String) (errno Int)] String
  (str "firn tag resolve: " operation " '" relative
    "': errno " errno "\n"))

(defn parse-message
  [(kind String) (relative String) (message String) (offset Int)] String
  (str "firn tag resolve: invalid " kind " '" relative "' at offset "
    offset ": " message "\n"))

(defn directory-names [(root String) (relative String)] DirectoryNamesResult
  (let [(absolute String) (path root relative)]
    (match (host.fs/list-directory-bounded absolute max-directory-entries)
      [(host.fs/ListDirectoryBoundedError errno)
       (if (= errno 2)
         (->DirectoryNamesLoaded [])
         (->DirectoryNamesRejected
           (errno-message "cannot list" relative errno)))]
      [(host.fs/ListDirectoryBoundedOk entries)
       (loop [(index Int) 0
              (names (Vec String)) []]
         (if (>= index (count entries))
           (->DirectoryNamesLoaded (sort names))
           (let [(name String) (nth entries index)
                 (candidate String) (str absolute "/" name)]
             (match (host.fs/path-kind candidate)
               [(host.fs/PathKindOk kind)
                (recur (+ index 1)
                  (if (= kind 2) (conj names name) names))]
               [(host.fs/PathKindError errno)
                (if (= errno 2)
                  (recur (+ index 1) names)
                  (->DirectoryNamesRejected
                    (errno-message "cannot inspect"
                      (str relative "/" name) errno)))])
             )
           )
         )]
    )
  )
)

(defn clause-delimiter? [(character String)] Bool
  (or (= character " ")
      (= character "\t")
      (= character "\r")
      (= character "\n")
      (= character "[")))

(defn clause-at? [(source String) (offset Int) (clause String)] Bool
  (let [(end Int) (+ offset (count clause))]
    (and (<= end (count source))
         (= (subs source offset end) clause)
         (< end (count source))
         (clause-delimiter? (subs source end (+ end 1))))))

(defn source-has-tag-clause? [(source String)] Bool
  (loop [(offset Int) 0]
    (if (>= offset (count source))
      false
      (if (or (clause-at? source offset ":tags")
              (clause-at? source offset ":tags-opt-in")
              (clause-at? source offset ":tag-overrides"))
        true
        (recur (+ offset 1))))))

(defn empty-module [(name String)] r/ModuleTags
  (r/->ModuleTags name [] [] []))

(defn load-module [(root String) (name String)] ModulesLoadResult
  (let [(relative String) (str "modules/" name "/default.bnix")
        (absolute String) (path root relative)]
    (match (host.fs/path-kind absolute)
      [(host.fs/PathKindError errno)
       (if (= errno 2)
         (->ModulesLoaded [(empty-module name)])
         (->ModulesRejected (errno-message "cannot inspect" relative errno)))]
      [(host.fs/PathKindOk kind)
       (if (not (or (= kind 1) (= kind 3)))
         (->ModulesLoaded [(empty-module name)])
         (match (host.fs/read-text-bounded absolute max-source-bytes)
           [(host.fs/ReadTextBoundedError errno)
            (->ModulesRejected
              (errno-message "cannot read" relative errno))]
           [(host.fs/ReadTextBoundedOk source)
            (if (not (source-has-tag-clause? source))
              (->ModulesLoaded [(empty-module name)])
              (match (input/module-tags-from-source name source)
                [(ModuleSourceParsed value)
                 (->ModulesLoaded [value])]
                [(ModuleSourceRejected message offset)
                 (->ModulesRejected
                   (parse-message "module tag source" relative message
                     offset))])
              )
            ]
         )
       )]
    )
  )
)

(defn load-modules-from
  [(root String)
   (names (Vec String))
   (index Int)
   (modules (Vec r/ModuleTags))]
  ModulesLoadResult
  (if (>= index (count names))
    (->ModulesLoaded modules)
    (match (load-module root (nth names index))
      [(ModulesRejected message) (->ModulesRejected message)]
      [(ModulesLoaded loaded)
       (load-modules-from root names (+ index 1) (into modules loaded))])))

(defn load-modules [(root String)] ModulesLoadResult
  (match (directory-names root "modules")
    [(DirectoryNamesRejected message) (->ModulesRejected message)]
    [(DirectoryNamesLoaded names) (load-modules-from root names 0 [])]))

(defn load-darwin-allowlist [(root String)] AllowlistLoadResult
  (let [(relative String) "config/darwin-modules.json"
        (absolute String) (path root relative)]
    (match (host.fs/read-text-bounded absolute max-source-bytes)
      [(host.fs/ReadTextBoundedError errno)
       (->AllowlistRejected (errno-message "cannot read" relative errno))]
      [(host.fs/ReadTextBoundedOk source)
       (match (input/darwin-allowlist-from-json source)
         [(DarwinAllowlistParsed modules) (->AllowlistLoaded modules)]
         [(DarwinAllowlistRejected message offset)
          (->AllowlistRejected
            (parse-message "Darwin allowlist" relative message offset))])])))

(defn load-generated
  [(root String) (host String) (needed Bool)] GeneratedLoadResult
  (if (not needed)
    (->GeneratedLoaded false "")
    (let [(relative String)
          (str "hosts/" host "/_generated-enables.bnix")
          (absolute String) (path root relative)]
      (match (host.fs/path-kind absolute)
        [(host.fs/PathKindError errno)
         (if (= errno 2)
           (->GeneratedLoaded false "")
           (->GeneratedRejected
             (errno-message "cannot inspect" relative errno)))]
        [(host.fs/PathKindOk kind)
         (if (not (or (= kind 1) (= kind 3)))
           (->GeneratedLoaded false "")
           (match (host.fs/read-text-bounded absolute max-source-bytes)
             [(host.fs/ReadTextBoundedError errno)
              (->GeneratedRejected
                (errno-message "cannot read" relative errno))]
             [(host.fs/ReadTextBoundedOk text)
              (->GeneratedLoaded true text)]))]))))

(defn empty-host [(host String)] r/HostTags
  (r/->HostTags host [] [] "linux" false []))

(defn host-data
  [(tags r/HostTags)
   (tag-source-present Bool)
   (generated GeneratedLoadResult)]
  HostLoadResult
  (match generated
    [(GeneratedRejected message) (->HostRejected message)]
    [(GeneratedLoaded present text)
     (->HostLoaded
       (driver/->TagResolveHostData tags tag-source-present present text))]))

(defn parse-host-source
  [(root String)
   (host String)
   (relative String)
   (source String)
   (load-generated? Bool)]
  HostLoadResult
  (match (input/host-tags-from-source host source [])
    [(HostSourceRejected message offset)
     (->HostRejected
       (parse-message "host tag source" relative message offset))]
    [(HostSourceParsed preliminary)
     (if (= (r/hosttags-platform preliminary) "darwin")
       (match (load-darwin-allowlist root)
         [(AllowlistRejected message) (->HostRejected message)]
         [(AllowlistLoaded allowed)
          (match (input/host-tags-from-source host source allowed)
            [(HostSourceRejected message offset)
             (->HostRejected
               (parse-message "host tag source" relative message offset))]
            [(HostSourceParsed tags)
             (host-data tags true
               (load-generated root host load-generated?))])])
       (host-data preliminary true
         (load-generated root host load-generated?))) ]))

(defn load-host
  [(root String) (host String) (load-generated? Bool)] HostLoadResult
  (let [(relative String) (str "hosts/" host "/enabled-tags.bnix")
        (absolute String) (path root relative)]
    (match (host.fs/path-kind absolute)
      [(host.fs/PathKindError errno)
       (if (= errno 2)
         (host-data (empty-host host) false
           (load-generated root host load-generated?))
         (->HostRejected (errno-message "cannot inspect" relative errno)))]
      [(host.fs/PathKindOk kind)
       (if (not (or (= kind 1) (= kind 3)))
         (host-data (empty-host host) false
           (load-generated root host load-generated?))
         (match (host.fs/read-text-bounded absolute max-source-bytes)
           [(host.fs/ReadTextBoundedError errno)
            (->HostRejected (errno-message "cannot read" relative errno))]
           [(host.fs/ReadTextBoundedOk source)
            (parse-host-source root host relative source load-generated?)]))])))

(defn load-hosts-from
  [(root String)
   (names (Vec String))
   (index Int)
   (load-generated? Bool)
   (hosts (Vec driver/TagResolveHostData))]
  HostsLoadResult
  (if (>= index (count names))
    (->HostsLoaded hosts)
    (match (load-host root (nth names index) load-generated?)
      [(HostRejected message) (->HostsRejected message)]
      [(HostLoaded data)
       (load-hosts-from root names (+ index 1) load-generated?
         (conj hosts data))])))

(defn load-hosts
  [(root String)
   (names (Vec String))
   (action driver/TagResolveAction)]
  HostsLoadResult
  (if (driver/action-all? action)
    (load-hosts-from root names 0 (driver/action-emit? action) [])
    (load-hosts-from root [(driver/action-host action)] 0
      (driver/action-emit? action) [])))

(defn string-member? [(values (Vec String)) (candidate String)] Bool
  (loop [(index Int) 0]
    (if (>= index (count values))
      false
      (if (= (nth values index) candidate)
        true
        (recur (+ index 1))))))

(defn placeholder-hosts [(names (Vec String))] (Vec driver/TagResolveHostData)
  (loop [(index Int) 0
         (hosts (Vec driver/TagResolveHostData)) []]
    (if (>= index (count names))
      hosts
      (recur (+ index 1)
        (conj hosts
          (driver/->TagResolveHostData
            (empty-host (nth names index)) false false ""))))))

(defn emit-io-error [(message String)] Int
  (do (host.stderr/write-text message) 1))

(defn any-tag-source? [(hosts (Vec driver/TagResolveHostData))] Bool
  (loop [(index Int) 0]
    (if (>= index (count hosts))
      false
      (if (driver/tagresolvehostdata-tag-source-present
            (nth hosts index))
        true
        (recur (+ index 1))))))

(defn execute-effects
  [(root String) (outcome driver/TagResolveOutcome) (index Int)] Int
  (if (>= index (count (driver/tagresolveoutcome-effects outcome)))
    (driver/tagresolveoutcome-status outcome)
    (match (nth (driver/tagresolveoutcome-effects outcome) index)
      [(StdoutText text)
       (do (print text) (execute-effects root outcome (+ index 1)))]
      [(StderrText text)
       (do (host.stderr/write-text text)
           (execute-effects root outcome (+ index 1)))]
      [(WriteGenerated relative text)
       (match (host.fs/write-text-atomic (path root relative) text)
         [(host.fs/WriteTextAtomicOk)
          (execute-effects root outcome (+ index 1))]
         [(host.fs/WriteTextAtomicError errno)
          (emit-io-error (errno-message "cannot write" relative errno))])])))

(defn run-action
  [(root String) (host-names (Vec String)) (action driver/TagResolveAction)] Int
  (if (and (not (driver/action-all? action))
           (not (string-member? host-names (driver/action-host action))))
    (execute-effects root
      (driver/run-tag-resolve-action
        (driver/->TagResolveRepositoryData []
          (placeholder-hosts host-names))
        action)
      0)
    (match (load-hosts root host-names action)
      [(HostsRejected message) (emit-io-error message)]
      [(HostsLoaded hosts)
       (if (and (driver/action-all? action)
                (driver/action-emit? action)
                (not (any-tag-source? hosts)))
         (execute-effects root
           (driver/run-tag-resolve-action
             (driver/->TagResolveRepositoryData [] hosts)
             action)
           0)
         (match (load-modules root)
           [(ModulesRejected message) (emit-io-error message)]
           [(ModulesLoaded modules)
            (execute-effects root
              (driver/run-tag-resolve-action
                (driver/->TagResolveRepositoryData modules hosts)
                action)
              0)]))])))

(defn repository-root [] (U String Nil)
  (let [(explicit (U String Nil)) (System/getenv "FIRN_REPO")]
    (if (some? explicit)
      explicit
      (let [(home (U String Nil)) (System/getenv "HOME")]
        (if (some? home)
          (str home "/code/nixos-config/main")
          nil)))))

(defn default-host [] String
  (let [(host (U String Nil)) (System/getenv "FIRN_HOST")]
    (if (some? host) host "whiterabbit")))

(defn usage-error [] Int
  (do
    (host.stderr/write-text
      "Usage: firn tag resolve [<host>|all][+emit]\n")
    64))

(defn -main [(args (Vec String))] Int
  (match (driver/parse-tag-resolve-argv args (default-host)
           (some? (System/getenv "FIRN_TAG_EMIT")))
    [(OtherFirnCommand argv) (usage-error)]
    [(InvalidTagResolveArgv argv) (usage-error)]
    [(ParsedTagResolve action)
     (let [(root (U String Nil)) (repository-root)]
       (if (nil? root)
         (do
           (host.stderr/write-text
             "firn tag resolve: FIRN_REPO and HOME are not set\n")
           1)
         (match (directory-names root "hosts")
           [(DirectoryNamesRejected message) (emit-io-error message)]
           [(DirectoryNamesLoaded names) (run-action root names action)])))]))
