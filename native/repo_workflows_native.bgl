#lang beagle
(ns firn.repo-workflows-native
  (:require [firn.repo-workflows :as workflow]))

(def max-process-output Int 67108864)
(def max-lock-bytes Int 16777216)
(def watch-ownership workflow/WatchOwnership
  (workflow/->WatchOwnership 30 1))

(defunion TrackedPathsResult
  (TrackedPathsLoaded [paths (Vec String)])
  (TrackedPathsRejected [message String]))

(defn repository-root [] (U String Nil)
  (let [explicit (U String Nil) (System/getenv "FIRN_REPO")]
    (if (some? explicit)
      explicit
      (let [home (U String Nil) (System/getenv "HOME")]
        (if (some? home)
          (str home "/code/nixos-config/main")
          nil)))))

(defn usage-error [] Int
  (do
    (host.stderr/write-text
      (str
        "Usage: firn repo validate|lint|diff|doctor|watch|architecture"
        "|upgrade [leaf]\n"))
    64))

(defn emit-captured [observation workflow/ProcessObservation] Int
  (do
    (if (not= (workflow/processobservation-stdout observation) "")
      (print (workflow/processobservation-stdout observation))
      0)
    (if (not= (workflow/processobservation-stderr observation) "")
      (host.stderr/write-text
        (workflow/processobservation-stderr observation))
      0)
    (workflow/processobservation-status observation)))

(defn execute-process [process workflow/ProcessBoundary] workflow/ProcessObservation
  (match process
    [(InheritProcess phase argv)
     (let [status Int (host.process/run-inherit argv)]
       (workflow/->ProcessObservation status "" ""))]
    [(CaptureProcess phase argv stdin max-output)
     (match (host.process/run-capture argv stdin max-output)
       [(host.process/CaptureOk status stdout stderr)
        (workflow/->ProcessObservation status stdout stderr)]
       [(host.process/CaptureError errno)
        (workflow/->ProcessObservation
          1
          ""
          (str "firn repo: cannot run " (nth argv 0)
            ": errno " errno "\n"))])]
    [(CaptureToFileProcess phase argv stdin max-output output-path)
     (match (host.process/run-capture argv stdin max-output)
       [(host.process/CaptureError errno)
        (workflow/->ProcessObservation
          1
          ""
          (str "firn repo: cannot run " (nth argv 0)
            ": errno " errno "\n"))]
       [(host.process/CaptureOk status stdout stderr)
        (if (not= status 0)
          (workflow/->ProcessObservation status stdout stderr)
          (match (host.fs/write-text-atomic output-path stdout)
            [(host.fs/WriteTextAtomicOk)
             (workflow/->ProcessObservation 0 "" stderr)]
            [(host.fs/WriteTextAtomicError errno)
             (workflow/->ProcessObservation
               1
               ""
               (str "firn repo: cannot write " output-path
                 ": errno " errno "\n"))]))])]))

(defn execute-processes
  [processes (Vec workflow/ProcessBoundary)
   index Int]
  Int
  (if (>= index (count processes))
    0
    (let [observation workflow/ProcessObservation (execute-process (nth processes index))
          status Int (emit-captured observation)]
      (if (= status 0)
        (execute-processes processes (+ index 1))
        status))))

(defn tracked-paths [root String] TrackedPathsResult
  (match (host.process/run-capture
           ["git" "-C" root "ls-files"] "" max-process-output)
    [(host.process/CaptureError errno)
     (->TrackedPathsRejected
       (str "firn repo: cannot run git: errno " errno "\n"))]
    [(host.process/CaptureOk status stdout stderr)
     (if (= status 0)
       (->TrackedPathsLoaded (workflow/split-lines stdout))
       (->TrackedPathsRejected
         (if (= stderr "")
           (str "firn repo: git ls-files failed with status " status "\n")
           stderr)))]))

(defn git-capture [argv (Vec String)] workflow/ProcessObservation
  (match (host.process/run-capture argv "" max-process-output)
    [(host.process/CaptureError errno)
     (workflow/->ProcessObservation
       127 "" (str "cannot run git: errno " errno "\n"))]
    [(host.process/CaptureOk status stdout stderr)
     (workflow/->ProcessObservation status stdout stderr)]))

(defn local-main-path [repo String] (U String Nil)
  (let [home (U String Nil) (System/getenv "HOME")]
    (if (some? home) (str home "/code/" repo "/main") nil)))

(defn github-origin?
  [origin String
   repo String] Bool
  (let [web String (str "https://github.com/tompassarelli/" repo)
        ssh String (str "git@github.com:tompassarelli/" repo)
        ssh-url String (str "ssh://git@github.com/tompassarelli/" repo)]
    (or (= origin web)
        (= origin (str web ".git"))
        (= origin ssh)
        (= origin (str ssh ".git"))
        (= origin ssh-url)
        (= origin (str ssh-url ".git")))))

(defn check-first-party-input
  [input workflow/FirstPartyInput] Int
  (let [name String (workflow/firstpartyinput-name input)
        repo String (workflow/firstpartyinput-repo input)
        rev String (workflow/firstpartyinput-rev input)
        checkout (U String Nil) (local-main-path repo)]
    (if (nil? checkout)
      (do
        (print (str "  ⚠ first-party input " name
          ": HOME is unavailable; local checkout skipped (portable)\n"))
        0)
      (match (host.fs/path-kind checkout)
        [(host.fs/PathKindError errno)
         (if (= errno 2)
           (do
             (print (str "  ⚠ first-party input " name
               ": local checkout " checkout " is absent; skipped (portable)\n"))
             0)
           (do
             (host.stderr/write-text
               (str "  ✗ first-party input " name
                 ": cannot inspect " checkout ": errno " errno "\n"))
             1))]
        [(host.fs/PathKindOk kind)
         (if (not= kind 2)
           (do
             (host.stderr/write-text
               (str "  ✗ first-party input " name
                 ": local checkout is not a directory: " checkout "\n"))
             1)
           (let [clean workflow/ProcessObservation (git-capture
                   ["git" "-C" checkout "status" "--porcelain"
                    "--untracked-files=no"])]
             (if (not= (workflow/processobservation-status clean) 0)
               (do
                 (host.stderr/write-text
                   (str "  ✗ first-party input " name
                     ": cannot inspect local main: "
                     (workflow/trim-line-end
                       (workflow/processobservation-stderr clean)) "\n"))
                 1)
               (if (not= (workflow/processobservation-stdout clean) "")
                 (do
                   (host.stderr/write-text
                     (str "  ✗ first-party input " name
                       ": local public main is dirty: " checkout "\n"))
                   1)
                 (let [origin-result workflow/ProcessObservation (git-capture
                         ["git" "-C" checkout "remote" "get-url" "origin"])]
                   (if (not= (workflow/processobservation-status origin-result) 0)
                     (do
                       (host.stderr/write-text
                         (str "  ✗ first-party input " name
                           ": cannot read local public origin: "
                           (workflow/trim-line-end
                             (workflow/processobservation-stderr origin-result))
                           "\n"))
                       1)
                     (let [origin String (workflow/trim-line-end
                             (workflow/processobservation-stdout origin-result))]
                       (if (not (github-origin? origin repo))
                         (do
                           (host.stderr/write-text
                             (str "  ✗ first-party input " name
                               ": local origin does not identify github:tompassarelli/"
                               repo "\n"))
                           1)
                         (let [main-result workflow/ProcessObservation (git-capture
                                 ["git" "-C" checkout "rev-parse" "--verify"
                                  "refs/heads/main"])]
                           (if (not= (workflow/processobservation-status main-result) 0)
                             (do
                               (host.stderr/write-text
                                 (str "  ✗ first-party input " name
                                   ": local public main is unavailable: "
                                   (workflow/trim-line-end
                                     (workflow/processobservation-stderr main-result))
                                   "\n"))
                               1)
                             (let [main-rev String (workflow/trim-line-end
                                     (workflow/processobservation-stdout main-result))
                                   ancestry workflow/ProcessObservation (git-capture
                                     ["git" "-C" checkout "merge-base" "--is-ancestor"
                                      rev main-rev])]
                               (cond
                                 (= (workflow/processobservation-status ancestry) 0)
                                 (do
                                   (print (str "  ✓ first-party input " name
                                     ": pinned " rev " is an ancestor of local "
                                     repo "/main\n"))
                                   0)

                                 (= (workflow/processobservation-status ancestry) 1)
                                 (do
                                   (host.stderr/write-text
                                     (str "  ✗ first-party input " name
                                       ": pinned " rev
                                       " is not an ancestor of local " repo
                                       "/main " main-rev "\n"))
                                   1)

                                 :else
                                 (do
                                   (host.stderr/write-text
                                     (str "  ✗ first-party input " name
                                       ": cannot compare pinned revision: "
                                       (workflow/trim-line-end
                                         (workflow/processobservation-stderr ancestry))
                                       "\n"))
                                   1)))))))))))))]))))

(defn check-first-party-input-skew [root String] Int
  (match (host.fs/read-text-bounded (str root "/flake.lock") max-lock-bytes)
    [(host.fs/ReadTextBoundedError errno)
     (do
       (host.stderr/write-text
         (str "firn doctor: cannot read flake.lock: errno " errno "\n"))
       1)]
    [(host.fs/ReadTextBoundedOk source)
     (match (workflow/first-party-inputs-from-lock source)
       [(FirstPartyInputsRejected message)
        (do (host.stderr/write-text (str "firn doctor: " message "\n")) 1)]
       [(FirstPartyInputsParsed inputs)
        (loop [index Int 0]
          (if (>= index (count inputs))
            0
            (let [status Int (check-first-party-input (nth inputs index))]
              (if (= status 0) (recur (+ index 1)) status))))])]))

(defn action-needs-tracked? [action workflow/RepoWorkflowAction] Bool
  (match action
    [(RepoValidate) false]
    [(RepoLint) true]
    [(RepoDiff target) false]
    [(RepoDoctor) false]
    [(RepoWatch) false]
    [(RepoArchitecture bundle) true]
    [(RepoUpgrade dry-run) false]))

(defn execute-action
  [root String
   action workflow/RepoWorkflowAction] Int
  (let [loaded TrackedPathsResult (if (action-needs-tracked? action)
          (tracked-paths root)
          (->TrackedPathsLoaded []))]
    (match loaded
      [(TrackedPathsRejected message)
       (do (host.stderr/write-text message) 1)]
      [(TrackedPathsLoaded tracked)
       (let [doctor-status Int (match action
               [(RepoDoctor) (check-first-party-input-skew root)]
               [(RepoValidate) 0]
               [(RepoLint) 0]
               [(RepoDiff target) 0]
               [(RepoWatch) 0]
               [(RepoArchitecture bundle) 0]
               [(RepoUpgrade dry-run) 0])]
         (if (not= doctor-status 0)
           doctor-status
           (let [plan workflow/RepoWorkflowPlan (workflow/repo-workflow-plan
                   root action tracked watch-ownership)
                 status Int (execute-processes
                   (workflow/repoworkflowplan-processes plan) 0)]
             (if (= status 0)
               (do
                 (if (not= (workflow/repoworkflowplan-success-output plan) "")
                   (print (workflow/repoworkflowplan-success-output plan))
                   0)
                 0)
               status))))])))

(defn -main [args (Vec String)] Int
  (match (workflow/parse-repo-workflow-argv args)
    [(InvalidRepoWorkflowArgv argv) (usage-error)]
    [(ParsedRepoWorkflow action)
     (let [root (U String Nil) (repository-root)]
       (if (nil? root)
         (do
           (host.stderr/write-text
             "firn repo: FIRN_REPO and HOME are not set\n")
           1)
         (execute-action root action)))]))
