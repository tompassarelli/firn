#lang beagle
(ns firn.flake-input-native
  (:require [firn.flake-input-driver :as driver]))

(def max-source-bytes Int 16777216)
(def max-directory-entries Int 16384)

(defunion DirectoryNamesResult
  (DirectoryNamesLoaded [(names (Vec String))])
  (DirectoryNamesRejected [(message String)]))

(defunion ModuleLoadResult
  (ModuleLoaded [(module driver/ModuleSource)])
  (ModuleLoadRejected [(message String)]))

(defunion ModulesLoadResult
  (ModulesLoaded [(modules (Vec driver/ModuleSource))])
  (ModulesLoadRejected [(message String)]))

(defunion FlakeLoadResult
  (FlakeLoaded [(text String)])
  (FlakeLoadRejected [(message String)]))

(defn path [(root String) (relative String)] String
  (str root "/" relative))

(defn errno-message [(operation String) (relative String) (errno Int)] String
  (str "firn flake-input resolve: " operation " '" relative
    "': errno " errno "\n"))

(defn directory-names [(root String)] DirectoryNamesResult
  (let [(relative String) "modules"
        (absolute String) (path root relative)]
    (match (host.fs/list-directory-bounded
             absolute max-directory-entries)
      [(host.fs/ListDirectoryBoundedError errno)
       (if (or (= errno 2) (= errno 20))
         (->DirectoryNamesLoaded [])
         (->DirectoryNamesRejected
           (errno-message "cannot list" relative errno)))]
      [(host.fs/ListDirectoryBoundedOk entries)
       (loop [index Int 0
              names (Vec String) []]
         (if (>= index (count entries))
           (->DirectoryNamesLoaded (sort names))
           (let [(name String) (nth entries index)
                 (candidate String) (str absolute "/" name)]
             (match (host.fs/path-kind candidate)
               [(host.fs/PathKindOk kind)
                (recur (+ index 1)
                  (if (= kind 2) (conj names name) names))]
               [(host.fs/PathKindError errno)
                (if (= errno 2)
                  (recur (+ index 1) names)
                  (->DirectoryNamesRejected
                    (errno-message "cannot inspect"
                      (str relative "/" name) errno)))])
             )
           )
         )]
    )
  )
)

(defn load-module [(root String) (name String)] ModuleLoadResult
  (let [(relative String) (str "modules/" name "/default.bnix")
        (absolute String) (path root relative)]
    (match (host.fs/path-kind absolute)
      [(host.fs/PathKindError errno)
       (if (= errno 2)
         (->ModuleLoaded (driver/->ModuleSource name ""))
         (->ModuleLoadRejected
           (errno-message "cannot inspect" relative errno)))]
      [(host.fs/PathKindOk kind)
       (if (not (or (= kind 1) (= kind 3)))
         (->ModuleLoaded (driver/->ModuleSource name ""))
         (match (host.fs/read-text-bounded absolute max-source-bytes)
           [(host.fs/ReadTextBoundedError errno)
            (->ModuleLoadRejected
              (errno-message "cannot read" relative errno))]
           [(host.fs/ReadTextBoundedOk source)
            (->ModuleLoaded (driver/->ModuleSource name source))]))])))

(defn load-modules-from
  [(root String)
   (names (Vec String))
   (index Int)
   (modules (Vec driver/ModuleSource))]
  ModulesLoadResult
  (if (>= index (count names))
    (->ModulesLoaded modules)
    (match (load-module root (nth names index))
      [(ModuleLoadRejected message) (->ModulesLoadRejected message)]
      [(ModuleLoaded module)
       (load-modules-from root names (+ index 1) (conj modules module))])))

(defn load-modules [(root String)] ModulesLoadResult
  (match (directory-names root)
    [(DirectoryNamesRejected message) (->ModulesLoadRejected message)]
    [(DirectoryNamesLoaded names) (load-modules-from root names 0 [])]))

(defn load-flake [(root String)] FlakeLoadResult
  (let [(relative String) "flake.bnix"
        (absolute String) (path root relative)]
    (match (host.fs/read-text-bounded absolute max-source-bytes)
      [(host.fs/ReadTextBoundedError errno)
       (->FlakeLoadRejected
         (errno-message "cannot read" relative errno))]
      [(host.fs/ReadTextBoundedOk text) (->FlakeLoaded text)])))

(defn emit-io-error [(message String)] Int
  (do (host.stderr/write-text message) 1))

(defn execute-effects
  [(root String) (outcome driver/FlakeInputOutcome) (index Int)] Int
  (if (>= index (count (driver/flakeinputoutcome-effects outcome)))
    (driver/flakeinputoutcome-status outcome)
    (match (nth (driver/flakeinputoutcome-effects outcome) index)
      [(StdoutText text)
       (do (print text) (execute-effects root outcome (+ index 1)))]
      [(StderrText text)
       (do (host.stderr/write-text text)
           (execute-effects root outcome (+ index 1)))]
      [(WriteFlake relative text)
       (match (host.fs/write-text-atomic (path root relative) text)
         [(host.fs/WriteTextAtomicOk)
          (execute-effects root outcome (+ index 1))]
         [(host.fs/WriteTextAtomicError errno)
          (emit-io-error (errno-message "cannot write" relative errno))])])))

(defn run [(root String)] Int
  (match (load-modules root)
    [(ModulesLoadRejected message) (emit-io-error message)]
    [(ModulesLoaded modules)
     (match (load-flake root)
       [(FlakeLoadRejected message) (emit-io-error message)]
       [(FlakeLoaded text)
        (execute-effects root
          (driver/run-flake-input-emit
            (driver/->FlakeInputRepositoryData modules text))
          0)])]))

(defn repository-root [] (U String Nil)
  (let [(explicit (U String Nil)) (System/getenv "FIRN_REPO")]
    (if (some? explicit)
      explicit
      (let [(home (U String Nil)) (System/getenv "HOME")]
        (if (some? home)
          (str home "/code/nixos-config/main")
          nil)))))

(defn usage-error [] Int
  (do
    (host.stderr/write-text
      "Usage: firn flake-input resolve emit\n")
    64))

(defn -main [(args (Vec String))] Int
  (match (driver/parse-flake-input-argv args)
    [(OtherFirnCommand argv) (usage-error)]
    [(InvalidFlakeInputArgv argv) (usage-error)]
    [(ParsedFlakeInputEmit)
     (let [(root (U String Nil)) (repository-root)]
       (if (nil? root)
         (do
           (host.stderr/write-text
             "firn flake-input resolve: FIRN_REPO and HOME are not set\n")
           1)
         (run root)))]))
