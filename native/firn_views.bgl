#lang beagle
(ns firn.views
  (:require [native.json :as json]
            [beagle.nix-schema-path :as paths]))

(defrecord Follow
  [input String
   target String])

(defrecord FlakeRow
  [name String
   url String
   age-seconds Int
   age String
   revision String
   frozen Bool
   broken Bool
   follows (Vec Follow)])

(defunion FlakeRowsResult
  (FlakeRows [rows (Vec FlakeRow)])
  (FlakeRowsRejected [message String]))

(defrecord SchemaEntry
  [path String
   type String
   inner-type String
   enum-values (Vec String)
   declarations (Vec String)])

(defunion SchemaResult
  (SchemaLoaded [entries (Vec SchemaEntry)])
  (SchemaRejected
    [message String
     offset Int]))

(defrecord ModuleSource
  [name String
   documents (Vec paths/SourceDocument)])

(defunion ModulePathsResult
  (ModulePaths [paths (Vec String)])
  (ModulePathsRejected [message String]))

(defrecord PlatformVerdict
  [module String
   verdict Keyword
   blockers (Vec String)])

(defunion PlatformVerdictResult
  (PlatformVerdictLoaded [value PlatformVerdict])
  (PlatformVerdictRejected [message String]))

(defunion PlatformResult
  (PlatformLoaded [verdicts (Vec PlatformVerdict)])
  (PlatformRejected [message String]))

(defrecord ChildResult
  [status Int
   stdout String
   stderr String])

(defrecord CommandResult
  [status Int
   stdout String
   stderr String])

(defunion ViewsAction
  FlakeInputs
  (PlatformList [selection String])
  (PlatformShow [module String])
  PlatformSafelist
  (SchemaExplain [input String])
  (SchemaExtract [host String])
  (HostGeneration [host String]))

(defunion ViewsArgv
  (ParsedViews [action ViewsAction])
  (InvalidViewsArgv [argv (Vec String)]))

(defn starts-with?
  [text String
   prefix String] Bool
  (and (>= (count text) (count prefix))
       (= prefix (subs text 0 (count prefix)))))

(defn ends-with?
  [text String
   suffix String] Bool
  (and (>= (count text) (count suffix))
       (= suffix
          (subs text (- (count text) (count suffix)) (count text)))))

(defn string-member?
  [values (Vec String)
   candidate String] Bool
  (loop [index Int 0]
    (if (>= index (count values))
      false
      (if (= candidate (nth values index))
        true
        (recur (+ index 1))))))

(defn append-unique
  [values (Vec String)
   candidate String] (Vec String)
  (if (string-member? values candidate) values (conj values candidate)))

(defn split-on
  [text String
   separator String] (Vec String)
  (if (= separator "")
    [text]
    (loop [start Int 0
           index Int 0
           parts (Vec String) []]
      (if (> (+ index (count separator)) (count text))
        (conj parts (subs text start (count text)))
        (if (= separator
               (subs text index (+ index (count separator))))
          (recur (+ index (count separator))
            (+ index (count separator))
            (conj parts (subs text start index)))
          (recur start (+ index 1) parts))))))

(defn split-lines [text String] (Vec String)
  (let [lines (Vec String) (split-on text "\n")]
    (if (and (> (count lines) 0)
             (= "" (nth lines (- (count lines) 1))))
      (pop lines)
      lines)))

(defn join-with
  [values (Vec String)
   separator String] String
  (loop [index Int 0
         result String ""]
    (if (>= index (count values))
      result
      (recur (+ index 1)
        (str result (if (= index 0) "" separator) (nth values index))))))

(defn trim-spaces [text String] String
  (loop [start Int 0]
    (if (and (< start (count text))
             (or (= " " (subs text start (+ start 1)))
                 (= "\t" (subs text start (+ start 1)))))
      (recur (+ start 1))
      (loop [end Int (count text)]
        (if (and (> end start)
                 (or (= " " (subs text (- end 1) end))
                     (= "\t" (subs text (- end 1) end))
                     (= "\r" (subs text (- end 1) end))))
          (recur (- end 1))
          (subs text start end))))))

(defn pad-right
  [text String
   width Int] String
  (loop [result String text]
    (if (>= (count result) width)
      result
      (recur (str result " ")))))

(defn truncate
  [text String
   limit Int] String
  (if (<= (count text) limit)
    text
    (str (subs text 0 (- limit 1)) "…")))

(defn ansi
  [tty Bool
   code String
   text String] String
  (if tty (str "\u001b[" code "m" text "\u001b[0m") text))

(defn json-container-end
  [events (Vec json/JsonEvent)
   start Int] Int
  (loop [index Int start
         depth Int 0]
    (if (>= index (count events))
      -1
      (match (nth events index)
        [(JsonObjectStart offset) (recur (+ index 1) (+ depth 1))]
        [(JsonArrayStart offset) (recur (+ index 1) (+ depth 1))]
        [(JsonObjectEnd offset)
         (if (= depth 1)
           (+ index 1)
           (recur (+ index 1) (- depth 1)))]
        [(JsonArrayEnd offset)
         (if (= depth 1)
           (+ index 1)
           (recur (+ index 1) (- depth 1)))]
        [(JsonKey offset value) (recur (+ index 1) depth)]
        [(JsonString offset value) (recur (+ index 1) depth)]
        [(JsonNumber offset lexeme) (recur (+ index 1) depth)]
        [(JsonBoolean offset value) (recur (+ index 1) depth)]
        [(JsonNull offset) (recur (+ index 1) depth)]))))

(defn json-value-end
  [events (Vec json/JsonEvent)
   start Int] Int
  (if (or (< start 0) (>= start (count events)))
    -1
    (match (nth events start)
      [(JsonObjectStart offset) (json-container-end events start)]
      [(JsonArrayStart offset) (json-container-end events start)]
      [(JsonObjectEnd offset) -1]
      [(JsonArrayEnd offset) -1]
      [(JsonKey offset value) (+ start 1)]
      [(JsonString offset value) (+ start 1)]
      [(JsonNumber offset lexeme) (+ start 1)]
      [(JsonBoolean offset value) (+ start 1)]
      [(JsonNull offset) (+ start 1)])))

(defn object-field-start
  [events (Vec json/JsonEvent)
   start Int
   key String] Int
  (if (or (< start 0)
          (>= start (count events))
          (not (instance? JsonObjectStart (nth events start))))
    -1
    (let [end Int (json-value-end events start)]
      (if (< end 0)
        -1
        (loop [index Int (+ start 1)]
          (if (>= index (- end 1))
            -1
            (match (nth events index)
              [(JsonKey offset candidate)
               (let [value-index Int (+ index 1)
                     next Int (json-value-end events value-index)]
                 (if (< next 0)
                   -1
                   (if (= candidate key)
                     value-index
                     (recur next))))]
              [(JsonObjectStart offset) -1]
              [(JsonObjectEnd offset) -1]
              [(JsonArrayStart offset) -1]
              [(JsonArrayEnd offset) -1]
              [(JsonString offset value) -1]
              [(JsonNumber offset lexeme) -1]
              [(JsonBoolean offset value) -1]
              [(JsonNull offset) -1])))))))

(defn object-field-names
  [events (Vec json/JsonEvent)
   start Int] (Vec String)
  (if (or (< start 0)
          (>= start (count events))
          (not (instance? JsonObjectStart (nth events start))))
    []
    (let [end Int (json-value-end events start)]
      (if (< end 0)
        []
        (loop [index Int (+ start 1)
               names (Vec String) []]
          (if (>= index (- end 1))
            names
            (match (nth events index)
              [(JsonKey offset key)
               (let [next Int (json-value-end events (+ index 1))]
                 (if (< next 0)
                   []
                   (recur next (conj names key))))]
              [(JsonObjectStart offset) []]
              [(JsonObjectEnd offset) []]
              [(JsonArrayStart offset) []]
              [(JsonArrayEnd offset) []]
              [(JsonString offset value) []]
              [(JsonNumber offset lexeme) []]
              [(JsonBoolean offset value) []]
              [(JsonNull offset) []])))))))

(defn string-at
  [events (Vec json/JsonEvent)
   index Int] (U String Nil)
  (if (or (< index 0) (>= index (count events)))
    nil
    (match (nth events index)
      [(JsonString offset value) value]
      [(JsonObjectStart offset) nil]
      [(JsonObjectEnd offset) nil]
      [(JsonArrayStart offset) nil]
      [(JsonArrayEnd offset) nil]
      [(JsonKey offset value) nil]
      [(JsonNumber offset lexeme) nil]
      [(JsonBoolean offset value) nil]
      [(JsonNull offset) nil])))

(defn number-at
  [events (Vec json/JsonEvent)
   index Int] (U Int Nil)
  (if (or (< index 0) (>= index (count events)))
    nil
    (match (nth events index)
      [(JsonNumber offset lexeme) (parse-long lexeme)]
      [(JsonObjectStart offset) nil]
      [(JsonObjectEnd offset) nil]
      [(JsonArrayStart offset) nil]
      [(JsonArrayEnd offset) nil]
      [(JsonKey offset value) nil]
      [(JsonString offset value) nil]
      [(JsonBoolean offset value) nil]
      [(JsonNull offset) nil])))

(defn object-string
  [events (Vec json/JsonEvent)
   start Int
   key String] (U String Nil)
  (string-at events (object-field-start events start key)))

(defn object-number
  [events (Vec json/JsonEvent)
   start Int
   key String] (U Int Nil)
  (number-at events (object-field-start events start key)))

(defn string-or
  [value (U String Nil)
   fallback String] String
  (if (nil? value) fallback value))

(defn array-strings
  [events (Vec json/JsonEvent)
   start Int] (Vec String)
  (if (or (< start 0)
          (>= start (count events))
          (not (instance? JsonArrayStart (nth events start))))
    []
    (let [end Int (json-value-end events start)]
      (loop [index Int (+ start 1)
             values (Vec String) []]
        (if (>= index (- end 1))
          values
          (let [next Int (json-value-end events index)
                value (U String Nil) (string-at events index)]
            (if (< next 0)
              []
              (recur next (if (nil? value) values (conj values value))))))))))

(defn object-array-strings
  [events (Vec json/JsonEvent)
   start Int
   key String] (Vec String)
  (array-strings events (object-field-start events start key)))

(defn last-string [values (Vec String)] String
  (if (= (count values) 0) "" (nth values (- (count values) 1))))

(defn first-string [values (Vec String)] String
  (if (= (count values) 0) "" (nth values 0)))

(defn human-age [seconds Int] String
  (let [safe Int (max seconds 0)
        minutes Int (quot safe 60)
        hours Int (quot minutes 60)
        days Int (quot hours 24)]
    (cond
      (< safe 60) (str safe "s")
      (< minutes 60) (str minutes "m")
      (< hours 24) (str hours "h")
      (< days 30) (str days "d")
      (< days 365) (str (quot days 30) "mo")
      :else (str (quot days 365) "y"))))

(defn original-url
  [events (Vec json/JsonEvent)
   original Int] String
  (let [type String (string-or (object-string events original "type") "")
        url (U String Nil) (object-string events original "url")
        owner String (string-or (object-string events original "owner") "")
        repo String (string-or (object-string events original "repo") "")
        reference (U String Nil) (object-string events original "ref")
        revision (U String Nil) (object-string events original "rev")
        path String (string-or (object-string events original "path") "")]
    (cond
      (some? url) url
      (= type "github")
      (let [suffix String (if (some? reference)
              reference
              (if (some? revision) revision ""))]
        (str "github:" owner "/" repo
          (if (= suffix "") "" (str "/" suffix))))
      (= type "gitlab") (str "gitlab:" owner "/" repo)
      (= type "git") (str "git+" (string-or url ""))
      (= type "path") (str "path:" path)
      :else (str type ":?"))))

(defn broken-original?
  [events (Vec json/JsonEvent)
   original Int] Bool
  (let [type String (string-or (object-string events original "type") "")
        path String (string-or (object-string events original "path") "")]
    (and (= type "path") (starts-with? path "/"))))

(defn input-node-name
  [events (Vec json/JsonEvent)
   value-index Int
   fallback String] String
  (let [direct (U String Nil) (string-at events value-index)]
    (if (some? direct)
      direct
      (let [values (Vec String) (array-strings events value-index)]
        (if (= (count values) 0) fallback (nth values 0))))))

(defn follows-from-node
  [events (Vec json/JsonEvent)
   node Int] (Vec Follow)
  (let [inputs Int (object-field-start events node "inputs")
        names (Vec String) (object-field-names events inputs)]
    (loop [remaining (Vec String) names
           result (Vec Follow) []]
      (if (= (count remaining) 0)
        result
        (let [name String (first remaining)
              value-index Int (object-field-start events inputs name)
              values (Vec String) (array-strings events value-index)]
          (recur (rest remaining)
            (if (= (count values) 0)
              result
              (conj result (->Follow name (last-string values))))))))))

(defn short-revision [revision String] String
  (subs revision 0 (min 8 (count revision))))

(defn flake-row
  [events (Vec json/JsonEvent)
   nodes Int
   root-inputs Int
   name String
   now-seconds Int] (U FlakeRow Nil)
  (let [input-value Int (object-field-start events root-inputs name)
        node-name String (input-node-name events input-value name)
        node Int (object-field-start events nodes node-name)
        original Int (object-field-start events node "original")
        locked Int (object-field-start events node "locked")]
    (if (or (< node 0) (< original 0))
      nil
      (let [modified (U Int Nil) (object-number events locked "lastModified")
            age-seconds Int (if (nil? modified) -1 (max 0 (- now-seconds modified)))
            revision String (string-or (object-string events locked "rev") "?")]
        (->FlakeRow
          name
          (original-url events original)
          age-seconds
          (if (< age-seconds 0) "?" (human-age age-seconds))
          (short-revision revision)
          (some? (object-string events original "rev"))
          (broken-original? events original)
          (follows-from-node events node))))))

(defn row-before?
  [left FlakeRow
   right FlakeRow] Bool
  (let [left-age Int (if (< (flakerow-age-seconds left) 0)
          315360000
          (flakerow-age-seconds left))
        right-age Int (if (< (flakerow-age-seconds right) 0)
          315360000
          (flakerow-age-seconds right))]
    (or (< left-age right-age)
        (and (= left-age right-age)
             (< (compare (flakerow-name left) (flakerow-name right)) 0)))))

(defn insert-row
  [rows (Vec FlakeRow)
   row FlakeRow] (Vec FlakeRow)
  (loop [remaining (Vec FlakeRow) rows
         result (Vec FlakeRow) []
         inserted Bool false]
    (if (= (count remaining) 0)
      (if inserted result (conj result row))
      (let [current FlakeRow (first remaining)]
        (if (and (not inserted) (row-before? row current))
          (recur remaining (conj result row) true)
          (recur (rest remaining) (conj result current) inserted))))))

(defn flake-rows
  [source String
   now-seconds Int] FlakeRowsResult
  (match (json/decode source)
    [(JsonDecodeError offset message)
     (->FlakeRowsRejected (str "invalid flake.lock at " offset ": " message))]
    [(JsonDecoded events)
     (if (or (= (count events) 0)
             (not (instance? JsonObjectStart (nth events 0))))
       (->FlakeRowsRejected "flake.lock must be a JSON object")
       (let [root-name String (string-or (object-string events 0 "root") "root")
             nodes Int (object-field-start events 0 "nodes")
             root-node Int (object-field-start events nodes root-name)
             root-inputs Int (object-field-start events root-node "inputs")
             names (Vec String) (sort (object-field-names events root-inputs))]
         (if (or (< nodes 0) (< root-node 0) (< root-inputs 0))
           (->FlakeRowsRejected "flake.lock is missing root nodes/inputs")
           (loop [remaining (Vec String) names
                  rows (Vec FlakeRow) []]
             (if (= (count remaining) 0)
               (->FlakeRows rows)
               (let [row (U FlakeRow Nil) (flake-row events nodes root-inputs
                       (first remaining) now-seconds)]
                 (if (nil? row)
                   (->FlakeRowsRejected
                     (str "flake.lock input '" (first remaining)
                       "' has no lock node"))
                   (recur (rest remaining) (insert-row rows row)))))))))]))

(defn max-row-name [rows (Vec FlakeRow)] Int
  (loop [remaining (Vec FlakeRow) rows
         width Int 0]
    (if (= (count remaining) 0)
      width
      (recur (rest remaining)
        (max width (count (flakerow-name (first remaining))))))))

(defn follow-lines
  [follows (Vec Follow)
   name-width Int] String
  (loop [remaining (Vec Follow) follows
         text String ""]
    (if (= (count remaining) 0)
      text
      (let [follow Follow (first remaining)]
        (recur (rest remaining)
          (str text "  " (pad-right "" name-width) "  └─ "
            (follow-input follow) " shares " (follow-target follow) "\n"))))))

(defn broken-lines [rows (Vec FlakeRow)] String
  (let [broken (Vec FlakeRow) (loop [remaining (Vec FlakeRow) rows
                                     result (Vec FlakeRow) []]
                                (if (= (count remaining) 0)
            result
            (recur (rest remaining)
              (if (flakerow-broken (first remaining))
                (conj result (first remaining))
                result))))]
    (if (= (count broken) 0)
      ""
      (loop [remaining (Vec FlakeRow) broken
             text String (str "! " (count broken) " input"
               (if (= (count broken) 1) "" "s")
               " with absolute path"
               (if (= (count broken) 1) "" "s")
               " (would break the build):\n")]
        (if (= (count remaining) 0)
          (str text "\n")
          (let [row FlakeRow (first remaining)]
            (recur (rest remaining)
              (str text "    " (flakerow-name row) ": "
                (flakerow-url row) "\n"))))))))

(defn rows-have-frozen? [rows (Vec FlakeRow)] Bool
  (loop [remaining (Vec FlakeRow) rows]
    (if (= (count remaining) 0)
      false
      (if (flakerow-frozen (first remaining))
        true
        (recur (rest remaining))))))

(defn rows-have-follows? [rows (Vec FlakeRow)] Bool
  (loop [remaining (Vec FlakeRow) rows]
    (if (= (count remaining) 0)
      false
      (if (> (count (flakerow-follows (first remaining))) 0)
        true
        (recur (rest remaining))))))

(defn render-flake-rows
  [rows (Vec FlakeRow)
   tty Bool] String
  (if (= (count rows) 0)
    "No inputs in flake.lock.\n"
    (let [name-width Int (max-row-name rows)
          has-frozen Bool (rows-have-frozen? rows)
          has-follows Bool (rows-have-follows? rows)
          body String (loop [remaining (Vec FlakeRow) rows
                             text String (str (broken-lines rows)
                   (ansi tty "1" "flake inputs")
                   " (" (count rows) ", newest first)\n"
                   "  " (pad-right "name" name-width)
                   "  " (pad-right "source" 57) "  age    rev\n")]
                        (if (= (count remaining) 0)
              text
              (let [row FlakeRow (first remaining)
                    source String (str (truncate (flakerow-url row) 48)
                      (if (flakerow-frozen row) " [frozen]" ""))]
                (recur (rest remaining)
                  (str text
                    "  " (pad-right (flakerow-name row) name-width)
                    "  " (pad-right source 57)
                    "  " (pad-right (flakerow-age row) 5)
                    "  " (flakerow-revision row) "\n"
                    (follow-lines (flakerow-follows row) name-width))))))]
      (str body "\n"
        "→ `nix flake update <name>` bumps one input; "
        "`nix flake update` bumps all.\n"
        (if has-frozen
          "→ [frozen] = source URL pins a commit; it will not update.\n"
          "")
        (if has-follows
          "→ └─ X shares Y = this input uses our copy of Y.\n"
          "")))))

(defn parse-schema-entry
  [events (Vec json/JsonEvent)
   start Int] (U SchemaEntry Nil)
  (if (or (< start 0)
          (>= start (count events))
          (not (instance? JsonObjectStart (nth events start))))
    nil
    (let [name (U String Nil) (object-string events start "name")
          legacy (U String Nil) (object-string events start "p")
          path String (if (some? name) name (string-or legacy ""))
          type String (string-or (object-string events start "t") "?")
          inner Int (object-field-start events start "inner")
          inner-type String (if (< inner 0)
            ""
            (string-or (object-string events inner "t") "?"))
          enum-values (Vec String) (let [direct (Vec String) (object-array-strings events start "enum")]
            (if (> (count direct) 0)
              direct
              (if (< inner 0)
                []
                (object-array-strings events inner "enum"))))
          declarations (Vec String) (object-array-strings events start "declarations")]
      (if (or (= path "")
              (and (some? name) (some? legacy) (not= name legacy)))
        nil
        (->SchemaEntry path type inner-type enum-values declarations)))))

(defn parse-schema-array
  [events (Vec json/JsonEvent)
   start Int] SchemaResult
  (if (or (< start 0)
          (>= start (count events))
          (not (instance? JsonArrayStart (nth events start))))
    (->SchemaRejected "expected a schema array" 0)
    (let [end Int (json-value-end events start)]
      (if (< end 0)
        (->SchemaRejected "unterminated schema array" 0)
        (loop [index Int (+ start 1)
               entries (Vec SchemaEntry) []]
          (if (>= index (- end 1))
            (->SchemaLoaded entries)
            (let [next Int (json-value-end events index)
                  entry (U SchemaEntry Nil) (parse-schema-entry events index)]
              (if (or (< next 0) (nil? entry))
                (->SchemaRejected "schema entries must name a path" index)
                (recur next (conj entries entry))))))))))

(defn schema-from-json [source String] SchemaResult
  (match (json/decode source)
    [(JsonDecodeError offset message) (->SchemaRejected message offset)]
    [(JsonDecoded events) (parse-schema-array events 0)]))

(defn append-schema-entries
  [left (Vec SchemaEntry)
   right (Vec SchemaEntry)] (Vec SchemaEntry)
  (loop [remaining (Vec SchemaEntry) right
         result (Vec SchemaEntry) left]
    (if (= (count remaining) 0)
      result
      (recur (rest remaining) (conj result (first remaining))))))

(defn submodule-schema-from-json [source String] SchemaResult
  (match (json/decode source)
    [(JsonDecodeError offset message) (->SchemaRejected message offset)]
    [(JsonDecoded events)
     (let [submodules Int (object-field-start events 0 "submodules")
           names (Vec String) (object-field-names events submodules)]
       (if (< submodules 0)
         (->SchemaRejected "expected a submodules object" 0)
         (loop [remaining (Vec String) names
                entries (Vec SchemaEntry) []]
           (if (= (count remaining) 0)
             (->SchemaLoaded entries)
             (match (parse-schema-array events
                      (object-field-start events submodules (first remaining)))
               [(SchemaRejected message offset)
                (->SchemaRejected message offset)]
               [(SchemaLoaded nested)
                (recur (rest remaining)
                  (append-schema-entries entries nested))])))))]))

(defn schema-paths [entries (Vec SchemaEntry)] (Vec String)
  (loop [remaining (Vec SchemaEntry) entries
         result (Vec String) []]
    (if (= (count remaining) 0)
      result
      (recur (rest remaining)
        (append-unique result (schemaentry-path (first remaining)))))))

(defn schema-entry-for
  [entries (Vec SchemaEntry)
   path String] (U SchemaEntry Nil)
  (loop [remaining (Vec SchemaEntry) entries]
    (if (= (count remaining) 0)
      nil
      (let [entry SchemaEntry (first remaining)]
        (if (= path (schemaentry-path entry))
          entry
          (recur (rest remaining)))))))

(defn freeform-type? [type String] Bool
  (or (= type "attrsOf")
      (= type "lazyAttrsOf")
      (= type "anything")
      (= type "unspecified")
      (= type "freeform")))

(defn path-at-or-under?
  [path String
   root String] Bool
  (or (= path root)
      (and (> (count path) (count root))
           (starts-with? path root)
           (= "." (subs path (count root) (+ (count root) 1))))))

(defn schema-prefix?
  [entries (Vec SchemaEntry)
   path String] Bool
  (loop [remaining (Vec SchemaEntry) entries]
    (if (= (count remaining) 0)
      false
      (let [candidate String (schemaentry-path (first remaining))]
        (if (path-at-or-under? candidate path)
          true
          (recur (rest remaining)))))))

(defn replace-segment
  [segments (Vec String)
   index Int
   replacement String] String
  (loop [cursor Int 0
         result (Vec String) []]
    (if (>= cursor (count segments))
      (join-with result ".")
      (recur (+ cursor 1)
        (conj result
          (if (= cursor index) replacement (nth segments cursor)))))))

(defn wildcard-hit?
  [entries (Vec SchemaEntry)
   path String] Bool
  (let [segments (Vec String) (split-on path ".")]
    (loop [index Int 0]
      (if (>= index (count segments))
        false
        (if (schema-prefix? entries
              (replace-segment segments index "<name>"))
          true
          (recur (+ index 1)))))))

(defn freeform-hit?
  [entries (Vec SchemaEntry)
   path String] Bool
  (loop [remaining (Vec SchemaEntry) entries]
    (if (= (count remaining) 0)
      false
      (let [entry SchemaEntry (first remaining)]
        (if (and (freeform-type? (schemaentry-type entry))
                 (path-at-or-under? path (schemaentry-path entry)))
          true
          (recur (rest remaining)))))))

(defn path-in-schema?
  [entries (Vec SchemaEntry)
   path String] Bool
  (or (schema-prefix? entries path)
      (wildcard-hit? entries path)
      (freeform-hit? entries path)))

(defn append-occurrence-paths
  [occurrences (Vec paths/OptionPathOccurrence)
   result (Vec String)] (Vec String)
  (loop [remaining (Vec paths/OptionPathOccurrence) occurrences
         combined (Vec String) result]
    (if (= (count remaining) 0)
      combined
      (recur (rest remaining)
        (append-unique combined
          (paths/optionpathoccurrence-path (first remaining)))))))

(defn module-paths [module ModuleSource] ModulePathsResult
  (loop [remaining (Vec paths/SourceDocument) (modulesource-documents module)
         result (Vec String) []]
    (if (= (count remaining) 0)
      (->ModulePaths result)
      (let [document paths/SourceDocument (first remaining)]
        (match (paths/extract-nix-option-paths document
                 ["cfg" "config" "myConfig" "home-manager"])
          [(OptionPathError source-id offset message)
           (->ModulePathsRejected (str source-id ":" offset ": " message))]
          [(OptionPaths occurrences)
           (recur (rest remaining)
             (append-occurrence-paths occurrences result))])))))

(defn missing-paths
  [paths (Vec String)
   schema (Vec SchemaEntry)] (Vec String)
  (loop [remaining (Vec String) paths
         missing (Vec String) []]
    (if (= (count remaining) 0)
      (sort missing)
      (recur (rest remaining)
        (if (path-in-schema? schema (first remaining))
          missing
          (conj missing (first remaining)))))))

(defn combine-unique
  [left (Vec String)
   right (Vec String)] (Vec String)
  (loop [remaining (Vec String) right
         result (Vec String) left]
    (if (= (count remaining) 0)
      (sort result)
      (recur (rest remaining)
        (append-unique result (first remaining))))))

(defn platform-verdict
  [module ModuleSource
   nixos (Vec SchemaEntry)
   darwin (Vec SchemaEntry)] PlatformVerdictResult
  (match (module-paths module)
    [(ModulePathsRejected message) (->PlatformVerdictRejected message)]
    [(ModulePaths system-paths)
     (let [linux-missing (Vec String) (missing-paths system-paths nixos)
           darwin-missing (Vec String) (missing-paths system-paths darwin)
           linux-ok Bool (= (count linux-missing) 0)
           darwin-ok Bool (= (count darwin-missing) 0)]
       (cond
         (and linux-ok darwin-ok)
         (->PlatformVerdictLoaded
           (->PlatformVerdict (modulesource-name module) :both []))

         linux-ok
         (->PlatformVerdictLoaded
           (->PlatformVerdict
             (modulesource-name module) :linux-only darwin-missing))

         darwin-ok
         (->PlatformVerdictLoaded
           (->PlatformVerdict
             (modulesource-name module) :darwin-only linux-missing))

         :else
         (->PlatformVerdictLoaded
           (->PlatformVerdict
             (modulesource-name module) :no-data
             (combine-unique linux-missing darwin-missing)))))]))

(defn platform-matrix
  [modules (Vec ModuleSource)
   nixos (Vec SchemaEntry)
   darwin (Vec SchemaEntry)] PlatformResult
  (loop [remaining (Vec ModuleSource) modules
         verdicts (Vec PlatformVerdict) []]
    (if (= (count remaining) 0)
      (->PlatformLoaded verdicts)
      (match (platform-verdict (first remaining) nixos darwin)
        [(PlatformVerdictRejected message) (->PlatformRejected message)]
        [(PlatformVerdictLoaded verdict)
         (recur (rest remaining) (conj verdicts verdict))]))))

(defn verdict-label [verdict Keyword] String
  (cond
    (= verdict :both) "both"
    (= verdict :linux-only) "linux-only"
    (= verdict :darwin-only) "darwin-only"
    :else "no-data"))

(defn modules-with
  [verdicts (Vec PlatformVerdict)
   verdict Keyword] (Vec String)
  (loop [remaining (Vec PlatformVerdict) verdicts
         modules (Vec String) []]
    (if (= (count remaining) 0)
      (sort modules)
      (recur (rest remaining)
        (if (= verdict (platformverdict-verdict (first remaining)))
          (conj modules (platformverdict-module (first remaining)))
          modules)))))

(defn render-list
  [label String
   modules (Vec String)] String
  (if (= (count modules) 0)
    (str label " (0):  (none)\n")
    (loop [remaining (Vec String) modules
           text String (str label " (" (count modules) "):\n")]
      (if (= (count remaining) 0)
        text
        (recur (rest remaining) (str text "  " (first remaining) "\n"))))))

(defn render-platform-list
  [selection String
   verdicts (Vec PlatformVerdict)
   nixos-count Int
   darwin-count Int] CommandResult
  (let [both (Vec String) (modules-with verdicts :both)
        linux (Vec String) (modules-with verdicts :linux-only)
        darwin-only (Vec String) (modules-with verdicts :darwin-only)
        darwin (Vec String) (combine-unique both darwin-only)
        no-data (Vec String) (modules-with verdicts :no-data)]
    (cond
      (= selection "darwin")
      (->CommandResult 0 (render-list "darwin-compatible modules" darwin) "")

      (= selection "linux")
      (->CommandResult 0
        (str (render-list "NixOS-only modules" linux)
          (if (= (count no-data) 0)
            ""
            (str "\n"
              (render-list "modules with no detectable paths" no-data))))
        "")

      (= selection "all")
      (->CommandResult 0
        (str "Platform compatibility matrix (" (count verdicts) " modules)\n"
          "Sources: NixOS schema (" nixos-count
          " paths), darwin schema (" darwin-count " paths)\n\n"
          (render-list "darwin-compatible modules" both) "\n"
          (render-list "NixOS-only modules" linux)
          (if (= (count darwin-only) 0)
            ""
            (str "\n" (render-list "darwin-only modules" darwin-only)))
          (if (= (count no-data) 0)
            ""
            (str "\n" (render-list "no-data" no-data)))
          "\nThis checks option-path schema compatibility, not package builds.\n")
        "")

      :else
      (->CommandResult 64 ""
        (str "firn platform list: expected all|darwin|linux, got '"
          selection "'\n")))))

(defn verdict-for
  [verdicts (Vec PlatformVerdict)
   module String] (U PlatformVerdict Nil)
  (loop [remaining (Vec PlatformVerdict) verdicts]
    (if (= (count remaining) 0)
      nil
      (let [verdict PlatformVerdict (first remaining)]
        (if (= module (platformverdict-module verdict))
          verdict
          (recur (rest remaining)))))))

(defn blocker-lines [blockers (Vec String)] String
  (loop [remaining (Vec String) blockers
         text String ""]
    (if (= (count remaining) 0)
      text
      (recur (rest remaining) (str text "  " (first remaining) "\n")))))

(defn render-platform-show
  [module String
   verdicts (Vec PlatformVerdict)] CommandResult
  (let [verdict (U PlatformVerdict Nil) (verdict-for verdicts module)]
    (if (nil? verdict)
      (->CommandResult 1 ""
        (str "firn platform show: no module named '" module "'\n"))
      (->CommandResult 0
        (str "module:  " module "\n"
          "verdict: " (verdict-label (platformverdict-verdict verdict)) "\n"
          (if (= (count (platformverdict-blockers verdict)) 0)
            ""
            (str "blocking paths:\n"
              (blocker-lines (platformverdict-blockers verdict)))))
        ""))))

(defn render-platform-safelist [verdicts (Vec PlatformVerdict)] CommandResult
  (let [both (Vec String) (modules-with verdicts :both)
        darwin-only (Vec String) (modules-with verdicts :darwin-only)
        compatible (Vec String) (combine-unique both darwin-only)]
    (->CommandResult 0
      (loop [remaining (Vec String) compatible
             text String (str ";; darwin-compatible modules (native Firn).\n"
               ";; " (count compatible) " entries.\n(lst")]
        (if (= (count remaining) 0)
          (str text ")\n")
          (recur (rest remaining)
            (str text "\n     \"" (first remaining) "\""))))
      "")))

(defn allowed-path-character? [character String] Bool
  (or (and (>= (compare character "a") 0)
           (<= (compare character "z") 0))
      (and (>= (compare character "A") 0)
           (<= (compare character "Z") 0))
      (and (>= (compare character "0") 0)
           (<= (compare character "9") 0))
      (= character ".")
      (= character "_")
      (= character "<")
      (= character ">")
      (= character "-")))

(defn find-substring
  [text String
   needle String] Int
  (if (= needle "")
    0
    (loop [index Int 0]
      (if (> (+ index (count needle)) (count text))
        -1
        (if (= needle (subs text index (+ index (count needle))))
          index
          (recur (+ index 1)))))))

(defn path-token-at
  [text String
   start Int] (U String Nil)
  (if (or (< start 0) (>= start (count text)))
    nil
    (loop [end Int start]
      (if (and (< end (count text))
               (allowed-path-character? (subs text end (+ end 1))))
        (recur (+ end 1))
        (if (= end start) nil (subs text start end))))))

(defn extract-option-path [input String] (U String Nil)
  (let [unknown String "unknown option "
        mismatch String "type mismatch at "
        unknown-at Int (find-substring input unknown)
        mismatch-at Int (find-substring input mismatch)]
    (cond
      (>= unknown-at 0) (path-token-at input (+ unknown-at (count unknown)))
      (>= mismatch-at 0) (path-token-at input (+ mismatch-at (count mismatch)))
      :else
      (let [trimmed String (trim-spaces input)
            candidate (U String Nil) (path-token-at trimmed 0)]
        (if (and (some? candidate) (= candidate trimmed)) candidate nil)))))

(defn describe-type [entry SchemaEntry] String
  (if (and (or (= (schemaentry-type entry) "listOf")
               (= (schemaentry-type entry) "nullOr")
               (= (schemaentry-type entry) "attrsOf")
               (= (schemaentry-type entry) "lazyAttrsOf"))
           (not= (schemaentry-inner-type entry) ""))
    (str (schemaentry-type entry) " (" (schemaentry-inner-type entry) ")")
    (schemaentry-type entry)))

(defn quoted-values [values (Vec String)] String
  (loop [remaining (Vec String) values
         text String ""]
    (if (= (count remaining) 0)
      text
      (recur (rest remaining)
        (str text (if (= text "") "" ", ") "\"" (first remaining) "\"")))))

(defn declaration-lines [values (Vec String)] String
  (loop [remaining (Vec String) values
         text String ""]
    (if (= (count remaining) 0)
      text
      (recur (rest remaining) (str text "  " (first remaining) "\n")))))

(defn references-for
  [path String
   documents (Vec paths/SourceDocument)] (Vec String)
  (loop [remaining (Vec paths/SourceDocument) documents
         result (Vec String) []]
    (if (= (count remaining) 0)
      (sort result)
      (let [document paths/SourceDocument (first remaining)]
        (match (paths/extract-nix-option-paths document [])
          [(OptionPathError source-id offset message)
           (recur (rest remaining) result)]
          [(OptionPaths occurrences)
           (recur (rest remaining)
             (if (> (count (paths/occurrences-for-path path occurrences)) 0)
               (append-unique result (paths/sourcedocument-source-id document))
               result))])))))

(defn reference-lines [references (Vec String)] String
  (if (= (count references) 0)
    "referenced in: (nowhere in this repo)\n"
    (loop [remaining (Vec String) references
           text String "referenced in this repo:\n"]
      (if (= (count remaining) 0)
        text
        (recur (rest remaining) (str text "  " (first remaining) "\n"))))))

(defn suggestion-lines [suggestions (Vec paths/PathSuggestion)] String
  (if (= (count suggestions) 0)
    "  no similar option paths found.\n"
    (loop [remaining (Vec paths/PathSuggestion) suggestions
           text String "did you mean:\n"]
      (if (= (count remaining) 0)
        text
        (recur (rest remaining)
          (str text "  "
            (paths/pathsuggestion-path (first remaining)) "\n"))))))

(defn render-schema-explain
  [input String
   entries (Vec SchemaEntry)
   documents (Vec paths/SourceDocument)] CommandResult
  (let [path (U String Nil) (extract-option-path input)]
    (if (nil? path)
      (->CommandResult 1 ""
        (str "firn explain: couldn't extract an option path from: " input "\n"))
      (let [entry (U SchemaEntry Nil) (schema-entry-for entries path)]
        (if (nil? entry)
          (->CommandResult 1 ""
            (str "no exact match for " path "\n"
              (suggestion-lines
                (paths/rank-path-suggestions path (schema-paths entries) 5))))
          (->CommandResult 0
            (str "path:  " path "\n"
              "type:  " (describe-type entry) "\n"
              (if (= (count (schemaentry-enum-values entry)) 0)
                ""
                (str "enum:  "
                  (quoted-values (schemaentry-enum-values entry)) "\n"))
              (if (= (count (schemaentry-declarations entry)) 0)
                ""
                (str "defined in:\n"
                  (declaration-lines (schemaentry-declarations entry))))
              (reference-lines (references-for path documents)))
            ""))))))

(defn line-has-current? [line String] Bool
  (or (>= (find-substring line "current") 0)
      (ends-with? (trim-spaces line) "True")))

(defn first-token [line String] String
  (let [trimmed String (trim-spaces line)]
    (loop [end Int 0]
      (if (or (>= end (count trimmed))
              (= " " (subs trimmed end (+ end 1)))
              (= "\t" (subs trimmed end (+ end 1))))
        (subs trimmed 0 end)
        (recur (+ end 1))))))

(defn current-generation [text String] (U Int Nil)
  (loop [remaining (Vec String) (split-lines text)]
    (if (= (count remaining) 0)
      nil
      (let [line String (first remaining)]
        (if (line-has-current? line)
          (parse-long (first-token line))
          (recur (rest remaining)))))))

(defn render-host-generation [child ChildResult] CommandResult
  (if (not= (childresult-status child) 0)
    (->CommandResult (childresult-status child)
      (childresult-stdout child)
      (str (childresult-stderr child)
        "firn host gen: generation listing failed.\n"))
    (let [generation (U Int Nil) (current-generation (childresult-stdout child))]
      (if (nil? generation)
        (->CommandResult 0 "(no generation info)\n" "")
        (->CommandResult 0
          (str "current: " generation "\nnext:    " (+ generation 1) "\n")
          "")))))

(defn render-schema-extract
  [host String
   child ChildResult] CommandResult
  (let [prefix String (str ">> firn schema extract " host "\n")]
    (if (= (childresult-status child) 0)
      (->CommandResult 0 (str prefix (childresult-stdout child))
        (childresult-stderr child))
      (->CommandResult (childresult-status child)
        (str prefix (childresult-stdout child))
        (str (childresult-stderr child) "firn schema extract: failed.\n")))))

(defn parse-views-argv
  [argv (Vec String)
   current-host String] ViewsArgv
  (cond
    (= argv ["flake" "inputs"])
    (->ParsedViews (->FlakeInputs))

    (= argv ["flake" "inputs" "all"])
    (->ParsedViews (->FlakeInputs))

    (= argv ["platform" "list"])
    (->ParsedViews (->PlatformList "all"))

    (and (= (count argv) 3)
         (= (nth argv 0) "platform")
         (= (nth argv 1) "list"))
    (->ParsedViews (->PlatformList (nth argv 2)))

    (and (= (count argv) 3)
         (= (nth argv 0) "platform")
         (= (nth argv 1) "show"))
    (->ParsedViews (->PlatformShow (nth argv 2)))

    (= argv ["platform" "safelist" "all"])
    (->ParsedViews (->PlatformSafelist))

    (= argv ["platform" "safelist"])
    (->ParsedViews (->PlatformSafelist))

    (and (= (count argv) 3)
         (= (nth argv 0) "schema")
         (= (nth argv 1) "explain"))
    (->ParsedViews (->SchemaExplain (nth argv 2)))

    (= argv ["schema" "extract"])
    (->ParsedViews (->SchemaExtract current-host))

    (and (= (count argv) 3)
         (= (nth argv 0) "schema")
         (= (nth argv 1) "extract"))
    (->ParsedViews (->SchemaExtract (nth argv 2)))

    (= argv ["host" "gen"])
    (->ParsedViews (->HostGeneration current-host))

    (and (= (count argv) 3)
         (= (nth argv 0) "host")
         (= (nth argv 1) "gen"))
    (->ParsedViews (->HostGeneration (nth argv 2)))

    :else (->InvalidViewsArgv argv)))
