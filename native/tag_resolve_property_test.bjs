#lang beagle/js
(ns firn.tag-resolve-property-test
  (:require [firn.tag-resolve :as r]))

(js/export
  (defn next-seed [seed Int] Int (mod (* seed 48271) 2147483647)))

(js/export
  (defn member? [values (Vec String) value String] Bool
    (loop [index Int 0]
      (if (>= index (count values)) false
        (if (= value (nth values index)) true (recur (+ index 1)))))))

(js/export
  (defn subset [seed Int values (Vec String)] (Vec String)
    (loop [index Int 0 state Int seed result (Vec String) []]
      (if (>= index (count values)) result
        (recur (+ index 1) (next-seed state)
          (if (= (mod state 3) 0) result (conj result (nth values index))))))))

(js/export (def names (Vec String) ["alpha" "beta" "delta" "epsilon" "gamma"]))
(js/export (def tags (Vec String) ["desktop" "terminal" "creative"]))

(js/export
  (defn modules [seed Int] (Vec r/ModuleTags)
    (loop [index Int 0 state Int seed result (Vec r/ModuleTags) []]
      (if (>= index (count names)) result
        (recur (+ index 1) (next-seed state)
          (conj result (r/->ModuleTags (nth names index)
            (subset state tags) (subset (next-seed state) tags) [])))))))

(js/export
  (defn host [seed Int] r/HostTags
    (let [enabled (Vec String) (subset seed (if (= (mod seed 2) 0) ["unknown" "creative" "desktop" "terminal"]
                                      ["terminal" "desktop" "creative" "unknown"]))]
      (r/->HostTags "fixture"
        (loop [index Int 0 state Int (next-seed seed) result (Vec r/EnabledTag) []]
          (if (>= index (count enabled)) result
            (recur (+ index 1) (next-seed state)
              (conj result (r/->EnabledTag (nth enabled index)
                (subset state (conj names "absent"))
                (subset (next-seed state) (conj names "absent")))))))
        (subset (next-seed (next-seed seed)) (conj names "absent"))
        (if (= (mod seed 2) 0) "linux" "darwin")
        (= (mod seed 2) 1) (subset (next-seed seed) names)))))

(js/export
  (defn contributes? [module r/ModuleTags entry r/EnabledTag] Bool
    (or (and (member? (r/moduletags-tags module) (r/enabledtag-tag entry))
             (not (member? (r/enabledtag-minuses entry) (r/moduletags-name module))))
        (and (member? (r/moduletags-opt-in module) (r/enabledtag-tag entry))
             (member? (r/enabledtag-pluses entry) (r/moduletags-name module))))))

(js/export
  (defn model [catalog (Vec r/ModuleTags) host r/HostTags] (Vec String)
    (loop [index Int 0 active (Vec String) []]
      (if (>= index (count catalog)) (sort active)
        (let [module r/ModuleTags (nth catalog index)
              name String (r/moduletags-name module)
              selected Bool (loop [tag-index Int 0]
                (if (>= tag-index (count (r/hosttags-enabled host))) false
                  (if (contributes? module (nth (r/hosttags-enabled host) tag-index))
                    true (recur (+ tag-index 1)))))]
          (recur (+ index 1)
            (if (and selected (not (member? (r/hosttags-disabled host) name))
                     (or (not (r/hosttags-restrict-allowed host))
                         (member? (r/hosttags-allowed host) name)))
              (conj active name) active)))))))

(defn declared [catalog (Vec r/ModuleTags) tag String opt-in Bool] (Vec String)
  (loop [index Int 0 result (Vec String) []]
    (if (>= index (count catalog)) result
      (let [module r/ModuleTags (nth catalog index)]
        (recur (+ index 1)
          (if (member? (if opt-in (r/moduletags-opt-in module) (r/moduletags-tags module)) tag)
            (conj result (r/moduletags-name module)) result))))))

(defn missing-count [values (Vec String) known (Vec String)] Int
  (loop [index Int 0 total Int 0]
    (if (>= index (count values)) total
      (recur (+ index 1) (+ total (if (member? known (nth values index)) 0 1))))))

(defn diagnostics? [catalog (Vec r/ModuleTags) host r/HostTags result r/Resolution] Bool
  (loop [index Int 0 errors Int (missing-count (r/hosttags-disabled host) names) warnings Int 0]
    (if (>= index (count (r/hosttags-enabled host)))
      (and (= errors (count (r/resolution-errors result)))
           (= warnings (count (r/resolution-warnings result))))
      (let [entry r/EnabledTag (nth (r/hosttags-enabled host) index)
            defaults (Vec String) (declared catalog (r/enabledtag-tag entry) false)
            opt-ins (Vec String) (declared catalog (r/enabledtag-tag entry) true)]
        (recur (+ index 1)
          (+ errors (+ (if (= (+ (count defaults) (count opt-ins)) 0) 1 0)
                       (missing-count (r/enabledtag-pluses entry) opt-ins)))
          (+ warnings (missing-count (r/enabledtag-minuses entry) defaults)))))))

(js/export
  (defn run-properties [samples Int] Int
    (if (<= samples 0) 1
    (loop [index Int 0 seed Int 73421]
      (if (>= index samples) 0
        (let [catalog (Vec r/ModuleTags) (modules seed) config r/HostTags (host seed)
              result r/Resolution (r/resolve catalog config)]
          (if (and (= (model catalog config) (r/resolution-active result))
                   (diagnostics? catalog config result))
            (recur (+ index 1) (next-seed seed))
            (do (println (str "FAIL tag algebra seed=" seed " case=" index)) 1))))))))
