#lang beagle/js
(ns firn.codex-invocation-controller-test
  (:require [firn.codex-invocation-controller :as controller]))

(def challenge String "12345678-1234-4abc-8def-1234567890ab")
(def digest String
  "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")

(defn valid-handshake [] String
  (str "{\"version\":\"InvocationFirewallHandshake/v1\","
    "\"kind\":\"challenge\","
    "\"challenge\":\"" challenge "\","
    "\"consumer_pid\":4242}"))

(defn tool-shape [name String] String
  (str
    "{\"tool\":{\"name\":\"" name "\",\"namespace\":null},"
    "\"payload_kind\":\"FUNCTION\","
    "\"schema_digest\":\"" digest "\"}"))

(defn valid-request [] String
  (str
    "{\"record\":\"invocation\","
    "\"version\":\"InvocationFirewallRequest/v1\","
    "\"request_id\":\"request-1\","
    "\"scope\":{\"session_id\":\"session-1\",\"turn_id\":\"turn-1\","
    "\"actor\":\"codex:/root\",\"call_slot\":1},"
    "\"catalog_digest\":\"" digest "\","
    "\"emitted\":" (tool-shape "get_goal") ","
    "\"catalog\":[" (tool-shape "get_goal") "," (tool-shape "wait") "]}"))

(defn starts-at?
  [source String
   offset Int
   wanted String] Bool
  (and (<= (+ offset (count wanted)) (count source))
       (= (subs source offset (+ offset (count wanted))) wanted)))

(defn find-substring
  [source String
   wanted String] Int
  (loop [offset Int 0]
    (cond
      (> (+ offset (count wanted)) (count source)) -1
      (starts-at? source offset wanted) offset
      :else (recur (+ offset 1)))))

(defn replace-once
  [source String
   before String
   after String] String
  (let [at Int (find-substring source before)]
    (if (< at 0)
      source
      (str (subs source 0 at) after
        (subs source (+ at (count before)) (count source))))))

(defn handshake-cases [] Bool
  (and
    (= (controller/validate-handshake (valid-handshake) 4242) challenge)
    (= (controller/validate-handshake (valid-handshake) 4243) "")
    (= (controller/validate-handshake
         (replace-once (valid-handshake)
           "\"consumer_pid\":4242"
           "\"consumer_pid\":4242,\"consumer_pid\":4242")
         4242)
       "")
    (= (controller/validate-handshake
         (replace-once (valid-handshake) "12345678" "1234567A")
         4242)
       "")
    (= (controller/render-handshake-response challenge 77 1000)
       (str
         "{\"version\":\"InvocationFirewallHandshake/v1\","
         "\"kind\":\"response\",\"challenge\":\"" challenge "\","
         "\"controller_pid\":77,\"controller_uid\":1000}"))))

(defn request-cases [] Bool
  (let [request String (valid-request)]
    (and
      (= (controller/validate-request request) "request-1")
      (= (controller/render-no-expectation "request-1")
         "{\"record\":\"no_expectation\",\"version\":\"ControlExpectation/v2\",\"request_id\":\"request-1\"}")
      (= (controller/validate-request
           (replace-once request
             "\"request_id\":\"request-1\""
             "\"request_id\":\"request-1\",\"request_id\":\"request-2\""))
         "")
      (= (controller/validate-request
           (replace-once request
             "\"request_id\":\"request-1\""
             "\"request_id\":\"request-1\",\"unknown\":true"))
         "")
      (= (controller/validate-request
           (replace-once request "\"call_slot\":1" "\"call_slot\":0"))
         "")
      (= (controller/validate-request
           (replace-once request "\"call_slot\":1"
             "\"call_slot\":18446744073709551615"))
         "request-1")
      (= (controller/validate-request
           (replace-once request "\"call_slot\":1"
             "\"call_slot\":18446744073709551616"))
         "")
      (= (controller/validate-request
           (replace-once request
             (str ",\"schema_digest\":\"" digest "\"")
             ""))
         "request-1")
      (= (controller/validate-request
           (replace-once request
             (str "\"schema_digest\":\"" digest "\"")
             "\"schema_digest\":null"))
         "")
      (= (controller/validate-request
           (replace-once request digest
             "sha256:zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"))
         "")
      (= (controller/validate-request
           (replace-once request
             (str "[" (tool-shape "get_goal") "," (tool-shape "wait") "]")
             (str "[" (tool-shape "wait") "," (tool-shape "get_goal") "]")))
         "")
      (= (controller/validate-request
           (replace-once request
             (str "[" (tool-shape "get_goal") "," (tool-shape "wait") "]")
             (str "[" (tool-shape "get_goal") "," (tool-shape "get_goal") "]")))
         ""))))

(js/export
  (defn run-tests [] Int
  (if (and (handshake-cases) (request-cases))
    0
    (do
      (println "FAIL: codex invocation controller protocol")
      1))))
