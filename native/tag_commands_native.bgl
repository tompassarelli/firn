#lang beagle
(ns firn.tag-commands-native
  (:require [firn.tag-resolve :as r]
            [firn.tag-resolve-native :as repository]
            [firn.tag-commands :as commands]
            [firn.tag-commands-driver :as driver]))

(def max-source-bytes Int 16777216)

(defunion HostDocumentLoadResult
  (HostDocumentLoaded [(document commands/HostDocument)])
  (HostDocumentMissing [(host String)])
  (HostDocumentLoadRejected [(message String)]))

(defunion HostDocumentsLoadResult
  (HostDocumentsLoaded [(documents (Vec commands/HostDocument))])
  (HostDocumentsLoadRejected [(message String)]))

(defn path [(root String) (relative String)] String
  (str root "/" relative))

(defn errno-message
  [(label String) (operation String) (relative String) (errno Int)] String
  (str label ": " operation " '" relative "': errno " errno "\n"))

(defn parse-message [(relative String) (message String) (offset Int)] String
  (str "firn: invalid host tag source '" relative "' at offset " offset
    ": " message "\n"))

(defn finish-host-document
  [(host String)
   (relative String)
   (source String)
   (allowed (Vec String))]
  HostDocumentLoadResult
  (match (commands/host-document-from-source host source allowed)
    [(HostDocumentRejected message offset)
     (->HostDocumentLoadRejected (parse-message relative message offset))]
    [(HostDocumentParsed document) (->HostDocumentLoaded document)]))

(defn parse-host-document
  [(root String)
   (host String)
   (relative String)
   (source String)]
  HostDocumentLoadResult
  (match (commands/host-document-from-source host source [])
    [(HostDocumentRejected message offset)
     (->HostDocumentLoadRejected (parse-message relative message offset))]
    [(HostDocumentParsed preliminary)
     (if (= "darwin"
            (r/hosttags-platform
              (commands/hostdocument-tags preliminary)))
       (match (repository/load-darwin-allowlist root)
         [(AllowlistRejected message) (->HostDocumentLoadRejected message)]
         [(AllowlistLoaded allowed)
          (finish-host-document host relative source allowed)])
       (->HostDocumentLoaded preliminary))]))

(defn load-host-document [(root String) (host String)] HostDocumentLoadResult
  (let [(relative String) (str "hosts/" host "/enabled-tags.bnix")
        (absolute String) (path root relative)]
    (match (host.fs/path-kind absolute)
      [(host.fs/PathKindError errno)
       (if (= errno 2)
         (->HostDocumentMissing host)
         (->HostDocumentLoadRejected
           (errno-message "firn" "cannot inspect" relative errno)))]
      [(host.fs/PathKindOk kind)
       (if (not (or (= kind 1) (= kind 3)))
         (->HostDocumentMissing host)
         (match (host.fs/read-text-bounded absolute max-source-bytes)
           [(host.fs/ReadTextBoundedError errno)
            (->HostDocumentLoadRejected
              (errno-message "firn" "cannot read" relative errno))]
           [(host.fs/ReadTextBoundedOk source)
            (parse-host-document root host relative source)]))])))

(defn load-action-hosts
  [(root String) (action driver/TagCommandAction)] HostDocumentsLoadResult
  (let [(wanted (U String Nil)) (driver/action-host action)]
    (if (nil? wanted)
      (->HostDocumentsLoaded [])
      (let [(host String) wanted]
        (match (load-host-document root host)
          [(HostDocumentLoadRejected message)
           (->HostDocumentsLoadRejected message)]
          [(HostDocumentMissing missing)
           (->HostDocumentsLoaded [])]
          [(HostDocumentLoaded document)
           (->HostDocumentsLoaded [document])])))))

(defn emit-io-error [(message String)] Int
  (do (host.stderr/write-text message) 1))

(defn write-error
  [(label String) (operation String) (relative String) (errno Int)] Int
  (emit-io-error (errno-message label operation relative errno)))

(defn execute-write
  [(root String)
   (outcome driver/TagCommandOutcome)
   (index Int)
   (relative String)
   (text String)
   (make-parents Bool)
   (label String)]
  Int
  (let [(absolute String) (path root relative)]
    (if make-parents
      (match (host.fs/make-parent-directories absolute)
        [(host.fs/MakeParentDirectoriesError errno)
         (write-error label "cannot create parent for" relative errno)]
        [(host.fs/MakeParentDirectoriesOk)
         (match (host.fs/write-text-atomic absolute text)
           [(host.fs/WriteTextAtomicError errno)
            (write-error label "cannot write" relative errno)]
           [(host.fs/WriteTextAtomicOk)
            (execute-effects root outcome (+ index 1))])])
      (match (host.fs/write-text-atomic absolute text)
        [(host.fs/WriteTextAtomicError errno)
         (write-error label "cannot write" relative errno)]
        [(host.fs/WriteTextAtomicOk)
         (execute-effects root outcome (+ index 1))]))))

(defn execute-effects
  [(root String) (outcome driver/TagCommandOutcome) (index Int)] Int
  (if (>= index (count (driver/tagcommandoutcome-effects outcome)))
    (driver/tagcommandoutcome-status outcome)
    (match (nth (driver/tagcommandoutcome-effects outcome) index)
      [(CommandStdout text)
       (do (print text) (execute-effects root outcome (+ index 1)))]
      [(CommandStderr text)
       (do (host.stderr/write-text text)
           (execute-effects root outcome (+ index 1)))]
      [(CommandWrite relative text make-parents label)
       (execute-write root outcome index relative text make-parents label)])))

(defn run-with-modules
  [(root String)
   (action driver/TagCommandAction)
   (modules (Vec r/ModuleTags))]
  Int
  (match (load-action-hosts root action)
    [(HostDocumentsLoadRejected message) (emit-io-error message)]
    [(HostDocumentsLoaded documents)
     (execute-effects root
       (driver/run-tag-command
         (driver/->TagCommandRepository modules documents)
         action)
       0)]))

(defn run-loaded-action [(root String) (action driver/TagCommandAction)] Int
  (if (driver/action-needs-modules? action)
    (match (repository/load-modules root)
      [(ModulesRejected message) (emit-io-error message)]
      [(ModulesLoaded modules) (run-with-modules root action modules)])
    (run-with-modules root action [])))

(defn run-action [(root String) (action driver/TagCommandAction)] Int
  (match (driver/preload-tag-command action)
    [(TagCommandRefusal outcome) (execute-effects root outcome 0)]
    [(TagCommandLoad) (run-loaded-action root action)]))

(defn repository-root [] (U String Nil)
  (let [(explicit (U String Nil)) (System/getenv "FIRN_REPO")]
    (if (some? explicit)
      explicit
      (let [(home (U String Nil)) (System/getenv "HOME")]
        (if (some? home)
          (str home "/code/nixos-config/main")
          nil)))))

(defn default-host [] String
  (let [(host (U String Nil)) (System/getenv "FIRN_HOST")]
    (if (some? host) host "whiterabbit")))

(defn usage-error [] Int
  (do
    (host.stderr/write-text
      (str
        "Usage: firn tag <list|show|filter|index|status|enable|disable|"
        "opt-in|opt-out> [<leaf>]\n"
        "       firn module <enable|disable> <name>\n"))
    64))

(defn -main [(args (Vec String))] Int
  (match (driver/parse-tag-command-argv args (default-host))
    [(OtherTagCommand argv) (usage-error)]
    [(InvalidTagCommand argv) (usage-error)]
    [(ParsedTagCommand action)
     (let [(root (U String Nil)) (repository-root)]
       (if (nil? root)
         (do
           (host.stderr/write-text
             "firn: FIRN_REPO and HOME are not set\n")
           1)
         (run-action root action)))]))
