#lang beagle/js
(ns firn.schema-transaction-test
  (:require [clojure.string :as str] [firn.schema-transaction :as transaction]))

(defn tool-files [seed Int] (Vec transaction/ToolFile)
  [
    (transaction/->ToolFile
      "bin/beagle-extract-schema"
      (str "extract-v1" (if (= seed 0) "" seed) "\n"))
    (transaction/->ToolFile "bin/beagle-validate" (str "validate-v1" (if (= seed 0) "" seed) "\n"))
    (transaction/->ToolFile "beagle-lib/schema.rkt" "#lang racket/base\n")])

(defn changed-tool-files [seed Int] (Vec transaction/ToolFile)
  [
    (transaction/->ToolFile
      "bin/beagle-extract-schema"
      (str "extract-v1" (if (= seed 0) "" seed) "\n"))
    (transaction/->ToolFile "bin/beagle-validate" (str "validate-v1" (if (= seed 0) "" seed) "\n"))
    (transaction/->ToolFile "beagle-lib/schema.rkt" "#lang racket/base\n2\n")])

(defn lock-source [seed Int nixpkgs-rev String darwin-rev String north-rev String] String
  (str
    "{\"nodes\":{"
    "\"north-node\":{\"locked\":{\"rev\":"
    "\""
    north-rev
    "\",\"narHash\":\"north\"}},"
    "\"darwin-node\":{\"locked\":{\"rev\":"
    "\""
    darwin-rev
    "\",\"narHash\":\"darwin\"}},"
    "\"hm-node\":{\"locked\":{\"rev\":\"hm-1\","
    "\"narHash\":\"hm\"}},"
    "\"nixpkgs-node\":{"
    "\"inputs\":{\"home-manager\":\"hm-node\"},"
    "\"locked\":{\"rev\":\""
    nixpkgs-rev
    "\",\"narHash\":\"nixpkgs\"}},"
    "\"root\":{\"inputs\":{"
    "\"north\":\"north-node\","
    "\"nix-darwin\":\"darwin-node\","
    "\"home-manager\":[\"nixpkgs\",\"home-manager\"],"
    "\"nixpkgs\":\"nixpkgs-node\"}}},"
    "\"root\":\"root\"}"))

(defn fingerprint [seed Int lock String mode transaction/SchemaMode files (Vec transaction/ToolFile)] String
  (match (transaction/schema-input-fingerprint lock mode files)
    [(FingerprintRejected message) ""]
    [(FingerprintReady value) value]))

(js/export
  (defn real-lock-fingerprint-valid? [lock String] Bool
    (match (transaction/schema-input-fingerprint lock (transaction/nixos-mode) (tool-files 0))
      [(FingerprintRejected message) false]
      [(FingerprintReady value) (= 64 (count value))])))

(defn case-sha256-and-canonical-json [seed Int] Bool
  (let [a String (str "{\"z\":" seed ",\"a\":true}") b String (str "{\"a\":true,\"z\":" seed "}")]
    (match (transaction/canonical-json a)
      [(CanonicalJsonRejected message offset) false]
      [
        (CanonicalJson first)
        (match (transaction/canonical-json b)
          [(CanonicalJsonRejected message offset) false]
          [(CanonicalJson second) (and (= first second) (= first b))])])))

(defn case-fingerprint-input-authority [seed Int] Bool
  (let [
     (initial String)
     (fingerprint
       seed
       (lock-source
         seed
         (str "nixpkgs-1" (if (= seed 0) "" seed))
         (str "darwin-1" (if (= seed 0) "" seed))
         (str "north-1" (if (= seed 0) "" seed)))
       (transaction/nixos-mode)
       (tool-files seed))
     (irrelevant String)
     (fingerprint
       seed
       (lock-source
         seed
         (str "nixpkgs-1" (if (= seed 0) "" seed))
         (str "darwin-1" (if (= seed 0) "" seed))
         (str "north-2" (if (= seed 0) "" seed)))
       (transaction/nixos-mode)
       (tool-files seed))
     (nixpkgs-changed String)
     (fingerprint
       seed
       (lock-source
         seed
         (str "nixpkgs-2" (if (= seed 0) "" seed))
         (str "darwin-1" (if (= seed 0) "" seed))
         (str "north-1" (if (= seed 0) "" seed)))
       (transaction/nixos-mode)
       (tool-files seed))
     (darwin-initial String)
     (fingerprint
       seed
       (lock-source
         seed
         (str "nixpkgs-1" (if (= seed 0) "" seed))
         (str "darwin-1" (if (= seed 0) "" seed))
         (str "north-1" (if (= seed 0) "" seed)))
       (transaction/darwin-mode)
       (tool-files seed))
     (darwin-changed String)
     (fingerprint
       seed
       (lock-source
         seed
         (str "nixpkgs-1" (if (= seed 0) "" seed))
         (str "darwin-2" (if (= seed 0) "" seed))
         (str "north-1" (if (= seed 0) "" seed)))
       (transaction/darwin-mode)
       (tool-files seed))]
    (and
      (= 64 (count initial))
      (= initial irrelevant)
      (not= initial nixpkgs-changed)
      (not= darwin-initial darwin-changed))))

(defn case-fingerprint-tool-authority [seed Int] Bool
  (let [
     (lock String)
     (lock-source
       seed
       (str "nixpkgs-1" (if (= seed 0) "" seed))
       (str "darwin-1" (if (= seed 0) "" seed))
       (str "north-1" (if (= seed 0) "" seed)))]
    (not=
      (fingerprint seed lock (transaction/nixos-mode) (tool-files seed))
      (fingerprint seed lock (transaction/nixos-mode) (changed-tool-files seed)))))

(defn case-fingerprint-refusals [seed Int] Bool
  (and
    (match (transaction/schema-input-fingerprint "{}" (transaction/nixos-mode) (tool-files seed))
      [(FingerprintRejected message) true]
      [(FingerprintReady value) false])
    (match (transaction/schema-input-fingerprint
       (str/replace
         (lock-source
           seed
           (str "nixpkgs-1" (if (= seed 0) "" seed))
           (str "darwin-1" (if (= seed 0) "" seed))
           (str "north-1" (if (= seed 0) "" seed)))
         "\"home-manager\":[\"nixpkgs\",\"home-manager\"],"
         "")
       (transaction/nixos-mode)
       (tool-files seed))
      [(FingerprintRejected message) true]
      [(FingerprintReady value) false])))

(defn case-schema-and-policy-validation [seed Int] Bool
  (and
    (instance? transaction/JsonPolicyValid (transaction/json-array-nonempty "[{\"name\":\"x\"}]"))
    (instance? transaction/JsonPolicyRejected (transaction/json-array-nonempty "[]"))
    (instance? transaction/JsonPolicyRejected (transaction/json-array-nonempty "[{"))
    (instance? transaction/JsonPolicyValid (transaction/json-object-policy "{}"))
    (instance? transaction/JsonPolicyRejected (transaction/json-object-policy "[]"))))

(defn current-nixos-cache [seed Int] transaction/NixosCacheSnapshot
  (transaction/->NixosCacheSnapshot
    "[{\"name\":\"x\"}]"
    "[{\"name\":\"home.x\"}]"
    (str "fingerprint" (if (= seed 0) "" seed) "\n")
    "{\"freeformKeyPrefixes\":[]}\n"
    "{\"freeformKeyPrefixes\":[]}\n"))

(defn case-cache-authority [seed Int] Bool
  (and
    (instance?
      transaction/CacheCurrent
      (transaction/nixos-cache-assessment
        (current-nixos-cache seed)
        (str "fingerprint" (if (= seed 0) "" seed))))
    (match (transaction/nixos-cache-assessment
       (transaction/->NixosCacheSnapshot
         "[{\"name\":\"x\"}]"
         nil
         (str "fingerprint" (if (= seed 0) "" seed) "\n")
         "{}"
         "{}")
       (str "fingerprint" (if (= seed 0) "" seed)))
      [(CacheCurrent fingerprint) false]
      [(CacheStale reason) true])
    (match (transaction/nixos-cache-assessment
       (transaction/->NixosCacheSnapshot
         "[{"
         "[]"
         (str "fingerprint" (if (= seed 0) "" seed) "\n")
         "{}"
         "{}")
       (str "fingerprint" (if (= seed 0) "" seed)))
      [(CacheCurrent fingerprint) false]
      [(CacheStale reason) true])
    (match (transaction/nixos-cache-assessment
       (transaction/->NixosCacheSnapshot
         "[{\"name\":\"x\"}]"
         "[{\"name\":\"home.x\"}]"
         "old\n"
         "{}"
         "{}")
       (str "fingerprint" (if (= seed 0) "" seed)))
      [(CacheCurrent fingerprint) false]
      [(CacheStale reason) true])))

(defn case-exact-input-selection [seed Int] Bool
  (let [
     (discovered (Vec String))
     [
       (str "z" seed ".bnix")
       "tests/fixtures/bad.bnix"
       "flake.bnix"
       ".direnv/hidden.bnix"
       (str "modules/a/" (if (= seed 0) "" seed) "default.bnix")
       "hardware-configuration.nix"
       (str "modules/a/" (if (= seed 0) "" seed) "default.nix")]]
    (and
      (=
        (transaction/select-bnix-inputs discovered [])
        [
          "flake.bnix"
          (str "modules/a/" (if (= seed 0) "" seed) "default.bnix")
          (str "z" seed ".bnix")])
      (=
        (transaction/select-bnix-inputs discovered [(str "z" seed ".bnix")])
        [(str "z" seed ".bnix")])
      (=
        (transaction/filter-sorted-nix discovered)
        [(str "modules/a/" (if (= seed 0) "" seed) "default.nix")]))))

(defn case-argv-grammar [seed Int] Bool
  (and
    (match (transaction/parse-schema-transaction-argv ["schema" "extract"])
      [
        (ExtractSchema mode host)
        (and (instance? transaction/NixosSchema mode) (= host "whiterabbit"))]
      [(ValidateSchema inputs) false]
      [(InvalidSchemaTransaction argv) false])
    (match (transaction/parse-schema-transaction-argv ["schema" "extract" "--darwin" "mac"])
      [(ExtractSchema mode host) (and (instance? transaction/DarwinSchema mode) (= host "mac"))]
      [(ValidateSchema inputs) false]
      [(InvalidSchemaTransaction argv) false])
    (match (transaction/parse-schema-transaction-argv
       ["repo" "validate" (str "a" seed ".bnix") (str "b" seed ".bnix")])
      [(ValidateSchema inputs) (= inputs [(str "a" seed ".bnix") (str "b" seed ".bnix")])]
      [(ExtractSchema mode host) false]
      [(InvalidSchemaTransaction argv) false])
    (match (transaction/parse-schema-transaction-argv ["repo" "validate" "all"])
      [(ValidateSchema inputs) (empty? inputs)]
      [(ExtractSchema mode host) false]
      [(InvalidSchemaTransaction argv) false])
    (instance?
      transaction/InvalidSchemaTransaction
      (transaction/parse-schema-transaction-argv ["schema" "extract" "x" "y"]))
    (instance?
      transaction/InvalidSchemaTransaction
      (transaction/parse-schema-transaction-argv ["schema" "extract" "--darwin"]))))

(defn rfc6234-section8-5-sha256-abc-reference? [] Bool
  (=
    (sha256-bytes (utf8-encode "abc"))
    "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"))

(js/export
  (defn run-properties [samples Int] Int
    (if (<= samples 0)
      1
      (if (not (and (rfc6234-section8-5-sha256-abc-reference?)
          (case-fingerprint-refusals 0)
          (case-schema-and-policy-validation 0)
          (case-cache-authority 0)
          (case-exact-input-selection 0)
          (case-argv-grammar 0)))
        1
        (loop [index Int 0 seed Int 0]
          (if (>= index samples)
            0
            (if (and
               (case-sha256-and-canonical-json seed)
               (case-fingerprint-input-authority seed)
               (case-fingerprint-tool-authority seed))
              (recur (+ index 1) (if (= seed 0) 73421 (mod (* seed 48271) 2147483647)))
              (do (println (str "FAIL firn.schema-transaction-test property seed=" seed)) 1))))))))
