#lang beagle/js
(ns activity.focus-test
  (:require [activity.core :as a]
            [activity.driver :as d]))

(defn workspace
  [id Int
   idx Int
   name (U String Nil)
   window (U Int Nil)] a/Workspace
  (a/->Workspace id idx name "DP-1" false false false window))

(defn focused-workspace
  [id Int
   idx Int
   name (U String Nil)] a/Workspace
  (a/->Workspace id idx name "DP-1" true true false nil))

(defn membership-activity
  [state a/ActivityState workspace-id Int] (U String Nil)
  (let [members (Vec a/Membership) (a/activitystate-members state)]
    (loop [(index Int) 0]
      (if (>= index (count members))
        nil
        (let [entry a/Membership (nth members index)]
          (if (= (a/membership-workspace-id entry) workspace-id)
            (a/membership-activity entry)
            (recur (+ index 1))))))))

(defn persistent-activity-sequence? [] Bool
  (let [defs (Vec a/ActivityDef) [(a/->ActivityDef "home" "home" [] [])
         (a/->ActivityDef "gjoa" "gjoa" [] [])
         (a/->ActivityDef "acme" "acme" [] [])]
        base a/ActivityState (a/->ActivityState defs "home" [] [] [] "home" "home" [])
        start-workspaces (Vec a/Workspace) [(workspace 1 1 "notes" 10) (workspace 2 2 nil nil)]
        start a/ActivityState (a/apply-workspaces base start-workspaces)
        gjoa-plan d/CommandPlan (d/plan-command start start-workspaces (a/->Goto "gjoa"))
        gjoa-steps (Vec d/PlannedStep) (d/commandplan-steps gjoa-plan)
        gjoa-workspaces (Vec a/Workspace) [(workspace 1 1 "notes" 10)
         (focused-workspace 2 2 "gjoa")
         (workspace 3 3 nil nil)]
        gjoa-state a/ActivityState (a/apply-workspaces (d/commandplan-state gjoa-plan) gjoa-workspaces)
        acme-plan d/CommandPlan (d/plan-command gjoa-state gjoa-workspaces (a/->Goto "acme"))
        acme-steps (Vec d/PlannedStep) (d/commandplan-steps acme-plan)
        all-workspaces (Vec a/Workspace) [(workspace 1 1 "notes" 10)
         (workspace 2 2 "gjoa" nil)
         (focused-workspace 3 3 "acme")
         (workspace 4 4 nil nil)]
        all-state a/ActivityState (a/apply-workspaces (d/commandplan-state acme-plan) all-workspaces)
        back-plan d/CommandPlan (d/plan-command all-state all-workspaces (a/->Goto "gjoa"))
        back-steps (Vec d/PlannedStep) (d/commandplan-steps back-plan)
        restarted a/ActivityState (a/apply-workspaces
          (a/->ActivityState defs "home" [] [] [] "home" "home" [])
          all-workspaces)
        restart-plan d/CommandPlan (d/plan-command restarted all-workspaces (a/->Goto "gjoa"))
        restart-steps (Vec d/PlannedStep) (d/commandplan-steps restart-plan)]
    (and
      (d/commandplan-settled gjoa-plan)
      (match (nth gjoa-steps 0)
        [(NameWorkspaceStep reference name)
         (and (= reference "2") (= name "gjoa"))]
        [(FocusStep reference) false]
        [(MoveColumnStep reference) false]
        [(ReorderStep reference id target-index) false]
        [(SnapshotStep snapshot) false]
        [(PersistStep assignments) false])
      (= (membership-activity gjoa-state 2) "gjoa")
      (nil? (membership-activity gjoa-state 3))
      (d/commandplan-settled acme-plan)
      (match (nth acme-steps 0)
        [(NameWorkspaceStep reference name)
         (and (= reference "3") (= name "acme"))]
        [(FocusStep reference) false]
        [(MoveColumnStep reference) false]
        [(ReorderStep reference id target-index) false]
        [(SnapshotStep snapshot) false]
        [(PersistStep assignments) false])
      (= (membership-activity all-state 1) "home")
      (= (membership-activity all-state 2) "gjoa")
      (= (membership-activity all-state 3) "acme")
      (nil? (membership-activity all-state 4))
      (match (nth back-steps 0)
        [(FocusStep reference) (= reference "gjoa")]
        [(MoveColumnStep reference) false]
        [(NameWorkspaceStep reference name) false]
        [(ReorderStep reference id target-index) false]
        [(SnapshotStep snapshot) false]
        [(PersistStep assignments) false])
      (= (membership-activity restarted 1) "home")
      (= (membership-activity restarted 2) "gjoa")
      (= (membership-activity restarted 3) "acme")
      (nil? (membership-activity restarted 4))
      (match (nth restart-steps 0)
        [(FocusStep reference) (= reference "gjoa")]
        [(MoveColumnStep reference) false]
        [(NameWorkspaceStep reference name) false]
        [(ReorderStep reference id target-index) false]
        [(SnapshotStep snapshot) false]
        [(PersistStep assignments) false]))))

(js/export
  (defn run [args (Vec String)] Int
    (let [persistent-passed Bool (persistent-activity-sequence?)]
      (do
        (println (if persistent-passed
          "PASS persistent-activity-sequence"
          "FAIL persistent-activity-sequence"))
        (if persistent-passed 0 1)))))
