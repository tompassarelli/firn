#lang beagle
(ns firn.prewarm-test
  (:require [firn.prewarm :as p]))

(defrecord TestResult
  [name String
   passed Bool])

(defn case-container-main-resolution [] Bool
  (and
    (= (p/container-main-candidates
         "/srv/firn/worktrees/prewarm" "/srv/firn/main/.git")
       ["/srv/firn/main" "/srv/firn/worktrees/prewarm"])
    (= (p/container-main-candidates
         "/srv/firn/pins/0123" "/srv/firn/main/.git")
       ["/srv/firn/main" "/srv/firn/pins/0123"])
    (= (p/container-main-candidates
         "/srv/firn/main" "/srv/firn/main/.git")
       ["/srv/firn/main"])))

(defn case-snapshot-and-target [] Bool
  (let [(on-branch p/WarmSpec)
          (p/warm-spec
            (p/->Snapshot "/srv/firn/main" "abc123" "main"
              "whiterabbit" "linux"))
        (detached p/WarmSpec)
          (p/warm-spec
            (p/->Snapshot "/srv/firn/main" "def456" nil
              "macbook" "darwin"))]
    (and
      (= (p/warmspec-key on-branch)
         (str
           "git+file:///srv/firn/main?rev=abc123&ref=main#"
           "nixosConfigurations.whiterabbit.config.system.build.toplevel"))
      (= (p/warmspec-key detached)
         (str
           "git+file:///srv/firn/main?rev=def456#"
           "darwinConfigurations.macbook.system")))))

(defn case-host-selection [] Bool
  (and (= (p/short-host "whiterabbit.example") "whiterabbit")
       (= (p/short-host "whiterabbit") "whiterabbit")))

(defn case-lease-codec [] Bool
  (let [(owner p/LeaseOwner) (p/->LeaseOwner 41 42 "snapshot-key")]
    (and
      (= (p/render-lease-owner owner) "41\n42\nsnapshot-key\n")
      (match (p/parse-lease-owner (p/render-lease-owner owner))
        [(LeaseOwnerInvalid message) false]
        [(LeaseOwnerParsed parsed) (= parsed owner)])
      (match (p/parse-lease-owner "41\nnope\nkey\n")
        [(LeaseOwnerInvalid message) (> (count message) 0)]
        [(LeaseOwnerParsed parsed) false]))))

(defn case-exact-process-identity [] Bool
  (let [(owner p/LeaseOwner) (p/->LeaseOwner 41 42 "old-key")
        (worker p/ProcessIdentity)
          (p/->ProcessIdentity 41
            (p/worker-argv "/bin/firn" "/srv/firn/main" "old-key"))
        (child p/ProcessIdentity)
          (p/->ProcessIdentity 42 (p/nix-build-argv "old-key"))
        (impostor p/ProcessIdentity)
          (p/->ProcessIdentity 42 ["nix" "build" "unrelated"])]
    (and
      (match
        (p/supersede-plan "old-key" 99 "/bin/firn"
          "/srv/firn/main" owner worker child)
        [(LeaseDeduplicated key) (= key "old-key")]
        [(LeaseSupersede child-pid worker-pid) false]
        [(LeaseContended key) false])
      (match
        (p/supersede-plan "new-key" 99 "/bin/firn"
          "/srv/firn/main" owner worker child)
        [(LeaseDeduplicated key) false]
        [(LeaseSupersede child-pid worker-pid)
         (and (= child-pid 42) (= worker-pid 41))]
        [(LeaseContended key) false])
      (match
        (p/supersede-plan "new-key" 99 "/bin/firn"
          "/srv/firn/main" owner worker impostor)
        [(LeaseDeduplicated key) false]
        [(LeaseSupersede child-pid worker-pid) false]
        [(LeaseContended key) (= key "old-key")]))))

(defn case-command-line-decoding [] Bool
  (= (p/command-argv "nix|build|--no-link|")
     ["nix" "build" "--no-link"]))

(defn case-lock-errno [] Bool
  (and (p/lock-contention? 11)
       (p/lock-contention? 35)
       (not (p/lock-contention? 13))))

(defn case-stamp-lifecycle [] Bool
  (and
    (p/stamp-current? "warm-key\n" "warm-key")
    (not (p/stamp-current? "old-key\n" "warm-key"))
    (match (p/stamp-plan "warm-key" 0)
      [(StampWrite key) (= key "warm-key")]
      [(StampUnchanged status) false])
    (match (p/stamp-plan "warm-key" 143)
      [(StampWrite key) false]
      [(StampUnchanged status) (= status 143)])))

(defn case-detached-low-priority-plan [] Bool
  (= (p/detached-worker-argv
       "/bin/firn" "/srv/firn/main" "warm-key")
     ["setsid" "-f" "nice" "-n" "19" "ionice" "-c" "3"
      "/bin/firn" "--worker" "/bin/firn"
      "/srv/firn/main" "warm-key"]))

(defn case-reference-transaction-plan [] Bool
  (let [(zero String) "0000000000000000000000000000000000000000"
        (new String) "1111111111111111111111111111111111111111"
        (main-line String) (str zero " " new " refs/heads/main")
        (lane-line String) (str zero " " new " refs/heads/lane")]
    (and
      (p/transaction-fires? "committed" [lane-line main-line])
      (not (p/transaction-fires? "prepared" [main-line]))
      (not (p/transaction-fires? "aborted" [main-line]))
      (not (p/transaction-fires? "committed"
             [(str new " " zero " refs/heads/main")]))
      (not (p/transaction-fires? "committed"
             [(str new " " new " refs/heads/main")]))
      (match
        (p/hook-plan "committed" [lane-line main-line]
          "/bin/firn" "/srv/firn/main" "warm-key")
        [(HookIgnored state) false]
        [(HookLaunch argv)
         (= argv
            (p/detached-worker-argv
              "/bin/firn" "/srv/firn/main" "warm-key"))])
      (match
        (p/hook-plan "prepared" [main-line]
          "/bin/firn" "/srv/firn/main" "warm-key")
        [(HookIgnored state) (= state "prepared")]
        [(HookLaunch argv) false]))))

(defn case-rebuild-detection [] Bool
  (and
    (p/rebuild-argv? ["firn" "rebuild"])
    (p/rebuild-argv? ["/bin/firn" "host" "rebuild" "whiterabbit"])
    (not (p/rebuild-argv? ["firn" "--worker"]))
    (not (p/rebuild-argv? ["tool" "firn-rebuild-not-the-command"]))))

(def tests (Vec TestResult)
  [(->TestResult "container-main-resolution" (case-container-main-resolution))
   (->TestResult "snapshot-and-target" (case-snapshot-and-target))
   (->TestResult "host-selection" (case-host-selection))
   (->TestResult "lease-codec" (case-lease-codec))
   (->TestResult "exact-process-identity" (case-exact-process-identity))
   (->TestResult "command-line-decoding" (case-command-line-decoding))
   (->TestResult "lock-errno" (case-lock-errno))
   (->TestResult "stamp-lifecycle" (case-stamp-lifecycle))
   (->TestResult "detached-low-priority-plan"
     (case-detached-low-priority-plan))
   (->TestResult "reference-transaction-plan"
     (case-reference-transaction-plan))
   (->TestResult "rebuild-detection" (case-rebuild-detection))])

(defn -main [args (Vec String)] Int
  (loop [(index Int) 0]
    (if (>= index (count tests))
      0
      (let [(test TestResult) (nth tests index)]
        (if (testresult-passed test)
          (recur (+ index 1))
          (do
            (print (str "FAIL: " (testresult-name test) "\n"))
            1))))))
