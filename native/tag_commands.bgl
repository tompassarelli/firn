#lang beagle
(ns firn.tag-commands
  (:require [beagle.datum-reader :as reader]
            [native.json :as json]
            [firn.tag-resolve :as r]
            [firn.tag-inputs :as input]))

;; Resolution keeps pluses and minuses separately because their relative order
;; is semantically irrelevant. Hosted rewrites preserve that order, so the
;; editable document retains the original tokens alongside the F0 HostTags.
(defrecord EditableEnabledTag [(tag String) (edits (Vec String))])

(defrecord HostDocument [(tags r/HostTags) (enabled (Vec EditableEnabledTag))])

(defunion EditableEntryResult
  (EditableEntryParsed [(value EditableEnabledTag)])
  (EditableEntryRejected [(message String) (offset Int)]))

(defunion EditableEnabledResult
  (EditableEnabledParsed [(values (Vec EditableEnabledTag))])
  (EditableEnabledRejected [(message String) (offset Int)]))

(defunion HostDocumentResult
  (HostDocumentParsed [(value HostDocument)])
  (HostDocumentRejected [(message String) (offset Int)]))

(defrecord TagMutation [(changed Bool) (document HostDocument)])

(defunion TagModuleLeaf
  (TagModuleParsed [(tag String) (module String)])
  (TagModuleRejected [(leaf String)]))

(defunion ModuleLookup
  (ModuleFound [(value r/ModuleTags)])
  (ModuleMissing [(name String)]))

(defunion TagIndexResult
  (TagIndexRendered [(text String)])
  (TagIndexRejected [(message String)]))

(defn string-join [(values (Vec String)) (separator String)] String
  (loop [index Int 0
         result String ""]
    (if (>= index (count values))
      result
      (recur (+ index 1)
        (str result (if (= index 0) "" separator) (nth values index))))))

(defn spaces [(amount Int)] String
  (loop [remaining Int amount
         result String ""]
    (if (<= remaining 0)
      result
      (recur (- remaining 1) (str result " ")))))

(defn pad-right [(value String) (width Int)] String
  (str value (spaces (- width (count value)))))

(defn prefix-values [(prefix String) (values (Vec String))] (Vec String)
  (loop [index Int 0
         result (Vec String) []]
    (if (>= index (count values))
      result
      (recur (+ index 1)
        (conj result (str prefix (nth values index)))))))

(defn editable-from-enabled [(enabled r/EnabledTag)] EditableEnabledTag
  (->EditableEnabledTag
    (r/enabledtag-tag enabled)
    (into
      (prefix-values "+" (r/enabledtag-pluses enabled))
      (prefix-values "-" (r/enabledtag-minuses enabled)))))

(defn editable-entry
  [(events (Vec reader/ReaderEvent)) (start Int)] EditableEntryResult
  (let [(event reader/ReaderEvent) (nth events start)
        (kind Keyword) (reader/readerevent-kind event)]
    (cond
      (= kind :symbol)
      (->EditableEntryParsed
        (->EditableEnabledTag (reader/readerevent-value event) []))

      (= kind :vector/open)
      (let [(children Int) (input/container-child-count events start)]
        (if (< children 1)
          (->EditableEntryRejected "enabled tag vector cannot be empty"
            (reader/readerevent-offset event))
          (let [(tag-start Int)
                (input/container-child-start events start 0)
                (tag-event reader/ReaderEvent) (nth events tag-start)]
            (if (not= :symbol (reader/readerevent-kind tag-event))
              (->EditableEntryRejected "enabled tag name must be a symbol"
                (reader/readerevent-offset tag-event))
              (loop [child Int 1
                     edits (Vec String) []]
                (if (>= child children)
                  (->EditableEntryParsed
                    (->EditableEnabledTag
                      (reader/readerevent-value tag-event) edits))
                  (let [(edit-start Int)
                        (input/container-child-start events start child)
                        (edit-event reader/ReaderEvent) (nth events edit-start)
                        (edit String) (reader/readerevent-value edit-event)]
                    (if (or (not= :symbol
                                  (reader/readerevent-kind edit-event))
                            (not (input/valid-edit-text? edit)))
                      (->EditableEntryRejected
                        "enabled tag edit must be +module or -module"
                        (reader/readerevent-offset edit-event))
                      (recur (+ child 1) (conj edits edit))))))))))

      :else
      (->EditableEntryRejected
        "enabled tag entry must be a symbol or vector"
        (reader/readerevent-offset event)))))

(defn editable-enabled-from-events
  [(events (Vec reader/ReaderEvent))
   (field input/SpanScan)]
  EditableEnabledResult
  (cond
    (not (input/spanscan-ok field))
    (->EditableEnabledRejected (input/spanscan-message field)
      (input/spanscan-offset field))

    (not (input/spanscan-found field))
    (->EditableEnabledParsed [])

    :else
    (let [(start Int) (input/spanscan-start field)]
      (if (not= :vector/open
                (reader/readerevent-kind (nth events start)))
        (->EditableEnabledRejected ":enabled must be a vector"
          (input/event-offset events start))
        (let [(end Int) (input/datum-end events start)]
          (loop [cursor Int (+ start 1)
                 values (Vec EditableEnabledTag) []]
            (if (= cursor (- end 1))
              (->EditableEnabledParsed values)
              (match (editable-entry events cursor)
                [(EditableEntryRejected message offset)
                 (->EditableEnabledRejected message offset)]
                [(EditableEntryParsed value)
                 (recur (input/datum-end events cursor)
                   (conj values value))]))))))))

(defn editable-enabled-from-source [(source String)] EditableEnabledResult
  (let [(read reader/DatumRead) (reader/read-events source)
        (read-error String?) (reader/datumread-error read)]
    (if (some? read-error)
      (->EditableEnabledRejected read-error
        (reader/datumread-error-offset read))
      (let [(events (Vec reader/ReaderEvent)) (reader/datumread-events read)
            (host-map input/SpanScan) (input/find-host-map events)]
        (cond
          (not (input/spanscan-ok host-map))
          (->EditableEnabledRejected (input/spanscan-message host-map)
            (input/spanscan-offset host-map))

          (not (input/spanscan-found host-map))
          (->EditableEnabledRejected "missing host tag map" -1)

          :else
          (editable-enabled-from-events events
            (input/map-field events (input/spanscan-start host-map)
              ":enabled")))))))

(defn host-document-from-source
  [(host String)
   (source String)
   (darwin-allowed (Vec String))]
  HostDocumentResult
  (match (input/host-tags-from-source host source darwin-allowed)
    [(HostSourceRejected message offset)
     (->HostDocumentRejected message offset)]
    [(HostSourceParsed tags)
     (match (editable-enabled-from-source source)
       [(EditableEnabledRejected message offset)
        (->HostDocumentRejected message offset)]
       [(EditableEnabledParsed enabled)
        (->HostDocumentParsed (->HostDocument tags enabled))])]))

(defn find-module [(modules (Vec r/ModuleTags)) (name String)] ModuleLookup
  (loop [index Int 0]
    (if (>= index (count modules))
      (->ModuleMissing name)
      (let [(module r/ModuleTags) (nth modules index)]
        (if (= name (r/moduletags-name module))
          (->ModuleFound module)
          (recur (+ index 1)))))))

(defn universe-add-all
  [(universe (Vec String)) (values (Vec String))] (Vec String)
  (loop [index Int 0
         result (Vec String) universe]
    (if (>= index (count values))
      result
      (recur (+ index 1)
        (r/append-unique result (nth values index))))))

(defn tag-universe [(modules (Vec r/ModuleTags))] (Vec String)
  (loop [index Int 0
         result (Vec String) []]
    (if (>= index (count modules))
      (sort result)
      (let [(module r/ModuleTags) (nth modules index)]
        (recur (+ index 1)
          (universe-add-all
            (universe-add-all result (r/moduletags-tags module))
            (r/moduletags-opt-in module)))))))

(defn tag-membership-count
  [(modules (Vec r/ModuleTags)) (tag String) (opt-in Bool)] Int
  (loop [index Int 0
         total Int 0]
    (if (>= index (count modules))
      total
      (let [(module r/ModuleTags) (nth modules index)
            (values (Vec String))
            (if opt-in
              (r/moduletags-opt-in module)
              (r/moduletags-tags module))]
        (recur (+ index 1)
          (+ total (if (r/string-member? values tag) 1 0)))))))

(defn tagged-module-count [(modules (Vec r/ModuleTags))] Int
  (loop [index Int 0
         total Int 0]
    (if (>= index (count modules))
      total
      (let [(module r/ModuleTags) (nth modules index)]
        (recur (+ index 1)
          (+ total
            (if (or (> (count (r/moduletags-tags module)) 0)
                    (> (count (r/moduletags-opt-in module)) 0))
              1
              0)))))))

(defn render-tag-list [(modules (Vec r/ModuleTags))] String
  (let [(tags (Vec String)) (tag-universe modules)
        (heading String)
        (if (= (count tags) 0)
          (str "No tags found. Add :tags / :tags-opt-in clauses to "
            "modules' default.bnix.\n")
          (str "Tags (" (count tags) "):\n"))
        (body String)
        (loop [index Int 0
               result String heading]
          (if (>= index (count tags))
            result
            (let [(tag String) (nth tags index)
                  (defaults Int)
                  (tag-membership-count modules tag false)
                  (opt-ins Int)
                  (tag-membership-count modules tag true)]
              (recur (+ index 1)
                (str result "  " (pad-right tag 18)
                  "  (" defaults " default"
                  (if (= opt-ins 0) "" (str ", " opt-ins " opt-in"))
                  ")\n")))))]
    (str body "\nCoverage: " (tagged-module-count modules) " / "
      (count modules) " modules carry at least one tag.\n")))

(defn render-tag-show [(module r/ModuleTags)] String
  (let [(name String) (r/moduletags-name module)
        (defaults (Vec String)) (r/moduletags-tags module)
        (opt-ins (Vec String)) (r/moduletags-opt-in module)]
    (str "module: " name "\n"
      ":tags         "
      (if (= (count defaults) 0)
        (str "(none — add a :tags clause to modules/" name
          "/default.bnix)")
        (string-join defaults ", "))
      "\n:tags-opt-in  "
      (if (= (count opt-ins) 0)
        "(none)"
        (string-join opt-ins ", "))
      "\n")))

(defn modules-with-tag [(modules (Vec r/ModuleTags)) (tag String)] (Vec String)
  (loop [index Int 0
         result (Vec String) []]
    (if (>= index (count modules))
      (sort result)
      (let [(module r/ModuleTags) (nth modules index)]
        (recur (+ index 1)
          (if (or (r/string-member? (r/moduletags-tags module) tag)
                  (r/string-member? (r/moduletags-opt-in module) tag))
            (conj result (r/moduletags-name module))
            result))))))

(defn module-tag-kind [(module r/ModuleTags) (tag String)] String
  (if (r/string-member? (r/moduletags-tags module) tag)
    "default"
    "opt-in"))

(defn render-tag-filter [(modules (Vec r/ModuleTags)) (tag String)] String
  (let [(names (Vec String)) (modules-with-tag modules tag)]
    (if (= (count names) 0)
      (str "no modules tagged '" tag "'\n")
      (loop [index Int 0
             result String
             (str "modules tagged '" tag "' (" (count names) "):\n")]
        (if (>= index (count names))
          result
          (let [(name String) (nth names index)]
            (match (find-module modules name)
              [(ModuleMissing missing) (recur (+ index 1) result)]
              [(ModuleFound module)
               (recur (+ index 1)
                 (str result "  " name "  (" (module-tag-kind module tag)
                   ")\n"))])))))))

(defn append-json-strings
  [(events (Vec json/JsonEvent)) (values (Vec String))] (Vec json/JsonEvent)
  (loop [index Int 0
         result (Vec json/JsonEvent) events]
    (if (>= index (count values))
      result
      (recur (+ index 1)
        (conj result (json/->JsonString 0 (nth values index)))))))

(defn module-index-events [(module r/ModuleTags)] (Vec json/JsonEvent)
  (let [(with-name (Vec json/JsonEvent))
        [(json/->JsonObjectStart 0)
         (json/->JsonKey 0 "name")
         (json/->JsonString 0 (r/moduletags-name module))
         (json/->JsonKey 0 "tags")
         (json/->JsonArrayStart 0)]
        (with-tags (Vec json/JsonEvent))
        (append-json-strings with-name (r/moduletags-tags module))
        (with-opt-in-key (Vec json/JsonEvent))
        (into with-tags
          [(json/->JsonArrayEnd 0)
           (json/->JsonKey 0 "tags_opt_in")
           (json/->JsonArrayStart 0)])
        (with-opt-ins (Vec json/JsonEvent))
        (append-json-strings with-opt-in-key (r/moduletags-opt-in module))]
    (into with-opt-ins
      [(json/->JsonArrayEnd 0) (json/->JsonObjectEnd 0)])))

(defn render-tag-index [(modules (Vec r/ModuleTags))] TagIndexResult
  (loop [index Int 0
         result String ""]
    (if (>= index (count modules))
      (->TagIndexRendered result)
      (let [(module r/ModuleTags) (nth modules index)]
        (match (json/encode (module-index-events module))
          [(JsonEncodeError event-index message)
           (->TagIndexRejected
             (str "cannot encode module '" (r/moduletags-name module)
               "': " message))]
          [(JsonEncoded text)
           (recur (+ index 1) (str result text "\n"))])))))

(defn editable-entry-string [(entry EditableEnabledTag)] String
  (if (= (count (editableenabledtag-edits entry)) 0)
    (editableenabledtag-tag entry)
    (str "[" (editableenabledtag-tag entry) " "
      (string-join (editableenabledtag-edits entry) " ") "]")))

(defn enabled-lines [(enabled (Vec EditableEnabledTag))] String
  (if (= (count enabled) 0)
    "  []"
    (loop [index Int 0
           result String "  ["]
      (if (>= index (count enabled))
        (str result "]")
        (recur (+ index 1)
          (str result (if (= index 0) "" "\n   ")
            (editable-entry-string (nth enabled index))))))))

(defn format-enabled-tags-bnix [(document HostDocument)] String
  (let [(tags r/HostTags) (hostdocument-tags document)
        (disabled (Vec String)) (r/hosttags-disabled tags)]
    (str "#lang beagle/nix\n\n"
      "(ns enabled-tags)\n\n"
      "{:platform " (r/hosttags-platform tags) "\n"
      " :enabled\n"
      (enabled-lines (hostdocument-enabled document))
      (if (= (count disabled) 0)
        "\n}\n"
        (str "\n :disabled [" (string-join disabled " ") "]\n}\n")))))

(defn render-enabled-status [(enabled (Vec EditableEnabledTag))] String
  (if (= (count enabled) 0)
    "  (none)\n"
    (loop [index Int 0
           result String ""]
      (if (>= index (count enabled))
        result
        (recur (+ index 1)
          (str result "  " (editable-entry-string (nth enabled index))
            "\n"))))))

(defn render-disabled-status [(disabled (Vec String))] String
  (if (= (count disabled) 0)
    "  (none)\n"
    (loop [index Int 0
           result String ""]
      (if (>= index (count disabled))
        result
        (recur (+ index 1)
          (str result "  " (nth disabled index) "\n"))))))

(defn validation-error-hint [(error r/ValidationError)] String
  (match error
    [(UnknownPlatform host platform hint) hint]
    [(UnknownTag host tag hint) hint]
    [(OptInMismatch host tag module hint) hint]
    [(UnknownDisabled host module hint) hint]))

(defn render-resolution-errors [(errors (Vec r/ValidationError))] String
  (if (= (count errors) 0)
    ""
    (loop [index Int 0
           result String (str "Resolution errors (" (count errors) "):\n")]
      (if (>= index (count errors))
        (str result "\n")
        (recur (+ index 1)
          (str result "  " (validation-error-hint (nth errors index))
            "\n"))))))

(defn render-active-status [(active (Vec String))] String
  (let [(heading String) (str "Resolved active modules (" (count active)
                           "):\n")]
    (if (= (count active) 0)
      (str heading "  (none)\n")
      (loop [index Int 0
             result String heading]
        (if (>= index (count active))
          result
          (recur (+ index 1)
            (str result "  " (nth active index) "\n")))))))

(defn render-tag-status
  [(modules (Vec r/ModuleTags)) (document HostDocument)] String
  (let [(tags r/HostTags) (hostdocument-tags document)
        (enabled (Vec EditableEnabledTag)) (hostdocument-enabled document)
        (disabled (Vec String)) (r/hosttags-disabled tags)
        (resolution r/Resolution) (r/resolve modules tags)]
    (str "Host: " (r/hosttags-host tags) "\n"
      "Platform: " (r/hosttags-platform tags) "\n"
      "Source: hosts/" (r/hosttags-host tags) "/enabled-tags.bnix\n\n"
      ":enabled (" (count enabled) "):\n"
      (render-enabled-status enabled)
      "\n:disabled (" (count disabled) "):\n"
      (render-disabled-status disabled)
      "\n"
      (render-resolution-errors (r/resolution-errors resolution))
      (render-active-status (r/resolution-active resolution)))))

(defn host-with
  [(tags r/HostTags)
   (enabled (Vec r/EnabledTag))
   (disabled (Vec String))]
  r/HostTags
  (r/->HostTags
    (r/hosttags-host tags)
    enabled
    disabled
    (r/hosttags-platform tags)
    (r/hosttags-restrict-allowed tags)
    (r/hosttags-allowed tags)))

(defn enabled-index [(enabled (Vec EditableEnabledTag)) (tag String)] Int
  (loop [index Int 0]
    (if (>= index (count enabled))
      -1
      (if (= tag (editableenabledtag-tag (nth enabled index)))
        index
        (recur (+ index 1))))))

(defn enabled-without-tag
  [(enabled (Vec EditableEnabledTag)) (tag String)] (Vec EditableEnabledTag)
  (loop [index Int 0
         result (Vec EditableEnabledTag) []]
    (if (>= index (count enabled))
      result
      (let [(entry EditableEnabledTag) (nth enabled index)]
        (recur (+ index 1)
          (if (= tag (editableenabledtag-tag entry))
            result
            (conj result entry)))))))

(defn semantic-without-tag
  [(enabled (Vec r/EnabledTag)) (tag String)] (Vec r/EnabledTag)
  (loop [index Int 0
         result (Vec r/EnabledTag) []]
    (if (>= index (count enabled))
      result
      (let [(entry r/EnabledTag) (nth enabled index)]
        (recur (+ index 1)
          (if (= tag (r/enabledtag-tag entry))
            result
            (conj result entry)))))))

(defn enable-tag [(document HostDocument) (tag String)] TagMutation
  (if (>= (enabled-index (hostdocument-enabled document) tag) 0)
    (->TagMutation false document)
    (let [(tags r/HostTags) (hostdocument-tags document)]
      (->TagMutation true
        (->HostDocument
          (host-with tags
            (conj (r/hosttags-enabled tags)
              (r/enabled-tag-from-edit-texts tag []))
            (r/hosttags-disabled tags))
          (conj (hostdocument-enabled document)
            (->EditableEnabledTag tag [])))))))

(defn disable-tag [(document HostDocument) (tag String)] TagMutation
  (let [(index Int) (enabled-index (hostdocument-enabled document) tag)]
    (if (< index 0)
      (->TagMutation false document)
      (let [(tags r/HostTags) (hostdocument-tags document)]
        (->TagMutation true
          (->HostDocument
            (host-with tags
              (semantic-without-tag (r/hosttags-enabled tags) tag)
              (r/hosttags-disabled tags))
            (enabled-without-tag (hostdocument-enabled document) tag)))))))

(defn edit-member? [(edits (Vec String)) (wanted String)] Bool
  (r/string-member? edits wanted))

(defn replace-editable-tag
  [(enabled (Vec EditableEnabledTag))
   (tag String)
   (edits (Vec String))]
  (Vec EditableEnabledTag)
  (loop [index Int 0
         result (Vec EditableEnabledTag) []]
    (if (>= index (count enabled))
      result
      (let [(entry EditableEnabledTag) (nth enabled index)]
        (recur (+ index 1)
          (conj result
            (if (= tag (editableenabledtag-tag entry))
              (->EditableEnabledTag tag edits)
              entry)))))))

(defn replace-semantic-tag
  [(enabled (Vec r/EnabledTag))
   (tag String)
   (edits (Vec String))]
  (Vec r/EnabledTag)
  (loop [index Int 0
         result (Vec r/EnabledTag) []]
    (if (>= index (count enabled))
      result
      (let [(entry r/EnabledTag) (nth enabled index)]
        (recur (+ index 1)
          (conj result
            (if (= tag (r/enabledtag-tag entry))
              (r/enabled-tag-from-edit-texts tag edits)
              entry)))))))

(defn add-tag-edit
  [(document HostDocument) (tag String) (edit String)] TagMutation
  (let [(index Int) (enabled-index (hostdocument-enabled document) tag)
        (tags r/HostTags) (hostdocument-tags document)]
    (if (< index 0)
      (->TagMutation true
        (->HostDocument
          (host-with tags
            (conj (r/hosttags-enabled tags)
              (r/enabled-tag-from-edit-texts tag [edit]))
            (r/hosttags-disabled tags))
          (conj (hostdocument-enabled document)
            (->EditableEnabledTag tag [edit]))))
      (let [(existing EditableEnabledTag)
            (nth (hostdocument-enabled document) index)
            (edits (Vec String)) (editableenabledtag-edits existing)]
        (if (edit-member? edits edit)
          (->TagMutation false document)
          (let [(new-edits (Vec String)) (conj edits edit)]
            (->TagMutation true
              (->HostDocument
                (host-with tags
                  (replace-semantic-tag
                    (r/hosttags-enabled tags) tag new-edits)
                  (r/hosttags-disabled tags))
                (replace-editable-tag
                  (hostdocument-enabled document) tag new-edits)))))))))

(defn disable-module [(document HostDocument) (module String)] TagMutation
  (let [(tags r/HostTags) (hostdocument-tags document)
        (disabled (Vec String)) (r/hosttags-disabled tags)]
    (if (r/string-member? disabled module)
      (->TagMutation false document)
      (->TagMutation true
        (->HostDocument
          (host-with tags (r/hosttags-enabled tags)
            (sort (conj disabled module)))
          (hostdocument-enabled document))))))

(defn enable-module [(document HostDocument) (module String)] TagMutation
  (let [(tags r/HostTags) (hostdocument-tags document)
        (disabled (Vec String)) (r/hosttags-disabled tags)]
    (if (not (r/string-member? disabled module))
      (->TagMutation false document)
      (->TagMutation true
        (->HostDocument
          (host-with tags (r/hosttags-enabled tags)
            (r/remove-strings disabled [module]))
          (hostdocument-enabled document))))))

(defn split-tag-module [(leaf String)] TagModuleLeaf
  (loop [index Int 0]
    (if (>= index (count leaf))
      (->TagModuleRejected leaf)
      (if (= "+" (subs leaf index (+ index 1)))
        (if (and (> index 0) (< (+ index 1) (count leaf)))
          (->TagModuleParsed
            (subs leaf 0 index)
            (subs leaf (+ index 1) (count leaf)))
          (->TagModuleRejected leaf))
        (recur (+ index 1))))))
