#lang beagle
(ns firn.responsibility-projection
  (:require [beagle.datum-reader :as reader]
            [firn.tag-inputs :as input]
            [store.types :as t]))

(def member-of Keyword :member_of)
(def relationships Keyword :relationships)
(def has-responsibility Keyword :has_responsibility)
(def depends-on Keyword :depends_on)
(def requires-capability Keyword :requires_capability)
(def provides-capability Keyword :provides_capability)
(def requires-software Keyword :requires_software)
(def is-realized-by Keyword :is_realized_by)
(def is-realized-in Keyword :is_realized_in)
(def has-criticality Keyword :has_criticality)
(def has-lifecycle Keyword :has_lifecycle)
(def must-realize Keyword :must_realize)

(defrecord TripleScan
  [ok Bool
   value t/Triple?
   message String
   offset Int])

(defunion ProjectionResult
  (ProjectionParsed [propositions (Vec t/Triple)])
  (ProjectionRejected
    [message String
     offset Int]))

(defrecord RealizationExplanation
  [machine Keyword
   responsibility Keyword
   software Keyword
   module Keyword?
   capabilities (Vec Keyword)
   domain Keyword?
   criticality Keyword?
   lifecycle Keyword?])

(defrecord BootCouplingBudget
  [environment-modules-in-boot (Vec String)
   boot-environment-dependencies (Vec Keyword)
   incomplete-software (Vec Keyword)
   uncovered-capabilities (Vec Keyword)
   inadmissible-boot-software (Vec Keyword)])

(defn keyword-at
  [events (Vec reader/ReaderEvent)
   index Int] Keyword?
  (if (or (< index 0) (>= index (count events)))
    nil
    (let [event reader/ReaderEvent (nth events index)]
      (if (and (= :keyword (reader/readerevent-kind event))
               (= (+ index 1) (input/datum-end events index)))
        (keyword
          (subs (reader/readerevent-value event)
                1
                (count (reader/readerevent-value event))))
        nil))))

(defn read-triple
  [events (Vec reader/ReaderEvent)
   start Int] TripleScan
  (if (or (< start 0)
          (>= start (count events))
          (not= :vector/open
                (reader/readerevent-kind (nth events start)))
          (not= 3 (input/container-child-count events start)))
    (->TripleScan false nil "each proposition must be a three-Term vector"
                  (input/event-offset events start))
    (let [t1 Keyword? (keyword-at events
                        (input/container-child-start events start 0))
          t2 Keyword? (keyword-at events
                        (input/container-child-start events start 1))
          t3 Keyword? (keyword-at events
                        (input/container-child-start events start 2))]
      (if (and (some? t1) (and (some? t2) (some? t3)))
        (let [subject Keyword t1
              relation Keyword t2
              object Keyword t3]
          (->TripleScan true (t/triple subject relation object) "" -1))
        (->TripleScan false nil
          "responsibility propositions currently admit Keyword Atoms only"
          (input/event-offset events start))))))

(defn relationship-declared?
  [propositions (Vec t/Triple)
   relation Any] Bool
  (some?
    (some
      (fn [proposition t/Triple] t/Triple?
        (if (and (= relation (t/triple-t1 proposition))
                 (and (= member-of (t/triple-t2 proposition))
                      (= relationships (t/triple-t3 proposition))))
          proposition
          nil))
      propositions)))

(defn fact-normal-form?
  [propositions (Vec t/Triple)] Bool
  (and
    (relationship-declared? propositions member-of)
    (every?
      (fn [proposition t/Triple] Bool
        (relationship-declared? propositions (t/triple-t2 proposition)))
      propositions)))

(defn read-proposition-vector
  [events (Vec reader/ReaderEvent)
   start Int] ProjectionResult
  (if (or (< start 0)
          (>= start (count events))
          (not= :vector/open
                (reader/readerevent-kind (nth events start))))
    (->ProjectionRejected
      "machine-responsibility-triples must be a vector"
      (input/event-offset events start))
    (let [end Int (input/datum-end events start)]
      (loop [cursor Int (+ start 1)
             propositions (Vec t/Triple) []]
        (if (= cursor (- end 1))
          (if (fact-normal-form? propositions)
            (->ProjectionParsed propositions)
            (->ProjectionRejected
              "every predicate must have an explicit relationship membership Triple"
              (input/event-offset events start)))
          (let [scan TripleScan (read-triple events cursor)]
            (if (triplescan-ok scan)
              (let [value t/Triple? (triplescan-value scan)]
                (if (some? value)
                  (let [proposition t/Triple value]
                    (recur (input/datum-end events cursor)
                           (conj propositions proposition)))
                  (->ProjectionRejected "missing projected Triple"
                                        (input/event-offset events cursor))))
              (->ProjectionRejected (triplescan-message scan)
                                    (triplescan-offset scan)))))))))

(defn project-source [source String] ProjectionResult
  (let [read reader/DatumRead (reader/read-events source)
        read-error String? (reader/datumread-error read)]
    (if (some? read-error)
      (->ProjectionRejected read-error (reader/datumread-error-offset read))
      (let [events (Vec reader/ReaderEvent) (reader/datumread-events read)
            form input/SpanScan (input/find-top-level-form events "def")]
        (cond
          (not (input/spanscan-ok form))
          (->ProjectionRejected (input/spanscan-message form)
                                (input/spanscan-offset form))

          (not (input/spanscan-found form))
          (->ProjectionRejected "missing machine-responsibility-triples def" -1)

          (not= 4
                (input/container-child-count events
                  (input/spanscan-start form)))
          (->ProjectionRejected
            "machine-responsibility-triples def requires a type and value"
            (input/spanscan-offset form))

          (not (input/symbol-at? events
                 (input/container-child-start events
                   (input/spanscan-start form) 1)
                 "machine-responsibility-triples"))
          (->ProjectionRejected "unexpected desired-state def" -1)

          :else
          (read-proposition-vector
            events
            (input/container-child-start events
              (input/spanscan-start form) 3)))))))

(defn append-keyword
  [values (Vec Keyword)
   candidate Keyword] (Vec Keyword)
  (if (some?
        (some
          (fn [value Keyword] Keyword?
            (if (= value candidate) value nil))
          values))
    values
    (conj values candidate)))

(defn string-member?
  [values (Vec String)
   candidate String] Bool
  (some?
    (some
      (fn [value String] String?
        (if (= value candidate) value nil))
      values)))

(defn append-string
  [values (Vec String)
   candidate String] (Vec String)
  (if (string-member? values candidate) values (conj values candidate)))

(defn ends-with?
  [text String
   suffix String] Bool
  (and (>= (count text) (count suffix))
       (= (subs text (- (count text) (count suffix)) (count text)) suffix)))

(defn module-name [module Keyword] String
  (let [spelling String (subs (str module) 1)
        suffix String "-module"]
    (if (ends-with? spelling suffix)
      (subs spelling 0 (- (count spelling) (count suffix)))
      spelling)))

(defn union-keywords
  [left (Vec Keyword)
   right (Vec Keyword)] (Vec Keyword)
  (reduce
    (fn
      [values (Vec Keyword)
       candidate Keyword] (Vec Keyword)
      (append-keyword values candidate))
    left
    right))

(defn objects
  [propositions (Vec t/Triple)
   subject Keyword
   relation Keyword] (Vec Keyword)
  (reduce
    (fn
      [values (Vec Keyword)
       proposition t/Triple] (Vec Keyword)
      (let [object Any (t/triple-t3 proposition)]
        (if (and (= subject (t/triple-t1 proposition))
                 (and (= relation (t/triple-t2 proposition))
                      (keyword? object)))
          (append-keyword values object)
          values)))
    []
    propositions))

(defn first-object
  [propositions (Vec t/Triple)
   subject Keyword
   relation Keyword] Keyword?
  (let [values (Vec Keyword) (objects propositions subject relation)]
    (if (empty? values) nil (first values))))

(defn dependency-closure
  [propositions (Vec t/Triple)
   seeds (Vec Keyword)] (Vec Keyword)
  (loop [cursor Int 0
         reached (Vec Keyword) seeds]
    (if (>= cursor (count reached))
      reached
      (recur (+ cursor 1)
        (union-keywords
          reached
          (objects propositions (nth reached cursor) depends-on))))))

(defn responsibilities-for
  [propositions (Vec t/Triple)
   machine Keyword] (Vec Keyword)
  (dependency-closure propositions
    (objects propositions machine has-responsibility)))

(defn explanation-for-software
  [propositions (Vec t/Triple)
   machine Keyword
   responsibility Keyword
   software Keyword] RealizationExplanation
  (->RealizationExplanation
    machine
    responsibility
    software
    (first-object propositions software is-realized-by)
    (objects propositions software provides-capability)
    (first-object propositions responsibility is-realized-in)
    (first-object propositions responsibility has-criticality)
    (first-object propositions responsibility has-lifecycle)))

(defn explain-machine
  [propositions (Vec t/Triple)
   machine Keyword] (Vec RealizationExplanation)
  (reduce
    (fn
      [explanations (Vec RealizationExplanation)
       responsibility Keyword] (Vec RealizationExplanation)
      (reduce
        (fn
          [current (Vec RealizationExplanation)
           software Keyword] (Vec RealizationExplanation)
          (conj current
            (explanation-for-software
              propositions machine responsibility software)))
        explanations
        (dependency-closure propositions
          (objects propositions responsibility requires-software))))
    []
    (responsibilities-for propositions machine)))

(defn environment-modules
  [propositions (Vec t/Triple)
   machine Keyword] (Vec String)
  (reduce
    (fn
      [modules (Vec String)
       explanation RealizationExplanation] (Vec String)
      (let [module Keyword? (realizationexplanation-module explanation)]
        (if (and (= :environment
                    (realizationexplanation-domain explanation))
                 (some? module))
          (let [present Keyword module]
            (append-string modules (module-name present)))
          modules)))
    []
    (explain-machine propositions machine)))

(defn environment-modules-in-boot
  [propositions (Vec t/Triple)
   machine Keyword
   boot-modules (Vec String)] (Vec String)
  (reduce
    (fn
      [coupled (Vec String)
       module String] (Vec String)
      (if (string-member? boot-modules module)
        (conj coupled module)
        coupled))
    []
    (environment-modules propositions machine)))

(defn responsibility-has-domain?
  [propositions (Vec t/Triple)
   responsibility Keyword
   domain Keyword] Bool
  (= domain (first-object propositions responsibility is-realized-in)))

(defn reaches-domain?
  [propositions (Vec t/Triple)
   responsibilities (Vec Keyword)
   domain Keyword] Bool
  (some?
    (some
      (fn [responsibility Keyword] Keyword?
        (if (responsibility-has-domain? propositions responsibility domain)
          responsibility
          nil))
      responsibilities)))

(defn boot-environment-dependencies
  [propositions (Vec t/Triple)
   machine Keyword] (Vec Keyword)
  (reduce
    (fn
      [violations (Vec Keyword)
       responsibility Keyword] (Vec Keyword)
      (if (and
            (responsibility-has-domain? propositions responsibility :boot)
            (reaches-domain?
              propositions
              (dependency-closure propositions
                (objects propositions responsibility depends-on))
              :environment))
        (append-keyword violations responsibility)
        violations))
    []
    (responsibilities-for propositions machine)))

(defn incomplete-software
  [propositions (Vec t/Triple)
   machine Keyword] (Vec Keyword)
  (reduce
    (fn
      [incomplete (Vec Keyword)
       explanation RealizationExplanation] (Vec Keyword)
      (if (or (nil? (realizationexplanation-module explanation))
              (or (nil? (realizationexplanation-domain explanation))
                  (or (nil? (realizationexplanation-criticality explanation))
                      (and
                        (= :boot
                           (realizationexplanation-domain explanation))
                        (nil?
                          (realizationexplanation-lifecycle explanation))))))
        (append-keyword incomplete
          (realizationexplanation-software explanation))
        incomplete))
    []
    (explain-machine propositions machine)))

(defn boot-software-admissible?
  [explanation RealizationExplanation
   boot-modules (Vec String)] Bool
  (let [module Keyword? (realizationexplanation-module explanation)]
    (and (= :long-lived-system-service
            (realizationexplanation-lifecycle explanation))
         (and (some? module)
              (let [present Keyword module]
                (string-member? boot-modules (module-name present)))))))

(defn inadmissible-boot-software
  [propositions (Vec t/Triple)
   machine Keyword
   boot-modules (Vec String)] (Vec Keyword)
  (reduce
    (fn
      [inadmissible (Vec Keyword)
       explanation RealizationExplanation] (Vec Keyword)
      (if (and (= :boot (realizationexplanation-domain explanation))
               (not (boot-software-admissible? explanation boot-modules)))
        (append-keyword inadmissible
          (realizationexplanation-software explanation))
        inadmissible))
    []
    (explain-machine propositions machine)))

(defn assess-boot-coupling
  [propositions (Vec t/Triple)
   machine Keyword
   boot-modules (Vec String)] BootCouplingBudget
  (->BootCouplingBudget
    (environment-modules-in-boot propositions machine boot-modules)
    (boot-environment-dependencies propositions machine)
    (incomplete-software propositions machine)
    (uncovered-capabilities propositions machine)
    (inadmissible-boot-software propositions machine boot-modules)))

(defn boot-coupling-budget-passes? [budget BootCouplingBudget] Bool
  (and
    (empty? (bootcouplingbudget-environment-modules-in-boot budget))
    (empty? (bootcouplingbudget-boot-environment-dependencies budget))
    (empty? (bootcouplingbudget-incomplete-software budget))
    (empty? (bootcouplingbudget-uncovered-capabilities budget))
    (empty? (bootcouplingbudget-inadmissible-boot-software budget))))

(defn realization-obligations
  [propositions (Vec t/Triple)
   machine Keyword] (Vec t/Triple)
  (reduce
    (fn [obligations (Vec t/Triple)
         explanation RealizationExplanation] (Vec t/Triple)
      (let [candidate t/Triple (t/triple machine must-realize
              (realizationexplanation-software explanation))]
        (if (some?
              (some
                (fn [existing t/Triple] t/Triple?
                  (if (= existing candidate) existing nil))
                obligations))
          obligations
          (conj obligations candidate))))
    []
    (explain-machine propositions machine)))

(defn uncovered-capabilities
  [propositions (Vec t/Triple)
   machine Keyword] (Vec Keyword)
  (reduce
    (fn
      [missing (Vec Keyword)
       responsibility Keyword] (Vec Keyword)
      (let [required (Vec Keyword) (objects propositions responsibility requires-capability)
            software (Vec Keyword) (dependency-closure propositions
              (objects propositions responsibility requires-software))
            provided (Vec Keyword) (reduce
              (fn
                [capabilities (Vec Keyword)
                 item Keyword] (Vec Keyword)
                (union-keywords capabilities
                  (objects propositions item provides-capability)))
              []
              software)]
        (reduce
          (fn
            [result (Vec Keyword)
             capability Keyword] (Vec Keyword)
            (if (some?
                  (some
                    (fn [candidate Keyword] Keyword?
                      (if (= capability candidate) candidate nil))
                    provided))
              result
              (append-keyword result capability)))
          missing
          required)))
    []
    (responsibilities-for propositions machine)))
