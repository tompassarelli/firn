#lang beagle/js
(ns firn.tag-commands-family
  (:require [firn.tag-resolve :as r]
            [firn.tag-resolve-family :as repository]
            [firn.tag-resolve-driver :as resolve-driver]
            [firn.tag-commands :as commands]
            [firn.tag-commands-driver :as driver]))

(js/export
  (defunion HostDocumentLoadResult
  (HostDocumentLoaded [(document commands/HostDocument)])
  (HostDocumentMissing [(host String)])
  (HostDocumentLoadRejected [(message String)])))

(js/export
  (defunion HostDocumentsLoadResult
  (HostDocumentsLoaded [(documents (Vec commands/HostDocument))])
  (HostDocumentsLoadRejected [(message String)])))

(defn path [(root String) (relative String)] String
  (str root "/" relative))

(defn errno-message
  [(label String) (operation String) (relative String) (errno Int)] String
  (str label ": " operation " '" relative "': errno " errno "\n"))

(defn load-host-document
  [(bridge Any) (root String) (host String)] HostDocumentLoadResult
  (match (repository/load-host bridge root host)
    [(HostRejected message) (->HostDocumentLoadRejected message)]
    [(HostLoaded data)
     (if (resolve-driver/tagresolvehostdata-tag-source-present data)
       (->HostDocumentLoaded
         (commands/->HostDocument (resolve-driver/tagresolvehostdata-tags data)
           (resolve-driver/tagresolvehostdata-active data)))
       (->HostDocumentMissing host))]))

(defn load-action-hosts
  [(bridge Any)
   (root String)
   (action driver/TagCommandAction)] HostDocumentsLoadResult
  (let [(wanted (U String Nil)) (driver/action-host action)]
    (if (nil? wanted)
      (->HostDocumentsLoaded [])
      (let [(host String) wanted]
        (match (load-host-document bridge root host)
          [(HostDocumentLoadRejected message)
           (->HostDocumentsLoadRejected message)]
          [(HostDocumentMissing missing)
           (->HostDocumentsLoaded [])]
          [(HostDocumentLoaded document)
           (->HostDocumentsLoaded [document])])))))

(defn emit-io-error [(bridge Any) (message String)] Int
  (do (.err bridge message) 1))

(defn write-error
  [(bridge Any)
   (label String)
   (operation String)
   (relative String)
   (errno Int)] Int
  (emit-io-error bridge (errno-message label operation relative errno)))

(defn execute-write
  [(bridge Any)
   (root String)
   (outcome driver/TagCommandOutcome)
   (index Int)
   (relative String)
   (text String)
   (make-parents Bool)
   (label String)]
  Int
  (let [(absolute String) (path root relative)]
    (if make-parents
      (let [(parent-errno Int) (.makeParentDirectories bridge absolute)]
        (if (not (= parent-errno 0))
          (write-error bridge label "cannot create parent for" relative
            parent-errno)
          (let [(write-errno Int) (.writeTextAtomic bridge absolute text)]
            (if (not (= write-errno 0))
              (write-error bridge label "cannot write" relative write-errno)
              (execute-effects bridge root outcome (+ index 1))))))
      (let [(write-errno Int) (.writeTextAtomic bridge absolute text)]
        (if (not (= write-errno 0))
          (write-error bridge label "cannot write" relative write-errno)
          (execute-effects bridge root outcome (+ index 1)))))))

(defn execute-effects
  [(bridge Any)
   (root String)
   (outcome driver/TagCommandOutcome)
   (index Int)] Int
  (if (>= index (count (driver/tagcommandoutcome-effects outcome)))
    (driver/tagcommandoutcome-status outcome)
    (match (nth (driver/tagcommandoutcome-effects outcome) index)
      [(CommandStdout text)
       (do (.out bridge text)
           (execute-effects bridge root outcome (+ index 1)))]
      [(CommandStderr text)
       (do (.err bridge text)
           (execute-effects bridge root outcome (+ index 1)))]
      [(CommandWrite relative text make-parents label)
       (execute-write bridge root outcome index relative text make-parents
         label)]
      [(CommandEditFacts relative remove add label)
       (let [(result Any) (.editHostFacts bridge (path root relative) remove add)]
         (if (= (.status bridge result) 0)
           (execute-effects bridge root outcome (+ index 1))
           (emit-io-error bridge
             (str label ": cannot edit '" relative "': "
               (.moduleFactsMessage bridge result) "\n"))))])))

(defn run-with-modules
  [(bridge Any)
   (root String)
   (action driver/TagCommandAction)
   (modules (Vec r/ModuleTags))]
  Int
  (match (load-action-hosts bridge root action)
    [(HostDocumentsLoadRejected message) (emit-io-error bridge message)]
    [(HostDocumentsLoaded documents)
     (execute-effects bridge root
       (driver/run-tag-command
         (driver/->TagCommandRepository modules documents)
         action)
       0)]))

(defn run-loaded-action
  [(bridge Any) (root String) (action driver/TagCommandAction)] Int
  (if (driver/action-needs-modules? action)
    (match (repository/load-modules bridge root)
      [(ModulesRejected message) (emit-io-error bridge message)]
      [(ModulesLoaded modules) (run-with-modules bridge root action modules)])
    (run-with-modules bridge root action [])))

(defn run-action
  [(bridge Any) (root String) (action driver/TagCommandAction)] Int
  (match (driver/preload-tag-command action)
    [(TagCommandRefusal outcome) (execute-effects bridge root outcome 0)]
    [(TagCommandLoad token) (run-loaded-action bridge root action)]))

(defn repository-root [bridge Any] (U String Nil)
  (let [(explicit (U String Nil)) (.env bridge "FIRN_REPO")]
    (if (some? explicit)
      explicit
      (let [(home (U String Nil)) (.env bridge "HOME")]
        (if (some? home)
          (str home "/code/nixos-config/main")
          nil)))))

(defn default-host [bridge Any] String
  (let [(host (U String Nil)) (.env bridge "FIRN_HOST")]
    (if (some? host) host "whiterabbit")))

(defn usage-error [bridge Any] Int
  (do
    (.err bridge
      (str
        "Usage: firn tag <list|show|filter|index|status|enable|disable|"
        "opt-in|opt-out> [<leaf>]\n"
        "       firn module <enable|disable> <name>\n"))
    64))

(js/export
 (defn run [(bridge Any) (args (Vec String))] Int
  (match (driver/parse-tag-command-argv args (default-host bridge))
    [(OtherTagCommand argv) (usage-error bridge)]
    [(InvalidTagCommand argv) (usage-error bridge)]
    [(ParsedTagCommand action)
     (let [(root (U String Nil)) (repository-root bridge)]
       (if (nil? root)
         (do
           (.err bridge
             "firn: FIRN_REPO and HOME are not set\n")
           1)
         (run-action bridge root action)))])))
