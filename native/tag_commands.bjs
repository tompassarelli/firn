#lang beagle/js
(ns firn.tag-commands
  (:require [native.json :as json]
            [firn.tag-resolve :as r]))

(js/export
  (defrecord HostDocument
  [tags r/HostTags
   active (Vec String)]))

(js/export
  (defrecord TagMutation
  [changed Bool
   remove (Vec String)
   add (Vec String)]))

(js/export
  (defunion TagModuleLeaf
  (TagModuleParsed
    [tag String
     module String])
  (TagModuleRejected [leaf String])))

(js/export
  (defunion ModuleLookup
  (ModuleFound [value r/ModuleTags])
  (ModuleMissing [name String])))

(js/export
  (defunion TagIndexResult
  (TagIndexRendered [text String])
  (TagIndexRejected [message String])))

(js/export
  (defn string-join
  [values (Vec String)
   separator String] String
  (loop [index Int 0
         result String ""]
    (if (>= index (count values))
      result
      (recur (+ index 1)
        (str result (if (= index 0) "" separator) (nth values index)))))))

(js/export
  (defn spaces [amount Int] String
  (loop [remaining Int amount
         result String ""]
    (if (<= remaining 0)
      result
      (recur (- remaining 1) (str result " "))))))

(js/export
  (defn pad-right
  [value String
   width Int] String
  (str value (spaces (- width (count value))))))

(js/export
  (defn prefix-values
  [prefix String
   values (Vec String)] (Vec String)
  (loop [index Int 0
         result (Vec String) []]
    (if (>= index (count values))
      result
      (recur (+ index 1)
        (conj result (str prefix (nth values index))))))))


(js/export
  (defn find-module
  [modules (Vec r/ModuleTags)
   name String] ModuleLookup
  (loop [index Int 0]
    (if (>= index (count modules))
      (->ModuleMissing name)
      (let [module r/ModuleTags (nth modules index)]
        (if (= name (r/moduletags-name module))
          (->ModuleFound module)
          (recur (+ index 1))))))))

(js/export
  (defn universe-add-all
  [universe (Vec String)
   values (Vec String)] (Vec String)
  (loop [index Int 0
         result (Vec String) universe]
    (if (>= index (count values))
      result
      (recur (+ index 1)
        (r/append-unique result (nth values index)))))))

(js/export
  (defn tag-universe [modules (Vec r/ModuleTags)] (Vec String)
  (loop [index Int 0
         result (Vec String) []]
    (if (>= index (count modules))
      (sort result)
      (let [module r/ModuleTags (nth modules index)]
        (recur (+ index 1)
          (universe-add-all
            (universe-add-all result (r/moduletags-tags module))
            (r/moduletags-opt-in module))))))))

(js/export
  (defn tag-membership-count
  [modules (Vec r/ModuleTags)
   tag String
   opt-in Bool] Int
  (loop [index Int 0
         total Int 0]
    (if (>= index (count modules))
      total
      (let [module r/ModuleTags (nth modules index)
            values (Vec String) (if opt-in
              (r/moduletags-opt-in module)
              (r/moduletags-tags module))]
        (recur (+ index 1)
          (+ total (if (r/string-member? values tag) 1 0))))))))

(js/export
  (defn tagged-module-count [modules (Vec r/ModuleTags)] Int
  (loop [index Int 0
         total Int 0]
    (if (>= index (count modules))
      total
      (let [module r/ModuleTags (nth modules index)]
        (recur (+ index 1)
          (+ total
            (if (or (> (count (r/moduletags-tags module)) 0)
                    (> (count (r/moduletags-opt-in module)) 0))
              1
              0))))))))

(js/export
  (defn render-tag-list [modules (Vec r/ModuleTags)] String
  (let [tags (Vec String) (tag-universe modules)
        heading String (if (= (count tags) 0)
          "No tags found. Add '<module> is tagged <tag>' facts to modules' default.gal.\n"
          (str "Tags (" (count tags) "):\n"))
        body String (loop [index Int 0
                           result String heading]
                      (if (>= index (count tags))
            result
            (let [tag String (nth tags index)
                  defaults Int (tag-membership-count modules tag false)
                  opt-ins Int (tag-membership-count modules tag true)]
              (recur (+ index 1)
                (str result "  " (pad-right tag 18)
                  "  (" defaults " default"
                  (if (= opt-ins 0) "" (str ", " opt-ins " opt-in"))
                  ")\n")))))]
    (str body "\nCoverage: " (tagged-module-count modules) " / "
      (count modules) " modules carry at least one tag.\n"))))

(js/export
  (defn render-tag-show [module r/ModuleTags] String
  (let [name String (r/moduletags-name module)
        defaults (Vec String) (r/moduletags-tags module)
        opt-ins (Vec String) (r/moduletags-opt-in module)]
    (str "module: " name "\n"
      ":tags         "
      (if (= (count defaults) 0)
        (str "(none — add '" name " is tagged <tag>' to modules/" name
          "/default.gal)")
        (string-join defaults ", "))
      "\n:tags-opt-in  "
      (if (= (count opt-ins) 0)
        "(none)"
        (string-join opt-ins ", "))
      "\n"))))

(js/export
  (defn modules-with-tag
  [modules (Vec r/ModuleTags)
   tag String] (Vec String)
  (loop [index Int 0
         result (Vec String) []]
    (if (>= index (count modules))
      (sort result)
      (let [module r/ModuleTags (nth modules index)]
        (recur (+ index 1)
          (if (or (r/string-member? (r/moduletags-tags module) tag)
                  (r/string-member? (r/moduletags-opt-in module) tag))
            (conj result (r/moduletags-name module))
            result)))))))

(js/export
  (defn module-tag-kind
  [module r/ModuleTags
   tag String] String
  (if (r/string-member? (r/moduletags-tags module) tag)
    "default"
    "opt-in")))

(js/export
  (defn render-tag-filter
  [modules (Vec r/ModuleTags)
   tag String] String
  (let [names (Vec String) (modules-with-tag modules tag)]
    (if (= (count names) 0)
      (str "no modules tagged '" tag "'\n")
      (loop [index Int 0
             result String (str "modules tagged '" tag "' (" (count names) "):\n")]
        (if (>= index (count names))
          result
          (let [name String (nth names index)]
            (match (find-module modules name)
              [(ModuleMissing missing) (recur (+ index 1) result)]
              [(ModuleFound module)
               (recur (+ index 1)
                 (str result "  " name "  (" (module-tag-kind module tag)
                   ")\n"))]))))))))

(js/export
  (defn append-json-strings
  [events (Vec json/JsonEvent)
   values (Vec String)] (Vec json/JsonEvent)
  (loop [index Int 0
         result (Vec json/JsonEvent) events]
    (if (>= index (count values))
      result
      (recur (+ index 1)
        (conj result (json/->JsonString 0 (nth values index))))))))

(js/export
  (defn module-index-events [module r/ModuleTags] (Vec json/JsonEvent)
  (let [with-name (Vec json/JsonEvent) [(json/->JsonObjectStart 0)
         (json/->JsonKey 0 "name")
         (json/->JsonString 0 (r/moduletags-name module))
         (json/->JsonKey 0 "tags")
         (json/->JsonArrayStart 0)]
        with-tags (Vec json/JsonEvent) (append-json-strings with-name (r/moduletags-tags module))
        with-opt-in-key (Vec json/JsonEvent) (into with-tags
          [(json/->JsonArrayEnd 0)
           (json/->JsonKey 0 "tags_opt_in")
           (json/->JsonArrayStart 0)])
        with-opt-ins (Vec json/JsonEvent) (append-json-strings with-opt-in-key (r/moduletags-opt-in module))]
    (into with-opt-ins
      [(json/->JsonArrayEnd 0) (json/->JsonObjectEnd 0)]))))

(js/export
  (defn render-tag-index [modules (Vec r/ModuleTags)] TagIndexResult
  (loop [index Int 0
         result String ""]
    (if (>= index (count modules))
      (->TagIndexRendered result)
      (let [module r/ModuleTags (nth modules index)]
        (match (json/encode (module-index-events module))
          [(JsonEncodeError event-index message)
           (->TagIndexRejected
             (str "cannot encode module '" (r/moduletags-name module)
               "': " message))]
          [(JsonEncoded text)
           (recur (+ index 1) (str result text "\n"))]))))))


(js/export
  (defn host-facts-path [host String] String
  (str "hosts/" host "/_generated-enables.gal")))

(js/export
  (defn enables-fact [host String tag String] String
  (str host " enables " tag)))

(js/export
  (defn adds-fact [host String module String tag String] String
  (str host " adds " module " to " tag)))

(js/export
  (defn drops-fact [host String module String tag String] String
  (str host " drops " module " from " tag)))

(js/export
  (defn disables-fact [host String module String] String
  (str host " disables " module)))

(js/export
  (defn enabled-entry-string [entry r/EnabledTag] String
  (let [edits (Vec String) (into (prefix-values "+" (r/enabledtag-pluses entry))
                             (prefix-values "-" (r/enabledtag-minuses entry)))]
    (if (= (count edits) 0)
      (r/enabledtag-tag entry)
      (str "[" (r/enabledtag-tag entry) " " (string-join edits " ") "]")))))

(js/export
  (defn render-enabled-status [enabled (Vec r/EnabledTag)] String
  (if (= (count enabled) 0)
    "  (none)\n"
    (loop [index Int 0
           result String ""]
      (if (>= index (count enabled))
        result
        (recur (+ index 1)
          (str result "  " (enabled-entry-string (nth enabled index))
            "\n")))))))

(js/export
  (defn render-disabled-status [disabled (Vec String)] String
  (if (= (count disabled) 0)
    "  (none)\n"
    (loop [index Int 0
           result String ""]
      (if (>= index (count disabled))
        result
        (recur (+ index 1)
          (str result "  " (nth disabled index) "\n")))))))

(js/export
  (defn validation-error-hint [error r/ValidationError] String
  (match error
    [(UnknownPlatform host platform hint) hint]
    [(UnknownTag host tag hint) hint]
    [(OptInMismatch host tag module hint) hint]
    [(UnknownDisabled host module hint) hint])))

(js/export
  (defn render-resolution-errors [errors (Vec r/ValidationError)] String
  (if (= (count errors) 0)
    ""
    (loop [index Int 0
           result String (str "Resolution errors (" (count errors) "):\n")]
      (if (>= index (count errors))
        (str result "\n")
        (recur (+ index 1)
          (str result "  " (validation-error-hint (nth errors index))
            "\n")))))))

(js/export
  (defn render-active-status [active (Vec String)] String
  (let [heading String (str "Resolved active modules (" (count active)
                           "):\n")]
    (if (= (count active) 0)
      (str heading "  (none)\n")
      (loop [index Int 0
             result String heading]
        (if (>= index (count active))
          result
          (recur (+ index 1)
            (str result "  " (nth active index) "\n"))))))))


(js/export
  (defn render-tag-status
  [modules (Vec r/ModuleTags)
   document HostDocument] String
  (let [tags r/HostTags (hostdocument-tags document)
        enabled (Vec r/EnabledTag) (r/hosttags-enabled tags)
        disabled (Vec String) (r/hosttags-disabled tags)
        resolution r/Resolution (r/resolve modules tags)]
    (str "Host: " (r/hosttags-host tags) "\n"
      "Platform: " (r/hosttags-platform tags) "\n"
      "Source: " (host-facts-path (r/hosttags-host tags)) "\n\n"
      ":enabled (" (count enabled) "):\n"
      (render-enabled-status enabled)
      "\n:disabled (" (count disabled) "):\n"
      (render-disabled-status disabled)
      "\n"
      (render-resolution-errors (r/resolution-errors resolution))
      (render-active-status (hostdocument-active document))))))

(js/export
  (defn find-enabled
  [enabled (Vec r/EnabledTag)
   tag String] (U r/EnabledTag Nil)
  (loop [index Int 0]
    (if (>= index (count enabled))
      nil
      (if (= tag (r/enabledtag-tag (nth enabled index)))
        (nth enabled index)
        (recur (+ index 1)))))))

(js/export
  (defn unchanged [] TagMutation
  (->TagMutation false [] [])))

(js/export
  (defn enable-tag
  [document HostDocument
   tag String] TagMutation
  (let [tags r/HostTags (hostdocument-tags document)]
    (if (some? (find-enabled (r/hosttags-enabled tags) tag))
      (unchanged)
      (->TagMutation true [] [(enables-fact (r/hosttags-host tags) tag)])))))

(js/export
  (defn edit-facts
  [host String
   entry r/EnabledTag] (Vec String)
  (let [tag String (r/enabledtag-tag entry)]
    (into
      (loop [index Int 0
             result (Vec String) []]
        (if (>= index (count (r/enabledtag-pluses entry)))
          result
          (recur (+ index 1)
            (conj result (adds-fact host (nth (r/enabledtag-pluses entry) index) tag)))))
      (loop [index Int 0
             result (Vec String) []]
        (if (>= index (count (r/enabledtag-minuses entry)))
          result
          (recur (+ index 1)
            (conj result (drops-fact host (nth (r/enabledtag-minuses entry) index) tag)))))))))

(js/export
  (defn disable-tag
  [document HostDocument
   tag String] TagMutation
  (let [tags r/HostTags (hostdocument-tags document)
        host String (r/hosttags-host tags)
        found (U r/EnabledTag Nil) (find-enabled (r/hosttags-enabled tags) tag)]
    (if (nil? found)
      (unchanged)
      (let [entry r/EnabledTag found]
        (->TagMutation true
          (into [(enables-fact host tag)] (edit-facts host entry))
          []))))))

(js/export
  (defn add-tag-edit
  [document HostDocument
   tag String
   module String
   plus Bool] TagMutation
  (let [tags r/HostTags (hostdocument-tags document)
        host String (r/hosttags-host tags)
        edit String (if plus (adds-fact host module tag) (drops-fact host module tag))
        found (U r/EnabledTag Nil) (find-enabled (r/hosttags-enabled tags) tag)]
    (if (nil? found)
      (->TagMutation true [] [(enables-fact host tag) edit])
      (let [entry r/EnabledTag found]
        (if (r/string-member?
              (if plus (r/enabledtag-pluses entry) (r/enabledtag-minuses entry))
              module)
          (unchanged)
          (->TagMutation true [] [edit])))))))

(js/export
  (defn disable-module
  [document HostDocument
   module String] TagMutation
  (let [tags r/HostTags (hostdocument-tags document)]
    (if (r/string-member? (r/hosttags-disabled tags) module)
      (unchanged)
      (->TagMutation true [] [(disables-fact (r/hosttags-host tags) module)])))))

(js/export
  (defn enable-module
  [document HostDocument
   module String] TagMutation
  (let [tags r/HostTags (hostdocument-tags document)]
    (if (r/string-member? (r/hosttags-disabled tags) module)
      (->TagMutation true [(disables-fact (r/hosttags-host tags) module)] [])
      (unchanged)))))

(js/export
  (defn split-tag-module [leaf String] TagModuleLeaf
  (loop [index Int 0]
    (if (>= index (count leaf))
      (->TagModuleRejected leaf)
      (if (= "+" (subs leaf index (+ index 1)))
        (if (and (> index 0) (< (+ index 1) (count leaf)))
          (->TagModuleParsed
            (subs leaf 0 index)
            (subs leaf (+ index 1) (count leaf)))
          (->TagModuleRejected leaf))
        (recur (+ index 1)))))))
