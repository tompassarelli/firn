import "nixpkgs.clause"
Null:
  foreign: "nix"
  type: "Null"

foreign nix-null(): Null
  construction: "nix"
  get: "null"
  from: "builtins"
  failure: throw

foreign darwin(): Bool
  construction: "nix"
  get: "stdenv.hostPlatform.isDarwin"
  from: "pkgs"
  failure: throw

export ghostty-module()
  configuration-module(path(myConfig.modules.ghostty.enable), "Ghostty terminal",
    {home-manager: {users: dictionary(configured-text(path(myConfig.modules.users.username)),
      {programs: {ghostty: {enable: true, package: if(darwin(), nix-null(), package(path(unstable.ghostty))), settings: {async-backend: "epoll", window-padding-x: 6, window-padding-y: 4, app-notifications: "no-clipboard-copy", command: "/run/current-system/sw/bin/bash", working-directory: "home"}}}})}})
