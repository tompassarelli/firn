import "nixpkgs.clause"
HomeArguments:
  config: {}

export git-module()
  configuration-module(path(myConfig.modules.git.enable), "Git configuration",
    {home-manager: {users: dictionary(configured-text(path(myConfig.modules.users.username)),
      (?home: Delayed<nix,HomeArguments>) =>
        {programs: {
          git: {enable: true, settings: {user: {name: configured-text(path(myConfig.modules.users.fullName)), email: configured-text(path(myConfig.modules.users.email))}, init: {defaultBranch: "main"}, core: {editor: "nvim"}, merge: {conflictstyle: "diff3"}, diff: {colorMoved: "default"}, maintenance: {auto: false, autoDetach: false}, gc: {auto: 0, autoDetach: false}}},
          delta: {enable: true, enableGitIntegration: true, options: {navigate: true}}}})}})
