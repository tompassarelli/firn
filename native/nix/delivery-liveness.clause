import "nixpkgs.clause"

HomeDirectory:
  homeDirectory: Text
HomeConfiguration:
  home: HomeDirectory
HomeArguments:
  config: HomeConfiguration

foreign binary-path(?packages: Sequence<Delayed<nix,Package>>): Text
  construction: "nix"
  call: "makeBinPath"
  from: "lib"
  failure: throw

export delivery-liveness-module()
  configuration-module(path(myConfig.modules.delivery-liveness.enable), "periodically build the committed Firn toplevel without switching",
    {environment: {etc: {"north/delivery-liveness-required": {text: "1\n"}}},
     home-manager: {users: dictionary(configured-text(path(myConfig.modules.users.username)),
       (?home: Delayed<nix,HomeArguments>) =>
        {
         home: {sessionVariables: {NORTH_DELIVERY_LIVENESS_REQUIRED: "1"}},
         systemd: {user: {
           services: {firn-delivery-liveness: {
             Unit: {Description: "Firn delivery liveness floor (non-switching)"},
             Service: {Type: "oneshot", ExecStart: "{?home.config.home.homeDirectory}/.local/bin/firn-liveness-floor",
               Environment: ["NORTH_BIN={?home.config.home.homeDirectory}/.local/share/north/bin/north", "PATH={?home.config.home.homeDirectory}/.local/bin:{?home.config.home.homeDirectory}/.local/share/north/bin:{binary-path([package(path(bash)), package(path(coreutils)), package(path(gawk)), package(path(git)), package(path(nix)), package(path(python3)), package(path(util-linux))])}"],
               TimeoutStartSec: "30m"}}},
           timers: {firn-delivery-liveness: {Unit: {Description: "Run Firn delivery liveness floor"}, Timer: {OnCalendar: "*:0/30", Persistent: true, RandomizedDelaySec: "5m"}, Install: {WantedBy: ["timers.target"]}}},
           paths: {firn-delivery-liveness: {Unit: {Description: "Refresh Firn delivery liveness when main advances"}, Path: {PathChanged: "{?home.config.home.homeDirectory}/code/nixos-config/main/.git/logs/HEAD"}, Install: {WantedBy: ["paths.target"]}}}}}})}})
