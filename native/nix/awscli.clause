import "nixpkgs.clause"

foreign flake-root(): Text
  construction: "nix"
  get: root
  from: "flakeRoot"
  failure: throw

awscli-configuration(?username: Delayed<nix,Text>, ?sops-file: Delayed<nix,Text>)
  {options: {myConfig: {modules: {awscli: {
    enable: enable-option("awscli"),
    sopsFile: option({type: string-type(),
      description: "sops file holding the AWS credentials (aws-access-key-id, aws-secret-access-key)"})}}}},
   config: when-enabled(configured(path(myConfig.modules.awscli.enable)), {
     environment: {systemPackages: [package(path(awscli2))]},
     sops: {
       secrets: {
         "aws-access-key-id": {sopsFile: ?sops-file, owner: ?username},
         "aws-secret-access-key": {sopsFile: ?sops-file, owner: ?username}},
       templates: {
         "aws-credentials": {owner: ?username,
           content: "[default]\naws_access_key_id = {configured-text(path(sops.placeholder.aws-access-key-id))}\naws_secret_access_key = {configured-text(path(sops.placeholder.aws-secret-access-key))}\n\n"},
         "aws-config": {owner: ?username, content: "[default]\nregion = us-east-2\noutput = json\n\n"}}}})}

export awscli-module()
  awscli-configuration(configured-text(path(myConfig.modules.users.username)), configured-text(path(myConfig.modules.awscli.sopsFile)))
