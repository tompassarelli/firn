import "nixpkgs.clause"

Symlink:
  foreign: "home-manager"
  type: "Path"

HomeDirectory:
  homeDirectory: Text

HomeFiles:
  mkOutOfStoreSymlink: Function<Text, Symlink>

HomeLibrary:
  file: HomeFiles

HomeConfiguration:
  home: HomeDirectory
  lib: HomeLibrary

HomeModuleArguments:
  config: HomeConfiguration

foreign package-text(?value: Delayed<nix,Package>): Text
  construction: "nix"
  call: "toString"
  from: "builtins"
  failure: throw

foreign force-text(?text: Delayed<nix,Text>): Definition
  construction: "nix"
  call: "mkForce"
  from: "lib"
  failure: throw

foreign merge-packages(?definitions: Sequence<Sequence<Delayed<nix,Package>>>): Definition
  construction: "nix"
  call: "mkMerge"
  from: "lib"
  failure: throw

export bash-module()
  configuration-module(path(myConfig.modules.bash.enable), "Bash shell configuration",
    {environment: {etc: {bash_logout: {text: force-text("# /etc/bash_logout: generated by Firn.\n\n# A login command may enable nounset before Bash sources this file.\nif [ -n \"$\u{7b}__ETC_BASHLOGOUT_SOURCED:-}\" ] || [ -n \"$\u{7b}NOSYSBASHLOGOUT:-}\" ]; then\n  return 0\nfi\n__ETC_BASHLOGOUT_SOURCED=1\n\n{configured-text(path(programs.bash.logout))}\n\nif test -f /etc/bash_logout.local; then\n  . /etc/bash_logout.local\nfi\n\n")}}, systemPackages: [package(path(fzf))]}, programs: {bash: {completion: {enable: true}}},
     home-manager: {users: dictionary(configured-text(path(myConfig.modules.users.username)),
       (?home: Delayed<nix,HomeModuleArguments>) =>
         {systemd: {user: {startServices: "sd-switch"}}, home: {sessionPath: ["{?home.config.home.homeDirectory}/.local/share/north/bin", "{?home.config.home.homeDirectory}/.local/share/south/bin"], file: {".local/bin": {source: ?home.config.lib.file.mkOutOfStoreSymlink("{?home.config.home.homeDirectory}/code/nixos-config/main/dotfiles/bin")}, ".local/share/north/bin": {source: ?home.config.lib.file.mkOutOfStoreSymlink("{?home.config.home.homeDirectory}/code/north/main/bin")}, ".local/share/south/bin": {source: ?home.config.lib.file.mkOutOfStoreSymlink("{?home.config.home.homeDirectory}/code/south/main/bin")}, ".local/libexec/convo/python3": {source: "{package-text(package(path(python3)))}/bin/python3"}}, packages: merge-packages([[package(path(libglvnd))]])},
          programs: {bash: {enable: true, shellAliases: {dsp: "--dangerously-skip-permissions",
            du: "dust",
            ls: "eza",
            ps: "procs",
            v: "nvim",
            e: "emacsclient -n -c -a emacs",
            etui: "emacsclient -t -a emacs",
            gits: "git status",
            gitd: "git diff",
            gitdc: "git diff --cached",
            gita: "git add -v . && git status",
            gitp: "git push"}, historyControl: ["ignoredups", "erasedups"], historySize: 100000, historyFileSize: 100000, shellOptions: ["histappend", "checkwinsize", "cmdhist", "globstar", "autocd", "cdspell", "dirspell"], bashrcExtra: "\n# Ensure ~/.local/bin (where dotfiles/bin is symlinked) is on PATH.\ncase \":$PATH:\" in\n  *\":$HOME/.local/bin:\"*) ;;\n  *) export PATH=\"$HOME/.local/bin:$PATH\" ;;\nesac\n\n# North and South tools follow ~/.local/bin, so firn copies still win.\nfor d in \"$HOME/.local/share/north/bin\" \"$HOME/.local/share/south/bin\"; do\n  case \":$PATH:\" in\n    *\":$d:\"*) ;;\n    *) export PATH=\"$PATH:$d\" ;;\n  esac\ndone\n\n# Readline-dependent setup. Skip cleanly on bash builds without\n# readline (pkgs.bash in nix dev shells) — `set -o vi`, `bind`,\n# `complete`, and the fzf bindings all need readline. The cd-to-home\n# block below is intentionally outside this gate.\nif [[ $- == *i* ]] && type bind >/dev/null 2>&1; then\n  # vi-mode (use 'set -o emacs' to switch back temporarily)\n  set -o vi\n\n  # Ctrl+L → clear screen, in every keymap. vi-mode doesn't\n  # bind this by default (it's an emacs-mode default), so\n  # set it explicitly in both vi-insert and vi-command.\n  bind -m emacs       '\"\\C-l\": clear-screen'\n  bind -m vi-insert   '\"\\C-l\": clear-screen'\n  bind -m vi-command  '\"\\C-l\": clear-screen'\n\n  # fzf integration (Ctrl-R for fuzzy history, Alt-C for cd)\n  if command -v fzf-share >/dev/null 2>&1; then\n    source \"$(fzf-share)/key-bindings.bash\"\n    source \"$(fzf-share)/completion.bash\"\n  fi\nfi\n\n# Change to home dir on interactive start (skip in Emacs vterm).\n# No readline dep, runs even in stripped bash.\nif [ -z \"$INSIDE_EMACS\" ] && [ -t 0 ]; then\n  case \"$PWD\" in\n    \"$HOME\"*) ;;\n    *) cd \"$HOME\" ;;\n  esac\nfi\n\n"}}})}})
