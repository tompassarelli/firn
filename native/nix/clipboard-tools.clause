import "nixpkgs.clause"

HomeArguments:
  config: {}

foreign package-text(?package: Delayed<nix,Package>): Text
  construction: "nix"
  call: "toString"
  from: "builtins"
  failure: throw

# A Wayland selection dies with its source client; wl-clip-persist reowns it.
# No xclip/xsel: xwayland-satellite's X clipboard goes stale without a focused X window, and Claude Code tries xclip before wl-paste.
clipboard-configuration(?persist: Delayed<nix,Package>)
  configuration-module(path(myConfig.modules.clipboard-tools.enable), "Clipboard persistence daemon and X selection diagnostics",
    {environment: {systemPackages: [?persist, package(path(xlsclients))]},
     home-manager: {users: dictionary(configured-text(path(myConfig.modules.users.username)),
       (?home: Delayed<nix,HomeArguments>) =>
         {systemd: {user: {services: {wl-clip-persist: {
           Unit: {Description: "Keep the Wayland clipboard after the source client exits",
             PartOf: ["graphical-session.target"], After: ["graphical-session.target"], Requisite: ["graphical-session.target"]},
           Service: {ExecStart: "{package-text(?persist)}/bin/wl-clip-persist --clipboard regular", Restart: "on-failure"},
           Install: {WantedBy: ["niri.service"]}}}}}})}})

export clipboard-tools-module()
  clipboard-configuration(package(path(wl-clip-persist)))
