import "nixpkgs.clause"

foreign fetch-url<Specification: Record>(?specification: Specification): Package
  construction: "nix"
  call: "fetchurl"
  from: "pkgs"
  failure: throw
foreign override-antigravity-cli<Specification: Record>(?specification: Specification): Package
  construction: "nix"
  call: "unstable.antigravity-cli.overrideAttrs"
  from: "pkgs"
  failure: throw

antigravity-cli-package(?version: Text, ?build: Text)
  override-antigravity-cli({version: ?version,
    src: fetch-url({url: "https://storage.googleapis.com/antigravity-public/antigravity-cli/{?version}-{?build}/linux-x64/cli_linux_x64.tar.gz", hash: "sha512-q+Pd9c8w062qWGrPUFIhqhlwL1ynGvPIsfmxpZdr2OXBUcQeozs5xBZ10lhDRio+jDgsBU9YDp1+FoiRnTtREA=="})})

export antigravity-cli-module()
  module(path(myConfig.modules.antigravity-cli.enable), "Antigravity CLI (agy) for free-tier adversarial review", antigravity-cli-package("1.3.3", "5524738307653632"))
