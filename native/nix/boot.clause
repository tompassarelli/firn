import "nixpkgs.clause"

export boot-module()
  configuration-module(path(myConfig.modules.boot.enable), "boot configuration",
    {boot: {
      loader: {systemd-boot: {enable: true}, efi: {canTouchEfiVariables: true}},

      # Crash forensics: whiterabbit silent-freeze hunt (diagnostic).
      # Turn hard-lockup detection into a panic so efi-pstore captures the
      # backtrace in firmware vars, archived to /var/lib/systemd/pstore next
      # boot. A dying box may never flush its log. Remove once the cause is found.
      # This kernel runs one pstore backend: efi_pstore wins, ramoops returns
      # -16. Ramoops needs CONFIG_PSTORE_CONSOLE and pstore.backend=ramoops to
      # add value. NixOS kdump has no vmcore save unit: its capture kernel drops
      # to a shell and strands an unattended box. Revisit only with a real
      # save-and-reboot capture init if the pstore backtrace is insufficient.
      kernelModules: ["uinput"],

      # GPU recovery resets and logs a hung GPU. The early-boot watchdog
      # panics before systemd-sysctl applies hardlockup_panic.
      # Disabling CWSR mitigates the gfx1150 (Radeon 890M) MES ring hang:
      # broken CWSR saturates MES, causing SQC/UTCL2 page faults and gfx resets.
      # Open regression across 6.18.x and 6.19.x; no upstream fix. Do not bump
      # kernel/firmware: newer MES ucode (0x82/0x83) triggers it.
      # Reference: community.frame.work/t/79221.
      # dcdebugmask=0x10 disables eDP panel self-refresh: with it on, the DCN35
      # display engine can miss a page flip ("flip_done timed out" on the eDP
      # CRTC), freezing the screen while the system keeps running.
      kernelParams: ["amdgpu.gpu_recovery=1", "nmi_watchdog=panic", "amdgpu.cwsr_enable=0", "amdgpu.dcdebugmask=0x10"],

      # Soft-lockup panic can falsely reboot after a >20s stall; set it to 0
      # if it fires spuriously. Panic recovery reboots after 20s, after capture.
      kernel: {sysctl: {
        "kernel.hardlockup_panic": 1,
        "kernel.softlockup_panic": 1,
        "kernel.panic_on_oops": 1,
        "kernel.panic": 20}}}})
