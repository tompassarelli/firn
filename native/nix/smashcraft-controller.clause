import "nixpkgs.clause"

HomeDirectory:
  homeDirectory: Text
HomeConfiguration:
  home: HomeDirectory
HomeArguments:
  config: HomeConfiguration

// Tom's Xbox controller for any Smashcraft session on his desktop: the
// always-on controller service (smashcraft:companion/README.md, "Always-on
// controller service"). ExecStart is a direct out-of-store launcher that
// `bun wisp controller` and `bun wisp play` point at the current helper, so
// the project stays out of the system closure; without it the unit is skipped.
export smashcraft-controller-module()
  configuration-module(path(myConfig.modules.smashcraft-controller.enable), "Smashcraft controller service: Tom's Xbox controller in any Smashcraft session",
    {home-manager: {users: dictionary(configured-text(path(myConfig.modules.users.username)),
       (?home: Delayed<nix,HomeArguments>) =>
        {systemd: {user: {services: {smashcraft-controller: {
           Unit: {Description: "Smashcraft controller service",
             PartOf: ["graphical-session.target"], After: ["graphical-session.target"],
             ConditionPathExists: "{?home.config.home.homeDirectory}/.local/share/smashcraft-build-inputs/controller/wc3-journal"},
           Service: {ExecStart: "{?home.config.home.homeDirectory}/.local/share/smashcraft-build-inputs/controller/wc3-journal --service",
             Restart: "always", RestartSec: "5"},
           Install: {WantedBy: ["niri.service"]}}}}}})}})
