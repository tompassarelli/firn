import "nixpkgs.clause"

Symlink:
  foreign: "home-manager"
  type: "Path"

HomeDirectory:
  homeDirectory: Text

HomeFiles:
  mkOutOfStoreSymlink: Function<Text, Symlink>

HomeLibrary:
  file: HomeFiles

HomeConfiguration:
  home: HomeDirectory
  lib: HomeLibrary

HomeModuleArguments:
  config: HomeConfiguration

export activity-module()
  {options: {myConfig: {modules: {activity: {
    enable: enable-option("activity — activities own workspaces: two-level layer over niri (daemon + CLI)"),
    activitiesFile: option({type: string-type(), default: "code/nixos-config/main/dotfiles/activity/activities.json", description: "activities.json linked at ~/.config/activity/activities.json, relative to the home directory"})}}}},
   config: when-enabled(configured(path(myConfig.modules.activity.enable)),
    {home-manager: {users: dictionary(configured-text(path(myConfig.modules.users.username)),
      (?home: Delayed<nix,HomeModuleArguments>) =>
        {
        systemd: {user: {services: {activity-daemon: {
          Unit: {Description: "activity daemon (niri activity layer)", PartOf: ["graphical-session.target"], After: ["graphical-session.target"], Requisite: ["graphical-session.target"]},
          Service: {ExecStart: "{configured-text(path(myConfig.modules.users.homeDir))}/.local/share/firn/bin/activity daemon", Restart: "on-failure", RestartSec: 2},
          Install: {WantedBy: ["niri.service"]}}}}},
        xdg: {configFile: {"activity/activities.json": {source: ?home.config.lib.file.mkOutOfStoreSymlink("{?home.config.home.homeDirectory}/{configured-text(path(myConfig.modules.activity.activitiesFile))}")}}}})}})}
