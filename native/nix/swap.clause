import "nixpkgs.clause"

export swap-module()
  configuration-module(path(myConfig.modules.swap.enable),
    "zram-based compressed swap",
    {zramSwap: {enable: true, algorithm: "zstd", memoryPercent: 50},
     swapDevices: [{device: "/swap/swapfile", priority: 0}],
     boot: {resumeDevice: "/dev/mapper/cryptroot",
       kernelParams: ["resume_offset=347227782"],
       kernel: {sysctl: {"vm.swappiness": 60, "vm.watermark_boost_factor": 0,
         "vm.watermark_scale_factor": 125, "vm.page-cluster": 0}}}})
