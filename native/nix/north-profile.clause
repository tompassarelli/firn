import "nixpkgs.clause"

Symlink:
  foreign: "home-manager"
  type: "Path"
HomeDirectory:
  homeDirectory: Text
HomeFiles:
  mkOutOfStoreSymlink: Function<Text, Symlink>
DagEntry:
  foreign: "home-manager"
  type: "DagEntry"
Dag:
  entryAfter: Function<Sequence<Text>, Function<Text, DagEntry>>
HomeLibrary:
  file: HomeFiles
  dag: Dag
HomeConfiguration:
  home: HomeDirectory
  lib: HomeLibrary
HomeArguments:
  config: HomeConfiguration
FilePath:
  foreign: "nix"
  type: "Path"
foreign hook-json(): FilePath
  construction: "nix"
  get: root
  from: "./claude-hooks.json"
  failure: throw
foreign hook-script(): FilePath
  construction: "nix"
  get: root
  from: "./claude-hook-projector.sh"
  failure: throw
foreign file-text(?file: Delayed<nix,FilePath>): Text
  construction: "nix"
  call: "readFile"
  from: "builtins"
  failure: throw
foreign write-text(?name: Text, ?text: Delayed<nix,Text>): Package
  construction: "nix"
  call: "writeText"
  from: "pkgs"
  failure: throw
foreign shell-script(?name: Text, ?text: Delayed<nix,Text>): Package
  construction: "nix"
  call: "writeShellScript"
  from: "pkgs"
  failure: throw
foreign package-text(?value: Delayed<nix,Package>): Text
  construction: "nix"
  call: "toString"
  from: "builtins"
  failure: throw

# North owns the immutable generation behind these provider-neutral discovery paths.
north-configuration(?projection: Delayed<nix,Package>, ?projector: Delayed<nix,Package>)
  configuration-module(path(myConfig.modules.north-profile.enable), "Publish shared agent surfaces at ~/.agents",
    {home-manager: {users: dictionary(configured-text(path(myConfig.modules.users.username)),
      (?home: Delayed<nix,HomeArguments>) =>
        {home: {
          # Source checkout links would bypass generation permission and provenance.
          file: {
            ".agents/AGENTS.md": {source: ?home.config.lib.file.mkOutOfStoreSymlink("{?home.config.home.homeDirectory}/.local/state/north/agents/current/instructions/shared/AGENTS.md")},
            ".agents/skills": {source: ?home.config.lib.file.mkOutOfStoreSymlink("{?home.config.home.homeDirectory}/.local/state/north/agents/current/skills/shared")},
            ".agents/hooks": {source: ?home.config.lib.file.mkOutOfStoreSymlink("{?home.config.home.homeDirectory}/.local/state/north/agents/current/provider-hooks")},
            "code/AGENTS.md": {source: ?home.config.lib.file.mkOutOfStoreSymlink("{?home.config.home.homeDirectory}/.local/state/north/agents/current/instructions/code/AGENTS.md")}},
          # Only hooks and autoCompactWindow are managed; native provider preferences survive.
          activation: {projectNorthClaudeHooks: ?home.config.lib.dag.entryAfter(["writeBoundary"])("run {package-text(package(path(coreutils)))}/bin/env CHMOD_BIN={package-text(package(path(coreutils)))}/bin/chmod FLOCK_BIN={package-text(package(path(util-linux)))}/bin/flock JQ_BIN={package-text(package(path(jq)))}/bin/jq MKDIR_BIN={package-text(package(path(coreutils)))}/bin/mkdir MV_BIN={package-text(package(path(coreutils)))}/bin/mv REALPATH_BIN={package-text(package(path(coreutils)))}/bin/realpath RM_BIN={package-text(package(path(coreutils)))}/bin/rm {package-text(?projector)} {package-text(?projection)} $HOME/.claude/settings.json\n")}}})}})

export north-profile-module()
  north-configuration(write-text("north-claude-hooks.json", file-text(hook-json())), shell-script("north-claude-hook-projector", file-text(hook-script())))
