import "nixpkgs.clause"

HomeDirectory:
  homeDirectory: Text
HomeConfiguration:
  home: HomeDirectory
HomeArguments:
  config: HomeConfiguration

foreign binary-path(?packages: Sequence<Delayed<nix,Package>>): Text
  construction: "nix"
  call: "makeBinPath"
  from: "lib"
  failure: throw

export lane-sweep-module()
  configuration-module(path(myConfig.modules.lane-sweep.enable), "Daily archive-then-remove of worktree lanes idle for a day",
    {home-manager: {users: dictionary(configured-text(path(myConfig.modules.users.username)),
      (?home: Delayed<nix,HomeArguments>) =>
       {systemd: {user: {
         services: {lane-sweep: {
           Unit: {Description: "Archive and remove idle worktree lanes"},
           Service: {Type: "oneshot", ExecStart: "{?home.config.home.homeDirectory}/.local/bin/lane-sweep",
             Environment: ["PATH={?home.config.home.homeDirectory}/.local/bin:{binary-path([package(path(coreutils)), package(path(git)), package(path(gh)), package(path(python3))])}"],
             TimeoutStartSec: "1h"}}},
         timers: {lane-sweep: {
           Unit: {Description: "Daily idle worktree lane sweep"},
           Timer: {OnCalendar: "*-*-* 04:30", Persistent: true, RandomizedDelaySec: "15m"},
           Install: {WantedBy: ["timers.target"]}}}}}})}})
