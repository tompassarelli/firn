import "nixpkgs.clause"

# Weights preserve idle capacity; MemoryHigh throttles without a MemoryMax kill limit.
# The session weight must rise too: weights are ratios among sibling slices.
# systemd ships session.slice, so its settings are emitted as a drop-in override.
export agent-slice-module()
  configuration-module(path(myConfig.modules.agent-slice.enable), "agent.slice compute governance — weight-based backpressure so agent lanes yield to the desktop",
    {systemd: {user: {slices: {
      agent: {description: "Agent lanes — yielding compute class",
        sliceConfig: {CPUWeight: 20, IOWeight: 20, MemoryHigh: "61G"}},
      session: {sliceConfig: {CPUWeight: 300, IOWeight: 300}},
      app: {sliceConfig: {MemoryLow: "12G"}}}}}})
