import "nixpkgs.clause"

Symlink:
  foreign: "home-manager"
  type: "Path"

HomeDirectory:
  homeDirectory: Text

HomeFiles:
  mkOutOfStoreSymlink: Function<Text, Symlink>

HomeLibrary:
  file: HomeFiles

HomeConfiguration:
  home: HomeDirectory
  lib: HomeLibrary

HomeModuleArguments:
  config: HomeConfiguration

export bun-module()
  configuration-module(path(myConfig.modules.bun.enable), "Bun JavaScript runtime and package manager",
    {environment: {systemPackages: [package(path(bun))]},
     home-manager: {users: dictionary(configured-text(path(myConfig.modules.users.username)),
       (?home: Delayed<nix,HomeModuleArguments>) =>
         {home: {file: dictionary(".bunfig.toml",
           {source: ?home.config.lib.file.mkOutOfStoreSymlink(
             "{?home.config.home.homeDirectory}/code/nixos-config/dotfiles/bun/bunfig.toml")})}})}})
