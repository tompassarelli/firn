#lang beagle/js
(ns firn.tag-resolve-family
  (:require [firn.tag-resolve :as r]
            [firn.tag-resolve-driver :as driver]
            [firn.tag-inputs :as input]))

(def max-source-bytes Int 16777216)
(def max-directory-entries Int 16384)

(js/export
  (defunion DirectoryNamesResult
  (DirectoryNamesLoaded [names (Vec String)])
  (DirectoryNamesRejected [message String])))

(js/export
  (defunion ModulesLoadResult
  (ModulesLoaded [modules (Vec r/ModuleTags)])
  (ModulesRejected [message String])))

(js/export
  (defunion HostLoadResult
  (HostLoaded [data driver/TagResolveHostData])
  (HostRejected [message String])))

(js/export
  (defunion HostsLoadResult
  (HostsLoaded [hosts (Vec driver/TagResolveHostData)])
  (HostsRejected [message String])))

(js/export
  (defunion GeneratedLoadResult
  (GeneratedLoaded
    [present Bool
     text String])
  (GeneratedRejected [message String])))

(js/export
  (defunion AllowlistLoadResult
  (AllowlistLoaded [modules (Vec String)])
  (AllowlistRejected [message String])))

(defn path
  [root String
   relative String] String
  (str root "/" relative))

(defn errno-message
  [operation String
   relative String
   errno Int] String
  (str "firn tag resolve: " operation " '" relative
    "': errno " errno "\n"))

(defn parse-message
  [kind String
   relative String
   message String
   offset Int] String
  (str "firn tag resolve: invalid " kind " '" relative "' at offset "
    offset ": " message "\n"))

(js/export
  (defn directory-names
  [bridge Any
   root String
   relative String] DirectoryNamesResult
  (let [absolute String (path root relative)
        result Any (.listDirectory bridge absolute max-directory-entries)
        errno Int (.status bridge result)]
    (if (not (= errno 0))
      (if (= errno 2)
         (->DirectoryNamesLoaded [])
         (->DirectoryNamesRejected
           (errno-message "cannot list" relative errno)))
      (let [entries (Vec String) (.value bridge result)]
       (loop [index Int 0
              names (Vec String) []]
         (if (>= index (count entries))
           (->DirectoryNamesLoaded (sort names))
           (let [name String (nth entries index)
                 candidate String (str absolute "/" name)
                 kind-result Any (.pathKind bridge candidate)
                 kind-errno Int (.status bridge kind-result)]
             (if (= kind-errno 0)
               (let [kind Int (.value bridge kind-result)]
                (recur (+ index 1)
                  (if (= kind 2) (conj names name) names)))
               (if (= kind-errno 2)
                  (recur (+ index 1) names)
                  (->DirectoryNamesRejected
                    (errno-message "cannot inspect"
                      (str relative "/" name) kind-errno))))))))))))

(defn clause-delimiter? [character String] Bool
  (or (= character " ")
      (= character "\t")
      (= character "\r")
      (= character "\n")
      (= character "[")))

(defn clause-at?
  [source String
   offset Int
   clause String] Bool
  (let [end Int (+ offset (count clause))]
    (and (<= end (count source))
         (= (subs source offset end) clause)
         (< end (count source))
         (clause-delimiter? (subs source end (+ end 1))))))

(defn source-has-tag-clause? [source String] Bool
  (loop [offset Int 0]
    (if (>= offset (count source))
      false
      (if (or (clause-at? source offset ":tags")
              (clause-at? source offset ":tags-opt-in")
              (clause-at? source offset ":tag-overrides"))
        true
        (recur (+ offset 1))))))

(defn empty-module [name String] r/ModuleTags
  (r/->ModuleTags name [] [] []))

(defn load-module
  [bridge Any
   root String
   name String] ModulesLoadResult
  (let [relative String (str "modules/" name "/default.bnix")
        absolute String (path root relative)
        kind-result Any (.pathKind bridge absolute)
        kind-errno Int (.status bridge kind-result)]
    (if (not (= kind-errno 0))
      (if (= kind-errno 2)
        (->ModulesLoaded [(empty-module name)])
        (->ModulesRejected
          (errno-message "cannot inspect" relative kind-errno)))
      (let [kind Int (.value bridge kind-result)]
        (if (not (or (= kind 1) (= kind 3)))
          (->ModulesLoaded [(empty-module name)])
          (let [read-result Any (.readText bridge absolute max-source-bytes)
                read-errno Int (.status bridge read-result)]
            (if (not (= read-errno 0))
              (->ModulesRejected
                (errno-message "cannot read" relative read-errno))
              (let [source String (.value bridge read-result)]
                (if (not (source-has-tag-clause? source))
                  (->ModulesLoaded [(empty-module name)])
                  (match (input/module-tags-from-source name source)
                    [(ModuleSourceParsed value)
                     (->ModulesLoaded [value])]
                    [(ModuleSourceRejected message offset)
                     (->ModulesRejected
                       (parse-message "module tag source" relative message
                         offset))]))))))))))

(defn load-modules-from
  [bridge Any
   root String
   names (Vec String)
   index Int
   modules (Vec r/ModuleTags)] ModulesLoadResult
  (if (>= index (count names))
    (->ModulesLoaded modules)
    (match (load-module bridge root (nth names index))
      [(ModulesRejected message) (->ModulesRejected message)]
      [(ModulesLoaded loaded)
       (load-modules-from bridge root names (+ index 1) (into modules loaded))])))

(js/export
 (defn load-modules [bridge Any root String] ModulesLoadResult
  (match (directory-names bridge root "modules")
    [(DirectoryNamesRejected message) (->ModulesRejected message)]
    [(DirectoryNamesLoaded names) (load-modules-from bridge root names 0 [])])))

(js/export
 (defn load-darwin-allowlist [bridge Any root String] AllowlistLoadResult
  (let [relative String "config/darwin-modules.json"
        absolute String (path root relative)
        result Any (.readText bridge absolute max-source-bytes)
        errno Int (.status bridge result)]
    (if (not (= errno 0))
      (->AllowlistRejected (errno-message "cannot read" relative errno))
      (let [source String (.value bridge result)]
       (match (input/darwin-allowlist-from-json source)
         [(DarwinAllowlistParsed modules) (->AllowlistLoaded modules)]
         [(DarwinAllowlistRejected message offset)
          (->AllowlistRejected
            (parse-message "Darwin allowlist" relative message offset))]))))))

(defn load-generated
  [bridge Any
   root String
   host String
   needed Bool] GeneratedLoadResult
  (if (not needed)
    (->GeneratedLoaded false "")
    (let [relative String (str "hosts/" host "/_generated-enables.bnix")
          absolute String (path root relative)
          kind-result Any (.pathKind bridge absolute)
          kind-errno Int (.status bridge kind-result)]
      (if (not (= kind-errno 0))
        (if (= kind-errno 2)
           (->GeneratedLoaded false "")
           (->GeneratedRejected
             (errno-message "cannot inspect" relative kind-errno)))
        (let [kind Int (.value bridge kind-result)]
         (if (not (or (= kind 1) (= kind 3)))
           (->GeneratedLoaded false "")
           (let [read-result Any (.readText bridge absolute max-source-bytes)
                 read-errno Int (.status bridge read-result)]
             (if (not (= read-errno 0))
              (->GeneratedRejected
                (errno-message "cannot read" relative read-errno))
              (let [text String (.value bridge read-result)]
                (->GeneratedLoaded true text))))))))))

(defn empty-host [host String] r/HostTags
  (r/->HostTags host [] [] "linux" false []))

(defn host-data
  [tags r/HostTags
   tag-source-present Bool
   generated GeneratedLoadResult] HostLoadResult
  (match generated
    [(GeneratedRejected message) (->HostRejected message)]
    [(GeneratedLoaded present text)
     (->HostLoaded
       (driver/->TagResolveHostData tags tag-source-present present text))]))

(defn parse-host-source
  [bridge Any
   root String
   host String
   relative String
   source String
   load-generated? Bool] HostLoadResult
  (match (input/host-tags-from-source host source [])
    [(HostSourceRejected message offset)
     (->HostRejected
       (parse-message "host tag source" relative message offset))]
    [(HostSourceParsed preliminary)
     (if (= (r/hosttags-platform preliminary) "darwin")
       (match (load-darwin-allowlist bridge root)
         [(AllowlistRejected message) (->HostRejected message)]
         [(AllowlistLoaded allowed)
          (match (input/host-tags-from-source host source allowed)
            [(HostSourceRejected message offset)
             (->HostRejected
               (parse-message "host tag source" relative message offset))]
            [(HostSourceParsed tags)
             (host-data tags true
               (load-generated bridge root host load-generated?))])])
       (host-data preliminary true
         (load-generated bridge root host load-generated?)))]))

(js/export
  (defn load-host
  [bridge Any
   root String
   host String
   load-generated? Bool] HostLoadResult
  (let [relative String (str "hosts/" host "/enabled-tags.bnix")
        absolute String (path root relative)
        kind-result Any (.pathKind bridge absolute)
        kind-errno Int (.status bridge kind-result)]
    (if (not (= kind-errno 0))
      (if (= kind-errno 2)
         (host-data (empty-host host) false
           (load-generated bridge root host load-generated?))
         (->HostRejected
           (errno-message "cannot inspect" relative kind-errno)))
      (let [kind Int (.value bridge kind-result)]
       (if (not (or (= kind 1) (= kind 3)))
         (host-data (empty-host host) false
           (load-generated bridge root host load-generated?))
         (let [read-result Any (.readText bridge absolute max-source-bytes)
               read-errno Int (.status bridge read-result)]
           (if (not (= read-errno 0))
             (->HostRejected
               (errno-message "cannot read" relative read-errno))
             (let [source String (.value bridge read-result)]
               (parse-host-source bridge root host relative source
                 load-generated?))))))))))

(defn load-hosts-from
  [bridge Any
   root String
   names (Vec String)
   index Int
   load-generated? Bool
   hosts (Vec driver/TagResolveHostData)] HostsLoadResult
  (if (>= index (count names))
    (->HostsLoaded hosts)
    (match (load-host bridge root (nth names index) load-generated?)
      [(HostRejected message) (->HostsRejected message)]
      [(HostLoaded data)
       (load-hosts-from bridge root names (+ index 1) load-generated?
         (conj hosts data))])))

(defn load-hosts
  [bridge Any
   root String
   names (Vec String)
   action driver/TagResolveAction] HostsLoadResult
  (if (driver/action-all? action)
    (load-hosts-from bridge root names 0 (driver/action-emit? action) [])
    (load-hosts-from bridge root [(driver/action-host action)] 0
      (driver/action-emit? action) [])))

(defn string-member?
  [values (Vec String)
   candidate String] Bool
  (loop [index Int 0]
    (if (>= index (count values))
      false
      (if (= (nth values index) candidate)
        true
        (recur (+ index 1))))))

(defn placeholder-hosts [names (Vec String)] (Vec driver/TagResolveHostData)
  (loop [index Int 0
         hosts (Vec driver/TagResolveHostData) []]
    (if (>= index (count names))
      hosts
      (recur (+ index 1)
        (conj hosts
          (driver/->TagResolveHostData
            (empty-host (nth names index)) false false ""))))))

(defn emit-io-error [bridge Any message String] Int
  (do (.err bridge message) 1))

(defn any-tag-source? [hosts (Vec driver/TagResolveHostData)] Bool
  (loop [index Int 0]
    (if (>= index (count hosts))
      false
      (if (driver/tagresolvehostdata-tag-source-present
            (nth hosts index))
        true
        (recur (+ index 1))))))

(defn execute-effects
  [bridge Any
   root String
   outcome driver/TagResolveOutcome
   index Int] Int
  (if (>= index (count (driver/tagresolveoutcome-effects outcome)))
    (driver/tagresolveoutcome-status outcome)
    (match (nth (driver/tagresolveoutcome-effects outcome) index)
      [(StdoutText text)
       (do (.out bridge text)
           (execute-effects bridge root outcome (+ index 1)))]
      [(StderrText text)
       (do (.err bridge text)
           (execute-effects bridge root outcome (+ index 1)))]
      [(WriteGenerated relative text)
       (let [errno Int (.writeTextAtomic bridge (path root relative) text)]
         (if (= errno 0)
           (execute-effects bridge root outcome (+ index 1))
           (emit-io-error bridge
             (errno-message "cannot write" relative errno))))])))

(defn run-action
  [bridge Any
   root String
   host-names (Vec String)
   action driver/TagResolveAction] Int
  (if (and (not (driver/action-all? action))
           (not (string-member? host-names (driver/action-host action))))
    (execute-effects bridge root
      (driver/run-tag-resolve-action
        (driver/->TagResolveRepositoryData []
          (placeholder-hosts host-names))
        action)
      0)
    (match (load-hosts bridge root host-names action)
      [(HostsRejected message) (emit-io-error bridge message)]
      [(HostsLoaded hosts)
       (if (and (driver/action-all? action)
                (driver/action-emit? action)
                (not (any-tag-source? hosts)))
         (execute-effects bridge root
           (driver/run-tag-resolve-action
             (driver/->TagResolveRepositoryData [] hosts)
             action)
           0)
         (match (load-modules bridge root)
           [(ModulesRejected message) (emit-io-error bridge message)]
           [(ModulesLoaded modules)
            (execute-effects bridge root
              (driver/run-tag-resolve-action
                (driver/->TagResolveRepositoryData modules hosts)
                action)
              0)]))])))

(defn repository-root [bridge Any] (U String Nil)
  (let [explicit (U String Nil) (.env bridge "FIRN_REPO")]
    (if (some? explicit)
      explicit
      (let [home (U String Nil) (.env bridge "HOME")]
        (if (some? home)
          (str home "/code/nixos-config/main")
          nil)))))

(defn default-host [bridge Any] String
  (let [host (U String Nil) (.env bridge "FIRN_HOST")]
    (if (some? host) host "whiterabbit")))

(defn usage-error [bridge Any] Int
  (do
    (.err bridge
      "Usage: firn tag resolve [<host>|all][+emit]\n")
    64))

(js/export
  (defn run [bridge Any args (Vec String)] Int
  (match (driver/parse-tag-resolve-argv args (default-host bridge)
           (some? (.env bridge "FIRN_TAG_EMIT")))
    [(OtherFirnCommand argv) (usage-error bridge)]
    [(InvalidTagResolveArgv argv) (usage-error bridge)]
    [(ParsedTagResolve action)
     (let [root (U String Nil) (repository-root bridge)]
       (if (nil? root)
         (do
           (.err bridge
             "firn tag resolve: FIRN_REPO and HOME are not set\n")
           1)
         (match (directory-names bridge root "hosts")
           [(DirectoryNamesRejected message) (emit-io-error bridge message)]
           [(DirectoryNamesLoaded names)
            (run-action bridge root names action)])))])))
