#lang beagle/js
(ns firn.tag-resolve-family
  (:require [firn.tag-resolve :as r]
            [firn.tag-resolve-driver :as driver]
            [firn.tag-inputs :as input]))

(def max-source-bytes Int 16777216)
(def max-directory-entries Int 16384)

(js/export
  (defunion DirectoryNamesResult
  (DirectoryNamesLoaded [names (Vec String)])
  (DirectoryNamesRejected [message String])))

(js/export
  (defunion ModulesLoadResult
  (ModulesLoaded [modules (Vec r/ModuleTags)])
  (ModulesRejected [message String])))

(js/export
  (defunion HostLoadResult
  (HostLoaded [data driver/TagResolveHostData])
  (HostRejected [message String])))

(js/export
  (defunion HostsLoadResult
  (HostsLoaded [hosts (Vec driver/TagResolveHostData)])
  (HostsRejected [message String])))

(js/export
  (defunion HostFactsLoadResult
  (HostFactsLoaded [facts Any])
  (HostFactsRejected [message String])))

(js/export
  (defunion AllowlistLoadResult
  (AllowlistLoaded [modules (Vec String)])
  (AllowlistRejected [message String])))

(defn path
  [root String
   relative String] String
  (str root "/" relative))

(defn errno-message
  [operation String
   relative String
   errno Int] String
  (str "firn tag resolve: " operation " '" relative
    "': errno " errno "\n"))

(defn parse-message
  [kind String
   relative String
   message String
   offset Int] String
  (str "firn tag resolve: invalid " kind " '" relative "' at offset "
    offset ": " message "\n"))

(js/export
  (defn directory-names
    [bridge Any
     root String
     relative String] DirectoryNamesResult
    (let [absolute String (path root relative)
          result Any (.listDirectory bridge absolute max-directory-entries)
          errno Int (.status bridge result)]
      (if (not (= errno 0))
      (if (= errno 2)
         (->DirectoryNamesLoaded [])
         (->DirectoryNamesRejected
           (errno-message "cannot list" relative errno)))
      (let [entries (Vec String) (.value bridge result)]
       (loop [index Int 0
              names (Vec String) []]
         (if (>= index (count entries))
           (->DirectoryNamesLoaded (sort names))
           (let [name String (nth entries index)
                 candidate String (str absolute "/" name)
                 kind-result Any (.pathKind bridge candidate)
                 kind-errno Int (.status bridge kind-result)]
             (if (= kind-errno 0)
               (let [kind Int (.value bridge kind-result)]
                (recur (+ index 1)
                  (if (= kind 2) (conj names name) names)))
               (if (= kind-errno 2)
                  (recur (+ index 1) names)
                  (->DirectoryNamesRejected
                    (errno-message "cannot inspect"
                      (str relative "/" name) kind-errno))))))))))))

(defn override-values
  [bridge Any
   facts Any
   name String
   tag String] (Vec r/OverrideValue)
  (loop [paths (Vec String) (.factOverridePaths bridge facts name tag)
         values (Vec r/OverrideValue) []]
    (if (= (count paths) 0)
      values
      (let [override-path String (first paths)
            literal String (.factOverrideLiteral bridge facts name tag override-path)]
        (recur (rest paths) (conj values (r/->OverrideValue override-path literal)))))))

(defn module-overrides
  [bridge Any
   facts Any
   name String] (Vec r/TaggedOverrides)
  (loop [tags (Vec String) (.factOverrideTags bridge facts name)
         overrides (Vec r/TaggedOverrides) []]
    (if (= (count tags) 0)
      overrides
      (let [tag String (first tags)]
        (recur (rest tags)
          (conj overrides
            (r/->TaggedOverrides tag (override-values bridge facts name tag))))))))

(defn modules-from-facts
  [bridge Any
   facts Any
   names (Vec String)] (Vec r/ModuleTags)
  (loop [remaining (Vec String) names
         modules (Vec r/ModuleTags) []]
    (if (= (count remaining) 0)
      modules
      (let [name String (first remaining)
            tags (Vec String) (.factTags bridge facts name)
            opt-in (Vec String) (.factOptIn bridge facts name)]
        (recur (rest remaining)
          (conj modules
            (r/->ModuleTags name tags opt-in (module-overrides bridge facts name))))))))

(js/export
 (defn load-modules
   [bridge Any
    root String] ModulesLoadResult
   (match (directory-names bridge root "modules")
    [(DirectoryNamesRejected message) (->ModulesRejected message)]
    [(DirectoryNamesLoaded names)
     (let [result Any (.readModuleFacts bridge root)
           status Int (.status bridge result)]
       (if (= status 0)
         (->ModulesLoaded (modules-from-facts bridge (.value bridge result) names))
         (->ModulesRejected
           (str "firn: cannot load module tags through galileo query: "
                (.moduleFactsMessage bridge result) "\n"))))])))

(js/export
 (defn load-darwin-allowlist
   [bridge Any
    root String] AllowlistLoadResult
   (let [relative String "config/darwin-modules.json"
         absolute String (path root relative)
         result Any (.readText bridge absolute max-source-bytes)
         errno Int (.status bridge result)]
     (if (not (= errno 0))
      (->AllowlistRejected (errno-message "cannot read" relative errno))
      (let [source String (.value bridge result)]
       (match (input/darwin-allowlist-from-json source)
         [(DarwinAllowlistParsed modules) (->AllowlistLoaded modules)]
         [(DarwinAllowlistRejected message offset)
          (->AllowlistRejected
            (parse-message "Darwin allowlist" relative message offset))]))))))

(defn empty-host [host String] r/HostTags
  (r/->HostTags host [] [] "linux" false []))

(defn enabled-tags
  [bridge Any
   facts Any
   host String] (Vec r/EnabledTag)
  (loop [tags (Vec String) (.hostEnabledTags bridge facts host)
         result (Vec r/EnabledTag) []]
    (if (= (count tags) 0)
      result
      (let [tag String (first tags)]
        (recur (rest tags)
          (conj result
            (r/->EnabledTag tag (.hostAdds bridge facts host tag)
              (.hostDrops bridge facts host tag))))))))

(defn host-tags
  [bridge Any
   facts Any
   host String
   platform String
   allowed (Vec String)] r/HostTags
  (r/->HostTags host (enabled-tags bridge facts host)
    (.hostDisabled bridge facts host) platform (= platform "darwin") allowed))

(defn host-from-facts
  [bridge Any
   root String
   facts Any
   host String] HostLoadResult
  (if (not (.hostDeclared bridge facts host))
    (->HostLoaded (driver/->TagResolveHostData (empty-host host) false []))
    (let [platform String (.hostPlatform bridge facts host)
          active (Vec String) (.hostActive bridge facts host)]
      (if (= platform "darwin")
        (match (load-darwin-allowlist bridge root)
          [(AllowlistRejected message) (->HostRejected message)]
          [(AllowlistLoaded allowed)
           (->HostLoaded (driver/->TagResolveHostData
             (host-tags bridge facts host platform allowed) true active))])
        (->HostLoaded (driver/->TagResolveHostData
          (host-tags bridge facts host platform []) true active))))))

(defn read-host-facts
  [bridge Any
   root String] HostFactsLoadResult
  (let [result Any (.readHostFacts bridge root)]
    (if (= (.status bridge result) 0)
      (->HostFactsLoaded (.value bridge result))
      (->HostFactsRejected
        (str "firn: cannot load host tags through galileo query: "
             (.moduleFactsMessage bridge result) "\n")))))

(js/export
  (defn load-host
    [bridge Any
     root String
     host String] HostLoadResult
    (match (read-host-facts bridge root)
      [(HostFactsRejected message) (->HostRejected message)]
      [(HostFactsLoaded facts) (host-from-facts bridge root facts host)])))

(defn load-hosts-from
  [bridge Any
   root String
   facts Any
   names (Vec String)
   index Int
   hosts (Vec driver/TagResolveHostData)] HostsLoadResult
  (if (>= index (count names))
    (->HostsLoaded hosts)
    (match (host-from-facts bridge root facts (nth names index))
      [(HostRejected message) (->HostsRejected message)]
      [(HostLoaded data)
       (load-hosts-from bridge root facts names (+ index 1) (conj hosts data))])))

(defn load-hosts
  [bridge Any
   root String
   names (Vec String)
   action driver/TagResolveAction] HostsLoadResult
  (match (read-host-facts bridge root)
    [(HostFactsRejected message) (->HostsRejected message)]
    [(HostFactsLoaded facts)
     (load-hosts-from bridge root facts
       (if (driver/action-all? action) names [(driver/action-host action)])
       0 [])]))

(defn string-member?
  [values (Vec String)
   candidate String] Bool
  (loop [index Int 0]
    (if (>= index (count values))
      false
      (if (= (nth values index) candidate)
        true
        (recur (+ index 1))))))

(defn placeholder-hosts [names (Vec String)] (Vec driver/TagResolveHostData)
  (loop [index Int 0
         hosts (Vec driver/TagResolveHostData) []]
    (if (>= index (count names))
      hosts
      (recur (+ index 1)
        (conj hosts
          (driver/->TagResolveHostData
            (empty-host (nth names index)) false []))))))

(defn emit-io-error
  [bridge Any
   message String] Int
  (do (.err bridge message) 1))

(defn any-tag-source? [hosts (Vec driver/TagResolveHostData)] Bool
  (loop [index Int 0]
    (if (>= index (count hosts))
      false
      (if (driver/tagresolvehostdata-tag-source-present
            (nth hosts index))
        true
        (recur (+ index 1))))))

(defn execute-effects
  [bridge Any
   root String
   outcome driver/TagResolveOutcome
   index Int] Int
  (if (>= index (count (driver/tagresolveoutcome-effects outcome)))
    (driver/tagresolveoutcome-status outcome)
    (match (nth (driver/tagresolveoutcome-effects outcome) index)
      [(StdoutText text)
       (do (.out bridge text)
           (execute-effects bridge root outcome (+ index 1)))]
      [(StderrText text)
       (do (.err bridge text)
           (execute-effects bridge root outcome (+ index 1)))]
      [(BuildGenerated relative)
       (let [status Int (.buildGenerated bridge root)]
         (if (= status 0)
           (execute-effects bridge root outcome (+ index 1))
           (emit-io-error bridge
             (str "firn tag resolve: galileo build '" relative "' exited "
               status "\n"))))])))

(js/export
  (defn run-action
    [bridge Any
     root String
     host-names (Vec String)
     action driver/TagResolveAction] Int
    (if (and (not (driver/action-all? action))
           (not (string-member? host-names (driver/action-host action))))
    (execute-effects bridge root
      (driver/run-tag-resolve-action
        (driver/->TagResolveRepositoryData []
          (placeholder-hosts host-names))
        action)
      0)
    (match (load-hosts bridge root host-names action)
      [(HostsRejected message) (emit-io-error bridge message)]
      [(HostsLoaded hosts)
       (if (and (driver/action-all? action)
                (driver/action-emit? action)
                (not (any-tag-source? hosts)))
         (execute-effects bridge root
           (driver/run-tag-resolve-action
             (driver/->TagResolveRepositoryData [] hosts)
             action)
           0)
         (match (load-modules bridge root)
           [(ModulesRejected message) (emit-io-error bridge message)]
           [(ModulesLoaded modules)
            (execute-effects bridge root
              (driver/run-tag-resolve-action
                (driver/->TagResolveRepositoryData modules hosts)
                action)
              0)]))]))))

(defn repository-root [bridge Any] (U String Nil)
  (let [explicit (U String Nil) (.env bridge "FIRN_REPO")]
    (if (some? explicit)
      explicit
      (let [home (U String Nil) (.env bridge "HOME")]
        (if (some? home)
          (str home "/code/nixos-config/main")
          nil)))))

(defn default-host [bridge Any] String
  (let [host (U String Nil) (.env bridge "FIRN_HOST")]
    (if (some? host) host "whiterabbit")))

(defn usage-error [bridge Any] Int
  (do
    (.err bridge
      "Usage: firn tag resolve [<host>|all][+emit]\n")
    64))

(js/export
  (defn run
    [bridge Any
     args (Vec String)] Int
    (match (driver/parse-tag-resolve-argv args (default-host bridge)
           (some? (.env bridge "FIRN_TAG_EMIT")))
    [(OtherFirnCommand argv) (usage-error bridge)]
    [(InvalidTagResolveArgv argv) (usage-error bridge)]
    [(ParsedTagResolve action)
     (let [root (U String Nil) (repository-root bridge)]
       (if (nil? root)
         (do
           (.err bridge
             "firn tag resolve: FIRN_REPO and HOME are not set\n")
           1)
         (match (directory-names bridge root "hosts")
           [(DirectoryNamesRejected message) (emit-io-error bridge message)]
           [(DirectoryNamesLoaded names)
            (run-action bridge root names action)])))])))
