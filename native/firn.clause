RequiredLeaf:
  required: Text

DefaultLeaf:
  usage: Text
  arguments: Sequence<Text>

Command:
  node: Text
  edge: Text
  leaf: RequiredLeaf | DefaultLeaf
  detail-gap: Text
  summary: Text
  common-gap: Text
  common-summary: Text
  executable: Text

Execution:
  executable: Text
  arguments: Sequence<Text>

Plan:
  steps: Sequence<Execution>

Diagnostic:
  message: Text
  status: F64
  descriptor: F64

UnknownWalk:
  node: Text
  edge: Text

flake-inputs(): Command
  {node: "flake", edge: "inputs",
   leaf: {usage: "all", arguments: ["all"]},
   detail-gap: "  ", summary: "List flake inputs: source, age, locked rev, follows, broken-path check.",
   common-gap: "", common-summary: "",
   executable: "firn-views"}

flake-input-resolve(): Command
  {node: "flake-input", edge: "resolve",
   leaf: {usage: "emit", arguments: ["emit"]},
   detail-gap: "  ", summary: "collect :flake-inputs from active modules; emit splices into flake.bnix",
   common-gap: "", common-summary: "",
   executable: "firn-flake-input"}

