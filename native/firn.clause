export command-groups(): Sequence<Sequence<Command>>
  [[flake-inputs()],
   [flake-input-resolve()],
   [host-prepare(), host-activate(), host-rebuild(), host-rollback(), host-impact(), host-list(), host-status(), host-gen(), host-deploy()],
   [module-list(), module-refs(), module-status(), module-add(), module-enable(), module-disable()],
   [platform-list(), platform-show(), platform-safelist()],
   [repo-watch(), repo-diff(), repo-doctor(), repo-pin-ancestry(), repo-upgrade(), repo-build(), repo-validate(), repo-lint(), repo-architecture()],
   [schema-explain(), schema-extract()],
   [secret-list(), secret-show(), secret-edit()],
   [tag-list(), tag-show(), tag-filter(), tag-index(), tag-resolve(), tag-enable(), tag-disable(), tag-opt-in(), tag-opt-out(), tag-status()],
   [template-service(), template-submodule(), template-home(), template-host()]]

common-commands-text(): Text
  common-command-text(repo-build(), "build") ++
    common-command-text(repo-validate(), "validate") ++
    common-command-text(host-impact(), "impact") ++
    common-command-text(repo-doctor(), "doctor") ++
    common-command-text(tag-status(), "status") ++
    common-command-text(tag-enable(), "enable <t>") ++
    common-command-text(tag-opt-in(), "opt-in <t>+<m>") ++
    common-command-text(module-disable(), "disable <m>") ++
    common-command-text(repo-diff(), "diff")

leaf-usage(?leaf: RequiredLeaf | DefaultLeaf): Text
  match(?leaf, ?required: RequiredLeaf => ?required.required, ?default: DefaultLeaf => ?default.usage)

command-usage(?command: Command): Text
  if(leaf-usage(?command.leaf) = "", ?command.edge, "{?command.edge} {leaf-usage(?command.leaf)}")

common-command-text(?command: Command, ?usage: Text): Text
  "  firn {?command.node} {?usage}{?command.common-gap}{?command.common-summary}\n"

command-text(?command: Command): Text
  "  {command-usage(?command)}{?command.detail-gap}{?command.summary}\n"

export full-help-text(): Text
  "firn — config management\n\nUsage:\n  firn <node> <edge> [<leaf>]  [<node> <edge> [<leaf>] ...]\n\nOperator shortcuts:\n  firn rebuild [host]          build + validate + switch\n  firn rollback <generation>  activate one exact prior generation\n\nCommon graph commands:\n{common-commands-text()}\nFull graph:\n\n{fold(command-groups(), "", ?text, ?group, ?text ++ fold(?group, "", ?text, ?command, ?text ++ if(?text = "", "{?command.node}\n", "") ++ command-text(?command)) ++ "\n")}"

export commands(): Sequence<Command>
  fold(command-groups(), [], ?commands, ?group, fold(?group, ?commands, ?commands, ?command, append(?commands, ?command)))

export command-count(): F64
  count(commands())

commands-for-node(?commands: Sequence<Command>, ?node: Text): Sequence<Command>
  fold(?commands, [], ?found, ?command, if(?command.node = ?node, append(?found, ?command), ?found))

unknown-command(?node: Text, ?edge: Text): Command | UnknownWalk
  {node: ?node, edge: ?edge}

find-in(?commands: Sequence<Command>, ?node: Text, ?edge: Text): Command | UnknownWalk
  fold(?commands, unknown-command(?node, ?edge), ?found, ?command,
    if(?command.node = ?node and ?command.edge = ?edge, ?command, ?found))

export find-command(?node: Text, ?edge: Text): Command | UnknownWalk
  find-in(commands(), ?node, ?edge)

node-known(?commands: Sequence<Command>, ?node: Text): Bool
  count(commands-for-node(?commands, ?node)) > 0

node-names(?commands: Sequence<Command>): Sequence<Text>
  fold(?commands, [], ?nodes, ?command,
    if(fold(?nodes, false, ?found, ?node, ?found or ?node = ?command.node), ?nodes, append(?nodes, ?command.node)))

node-help(?commands: Sequence<Command>, ?node: Text): Text
  fold(commands-for-node(?commands, ?node), "Edges on '{?node}':\n", ?text, ?command,
    ?text ++ "  firn {?command.node} {command-usage(?command)}\n      {?command.summary}\n")

export node-help-text(?node: Text): Text
  node-help(commands(), ?node)

unknown-walk(?commands: Sequence<Command>, ?node: Text, ?edge: Text): Text
  "firn: unknown walk '{?node} {?edge}'\n" ++
    if(node-known(?commands, ?node),
      "  edges on '{?node}': {join([?command.edge for ?command in commands-for-node(?commands, ?node)], ", ")}\n",
      "  no such node '{?node}'\n  available nodes: {join(node-names(?commands), ", ")}\n")

export unknown-walk-text(?node: Text, ?edge: Text): Text
  unknown-walk(commands(), ?node, ?edge)

incomplete-walk(?commands: Sequence<Command>): Text
  "firn: incomplete walk; expected <node> <edge> [<leaf>]\n  available nodes: {join(node-names(?commands), ", ")}\n"

export incomplete-walk-text(): Text
  incomplete-walk(commands())

error(?message: Text): Diagnostic
  {message: ?message, status: 1, descriptor: 2}

help(?message: Text): Diagnostic
  {message: ?message, status: 0, descriptor: 1}

missing-leaf(?command: Command): Diagnostic
  error("firn: '{?command.node} {?command.edge}' requires a leaf node\nUsage: firn {?command.node} {?command.edge} {leaf-usage(?command.leaf)}\n  {?command.summary}\n")

execution(?command: Command, ?leaf: Sequence<Text>): Execution
  {executable: ?command.executable, arguments: fold(?leaf, [?command.node, ?command.edge], ?args, ?arg, append(?args, ?arg))}

append-step(?steps: Sequence<Execution>, ?command: Command, ?leaf: Sequence<Text>): Plan
  {steps: append(?steps, execution(?command, ?leaf))}

Start:
  usage: Text

Node:
  steps: Sequence<Execution>
  node: Text

PendingLeaf:
  steps: Sequence<Execution>
  command: Command

PossibleNode:
  steps: Sequence<Execution>
  command: Command
  node: Text

Alias:
  command: Command
  usage: Text

CompleteAlias:
  execution: Execution
  usage: Text

Prewarm:
  arguments: Sequence<Text>

initial(): Start | Plan | Node | PendingLeaf | PossibleNode | Alias | CompleteAlias | Prewarm | Diagnostic
  {usage: full-help-text()}

start-token(?start: Start, ?token: Text): Node | Alias | Prewarm | Diagnostic
  if(?token = "help" or ?token = "-h" or ?token = "--help", help(?start.usage),
    if(?token = "rebuild", {command: host-rebuild(), usage: "Usage: firn rebuild [host]\n"},
      if(?token = "rollback", {command: host-rollback(), usage: "Usage: firn rollback <generation>\n"},
        if(?token = "--print-warm-key" or ?token = "--plan-detached" or ?token = "--plan-reference-transaction" or ?token = "--reference-transaction" or ?token = "--worker",
          {arguments: [?token]}, {steps: [], node: ?token}))))

node-token(?commands: Sequence<Command>, ?state: Node, ?token: Text): PendingLeaf | Diagnostic
  match(find-in(?commands, ?state.node, ?token),
    ?command: Command => {steps: ?state.steps, command: ?command},
    ?unknown: UnknownWalk => error(unknown-walk(?commands, ?unknown.node, ?unknown.edge)))

leaf-token(?commands: Sequence<Command>, ?state: PendingLeaf, ?token: Text): Plan | PossibleNode
  match(?state.command.leaf,
    ?required: RequiredLeaf => append-step(?state.steps, ?state.command, [?token]),
    ?default: DefaultLeaf => if(node-known(?commands, ?token),
      {steps: ?state.steps, command: ?state.command, node: ?token},
      append-step(?state.steps, ?state.command, [?token])))

possible-node-token(?commands: Sequence<Command>, ?state: PossibleNode, ?token: Text): PendingLeaf | Node | Diagnostic
  match(find-in(?commands, ?state.node, ?token),
    ?command: Command => match(?state.command.leaf,
      ?default: DefaultLeaf => {steps: append(?state.steps, execution(?state.command, ?default.arguments)), command: ?command},
      ?required: RequiredLeaf => missing-leaf(?state.command)),
    ?unknown: UnknownWalk => {steps: append(?state.steps, execution(?state.command, [?state.node])), node: ?token})

alias-token(?state: Alias, ?token: Text): CompleteAlias | Diagnostic
  if(starts-with(?token, "-"), error(?state.usage), {execution: execution(?state.command, [?token]), usage: ?state.usage})

parse-token(?commands: Sequence<Command>, ?state: Start | Plan | Node | PendingLeaf | PossibleNode | Alias | CompleteAlias | Prewarm | Diagnostic, ?token: Text): Start | Plan | Node | PendingLeaf | PossibleNode | Alias | CompleteAlias | Prewarm | Diagnostic
  match(?state,
    ?start: Start => start-token(?start, ?token),
    ?plan: Plan => {steps: ?plan.steps, node: ?token},
    ?node: Node => node-token(?commands, ?node, ?token),
    ?leaf: PendingLeaf => leaf-token(?commands, ?leaf, ?token),
    ?node: PossibleNode => possible-node-token(?commands, ?node, ?token),
    ?alias: Alias => alias-token(?alias, ?token),
    ?alias: CompleteAlias => error(?alias.usage),
    ?prewarm: Prewarm => {arguments: append(?prewarm.arguments, ?token)},
    ?diagnostic: Diagnostic => ?diagnostic)

finish-node(?commands: Sequence<Command>, ?node: Node): Diagnostic
  if(count(?node.steps) = 0,
    if(node-known(?commands, ?node.node), help(node-help(?commands, ?node.node)), error(incomplete-walk(?commands))),
    error("firn: dangling token after a complete walk: {?node.node}\n"))

finish-leaf(?pending: PendingLeaf): Plan | Diagnostic
  match(?pending.command.leaf,
    ?required: RequiredLeaf => missing-leaf(?pending.command),
    ?default: DefaultLeaf => append-step(?pending.steps, ?pending.command, ?default.arguments))

finish-alias(?alias: Alias): Plan | Diagnostic
  match(?alias.command.leaf,
    ?required: RequiredLeaf => error(?alias.usage),
    ?default: DefaultLeaf => {steps: [execution(?alias.command, ?default.arguments)]})

finish(?commands: Sequence<Command>, ?state: Start | Plan | Node | PendingLeaf | PossibleNode | Alias | CompleteAlias | Prewarm | Diagnostic): Plan | Diagnostic
  match(?state,
    ?start: Start => help(?start.usage),
    ?plan: Plan => ?plan,
    ?node: Node => finish-node(?commands, ?node),
    ?leaf: PendingLeaf => finish-leaf(?leaf),
    ?node: PossibleNode => append-step(?node.steps, ?node.command, [?node.node]),
    ?alias: Alias => finish-alias(?alias),
    ?alias: CompleteAlias => {steps: [?alias.execution]},
    ?prewarm: Prewarm => {steps: [{executable: "firn-prewarm", arguments: ?prewarm.arguments}]},
    ?diagnostic: Diagnostic => ?diagnostic)

parse(?commands: Sequence<Command>, ?args: Sequence<Text>): Plan | Diagnostic
  finish(?commands, fold(?args, initial(), ?state, ?token, parse-token(?commands, ?state, ?token)))

export parse-dispatch(?args: Sequence<Text>): Plan | Diagnostic
  parse(commands(), ?args)

foreign write-output(?descriptor: F64, ?message: Text): F64
  call: "writeSync"
  from: "node:fs"
  failure: throw

foreign execute-runtime(?executable: Text, ?arguments: Sequence<Text>): F64
  call: "executeRuntime"
  from: "../bin/firn-io.mjs"
  failure: throw

procedure deliver-diagnostic(?diagnostic: Diagnostic): F64
  write-output(?diagnostic.descriptor, ?diagnostic.message)
  ?diagnostic.status

procedure execute-plan(?plan: Plan): F64
  fold(?plan.steps, 0, ?status, ?step,
    if(?status = 0, execute-runtime(?step.executable, ?step.arguments), ?status))

export procedure run(?args: Sequence<Text>): F64
  match(parse-dispatch(?args),
    ?plan: Plan => execute-plan(?plan),
    ?diagnostic: Diagnostic => deliver-diagnostic(?diagnostic))
