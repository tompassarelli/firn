#lang beagle/js
(ns firn.views-test (:require [firn.views :as views]))

(defn suffix [seed Int] String (if (= seed 0) "" (str seed)))

(defn row [module String platform String] views/PlatformRow
  (views/->PlatformRow module platform))

(defn verdict [verdicts (Vec views/PlatformVerdict) name String] Keyword
  (let [(found (U views/PlatformVerdict Nil)) (views/verdict-for verdicts name)]
    (if (nil? found) :missing (views/platformverdict-verdict found))))

(defn case-platform-verdicts [seed Int] Bool
  (let [both String (str "both" (suffix seed))
        linux String (str "linux" (suffix seed))
        darwin String (str "darwin" (suffix seed))
        neither String (str "neither" (suffix seed))
        everywhere (Vec views/PlatformVerdict)
        (views/platform-matrix [both linux]
          [(row both "linux") (row linux "linux") (row both "darwin")])
        nowhere (Vec views/PlatformVerdict)
        (views/platform-matrix [darwin neither] [(row darwin "darwin")])]
    (and
      (= (verdict everywhere both) :both)
      (= (verdict everywhere linux) :linux-only)
      (= (verdict nowhere darwin) :darwin-only)
      (= (verdict nowhere neither) :neither))))

(defn action-kind [seed Int action views/ViewsAction] String
  (match action
    [(FlakeInputs token) "flake"]
    [(PlatformList selection) "platform-list"]
    [(PlatformShow module) "platform-show"]
    [(PlatformSafelist token) "platform-safelist"]
    [(SchemaExplain input) "schema-explain"]
    [(SchemaExtract host) (str "schema-extract:" host)]
    [(HostGeneration host) (str "host-gen:" host)]))

(defn parsed-kind [seed Int argv (Vec String)] String
  (match (views/parse-views-argv argv (str "host-a" (if (= seed 0) "" seed)))
    [(InvalidViewsArgv invalid) "invalid"]
    [(ParsedViews action) (action-kind seed action)]))

(defn case-argv [seed Int] Bool
  (and
    (= (parsed-kind seed ["flake" "inputs"]) "flake")
    (= (parsed-kind seed ["platform" "list" "all"]) "platform-list")
    (= (parsed-kind seed ["platform" "show" (str "linux" (if (= seed 0) "" seed))]) "platform-show")
    (= (parsed-kind seed ["platform" "safelist" "all"]) "platform-safelist")
    (=
      (parsed-kind seed ["schema" "explain" (str "services.mode" (if (= seed 0) "" seed))])
      "schema-explain")
    (=
      (parsed-kind seed ["schema" "extract"])
      (str "schema-extract:host-a" (if (= seed 0) "" seed)))
    (= (parsed-kind seed ["host" "gen"]) (str "host-gen:host-a" (if (= seed 0) "" seed)))
    (= (parsed-kind seed ["stale"]) "invalid")))

(defn child-conservation? [seed Int] Bool
  (let [
     status
     Int
     (+ 1 (mod seed 127))
     out
     String
     (str "output-" seed)
     err
     String
     (str "error-" seed)
     failed
     views/CommandResult
     (views/render-host-generation (views/->ChildResult status out err))
     extract
     views/CommandResult
     (views/render-schema-extract (str "host-" seed) (views/->ChildResult status out err))]
    (and
      (= (views/commandresult-status failed) status)
      (= (views/commandresult-status extract) status)
      (views/starts-with? (views/commandresult-stderr extract) err))))

(js/export
  (defn run-scenarios [] Int
    (if (and
      (case-platform-verdicts 0)
      (case-argv 0))
      0
      (do (println "FAIL views scenarios") 1))))

(js/export
  (defn run-properties [samples Int] Int
    (if (<= samples 0) 1
      (loop [index Int 0 seed Int 73421]
        (if (>= index samples) 0
          (if (child-conservation? seed)
            (recur (+ index 1) (mod (* seed 48271) 2147483647))
            (do (println (str "FAIL child conservation seed=" seed)) 1)))))))
