#lang beagle/js
(ns firn.repo-build-test (:require [firn.repo-build :as build]))

(defn expect [seed Int condition Bool message String] Int (if condition 0 1))

(defn test-path-contract [seed Int] Int
  (expect
    seed
    (and
      (build/source-path? "flake.bnix")
      (build/source-path? (str "modules/alpha" (if (= seed 0) "" seed) "/default.bnix"))
      (not (build/source-path? "scripts/fixture.bnix"))
      (not (build/source-path? "tests/fixture.bnix"))
      (not (build/source-path? "docs/fixtures/example.bnix"))
      (not (build/source-path? (str "hosts/alpha" (if (= seed 0) "" seed) "/enabled-tags.bnix")))
      (not (build/source-path? "result-old/module.bnix"))
      (not (build/source-path? ".direnv/cache/module.bnix"))
      (build/obsolete-output-path? (str "hosts/alpha" (if (= seed 0) "" seed) "/enabled-tags.nix"))
      (=
        (build/output-relative (str "modules/alpha" (if (= seed 0) "" seed) "/default.bnix"))
        (str "modules/alpha" (if (= seed 0) "" seed) "/default.nix")))
    "source inventory path contract"))

(defn test-command-contract [seed Int] Int
  (expect
    seed
    (and
      (instance? build/ParsedRepoBuild (build/parse-repo-build-argv ["repo" "build"]))
      (instance? build/ParsedRepoBuild (build/parse-repo-build-argv ["repo" "build" "all"]))
      (instance? build/InvalidRepoBuildArgv (build/parse-repo-build-argv ["repo" "build" "host"]))
      (instance? build/OtherRepoBuildCommand (build/parse-repo-build-argv ["repo" "validate"])))
    "repo build argv contract"))

(js/export
  (defn run-scenarios [] Int
    (if (and
      (= (test-path-contract 0) 0)
      (= (test-command-contract 0) 0))
      0
      (do (println "FAIL repo_build scenarios") 1))))
