DirectoryObservation:
  status: F64
  names: Sequence<Text>

PathObservation:
  status: F64
  kind: F64

HostNames:
  names: Sequence<Text>
  error: Text

CommandResult:
  output: Text
  error: Text
  status: F64

foreign list-directory(?path: Text): DirectoryObservation
  call: "listDirectory"
  from: "./firn-host-list-os.mjs"
  failure: throw

foreign path-kind(?path: Text): PathObservation
  call: "pathKind"
  from: "./firn-host-list-os.mjs"
  failure: throw

foreign write-output(?fd: F64, ?message: Text): F64
  call: "writeSync"
  from: "node:fs"
  failure: throw

empty-hosts(): HostNames
  {names: [], error: ""}

errno-message(?operation: Text, ?relative: Text, ?errno: F64): Text
  "firn host list: {?operation} '{?relative}': errno {?errno}\n"

inspection-result(?prior: HostNames, ?name: Text, ?observation: PathObservation): HostNames
  if(?observation.status = 0,
    if(?observation.kind = 2, {names: append(?prior.names, ?name), error: ""}, ?prior),
    if(?observation.status = 2, ?prior,
      {names: ?prior.names, error: errno-message("cannot inspect", "hosts/{?name}", ?observation.status)}))

procedure inspect-entry(?root: Text, ?prior: HostNames, ?name: Text): HostNames
  if(?prior.error = "", inspection-result(?prior, ?name, path-kind("{?root}/hosts/{?name}")), ?prior)

procedure inspect-entries(?root: Text, ?names: Sequence<Text>): HostNames
  fold(?names, empty-hosts(), ?prior, ?name, inspect-entry(?root, ?prior, ?name))

procedure listed-hosts(?root: Text, ?observation: DirectoryObservation): HostNames
  if(?observation.status = 0,
    if(count(?observation.names) > 16384,
      {names: [], error: errno-message("cannot list", "hosts", 27)},
      inspect-entries(?root, ?observation.names)),
    if(?observation.status = 2, empty-hosts(),
      {names: [], error: errno-message("cannot list", "hosts", ?observation.status)}))

render-hosts(?names: Sequence<Text>): Text
  "Hosts ({count(?names)}):\n{join(["  {?name}\n" for ?name in ?names], "")}"

command-result(?hosts: HostNames): CommandResult
  if(?hosts.error = "",
    {output: render-hosts(sort(?hosts.names)), error: "", status: 0},
    {output: "", error: ?hosts.error, status: 1})

export procedure host-list(?root: Text): CommandResult
  command-result(listed-hosts(?root, list-directory("{?root}/hosts")))

procedure deliver(?result: CommandResult): F64
  write-output(1, ?result.output)
  write-output(2, ?result.error)
  ?result.status

export handles(?args: Sequence<Text>): Bool
  if(?args = ["host", "list"], true, ?args = ["host", "list", "all"])

export procedure run(?root: Text, ?args: Sequence<Text>): F64
  deliver(if(handles(?args), host-list(?root),
    {output: "", error: "Usage: firn host list [all]\n", status: 64}))
