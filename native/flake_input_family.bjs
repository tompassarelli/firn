#lang beagle/js
(ns firn.flake-input-family
  (:require [firn.flake-input-driver :as driver]))

(def max-source-bytes Int 16777216)

(defn read-flake [bridge Any root String] String
  (let [result Any (.readText bridge (str root "/flake.nix") max-source-bytes)]
    (if (= (.status bridge result) 0) (.value bridge result) "")))

(defn emit-error [bridge Any message String] Int
  (do (.err bridge (str "firn flake-input resolve: " message "\n")) 1))

(js/export
 (defn run-root [bridge Any root String] Int
  (let [before String (read-flake bridge root)
        build-status Int (.runFlakeBuild bridge root)]
    (if (not (= build-status 0))
      (emit-error bridge (str "galileo build of flake.gal exited " build-status))
      (let [facts Any (.readFlakeInputs bridge root)]
        (if (not (= (.status bridge facts) 0))
          (emit-error bridge
            (str "cannot read flake inputs through galileo query: "
              (.moduleFactsMessage bridge facts)))
          (do
            (.out bridge
              (driver/summary-text
                (driver/inputs-from-rows (.value bridge facts))
                (not (= before (read-flake bridge root)))))
            0)))))))

(defn repository-root [bridge Any] (U String Nil)
  (let [explicit (U String Nil) (.env bridge "FIRN_REPO")]
    (if (some? explicit)
      explicit
      (let [home (U String Nil) (.env bridge "HOME")]
        (if (some? home)
          (str home "/code/nixos-config/main")
          nil)))))

(defn usage-error [bridge Any] Int
  (do
    (.err bridge "Usage: firn flake-input resolve emit\n")
    64))

(js/export
 (defn run [bridge Any args (Vec String)] Int
  (match (driver/parse-flake-input-argv args)
    [(OtherFirnCommand argv) (usage-error bridge)]
    [(InvalidFlakeInputArgv argv) (usage-error bridge)]
    [(ParsedFlakeInputEmit token)
     (let [root (U String Nil) (repository-root bridge)]
       (if (nil? root)
         (do
           (.err bridge
             "firn flake-input resolve: FIRN_REPO and HOME are not set\n")
           1)
         (run-root bridge root)))])))
