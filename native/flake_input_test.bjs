#lang beagle/js
(ns firn.flake-input-test (:require [firn.flake-input :as input]))

(defn alpha-source [seed Int] String
  (str
    "#lang beagle/nix\n"
    "(ns default)\n"
    "(nix/module [config lib pkgs ...]\n"
    (str "  (let [name \"alpha" (if (= seed 0) "" seed) "\"]\n")
    "    {:flake-inputs\n"
    (str
      "      {:zeta"
      (if (= seed 0) "" seed)
      " {:url \"github:zeta"
      (if (= seed 0) "" seed)
      "/project\"\n")
    "              :inputs.nixpkgs.follows \"nixpkgs\"}\n"
    (str
      "       :alpha"
      (if (= seed 0) "" seed)
      " {:url \"github:alpha"
      (if (= seed 0) "" seed)
      "/project\"}}}))\n")))

(defn same-zeta-source [seed Int] String
  (str
    "(nix/module [config]\n"
    "  {:flake-inputs\n"
    (str
      "    {:zeta"
      (if (= seed 0) "" seed)
      " {:url \"github:zeta"
      (if (= seed 0) "" seed)
      "/project\" :ignored \"later"
      (if (= seed 0) "" seed)
      "\"}}})\n")))

(defn parsed-inputs [seed Int module-name String source String] (Vec input/FlakeInput)
  (match (input/module-inputs-from-source module-name source)
    [(ModuleInputsParsed inputs) inputs]
    [(ModuleInputsRejected message offset) []]))

(defn case-parse-and-render [seed Int] Bool
  (let [
     (inputs (Vec input/FlakeInput))
     (parsed-inputs seed (str "alpha" (if (= seed 0) "" seed) "-module") (alpha-source seed))
     (names (Vec String))
     (input/sorted-input-names inputs)]
    (and
      (= names [(str "alpha" (if (= seed 0) "" seed)) (str "zeta" (if (= seed 0) "" seed))])
      (=
        (input/format-input-decl (input/find-input inputs (str "alpha" (if (= seed 0) "" seed))))
        (str
          "   :alpha"
          (if (= seed 0) "" seed)
          " {:url \"github:alpha"
          (if (= seed 0) "" seed)
          "/project\"}"))
      (=
        (input/format-input-decl (input/find-input inputs (str "zeta" (if (= seed 0) "" seed))))
        (str
          (str "   :zeta" (if (= seed 0) "" seed) " {:inputs.nixpkgs.follows \"nixpkgs\" ")
          (str ":url \"github:zeta" (if (= seed 0) "" seed) "/project\"}"))))))

(defn case-duplicate-url-keeps-first [seed Int] Bool
  (let [
     (collected input/CollectedInputs)
     (input/collect
       [
         (parsed-inputs seed (str "alpha" (if (= seed 0) "" seed) "-module") (alpha-source seed))
         (parsed-inputs
           seed
           (str "later" (if (= seed 0) "" seed) "-module")
           (same-zeta-source seed))])
     (zeta input/FlakeInput)
     (input/find-input
       (input/collectedinputs-inputs collected)
       (str "zeta" (if (= seed 0) "" seed)))]
    (and
      (= (input/collectedinputs-errors collected) [])
      (= (input/flakeinput-source-module zeta) (str "alpha" (if (= seed 0) "" seed) "-module")))))

(defn marker-source [seed Int] String
  (str
    "prefix "
    input/input-begin-marker
    "\n"
    (str "   :old" (if (= seed 0) "" seed) " {:url \"old" (if (= seed 0) "" seed) "\"}\n")
    "   "
    input/input-end-marker
    " suffix\n"
    "args "
    input/args-begin-marker
    "\n"
    (str "     old" (if (= seed 0) "" seed) "\n")
    "     "
    input/args-end-marker
    "\n"
    "special "
    input/special-begin-marker
    "\n"
    (str "                    :old" (if (= seed 0) "" seed) " old" (if (= seed 0) "" seed) "\n")
    "  "
    input/special-end-marker
    "\n"
    "hm "
    input/hm-special-begin-marker
    "\n"
    (str " old" (if (= seed 0) "" seed) "\n")
    "    "
    input/hm-special-end-marker
    "\n"
    "darwin "
    input/darwin-special-begin-marker
    "\n"
    (str " old" (if (= seed 0) "" seed) "\n")
    "      "
    input/darwin-special-end-marker
    "\n"
    "darwin-hm "
    input/darwin-hm-begin-marker
    "\n"
    (str " old" (if (= seed 0) "" seed) "\n")
    "        "
    input/darwin-hm-end-marker
    "\n"))

(defn case-six-marker-splice-and-idempotence [seed Int] Bool
  (let [
     (inputs (Vec input/FlakeInput))
     (parsed-inputs seed (str "alpha" (if (= seed 0) "" seed) "-module") (alpha-source seed))
     (first input/SpliceResult)
     (input/splice-flake-inputs (marker-source seed) inputs)]
    (match first
      [(SpliceRejected message) false]
      [(SpliceUnchanged text) false]
      [
        (SpliceChanged text)
        (match (input/splice-flake-inputs text inputs)
          [(SpliceRejected message) false]
          [(SpliceChanged changed) false]
          [(SpliceUnchanged unchanged) (= unchanged text)])])))

(defn case-missing-marker-rejected [seed Int] Bool
  (match (input/splice-flake-inputs "no markers\n" [])
    [(SpliceRejected message) true]
    [(SpliceChanged text) false]
    [(SpliceUnchanged text) false]))

(js/export
  (defn run-properties [samples Int] Int
    (if (<= samples 0)
      1
      (loop [index Int 0 seed Int 0]
        (if (>= index samples)
          0
          (if (and
             (case-parse-and-render seed)
             (case-duplicate-url-keeps-first seed)
             (case-six-marker-splice-and-idempotence seed)
             (case-missing-marker-rejected seed))
            (recur (+ index 1) (if (= seed 0) 73421 (mod (* seed 48271) 2147483647)))
            (do (println (str "FAIL firn.flake-input-test property seed=" seed)) 1)))))))
