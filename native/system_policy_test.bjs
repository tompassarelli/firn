#lang beagle/js
(ns firn.system-policy-test (:require [firn.system-policy :as policy]))

(defn raw-bash [seed Int command String] policy/RawHookEvent
  (policy/->RawHookEvent
    "Bash"
    command
    nil
    (str "session" (if (= seed 0) "" seed))
    false
    false
    false))

(defn case-event-decoding-and-refusal [seed Int] Bool
  (and
    (match (policy/decode-hook-event (raw-bash seed "nixos-rebuild switch"))
      [(HookBash command) (= command "nixos-rebuild switch")]
      [(HookEdit path) false]
      [(HookIgnored name) false])
    (match (policy/decide-hook (raw-bash seed "sudo nixos-rebuild test"))
      [(HookRefuse reason) true]
      [(HookPass token) false]
      [(HookInject context) false])
    (match (policy/decide-hook (raw-bash seed "echo nixos-rebuild switch"))
      [(HookPass token) token]
      [(HookRefuse reason) false]
      [(HookInject context) false])
    (match (policy/decide-hook (raw-bash seed "firn repo upgrade now"))
      [(HookPass token) token]
      [(HookRefuse reason) false]
      [(HookInject context) false])))

(defn case-edit-introduction-and-exits [seed Int] Bool
  (let [
     event
     policy/RawHookEvent
     (policy/->RawHookEvent
       "Edit"
       nil
       (str "/code/nixos-config/file" (if (= seed 0) "" seed) ".bnix")
       (str "session" (if (= seed 0) "" seed))
       false
       false
       true)]
    (and
      (match (policy/decide-hook event)
        [(HookInject context) true]
        [(HookPass token) false]
        [(HookRefuse reason) false])
      (= (policy/hook-exit-code (policy/decide-hook event)) 0))))

(defn case-pin-arguments-and-assertions [seed Int] Bool
  (and
    (match (policy/parse-pin-arguments [(str "--warn-days=" (mod seed 61))])
      [(PinArgumentsAccepted days) (= days (mod seed 61))]
      [(PinArgumentsHelp token) false]
      [(PinArgumentsRejected message) false])
    (match (policy/parse-pin-arguments ["--warn-days" (str "no" seed)])
      [(PinArgumentsRejected message) true]
      [(PinArgumentsAccepted days) false]
      [(PinArgumentsHelp token) false])
    (policy/valid-sri? "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=")
    (not (policy/valid-sri? "sha256-not-a-checksum"))))

(defn case-pin-exit-decision [seed Int] Bool
  (let [
     arguments
     policy/PinArguments
     (policy/parse-pin-arguments [])
     evidence
     (Vec policy/PinEvidence)
     [
       (policy/->PinEvidence
         (str "fixed-output" (if (= seed 0) "" seed))
         "module.bnix:4"
         "https://example.test/source"
         "https://example.test/source"
         true
         "sha256-invalid")]
     inputs
     (Vec policy/LockInput)
     [(policy/->LockInput "nixpkgs" (str "abcdef" (if (= seed 0) "" seed)) 0)]
     report
     policy/PolicyReport
     (policy/pin-policy arguments 2678400 evidence inputs)]
    (and
      (= (policy/policyreport-exit-code report) 1)
      (=
        (policy/diagnostic-code (nth (policy/policyreport-diagnostics report) 0))
        "malformed-checksum")
      (=
        (policy/diagnostic-code (nth (policy/policyreport-diagnostics report) 1))
        "stale-lock-input"))))

(js/export
  (defn run-properties [samples Int] Int
    (if (<= samples 0)
      1
      (loop [index Int 0 seed Int 0]
        (if (>= index samples)
          0
          (if (and
             (case-event-decoding-and-refusal seed)
             (case-edit-introduction-and-exits seed)
             (case-pin-arguments-and-assertions seed)
             (case-pin-exit-decision seed))
            (recur (+ index 1) (if (= seed 0) 73421 (mod (* seed 48271) 2147483647)))
            (do (println (str "FAIL firn.system-policy-test property seed=" seed)) 1)))))))
