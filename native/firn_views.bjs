#lang beagle/js
(ns firn.views
  (:require [native.json :as json]))

(js/export
  (defrecord Follow
  [input String
   target String]))

(js/export
  (defrecord FlakeRow
  [name String
   url String
   age-seconds Int
   age String
   revision String
   frozen Bool
   broken Bool
   follows (Vec Follow)]))

(js/export
  (defunion FlakeRowsResult
  (FlakeRows [rows (Vec FlakeRow)])
  (FlakeRowsRejected [message String])))

(js/export
  (defrecord PlatformRow
  [module String
   platform String]))

(js/export
  (defrecord PlatformVerdict
  [module String
   verdict Keyword
   blockers (Vec String)]))

(js/export
  (defunion QueryNamesResult
  (QueryNames [names (Vec String)])
  (QueryNamesRejected [message String])))

(js/export
  (defunion QueryRowsResult
  (QueryRows [rows (Vec PlatformRow)])
  (QueryRowsRejected [message String])))

(js/export
  (defrecord ChildResult
  [status Int
   stdout String
   stderr String]))

(js/export
  (defrecord CommandResult
  [status Int
   stdout String
   stderr String]))

(js/export
  (defunion ViewsAction
  (FlakeInputs [token Bool])
  (PlatformList [selection String])
  (PlatformShow [module String])
  (PlatformSafelist [token Bool])
  (SchemaExplain [input String])
  (HostGeneration [host String])))

(js/export
  (defunion ViewsArgv
  (ParsedViews [action ViewsAction])
  (InvalidViewsArgv [argv (Vec String)])))

(js/export
  (defn starts-with?
  [text String
   prefix String] Bool
  (and (>= (count text) (count prefix))
       (= prefix (subs text 0 (count prefix))))))

(js/export
  (defn ends-with?
  [text String
   suffix String] Bool
  (and (>= (count text) (count suffix))
       (= suffix
          (subs text (- (count text) (count suffix)) (count text))))))

(defn string-member?
  [values (Vec String)
   candidate String] Bool
  (loop [index Int 0]
    (if (>= index (count values))
      false
      (if (= candidate (nth values index))
        true
        (recur (+ index 1))))))

(defn append-unique
  [values (Vec String)
   candidate String] (Vec String)
  (if (string-member? values candidate) values (conj values candidate)))

(defn split-on
  [text String
   separator String] (Vec String)
  (if (= separator "")
    [text]
    (loop [start Int 0
           index Int 0
           parts (Vec String) []]
      (if (> (+ index (count separator)) (count text))
        (conj parts (subs text start (count text)))
        (if (= separator
               (subs text index (+ index (count separator))))
          (recur (+ index (count separator))
            (+ index (count separator))
            (conj parts (subs text start index)))
          (recur start (+ index 1) parts))))))

(defn split-lines [text String] (Vec String)
  (let [lines (Vec String) (split-on text "\n")]
    (if (and (> (count lines) 0)
             (= "" (nth lines (- (count lines) 1))))
      (pop lines)
      lines)))

(defn join-with
  [values (Vec String)
   separator String] String
  (loop [index Int 0
         result String ""]
    (if (>= index (count values))
      result
      (recur (+ index 1)
        (str result (if (= index 0) "" separator) (nth values index))))))

(defn trim-spaces [text String] String
  (loop [start Int 0]
    (if (and (< start (count text))
             (or (= " " (subs text start (+ start 1)))
                 (= "\t" (subs text start (+ start 1)))))
      (recur (+ start 1))
      (loop [end Int (count text)]
        (if (and (> end start)
                 (or (= " " (subs text (- end 1) end))
                     (= "\t" (subs text (- end 1) end))
                     (= "\r" (subs text (- end 1) end))))
          (recur (- end 1))
          (subs text start end))))))

(defn pad-right
  [text String
   width Int] String
  (loop [result String text]
    (if (>= (count result) width)
      result
      (recur (str result " ")))))

(defn truncate
  [text String
   limit Int] String
  (if (<= (count text) limit)
    text
    (str (subs text 0 (- limit 1)) "…")))

(defn ansi
  [tty Bool
   code String
   text String] String
  (if tty (str "\u001b[" code "m" text "\u001b[0m") text))

(defn json-container-end
  [events (Vec json/JsonEvent)
   start Int] Int
  (loop [index Int start
         depth Int 0]
    (if (>= index (count events))
      -1
      (match (nth events index)
        [(JsonObjectStart offset) (recur (+ index 1) (+ depth 1))]
        [(JsonArrayStart offset) (recur (+ index 1) (+ depth 1))]
        [(JsonObjectEnd offset)
         (if (= depth 1)
           (+ index 1)
           (recur (+ index 1) (- depth 1)))]
        [(JsonArrayEnd offset)
         (if (= depth 1)
           (+ index 1)
           (recur (+ index 1) (- depth 1)))]
        [(JsonKey offset value) (recur (+ index 1) depth)]
        [(JsonString offset value) (recur (+ index 1) depth)]
        [(JsonNumber offset lexeme) (recur (+ index 1) depth)]
        [(JsonBoolean offset value) (recur (+ index 1) depth)]
        [(JsonNull offset) (recur (+ index 1) depth)]))))

(defn json-value-end
  [events (Vec json/JsonEvent)
   start Int] Int
  (if (or (< start 0) (>= start (count events)))
    -1
    (match (nth events start)
      [(JsonObjectStart offset) (json-container-end events start)]
      [(JsonArrayStart offset) (json-container-end events start)]
      [(JsonObjectEnd offset) -1]
      [(JsonArrayEnd offset) -1]
      [(JsonKey offset value) (+ start 1)]
      [(JsonString offset value) (+ start 1)]
      [(JsonNumber offset lexeme) (+ start 1)]
      [(JsonBoolean offset value) (+ start 1)]
      [(JsonNull offset) (+ start 1)])))

(defn object-field-start
  [events (Vec json/JsonEvent)
   start Int
   key String] Int
  (if (or (< start 0)
          (>= start (count events))
          (not (instance? json/JsonObjectStart (nth events start))))
    -1
    (let [end Int (json-value-end events start)]
      (if (< end 0)
        -1
        (loop [index Int (+ start 1)]
          (if (>= index (- end 1))
            -1
            (match (nth events index)
              [(JsonKey offset candidate)
               (let [value-index Int (+ index 1)
                     next Int (json-value-end events value-index)]
                 (if (< next 0)
                   -1
                   (if (= candidate key)
                     value-index
                     (recur next))))]
              [(JsonObjectStart offset) -1]
              [(JsonObjectEnd offset) -1]
              [(JsonArrayStart offset) -1]
              [(JsonArrayEnd offset) -1]
              [(JsonString offset value) -1]
              [(JsonNumber offset lexeme) -1]
              [(JsonBoolean offset value) -1]
              [(JsonNull offset) -1])))))))

(defn object-field-names
  [events (Vec json/JsonEvent)
   start Int] (Vec String)
  (if (or (< start 0)
          (>= start (count events))
          (not (instance? json/JsonObjectStart (nth events start))))
    []
    (let [end Int (json-value-end events start)]
      (if (< end 0)
        []
        (loop [index Int (+ start 1)
               names (Vec String) []]
          (if (>= index (- end 1))
            names
            (match (nth events index)
              [(JsonKey offset key)
               (let [next Int (json-value-end events (+ index 1))]
                 (if (< next 0)
                   []
                   (recur next (conj names key))))]
              [(JsonObjectStart offset) []]
              [(JsonObjectEnd offset) []]
              [(JsonArrayStart offset) []]
              [(JsonArrayEnd offset) []]
              [(JsonString offset value) []]
              [(JsonNumber offset lexeme) []]
              [(JsonBoolean offset value) []]
              [(JsonNull offset) []])))))))

(defn string-at
  [events (Vec json/JsonEvent)
   index Int] (U String Nil)
  (if (or (< index 0) (>= index (count events)))
    nil
    (match (nth events index)
      [(JsonString offset value) value]
      [(JsonObjectStart offset) nil]
      [(JsonObjectEnd offset) nil]
      [(JsonArrayStart offset) nil]
      [(JsonArrayEnd offset) nil]
      [(JsonKey offset value) nil]
      [(JsonNumber offset lexeme) nil]
      [(JsonBoolean offset value) nil]
      [(JsonNull offset) nil])))

(defn number-at
  [events (Vec json/JsonEvent)
   index Int] (U Int Nil)
  (if (or (< index 0) (>= index (count events)))
    nil
    (match (nth events index)
      [(JsonNumber offset lexeme) (parse-long lexeme)]
      [(JsonObjectStart offset) nil]
      [(JsonObjectEnd offset) nil]
      [(JsonArrayStart offset) nil]
      [(JsonArrayEnd offset) nil]
      [(JsonKey offset value) nil]
      [(JsonString offset value) nil]
      [(JsonBoolean offset value) nil]
      [(JsonNull offset) nil])))

(defn object-string
  [events (Vec json/JsonEvent)
   start Int
   key String] (U String Nil)
  (string-at events (object-field-start events start key)))

(defn object-number
  [events (Vec json/JsonEvent)
   start Int
   key String] (U Int Nil)
  (number-at events (object-field-start events start key)))

(defn string-or
  [value (U String Nil)
   fallback String] String
  (if (nil? value) fallback value))

(defn array-strings
  [events (Vec json/JsonEvent)
   start Int] (Vec String)
  (if (or (< start 0)
          (>= start (count events))
          (not (instance? json/JsonArrayStart (nth events start))))
    []
    (let [end Int (json-value-end events start)]
      (loop [index Int (+ start 1)
             values (Vec String) []]
        (if (>= index (- end 1))
          values
          (let [next Int (json-value-end events index)
                value (U String Nil) (string-at events index)]
            (if (< next 0)
              []
              (recur next (if (nil? value) values (conj values value))))))))))

(defn last-string [values (Vec String)] String
  (if (= (count values) 0) "" (nth values (- (count values) 1))))

(defn first-string [values (Vec String)] String
  (if (= (count values) 0) "" (nth values 0)))

(js/export
  (defn human-age [seconds Int] String
  (let [safe Int (max seconds 0)
        minutes Int (quot safe 60)
        hours Int (quot minutes 60)
        days Int (quot hours 24)]
    (cond
      (< safe 60) (str safe "s")
      (< minutes 60) (str minutes "m")
      (< hours 24) (str hours "h")
      (< days 30) (str days "d")
      (< days 365) (str (quot days 30) "mo")
      :else (str (quot days 365) "y")))))

(defn original-url
  [events (Vec json/JsonEvent)
   original Int] String
  (let [type String (string-or (object-string events original "type") "")
        url (U String Nil) (object-string events original "url")
        owner String (string-or (object-string events original "owner") "")
        repo String (string-or (object-string events original "repo") "")
        reference (U String Nil) (object-string events original "ref")
        revision (U String Nil) (object-string events original "rev")
        path String (string-or (object-string events original "path") "")]
    (cond
      (some? url) url
      (= type "github")
      (let [suffix String (if (some? reference)
              reference
              (if (some? revision) revision ""))]
        (str "github:" owner "/" repo
          (if (= suffix "") "" (str "/" suffix))))
      (= type "gitlab") (str "gitlab:" owner "/" repo)
      (= type "git") (str "git+" (string-or url ""))
      (= type "path") (str "path:" path)
      :else (str type ":?"))))

(defn broken-original?
  [events (Vec json/JsonEvent)
   original Int] Bool
  (let [type String (string-or (object-string events original "type") "")
        path String (string-or (object-string events original "path") "")]
    (and (= type "path") (starts-with? path "/"))))

(defn input-node-name
  [events (Vec json/JsonEvent)
   value-index Int
   fallback String] String
  (let [direct (U String Nil) (string-at events value-index)]
    (if (some? direct)
      direct
      (let [values (Vec String) (array-strings events value-index)]
        (if (= (count values) 0) fallback (nth values 0))))))

(defn follows-from-node
  [events (Vec json/JsonEvent)
   node Int] (Vec Follow)
  (let [inputs Int (object-field-start events node "inputs")
        names (Vec String) (object-field-names events inputs)]
    (loop [remaining (Vec String) names
           result (Vec Follow) []]
      (if (= (count remaining) 0)
        result
        (let [name String (first remaining)
              value-index Int (object-field-start events inputs name)
              values (Vec String) (array-strings events value-index)]
          (recur (rest remaining)
            (if (= (count values) 0)
              result
              (conj result (->Follow name (last-string values))))))))))

(defn short-revision [revision String] String
  (subs revision 0 (min 8 (count revision))))

(defn flake-row
  [events (Vec json/JsonEvent)
   nodes Int
   root-inputs Int
   name String
   now-seconds Int] (U FlakeRow Nil)
  (let [input-value Int (object-field-start events root-inputs name)
        node-name String (input-node-name events input-value name)
        node Int (object-field-start events nodes node-name)
        original Int (object-field-start events node "original")
        locked Int (object-field-start events node "locked")]
    (if (or (< node 0) (< original 0))
      nil
      (let [modified (U Int Nil) (object-number events locked "lastModified")
            age-seconds Int (if (nil? modified) -1 (max 0 (- now-seconds modified)))
            revision String (string-or (object-string events locked "rev") "?")]
        (->FlakeRow
          name
          (original-url events original)
          age-seconds
          (if (< age-seconds 0) "?" (human-age age-seconds))
          (short-revision revision)
          (some? (object-string events original "rev"))
          (broken-original? events original)
          (follows-from-node events node))))))

(defn row-before?
  [left FlakeRow
   right FlakeRow] Bool
  (let [left-age Int (if (< (flakerow-age-seconds left) 0)
          315360000
          (flakerow-age-seconds left))
        right-age Int (if (< (flakerow-age-seconds right) 0)
          315360000
          (flakerow-age-seconds right))]
    (or (< left-age right-age)
        (and (= left-age right-age)
             (< (compare (flakerow-name left) (flakerow-name right)) 0)))))

(defn insert-row
  [rows (Vec FlakeRow)
   row FlakeRow] (Vec FlakeRow)
  (loop [remaining (Vec FlakeRow) rows
         result (Vec FlakeRow) []
         inserted Bool false]
    (if (= (count remaining) 0)
      (if inserted result (conj result row))
      (let [current FlakeRow (first remaining)]
        (if (and (not inserted) (row-before? row current))
          (recur remaining (conj result row) true)
          (recur (rest remaining) (conj result current) inserted))))))

(js/export
  (defn flake-rows
  [source String
   now-seconds Int] FlakeRowsResult
  (match (json/decode source)
    [(JsonDecodeError offset message)
     (->FlakeRowsRejected (str "invalid flake.lock at " offset ": " message))]
    [(JsonDecoded events)
     (if (or (= (count events) 0)
             (not (instance? json/JsonObjectStart (nth events 0))))
       (->FlakeRowsRejected "flake.lock must be a JSON object")
       (let [root-name String (string-or (object-string events 0 "root") "root")
             nodes Int (object-field-start events 0 "nodes")
             root-node Int (object-field-start events nodes root-name)
             root-inputs Int (object-field-start events root-node "inputs")
             names (Vec String) (sort (object-field-names events root-inputs))]
         (if (or (< nodes 0) (< root-node 0) (< root-inputs 0))
           (->FlakeRowsRejected "flake.lock is missing root nodes/inputs")
           (loop [remaining (Vec String) names
                  rows (Vec FlakeRow) []]
             (if (= (count remaining) 0)
               (->FlakeRows rows)
               (let [row (U FlakeRow Nil) (flake-row events nodes root-inputs
                       (first remaining) now-seconds)]
                 (if (nil? row)
                   (->FlakeRowsRejected
                     (str "flake.lock input '" (first remaining)
                       "' has no lock node"))
                   (recur (rest remaining) (insert-row rows row)))))))))])))

(defn max-row-name [rows (Vec FlakeRow)] Int
  (loop [remaining (Vec FlakeRow) rows
         width Int 0]
    (if (= (count remaining) 0)
      width
      (recur (rest remaining)
        (max width (count (flakerow-name (first remaining))))))))

(defn follow-lines
  [follows (Vec Follow)
   name-width Int] String
  (loop [remaining (Vec Follow) follows
         text String ""]
    (if (= (count remaining) 0)
      text
      (let [follow Follow (first remaining)]
        (recur (rest remaining)
          (str text "  " (pad-right "" name-width) "  └─ "
            (follow-input follow) " shares " (follow-target follow) "\n"))))))

(defn broken-lines [rows (Vec FlakeRow)] String
  (let [broken (Vec FlakeRow) (loop [remaining (Vec FlakeRow) rows
                                     result (Vec FlakeRow) []]
                                (if (= (count remaining) 0)
            result
            (recur (rest remaining)
              (if (flakerow-broken (first remaining))
                (conj result (first remaining))
                result))))]
    (if (= (count broken) 0)
      ""
      (loop [remaining (Vec FlakeRow) broken
             text String (str "! " (count broken) " input"
               (if (= (count broken) 1) "" "s")
               " with absolute path"
               (if (= (count broken) 1) "" "s")
               " (would break the build):\n")]
        (if (= (count remaining) 0)
          (str text "\n")
          (let [row FlakeRow (first remaining)]
            (recur (rest remaining)
              (str text "    " (flakerow-name row) ": "
                (flakerow-url row) "\n"))))))))

(defn rows-have-frozen? [rows (Vec FlakeRow)] Bool
  (loop [remaining (Vec FlakeRow) rows]
    (if (= (count remaining) 0)
      false
      (if (flakerow-frozen (first remaining))
        true
        (recur (rest remaining))))))

(defn rows-have-follows? [rows (Vec FlakeRow)] Bool
  (loop [remaining (Vec FlakeRow) rows]
    (if (= (count remaining) 0)
      false
      (if (> (count (flakerow-follows (first remaining))) 0)
        true
        (recur (rest remaining))))))

(js/export
  (defn render-flake-rows
  [rows (Vec FlakeRow)
   tty Bool] String
  (if (= (count rows) 0)
    "No inputs in flake.lock.\n"
    (let [name-width Int (max-row-name rows)
          has-frozen Bool (rows-have-frozen? rows)
          has-follows Bool (rows-have-follows? rows)
          body String (loop [remaining (Vec FlakeRow) rows
                             text String (str (broken-lines rows)
                   (ansi tty "1" "flake inputs")
                   " (" (count rows) ", newest first)\n"
                   "  " (pad-right "name" name-width)
                   "  " (pad-right "source" 57) "  age    rev\n")]
                        (if (= (count remaining) 0)
              text
              (let [row FlakeRow (first remaining)
                    source String (str (truncate (flakerow-url row) 48)
                      (if (flakerow-frozen row) " [frozen]" ""))]
                (recur (rest remaining)
                  (str text
                    "  " (pad-right (flakerow-name row) name-width)
                    "  " (pad-right source 57)
                    "  " (pad-right (flakerow-age row) 5)
                    "  " (flakerow-revision row) "\n"
                    (follow-lines (flakerow-follows row) name-width))))))]
      (str body "\n"
        "→ `nix flake update <name>` bumps one input; "
        "`nix flake update` bumps all.\n"
        (if has-frozen
          "→ [frozen] = source URL pins a commit; it will not update.\n"
          "")
        (if has-follows
          "→ └─ X shares Y = this input uses our copy of Y.\n"
          ""))))))

(defn combine-unique
  [left (Vec String)
   right (Vec String)] (Vec String)
  (loop [remaining (Vec String) right
         result (Vec String) left]
    (if (= (count remaining) 0)
      (sort result)
      (recur (rest remaining)
        (append-unique result (first remaining))))))

(defn array-elements
  [events (Vec json/JsonEvent)] (U (Vec Int) Nil)
  (if (or (= (count events) 0)
          (not (instance? json/JsonArrayStart (nth events 0))))
    nil
    (let [end Int (json-value-end events 0)]
      (if (not= end (count events))
        nil
        (loop [index Int 1
               starts (Vec Int) []]
          (if (>= index (- end 1))
            starts
            (let [next Int (json-value-end events index)]
              (if (< next 0)
                nil
                (recur next (conj starts index))))))))))

(js/export
  (defn query-names-from-json [source String] QueryNamesResult
  (match (json/decode source)
    [(JsonDecodeError offset message) (->QueryNamesRejected message)]
    [(JsonDecoded events)
     (let [starts (U (Vec Int) Nil) (array-elements events)]
       (if (nil? starts)
         (->QueryNamesRejected "expected an array of names")
         (loop [remaining (Vec Int) starts
                names (Vec String) []]
           (if (= (count remaining) 0)
             (->QueryNames names)
             (let [name (U String Nil) (string-at events (first remaining))]
               (if (nil? name)
                 (->QueryNamesRejected "expected an array of names")
                 (recur (rest remaining) (conj names name))))))))])))

(js/export
  (defn query-rows-from-json [source String] QueryRowsResult
  (match (json/decode source)
    [(JsonDecodeError offset message) (->QueryRowsRejected message)]
    [(JsonDecoded events)
     (let [starts (U (Vec Int) Nil) (array-elements events)]
       (if (nil? starts)
         (->QueryRowsRejected "expected an array of rows")
         (loop [remaining (Vec Int) starts
                rows (Vec PlatformRow) []]
           (if (= (count remaining) 0)
             (->QueryRows rows)
             (let [module (U String Nil) (object-string events (first remaining) "m")
                   platform (U String Nil) (object-string events (first remaining) "p")]
               (if (or (nil? module) (nil? platform))
                 (->QueryRowsRejected "expected rows with m and p")
                 (recur (rest remaining)
                   (conj rows (->PlatformRow module platform)))))))))])))

(defn supported?
  [rows (Vec PlatformRow)
   module String
   platform String] Bool
  (loop [remaining (Vec PlatformRow) rows]
    (if (= (count remaining) 0)
      false
      (let [row PlatformRow (first remaining)]
        (if (and (= module (platformrow-module row))
                 (= platform (platformrow-platform row)))
          true
          (recur (rest remaining)))))))

(defn platform-verdict
  [module String
   rows (Vec PlatformRow)] PlatformVerdict
  (let [linux-ok Bool (supported? rows module "linux")
        darwin-ok Bool (supported? rows module "darwin")]
    (cond
      (and linux-ok darwin-ok) (->PlatformVerdict module :both [])
      linux-ok (->PlatformVerdict module :linux-only ["darwin"])
      darwin-ok (->PlatformVerdict module :darwin-only ["linux"])
      :else (->PlatformVerdict module :neither ["darwin" "linux"]))))

(js/export
  (defn platform-matrix
  [modules (Vec String)
   rows (Vec PlatformRow)] (Vec PlatformVerdict)
  (loop [remaining (Vec String) modules
         verdicts (Vec PlatformVerdict) []]
    (if (= (count remaining) 0)
      verdicts
      (recur (rest remaining)
        (conj verdicts (platform-verdict (first remaining) rows)))))))

(defn verdict-label [verdict Keyword] String
  (cond
    (= verdict :both) "both"
    (= verdict :linux-only) "linux-only"
    (= verdict :darwin-only) "darwin-only"
    :else "neither"))

(defn modules-with
  [verdicts (Vec PlatformVerdict)
   verdict Keyword] (Vec String)
  (loop [remaining (Vec PlatformVerdict) verdicts
         modules (Vec String) []]
    (if (= (count remaining) 0)
      (sort modules)
      (recur (rest remaining)
        (if (= verdict (platformverdict-verdict (first remaining)))
          (conj modules (platformverdict-module (first remaining)))
          modules)))))

(defn render-list
  [label String
   modules (Vec String)] String
  (if (= (count modules) 0)
    (str label " (0):  (none)\n")
    (loop [remaining (Vec String) modules
           text String (str label " (" (count modules) "):\n")]
      (if (= (count remaining) 0)
        text
        (recur (rest remaining) (str text "  " (first remaining) "\n"))))))

(js/export
  (defn render-platform-list
  [selection String
   verdicts (Vec PlatformVerdict)] CommandResult
  (let [both (Vec String) (modules-with verdicts :both)
        linux (Vec String) (modules-with verdicts :linux-only)
        darwin-only (Vec String) (modules-with verdicts :darwin-only)
        darwin (Vec String) (combine-unique both darwin-only)
        neither (Vec String) (modules-with verdicts :neither)]
    (cond
      (= selection "darwin")
      (->CommandResult 0 (render-list "darwin-compatible modules" darwin) "")

      (= selection "linux")
      (->CommandResult 0
        (str (render-list "NixOS-only modules" linux)
          (if (= (count neither) 0)
            ""
            (str "\n" (render-list "modules supported nowhere" neither))))
        "")

      (= selection "all")
      (->CommandResult 0
        (str "Platform compatibility matrix (" (count verdicts) " modules)\n\n"
          (render-list "darwin-compatible modules" both) "\n"
          (render-list "NixOS-only modules" linux)
          (if (= (count darwin-only) 0)
            ""
            (str "\n" (render-list "darwin-only modules" darwin-only)))
          (if (= (count neither) 0)
            ""
            (str "\n" (render-list "modules supported nowhere" neither))))
        "")

      :else
      (->CommandResult 64 ""
        (str "firn platform list: expected all|darwin|linux, got '"
          selection "'\n"))))))

(js/export
  (defn verdict-for
  [verdicts (Vec PlatformVerdict)
   module String] (U PlatformVerdict Nil)
  (loop [remaining (Vec PlatformVerdict) verdicts]
    (if (= (count remaining) 0)
      nil
      (let [verdict PlatformVerdict (first remaining)]
        (if (= module (platformverdict-module verdict))
          verdict
          (recur (rest remaining))))))))

(defn blocker-lines [blockers (Vec String)] String
  (loop [remaining (Vec String) blockers
         text String ""]
    (if (= (count remaining) 0)
      text
      (recur (rest remaining) (str text "  " (first remaining) "\n")))))

(js/export
  (defn render-platform-show
  [module String
   verdicts (Vec PlatformVerdict)] CommandResult
  (let [verdict (U PlatformVerdict Nil) (verdict-for verdicts module)]
    (if (nil? verdict)
      (->CommandResult 1 ""
        (str "firn platform show: no module named '" module "'\n"))
      (->CommandResult 0
        (str "module:  " module "\n"
          "verdict: " (verdict-label (platformverdict-verdict verdict)) "\n"
          (if (= (count (platformverdict-blockers verdict)) 0)
            ""
            (str "unsupported on:\n"
              (blocker-lines (platformverdict-blockers verdict)))))
        "")))))

(defn row-platforms [rows (Vec PlatformRow)] (Vec String)
  (loop [remaining (Vec PlatformRow) rows
         platforms (Vec String) []]
    (if (= (count remaining) 0)
      (sort platforms)
      (recur (rest remaining)
        (append-unique platforms (platformrow-platform (first remaining)))))))

(defn platform-modules
  [rows (Vec PlatformRow)
   platform String] (Vec String)
  (loop [remaining (Vec PlatformRow) rows
         modules (Vec String) []]
    (if (= (count remaining) 0)
      (sort modules)
      (recur (rest remaining)
        (if (= platform (platformrow-platform (first remaining)))
          (append-unique modules (platformrow-module (first remaining)))
          modules)))))

(defn roll-call
  [names (Vec String)
   predicate String] String
  (cond
    (= (count names) 0) ""
    (= (count names) 1) (str (first names) " " predicate "\n")
    :else (str "[" (join-with names ", ") "] " predicate "\n")))

(js/export
  (defn render-platform-safelist
  [everywhere (Vec PlatformRow)
   supported (Vec PlatformRow)] CommandResult
  (let [open (Vec String) (row-platforms everywhere)]
    (->CommandResult 0
      (loop [remaining (Vec String) (row-platforms supported)
             text String ""]
        (if (= (count remaining) 0)
          text
          (recur (rest remaining)
            (if (string-member? open (first remaining))
              text
              (str text
                (roll-call (platform-modules supported (first remaining))
                  (str "supports " (first remaining))))))))
      ""))))

(defn allowed-path-character? [character String] Bool
  (or (and (>= (compare character "a") 0)
           (<= (compare character "z") 0))
      (and (>= (compare character "A") 0)
           (<= (compare character "Z") 0))
      (and (>= (compare character "0") 0)
           (<= (compare character "9") 0))
      (= character ".")
      (= character "_")
      (= character "<")
      (= character ">")
      (= character "-")))

(js/export
  (defn find-substring
  [text String
   needle String] Int
  (if (= needle "")
    0
    (loop [index Int 0]
      (if (> (+ index (count needle)) (count text))
        -1
        (if (= needle (subs text index (+ index (count needle))))
          index
          (recur (+ index 1))))))))

(defn path-token-at
  [text String
   start Int] (U String Nil)
  (if (or (< start 0) (>= start (count text)))
    nil
    (loop [end Int start]
      (if (and (< end (count text))
               (allowed-path-character? (subs text end (+ end 1))))
        (recur (+ end 1))
        (if (= end start) nil (subs text start end))))))

(js/export
  (defn extract-option-path [input String] (U String Nil)
  (let [unknown String "unknown option "
        mismatch String "type mismatch at "
        unknown-at Int (find-substring input unknown)
        mismatch-at Int (find-substring input mismatch)]
    (cond
      (>= unknown-at 0) (path-token-at input (+ unknown-at (count unknown)))
      (>= mismatch-at 0) (path-token-at input (+ mismatch-at (count mismatch)))
      :else
      (let [trimmed String (trim-spaces input)
            candidate (U String Nil) (path-token-at trimmed 0)]
        (if (and (some? candidate) (= candidate trimmed)) candidate nil))))))

(defn line-has-current? [line String] Bool
  (or (>= (find-substring line "current") 0)
      (ends-with? (trim-spaces line) "True")))

(defn first-token [line String] String
  (let [trimmed String (trim-spaces line)]
    (loop [end Int 0]
      (if (or (>= end (count trimmed))
              (= " " (subs trimmed end (+ end 1)))
              (= "\t" (subs trimmed end (+ end 1))))
        (subs trimmed 0 end)
        (recur (+ end 1))))))

(defn current-generation [text String] (U Int Nil)
  (loop [remaining (Vec String) (split-lines text)]
    (if (= (count remaining) 0)
      nil
      (let [line String (first remaining)]
        (if (line-has-current? line)
          (parse-long (first-token line))
          (recur (rest remaining)))))))

(js/export
  (defn render-host-generation [child ChildResult] CommandResult
  (if (not= (childresult-status child) 0)
    (->CommandResult (childresult-status child)
      (childresult-stdout child)
      (str (childresult-stderr child)
        "firn host gen: generation listing failed.\n"))
    (let [generation (U Int Nil) (current-generation (childresult-stdout child))]
      (if (nil? generation)
        (->CommandResult 0 "(no generation info)\n" "")
        (->CommandResult 0
          (str "current: " generation "\nnext:    " (+ generation 1) "\n")
          ""))))))

(js/export
  (defn parse-views-argv
  [argv (Vec String)
   current-host String] ViewsArgv
  (cond
    (= argv ["flake" "inputs"])
    (->ParsedViews (->FlakeInputs false))

    (= argv ["flake" "inputs" "all"])
    (->ParsedViews (->FlakeInputs false))

    (= argv ["platform" "list"])
    (->ParsedViews (->PlatformList "all"))

    (and (= (count argv) 3)
         (= (nth argv 0) "platform")
         (= (nth argv 1) "list"))
    (->ParsedViews (->PlatformList (nth argv 2)))

    (and (= (count argv) 3)
         (= (nth argv 0) "platform")
         (= (nth argv 1) "show"))
    (->ParsedViews (->PlatformShow (nth argv 2)))

    (= argv ["platform" "safelist" "all"])
    (->ParsedViews (->PlatformSafelist false))

    (= argv ["platform" "safelist"])
    (->ParsedViews (->PlatformSafelist false))

    (and (= (count argv) 3)
         (= (nth argv 0) "schema")
         (= (nth argv 1) "explain"))
    (->ParsedViews (->SchemaExplain (nth argv 2)))

    (= argv ["host" "gen"])
    (->ParsedViews (->HostGeneration current-host))

    (and (= (count argv) 3)
         (= (nth argv 0) "host")
         (= (nth argv 1) "gen"))
    (->ParsedViews (->HostGeneration (nth argv 2)))

    :else (->InvalidViewsArgv argv))))
