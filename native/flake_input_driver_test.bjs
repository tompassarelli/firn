#lang beagle/js
(ns firn.flake-input-driver-test
  (:require [firn.flake-input :as input] [firn.flake-input-driver :as driver]))

(defn parsed? [argv (Vec String)] Bool
  (match (driver/parse-flake-input-argv argv)
    [(ParsedFlakeInputEmit token) true]
    [(OtherFirnCommand other) false]
    [(InvalidFlakeInputArgv invalid) false]))

(defn invalid? [argv (Vec String)] Bool
  (match (driver/parse-flake-input-argv argv)
    [(ParsedFlakeInputEmit token) false]
    [(OtherFirnCommand other) false]
    [(InvalidFlakeInputArgv invalid) true]))

(defn other? [argv (Vec String)] Bool
  (match (driver/parse-flake-input-argv argv)
    [(ParsedFlakeInputEmit token) false]
    [(OtherFirnCommand other) true]
    [(InvalidFlakeInputArgv invalid) false]))

(defn case-argv-grammar [] Bool
  (and
    (parsed? ["flake-input" "resolve" "emit"])
    (invalid? ["flake-input" "resolve"])
    (invalid? ["flake-input" "resolve" "show"])
    (invalid? ["flake-input" "resolve" "emit" "extra"])
    (other? ["tag" "resolve" "all"])))

(defn case-shared-input-keeps-first-module [] Bool
  (let [inputs (Vec input/FlakeInput)
          (driver/inputs-from-rows
            [["alpha" "alpha" "github:alpha/project"]
             ["alpha" "zeta" "github:zeta/project"]
             ["beta" "zeta" "github:zeta/project"]])]
    (and
      (= (input/sorted-input-names inputs) ["alpha" "zeta"])
      (= (input/flakeinput-source-module (input/find-input inputs "zeta")) "alpha")
      (= (input/source-module-count inputs) 1))))

(js/export
  (defn run-scenarios [] Int
    (if (and
      (case-argv-grammar)
      (case-shared-input-keeps-first-module))
      0
      (do (println "FAIL flake_input_driver scenarios") 1))))
