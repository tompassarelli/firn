#lang beagle/js
(ns firn.repo-build-family
  (:require [firn.repo-build :as build]
            [firn.tag-resolve-driver :as tag-driver]
            [firn.tag-resolve-family :as tag-family]
            [firn.flake-input-family :as flake-family]))

(def max-directory-entries Int 16384)
(def max-generated-bytes Int 33554432)
(def max-compiler-output-bytes Int 16777216)

(defunion SourceStateLoadResult
  (SourceStateLoaded [state build/SourceState])
  (SourceStateRejected [message String]))

(defunion OutputMtimeResult
  (OutputMtimeLoaded [modified-time (U build/ModifiedTime Nil)])
  (OutputMtimeRejected [message String]))

(defunion InventoryLoadResult
  (InventoryLoaded [inventory build/SourceInventory])
  (InventoryRejected [message String]))

(defn relative-child [parent String name String] String
  (if (= parent "") name (str parent "/" name)))

(defn absolute-path [root String relative String] String
  (str root "/" relative))

(defn merge-inventory
  [left build/SourceInventory right build/SourceInventory]
  build/SourceInventory
  (build/->SourceInventory
    (into (build/sourceinventory-sources left)
      (build/sourceinventory-sources right))
    (into (build/sourceinventory-obsolete-outputs left)
      (build/sourceinventory-obsolete-outputs right))))

(defn output-mtime
  [bridge Any root String relative String] OutputMtimeResult
  (let [absolute String (absolute-path root relative)
        kind-result Any (.pathKind bridge absolute)
        kind-errno Int (.status bridge kind-result)]
    (if (not (= kind-errno 0))
      (if (= kind-errno 2)
        (->OutputMtimeLoaded nil)
        (->OutputMtimeRejected
          (build/errno-message "cannot inspect" relative kind-errno)))
      (let [kind Int (.value bridge kind-result)]
        (if (not (or (= kind 1) (= kind 3)))
          (->OutputMtimeLoaded nil)
          (let [mtime-result Any (.mtimeNanoseconds bridge absolute)
                mtime-errno Int (.status bridge mtime-result)]
            (if (= mtime-errno 0)
              (let [value Any (.value bridge mtime-result)]
                (->OutputMtimeLoaded
                  (build/->ModifiedTime
                    (.seconds bridge value)
                    (.nanoseconds bridge value))))
              (if (= mtime-errno 2)
                (->OutputMtimeLoaded nil)
                (->OutputMtimeRejected
                  (build/errno-message
                    "cannot read modification time for" relative
                    mtime-errno))))))))))

(defn load-source-state
  [bridge Any root String relative String] SourceStateLoadResult
  (let [mtime-result Any
        (.mtimeNanoseconds bridge (absolute-path root relative))
        errno Int (.status bridge mtime-result)]
    (if (not (= errno 0))
      (->SourceStateRejected
        (build/errno-message
          "cannot read modification time for" relative errno))
      (let [mtime Any (.value bridge mtime-result)
            source-modified-time build/ModifiedTime
            (build/->ModifiedTime
              (.seconds bridge mtime)
              (.nanoseconds bridge mtime))
            output-relative String (build/output-relative relative)]
        (match (output-mtime bridge root output-relative)
          [(OutputMtimeRejected message) (->SourceStateRejected message)]
          [(OutputMtimeLoaded output-modified-time)
           (->SourceStateLoaded
             (build/->SourceState
               (build/->SourceKey relative source-modified-time)
               output-relative output-modified-time))])))))

(defn load-inventory-directory
  [bridge Any root String relative String] InventoryLoadResult
  (let [absolute String
        (if (= relative "") root (absolute-path root relative))
        list-result Any
        (.listDirectory bridge absolute max-directory-entries)
        list-errno Int (.status bridge list-result)]
    (if (not (= list-errno 0))
      (->InventoryRejected
        (build/errno-message "cannot list"
          (if (= relative "") "." relative) list-errno))
      (let [names (Vec String) (sort (.value bridge list-result))]
        (loop [index Int 0
               inventory build/SourceInventory
               (build/->SourceInventory [] [])]
          (if (>= index (count names))
            (->InventoryLoaded inventory)
            (let [entry-relative String
                  (relative-child relative (nth names index))
                  kind-result Any
                  (.pathKind bridge (absolute-path root entry-relative))
                  kind-errno Int (.status bridge kind-result)]
              (if (not (= kind-errno 0))
                (if (= kind-errno 2)
                  (recur (+ index 1) inventory)
                  (->InventoryRejected
                    (build/errno-message
                      "cannot inspect" entry-relative kind-errno)))
                (let [kind Int (.value bridge kind-result)]
                  (cond
                    [(and (= kind 2)
                          (not (build/traversal-excluded? entry-relative)))
                     (match
                       (load-inventory-directory bridge root entry-relative)
                       [(InventoryRejected message)
                        (->InventoryRejected message)]
                       [(InventoryLoaded child-inventory)
                        (recur (+ index 1)
                          (merge-inventory inventory child-inventory))])]
                    [(and (or (= kind 1) (= kind 3))
                          (build/source-path? entry-relative))
                     (match (load-source-state bridge root entry-relative)
                       [(SourceStateRejected message)
                        (->InventoryRejected message)]
                       [(SourceStateLoaded state)
                        (recur (+ index 1)
                          (merge-inventory inventory
                            (build/->SourceInventory [state] [])))])]
                    [(and (or (= kind 1) (= kind 3))
                          (build/obsolete-output-path? entry-relative))
                     (recur (+ index 1)
                       (merge-inventory inventory
                         (build/->SourceInventory [] [entry-relative])))]
                    [:else (recur (+ index 1) inventory)]))))))))))

(defn emit-error [bridge Any message String] Int
  (do (.err bridge message) 1))

(defn run-preparation [bridge Any root String] Int
  (match (tag-family/directory-names bridge root "hosts")
    [(DirectoryNamesRejected message)
     (do
       (.err bridge message)
       (emit-error bridge
         "firn-build: tag resolution failed; aborting before .nix regeneration\n"))]
    [(DirectoryNamesLoaded names)
     (let [tag-status Int
           (tag-family/run-action bridge root names
             (tag-driver/->ResolveAll true))]
       (if (not (= tag-status 0))
         (emit-error bridge
           "firn-build: tag resolution failed; aborting before .nix regeneration\n")
         (let [flake-status Int (flake-family/run-root bridge root)]
           (if (= flake-status 0)
             0
             (emit-error bridge
               "firn-build: flake-inputs resolution failed; aborting\n")))))]))

(defn cleanup-temporary
  [bridge Any temporary String relative String] Int
  (let [errno Int (.removeFile bridge temporary)]
    (if (or (= errno 0) (= errno 2))
      0
      (emit-error bridge
        (build/errno-message
          "cannot remove temporary output for" relative errno)))))

(defn fail-after-cleanup
  [bridge Any temporary String relative String message String] Int
  (let [cleanup-status Int (cleanup-temporary bridge temporary relative)]
    (do
      (.err bridge message)
      (if (= cleanup-status 0) 1 cleanup-status))))

(defn emit-compiler-output
  [bridge Any stdout String stderr String] Int
  (do
    (if (= stdout "") 0 (do (.out bridge stdout) 0))
    (if (= stderr "") 0 (do (.err bridge stderr) 0))
    0))

(defn publish-compiled
  [bridge Any temporary String destination String relative String] Int
  (let [read-result Any (.readText bridge temporary max-generated-bytes)
        read-errno Int (.status bridge read-result)]
    (if (not (= read-errno 0))
      (fail-after-cleanup bridge temporary relative
        (build/errno-message
          "cannot read temporary output for" relative read-errno))
      (let [generated String (.value bridge read-result)
            write-errno Int
            (.writeTextAtomic bridge temporary
              (build/strip-authoring-attributes generated))]
        (if (not (= write-errno 0))
          (fail-after-cleanup bridge temporary relative
            (build/errno-message
              "cannot clean temporary output for" relative write-errno))
          (let [rename-errno Int (.renameFile bridge temporary destination)]
            (if (= rename-errno 0)
              0
              (fail-after-cleanup bridge temporary relative
                (build/errno-message "cannot publish" relative
                  rename-errno)))))))))

(defn run-compiler
  [bridge Any root String compiler String state build/SourceState
   temporary String] Int
  (let [process build/CompilerProcess
        (build/compiler-process compiler root state temporary)
        relative String (build/compilerprocess-source-relative process)
        capture Any
        (.runCapture bridge (build/compilerprocess-argv process)
          max-compiler-output-bytes)
        errno Int (.status bridge capture)]
    (if (not (= errno 0))
      (fail-after-cleanup bridge temporary relative
        (build/compiler-spawn-message relative errno))
      (let [result Any (.value bridge capture)
            status Int (.exitStatus bridge result)
            stdout String (.stdout bridge result)
            stderr String (.stderr bridge result)]
        (if (not (= status 0))
          (do
            (emit-compiler-output bridge stdout stderr)
            (fail-after-cleanup bridge temporary relative
              (build/compiler-failure-message relative status)))
          (publish-compiled bridge temporary
            (absolute-path root
              (build/compilerprocess-destination-relative process))
            relative))))))

(defn compile-source
  [bridge Any root String compiler String state build/SourceState] Int
  (let [destination-relative String
        (build/sourcestate-output-relative state)
        destination String (absolute-path root destination-relative)
        temporary-result Any (.createTemporarySibling bridge destination)
        errno Int (.status bridge temporary-result)]
    (if (not (= errno 0))
      (emit-error bridge
        (build/errno-message
          "cannot create temporary output for" destination-relative errno))
      (let [temporary String (.value bridge temporary-result)]
        (run-compiler bridge root compiler state temporary)))))

(defn compile-sources
  [bridge Any root String compiler String sources (Vec build/SourceState)
   index Int] Int
  (if (>= index (count sources))
    0
    (let [status Int
          (compile-source bridge root compiler (nth sources index))]
      (if (= status 0)
        (compile-sources bridge root compiler sources (+ index 1))
        status))))

(defn remove-obsolete-output
  [bridge Any root String relative String] Int
  (let [errno Int (.removeFile bridge (absolute-path root relative))]
    (if (or (= errno 0) (= errno 2))
      0
      (emit-error bridge
        (build/errno-message "cannot remove obsolete output" relative errno)))))

(defn remove-obsolete-outputs
  [bridge Any root String paths (Vec String) index Int] Int
  (if (>= index (count paths))
    0
    (let [status Int
          (remove-obsolete-output bridge root (nth paths index))]
      (if (= status 0)
        (remove-obsolete-outputs bridge root paths (+ index 1))
        status))))

(defn execute-plan
  [bridge Any root String compiler String plan build/RepoBuildPlan] Int
  (let [sources (Vec build/SourceState)
        (build/repobuildplan-stale-sources plan)
        compile-status Int
        (compile-sources bridge root compiler sources 0)]
    (if (not (= compile-status 0))
      compile-status
      (let [cleanup-status Int
            (remove-obsolete-outputs bridge root
              (build/repobuildplan-obsolete-outputs plan) 0)]
        (if (not (= cleanup-status 0))
          cleanup-status
          (do
            (if (= (count sources) 0)
              (.out bridge "firn-build: nothing to rebuild.\n")
              0)
            0))))))

(defn beagle-root [bridge Any] (U String Nil)
  (let [explicit (U String Nil) (.env bridge "BEAGLE_PATH")]
    (if (some? explicit)
      explicit
      (let [home (U String Nil) (.env bridge "HOME")]
        (if (some? home) (str home "/code/beagle/main") nil)))))

(defn repository-root [bridge Any] (U String Nil)
  (let [explicit (U String Nil) (.env bridge "FIRN_REPO")]
    (if (some? explicit)
      explicit
      (let [home (U String Nil) (.env bridge "HOME")]
        (if (some? home)
          (str home "/code/nixos-config/main")
          nil)))))

(defn run-root [bridge Any root String compiler String] Int
  (let [preparation-status Int (run-preparation bridge root)]
    (if (not (= preparation-status 0))
      preparation-status
      (match (load-inventory-directory bridge root "")
        [(InventoryRejected message) (emit-error bridge message)]
        [(InventoryLoaded inventory)
         (execute-plan bridge root compiler (build/build-plan inventory))]))))

(defn run-command [bridge Any root String compiler String] Int
  (do
    (.out bridge ">> firn-build\n")
    (let [status Int (run-root bridge root compiler)]
      (if (= status 0)
        0
        (do
          (.err bridge "firn repo build: failed.\n")
          1)))))

(defn usage-error [bridge Any] Int
  (do (.err bridge "Usage: firn repo build [all]\n") 64))

(js/export
  (defn run [bridge Any args (Vec String)] Int
  (match (build/parse-repo-build-argv args)
    [(OtherRepoBuildCommand argv) (usage-error bridge)]
    [(InvalidRepoBuildArgv argv) (usage-error bridge)]
    [(ParsedRepoBuild token)
     (let [root (U String Nil) (repository-root bridge)
           beagle (U String Nil) (beagle-root bridge)]
       (cond
         [(nil? root)
          (do
            (.err bridge
              "firn repo build: FIRN_REPO and HOME are not set\n")
            1)]
         [(nil? beagle)
          (do
            (.err bridge
              "firn repo build: BEAGLE_PATH and HOME are not set\n")
            1)]
         [:else
          (run-command bridge root (str beagle "/bin/beagle-build"))]))])))
