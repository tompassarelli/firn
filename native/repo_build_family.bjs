#lang beagle/js
(ns firn.repo-build-family
  (:require [firn.repo-build :as build]
            [firn.tag-resolve-driver :as tag-driver]
            [firn.tag-resolve-family :as tag-family]
            [firn.flake-input-family :as flake-family]))

(def max-directory-entries Int 16384)
(def max-compiler-output-bytes Int 16777216)

(defunion InventoryLoadResult
  (InventoryLoaded [inventory build/SourceInventory])
  (InventoryRejected [message String]))

(defn relative-child
  [parent String
   name String] String
  (if (= parent "") name (str parent "/" name)))

(defn absolute-path
  [root String
   relative String] String
  (str root "/" relative))

(defn merge-inventory
  [left build/SourceInventory right build/SourceInventory]
  build/SourceInventory
  (build/->SourceInventory
    (into (build/sourceinventory-sources left)
      (build/sourceinventory-sources right))
    (into (build/sourceinventory-obsolete-outputs left)
      (build/sourceinventory-obsolete-outputs right))))

(defn load-inventory-directory
  [bridge Any
   root String
   relative String] InventoryLoadResult
  (let [absolute String (if (= relative "") root (absolute-path root relative))
        list-result Any (.listDirectory bridge absolute max-directory-entries)
        list-errno Int (.status bridge list-result)]
    (if (not (= list-errno 0))
      (->InventoryRejected
        (build/errno-message "cannot list"
          (if (= relative "") "." relative) list-errno))
      (let [names (Vec String) (sort (.value bridge list-result))]
        (loop [index Int 0
               inventory build/SourceInventory (build/->SourceInventory [] [])]
          (if (>= index (count names))
            (->InventoryLoaded inventory)
            (let [entry-relative String (relative-child relative (nth names index))
                  kind-result Any (.pathKind bridge (absolute-path root entry-relative))
                  kind-errno Int (.status bridge kind-result)]
              (if (not (= kind-errno 0))
                (if (= kind-errno 2)
                  (recur (+ index 1) inventory)
                  (->InventoryRejected
                    (build/errno-message
                      "cannot inspect" entry-relative kind-errno)))
                (let [kind Int (.value bridge kind-result)]
                  (cond
                    [(and (= kind 2)
                          (not (build/traversal-excluded? entry-relative)))
                     (match
                       (load-inventory-directory bridge root entry-relative)
                       [(InventoryRejected message)
                        (->InventoryRejected message)]
                       [(InventoryLoaded child-inventory)
                        (recur (+ index 1)
                          (merge-inventory inventory child-inventory))])]
                    [(and (or (= kind 1) (= kind 3))
                          (build/source-path? entry-relative))
                     (recur (+ index 1)
                       (merge-inventory inventory
                         (build/->SourceInventory
                           [(build/->SourceState entry-relative
                              (build/output-relative entry-relative))] [])))]
                    [(and (or (= kind 1) (= kind 3))
                          (build/obsolete-output-path? entry-relative))
                     (recur (+ index 1)
                       (merge-inventory inventory
                         (build/->SourceInventory [] [entry-relative])))]
                    [:else (recur (+ index 1) inventory)]))))))))))

(defn emit-error
  [bridge Any
   message String] Int
  (do (.err bridge message) 1))

(defn run-preparation
  [bridge Any
   root String] Int
  (match (tag-family/directory-names bridge root "hosts")
    [(DirectoryNamesRejected message)
     (do
       (.err bridge message)
       (emit-error bridge
         "firn-build: tag resolution failed; aborting before .nix regeneration\n"))]
    [(DirectoryNamesLoaded names)
     (let [tag-status Int (tag-family/run-action bridge root names
             (tag-driver/->ResolveAll true))]
       (if (not (= tag-status 0))
         (emit-error bridge
           "firn-build: tag resolution failed; aborting before .nix regeneration\n")
         (let [flake-status Int (flake-family/run-root bridge root)]
           (if (= flake-status 0)
             0
             (emit-error bridge
               "firn-build: flake-inputs resolution failed; aborting\n")))))]))

(defn emit-compiler-output
  [bridge Any
   stdout String
   stderr String] Int
  (do
    (if (= stdout "") 0 (do (.out bridge stdout) 0))
    (if (= stderr "") 0 (do (.err bridge stderr) 0))
    0))

(defn galileo-binary [bridge Any] String
  (let [runtime (U String Nil) (.env bridge "FIRN_RUNTIME_BIN")]
    (if (and (some? runtime)
             (= (.status bridge (.pathKind bridge (str runtime "/galileo"))) 0))
      (str runtime "/galileo")
      "galileo")))

(defn run-galileo-build
  [bridge Any
   root String
   arguments (Vec String)] Int
  (let [capture Any (.runCapture bridge
          (into ["env" "-C" root (galileo-binary bridge) "build" "--layout" "idiomatic"] arguments)
          max-compiler-output-bytes)
        errno Int (.status bridge capture)]
    (if (not (= errno 0))
      (emit-error bridge (str "firn-build: cannot start galileo build: errno " errno "\n"))
      (let [result Any (.value bridge capture)
            status Int (.exitStatus bridge result)]
        (do
          (emit-compiler-output bridge (.stdout bridge result) (.stderr bridge result))
          (if (= status 0)
            0
            (emit-error bridge
              (str "firn-build: galileo build exited " status "\n"))))))))

(defn remove-obsolete-output
  [bridge Any
   root String
   relative String] Int
  (let [errno Int (.removeFile bridge (absolute-path root relative))]
    (if (or (= errno 0) (= errno 2))
      0
      (emit-error bridge
        (build/errno-message "cannot remove obsolete output" relative errno)))))

(defn remove-obsolete-outputs
  [bridge Any
   root String
   paths (Vec String)
   index Int] Int
  (if (>= index (count paths))
    0
    (let [status Int (remove-obsolete-output bridge root (nth paths index))]
      (if (= status 0)
        (remove-obsolete-outputs bridge root paths (+ index 1))
        status))))

(defn execute-plan
  [bridge Any
   root String
   plan build/RepoBuildPlan] Int
  (let [sources (Vec build/SourceState) (build/repobuildplan-sources plan)
        compile-status Int (run-galileo-build bridge root [])]
    (if (not (= compile-status 0))
      compile-status
      (let [cleanup-status Int (remove-obsolete-outputs bridge root
              (build/repobuildplan-obsolete-outputs plan) 0)]
        (if (not (= cleanup-status 0))
          cleanup-status
          (do
            (if (= (count sources) 0)
              (.out bridge "firn-build: nothing to rebuild.\n")
              0)
            0))))))

(defn diff-selected? [state build/SourceState target String] Bool
  (or (= target "all")
      (= target (build/sourcestate-relative state))
      (= target (build/sourcestate-output-relative state))
      (build/starts-with? (build/sourcestate-relative state) (str target "/"))))

(defn run-diff
  [bridge Any
   root String
   target String] Int
  (match (load-inventory-directory bridge root "")
    [(InventoryRejected message) (emit-error bridge message)]
    [(InventoryLoaded inventory)
     (let [sources (Vec build/SourceState) (build/sourceinventory-sources inventory)
           selected (Vec String)
           (loop [index Int 0 paths (Vec String) []]
             (if (>= index (count sources))
               paths
               (let [state build/SourceState (nth sources index)]
                 (recur (+ index 1)
                   (if (diff-selected? state target)
                     (conj paths (build/sourcestate-relative state))
                     paths)))))]
       (if (= (count selected) 0)
         (do (.out bridge "firn diff: 0 checked\n") 1)
         (let [status Int (run-galileo-build bridge root
                 (into ["--check"] (if (= target "all") [] selected)))]
           (do
             (.out bridge (str "firn diff: " (count selected) " checked, "
                            (if (= status 0) "clean" "differing or failed") "\n"))
             status))))]))

(defn repository-root [bridge Any] (U String Nil)
  (let [explicit (U String Nil) (.env bridge "FIRN_REPO")]
    (if (some? explicit)
      explicit
      (let [home (U String Nil) (.env bridge "HOME")]
        (if (some? home)
          (str home "/code/nixos-config/main")
          nil)))))

(defn run-root
  [bridge Any
   root String] Int
  (let [preparation-status Int (run-preparation bridge root)]
    (if (not (= preparation-status 0))
      preparation-status
      (match (load-inventory-directory bridge root "")
        [(InventoryRejected message) (emit-error bridge message)]
        [(InventoryLoaded inventory)
         (execute-plan bridge root (build/build-plan inventory))]))))

(defn run-command
  [bridge Any
   root String] Int
  (do
    (.out bridge ">> firn-build\n")
    (let [status Int (run-root bridge root)]
      (if (= status 0)
        0
        (do
          (.err bridge "firn repo build: failed.\n")
          1)))))

(defn usage-error [bridge Any] Int
  (do (.err bridge "Usage: firn repo build [all] | firn repo diff [target|all]\n") 64))

(js/export
  (defn run
    [bridge Any
     args (Vec String)] Int
    (match (build/parse-repo-build-argv args)
    [(OtherRepoBuildCommand argv) (usage-error bridge)]
    [(InvalidRepoBuildArgv argv) (usage-error bridge)]
    [(ParsedRepoDiff target)
     (let [root (U String Nil) (repository-root bridge)]
       (if (nil? root)
         (emit-error bridge "firn diff: FIRN_REPO and HOME are not set\n")
         (run-diff bridge root target)))]
    [(ParsedRepoBuild token)
     (let [root (U String Nil) (repository-root bridge)]
       (if (nil? root)
         (emit-error bridge "firn repo build: FIRN_REPO and HOME are not set\n")
         (run-command bridge root)))])))
